
Процедура ПередЗаписью(Отказ)
	Попытка      
		Наим_Число = Число(Наименование);
		Если не Вылет = Наим_Число Тогда 
			Вылет = Наим_Число;
		КонецЕсли;	
	Исключение   
		#Если Клиент Тогда    
			Сообщить(Наименование + ".  С.Д. не удалось заполнить значение Вылет, которое используется для отбора в подборе!");	
		#КонецЕсли
	КонецПопытки;	
КонецПроцедуры
