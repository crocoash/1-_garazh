
Процедура ПередЗаписью(Отказ) 
	
	Если Не Активное тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	БП_НастройкиАвтозаменыОрганизацииВЗаказеПоставщику.Ссылка
	                      |ИЗ
	                      |	Справочник.БП_НастройкиАвтозаменыОрганизацииВЗаказеПоставщику КАК БП_НастройкиАвтозаменыОрганизацииВЗаказеПоставщику
	                      |ГДЕ
	                      |	БП_НастройкиАвтозаменыОрганизацииВЗаказеПоставщику.Активное
	                      |	И НЕ БП_НастройкиАвтозаменыОрганизацииВЗаказеПоставщику.ПометкаУдаления
	                      |	И БП_НастройкиАвтозаменыОрганизацииВЗаказеПоставщику.Ссылка <> &Ссылка");
	
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ.Количество() тогда
		Сообщить("Може бути лише одне активне налаштування!");
		Отказ = Истина;
	КонецЕсли;		
	
КонецПроцедуры
