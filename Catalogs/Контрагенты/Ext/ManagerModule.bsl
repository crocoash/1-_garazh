Функция НайтиКонтрагентовПоНомеруТелефона(Номер) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект.Код КАК Код,
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Вид,
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	ПОДСТРОКА(КонтактнаяИнформация.Представление, 1, 20) ПОДОБНО &Телефон";
	Запрос.УстановитьПараметр("Телефон","%"+Прав(Номер,9));
	Возврат  Запрос.Выполнить().Выгрузить();
КонецФункции 

Функция НайтиКонтрагентовПоНомеруТелефона1(Номер) Экспорт

    // Проверяем, что номер задан
    Если НЕ ЗначениеЗаполнено(Номер) Тогда
        Возврат Новый Массив;
    КонецЕсли;

	// Очищаем номер от всех символов кроме цифр
	НомерЦифры = "";
	Для Индекс = 1 По СтрДлина(Номер) Цикл
		Символ = Сред(Номер, Индекс, 1);
		Если Символ >= "0" И Символ <= "9" Тогда
			НомерЦифры = НомерЦифры + Символ;
		КонецЕсли;
	КонецЦикла;
	// Берём последние 9 цифр (если меньше — берём всё)
	Длина = СтрДлина(НомерЦифры);
	Если Длина > 9 Тогда
		НомерПоиска = Сред(НомерЦифры, Длина-8, 9); // последние 9 цифр
	Иначе
		НомерПоиска = НомерЦифры;
    КонецЕсли;

    // Создаём и выполняем запрос
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |   КонтактнаяИнформация.Объект.Код КАК Код,
    |   КонтактнаяИнформация.Объект,
    |   КонтактнаяИнформация.Вид,
    |   КонтактнаяИнформация.Представление
    |ИЗ
    |   РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
    |ГДЕ
    |   КонтактнаяИнформация.Представление ПОДОБНО &Телефон";

    // Параметр с символом % в начале для поиска конца строки
    Запрос.УстановитьПараметр("Телефон", "%" + НомерПоиска);

    // Возврат результатов
    Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция НайтиКонтрагентаПоНомеруТелефона(Номер) Экспорт
	
	Контрагенты = НайтиКонтрагентовПоНомеруТелефона1(Номер);

	Если Контрагенты.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Берем первого найденного
	Возврат Контрагенты[0].Объект;

КонецФункции

Функция ОтобразитьОкноДляНомера(Номер = неопределено, Контрагент = Неопределено) Экспорт
	
	ЕстьКонтрагент = ЗначениеЗаполнено(Контрагент);
	ЕстьНомер      = ЗначениеЗаполнено(Номер);
	
	Если не ЕстьКонтрагент и не ЕстьНомер Тогда Возврат Неопределено; КонецЕсли; 
		
	Если не ЕстьКонтрагент И ЕстьНомер Тогда
		Контрагент = НайтиКонтрагентаПоНомеруТелефона(Номер);
	КонецЕсли;  
	
	Если не ЕстьНомер и ЕстьКонтрагент Тогда 	
		Номер = Контрагент.ПолучитьОбъект().ПолучитьНомерТелефона();
	КонецЕсли; 
	
	Форма = ПолучитьОбщуюФорму("Цв_Инфа_По_Контрагенту");	
	Если Форма.Открыта() Тогда
		Форма.Закрыть();
	КонецЕсли;
	Форма = ПолучитьОбщуюФорму("Цв_Инфа_По_Контрагенту"); 
	форма.Номер = Номер; 
	форма.Контрагент = Контрагент;
	форма.Открыть();	
КонецФункции                       

функция ПолучимКонтрагентовТоваровКоторыхНаРеализации() Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ГруппыДоговоров_СДДоговора.Договор КАК ДоговорПоставщика,
	               |	ГруппыДоговоров_СДДоговора.Ссылка КАК Ссылка,
	               |	ГруппыДоговоров_СДДоговора.Ссылка.Владелец КАК Поставщик,
	               |	ШаблоныЗагрузкиОстатковПоставщиков_СД.ПочтаПоставщика,
	               |	БП_НастройкаЗагрузкиСчетовКонтрагентовExcel.Ссылка КАК БП_НастройкаЗагрузкиСчетовКонтрагентовExcel
	               |ИЗ
	               |	Справочник.ГруппыДоговоров_СД.Договора КАК ГруппыДоговоров_СДДоговора
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ШаблоныЗагрузкиОстатковПоставщиков_СД КАК ШаблоныЗагрузкиОстатковПоставщиков_СД
	               |		ПО ГруппыДоговоров_СДДоговора.Ссылка = ШаблоныЗагрузкиОстатковПоставщиков_СД.ГруппаДоговоров
	               |		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.БП_НастройкаЗагрузкиСчетовКонтрагентовExcel КАК БП_НастройкаЗагрузкиСчетовКонтрагентовExcel
	               |		ПО ГруппыДоговоров_СДДоговора.Ссылка.Владелец = БП_НастройкаЗагрузкиСчетовКонтрагентовExcel.Контрагент";
	Возврат Запрос.Выполнить().Выгрузить();  
	
КонецФункции
                                                                  
функция ПолучитьПочтуПоставщикаДляОповещенииОПроданомТоваре(Поставщик) Экспорт  
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШаблоныЗагрузкиОстатковПоставщиков_СДСрезПоследних.ПочтаПоставщика КАК ПочтаПоставщика	               
				   |ИЗ
	               |	РегистрСведений.ШаблоныЗагрузкиОстатковПоставщиков_СД.СрезПоследних КАК ШаблоныЗагрузкиОстатковПоставщиков_СДСрезПоследних
	               |ГДЕ
	               |	ШаблоныЗагрузкиОстатковПоставщиков_СДСрезПоследних.Поставщик = &Поставщик";
	
	Запрос.УстановитьПараметр("Поставщик",Поставщик);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл 
		Возврат Выборка.ПочтаПоставщика;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

