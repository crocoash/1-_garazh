Функция ПолучитьMagentoТекущийМенеджер(ТипЦены,MagentoТекущийМенеджер) Экспорт
		
	ТекНомМенеджер = MagentoТекущийМенеджер.Получить();	
	Мен = ТекНомМенеджер+1;
	MagentoТекущийМенеджер.Установить(Мен);

	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	БП_ГрафикРаботыМенеджеровMagentoМенеджера.НомерСтроки,
	               |	БП_ГрафикРаботыМенеджеровMagentoМенеджера.Менеджер,
	               |	БП_ГрафикРаботыМенеджеровMagentoМенеджера.Ссылка.Ссылка,
	               |	БП_ГрафикРаботыМенеджеровMagentoМенеджера.Ссылка.Номер,
	               |	ПолучимДокумент.Номер КАК Номер1
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		МАКСИМУМ(БП_ГрафикРаботыМенеджеровMagento.Дата) КАК Дата,
	               |		БП_ГрафикРаботыМенеджеровMagento.Номер КАК Номер
	               |	ИЗ
	               |		Документ.БП_ГрафикРаботыМенеджеровMagento КАК БП_ГрафикРаботыМенеджеровMagento
	               |	ГДЕ
	               |		БП_ГрафикРаботыМенеджеровMagento.ТипЦены = &ТипЦены
	               |		И БП_ГрафикРаботыМенеджеровMagento.Проведен
	               |		И БП_ГрафикРаботыМенеджеровMagento.Дата <= &Дата
	               |		И БП_ГрафикРаботыМенеджеровMagento.ДатаПо >= &Дата
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		БП_ГрафикРаботыМенеджеровMagento.Номер) КАК ПолучимДокумент
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.БП_ГрафикРаботыМенеджеровMagento.Менеджера КАК БП_ГрафикРаботыМенеджеровMagentoМенеджера
	               |		ПО ПолучимДокумент.Дата = БП_ГрафикРаботыМенеджеровMagentoМенеджера.Ссылка.Дата
	               |			И ПолучимДокумент.Номер = БП_ГрафикРаботыМенеджеровMagentoМенеджера.Ссылка.Номер
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	БП_ГрафикРаботыМенеджеровMagentoМенеджера.НомерСтроки";
	
	
	Запрос.УстановитьПараметр("ТипЦены",ТипЦены);
	Запрос.УстановитьПараметр("Дата",ТекущаяДата());
	Менеджеры = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Менеджер");	
			
	Кво = Менеджеры.Количество();
    Если Кво = 0 Тогда
        Сообщить("Нет менеджеров для типа цены!");
        Возврат Справочники.Пользователи.ПустаяСсылка();
    КонецЕсли;

    Поз = Мен-Цел(Мен/Кво)*Кво;
    Если Поз = 0 Тогда
        Поз = Кво;
    КонецЕсли;

    Возврат Менеджеры[Поз - 1]; // 0-based индекс

