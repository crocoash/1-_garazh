// Переводит фрагмент наименования по справочнику соответствий слов.
//
// Словарь - таблица значений (колонки СловоУкр, СловоРу) для нужного направления,
// структура (РуУкр, УкрРу) с обоими направлениями сразу либо Неопределено - тогда
// справочник читается здесь же.
Функция ПеревестиНаименованиеЧерезСоответствия(НаименованиеДляПеревода, ВидНоменклатуры = Неопределено, руНаУкр = Истина, Словарь = Неопределено) Экспорт

	Если ПустаяСтрока(НаименованиеДляПеревода) Тогда
		Возврат НаименованиеДляПеревода;
	КонецЕсли;

	ТаблицаСловаря = СловарьДляНаправления(Словарь, ВидНоменклатуры, руНаУкр);

	// Поле нового формата ("Полусинтетическое") - это значение реквизита из справочника целиком,
	// а не слово посреди фразы: якоря по пробелам на нём не срабатывают. Поэтому сначала пробуем
	// перевести фрагмент целиком, и только потом идём по старым правилам подстроки.
	Перевод = ПеревестиФрагментЦеликом(НаименованиеДляПеревода, ТаблицаСловаря, руНаУкр);
	Если Перевод <> Неопределено Тогда
		Возврат Перевод;
	КонецЕсли;

	Для Каждого Выборка Из ТаблицаСловаря Цикл
		Если руНаУкр тогда
			//Наименование = СтрЗаменить(Наименование,	Выборка.СловоРу, Выборка.СловоУкр);
			Если Найти(НаименованиеДляПеревода,"(" + Выборка.СловоРу + ")") <> 0 Тогда
				НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	"(" + Выборка.СловоРу + ")", "(" + Выборка.СловоУкр + ")");
			ИначеЕсли Найти(НаименованиеДляПеревода," " + Выборка.СловоРу + " ") <> 0 Тогда
					НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	" " + Выборка.СловоРу + " ", " " + Выборка.СловоУкр + " ");
			ИначеЕсли Найти(НаименованиеДляПеревода,"-" + Выборка.СловоРу + "-") <> 0 Тогда
					НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	"-" + Выборка.СловоРу + "-", "-" + Выборка.СловоУкр + "-"); 
			ИначеЕсли Найти(НаименованиеДляПеревода," " + Выборка.СловоРу + "-") <> 0 Тогда
					НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	"" + Выборка.СловоРу + "-", "" + Выборка.СловоУкр + "-"); 
			ИначеЕсли Найти(НаименованиеДляПеревода,"-" + Выборка.СловоРу + "") <> 0 Тогда
					НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	"-" + Выборка.СловоРу + "", "-" + Выборка.СловоУкр + ""); 
			ИначеЕсли СловосочетаниеНачинаетСтроку(НаименованиеДляПеревода,Выборка.СловоРу,Истина) Тогда
					НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	Выборка.СловоРу, Выборка.СловоУкр);
			ИначеЕсли  СловосочетаниеЗаканчиваетСтроку(НаименованиеДляПеревода,Выборка.СловоРу,Истина) Тогда
					НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,Выборка.СловоРу, Выборка.СловоУкр);
			КонецЕсли; 
		Иначе
			//НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	Выборка.СловоУкр, Выборка.СловоРу);	    
			Если Найти(НаименованиеДляПеревода,"(" + Выборка.СловоУкр + ")") <> 0 Тогда
				НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	"(" + Выборка.СловоУкр + ")", "(" + Выборка.СловоРу + ")");
			ИначеЕсли Найти(НаименованиеДляПеревода," " + Выборка.СловоУкр + " ") <> 0 Тогда
					НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	" " + Выборка.СловоУкр + " ", " " + Выборка.СловоРу + " "); 
			ИначеЕсли Найти(НаименованиеДляПеревода,"-" + Выборка.СловоУкр + "-") <> 0 Тогда
					НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	"-" + Выборка.СловоУкр + "-", "-" + Выборка.СловоРу + "-"); 
			ИначеЕсли Найти(НаименованиеДляПеревода," " + Выборка.СловоУкр + "-") <> 0 Тогда
					НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	"" + Выборка.СловоУкр + "-", "" + Выборка.СловоРу + "-"); 
			ИначеЕсли Найти(НаименованиеДляПеревода,"-" + Выборка.СловоУкр + "") <> 0 Тогда
					НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	"-" + Выборка.СловоУкр + "", "-" + Выборка.СловоРу + ""); 
			ИначеЕсли  СловосочетаниеНачинаетСтроку(НаименованиеДляПеревода,Выборка.СловоУкр,Истина) Тогда
					НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,	Выборка.СловоУкр , Выборка.СловоРу);
			ИначеЕсли  СловосочетаниеЗаканчиваетСтроку(НаименованиеДляПеревода,Выборка.СловоУкр,Истина) Тогда
					НаименованиеДляПеревода = СтрЗаменить(НаименованиеДляПеревода,Выборка.СловоУкр, Выборка.СловоРу);
			КонецЕсли; 

		КонецЕсли;
	КонецЦикла;  
	
	Возврат НаименованиеДляПеревода;

КонецФункции

// Возвращает таблицу словаря для нужного направления перевода.
Функция СловарьДляНаправления(Словарь, ВидНоменклатуры, руНаУкр)

	Если Словарь = Неопределено Тогда
		Возврат ПолучитьСловарьПереводов(ВидНоменклатуры, руНаУкр);
	КонецЕсли;

	Если ТипЗнч(Словарь) = Тип("Структура") Тогда
		Возврат ?(руНаУкр, Словарь.РуУкр, Словарь.УкрРу);
	КонецЕсли;

	Возврат Словарь;

КонецФункции // СловарьДляНаправления()

// Переводит фрагмент целиком, если он совпал со словарной статьёй.
// Возвращает Неопределено, если совпадения нет - тогда работают старые правила подстроки.
Функция ПеревестиФрагментЦеликом(Фрагмент, ТаблицаСловаря, руНаУкр)

	Ядро = СокрЛП(Фрагмент);
	Если ПустаяСтрока(Ядро) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Выборка Из ТаблицаСловаря Цикл

		Источник = ?(руНаУкр, Выборка.СловоРу,  Выборка.СловоУкр);
		Цель     = ?(руНаУкр, Выборка.СловоУкр, Выборка.СловоРу);

		Если ПустаяСтрока(Источник) ИЛИ ПустаяСтрока(Цель) Тогда
			Продолжить;
		КонецЕсли;

		Если НРег(Ядро) <> НРег(Источник) Тогда
			Продолжить;
		КонецЕсли;

		// Регистр первой буквы задаёт сборка наименования (ВРег на каждое поле в скобках),
		// а не словарь: иначе поле вернулось бы как "напівсинтетична" со строчной.
		ПерваяБуква = Лев(Ядро, 1);
		Если ПерваяБуква = ВРег(ПерваяБуква) И ПерваяБуква <> НРег(ПерваяБуква) Тогда
			Цель = ВРег(Лев(Цель, 1)) + Сред(Цель, 2);
		КонецЕсли;

		// Пробелы вокруг фрагмента - это разметка наименования, их нужно сохранить как есть.
		ПозицияЯдра = Найти(Фрагмент, Ядро);
		Возврат Лев(Фрагмент, ПозицияЯдра - 1) + Цель + Сред(Фрагмент, ПозицияЯдра + СтрДлина(Ядро));

	КонецЦикла;

	Возврат Неопределено;

КонецФункции // ПеревестиФрагментЦеликом()

функция первоеслово(строка,слово)
	слово = СокрЛП(слово);
	строка = Сокрлп(строка);
	//позиция=найти(строка, " " + слово);
	Если найти(строка, " " + слово) > 0 тогда
		Возврат Ложь;
	иначеЕсли  найти(строка, "(" + слово) > 0 тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	конецесли;
конецфункции  

функция Последнееслово(ИсходнаяСтрока)
	слово = СокрЛП(слово);
	строка = Сокрлп(строка);
	позиция=найти(строка, слово + " ");
	Если найти(строка, слово + " ") > 0 тогда
		Возврат Ложь;
	иначеЕсли  найти(строка, слово + ") ") > 0 тогда 
		Возврат Ложь;
	иначеЕсли  найти(строка, слово + ") ") > 0 тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	конецесли;
конецфункции  
Функция СловосочетаниеНачинаетСтроку(Строка1, Словосочетание1, БезУчетаРегистра = Ложь) Экспорт
	
	// Уберём пробелы слева/справа
	Строка = СокрЛП(Строка1);
	Словосочетание = СокрЛП(Словосочетание1);

	Если БезУчетаРегистра Тогда
		СтрНорм = НРег(Строка);
		СочНорм = НРег(Словосочетание);
	Иначе
		СтрНорм = Строка;
		СочНорм = Словосочетание;
	КонецЕсли;

	Дл = СтрДлина(СочНорм);
	Если Дл = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// Проверяем, что строка начинается с словосочетания
	Если Лев(СтрНорм, Дл) <> СочНорм Тогда
		Возврат Ложь;
	КонецЕсли;

	// Требуем границу слова: либо конец строки,
	// либо после словосочетания идет разделитель (пробел/знак препинания)
	Если СтрДлина(СтрНорм) = Дл Тогда
		Возврат Истина;
	КонецЕсли;

	СледСимв = Сред(СтрНорм, Дл + 1, 1);
	Разделители = " " + Символы.Таб + ".,;:!?_-—()""'…";
	Если Найти(Разделители, СледСимв) > 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции   

Функция СловосочетаниеЗаканчиваетСтроку(Строка1, Словосочетание1, БезУчетаРегистра = Ложь) Экспорт
	
	// Уберём пробелы справа
	Строка = СокрП(Строка1);
	Словосочетание = СокрП(Словосочетание1);

	Если БезУчетаРегистра Тогда
		СтрНорм = НРег(Строка);
		СочНорм = НРег(Словосочетание);
	Иначе
		СтрНорм = Строка;
		СочНорм = Словосочетание;
	КонецЕсли;

	Дл = СтрДлина(СочНорм);
	Если Дл = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	// Проверим, что строка оканчивается словосочетанием
	Если Прав(СтрНорм, Дл) <> СочНорм Тогда
		Возврат Ложь;
	КонецЕсли;

	// Требуем границу слова: либо строка равна словосочетанию,
	// либо перед ним стоит разделитель (пробел/знак препинания)
	Если СтрДлина(СтрНорм) = Дл Тогда
		Возврат Истина;
	КонецЕсли;

	ПредСимв = Сред(СтрНорм, СтрДлина(СтрНорм) - Дл, 1);
	Разделители = " " + Символы.Таб + ".,;:!_?-—()""'…";
	Если Найти(Разделители, ПредСимв) > 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции


Функция ОткрытьДляПользователя(мТекущийПользователь) Экспорт
	
	Форма = ПолучитьФорму("ФормаСписка");
	Форма.Открыть();

КонецФункции

функция ПолучимСвободныйОстатокНаНашемСкладе(Номенклатура) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	               |	СУММА(ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоКонечныйОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)) КАК СвободныйОстаток
	               |ИЗ
	               |	РегистрНакопления.ПартииТоваровНаСкладах.ОстаткиИОбороты(&ТекДата, &ТекДата, Регистратор, , Номенклатура В (&Номенклатура)) КАК ТоварыНаСкладахОстатки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Номенклатура В (&Номенклатура)) КАК ТоварыВРезервеНаСкладахОстатки
	               |		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
	               |			И ТоварыНаСкладахОстатки.Склад = ТоварыВРезервеНаСкладахОстатки.Склад
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТоварыНаСкладахОстатки.Номенклатура";
	
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл  
		Возврат Выборка.СвободныйОстаток;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции


                                             

////////////////////////////////////////////////////////////////////////////////
//
// Шаблон хранится в справочнике ШаблоныНаименований в разрезе вида номенклатуры.
// Синтаксис шаблона:
//
//   [Реквизит]          - значение реквизита объекта;
//   [Реквизит=Зн1;Зн2]  - значение подставляется только если совпадает с одним из перечисленных;
//   [Реквизит!Зн1;Зн2]  - значение подставляется только если НЕ совпадает ни с одним из перечисленных;
//   |                   - разделитель полей. Поле, все токены которого пустые, выбрасывается
//                         целиком вместе со своими литералами; оставшиеся склеиваются через " | ";
//   ( ... )             - группа полей. Если внутри не осталось ни одного поля, скобки не выводятся.
//
// Литералы вне токенов сохраняются как есть (" мм.", "Ключ ", "DIA ", "/").
// Первая буква наименования и первая буква каждого поля внутри скобок приводятся к ВРег.
//
// Пример шаблона для секреток:
//   Секретки [Производитель] [Модель] ([ТипСекреток] [РезьбаСекретки] | [ВысотаСекретки] мм. | [ВидСекретки] | [ПрижимнаяПоверхность] | Ключ [Ключ] | [ДопПараметрСекреток])
//
// Наименование собирается один раз (база), затем нормализуется в каждый язык
// отдельно через словарь БП_СоответствиеУкрРуСлов - так же, как это делалось раньше.
////////////////////////////////////////////////////////////////////////////////

// Возвращает шаблон наименования для вида номенклатуры или пустую строку, если шаблон не задан.
Функция ПолучитьШаблонНаименования(ВидНоменклатуры) Экспорт

	Если НЕ ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		Возврат "";
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ШаблоныНаименований.Шаблон КАК Шаблон
	                      |ИЗ
	                      |	Справочник.ШаблоныНаименований КАК ШаблоныНаименований
	                      |ГДЕ
	                      |	ШаблоныНаименований.ВидНоменклатуры = &ВидНоменклатуры
	                      |	И НЕ ШаблоныНаименований.ПометкаУдаления");
	Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.Шаблон);
	КонецЕсли;

	Возврат "";

КонецФункции // ПолучитьШаблонНаименования()

// Возвращает словарь соответствий слов для вида номенклатуры (таблица с колонками СловоУкр, СловоРу).
// Нужен, чтобы при пакетной обработке не выполнять запрос на каждый фрагмент наименования.
//
// Направление задаёт справочник: рус.->укр. живёт в БП_СоответствиеРуУкрСлов, укр.->рус. -
// в БП_СоответствиеУкрРуСлов. Раньше в обе стороны читался только укр.->рус., поэтому весь
// рус.->укр. справочник (масла, диски, проставки) в переводе не участвовал вообще, а пары
// из укр.->рус. применялись задом наперёд.
Функция ПолучитьСловарьПереводов(ВидНоменклатуры = Неопределено, руНаУкр = Истина) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ВидНоменклатуры = Неопределено Тогда
		ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПустаяСсылка();
	КонецЕсли;

	ИмяСправочника    = ?(руНаУкр, "БП_СоответствиеРуУкрСлов", "БП_СоответствиеУкрРуСлов");
	ИмяВстречного     = ?(руНаУкр, "БП_СоответствиеУкрРуСлов", "БП_СоответствиеРуУкрСлов");

	Словарь = ЧитатьСоответствияСлов(ИмяСправочника, ВидНоменклатуры);

	// Пары в обоих справочниках одинаковы по смыслу (колонки СловоУкр/СловоРу), различается
	// только то, в каком из них вид номенклатуры вообще заведён: рус.->укр. заполнен на 8 видов,
	// укр.->рус. - на 3. Без этого отката виды, заведённые лишь во встречном справочнике,
	// потеряли бы перевод, который работал раньше.
	Если Словарь.Количество() = 0 Тогда
		Словарь = ЧитатьСоответствияСлов(ИмяВстречного, ВидНоменклатуры);
	КонецЕсли;

	НормализоватьСловарь(Словарь);
	УпорядочитьСловарьОтДлинныхСтатей(Словарь, руНаУкр);

	Возврат Словарь;

КонецФункции // ПолучитьСловарьПереводов()

// Ставит длинные статьи словаря впереди коротких.
//
// Статьи применяются к строке по очереди и независимо друг от друга, поэтому короткое слово,
// стоящее выше, съедает начало длинной фразы: "Масло" -> "Олива" превращает
// "Масло моторное" в "Олива моторное", после чего статья "Масло моторное" себя уже не находит.
// От порядка строк в табличной части это зависеть не должно - сортируем сами.
Процедура УпорядочитьСловарьОтДлинныхСтатей(Словарь, руНаУкр)

	Словарь.Колонки.Добавить("ДлинаСтатьи", Новый ОписаниеТипов("Число"));

	Для Каждого СтрокаСловаря Из Словарь Цикл
		СтрокаСловаря.ДлинаСтатьи = СтрДлина(?(руНаУкр, СтрокаСловаря.СловоРу, СтрокаСловаря.СловоУкр));
	КонецЦикла;

	Словарь.Сортировать("ДлинаСтатьи Убыв");
	Словарь.Колонки.Удалить("ДлинаСтатьи");

КонецПроцедуры // УпорядочитьСловарьОтДлинныхСтатей()

// Читает табличную часть "Соответствие" указанного справочника соответствий слов.
Функция ЧитатьСоответствияСлов(ИмяСправочника, ВидНоменклатуры)

	ТекстЗапроса = "ВЫБРАТЬ
	               |	Соответствие.СловоУкр КАК СловоУкр,
	               |	Соответствие.СловоРу КАК СловоРу
	               |ИЗ
	               |	Справочник.ИмяСправочникаСоответствий.Соответствие КАК Соответствие
	               |ГДЕ
	               |	Соответствие.Ссылка.ВидНоменклатуры = &ВидНоменклатуры
	               |	И НЕ Соответствие.Ссылка.ПометкаУдаления";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИмяСправочникаСоответствий", ИмяСправочника);

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // ЧитатьСоответствияСлов()

// Возвращает оба направления сразу - структуру (РуУкр, УкрРу) с таблицами словарей.
// При пакетной обработке справочники читаются один раз на вид номенклатуры.
Функция ПолучитьСловариПереводов(ВидНоменклатуры = Неопределено) Экспорт

	Словари = Новый Структура("РуУкр, УкрРу");
	Словари.РуУкр = ПолучитьСловарьПереводов(ВидНоменклатуры, Истина);
	Словари.УкрРу = ПолучитьСловарьПереводов(ВидНоменклатуры, Ложь);

	Возврат Словари;

КонецФункции // ПолучитьСловариПереводов()

// Снимает у словарных статей обрамляющие скобки и пробелы.
//
// В справочниках слова заведены в том виде, в каком стояли в старом наименовании:
// "(полусинтетическое)" - вместе со скобками. В новом формате поле приходит без скобок
// и с заглавной буквы, поэтому сравнивать нужно по голому слову; скобки навешивает обратно
// сопоставление по якорям.
Процедура НормализоватьСловарь(Словарь)

	Для Каждого СтрокаСловаря Из Словарь Цикл
		СтрокаСловаря.СловоУкр = СнятьОбрамляющиеСкобки(СтрокаСловаря.СловоУкр);
		СтрокаСловаря.СловоРу  = СнятьОбрамляющиеСкобки(СтрокаСловаря.СловоРу);
	КонецЦикла;

КонецПроцедуры // НормализоватьСловарь()

Функция СнятьОбрамляющиеСкобки(Слово)

	Результат = СокрЛП(Слово);

	Пока СтрДлина(Результат) > 2 И Лев(Результат, 1) = "(" И Прав(Результат, 1) = ")" Цикл
		Результат = СокрЛП(Сред(Результат, 2, СтрДлина(Результат) - 2));
	КонецЦикла;

	Возврат Результат;

КонецФункции // СнятьОбрамляющиеСкобки()

// Переводит наименование, разбирая его на фрагменты по структурным разделителям "(", ")" и "|".
//
// Зачем: ПеревестиНаименованиеЧерезСоответствия() ищет слово по якорям (пробел слева и справа,
// начало строки, конец строки). В новом формате первый токен стоит сразу после "(", а последний -
// перед ")", поэтому ни один якорь не срабатывает и слово молча остаётся непереведённым.
// Разбор на фрагменты делает начало/конец каждого поля границей строки, и старые якоря снова работают.
Функция ПеревестиНаименованиеПоФрагментам(Наименование, ВидНоменклатуры = Неопределено, руНаУкр = Истина, Словарь = Неопределено) Экспорт

	Если ПустаяСтрока(Наименование) Тогда
		Возврат Наименование;
	КонецЕсли;

	Если Словарь = Неопределено Тогда
		Словарь = ПолучитьСловариПереводов(ВидНоменклатуры);
	КонецЕсли;

	Разделители = "()|";
	Результат   = "";
	Фрагмент    = "";

	Для Счетчик = 1 По СтрДлина(Наименование) Цикл
		Символ = Сред(Наименование, Счетчик, 1);
		Если Найти(Разделители, Символ) > 0 Тогда
			Результат = Результат + ПеревестиНаименованиеЧерезСоответствия(Фрагмент, ВидНоменклатуры, руНаУкр, Словарь) + Символ;
			Фрагмент  = "";
		Иначе
			Фрагмент = Фрагмент + Символ;
		КонецЕсли;
	КонецЦикла;

	Результат = Результат + ПеревестиНаименованиеЧерезСоответствия(Фрагмент, ВидНоменклатуры, руНаУкр, Словарь);

	Возврат Результат;

КонецФункции // ПеревестиНаименованиеПоФрагментам()

// Собирает наименование объекта по шаблону. Ничего не записывает.
// Предупреждения - массив строк, заполняется найденными проблемами (необязательный).
Функция СформироватьНаименованиеПоШаблону(Объект, Шаблон, Предупреждения = Неопределено, Трассировка = Неопределено) Экспорт

	Если Предупреждения = Неопределено Тогда
		Предупреждения = Новый Массив;
	КонецЕсли;

	Если ПустаяСтрока(Шаблон) Тогда
		Возврат "";
	КонецЕсли;

	// Шаблон делится на голову, группу в скобках и хвост. Разбор идёт по ШАБЛОНУ, а не по
	// готовой строке - поэтому символы "(", ")" и "|" внутри значений реквизитов не мешают.
	ПозицияОткрытия = Найти(Шаблон, "(");
	Если ПозицияОткрытия = 0 Тогда
		ТекстГоловы = Шаблон;
		ТекстГруппы = "";
		ТекстХвоста = "";
	Иначе
		ТекстГоловы = Лев(Шаблон, ПозицияОткрытия - 1);
		Остаток     = Сред(Шаблон, ПозицияОткрытия + 1);

		ПозицияЗакрытия = ПоследняяПозицияСимвола(Остаток, ")");
		Если ПозицияЗакрытия = 0 Тогда
			Предупреждения.Добавить("у шаблоні не закрита дужка");
			ТекстГруппы = Остаток;
			ТекстХвоста = "";
		Иначе
			ТекстГруппы = Лев(Остаток, ПозицияЗакрытия - 1);
			ТекстХвоста = Сред(Остаток, ПозицияЗакрытия + 1);
		КонецЕсли;
	КонецЕсли;

	// Вне скобок пустой токен просто исчезает, а литералы остаются: голова несёт название
	// категории, и терять его из-за незаполненных производителя с моделью нельзя.
	ДобавитьВТрассировку(Трассировка, "  голова: """ + ТекстГоловы + """");
	ДобавитьВТрассировку(Трассировка, "  група : """ + ТекстГруппы + """");
	ДобавитьВТрассировку(Трассировка, "  хвіст : """ + ТекстХвоста + """");
	ДобавитьВТрассировку(Трассировка, "");

	Голова = СобратьПоляШаблона(Объект, ТекстГоловы, Ложь,   Ложь,   Предупреждения, Трассировка, "голова");
	Группа = СобратьПоляШаблона(Объект, ТекстГруппы, Истина, Истина, Предупреждения, Трассировка, "група");
	Хвост  = СобратьПоляШаблона(Объект, ТекстХвоста, Ложь,   Ложь,   Предупреждения, Трассировка, "хвіст");

	Результат = Голова;
	Если НЕ ПустаяСтрока(Группа) Тогда
		Результат = СокрЛП(Результат) + " (" + Группа + ")";
	КонецЕсли;
	Если НЕ ПустаяСтрока(Хвост) Тогда
		Результат = СокрЛП(Результат) + " " + Хвост;
	КонецЕсли;

	// Всі реквізити порожні - у назві лишилася сама категорія. Це не найменування, а заглушка:
	// такі позиції не можна писати автоматом, інакше товар втратить назву повністю.
	Если НЕ ПустаяСтрока(ТекстГруппы) И ПустаяСтрока(Группа) Тогда
		Предупреждения.Добавить(ТекстПредупрежденияПустаяГруппа());
	КонецЕсли;

	Результат = НормализоватьФрагментНаименования(Результат);
	Если НЕ ПустаяСтрока(Результат) Тогда
		Результат = ВРег(Лев(Результат, 1)) + Сред(Результат, 2);
	КонецЕсли;

	Возврат Результат;

КонецФункции // СформироватьНаименованиеПоШаблону()

// Основная точка входа: собирает наименование по шаблону вида номенклатуры и нормализует его
// в оба языка. Возвращает структуру (База, Укр, Рус, Предупреждения) либо Неопределено,
// если для вида номенклатуры шаблон не задан - тогда вызывающий код работает по-старому.
Функция СформироватьНаименованияПоШаблону(Объект, Предупреждения = Неопределено, Словарь = Неопределено) Экспорт

	Если Предупреждения = Неопределено Тогда
		Предупреждения = Новый Массив;
	КонецЕсли;

	Шаблон = ПолучитьШаблонНаименования(Объект.ВидНоменклатуры);
	Если ПустаяСтрока(Шаблон) Тогда
		Возврат Неопределено;
	КонецЕсли;

	База = СформироватьНаименованиеПоШаблону(Объект, Шаблон, Предупреждения);
	Если ПустаяСтрока(База) Тогда
		Предупреждения.Добавить("шаблон не дав результату - не заповнені реквізити");
		Возврат Неопределено;
	КонецЕсли;

	Если Словарь = Неопределено Тогда
		Словарь = ПолучитьСловариПереводов(Объект.ВидНоменклатуры);
	КонецЕсли;

	Результат = Новый Структура("База, Укр, Рус, Предупреждения");
	Результат.База = База;
	Результат.Укр  = ПеревестиНаименованиеПоФрагментам(База, Объект.ВидНоменклатуры, Истина, Словарь);
	Результат.Рус  = ПеревестиНаименованиеПоФрагментам(База, Объект.ВидНоменклатуры, Ложь,   Словарь);

	ПроверитьНаименования(Результат.Укр, Результат.Рус, Предупреждения);
	Результат.Предупреждения = Предупреждения;

	Возврат Результат;

КонецФункции // СформироватьНаименованияПоШаблону()

// Детекторы проблем, которые платформа не показывает сама.
Процедура ПроверитьНаименования(НаименованиеУкр, НаименованиеРус, Предупреждения) Экспорт

	// Наименование усекается по длине молча, без ошибки.
	МаксДлина = Метаданные.Справочники.Номенклатура.ДлинаНаименования;
	Если СтрДлина(НаименованиеУкр) > МаксДлина Тогда
		Предупреждения.Добавить("довжина " + СтрДлина(НаименованиеУкр) + " > " + МаксДлина + " - найменування буде обрізане");
	КонецЕсли;

	// В украинском нет ы/ъ/э/ё, в русском - і/ї/є/ґ. Если буквы остались, слово не переведено.
	Если СтрокаСодержитСимволы(НРег(НаименованиеУкр), "ыъэё") Тогда
		Предупреждения.Добавить("укр. варіант містить рос. літери - слово немає у словнику");
	КонецЕсли;

	Если СтрокаСодержитСимволы(НРег(НаименованиеРус), "іїєґ") Тогда
		Предупреждения.Добавить("рос. варіант містить укр. літери - слово немає у словнику");
	КонецЕсли;

КонецПроцедуры // ПроверитьНаименования()

////////////////////////////////////////////////////////////////////////////////
// Служебные функции движка шаблонов

// Собирает часть шаблона: делит её по "|", выбрасывает поля без заполненных токенов,
// склеивает оставшиеся через " | ".
Функция СобратьПоляШаблона(Объект, ТекстЧасти, ПриводитьРегистр, ВыбрасыватьПустыеПоля, Предупреждения, Трассировка = Неопределено, ИмяЧасти = "")

	Если ПустаяСтрока(ТекстЧасти) Тогда
		Возврат "";
	КонецЕсли;

	МассивПолей = РазложитьПоРазделителю(ТекстЧасти, "|");
	Результат   = "";
	НомерПоля   = 0;

	Для Каждого ТекстПоля Из МассивПолей Цикл

		НомерПоля          = НомерПоля + 1;
		ВсегоТокенов       = 0;
		ЗаполненныхТокенов = 0;
		Текст = ПодставитьТокеныШаблона(Объект, ТекстПоля, ВсегоТокенов, ЗаполненныхТокенов, Предупреждения);

		// Внутри скобок поле, в котором были токены и все они пустые, уходит вместе со своими
		// литералами - иначе в имени повисло бы одинокое "Ключ" или " мм.".
		Если ВыбрасыватьПустыеПоля И ВсегоТокенов > 0 И ЗаполненныхТокенов = 0 Тогда
			ДобавитьВТрассировку(Трассировка, "  " + ИмяЧасти + ", поле " + НомерПоля + ": """ + ТекстПоля + """ -> викинуто (токенів " + ВсегоТокенов + ", заповнено 0)");
			Продолжить;
		КонецЕсли;

		Текст = НормализоватьФрагментНаименования(Текст);
		Если ПустаяСтрока(Текст) Тогда
			ДобавитьВТрассировку(Трассировка, "  " + ИмяЧасти + ", поле " + НомерПоля + ": """ + ТекстПоля + """ -> порожній текст, викинуто");
			Продолжить;
		КонецЕсли;

		Если ПриводитьРегистр Тогда
			Текст = ВРег(Лев(Текст, 1)) + Сред(Текст, 2);
		КонецЕсли;

		ДобавитьВТрассировку(Трассировка, "  " + ИмяЧасти + ", поле " + НомерПоля + ": """ + ТекстПоля + """ -> """ + Текст + """ (токенів " + ВсегоТокенов + ", заповнено " + ЗаполненныхТокенов + ")");

		Результат = Результат + ?(ПустаяСтрока(Результат), "", " | ") + Текст;

	КонецЦикла;

	Возврат Результат;

КонецФункции // СобратьПоляШаблона()

// Подставляет значения токенов в один фрагмент шаблона.
Функция ПодставитьТокеныШаблона(Объект, ТекстПоля, ВсегоТокенов, ЗаполненныхТокенов, Предупреждения)

	ВсегоТокенов       = 0;
	ЗаполненныхТокенов = 0;
	Результат = "";
	Остаток   = ТекстПоля;

	Пока Истина Цикл

		ПозицияНачала = Найти(Остаток, "[");
		Если ПозицияНачала = 0 Тогда
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;

		ПозицияКонца = Найти(Остаток, "]");
		Если ПозицияКонца < ПозицияНачала Тогда
			Предупреждения.Добавить("у шаблоні незакрита квадратна дужка");
			Результат = Результат + Остаток;
			Прервать;
		КонецЕсли;

		Результат      = Результат + Лев(Остаток, ПозицияНачала - 1);
		ОписаниеТокена = СокрЛП(Сред(Остаток, ПозицияНачала + 1, ПозицияКонца - ПозицияНачала - 1));
		Остаток        = Сред(Остаток, ПозицияКонца + 1);

		ВсегоТокенов = ВсегоТокенов + 1;
		Значение = ПолучитьЗначениеТокена(Объект, ОписаниеТокена, Предупреждения);
		Если НЕ ПустаяСтрока(Значение) Тогда
			ЗаполненныхТокенов = ЗаполненныхТокенов + 1;
		КонецЕсли;

		Результат = Результат + Значение;

	КонецЦикла;

	Возврат Результат;

КонецФункции // ПодставитьТокеныШаблона()

// Возвращает строковое значение одного токена с учётом условий "=" и "!".
Функция ПолучитьЗначениеТокена(Объект, ОписаниеТокена, Предупреждения)

	ИмяРеквизита   = ОписаниеТокена;
	Условие        = "";
	СписокЗначений = "";

	ПозицияРавно   = Найти(ОписаниеТокена, "=");
	ПозицияНеРавно = Найти(ОписаниеТокена, "!");

	Если ПозицияРавно > 0 Тогда
		ИмяРеквизита   = СокрЛП(Лев(ОписаниеТокена, ПозицияРавно - 1));
		СписокЗначений = Сред(ОписаниеТокена, ПозицияРавно + 1);
		Условие        = "=";
	ИначеЕсли ПозицияНеРавно > 0 Тогда
		ИмяРеквизита   = СокрЛП(Лев(ОписаниеТокена, ПозицияНеРавно - 1));
		СписокЗначений = Сред(ОписаниеТокена, ПозицияНеРавно + 1);
		Условие        = "!";
	КонецЕсли;

	Если ПустаяСтрока(ИмяРеквизита) Тогда
		Предупреждения.Добавить("у шаблоні порожній токен []");
		Возврат "";
	КонецЕсли;

	// Опечатка в имени реквизита должна быть видна, а не молча давать пустую строку.
	Попытка
		Значение = Объект[ИмяРеквизита];
	Исключение
		Предупреждения.Добавить("невідомий реквізит у шаблоні: [" + ИмяРеквизита + "]");
		Возврат "";
	КонецПопытки;

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Текст = СокрЛП(Формат(Значение, "ЧГ=0"));
	Иначе
		Текст = СокрЛП(Строка(Значение));
	КонецЕсли;

	Если ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Если НЕ ПустаяСтрока(Условие) Тогда
		Совпало = Ложь;
		Для Каждого ЭталонноеЗначение Из РазложитьПоРазделителю(СписокЗначений, ";") Цикл
			Если НРег(СокрЛП(ЭталонноеЗначение)) = НРег(Текст) Тогда
				Совпало = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если (Условие = "=" И НЕ Совпало) ИЛИ (Условие = "!" И Совпало) Тогда
			Возврат "";
		КонецЕсли;
	КонецЕсли;

	Текст = НормализоватьРезьбу(Текст);

	// "|" - разделитель полей нового формата, внутри значения он ломает читаемость наименования.
	Если Найти(Текст, "|") > 0 Тогда
		Предупреждения.Добавить("значення реквізиту [" + ИмяРеквизита + "] містить символ ""|""");
	КонецЕсли;

	Возврат Текст;

КонецФункции // ПолучитьЗначениеТокена()

// Убирает двойные пробелы и висящие "/", оставшиеся после выброшенных токенов.
Функция НормализоватьФрагментНаименования(Текст)

	Результат = Текст;

	// Пробіл поруч зі слешем означає, що один з операндів не заповнений:
	// "Проставки /5x120", "DIA 74,1/ ". Слеш-сироту прибираємо, а не приклеюємо ним сусіда.
	Результат = СтрЗаменить(Результат, " /", " ");
	Результат = СтрЗаменить(Результат, "/ ", " ");
	Пока Найти(Результат, "//") > 0 Цикл
		Результат = СтрЗаменить(Результат, "//", "/");
	КонецЦикла;

	Пока Найти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;

	Результат = СокрЛП(Результат);

	Пока СтрДлина(Результат) > 0 И Прав(Результат, 1) = "/" Цикл
		Результат = СокрЛП(Лев(Результат, СтрДлина(Результат) - 1));
	КонецЦикла;

	Пока СтрДлина(Результат) > 0 И Лев(Результат, 1) = "/" Цикл
		Результат = СокрЛП(Сред(Результат, 2));
	КонецЦикла;

	Возврат Результат;

КонецФункции // НормализоватьФрагментНаименования()

Функция РазложитьПоРазделителю(Текст, Разделитель)

	Результат = Новый Массив;
	Остаток   = Текст;

	Позиция = Найти(Остаток, Разделитель);
	Пока Позиция > 0 Цикл
		Результат.Добавить(Лев(Остаток, Позиция - 1));
		Остаток = Сред(Остаток, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Остаток, Разделитель);
	КонецЦикла;
	Результат.Добавить(Остаток);

	Возврат Результат;

КонецФункции // РазложитьПоРазделителю()

Функция ПоследняяПозицияСимвола(Текст, Символ)

	Результат = 0;
	Позиция   = Найти(Текст, Символ);

	Пока Позиция > 0 Цикл
		Результат = Результат + Позиция;
		Позиция   = Найти(Сред(Текст, Результат + 1), Символ);
	КонецЦикла;

	Возврат Результат;

КонецФункции // ПоследняяПозицияСимвола()

Функция СтрокаСодержитСимволы(Текст, НаборСимволов)

	Для Счетчик = 1 По СтрДлина(НаборСимволов) Цикл
		Если Найти(Текст, Сред(НаборСимволов, Счетчик, 1)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции // СтрокаСодержитСимволы()


////////////////////////////////////////////////////////////////////////////////
//
// Три режима, один и тот же движок:
//   ПодготовитьПерегенерациюНаименований()   - предпросмотр, НИЧЕГО не пишет;
//   ЗаписатьПерегенерированныеНаименования() - запись отмеченных строк + история;
//   ОткатитьНаименования()                   - вернуть предыдущие значения из истории.
//
// Запись идёт с ОбменДанными.Загрузка = Истина. Причина: подписка
// БП_ОбменMagento.MagentoПередЗаписьюНоменклатурыПередЗаписью на каждую запись пускает
// фоновое задание с ФИКСИРОВАННЫМ ключом "MagentoID"/"MagentoGarazhID" - при массовой
// перезаписи задания конфликтуют по ключу. Регистрацию изменений в плане обмена "Сайт",
// которую при этом теряет ПриЗаписи(), делаем здесь явно, а выгрузку на сайт -
// пачками через БП_ОбменMagentoВФоне.ВыгрузитьМассивНоменклатурыНаСайт().
////////////////////////////////////////////////////////////////////////////////

// Возвращает массив уникальных имён реквизитов, использованных в шаблоне.
Функция ИменаРеквизитовШаблона(Шаблон) Экспорт

	Результат = Новый Массив;
	Найденные = Новый Соответствие;
	Остаток   = Шаблон;

	Пока Истина Цикл

		ПозицияНачала = Найти(Остаток, "[");
		Если ПозицияНачала = 0 Тогда
			Прервать;
		КонецЕсли;

		ПозицияКонца = Найти(Остаток, "]");
		Если ПозицияКонца < ПозицияНачала Тогда
			Прервать;
		КонецЕсли;

		ОписаниеТокена = СокрЛП(Сред(Остаток, ПозицияНачала + 1, ПозицияКонца - ПозицияНачала - 1));
		Остаток = Сред(Остаток, ПозицияКонца + 1);

		ПозицияРавно   = Найти(ОписаниеТокена, "=");
		ПозицияНеРавно = Найти(ОписаниеТокена, "!");
		Если ПозицияРавно > 0 Тогда
			ОписаниеТокена = СокрЛП(Лев(ОписаниеТокена, ПозицияРавно - 1));
		ИначеЕсли ПозицияНеРавно > 0 Тогда
			ОписаниеТокена = СокрЛП(Лев(ОписаниеТокена, ПозицияНеРавно - 1));
		КонецЕсли;

		Если НЕ ПустаяСтрока(ОписаниеТокена) И Найденные[ВРег(ОписаниеТокена)] = Неопределено Тогда
			Найденные.Вставить(ВРег(ОписаниеТокена), Истина);
			Результат.Добавить(ОписаниеТокена);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции // ИменаРеквизитовШаблона()

// Предпросмотр перегенерации. Ничего не записывает.
//
// Возвращает таблицу значений: Пометка, Номенклатура, Код, БылоУкр, СталоУкр, БылоРус,
// СталоРус, Изменилось, Предупреждения. Позиции с установленным флагом
// БП_РучнаяКоректировкаНаименования, а также помеченные "Не выгружать на сайт",
// в выборку не попадают.
// Список видов номенклатуры, для которых заведён непустой шаблон.
Функция ПолучитьВидыСШаблонами() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ШаблоныНаименований.ВидНоменклатуры КАК ВидНоменклатуры
	                      |ИЗ
	                      |	Справочник.ШаблоныНаименований КАК ШаблоныНаименований
	                      |ГДЕ
	                      |	НЕ ШаблоныНаименований.ПометкаУдаления
	                      |	И ШаблоныНаименований.ВидНоменклатуры <> ЗНАЧЕНИЕ(Справочник.ВидыНоменклатуры.ПустаяСсылка)
	                      |	И ШаблоныНаименований.Шаблон <> """"
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ВидНоменклатуры");

	Результат = Новый Массив;
	Выборка   = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.ВидНоменклатуры);
	КонецЦикла;

	Возврат Результат;

КонецФункции // ПолучитьВидыСШаблонами()

// Предпросмотр перегенерации. НИЧЕГО не записывает.
//
// Вид номенклатуры выбран - работаем по нему. Вид НЕ выбран - идём по всем видам,
// для которых заведён шаблон, и делим лимит строк между ними: нужен срез по каждой
// категории, а не десять тысяч позиций одной. Без лимита в этом режиме подставляется 100 -
// иначе первая же попытка вытащит весь справочник.
//
// Возвращает таблицу значений: Пометка, ВидНоменклатуры, Номенклатура, Код, БылоУкр, СталоУкр,
// БылоРус, СталоРус, Изменилось, Предупреждения. Позиции с установленным флагом
// БП_РучнаяКоректировкаНаименования, а также помеченные "Не выгружать на сайт",
// в выборку не попадают.
Функция ПодготовитьПерегенерациюНаименований(ВидНоменклатуры, НаименованиеСодержит = "", МаксСтрок = 0, Сообщение = "") Экспорт

	Сообщение = "";
	Результат = СоздатьТаблицуПерегенерации();

	Если ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		ЗаполнитьПерегенерациюПоВиду(Результат, ВидНоменклатуры, НаименованиеСодержит, МаксСтрок, Сообщение);
		Возврат Результат;
	КонецЕсли;

	МассивВидов = ПолучитьВидыСШаблонами();
	Если МассивВидов.Количество() = 0 Тогда
		Сообщение = "Жодного шаблону не заведено - нічого робити.";
		Возврат Результат;
	КонецЕсли;

	ОбщийЛимит  = ?(МаксСтрок > 0, МаксСтрок, 100);
	БазоваяДоля = Цел(ОбщийЛимит / МассивВидов.Количество());
	Остаток     = ОбщийЛимит - БазоваяДоля * МассивВидов.Количество();

	ТекстыСообщений = Новый Массив;
	Если МаксСтрок = 0 Тогда
		ТекстыСообщений.Добавить("вид не обрано і ліміт не заданий - взято 100 рядків");
	КонецЕсли;

	Номер = 0;
	Для Каждого Вид Из МассивВидов Цикл

		Номер = Номер + 1;
		Доля  = БазоваяДоля + ?(Номер <= Остаток, 1, 0);
		// хотя бы одна строка на вид: иначе при малом лимите категории просто выпадут из среза
		Доля  = Макс(Доля, 1);

		СообщениеВида = "";
		ЗаполнитьПерегенерациюПоВиду(Результат, Вид, НаименованиеСодержит, Доля, СообщениеВида);

		Если НЕ ПустаяСтрока(СообщениеВида) Тогда
			ТекстыСообщений.Добавить(Строка(Вид) + ": " + СообщениеВида);
		КонецЕсли;

	КонецЦикла;

	ТекстыСообщений.Вставить(0, "Видів з шаблонами: " + МассивВидов.Количество()
		+ ", приблизно по " + Макс(БазоваяДоля, 1) + " рядків на вид.");
	Сообщение = СоединитьМассивСтрок(ТекстыСообщений, Символы.ПС);

	Возврат Результат;

КонецФункции // ПодготовитьПерегенерациюНаименований()

Функция СоздатьТаблицуПерегенерации()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Пометка",         Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ВидНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ВидыНоменклатуры"));
	Результат.Колонки.Добавить("Номенклатура",    Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Код");
	Результат.Колонки.Добавить("БылоУкр");
	Результат.Колонки.Добавить("СталоУкр");
	Результат.Колонки.Добавить("БылоРус");
	Результат.Колонки.Добавить("СталоРус");
	Результат.Колонки.Добавить("Изменилось",      Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Предупреждения");

	Возврат Результат;

КонецФункции // СоздатьТаблицуПерегенерации()

// Дописывает в таблицу строки по одному виду номенклатуры.
Процедура ЗаполнитьПерегенерациюПоВиду(Результат, ВидНоменклатуры, НаименованиеСодержит, МаксСтрок, Сообщение)

	Сообщение = "";

	Шаблон = ПолучитьШаблонНаименования(ВидНоменклатуры);
	Если ПустаяСтрока(Шаблон) Тогда
		Сообщение = "шаблон не заданий - нічого робити";
		Возврат;
	КонецЕсли;

	Если КоличествоШаблоновДляВида(ВидНоменклатуры) > 1 Тогда
		Сообщение = "УВАГА: заведено кілька шаблонів - береться перший-ліпший, приберіть зайві";
	КонецЕсли;

	МассивРеквизитов = ИменаРеквизитовШаблона(Шаблон);
	Если МассивРеквизитов.Количество() = 0 Тогда
		Сообщение = "у шаблоні немає жодного токена [Реквізит]";
		Возврат;
	КонецЕсли;

	// Поля выбираются динамически по составу шаблона: так значения реквизитов достаются
	// одним запросом, без ПолучитьОбъект() на каждую позицию.
	ТекстРеквизитов = "";
	Для Каждого ИмяРеквизита Из МассивРеквизитов Цикл
		ТекстРеквизитов = ТекстРеквизитов + "," + Символы.ПС
			+ "	Номенклатура." + ИмяРеквизита + " КАК " + ИмяРеквизита;
	КонецЦикла;

	ТекстЗапроса = "ВЫБРАТЬ " + ?(МаксСтрок > 0, "ПЕРВЫЕ " + Формат(МаксСтрок, "ЧГ=0"), "") + Символы.ПС
		+ "	Номенклатура.Ссылка КАК ПерегенСсылка," + Символы.ПС
		+ "	Номенклатура.Код КАК ПерегенКод," + Символы.ПС
		+ "	Номенклатура.Наименование КАК ПерегенБылоУкр," + Символы.ПС
		+ "	Номенклатура.БП_НаименованиеРу КАК ПерегенБылоРус"
		+ ТекстРеквизитов + Символы.ПС
		+ "ИЗ" + Символы.ПС
		+ "	Справочник.Номенклатура КАК Номенклатура" + Символы.ПС
		+ "ГДЕ" + Символы.ПС
		+ "	НЕ Номенклатура.ЭтоГруппа" + Символы.ПС
		+ "	И НЕ Номенклатура.ПометкаУдаления" + Символы.ПС
		+ "	И НЕ Номенклатура.БП_РучнаяКоректировкаНаименования" + Символы.ПС
		+ "	И НЕ Номенклатура.НеВыгружатьНаСайт" + Символы.ПС
		+ "	И Номенклатура.ВидНоменклатуры = &ВидНоменклатуры";

	Если НЕ ПустаяСтрока(НаименованиеСодержит) Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	И Номенклатура.Наименование ПОДОБНО &НаименованиеСодержит";
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + "	Номенклатура.Наименование";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);
	Если НЕ ПустаяСтрока(НаименованиеСодержит) Тогда
		Запрос.УстановитьПараметр("НаименованиеСодержит", "%" + НаименованиеСодержит + "%");
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	// Словари читаются один раз на весь вид, иначе запрос уходил бы на каждый фрагмент.
	Словарь   = ПолучитьСловариПереводов(ВидНоменклатуры);
	МаксДлина = Метаданные.Справочники.Номенклатура.ДлинаНаименования;

	Пока Выборка.Следующий() Цикл

		Предупреждения = Новый Массив;
		База = СформироватьНаименованиеПоШаблону(Выборка, Шаблон, Предупреждения);

		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.ВидНоменклатуры = ВидНоменклатуры;
		НоваяСтрока.Номенклатура    = Выборка.ПерегенСсылка;
		НоваяСтрока.Код             = Выборка.ПерегенКод;
		НоваяСтрока.БылоУкр         = Выборка.ПерегенБылоУкр;
		НоваяСтрока.БылоРус         = Выборка.ПерегенБылоРус;

		Если ПустаяСтрока(База) Тогда
			Предупреждения.Добавить("шаблон не дав результату - не заповнені реквізити");
			НоваяСтрока.СталоУкр       = "";
			НоваяСтрока.СталоРус       = "";
			НоваяСтрока.Изменилось     = Ложь;
			НоваяСтрока.Пометка        = Ложь;
			НоваяСтрока.Предупреждения = СоединитьМассивСтрок(Предупреждения, "; ");
			Продолжить;
		КонецЕсли;

		Укр = ПеревестиНаименованиеПоФрагментам(База, ВидНоменклатуры, Истина, Словарь);
		Рус = ПеревестиНаименованиеПоФрагментам(База, ВидНоменклатуры, Ложь,  Словарь);
		ПроверитьНаименования(Укр, Рус, Предупреждения);

		НоваяСтрока.СталоУкр   = Укр;
		НоваяСтрока.СталоРус   = Рус;
		НоваяСтрока.Изменилось = (Укр <> Выборка.ПерегенБылоУкр) ИЛИ (Рус <> Выборка.ПерегенБылоРус);
		// Строки, которые запись всё равно пропустит или испортит, отмечать не за чем.
		НоваяСтрока.Пометка = НоваяСтрока.Изменилось
			И СтрДлина(Укр) <= МаксДлина
			И НЕ МассивСодержит(Предупреждения, ТекстПредупрежденияПустаяГруппа());
		НоваяСтрока.Предупреждения = СоединитьМассивСтрок(Предупреждения, "; ");

	КонецЦикла;

КонецПроцедуры // ЗаполнитьПерегенерациюПоВиду()

// Записывает отмеченные строки предпросмотра. Возвращает структуру
// (Записано, Пропущено, МассивЗаписанных, Ошибки).
//
// Строки, у которых укр. наименование длиннее допустимого, НЕ пишутся: платформа обрезала бы
// его молча, и на сайт уехало бы битое имя. Такие строки попадают в Ошибки.
Функция ЗаписатьПерегенерированныеНаименования(ТаблицаСтрок, Комментарий = "", ТолькоОтмеченные = Истина) Экспорт

	МассивЗаписанных = Новый Массив;
	Ошибки           = Новый Массив;
	Пропущено        = 0;
	МаксДлина        = Метаданные.Справочники.Номенклатура.ДлинаНаименования;

	Для Каждого СтрокаТаблицы Из ТаблицаСтрок Цикл

		Если (ТолькоОтмеченные И НЕ СтрокаТаблицы.Пометка) ИЛИ НЕ СтрокаТаблицы.Изменилось Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Если ПустаяСтрока(СтрокаТаблицы.СталоУкр) Тогда
			Пропущено = Пропущено + 1;
			Ошибки.Добавить(Строка(СтрокаТаблицы.Номенклатура) + ": порожнє нове найменування");
			Продолжить;
		КонецЕсли;

		Если СтрДлина(СтрокаТаблицы.СталоУкр) > МаксДлина Тогда
			Пропущено = Пропущено + 1;
			Ошибки.Добавить(Строка(СтрокаТаблицы.Номенклатура) + ": довжина "
				+ СтрДлина(СтрокаТаблицы.СталоУкр) + " > " + МаксДлина + ", запис пропущено");
			Продолжить;
		КонецЕсли;

		Попытка

			Объект = СтрокаТаблицы.Номенклатура.ПолучитьОбъект();

			ЗаписатьИсториюНаименования(Объект, СтрокаТаблицы.СталоУкр, Комментарий);

			Объект.Наименование            = СтрокаТаблицы.СталоУкр;
			Объект.НаименованиеПолное      = СтрокаТаблицы.СталоУкр;
			Объект.БП_НаименованиеРу       = СтрокаТаблицы.СталоРус;
			Объект.БП_НаименованиеПолноеРу = СтрокаТаблицы.СталоРус;

			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();

			ЗарегистрироватьИзмененияДляСайта(Объект.Ссылка);
			МассивЗаписанных.Добавить(Объект.Ссылка);

		Исключение
			Ошибки.Добавить(Строка(СтрокаТаблицы.Номенклатура) + ": " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Результат = Новый Структура("Записано, Пропущено, МассивЗаписанных, Ошибки");
	Результат.Записано         = МассивЗаписанных.Количество();
	Результат.Пропущено        = Пропущено;
	Результат.МассивЗаписанных = МассивЗаписанных;
	Результат.Ошибки           = Ошибки;

	Возврат Результат;

КонецФункции // ЗаписатьПерегенерированныеНаименования()

// Возвращает наименования из последней записи истории и удаляет эту запись,
// поэтому повторный откат шагает по истории дальше назад.
// Возвращает структуру (Откачено, МассивОткаченных, Ошибки).
Функция ОткатитьНаименования(МассивНоменклатуры) Экспорт

	МассивОткаченных = Новый Массив;
	Ошибки           = Новый Массив;

	Для Каждого СсылкаНоменклатуры Из МассивНоменклатуры Цикл

		Попытка

			Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
			                      |	История.Период КАК Период,
			                      |	История.НаименованиеДо КАК НаименованиеДо,
			                      |	История.НаименованиеПолноеДо КАК НаименованиеПолноеДо,
			                      |	История.НаименованиеРуДо КАК НаименованиеРуДо,
			                      |	История.НаименованиеПолноеРуДо КАК НаименованиеПолноеРуДо
			                      |ИЗ
			                      |	РегистрСведений.ИсторияНаименованийНоменклатуры КАК История
			                      |ГДЕ
			                      |	История.Номенклатура = &Номенклатура
			                      |
			                      |УПОРЯДОЧИТЬ ПО
			                      |	Период УБЫВ");
			Запрос.УстановитьПараметр("Номенклатура", СсылкаНоменклатуры);

			Выборка = Запрос.Выполнить().Выбрать();
			Если НЕ Выборка.Следующий() Тогда
				Ошибки.Добавить(Строка(СсылкаНоменклатуры) + ": в історії немає записів");
				Продолжить;
			КонецЕсли;

			Объект = СсылкаНоменклатуры.ПолучитьОбъект();
			Объект.Наименование            = Выборка.НаименованиеДо;
			Объект.НаименованиеПолное      = Выборка.НаименованиеПолноеДо;
			Объект.БП_НаименованиеРу       = Выборка.НаименованиеРуДо;
			Объект.БП_НаименованиеПолноеРу = Выборка.НаименованиеПолноеРуДо;

			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();

			НаборЗаписей = РегистрыСведений.ИсторияНаименованийНоменклатуры.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Номенклатура.Установить(СсылкаНоменклатуры);
			НаборЗаписей.Отбор.Период.Установить(Выборка.Период);
			НаборЗаписей.Записать(Истина);

			ЗарегистрироватьИзмененияДляСайта(СсылкаНоменклатуры);
			МассивОткаченных.Добавить(СсылкаНоменклатуры);

		Исключение
			Ошибки.Добавить(Строка(СсылкаНоменклатуры) + ": " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

	Результат = Новый Структура("Откачено, МассивОткаченных, Ошибки");
	Результат.Откачено         = МассивОткаченных.Количество();
	Результат.МассивОткаченных = МассивОткаченных;
	Результат.Ошибки           = Ошибки;

	Возврат Результат;

КонецФункции // ОткатитьНаименования()

////////////////////////////////////////////////////////////////////////////////
// Служебные функции пакетной перегенерации

Процедура ЗаписатьИсториюНаименования(Объект, НаименованиеПосле, Комментарий)

	Запись = РегистрыСведений.ИсторияНаименованийНоменклатуры.СоздатьМенеджерЗаписи();
	Запись.Период       = ТекущаяДата();
	Запись.Номенклатура = Объект.Ссылка;

	Запись.НаименованиеДо         = Объект.Наименование;
	Запись.НаименованиеПолноеДо   = Объект.НаименованиеПолное;
	Запись.НаименованиеРуДо       = Объект.БП_НаименованиеРу;
	Запись.НаименованиеПолноеРуДо = Объект.БП_НаименованиеПолноеРу;
	Запись.НаименованиеПосле      = НаименованиеПосле;

	Запись.Пользователь = ПараметрыСеанса.ТекущийПользователь;
	Запись.Комментарий  = Лев(Комментарий, 200);

	Запись.Записать(Истина);

КонецПроцедуры // ЗаписатьИсториюНаименования()

// То, что делает ПриЗаписи() объекта и что теряется при ОбменДанными.Загрузка = Истина.
Процедура ЗарегистрироватьИзмененияДляСайта(СсылкаНоменклатуры)

	СсылкаНаУзел = ПланыОбмена.Сайт.НайтиПоКоду("Сайт").Ссылка;
	Если ЗначениеЗаполнено(СсылкаНаУзел) Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(СсылкаНаУзел, СсылкаНоменклатуры);
	КонецЕсли;

КонецПроцедуры // ЗарегистрироватьИзмененияДляСайта()

Функция СоединитьМассивСтрок(МассивСтрок, Разделитель)

	Результат = "";
	Для Каждого ЭлементМассива Из МассивСтрок Цикл
		Результат = Результат + ?(ПустаяСтрока(Результат), "", Разделитель) + Строка(ЭлементМассива);
	КонецЦикла;

	Возврат Результат;

КонецФункции // СоединитьМассивСтрок()

Процедура ДобавитьВТрассировку(Трассировка, Текст)

	Если Трассировка <> Неопределено Тогда
		Трассировка.Добавить(Текст);
	КонецЕсли;

КонецПроцедуры // ДобавитьВТрассировку()

////////////////////////////////////////////////////////////////////////////////
// Диагностика: пошаговый разбор шаблона для одной позиции.
//
// Трассировку пишет САМ движок (параметр Трассировка у СобратьПоляШаблона), а не
// отдельная копия логики - иначе отчёт со временем начал бы расходиться с тем, что реально
// выполняется, и диагностика врала бы ровно тогда, когда она нужнее всего.
////////////////////////////////////////////////////////////////////////////////

// Сколько строк шаблона заведено для вида. Больше одной - берётся первая попавшаяся,
// и результат становится непредсказуемым.
Функция КоличествоШаблоновДляВида(ВидНоменклатуры) Экспорт

	Если НЕ ЗначениеЗаполнено(ВидНоменклатуры) Тогда
		Возврат 0;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КОЛИЧЕСТВО(*) КАК Кво
	                      |ИЗ
	                      |	Справочник.ШаблоныНаименований КАК ШаблоныНаименований
	                      |ГДЕ
	                      |	ШаблоныНаименований.ВидНоменклатуры = &ВидНоменклатуры
	                      |	И НЕ ШаблоныНаименований.ПометкаУдаления");
	Запрос.УстановитьПараметр("ВидНоменклатуры", ВидНоменклатуры);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Кво;
	КонецЕсли;

	Возврат 0;

КонецФункции // КоличествоШаблоновДляВида()

// Возвращает текстовый отчёт о том, как шаблон отработал на конкретной позиции.
Функция ДиагностикаНаименования(СсылкаНоменклатуры) Экспорт

	Отчет = Новый Массив;
	Отчет.Добавить("=== Діагностика найменування ===");

	Если НЕ ЗначениеЗаполнено(СсылкаНоменклатуры) Тогда
		Отчет.Добавить("Не передано номенклатуру.");
		Возврат СоединитьМассивСтрок(Отчет, Символы.ПС);
	КонецЕсли;

	Объект = СсылкаНоменклатуры.ПолучитьОбъект();

	Отчет.Добавить("Номенклатура : " + Строка(СсылкаНоменклатуры) + "   (код " + СокрЛП(Объект.Код) + ")");
	Отчет.Добавить("Вид          : " + Строка(Объект.ВидНоменклатуры));
	Отчет.Добавить("Артикул      : " + СокрЛП(Строка(Объект.Артикул)));
	Отчет.Добавить("");

	КвоШаблонов = КоличествоШаблоновДляВида(Объект.ВидНоменклатуры);
	Отчет.Добавить("Шаблонів для виду: " + КвоШаблонов);
	Если КвоШаблонов > 1 Тогда
		Отчет.Добавить("  !!! УВАГА: для виду заведено кілька шаблонів, береться перший-ліпший.");
	КонецЕсли;

	Шаблон = ПолучитьШаблонНаименования(Объект.ВидНоменклатуры);
	Если ПустаяСтрока(Шаблон) Тогда
		Отчет.Добавить("Шаблон не заданий - працює стара логіка ЗаполнитьНаименование().");
		Возврат СоединитьМассивСтрок(Отчет, Символы.ПС);
	КонецЕсли;
	Отчет.Добавить("Шаблон       : " + Шаблон);
	Отчет.Добавить("");

	// Значения реквизитов, на которые шаблон ссылается.
	Отчет.Добавить("--- Реквізити шаблону ---");
	Для Каждого ИмяРеквизита Из ИменаРеквизитовШаблона(Шаблон) Цикл
		Попытка
			Значение = Объект[ИмяРеквизита];
		Исключение
			Отчет.Добавить("  " + ДополнитьСправа(ИмяРеквизита, 26) + "= !!! такого реквізиту немає");
			Продолжить;
		КонецПопытки;

		Если ЗначениеЗаполнено(Значение) Тогда
			Отчет.Добавить("  " + ДополнитьСправа(ИмяРеквизита, 26) + "= " + СокрЛП(Строка(Значение)));
		Иначе
			Отчет.Добавить("  " + ДополнитьСправа(ИмяРеквизита, 26) + "= <порожньо>");
		КонецЕсли;
	КонецЦикла;
	Отчет.Добавить("");

	Предупреждения = Новый Массив;
	Трассировка    = Новый Массив;

	База = СформироватьНаименованиеПоШаблону(Объект, Шаблон, Предупреждения, Трассировка);

	Отчет.Добавить("--- Розбір шаблону по полях ---");
	Для Каждого СтрокаТрассировки Из Трассировка Цикл
		Отчет.Добавить(СтрокаТрассировки);
	КонецЦикла;
	Отчет.Добавить("");

	Словарь = ПолучитьСловариПереводов(Объект.ВидНоменклатуры);
	Укр = ПеревестиНаименованиеПоФрагментам(База, Объект.ВидНоменклатуры, Истина, Словарь);
	Рус = ПеревестиНаименованиеПоФрагментам(База, Объект.ВидНоменклатуры, Ложь,  Словарь);
	ПроверитьНаименования(Укр, Рус, Предупреждения);

	Отчет.Добавить("--- Результат ---");
	Отчет.Добавить("  Було (укр) : " + Объект.Наименование);
	Отчет.Добавить("  Було (рус) : " + Объект.БП_НаименованиеРу);
	Отчет.Добавить("  База       : " + База);
	Отчет.Добавить("  Стало (укр): " + Укр);
	Отчет.Добавить("  Стало (рус): " + Рус);
	Отчет.Добавить("  Довжина укр: " + СтрДлина(Укр) + " з " + Метаданные.Справочники.Номенклатура.ДлинаНаименования);
	Отчет.Добавить("  Слів у словнику рос.->укр. (БП_СоответствиеРуУкрСлов): " + Словарь.РуУкр.Количество());
	Отчет.Добавить("  Слів у словнику укр.->рос. (БП_СоответствиеУкрРуСлов): " + Словарь.УкрРу.Количество());
	Отчет.Добавить("");

	Отчет.Добавить("--- Попередження ---");
	Если Предупреждения.Количество() = 0 Тогда
		Отчет.Добавить("  немає");
	Иначе
		Для Каждого Предупреждение Из Предупреждения Цикл
			Отчет.Добавить("  " + Предупреждение);
		КонецЦикла;
	КонецЕсли;

	Возврат СоединитьМассивСтрок(Отчет, Символы.ПС);

КонецФункции // ДиагностикаНаименования()

Функция ДополнитьСправа(Текст, Длина)

	Результат = СокрЛП(Текст);
	Пока СтрДлина(Результат) < Длина Цикл
		Результат = Результат + " ";
	КонецЦикла;

	Возврат Результат;

КонецФункции // ДополнитьСправа()

// Приводит резьбу к единому виду: 12*1,5 / 12х1.5 / 12 X 1.5 / М12х1.5 -> 12x1,5.
//
// В справочнике резьбы живут все три написания сразу, а в словаре перекладу кто-то завёл
// пары вида «14*1,5 -> 14x1,5» - из-за этого укр. и рус. варианты имени расходились между собой.
//
// Нормализуем ТОЛЬКО если всё значение целиком - это резьба: «диаметр разделитель шаг».
// Иначе легко испортить модель или артикул, где те же символы значат совсем другое
// (382/M-2CH, AG5/E23-2CH, 416444x2, 1/2").
Функция НормализоватьРезьбу(Текст)

	Значение = СтрЗаменить(СокрЛП(Текст), " ", "");
	Если СтрДлина(Значение) < 3 Тогда
		Возврат Текст;
	КонецЕсли;

	Префикс     = "";
	ПерваяБуква = Лев(Значение, 1);
	Если ПерваяБуква = "М" ИЛИ ПерваяБуква = "M" Тогда
		Префикс  = ПерваяБуква;
		Значение = Сред(Значение, 2);
	КонецЕсли;

	Разделители        = "*xхXХ×";
	ПозицияРазделителя = 0;
	Для Счетчик = 1 По СтрДлина(Значение) Цикл
		Если Найти(Разделители, Сред(Значение, Счетчик, 1)) > 0 Тогда
			Если ПозицияРазделителя > 0 Тогда
				Возврат Текст;   // два разделителя - это уже не резьба
			КонецЕсли;
			ПозицияРазделителя = Счетчик;
		КонецЕсли;
	КонецЦикла;

	Если ПозицияРазделителя = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Диаметр = Лев(Значение, ПозицияРазделителя - 1);
	Шаг     = Сред(Значение, ПозицияРазделителя + 1);

	Если НЕ ЭтоЦелоеЧисло(Диаметр) ИЛИ НЕ ЭтоДробноеЧисло(Шаг) Тогда
		Возврат Текст;
	КонецЕсли;

	Возврат Префикс + Диаметр + "x" + СтрЗаменить(Шаг, ".", ",");

КонецФункции // НормализоватьРезьбу()

Функция ЭтоЦелоеЧисло(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Счетчик = 1 По СтрДлина(Текст) Цикл
		Если Найти("0123456789", Сред(Текст, Счетчик, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции // ЭтоЦелоеЧисло()

Функция ЭтоДробноеЧисло(Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	КвоРазделителей = 0;
	Для Счетчик = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Счетчик, 1);
		Если Символ = "," ИЛИ Символ = "." Тогда
			КвоРазделителей = КвоРазделителей + 1;
			Если КвоРазделителей > 1 Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли Найти("0123456789", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции // ЭтоДробноеЧисло()

Функция ТекстПредупрежденияПустаяГруппа()

	Возврат "жоден реквізит у дужках не заповнений - у назві лишилася сама категорія";

КонецФункции // ТекстПредупрежденияПустаяГруппа()

Функция МассивСодержит(Массив, Значение)

	Для Каждого ЭлементМассива Из Массив Цикл
		Если ЭлементМассива = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции // МассивСодержит()
