// Дата "Діє з" у строк таблицы лимитов ОрганизацииПоСумме.
// С этого момента для ступени строки заново считаются заказы при выборе счёта
// (БП_ОбщийМодуль.СтрокаСНаименьшимЧисломЗаказов): иначе счёт, добавленный посреди дня,
// получал бы подряд все заказы, пока не догонит остальные.
// Дата ставится строке, которой не было в прежней версии элемента, - новой или изменённой
// (другая сумма, организация или счёт). Перестановка строк дату не трогает.

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка тогда
		Возврат;
	КонецЕсли;
	
	ПрежниеСтроки = Неопределено;
	Если Не ЭтоНовый() тогда
		ПрежниеСтроки = Ссылка.ОрганизацииПоСумме.Выгрузить();
	КонецЕсли;
	
	Для каждого СтрокаЛимита Из ОрганизацииПоСумме Цикл
		
		СтрокаБылаРаньше = Ложь;
		Если ПрежниеСтроки <> Неопределено тогда
			Отбор = Новый Структура("СуммаДо, Организация, БанковскийСчет",
				СтрокаЛимита.СуммаДо, СтрокаЛимита.Организация, СтрокаЛимита.БанковскийСчет);
			СтрокаБылаРаньше = ПрежниеСтроки.НайтиСтроки(Отбор).Количество() > 0;
		КонецЕсли;
		
		Если Не СтрокаБылаРаньше тогда
			СтрокаЛимита.ДействуетС = ТекущаяДата();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
