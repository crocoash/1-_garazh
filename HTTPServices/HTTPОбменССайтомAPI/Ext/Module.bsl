// Логирование входящих заказов с сайта.
//
// Тело запроса раньше нигде не сохранялось: при сбое обработчик отдаёт 400 с описанием
// ошибки, а сам JSON пропадал - разбирать "заказ с сайта не создался" было нечем.
// Пишем в журнал регистрации, а не в регистр сведений: журнал лежит в каталоге кластера
// на сервере 1С, а не в таблицах СУБД, поэтому не растит базу и не попадает в бэкапы,
// и нового объекта метаданных под него заводить не нужно.
//
// Успешные запросы логируются целиком, пока идёт разбор формата обмена: нужны реальные
// примеры payload, а урезанная запись как раз и скроет ключи, о которых мы не знаем
// (ref города и отделения Новой Почты). Когда маппинг адреса доставки будет готов -
// убрать вызовы ЗапросСайтаВЖурнал, оставить только ОшибкаСайтаВЖурнал.
//
Процедура ЗапросСайтаВЖурнал(Знач Метод, Знач Тело)

	ЗаписьЖурналаРегистрации("Magento.Заказ",
		УровеньЖурналаРегистрации.Информация, , ,
		Метод + ": " + Тело);

КонецПроцедуры

// Ошибка обработки запроса с сайта. Текст ошибки берётся в самом блоке Исключение
// и передаётся сюда параметром: вызов ИнформацияОбОшибке() из вложенной процедуры
// опирался бы на контекст обработчика исключения, а это лишнее допущение.
//
Процедура ОшибкаСайтаВЖурнал(Знач Метод, Знач Тело, Знач ТекстОшибки)

	ЗаписьЖурналаРегистрации("Magento.Заказ",
		УровеньЖурналаРегистрации.Ошибка, , ,
		Метод + " не выполнен: " + ТекстОшибки
		+ Символы.ПС + "Тело запроса: " + Тело);

КонецПроцедуры
//-БП: claude (27.08.2026) <>

Процедура ОтветCustomerПровал(Ответ,ОписаниеОшибки)
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("code", "400");
	СтруктураОтвета.Вставить("message", "Внутрішня помилка системи");
	СтруктураОтвета.Вставить("ОписаниеОшибки", ОписаниеОшибки);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
	СтрокаДляОтвета = ЗаписьJSON.Закрыть();
	
	Ответ.КодСостояния = 400;
	Ответ.Заголовки.Вставить("Content-type", "application/json");
	Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);		
	
КонецПроцедуры

Функция CustomerCreateCreatePost(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	СтрокаЗапросаJSON = Запрос.ПолучитьТелоКакСтроку();
	
	Попытка
		БП_ОбменMagento.СоздатьCustomerMagento(СтрокаЗапросаJSON, Ответ);
	Исключение
		ОтветCustomerПровал(Ответ,ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

