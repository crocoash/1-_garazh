Функция TerminalPay(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	QueryType = Запрос.ПараметрыЗапроса.Получить("QueryType");
	Account = Запрос.ПараметрыЗапроса.Получить("Account");
	TransactionId = Запрос.ПараметрыЗапроса.Получить("TransactionId");
	ReceiptNumber = Запрос.ПараметрыЗапроса.Получить("ReceiptNumber"); 
	
	
	ResultCode = "21";
	ResultStatus = "Error";  
	ResultMessage = "Заказы не найдены";
	OrdersCount = 0;
	OrdersXML = "";	
	
	XML = РегистрыСведений.КонтактнаяИнформация.ПолучитьДляТерминала(Запрос, Account,TransactionId, ReceiptNumber,QueryType);
	
	
	Ответ.Заголовки.Вставить("Content-Type", "text/xml; charset=UTF-8");
	Ответ.УстановитьТелоИзСтроки(XML, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать); 
	Возврат Ответ;
	
КонецФункции




