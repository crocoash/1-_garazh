Функция OrderCreateCreatePost(Запрос)  
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	СтрокаЗапросаJSON = Запрос.ПолучитьТелоКакСтроку();
	ЭтоГараж = Найти(Запрос.ОтносительныйURL, "garazh") > 0;	
	
	ЗапросСайтаВЖурнал(Запрос.ОтносительныйURL, СтрокаЗапросаJSON);

	Попытка
		БП_ОбменMagento.СоздатьOrderMagento(СтрокаЗапросаJSON, Ответ, ЭтоГараж);
	Исключение
		ОшибкаСайтаВЖурнал(Запрос.ОтносительныйURL, СтрокаЗапросаJSON,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОтветCustomerПровал(Ответ,ОписаниеОшибки());
	КонецПопытки;                                                                                                                 
	
	Возврат Ответ;     
	
КонецФункции

                                                                          

