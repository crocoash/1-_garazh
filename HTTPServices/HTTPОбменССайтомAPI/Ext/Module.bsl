
Процедура ОтветCustomerПровал(Ответ,ОписаниеОшибки)
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("code", "400");
	СтруктураОтвета.Вставить("message", "Внутрішня помилка системи");
	СтруктураОтвета.Вставить("ОписаниеОшибки", ОписаниеОшибки);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураОтвета);
	СтрокаДляОтвета = ЗаписьJSON.Закрыть();
	
	Ответ.КодСостояния = 400;
	Ответ.Заголовки.Вставить("Content-type", "application/json");
	Ответ.УстановитьТелоИзСтроки(СтрокаДляОтвета, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);		
	
КонецПроцедуры

Функция CustomerCreateCreatePost(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	СтрокаЗапросаJSON = Запрос.ПолучитьТелоКакСтроку();
	
	Попытка
		БП_ОбменMagento.СоздатьCustomerMagento(СтрокаЗапросаJSON, Ответ);
	Исключение
		ОтветCustomerПровал(Ответ,ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Ответ;
	
КонецФункции

