Функция РасчетПустая_Есть_ТипыЦенНоменклатуры(МВТЦены, Знач стрТипыЦен)
	
	
	
	
	Запрос = новый Запрос(); 
	Запрос.МенеджерВременныхТаблиц =МВТЦены;
	
	Запрос.Текст =   "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	"""" КАК Номенклатура,
	|	"""" КАК ТипЦен,
	|	0 КАК Цена
	|ПОМЕСТИТЬ ЦеныНоменклатуры
	|ГДЕ
	|	ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса;
	
КонецФункции


Функция Расчет_Есть_ТипыЦенНоменклатуры(МВТЦены,стрТипыЦен)
	
	
	Запрос = Новый Запрос(); 
	
	Запрос.Текст = 	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.ТипЦен,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ПОМЕСТИТЬ ЦеныНоменклатуры
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаДокументов,
	|			ТипЦен В (&ТипыЦен)
	|				И Номенклатура В (&ТаблицаНоменлкатура)) КАК ЦеныНоменклатурыСрезПоследних";	
	
	
	МасивПараметров = ЗАпрос.НайтиПараметры();
	
	для каждого строкаСтр из МасивПараметров цикл				
		
		Запрос.УстановитьПараметр(строкаСтр.Имя, стрТипыЦен[строкаСтр.Имя]);  
		
	конецЦикла;
	
	Запрос.МенеджерВременныхТаблиц = МВТЦены;
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса;
	
КонецФункции


