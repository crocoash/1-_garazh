			строкатабчасти.VS_max_price = строкатабчасти.ЦенаУЦ - строкатабчасти.max_price;
			строкатабчасти.VS_max_price_процент = строкатабчасти.VS_max_price/ (строкатабчасти.ЦенаУЦ/100);
	
		Конецесли;
		
		Если не строкатабчасти.min_price = 0 тогда 
		
			строкатабчасти.VS_min_price = строкатабчасти.ЦенаУЦ - строкатабчасти.min_price; 
			строкатабчасти.VS_min_price_процент = строкатабчасти.VS_min_price/(строкатабчасти.ЦенаУЦ/100 ); 
		
		конецЕсли;
		
		Если не строкатабчасти.avg_price_compared = 0 тогда
			строкатабчасти.VS_avg_price_compared = строкатабчасти.ЦенаУЦ - строкатабчасти.avg_price_compared;
			строкатабчасти.VS_avg_price_compared_процент =  строкатабчасти.VS_avg_price_compared/ ( строкатабчасти.ЦенаУЦ/100);

		КонецЕсли;
		
		Если не  строкатабчасти.min_price_compared = 0 тогда
			строкатабчасти.VS_min_price_compared = строкатабчасти.ЦенаУЦ - строкатабчасти.min_price_compared; 
			строкатабчасти.VS_min_price_compared_процент = строкатабчасти.VS_min_price_compared/ (строкатабчасти.ЦенаУЦ/100);

		конеЦесли;
		
		Если не строкатабчасти.max_price_compared = 0 тогда
			строкатабчасти.VS_max_price_compared = строкатабчасти.ЦенаУЦ - строкатабчасти.max_price_compared;  
			строкатабчасти.VS_max_price_compared_процент =  строкатабчасти.VS_max_price_compared /(строкатабчасти.ЦенаУЦ/100);

		конецесли; 
		
		//СтараяЦена   
		УсловияСтаройЦены = стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.УсловияСтаройЦены;
		ТипСтаройЦены = стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.ТипСтаройЦены; 
		
		Если Не ЗначениеЗаполнено(ТипСтаройЦены) И УсловияСтаройЦены = "" тогда
			строкатабчасти.СтараяЦена = 0;
			Продолжить;
		Иначе
			
			Если УсловияСтаройЦены <> "" тогда
				Если строкатабчасти[УсловияСтаройЦены] >= стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.НаценкаСтаройЦеныОт И строкатабчасти[УсловияСтаройЦены] <= стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.НаценкаСтаройЦеныДо И НЕ строкатабчасти[УсловияСтаройЦены] = 0 тогда
					Если ЗначениеЗаполнено(ТипСтаройЦены) тогда
						ЦенаХотлайн = _РасчитатьЦену(строкатабчасти.Номенклатура,  ТЗЦЕНЫ,  стрТипыЦен.ТипыЦен , ТипСтаройЦены,0);
						
						//Если ЦенаХотлайн = Неопределено тогда
						//	строкатабчасти.СтараяЦена = строкатабчасти.ЦенаУЦ + _РасчитатьСтаруюЦену(строкатабчасти.ЦенаУЦ,стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.НаценкаСуммойСтаройЦены,стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.НаценкаПроцентомСтаройЦены); 	
						//КонецЕсли;
						//
						СтараяЦенаНаценка = _РасчитатьСтаруюЦену(строкатабчасти.ЦенаУЦ,стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.НаценкаСуммойСтаройЦены,стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.НаценкаПроцентомСтаройЦены);
						строкатабчасти.СтараяЦена = строкатабчасти.ЦенаУЦ + СтараяЦенаНаценка;
						
						строкатабчасти.СтараяЦена = Макс(ЦенаХотлайн,строкатабчасти.СтараяЦена);  
						
						//
						//строкатабчасти.СтараяЦена = строкатабчасти.ЦенаУЦ + _РасчитатьСтаруюЦену(строкатабчасти.ЦенаУЦ,стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.НаценкаСуммойСтаройЦены,стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.НаценкаПроцентомСтаройЦены);
						
						
						Если  строкатабчасти.СтараяЦена < строкатабчасти.ЦенаУЦ тогда
							строкатабчасти.СтараяЦена = 0;		
						КонецЕсли;
					Иначе
						  строкатабчасти.СтараяЦена = 0; 
						//строкатабчасти.СтараяЦена = строкатабчасти.ЦенаУЦ + _РасчитатьСтаруюЦену(строкатабчасти.ЦенаУЦ,стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.НаценкаСуммойСтаройЦены,стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.НаценкаПроцентомСтаройЦены);
					КонецЕсли;
				Иначе
					строкатабчасти.СтараяЦена = 0; 	
				КонецЕсли;
			Иначе
				строкатабчасти.СтараяЦена = строкатабчасти.ЦенаУЦ + _РасчитатьСтаруюЦену(строкатабчасти.ЦенаУЦ,стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.НаценкаСуммойСтаройЦены,стрТипыЦен.стрОтборПравилоРасчета.ПравилоРасчета.НаценкаПроцентомСтаройЦены);
			КонецЕсли;
			
		КонецЕсли;

		
	КонецЦикла;	
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
