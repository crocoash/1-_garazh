	                  |				ТОГДА НЕ ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура В (&СписокНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоТипуНоменклатуры
	                  |				ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.Тип В (&СписокТиповНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоДиаметру
	                  |				ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.ДиаметрДиска В (&СписокДиаметров)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоСезону
	                  |				ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.Сезонность В (&СписокСезонов)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоВидуНоменлкатуры
	                  |				ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.ВидНоменклатуры В (&СписокВидыНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоШирине
	                  |				ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.Ширина В (&СписокШирины)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоВысотеПрофиля
	                  |				ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.ВысотаПрофиля В (&СписокВысотПрофилей)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборБУ
	                  |				ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.БУ = &БУ
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборОстаток
	                  |				ТОГДА ВЫБОР
	                  |						КОГДА &ВНаличии
	                  |							ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.КоличествоКонечныйОстаток > 0
	                  |						КОГДА &ВНаличии = ЛОЖЬ
	                  |							ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.КоличествоКонечныйОстаток < 0
	                  |						ИНАЧЕ ИСТИНА
	                  |					КОНЕЦ
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПроизводители
	                  |					И НЕ &Использовать_ПроизводителиИсключение
	                  |				ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.Производитель В (&СписокПроизводители)
	                  |			КОГДА &Использовать_ОтборПроизводители
	                  |					И &Использовать_ПроизводителиИсключение
	                  |				ТОГДА НЕ ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.Производитель В (&СписокПроизводители)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ";
	
	//КонецЕсли;
	
	
		МасивПараметров = ЗапросНом.НайтиПараметры();
	
	для каждого строкаСтр из МасивПараметров цикл				
		
		ЗапросНом.УстановитьПараметр(строкаСтр.Имя, стрТипыЦен[строкаСтр.Имя]); 
		
	конецЦикла;

	
	ЗапросНом.МенеджерВременныхТаблиц = МВТ;	
	
	ЗапросНом.УстановитьПараметр("ДатаОст", ДатаДокументов);
	РезНом = ЗапросНом.Выполнить();
	Возврат РезНом;
	
КонецФункции	



Функция Удалить_ЗапросВсе_старый(ПравилоРасчета)
	
	Перем ЗапросНом, Использовать_ОтборБУ, Использовать_ОтборНоменклатура, Использовать_ОтборОстаток, Использовать_ОтборПоВидуНоменлкатуры, Использовать_ОтборПоВысотеПрофиля, Использовать_ОтборПоГородам, Использовать_ОтборПоДиаметру, Использовать_ОтборПоДоговорКонтрагента, Использовать_ОтборПоПоставщикам, Использовать_ОтборПоПоставщикамТекст, Использовать_ОтборПоСезону, Использовать_ОтборПоТипуНоменклатуры, Использовать_ОтборПоШирине, Использовать_ОтборПроизводители, РезНом;
	
	Использовать_ОтборБУ		     = ?(ЗначениеЗаполнено(ПравилоРасчета.БУ), Истина, Ложь);
	Использовать_ОтборНоменклатура           = ?(ПравилоРасчета.Номенклатура.Количество() <> 0, Истина, Ложь);
	Использовать_ОтборПоТипуНоменклатуры     = ?(ПравилоРасчета.ТипыНоменклатуры.Количество() <> 0, Истина, Ложь);
	Использовать_ОтборПоДиаметру		     = ?(ПравилоРасчета.Модель.Количество() <> 0, Истина, Ложь);
	Использовать_ОтборПоСезону			     = ?(ПравилоРасчета.Сезоны.Количество() <> 0, Истина, Ложь);
	Использовать_ОтборПоПоставщикам		     = ?(ПравилоРасчета.Поставщики.Количество() <> 0, Истина, Ложь);
	Использовать_ОтборПоШирине			     = ?(ПравилоРасчета.Ширина.Количество() <> 0, Истина, Ложь);
	//с.д. рижий 2023-10-01 (
	//с.д. Рижий 2023-10-01 )
	Использовать_ОтборПоВысотеПрофиля	     = ?(ПравилоРасчета.ВысотаПрофиля.Количество() <> 0, Истина, Ложь);
	//Использовать_ОтборОстатокНеМеньше        = ?(ПравилоРасчета.ОстатокНаСкладеНеМеньше <> 0, Истина, Ложь);
	//Использовать_ОтборОстатокНеБольше        = ?(ПравилоРасчета.ОстатокНаСкладеНеБольше <> 0, Истина, Ложь);
	
	Использовать_ОтборОстаток		     = ?(ЗначениеЗаполнено(ПравилоРасчета.ВНаличии), Истина, Ложь);
	
	
	
	ЗапросНом = новый запрос();
	
	ЗапросНом.Текст = "ВЫБРАТЬ
	                  |	ВложенныйЗапрос.Номенклатура_
	                  |ПОМЕСТИТЬ НоменклатураСОтбором
	                  |ИЗ
	                  |	(ВЫБРАТЬ
	                  |		ЦеныНоменклатурыКонтрагентов.Номенклатура КАК Номенклатура_
	                  |	ИЗ
	                  |		ЦеныНоменклатурыКонтрагентов КАК ЦеныНоменклатурыКонтрагентов
	                  |	
	                  |	СГРУППИРОВАТЬ ПО
	                  |		ЦеныНоменклатурыКонтрагентов.Номенклатура
	                  |	
	                  |	ОБЪЕДИНИТЬ ВСЕ
	                  |	
	                  |	ВЫБРАТЬ
	                  |		ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура
	                  |	ИЗ
	                  |		РегистрСведений.ЦеныНоменклатурыКонтрагентов.СрезПоследних(
	                  |				КОНЕЦПЕРИОДА(&ДатаОст, ДЕНЬ),
	                  |				ВЫБОР
	                  |						КОГДА &Использовать_ОтборПоПоставщикам = ИСТИНА
	                  |							ТОГДА ТипЦен.Владелец В (&Поставщики)
	                  |						ИНАЧЕ ИСТИНА
	                  |					КОНЕЦ
	                  |					И ВЫБОР
	                  |						КОГДА &Использовать_ОтборПоГородам = ИСТИНА
	                  |								И &Использовать_ГородИсключение = ЛОЖЬ
	                  |							ТОГДА МІСТО В (&Города)
	                  |						КОГДА &Использовать_ОтборПоГородам = ИСТИНА
	                  |								И &Использовать_ГородИсключение = ИСТИНА
	                  |							ТОГДА НЕ МІСТО В (&Города)
	                  |						ИНАЧЕ ИСТИНА
	                  |					КОНЕЦ
	                  |					И ВЫБОР
	                  |						КОГДА &Использовать_ОтборПоПоставщикамТекст = ИСТИНА
	                  |								И &Использовать_ПоставщикиТекстИсключение = ЛОЖЬ
	                  |							ТОГДА Поставщик В (&ПоставщикиТекст)
	                  |						КОГДА &Использовать_ОтборПоПоставщикамТекст = ИСТИНА
	                  |								И &Использовать_ПоставщикиТекстИсключение = ИСТИНА
	                  |							ТОГДА НЕ Поставщик В (&ПоставщикиТекст)
	                  |						ИНАЧЕ ИСТИНА
	                  |					КОНЕЦ) КАК ЦеныНоменклатурыКонтрагентовСрезПоследних
	                  |	ГДЕ
	                  |		ВЫБОР
	                  |				КОГДА &Использовать_ОтборНоменклатура
	                  |						И НЕ &Использовать_НоменклатураИсключение
	                  |					ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура В (&СписокНоменклатуры)
	                  |				КОГДА &Использовать_ОтборНоменклатура
	                  |						И &Использовать_НоменклатураИсключение
	                  |					ТОГДА НЕ ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура В (&СписокНоменклатуры)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПоТипуНоменклатуры
	                  |					ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.Тип В (&СписокТиповНоменклатуры)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПоДиаметру
	                  |					ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.ДиаметрДиска В (&СписокДиаметров)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПоСезону
	                  |					ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.Сезонность В (&СписокСезонов)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПоВидуНоменлкатуры
	                  |					ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.ВидНоменклатуры В (&СписокВидыНоменклатуры)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПоШирине
	                  |					ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.Ширина В (&СписокШирины)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПоВысотеПрофиля
	                  |					ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.ВысотаПрофиля В (&СписокВысотПрофилей)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборБУ
	                  |					ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.БУ = &БУ
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПроизводители
	                  |						И НЕ &Использовать_ПроизводителиИсключение
	                  |					ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.Производитель В (&СписокПроизводители)
	                  |				КОГДА &Использовать_ОтборПроизводители
	                  |						И &Использовать_ПроизводителиИсключение
	                  |					ТОГДА НЕ ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.Производитель В (&СписокПроизводители)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |	
	                  |	ОБЪЕДИНИТЬ ВСЕ
	                  |	
	                  |	ВЫБРАТЬ РАЗЛИЧНЫЕ
	                  |		ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура
	                  |	ИЗ
	                  |		РегистрНакопления.ПартииТоваровНаСкладах.ОстаткиИОбороты(
	                  |				КОНЕЦПЕРИОДА(&ДатаОст, ДЕНЬ),
	                  |				КОНЕЦПЕРИОДА(&ДатаОст, ДЕНЬ),
	                  |				Авто,
	                  |				ДвиженияИГраницыПериода,
	                  |				ВЫБОР
	                  |						КОГДА &Использовать_ОтборПоПоставщикам = ИСТИНА
	                  |							ТОГДА ДокументОприходования.Контрагент В (&Поставщики)
	                  |						ИНАЧЕ ИСТИНА
	                  |					КОНЕЦ
	                  |					И ВЫБОР
	                  |						КОГДА &Использовать_ОтборПоДоговорКонтрагента = ИСТИНА
	                  |							ТОГДА ДокументОприходования.ДоговорКонтрагента В (&ДоговораКонтрагента)
	                  |						ИНАЧЕ ИСТИНА
	                  |					КОНЕЦ) КАК ПартииТоваровНаСкладахОстаткиИОбороты
	                  |	ГДЕ
	                  |		ВЫБОР
	                  |				КОГДА &Использовать_ОтборНоменклатура
	                  |					ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура В (&СписокНоменклатуры)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПоТипуНоменклатуры
	                  |					ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.Тип В (&СписокТиповНоменклатуры)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПоДиаметру
	                  |					ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.ДиаметрДиска В (&СписокДиаметров)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПоСезону
	                  |					ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.Сезонность В (&СписокСезонов)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПоВидуНоменлкатуры
	                  |					ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.ВидНоменклатуры В (&СписокВидыНоменклатуры)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПоШирине
	                  |					ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.Ширина В (&СписокШирины)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборПоВысотеПрофиля
	                  |					ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.ВысотаПрофиля В (&СписокВысотПрофилей)
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ
	                  |		И ВЫБОР
	                  |				КОГДА &Использовать_ОтборБУ
	                  |					ТОГДА ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура.БУ = &БУ
	                  |				ИНАЧЕ ИСТИНА
	                  |			КОНЕЦ) КАК ВложенныйЗапрос
	                  |ГДЕ
	                  |	ВЫБОР
	                  |			КОГДА &Использовать_ОтборНоменклатура
	                  |					И НЕ &Использовать_НоменклатураИсключение
	                  |				ТОГДА ВложенныйЗапрос.Номенклатура_.Ссылка В (&СписокНоменклатуры)
	                  |			КОГДА &Использовать_ОтборНоменклатура
	                  |					И &Использовать_НоменклатураИсключение
	                  |				ТОГДА НЕ ВложенныйЗапрос.Номенклатура_.Ссылка В (&СписокНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоТипуНоменклатуры
	                  |				ТОГДА ВложенныйЗапрос.Номенклатура_.Тип В (&СписокТиповНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПроизводители
	                  |					И НЕ &Использовать_ПроизводителиИсключение
	                  |				ТОГДА ВложенныйЗапрос.Номенклатура_.Производитель В (&СписокПроизводители)
	                  |			КОГДА &Использовать_ОтборПроизводители
	                  |					И &Использовать_ПроизводителиИсключение
	                  |				ТОГДА НЕ ВложенныйЗапрос.Номенклатура_.Производитель В (&СписокПроизводители)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоДиаметру
	                  |				ТОГДА ВложенныйЗапрос.Номенклатура_.ДиаметрДиска В (&СписокДиаметров)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоСезону
	                  |				ТОГДА ВложенныйЗапрос.Номенклатура_.Сезонность В (&СписокСезонов)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоШирине
	                  |				ТОГДА ВложенныйЗапрос.Номенклатура_.Ширина В (&СписокШирины)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоВысотеПрофиля
	                  |				ТОГДА ВложенныйЗапрос.Номенклатура_.ВысотаПрофиля В (&СписокВысотПрофилей)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборБУ
	                  |				ТОГДА ВложенныйЗапрос.Номенклатура_.БУ = &БУ
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоВидуНоменлкатуры
	                  |				ТОГДА ВложенныйЗапрос.Номенклатура_.ВидНоменклатуры В (&СписокВидыНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |
	                  |СГРУППИРОВАТЬ ПО
	                  |	ВложенныйЗапрос.Номенклатура_
	                  |;
	                  |
	                  |////////////////////////////////////////////////////////////////////////////////
	                  |ВЫБРАТЬ
	                  |	ВложенныйЗапрос.Номенклатура_ КАК Номенклатура,
	                  |	ВложенныйЗапрос.КоличествоОстаток КАК Остаток,
	                  |	&ПравилоРасчета,
	                  |	&КонтрагентУЦ,
	                  |	&Приоритет,
	                  |	&УЦ,
	                  |	ВложенныйЗапрос.Номенклатура_.ВидНоменклатуры КАК ВидНоменклатуры,
	                  |	&ТипЦеныРассчитанной,
	                  |	ВложенныйЗапрос.Номенклатура_.avg_price КАК avg_price,
	                  |	ВложенныйЗапрос.Номенклатура_.min_price КАК min_price,
	                  |	ВложенныйЗапрос.Номенклатура_.max_price КАК max_price,
	                  |	ВложенныйЗапрос.Номенклатура_.count_stores КАК count_stores,
	                  |	ВложенныйЗапрос.Номенклатура_.min_price_compared КАК min_price_compared,
	                  |	ВложенныйЗапрос.Номенклатура_.max_price_compared КАК max_price_compared,
	                  |	ВложенныйЗапрос.Номенклатура_.card_popularity КАК card_popularity,
	                  |	ВложенныйЗапрос.Номенклатура_.url_path КАК url_path,
	                  |	ВложенныйЗапрос.Номенклатура_.Url КАК url
	                  |ИЗ
	                  |	(ВЫБРАТЬ
	                  |		НоменклатураСОтбором.Номенклатура_ КАК Номенклатура_,
	                  |		СУММА(ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0)) КАК КоличествоОстаток
	                  |	ИЗ
	                  |		НоменклатураСОтбором КАК НоменклатураСОтбором
	                  |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
	                  |					КОНЕЦПЕРИОДА(&ДатаОст, ДЕНЬ),
	                  |					Номенклатура В
	                  |						(ВЫБРАТЬ
	                  |							НоменклатураСОтбором.Номенклатура_
	                  |						ИЗ
	                  |							НоменклатураСОтбором)) КАК ТоварыНаСкладахОстатки
	                  |			ПО НоменклатураСОтбором.Номенклатура_ = ТоварыНаСкладахОстатки.Номенклатура
	                  |	
	                  |	СГРУППИРОВАТЬ ПО
	                  |		НоменклатураСОтбором.Номенклатура_) КАК ВложенныйЗапрос
	                  |ГДЕ
	                  |	ВЫБОР
	                  |			КОГДА &Использовать_ОтборОстаток
	                  |				ТОГДА ВЫБОР
	                  |						КОГДА &ВНаличии
