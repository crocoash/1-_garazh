Функция ВернутьСебестоимостьПоставщика(Номенклатура,Поставщик)
	
	ЦенаПост = 0;
	ЗапросНомПост = новый запрос;
	ЗапросНомПост.Текст = "ВЫБРАТЬ
	|	СУММА(ПартииТоваровНаСкладахОстаткиИОбороты.СтоимостьКонечныйОстаток) КАК СтоимостьКонечныйОстаток,
	|	СУММА(ПартииТоваровНаСкладахОстаткиИОбороты.КоличествоКонечныйОстаток) КАК КоличествоКонечныйОстаток,
	|	СУММА(ВЫБОР
	|			КОГДА ПартииТоваровНаСкладахОстаткиИОбороты.КоличествоКонечныйОстаток = 0
	|				ТОГДА 0
	|			ИНАЧЕ ПартииТоваровНаСкладахОстаткиИОбороты.СтоимостьКонечныйОстаток / ПартииТоваровНаСкладахОстаткиИОбороты.КоличествоКонечныйОстаток
	|		КОНЕЦ) КАК Себестоимость,
	|	ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура
	|ИЗ
	|	РегистрНакопления.ПартииТоваровНаСкладах.ОстаткиИОбороты(
	|			&ДатаДокументов,
	|			&ДатаДокументов,
	|			Авто,
	|			ДвиженияИГраницыПериода,
	|			Номенклатура = &Номенклатура
	|				И ВЫБОР
	|					КОГДА &Использовать_ОтборПоПоставщикам
	|						ТОГДА ДокументОприходования.Контрагент В (&Поставщик)    иначе Истина
	|				КОНЕЦ) КАК ПартииТоваровНаСкладахОстаткиИОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура";
	ЗапросНомПост.УстановитьПараметр("ДатаДокументов", ДатаДокументов); 
	Использовать_ОтборПоПоставщикам		     = ?(Поставщик.Количество() <> 0, Истина, Ложь);
	
	
	ЗапросНомПост.УстановитьПараметр("Использовать_ОтборПоПоставщикам", Использовать_ОтборПоПоставщикам);
	
	ЗапросНомПост.УстановитьПараметр("Поставщик", Поставщик);
	
	ЗапросНомПост.УстановитьПараметр("Номенклатура", Номенклатура);
	РезНомПост = ЗапросНомПост.Выполнить().Выгрузить();
	Если РезНомПост.Количество() <> 0 Тогда 
		
		//Если РезНомПост.Количество() <> 0 Тогда 
		ЦенаПост = РезНомПост[0].Себестоимость;
		//КонецЕсли;
		
	КонецЕсли;
	Возврат ЦенаПост;
	
КонецФункции	



Функция ВернутьЦенуПоставщика(Номенклатура,Поставщик, ЦенаСтрокой)
	
	ЦенаПост = 0;
	ЗапросНомПост = новый запрос;
	ЗапросНомПост.Текст = "ВЫБРАТЬ
	|	НоменклатураПоставщика.Ссылка
	|ИЗ
	|	Справочник.НоменклатураПоставщика КАК НоменклатураПоставщика
	|ГДЕ
	|	НоменклатураПоставщика.Владелец = &Владелец
	|	И НоменклатураПоставщика.Номенклатура = &Номенклатура
	|	И НЕ НоменклатураПоставщика.ПометкаУдаления";
	ЗапросНомПост.УстановитьПараметр("Владелец", Поставщик);
	ЗапросНомПост.УстановитьПараметр("Номенклатура", Номенклатура);
	РезНомПост = ЗапросНомПост.Выполнить().Выгрузить();
	Если РезНомПост.Количество() <> 0 Тогда 
		
		ОтборСрезаМин = новый Структура;
		ОтборСрезаМин.Вставить("НоменклатураПоставщика", РезНомПост[0].Ссылка);
		СрезЦенПоБазов = РегистрыСведений.НоменклатураПоставщикаОстатки_СД.СрезПоследних(ДатаДокументов, ОтборСрезаМин);
		Если СрезЦенПоБазов.Количество() <> 0 Тогда 
			ЦенаПост = СрезЦенПоБазов[0][ЦенаСтрокой];
		КонецЕсли;
		
	КонецЕсли;
	Возврат ЦенаПост;
	
КонецФункции	

Процедура СоздатьДокументы() Экспорт    
	
	
	
	НоменклатураПоПравилу.Сортировать("УЦ УБЫВ,Номенклатура");
	
	ДатаДокументаУЦ = ДатаДокументов;
	Для Каждого Стр_Правило из  ДокументыУЦ Цикл   
		
		
		//Для Каждого ЕлКонтрагент из масивКонтрагенты Цикл 
		ВывестиКоментарий("УЦ {" ,Стр_Правило.КонтрагентУЦ,"{");
		
		//
		
		СтруктПрав = новый Структура;
		СтруктПрав.Вставить("КонтрагентУЦ", Стр_Правило.КонтрагентУЦ);
		СтруктПрав.Вставить("ВидНоменклатуры", Стр_Правило.ВидНоменклатуры);  
		СтруктПрав.Вставить("УЦ", Истина);
		
		
		Строки_ПоПравилу = НоменклатураПоПравилу.НайтиСтроки(СтруктПрав);
		
		Если Строки_ПоПравилу.Количество() = 0 Тогда 
			Продолжить;
		КонецЕсли;	      
		
		
		СоздатьДокументыКонтрагентФрагмент(Стр_Правило , Строки_ПоПравилу,ДатаДокументаУЦ);
		
		ВывестиКоментарий("} УЦ",Стр_Правило.КонтрагентУЦ);
		ДатаДокументаУЦ  = ДатаДокументаУЦ + 1;
		//конецЦикла;	
		
		
	КонецЦикла;
	
КонецПроцедуры

