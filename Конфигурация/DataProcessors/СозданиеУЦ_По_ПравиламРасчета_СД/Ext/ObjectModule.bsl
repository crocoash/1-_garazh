Процедура ЗаполнитьВсеНаСервере()   экспорт
	
	Перем новСтр, промтз, Рез_Правила, СтрокаТабличнойЧасти, строкаТЗ, строкатз2;
	
	ВывестиКоментарий("Все",,"{");
	
	
	ДокументыУЦ.Очистить();
	для каждого строкаТЗ из ПравилаРасчета цикл
		для каждого строкатз2 из строкаТЗ.ПравилоРасчета.ВидыНоменклатуры цикл
			новСтр = ДокументыУЦ.Добавить();
			новСтр.КонтрагентУЦ = строкаТЗ.ПравилоРасчета.КонтрагентУЦ;
			новСтр.ВидНоменклатуры = строкатз2.ВидНоменклатуры;
			
		КонецЦикла;;
		
	КонецЦикла;
	
	промтз  = ДокументыУЦ.Выгрузить();
	промтз.Свернуть("КонтрагентУЦ,ВидНоменклатуры");
	ДокументыУЦ.Загрузить(промтз);
	
	
	НоменклатураПоПравилу.Очистить();
	
	ПравилаРасчета.Сортировать("Приоритет");
	для  каждого СтрокаТабличнойЧасти из ПравилаРасчета цикл   
		
		//Сообщить(СтрокаТабличнойЧасти.ПравилоРасчета);         
		ЗапонитьВсюНоменклатуруПоПравилу(СтрокаТабличнойЧасти.ПравилоРасчета);
		Расчет_ВсюНоменклатуруПоПравилу(СтрокаТабличнойЧасти.ПравилоРасчета);
		
		
		
	КонецЦикла;	 
	//Сообщить("Все Завершение: " + СокрЛП(ТекущаяДата()));       
	ВывестиКоментарий("}","Все");
	
КонецПроцедуры


Процедура ВсюНоменклатуруПоВсемПравилам() Экспорт 
	
	НоменклатураПоПравилу.Очистить();
	для Каждого СтрПравило из ПравилаРасчета Цикл 
		
		Если не ЗначениеЗаполнено(СтрПравило.ПравилоРасчета) Тогда 
			Продолжить;
		КонецЕсли;	
		
		ВывестиКоментарий("Заполнение {" , СтрПравило.ПравилоРасчета , "{");
		
		РезНом = ВернутьТабНоменклатурыПоПравилу(СтрПравило.ПравилоРасчета);
		
		для Каждого СтрДоб из РезНом Цикл 
			НовСтр = НоменклатураПоПравилу.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, СтрДоб);
			НовСтр.ЦенаУЦ = ВернутьЦену(НовСтр);
		КонецЦикла;
		
		ВывестиКоментарий("} Заполнение" , СтрПравило.ПравилоРасчета );
		
		
	КонецЦикла;
КонецПроцедуры	

Процедура ВсюНоменклатуруПоПравилу(ПравилоРасчета) Экспорт 
	
	ВывестиКоментарий("Заполнение {" , ПравилоРасчета , "");
	
	СтруктУдалить = новый Структура;
	СтруктУдалить.Вставить("ПравилоРасчета", ПравилоРасчета);
	СтрокиУдалить = НоменклатураПоПравилу.НайтиСтроки(СтруктУдалить);
	для Каждого СтрУдалить из СтрокиУдалить Цикл  
		НоменклатураПоПравилу.Удалить(СтрУдалить);
	КонецЦикла;
	
	Если не ЗначениеЗаполнено(ПравилоРасчета) Тогда 
		Возврат;
	КонецЕсли;	
	РезНом = ВернутьТабНоменклатурыПоПравилу(ПравилоРасчета);
	для Каждого СтрДоб из РезНом Цикл 
		НовСтр = НоменклатураПоПравилу.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, СтрДоб);
		НовСтр.ЦенаУЦ = ВернутьЦену(НовСтр);
	КонецЦикла;
	
	ВывестиКоментарий("} Заполнение" , ПравилоРасчета );
	
	
КонецПроцедуры	


Процедура ЗапонитьВсюНоменклатуруПоПравилу(ПравилоРасчета) Экспорт 
	
	ВывестиКоментарий("Заполнение {" , ПравилоРасчета , "{");
	
	СтруктУдалить = новый Структура;
	СтруктУдалить.Вставить("ПравилоРасчета", ПравилоРасчета);
	СтрокиУдалить = НоменклатураПоПравилу.НайтиСтроки(СтруктУдалить);
	для Каждого СтрУдалить из СтрокиУдалить Цикл  
		НоменклатураПоПравилу.Удалить(СтрУдалить);
	КонецЦикла;
	
	Если не ЗначениеЗаполнено(ПравилоРасчета) Тогда 
		Возврат;
	КонецЕсли;	
	РезНом = ВернутьТабНоменклатурыПоПравилу(ПравилоРасчета);   
	//РезНом.Свернуть("Номенлкатура,ПравилоРасчета");
	//НоменклатураПоПравилу.Загрузить(РезНом);
	//ОбщегоНазначения.ЗагрузитьВТаблицуЗначений(	РезНом, НоменклатураПоПравилу);  
	
	// Заполним значения в совпадающих колонках.
	Для каждого СтрокаТаблицыИсточника Из РезНом Цикл
		
		СтрокаТаблицыПриемника = НоменклатураПоПравилу.Добавить();  
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыПриемника, СтрокаТаблицыИсточника.Номенклатура);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыПриемника, СтрокаТаблицыИсточника);
		
		СтрокаТаблицыПриемника.ПолеДляПоиска =  СокрЛП(СтрокаТаблицыПриемника.Номенклатура) +   СокрЛП(СтрокаТаблицыПриемника.КонтрагентУЦ)+   СокрЛП(СтрокаТаблицыПриемника.ТипЦеныРассчитанной);			
		
	КонецЦикла;
	
	
	ВывестиКоментарий("} Заполнение" , ПравилоРасчета );
	
КонецПроцедуры	


