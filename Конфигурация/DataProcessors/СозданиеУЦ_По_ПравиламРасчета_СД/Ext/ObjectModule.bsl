Функция  ЗапросЗаполнения_ОбединитьНоменлкатуру(Знач МВТ, стрТипыЦен)
	
	Перем Запрос, РезНом;
	
	Запрос = новый Запрос(); 
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.Текст =   "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                 |	ЦеныНоменклатурыКонтрагента.Номенклатура,
	                 |	ЦеныНоменклатурыКонтрагента.Остаток,
	                 |	ЦеныНоменклатурыКонтрагента.МІСТО,
	                 |	ЦеныНоменклатурыКонтрагента.Поставщик
	                 |ПОМЕСТИТЬ тзНом
	                 |ИЗ
	                 |	ЦеныНоменклатурыКонтрагента КАК ЦеныНоменклатурыКонтрагента
	                 |
	                 |ОБЪЕДИНИТЬ ВСЕ
	                 |
	                 |ВЫБРАТЬ
	                 |	СправочникНоменклатура.Номенклатура,
	                 |	СправочникНоменклатура.Остаток,
	                 |	"""",
	                 |	""""
	                 |ИЗ
	                 |	СправочникНоменклатура КАК СправочникНоменклатура
	                 |
	                 |ОБЪЕДИНИТЬ ВСЕ
	                 |
	                 |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                 |	ПартииТоваров.Номенклатура,
	                 |	ПартииТоваров.Остаток,
	                 |	"""",
	                 |	""""
	                 |ИЗ
	                 |	ПартииТоваров КАК ПартииТоваров
	                 |
	                 |ОБЪЕДИНИТЬ ВСЕ
	                 |
	                 |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                 |	ЦеныНоменклатуры.Номенклатура,
	                 |	ЦеныНоменклатуры.Остаток,
	                 |	"""",
	                 |	""""
	                 |ИЗ
	                 |	ЦеныНоменклатуры КАК ЦеныНоменклатуры
	                 |;
	                 |
	                 |////////////////////////////////////////////////////////////////////////////////
	                 |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                 |	тзНом.Номенклатура,
	                 |	&ПравилоРасчета,
	                 |	&КонтрагентУЦ,
	                 |	&Приоритет,
	                 |	&УЦ,
	                 |	&ТипЦеныРассчитанной,
	                 |	МАКСИМУМ(тзНом.Остаток) КАК Остаток,
	                 |	тзНом.МІСТО,
	                 |	тзНом.Поставщик
	                 |ИЗ
	                 |	тзНом КАК тзНом
	                 |
	                 |СГРУППИРОВАТЬ ПО
	                 |	тзНом.Номенклатура,
	                 |	тзНом.МІСТО,
	                 |	тзНом.Поставщик";
	
	Запрос.УстановитьПараметр("ТипЦеныРассчитанной", стрТипыЦен.ТипЦеныРассчитанной);  
	Запрос.УстановитьПараметр("ПравилоРасчета", стрТипыЦен.ПравилоРасчета);  
	Запрос.УстановитьПараметр("КонтрагентУЦ", стрТипыЦен.КонтрагентУЦ);  
	Запрос.УстановитьПараметр("Приоритет", стрТипыЦен.Приоритет);
	Запрос.УстановитьПараметр("УЦ", ложь);
	
	РезНом = Запрос.Выполнить();
	Возврат РезНом;
	
КонецФункции

