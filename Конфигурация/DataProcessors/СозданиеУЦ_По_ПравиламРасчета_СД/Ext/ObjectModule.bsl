Функция РачитатьЦену(Номенклатура, _ПравилоРасчета_)
	
	Результат = 0;
	
	Если ТипЗнч(_ПравилоРасчета_) = Тип("Число") Тогда 
		
		Результат = _ПравилоРасчета_;    
		
	ИначеЕсли ТипЗнч(_ПравилоРасчета_) = Тип("Строка") Тогда 
		//[ЦенаСоСкидкой]
		//[ЦенаОпт]
		//[ЦенаРекомендована]
		НайдЦенаСтрокой = Найти(_ПравилоРасчета_, "[ЦенаСоСкидкой]");
		Если НайдЦенаСтрокой = 0 Тогда 
			НайдЦенаСтрокой = Найти(_ПравилоРасчета_, "[ЦенаОпт]");
			Если НайдЦенаСтрокой = 0 Тогда 
				НайдЦенаСтрокой = Найти(_ПравилоРасчета_, "[ЦенаРекомендована]");
				Если НайдЦенаСтрокой <> 0 Тогда
					Результат = ВернутьЦенуПоставщика(Номенклатура,Номенклатура.ОсновнойПоставщик, "ЦенаРекомендована");
				КонецЕсли;	
			Иначе
				Результат = ВернутьЦенуПоставщика(Номенклатура,Номенклатура.ОсновнойПоставщик, "ЦенаОпт");
			КонецЕсли;	
		Иначе
			Результат = ВернутьЦенуПоставщика(Номенклатура,Номенклатура.ОсновнойПоставщик, "ЦенаСоСкидкой");
		КонецЕсли;	
		
	ИначеЕсли _ПравилоРасчета_ = Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаРекомендованая Тогда 
		//[ЦенаСоСкидкой]
		//[ЦенаОпт]
		//[ЦенаРекомендована]
		Результат = ВернутьЦенуПоставщика(Номенклатура,Номенклатура.ОсновнойПоставщик, "ЦенаРекомендована");
		
	ИначеЕсли _ПравилоРасчета_ = Справочники.ТипыЦенНоменклатурыПрочее_сд.СебестоимостьНаша Тогда 
		//[ЦенаСоСкидкой]
		//[ЦенаОпт]
		//[ЦенаРекомендована]
		Результат = ВернутьСебестоимостьПоставщика(Номенклатура,Поставщики.ВыгрузитьКолонку("Поставщик"));
		
		
	ИначеЕсли _ПравилоРасчета_ = Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаОпт Тогда 
		//[ЦенаСоСкидкой]
		//[ЦенаОпт]
		//[ЦенаРекомендована]
		Результат = ВернутьЦенуПоставщика(Номенклатура,Номенклатура.ОсновнойПоставщик, "ЦенаОпт");     
		//ИначеЕсли ПравилоРасчета_.ЦенаРассчитанаНеМеньше = Справочники.ТипыЦенНоменклатурыПрочее_сд.цен Тогда 
		//	//[ЦенаСоСкидкой]
		//	//[ЦенаОпт]
		//	//[ЦенаРекомендована]
		//	ЦенаМин = ВернутьЦенуПоставщика(Строка_, "ЦенаЗакупки");     
		//	
	ИначеЕсли _ПравилоРасчета_ = Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаСоСкидкой Тогда 
		//[ЦенаСоСкидкой]
		//[ЦенаОпт]
		//[ЦенаРекомендована]
		Результат = ВернутьЦенуПоставщика(Номенклатура,Номенклатура.ОсновнойПоставщик, "ЦенаСоСкидкой");
		
	ИначеЕсли ТипЗнч(_ПравилоРасчета_) = Тип("СправочникСсылка.ТипыЦенНоменклатуры") Тогда
		ОтборСрезаН = новый Структура;
		ОтборСрезаН.Вставить("ТипЦен", _ПравилоРасчета_);
		ОтборСрезаН.Вставить("Номенклатура", Номенклатура);
		СрезЦенПоБазовН = РегистрыСведений.ЦеныНоменклатуры.СрезПоследних(ДатаДокументов, ОтборСрезаН);
		Если СрезЦенПоБазовН.Количество() <> 0 Тогда 
			Результат = СрезЦенПоБазовН[0].Цена;
		КонецЕсли;
	ИначеЕсли ТипЗнч(_ПравилоРасчета_) = Тип("СправочникСсылка.ТипыЦенНоменклатурыКонтрагентов") Тогда
		ОтборСрезаН = новый Структура;
		ОтборСрезаН.Вставить("ТипЦен", _ПравилоРасчета_);
		ОтборСрезаН.Вставить("Номенклатура", Номенклатура);
		СрезЦенПоБазовН = РегистрыСведений.ЦеныНоменклатурыКонтрагентов.СрезПоследних(ДатаДокументов, ОтборСрезаН);
		Если СрезЦенПоБазовН.Количество() <> 0 Тогда 
			Результат = СрезЦенПоБазовН[0].Цена;
		КонецЕсли;
	КонецЕсли;	
	
	
	возврат Результат;
	
КонецФункции	

функция ВернутьЦену(Строка_)
	//Ціна по кожній номенклатурі рахується за такою формулою :
	//[ціна] = [тип базової ціни].Ціна  + [Націнка сумою]  
	//якщо [Націнка сумою] = 0 тоді [Знижка сумою] = [тип базової ціни].Ціна /100*[Знижка відсотком] 
	//якщо [ціна] <= [ціна розрахована не менше ] то встановлюмо [ціна] = [ціна розрахована не менше ] . 
	//Якщо [ціна розрахована не менше ]  = 0 то не перевіряємо цю умову
	//якщо [ціна] >=  [ціна розрахована не більше]   то встановлюмо [ціна] =  [ціна розрахована не більше] . 
	//Якщо  [ціна розрахована не більше]    = 0 то не перевіряємо цю умову
	//замість  
	//[Знижка відсотком]  тра    [Націнка  відсотком  ] 
	//[Знижка сумою]     тра   [Націнка сумою] 	Цена_ = 0;
	ПравилоРасчета_ = Строка_.ПравилоРасчета;
	Если ЗначениеЗаполнено(ПравилоРасчета_.ТипБазовойЦены) Тогда 
		//ОтборСреза = новый Структура;
		//ОтборСреза.Вставить("ТипЦен", ПравилоРасчета_.ТипБазовойЦены);
		//ОтборСреза.Вставить("Номенклатура", Строка_.Номенклатура);
		//СрезЦенПоБазов = РегистрыСведений.ЦеныНоменклатуры.СрезПоследних(ДатаДокументов, ОтборСреза);
		ЦенаПоБазовойЦене = 0;
		Наценка_ 		  = 0;
		Строка_.ЦенаМин 		  = 0;
		Строка_.ЦенаМакс 		  = 0;
		//Если СрезЦенПоБазов.Количество() <> 0 Тогда 
		//	ЦенаПоБазовойЦене = СрезЦенПоБазов[0].Цена;     
		ЦенаПоБазовойЦене = РачитатьЦену(Строка_.Номенклатура,ПравилоРасчета_.ТипБазовойЦены);
		//КонецЕсли;
		Если не ПравилоРасчета_.НаценкаСуммой = 0 Тогда  
			Наценка_ = ПравилоРасчета_.НаценкаСуммой;
