Процедура Расчет_ВсюНоменклатуруПоПравилу(ПравилоРасчета) Экспорт
	
	ВывестиКоментарий("Расчет {" , ПравилоРасчета ,"{");
	
	
	
	Если ложь тогда
		
		ПравилоРасчета = Справочники.ПравилаРасчетаЦен_СД.ПустаяСсылка();
	КонецЕсли;	
	
	стрТипыЦен = Расчет_ВсюНоменклатуруУстановитьПараметры(ПравилоРасчета);
	
	
	МВТЦены = Новый МенеджерВременныхТаблиц();
	
	
	
	
	для каждого ФУн из стрТипыЦен.МасивРасчетаЦен цикл
		
		Если  стрТипыЦен.МасивРасчетаЦен[фун.Ключ] = ЛОжь тогда
			Текст_сд = "РасчетПустая_" + СокрЛП(фун.Ключ)+ "(МВТЦены, стрТипыЦен);" ; 
		Иначе
			Текст_сд = "Расчет_" + СокрЛП(фун.Ключ)+ "(МВТЦены, стрТипыЦен);" ;

		КонецЕсли;   
	
	    Выполнить(Текст_сд) ;

		
		Если Отладка = истина тогда
			Сообщить(Текст_сд)
		конецЕсли;	
		
	КонецЦикла;	
	
	
	
	
	//РезультатЗапроса = РасчитатьВсюНоменклатуруВодномзапросе_старый(ПравилоРасчета, стрТипыЦен, ТипыЦен);
