	МВТ = Новый МенеджерВременныхТаблиц();	
	
	
	
	
	для каждого ФУн из стрТипыЦен.МасивРасчетаЦен цикл
		
		Если  стрТипыЦен.МасивРасчетаЦен[фун.Ключ] = ЛОжь тогда
			Текст_сд = "ЗапросЗаполнения_Пустая_" + СокрЛП(фун.Ключ)+ "(МВТ);" ; 
