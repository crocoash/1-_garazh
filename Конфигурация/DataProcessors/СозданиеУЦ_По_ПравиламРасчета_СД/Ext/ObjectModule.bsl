	                  |						ИНАЧЕ ИСТИНА
	                  |					КОНЕЦ
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ";
	
	//КонецЕсли;
	
	ЗапросНом.УстановитьПараметр("Использовать_ОтборОстаток",Использовать_ОтборОстаток );
	ЗапросНом.УстановитьПараметр("ВНаличии", ?(ПравилоРасчета.ВНаличии = Перечисления.ДаНет_сд.Да, Истина, Ложь));
	
	
	
