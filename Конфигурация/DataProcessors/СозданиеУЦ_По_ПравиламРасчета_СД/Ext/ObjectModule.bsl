		Если СтрокаТиповЦен = Неопределено Тогда
			СтрокаТиповЦен = ДокументОбъект.ТипыЦен.Добавить();
			СтрокаТиповЦен.ТипЦен = СтрокаТовара.ТипЦеныРассчитанной;  
			
		КонецЕсли;
		
		//Если не контрагенты = Неопределено тогда
		
		//для каждого СтрокаКонтрагент из контрагенты цикл
		
		//СтруктураПоиска = Новый Структура;
		//СтруктураПоиска.Вставить("Номенклатура", СтрокаТовара.Номенклатура);
		//СтруктураПоиска.Вставить("ТипЦен", ТипЦен_);
		
		//НовыйТовар = ОбработкаТабличныхЧастей.НайтиСтрокуТабЧасти(ДокументОбъект.Товары, СтруктураПоиска);
		//
		//Если НовыйТовар = Неопределено Тогда
		НовыйТовар 							= ДокументОбъект.Товары.Добавить();
		НовыйТовар.Номенклатура 			= СтрокаТовара.Номенклатура;
		НовыйТовар.ТипЦен 					= СтрокаТовара.ТипЦеныРассчитанной;
		НовыйТовар.ИндексСтрокиТаблицыЦен 	= 0;
		//КонецЕсли;
		//
		НовыйТовар.Цена 						= СтрокаТовара.ЦенаУЦ;
		НовыйТовар.Валюта 						= СтрокаТовара.ТипЦеныРассчитанной.ВалютаЦены;
		НовыйТовар.ЕдиницаИзмерения 			= СтрокаТовара.Номенклатура.ЕдиницаХраненияОстатков;   
		НовыйТовар.Поставщик 				=  Стр_Правило.КонтрагентУЦ;
		//НовыйТовар.ПроцентСкидкиНаценки 		= ТипЦен.ПроцентСкидкиНаценки;
		//НовыйТовар.СпособРасчетаЦены 			= ТипЦен.СпособРасчетаЦены;
