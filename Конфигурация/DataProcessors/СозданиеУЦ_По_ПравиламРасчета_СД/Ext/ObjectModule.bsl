	//	|				Авто,
	//	|				ДвиженияИГраницыПериода,
	//	|				ВЫБОР
	//	|						КОГДА &Использовать_ОтборПоПоставщикам = ИСТИНА
	//	|							ТОГДА ДокументОприходования.Контрагент В (&Поставщики)
	//	|						ИНАЧЕ ИСТИНА
	//	|					КОНЕЦ
	//	|					И ВЫБОР
	//	|						КОГДА &Использовать_ОтборПоДоговорКонтрагента = ИСТИНА
	//	|							ТОГДА ДокументОприходования.ДоговорКонтрагента В (&ДоговораКонтрагента)
	//	|						ИНАЧЕ ИСТИНА
	//	|					КОНЕЦ) КАК ПартииТоваровНаСкладахОстаткиИОбороты
	//	|		ПО ТЗНом.Номенклатура = ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура
	//	|
	//	|СГРУППИРОВАТЬ ПО
	//	|	ТЗНом.Номенклатура"; 
	
	
	
	//	
	Запрос = новый Запрос();
	
	
	
	
	Запрос.МенеджерВременныхТаблиц = МВТЦены;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура,
	               |	&ТипыЦенНоменклатурыПрочееСебестоимость КАК ТипЦен,
	               |	СУММА(ВЫБОР
	               |			КОГДА ПартииТоваровНаСкладахОстаткиИОбороты.КоличествоКонечныйОстаток = 0
	               |				ТОГДА 0
	               |			ИНАЧЕ ПартииТоваровНаСкладахОстаткиИОбороты.СтоимостьКонечныйОстаток / ПартииТоваровНаСкладахОстаткиИОбороты.КоличествоКонечныйОстаток
	               |		КОНЕЦ) КАК цена
	               |ПОМЕСТИТЬ ЦеныТипыЦенНоменклатурыПрочееСебестоимость
	               |ИЗ
	               |	РегистрНакопления.ПартииТоваровНаСкладах.ОстаткиИОбороты(
	               |			&ДатаДокументов,
	               |			&ДатаДокументов,
	               |			Авто,
	               |			ДвиженияИГраницыПериода,
	               |			Номенклатура В (&ТаблицаНоменлкатура)
	               |				И ВЫБОР
	               |					КОГДА &Использовать_ОтборПоПоставщикам = ИСТИНА
	               |						ТОГДА ДокументОприходования.Контрагент В (&Поставщики)
	               |					ИНАЧЕ ИСТИНА
	               |				КОНЕЦ
	               |				И ВЫБОР
	               |					КОГДА &Использовать_ОтборПоДоговорКонтрагента = ИСТИНА
	               |						ТОГДА ДокументОприходования.ДоговорКонтрагента В (&ДоговораКонтрагента)
	               |					ИНАЧЕ ИСТИНА
	               |				КОНЕЦ) КАК ПартииТоваровНаСкладахОстаткиИОбороты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПартииТоваровНаСкладахОстаткиИОбороты.Номенклатура" ;	
	
	
	МасивПараметров = ЗАпрос.НайтиПараметры();
	
	для каждого строкаСтр из МасивПараметров цикл				
		
		Запрос.УстановитьПараметр(строкаСтр.Имя, стрТипыЦен[строкаСтр.Имя]); 
		
	конецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса;
	
КонецФункции


Функция РасчитатьВсюНоменклатуруВодномзапросе_старый(Знач ПравилоРасчета, Знач стрТипыЦен, ТипыЦен)
	
	Перем Запрос, Использовать_ОтборПоГородам, Использовать_ОтборПоДоговорКонтрагента, Использовать_ОтборПоПоставщикам, РезультатЗапроса;
	
	
	стрОтборПравилоРасчета = Новый Структура();
	стрОтборПравилоРасчета.Вставить("ПравилоРасчета",ПравилоРасчета);
	
	
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Даний фрагмент побудований конструктором.
	// При повторному використанні конструктора, внесені вручну зміни будуть втрачені!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаНоменлкатура.Номенклатура,
	|	ТаблицаНоменлкатура.ПравилоРасчета
	|ПОМЕСТИТЬ ТЗНом
	|ИЗ
	|	&ТаблицаНоменлкатура КАК ТаблицаНоменлкатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЗНом.Номенклатура,
	|	&ТипыЦенНачалоная КАК ТипЦен,
	|	0 КАК Цена
	|ИЗ
	|	ТЗНом КАК ТЗНом
	|
	|СГРУППИРОВАТЬ ПО
	|	ТЗНом.Номенклатура
	|";
	
	еСЛИ стрТипыЦен.Есть_ТипыЦенНоменклатуры = ИСТИНА ТОГДА
		Запрос.Текст = Запрос.Текст  +"
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТЗНом.Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.ТипЦен,
		|	ЦеныНоменклатурыСрезПоследних.Цена
		|ИЗ
		|	ТЗНом КАК ТЗНом
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаДокументов, ТипЦен В (&ТипыЦен)) КАК ЦеныНоменклатурыСрезПоследних
		|		ПО ТЗНом.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
		|";	
	КОНЕЦеСЛИ;
	еСЛИ стрТипыЦен.Есть_ТипыЦенНоменклатурыКонтрагентов = ИСТИНА ТОГДА
		Запрос.Текст = Запрос.Текст  +"
		
		|ОБЪЕДИНИТЬ ВСЕ
