Функция  ЗапросЗаполнения_Есть_Номенклатура(МВТ,стрТипыЦен)
	
		
	
	ЗапросНом = новый запрос();
	
	ЗапросНом.Текст = "ВЫБРАТЬ
	                  |	НоменклатураВся.Ссылка КАК Номенклатура,
	                  |	ТоварыНаСкладахОстаткиИОбороты.КоличествоКонечныйОстаток КАК Остаток
	                  |ПОМЕСТИТЬ СправочникНоменклатура
	                  |ИЗ
	                  |	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(&ДатаОст, &ДатаОст, Авто, ДвиженияИГраницыПериода, ) КАК ТоварыНаСкладахОстаткиИОбороты
	                  |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураВся
	                  |		ПО ТоварыНаСкладахОстаткиИОбороты.Номенклатура = НоменклатураВся.Ссылка
	                  |ГДЕ
	                  |	НЕ НоменклатураВся.Ссылка.ПометкаУдаления
	                  |	И НЕ НоменклатураВся.Ссылка.ЭтоГруппа
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборНоменклатура
	                  |					И НЕ &Использовать_НоменклатураИсключение
	                  |				ТОГДА НоменклатураВся.Ссылка В (&СписокНоменклатуры)
	                  |			КОГДА &Использовать_ОтборНоменклатура
	                  |					И &Использовать_НоменклатураИсключение
	                  |				ТОГДА НЕ НоменклатураВся.Ссылка В (&СписокНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоТипуНоменклатуры
	                  |				ТОГДА НоменклатураВся.Тип В (&СписокТиповНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоДиаметру
	                  |				ТОГДА НоменклатураВся.ДиаметрДиска В (&СписокДиаметров)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоСезону
	                  |				ТОГДА НоменклатураВся.Сезонность В (&СписокСезонов)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоПоставщикам
	                  |				ТОГДА НоменклатураВся.ОсновнойПоставщик В (&СписокПоставщиков)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоВидуНоменлкатуры
	                  |				ТОГДА НоменклатураВся.ВидНоменклатуры В (&СписокВидыНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоШирине
	                  |				ТОГДА НоменклатураВся.Ширина В (&СписокШирины)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоВысотеПрофиля
	                  |				ТОГДА НоменклатураВся.ВысотаПрофиля В (&СписокВысотПрофилей)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборБУ
	                  |				ТОГДА НоменклатураВся.БУ = &БУ
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПроизводители
	                  |					И НЕ &Использовать_ПроизводителиИсключение
	                  |				ТОГДА НоменклатураВся.Производитель В (&СписокПроизводители)
	                  |			КОГДА &Использовать_ОтборПроизводители
	                  |					И &Использовать_ПроизводителиИсключение
	                  |				ТОГДА НЕ НоменклатураВся.Производитель В (&СписокПроизводители)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |
	                  |СГРУППИРОВАТЬ ПО
	                  |	НоменклатураВся.Ссылка,
	                  |	ТоварыНаСкладахОстаткиИОбороты.КоличествоКонечныйОстаток";
	
	
	МасивПараметров = ЗапросНом.НайтиПараметры();
	
	для каждого строкаСтр из МасивПараметров цикл				
		
		ЗапросНом.УстановитьПараметр(строкаСтр.Имя, стрТипыЦен[строкаСтр.Имя]); 
		
	конецЦикла;

	ЗапросНом.МенеджерВременныхТаблиц = МВТ;	
	ЗапросНом.УстановитьПараметр("ДатаОст", ДатаДокументов);
	РезНом = ЗапросНом.Выполнить();
	Возврат РезНом;
	
КонецФункции	



Функция ЗапросЗаполнения_Есть_ТипыЦенНоменклатуры(МВТ,стрТипыЦен)
	
		
	
	
	ЗапросНом = новый запрос();
	
	ЗапросНом.Текст = "ВЫБРАТЬ
	                  |	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура
	                  |ПОМЕСТИТЬ ЦеныНоменклатуры
	                  |ИЗ
	                  |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	                  |			КОНЕЦПЕРИОДА(&ДатаОст, ДЕНЬ),
	                  |			Цена <> 0
	                  |				И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних
	                  |ГДЕ
	                  |	ВЫБОР
	                  |			КОГДА &Использовать_ОтборНоменклатура
	                  |					И НЕ &Использовать_НоменклатураИсключение
	                  |				ТОГДА ЦеныНоменклатурыСрезПоследних.Номенклатура В (&СписокНоменклатуры)
	                  |			КОГДА &Использовать_ОтборНоменклатура
	                  |					И &Использовать_НоменклатураИсключение
	                  |				ТОГДА НЕ ЦеныНоменклатурыСрезПоследних.Номенклатура В (&СписокНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоТипуНоменклатуры
	                  |				ТОГДА ЦеныНоменклатурыСрезПоследних.Номенклатура.Тип В (&СписокТиповНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоДиаметру
	                  |				ТОГДА ЦеныНоменклатурыСрезПоследних.Номенклатура.ДиаметрДиска В (&СписокДиаметров)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоСезону
	                  |				ТОГДА ЦеныНоменклатурыСрезПоследних.Номенклатура.Сезонность В (&СписокСезонов)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоВидуНоменлкатуры
	                  |				ТОГДА ЦеныНоменклатурыСрезПоследних.Номенклатура.ВидНоменклатуры В (&СписокВидыНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоШирине
	                  |				ТОГДА ЦеныНоменклатурыСрезПоследних.Номенклатура.Ширина В (&СписокШирины)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоВысотеПрофиля
	                  |				ТОГДА ЦеныНоменклатурыСрезПоследних.Номенклатура.ВысотаПрофиля В (&СписокВысотПрофилей)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборБУ
	                  |				ТОГДА ЦеныНоменклатурыСрезПоследних.Номенклатура.БУ = &БУ
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПроизводители
	                  |					И НЕ &Использовать_ПроизводителиИсключение
	                  |				ТОГДА ЦеныНоменклатурыСрезПоследних.Номенклатура.Производитель В (&СписокПроизводители)
	                  |			КОГДА &Использовать_ОтборПроизводители
	                  |					И &Использовать_ПроизводителиИсключение
	                  |				ТОГДА НЕ ЦеныНоменклатурыСрезПоследних.Номенклатура.Производитель В (&СписокПроизводители)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ЦеныНоменклатурыСрезПоследних.Цена <> 0";
	
	//КонецЕсли;
		МасивПараметров = ЗапросНом.НайтиПараметры();
	
	для каждого строкаСтр из МасивПараметров цикл				
		
		ЗапросНом.УстановитьПараметр(строкаСтр.Имя, стрТипыЦен[строкаСтр.Имя]); 
		
	конецЦикла;
	
		
	
	ЗапросНом.МенеджерВременныхТаблиц = МВТ;	
	ЗапросНом.УстановитьПараметр("ДатаОст", ДатаДокументов);
	РезНом = ЗапросНом.Выполнить();
	Возврат РезНом;
	
КонецФункции	



