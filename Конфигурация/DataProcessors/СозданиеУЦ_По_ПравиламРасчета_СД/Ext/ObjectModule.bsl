Процедура Расчет_ВсюНоменклатуруУстановитьПараметры_старые(Знач Запрос, Знач ПравилоРасчета, Знач стрОтборПравилоРасчета, ТипыЦен)
	
	Перем Использовать_ОтборПоГородам, Использовать_ОтборПоДоговорКонтрагента, Использовать_ОтборПоПоставщикам;
	
	Запрос.УстановитьПараметр("ДатаДокументов", ДатаДокументов);
	
	Запрос.УстановитьПараметр("Города", ПравилоРасчета.Города.ВыгрузитьКолонку("Город"));
	Использовать_ОтборПоГородам		     = ?(ПравилоРасчета.Города.Количество() <> 0, Истина, Ложь);
	Запрос.УстановитьПараметр("Использовать_ОтборПоГородам", Использовать_ОтборПоГородам);
	
	Запрос.УстановитьПараметр("Поставщики", ПравилоРасчета.Поставщики.ВыгрузитьКолонку("Поставщик"));   
	Использовать_ОтборПоПоставщикам		     = ?(ПравилоРасчета.Поставщики.Количество() <> 0, Истина, Ложь);
	Запрос.УстановитьПараметр("Использовать_ОтборПоПоставщикам",Использовать_ОтборПоПоставщикам);   
	
	
	Запрос.УстановитьПараметр("ДоговораКонтрагента", ПравилоРасчета.ДоговораКонтрагента.ВыгрузитьКолонку("ДоговорКонтрагента"));   
	Использовать_ОтборПоДоговорКонтрагента	     = ?(ПравилоРасчета.ДоговораКонтрагента.Количество() <> 0, Истина, Ложь);
	Запрос.УстановитьПараметр("Использовать_ОтборПоДоговорКонтрагента",Использовать_ОтборПоДоговорКонтрагента);   
	
	
	Запрос.УстановитьПараметр("ТипыЦен", ТипыЦен);
	Запрос.УстановитьПараметр("ТаблицаНоменлкатура", НоменклатураПоПравилу.Выгрузить(стрОтборПравилоРасчета,"Номенклатура,ПравилоРасчета"));
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочееЦенаОпт", Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаОпт);
	Запрос.УстановитьПараметр("ТипБазовойЦены", ПравилоРасчета.ТипБазовойЦены);
	Запрос.УстановитьПараметр("ЦенаРассчитанаНеМеньше", ПравилоРасчета.ЦенаРассчитанаНеМеньше);
	Запрос.УстановитьПараметр("ЦенаРассчитанаНеБольше", ПравилоРасчета.ЦенаРассчитанаНеБольше);
	
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочееЦенаРекомендована", Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаРекомендованая);
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочееЦенаСоскидкой", Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаСоСкидкой);
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочееСебестоимость", Справочники.ТипыЦенНоменклатурыПрочее_сд.СебестоимостьНаша);
	
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочееЦенаБН", Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаБН);
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочееРекОпт", Справочники.ТипыЦенНоменклатурыПрочее_сд.РекОпт);
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочееРекОптБН", Справочники.ТипыЦенНоменклатурыПрочее_сд.РекОптБН);
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочееРекРозница", Справочники.ТипыЦенНоменклатурыПрочее_сд.РекРозница);
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочееРекРозницаБН", Справочники.ТипыЦенНоменклатурыПрочее_сд.РекРозницаБН);
	Запрос.УстановитьПараметр("ТипыЦенНачалоная", Справочники.ТипыЦенНоменклатурыПрочее_сд.ПустаяСсылка());
	
	
	
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочее_ЦенаХотлайнКонкурентыМаксимальная_сд", Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаХотлайнКонкурентыМаксимальная);
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочее_ЦенаХотлайнКонкурентыМинимальная_сд", Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаХотлайнКонкурентыМинимальная);
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочее_ЦенаХотлайнКонкурентыСредняя_сд", Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаХотлайнКонкурентыСредняя);
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочее_ЦенаХотлайнМаксимальная_сд", Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаХотлайнМаксимальная);
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочее_ЦенаХотлайнСредняя_сд", Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаХотлайнСредняя);
	Запрос.УстановитьПараметр("ТипыЦенНоменклатурыПрочее_ЦенаХотлайнМинимальная_сд", Справочники.ТипыЦенНоменклатурыПрочее_сд.ЦенаХотлайнМинимальная);
	
	
	Запрос.УстановитьПараметр("Использовать_ПоставщикиТекстИсключение", ПравилоРасчета.ПоставщикиТекстИсключение);
	Запрос.УстановитьПараметр("Использовать_ПроизводителиИсключение", ПравилоРасчета.ПроизводителиИсключение);
	Запрос.УстановитьПараметр("Использовать_ГородИсключение", ПравилоРасчета.ГородИсключение);
	Запрос.УстановитьПараметр("Использовать_НоменклатураИсключение", ПравилоРасчета.НоменклатураИсключение);
	
КонецПроцедуры

Функция _РасчитатьЦену(Номенклатура, Знач ТЗЦЕНЫ, Знач ТипыЦен , ЗначениеЦены = 0, ЦенаБазовая = 0)
	
	Перем отборТипЦЕн, ТЗ;
	
	Если не ТипыЦен.НайтиПоЗначению(ЗначениеЦены)  = Неопределено тогда
		отборТипЦЕн = новый Структура();
		отборТипЦЕн.Вставить("Номенклатура", Номенклатура);		
		отборТипЦЕн.Вставить("ТипЦен", ЗначениеЦены);		
		
		
		ТЗ = ТЗЦЕНЫ.НайтиСтроки(отборТипЦЕн);
		Если не Тз.количество()= 0 тогда
			РезультатФункции = Тз[0].цена;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ЗначениеЦены) = Тип("Число") тогда
		РезультатФункции  = ЦенаБазовая +  ЗначениеЦены	
	КонецЕсли;
	
	
	возврат РезультатФункции
КонецФункции //_РасчитатьЦену(Номенклатура, Знач ТЗЦЕНЫ, Знач ТипыЦен ,Знач цена = 0)


Функция _РасчитатьНаценку (ЦенаБазовая, НаценкаСуммой = 0, НаценкаПроцентом = 0)
	
	
	Если  НаценкаПроцентом <> 0   тогда
		Наценка = ЦенаБазовая / 100 * НаценкаПроцентом;    
	Иначе
		Наценка =  НаценкаСуммой;
	КонецЕсли;	
		
	
	//Наценка = Макс(НаценкаПроцент, НаценкаСуммой);
		
	
	возврат Наценка
КонецФункции //_РасчитатьЦену(Номенклатура, Знач ТЗЦЕНЫ, Знач ТипыЦен ,Знач цена = 0)


Функция _РасчитатьНаценкуБазова (ЦенаБазовая, НаценкаСуммой = 0, НаценкаПроцентом = 0)
	
	
	НаценкаПроцент = ЦенаБазовая / 100 * НаценкаПроцентом;    
	
	Наценка = Макс(НаценкаПроцент, НаценкаСуммой);
		
	
	возврат Наценка
КонецФункции //_РасчитатьЦену(Номенклатура, Знач ТЗЦЕНЫ, Знач ТипыЦен ,Знач цена = 0)



Функция  ТИпЦенСписок(Знач ТипЦен, Знач ТипыЦен = Неопределено , стрТипыЦен)
	
	
	
	Если ТипЗнч(ТипЦен) = ТИп("СправочникСсылка.ТипыЦенНоменклатуры") тогда
		ТипыЦен.Добавить( ТипЦен);
		
