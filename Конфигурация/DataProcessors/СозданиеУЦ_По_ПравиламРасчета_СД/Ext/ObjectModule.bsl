Функция ПередатьНоменклатуруКРасчетуРейтинга() Экспорт 
	//+БП: d.matyash (16.07.2025) <>
	ЗаполнитьПравила();
	ЗаполнитьВсеНаСервере();
	ПодготовитьУцНаСервере();
	ТЗ = НоменклатураПоПравилу.ВыгрузитьКолонки("ПравилоРасчета,Номенклатура,ВидНоменклатуры,ТипЦеныРассчитанной,Приоритет,МІСТО,Поставщик,Остаток,Прибыль,ЦенаУЦ,СтараяЦена,ПрибыльПроцент");
	Для каждого СтрНом из НоменклатураПоПравилу цикл
		Если Не СтрНом.УЦ тогда 
			Продолжить;
		КонецЕсли;                      
		
		Отбор = Новый Структура("Номенклатура, ТипЦеныРассчитанной", СтрНом.Номенклатура, СтрНом.ТипЦеныРассчитанной);
		Строки = ТЗ.НайтиСтроки(Отбор);
		Если  НЕ Строки.Количество() тогда
			НовСтрока = ТЗ.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,СтрНом);
		Иначе
			НайденнаяСтрока = Строки[0];	
			Если СтрНом.Приоритет > НайденнаяСтрока.Приоритет тогда
				ЗаполнитьЗначенияСвойств(НайденнаяСтрока,СтрНом);
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат ТЗ;
	//-БП: d.matyash (16.07.2025) <> 
КонецФункции

Функция _РасчитатьСтаруюЦену (ЦенаБазовая, НаценкаСуммой = 0, НаценкаПроцентом = 0)
	
	
	НаценкаПроцент = ЦенаБазовая / 100 * НаценкаПроцентом;    
	
	Наценка = Макс(НаценкаПроцент, НаценкаСуммой);
		
	
	возврат Наценка
