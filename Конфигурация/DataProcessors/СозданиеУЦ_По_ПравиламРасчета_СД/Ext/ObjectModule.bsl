	ДокументОбъект.ВидНоменклатуры = Стр_Правило.ВидНоменклатуры;
	
	ДокументОбъект.Дата = ДатаДокументаУЦ;
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ДокументОбъект, глЗначениеПеременной("глТекущийПользователь"));
	ДокументОбъект.НеПроводитьНулевыеЗначения = Истина;
	
	//+БП: d.matyash (22.09.2025) <>
