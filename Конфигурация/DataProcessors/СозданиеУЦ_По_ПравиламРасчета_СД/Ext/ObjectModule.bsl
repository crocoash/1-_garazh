Функция  	отменитьУцНаСервера() Экспорт
	
	
	ВывестиКоментарий("УЦ отмена","","{");
	
	МАсивДок = ДокументыУЦ.ВыгрузитьКолонку("ДокУЦ");
	
	//+БП: d.matyash (24.09.2025) <> 
	Для каждого Стр из ДокументыУЦ цикл  
		Если Не ЗначениеЗаполнено(Стр.ДокУЦСтараяЦена) тогда 
			Продолжить;
		КонецЕсли;
		МАсивДок.Добавить(Стр.ДокУЦСтараяЦена);	
	КонецЦикла;
	//-БП: d.matyash (24.09.2025) <>
	
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Даний фрагмент побудований конструктором.
	// При повторному використанні конструктора, внесені вручну зміни будуть втрачені!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УстановкаЦенНоменклатуры.Ссылка,
	|	УстановкаЦенНоменклатуры.ВидНоменклатуры,
	|	УстановкаЦенНоменклатуры.КонтрагентРасчета КАК Контрагент
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
	|ГДЕ
	|	НЕ УстановкаЦенНоменклатуры.Ссылка В (&Список)
	|	И УстановкаЦенНоменклатуры.Проведен = ИСТИНА
	|	И УстановкаЦенНоменклатуры.Комментарий ПОДОБНО &Комментарий";
	
	Запрос.УстановитьПараметр("Комментарий", "Создано автоматом по правилам с.д.");
	Запрос.УстановитьПараметр("Список", МАсивДок);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
	
	
	для каждого ДокУц из ДокументыУЦ цикл
		
		Если не ДокУц.ДокУЦ.Проведен = истина тогда
			Продолжить;	
		Конецесли;
		
		
		_ОтборУЦ = новый Структура();
		_ОтборУЦ.Вставить("ВидНоменклатуры", ДокУц.ВидНоменклатуры);
		_ОтборУЦ.Вставить("Контрагент", ДокУц.КонтрагентУЦ);
		
		_докыУЦОтмена = ВыборкаДетальныеЗаписи.НайтиСтроки(_ОтборУЦ); 
		для каждого _докУЦОтмена из _докыУЦОтмена цикл
			докел  = _докУЦОтмена.ссылка.ПолучитьОбъект();
			//докел  = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
			докел.УстановитьПометкуУдаления(истина);
			//докел.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			//докел.ЗАпи
		конецЦИкла;	
	конецЦикла;	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	
	
	
	ВывестиКоментарий("} УЦ отмена");
	
	
конецФункции	


