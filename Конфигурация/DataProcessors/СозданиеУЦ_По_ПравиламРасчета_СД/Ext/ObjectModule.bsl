		//	КонецЕсли;	
		
		
		//+БП: d.matyash (22.09.2025) <>
		//------------------Старая Цена
		//      
		//Если СтрокаТовара.СтараяЦена <> 0 тогда
			СтрокаТиповЦен = ДокументОбъектСтараяЦена.ТипыЦен.Найти(СтрокаТовара.ТипЦеныРассчитанной.ТипСтаройЦены, "ТипЦен");
			
