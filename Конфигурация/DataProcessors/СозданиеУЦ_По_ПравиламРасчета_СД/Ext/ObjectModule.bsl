Функция ЗапросЗаполнения_Есть_ТипыЦенНоменклатурыКонтрагентов(МВТ,стрТипыЦен)
	
		
	
	
	ЗапросНом = новый запрос();
	
	ЗапросНом.Текст = "ВЫБРАТЬ
	                  |	ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура КАК Номенклатура,
	                  |	ЦеныНоменклатурыКонтрагентовСрезПоследних.Остаток КАК Остаток,
	                  |	ЦеныНоменклатурыКонтрагентовСрезПоследних.МІСТО,
	                  |	ЦеныНоменклатурыКонтрагентовСрезПоследних.Поставщик
	                  |ПОМЕСТИТЬ ЦеныНоменклатурыКонтрагента
	                  |ИЗ
	                  |	РегистрСведений.ЦеныНоменклатурыКонтрагентов.СрезПоследних(
	                  |			КОНЕЦПЕРИОДА(&ДатаОст, ДЕНЬ),
	                  |			ТипЦен = &ТипЦен
	                  |				И ВЫБОР
	                  |					КОГДА &Использовать_ОтборПоПоставщикам = ИСТИНА
	                  |						ТОГДА ТипЦен.Владелец В (&Поставщики)
	                  |					ИНАЧЕ ИСТИНА
	                  |				КОНЕЦ
	                  |				И ВЫБОР
	                  |					КОГДА &Использовать_ОтборПоГородам = ИСТИНА
	                  |							И &Использовать_ГородИсключение = ЛОЖЬ
	                  |						ТОГДА МІСТО В (&Города)
	                  |					КОГДА &Использовать_ОтборПоГородам = ИСТИНА
	                  |							И &Использовать_ГородИсключение = ИСТИНА
	                  |						ТОГДА НЕ МІСТО В (&Города)
	                  |					ИНАЧЕ ИСТИНА
	                  |				КОНЕЦ
	                  |				И ВЫБОР
	                  |					КОГДА &Использовать_ОтборПоПоставщикамТекст = ИСТИНА
	                  |							И &Использовать_ПоставщикиТекстИсключение = ЛОЖЬ
	                  |						ТОГДА Поставщик В (&ПоставщикиТекст)
	                  |					КОГДА &Использовать_ОтборПоПоставщикамТекст = ИСТИНА
	                  |							И &Использовать_ПоставщикиТекстИсключение = ИСТИНА
	                  |						ТОГДА НЕ Поставщик В (&ПоставщикиТекст)
	                  |					ИНАЧЕ ИСТИНА
	                  |				КОНЕЦ
	                  |				И Цена <> 0) КАК ЦеныНоменклатурыКонтрагентовСрезПоследних
	                  |ГДЕ
	                  |	ВЫБОР
	                  |			КОГДА &Использовать_ОтборНоменклатура
	                  |					И НЕ &Использовать_НоменклатураИсключение
	                  |				ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура В (&СписокНоменклатуры)
	                  |			КОГДА &Использовать_ОтборНоменклатура
	                  |					И &Использовать_НоменклатураИсключение
	                  |				ТОГДА НЕ ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура В (&СписокНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоТипуНоменклатуры
	                  |				ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.Тип В (&СписокТиповНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоДиаметру
	                  |				ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.ДиаметрДиска В (&СписокДиаметров)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоСезону
	                  |				ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.Сезонность В (&СписокСезонов)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоВидуНоменлкатуры
	                  |				ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.ВидНоменклатуры В (&СписокВидыНоменклатуры)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоШирине
	                  |				ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.Ширина В (&СписокШирины)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПоВысотеПрофиля
	                  |				ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.ВысотаПрофиля В (&СписокВысотПрофилей)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборБУ
	                  |				ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.БУ = &БУ
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ
	                  |	И ВЫБОР
	                  |			КОГДА &Использовать_ОтборПроизводители
	                  |					И НЕ &Использовать_ПроизводителиИсключение
	                  |				ТОГДА ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.Производитель В (&СписокПроизводители)
	                  |			КОГДА &Использовать_ОтборПроизводители
	                  |					И &Использовать_ПроизводителиИсключение
	                  |				ТОГДА НЕ ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура.Производитель В (&СписокПроизводители)
	                  |			ИНАЧЕ ИСТИНА
	                  |		КОНЕЦ";
	
	//КонецЕсли;
		МасивПараметров = ЗапросНом.НайтиПараметры();
	
	для каждого строкаСтр из МасивПараметров цикл				
		
		ЗапросНом.УстановитьПараметр(строкаСтр.Имя, стрТипыЦен[строкаСтр.Имя]); 
		
	конецЦикла;
	
		
	
	ЗапросНом.МенеджерВременныхТаблиц = МВТ;	
	ЗапросНом.УстановитьПараметр("ДатаОст", ДатаДокументов);
	РезНом = ЗапросНом.Выполнить();
	Возврат РезНом;
	
КонецФункции	


