	//еСЛИ стрТипыЦен.Есть_ТипыЦенНоменклатурыПрочее_ЦенаХотлайнКонкурентыМаксимальная_сд = ИСТИНА ТОГДА
	//		Запрос.Текст = Запрос.Текст  +"
	//		|ОБЪЕДИНИТЬ ВСЕ
	//		|ВЫБРАТЬ РАЗЛИЧНЫЕ
	//		|	ТЗНом.Номенклатура,
	//		|	&ТипыЦенНоменклатурыПрочее_ЦенаХотлайнКонкурентыМаксимальная,
	//		|	ТЗНом.Номенклатура.max_price_compared КАК Цена
	//		|ИЗ
	//		|	ТЗНом КАК ТЗНом         ";	       
	//	КОНЕЦеСЛИ;   
	//		        
	
	
	//	
	Запрос = новый Запрос();
	
	
	
	
	Запрос.МенеджерВременныхТаблиц = МВТЦены;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	&ТипыЦенНоменклатурыПрочее_ЦенаХотлайнКонкурентыМаксимальная_сд КАК ТипЦен,
	|	Номенклатура.max_price_compared КАК Цена
	|ПОМЕСТИТЬ ЦеныТипыЦенНоменклатурыПрочее_ЦенаХотлайнКонкурентыМаксимальная_сд
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В(&ТаблицаНоменлкатура)" ;	
	
	
	МасивПараметров = ЗАпрос.НайтиПараметры();
	
	для каждого строкаСтр из МасивПараметров цикл				
		
		Запрос.УстановитьПараметр(строкаСтр.Имя, стрТипыЦен[строкаСтр.Имя]); 
		
	конецЦикла;
	
	РезультатЗапроса = Запрос.Выполнить();
	Возврат РезультатЗапроса;
	
КонецФункции


