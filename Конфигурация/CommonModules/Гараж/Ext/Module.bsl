  Процедура СнятьРезерв() Экспорт
	  Запрос = Новый Запрос;
	  Запрос.Текст = "ВЫБРАТЬ
	  |	ЗакрытиеЗаказовПокупателей.Ссылка
	  |ИЗ
	  |	Документ.ОтменаЗаказовПокупателей КАК ЗакрытиеЗаказовПокупателей
	  |ГДЕ
	  |	ЗакрытиеЗаказовПокупателей.Дата МЕЖДУ &Начало И &Конец
	  |	И ЗакрытиеЗаказовПокупателей.Проведен = Истина";
	  Запрос.УстановитьПараметр("Начало",НачалоДня(ТекущаяДата()));
	  Запрос.УстановитьПараметр("Конец",КонецДня(ТекущаяДата()));
	  Результат = Запрос.Выполнить().Выбрать();
	  Стат = Истина;
	  Пока Результат.Следующий() Цикл
		  Стат = Ложь;
		  Прервать;
	  КонецЦикла;
	  Если Стат Тогда
		  ДокСнятия = Документы.ОтменаЗаказовПокупателей.СоздатьДокумент();
		  ДокСнятия.Дата = ТекущаяДата();
		  ДокСнятия.Ответственный = глЗначениеПеременной("глТекущийПользователь");
		  ДокСнятия.ЗаполнитьЗаказы();
		  ДокСнятия.Записать(РежимЗаписиДокумента.Проведение);

#Если Клиент Тогда
		  
		  Сообщить("Сняли проссроченый резерв: "+ДокСнятия);
		  #КонецЕсли

	  КонецЕсли;
  КонецПроцедуры
  
  
  Процедура 	СнимемЗаказПоставщику(З,С);
	  Запрос = Новый ЗАпрос;
	  ЗАпрос.Текст = "ВЫБРАТЬ
	  |	ЗаказПоставщикуТовары.Ссылка
	  |ИЗ
	  |	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
	  |ГДЕ
	  |	ЗаказПоставщикуТовары.Заказ = &Заказ
	  |	И ЗаказПоставщикуТовары.Ссылка.ПометкаУдаления = Ложь
	  |
	  |СГРУППИРОВАТЬ ПО
	  |	ЗаказПоставщикуТовары.Ссылка";
	  Запрос.УстановитьПараметр("Заказ",З);
	  Р = Запрос.Выполнить().Выбрать();
	  Пока Р.Следующий() Цикл
		  ЗП = Р.Ссылка.ПолучитьОбъект();
		  Зп.СтатусЗП = С;
		  ЗП.ЗАписать(РежимЗаписиДокумента.ОтменаПроведения);
	  КонецЦикла;
	  
  КонецПроцедуры
  
  Процедура 	СнимемПеремещение(З,С);
	  Запрос = Новый ЗАпрос;
	  ЗАпрос.Текст = "ВЫБРАТЬ
	  |	ПеремещениеТоваров.Ссылка
	  |ИЗ
	  |	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
	  |ГДЕ
	  |	ПеремещениеТоваров.ВнутреннийЗаказ = &Заказ
	  |	И ПеремещениеТоваров.ПометкаУдаления = Ложь
	  |
	  |СГРУППИРОВАТЬ ПО
	  |	ПеремещениеТоваров.Ссылка";
	  Запрос.УстановитьПараметр("Заказ",З);
	  Р = Запрос.Выполнить().Выбрать();
	  Пока Р.Следующий() Цикл
		  ЗП = Р.Ссылка.ПолучитьОбъект();
		  Зп.Статус = С;
		  ЗП.ЗАписать(РежимЗаписиДокумента.ОтменаПроведения);
	  КонецЦикла;
	  
  КонецПроцедуры
  
  Функция ЕстьВЭкспедиторке(П)
	  Запрос = Новый Запрос;
	  Запрос.Текст = "ВЫБРАТЬ
	  |	ЭкспедиторкаДокументыТ.Ссылка
	  |ИЗ
	  |	Документ.Экспедиторка.ДокументыТ КАК ЭкспедиторкаДокументыТ
	  |ГДЕ
	  |	ЭкспедиторкаДокументыТ.Документ = &Док
	  |	И ЭкспедиторкаДокументыТ.Ссылка.ПометкаУдаления = Ложь";
	  Запрос.УстановитьПараметр("Док",П);
	  Р = ЗАпрос.Выполнить().Выбрать();
	  Пока Р.Следующий() Цикл
		  Возврат ИстинА;
	  КонецЦикла;
	  Возврат Ложь;
  КонецФункции
  
  
  Процедура ОтменаЗаказа(Заказ)     Экспорт
#Если Клиент Тогда	  
	  Режим = РежимДиалогаВопрос.ДаНет;
	  Текст = "Произвести отмену заказа № "+Заказ.Номер+" от покупателя "+Заказ.Контрагент;
	  Ответ = Вопрос(Текст, Режим, 0);
	  Если Ответ = КодВозвратаДиалога.Нет Тогда
		  Возврат;
	  КонецЕсли; 
	  Если Не РольДоступна("ПолныеПрава") Тогда
		  Если ЗАказ.Ответственный <> ПараметрыСеанса.ТекущийПользователь Тогда
			  Предупреждение("Нет доступа для отмены заказа!");
			  Возврат;
		  КонецЕслИ;
	  КонецЕслИ;
	  
	  Запрос = Новый Запрос;
	  Запрос.Текст = "ВЫБРАТЬ
	  |	ЗаказыПокупателейОстатки.КоличествоОстаток,
	  |	ЗаказыПокупателейОстатки.ЗаказПокупателя,
	  |	ЕСТЬNULL(ВзаиморасчетыСКонтрагентамиОбороты.СуммаВзаиморасчетовПриход, 0) КАК Поле1,
	  |	ЕСТЬNULL(ВзаиморасчетыСКонтрагентамиОбороты.СуммаВзаиморасчетовРасход, 0) КАК Поле2
	  |ИЗ
	  |	РегистрНакопления.ЗаказыПокупателей.Остатки(, ЗаказПокупателя = &Заказ) КАК ЗаказыПокупателейОстатки
	  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчетыСКонтрагентами.Обороты КАК ВзаиморасчетыСКонтрагентамиОбороты
	  |		ПО ЗаказыПокупателейОстатки.ЗаказПокупателя = ВзаиморасчетыСКонтрагентамиОбороты.Сделка";
	  ЗАпрос.УстановитьПараметр("Заказ",Заказ);
	  ЗапросРн = Новый Запрос;
	  ЗапросРН.Текст = "ВЫБРАТЬ
	  |	РеализацияТоваровУслуг.Ссылка
	  |ИЗ
	  |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	  |ГДЕ
	  |	РеализацияТоваровУслуг.Проведен = ИСТИНА
	  |	И РеализацияТоваровУслуг.Сделка = &Заказ";
	  
	  Рез = ЗАпрос.Выполнить().Выбрать();
	  МожноСнимать = Истина;
	  Пока Рез.Следующий() Цикл
		  если Рез.ЗаказПокупателя.Статус <> Справочники.Статусы.Создан и ЗначениеЗаполнено(Рез.ЗаказПокупателя.Статус) Тогда
			  МожноСнимать = Ложь;
		  КонецеслИ;
		  Если Рез.Поле1 <> 0 или Рез.Поле2 <> 0 Тогда
			  МожноСнимать = Ложь;
		  КонецЕсли;
		  ЗапросРН.УстановитьПараметр("Заказ",Рез.ЗаказПокупателя);
		  РезРн = ЗапросРн.Выполнить().Выбрать();
		  ЕстьРН = Ложь;
		  Пока РезРн.Следующий() Цикл
			  ЕстьРН = Истина;
			  МожноСнимать = Ложь;
		  КонецЦикла;
		  Если МожноСнимать Тогда
			  //1 Пункт
			  Запрос = Новый Запрос;
			  Запрос.Текст = "ВЫБРАТЬ
			  |	ПоступлениеТоваровУслугТовары.Ссылка
			  |ИЗ
			  |	Документ.ПоступлениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
			  |ГДЕ
			  |	ПоступлениеТоваровУслугТовары.Заказ = &Заказ
			  |	И ПоступлениеТоваровУслугТовары.Ссылка.ПометкаУдаления = Ложь";
			  ЗАпрос.УстановитьПараметр("Заказ",Заказ);
			  Рез = Запрос.Выполнить().Выбрать();
			  Продолжаем = Истина;
			  Пока Рез.Следующий() Цикл
				  З = Заказ.ПолучитьОбъект();
				  З.Статус = Справочники.Статусы.НайтиПоКоду("000000007");
				  З.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				  Продолжаем = Ложь;
			  КонецЦикла;
			  Если НЕ Продолжаем Тогда
				  Возврат;
			  КонецЕсли;
			  //2 Пункт
			  Запрос = Новый Запрос;
			  Запрос.Текст = "ВЫБРАТЬ
			  |	ПеремещениеТоваров.Ссылка
			  |ИЗ
			  |	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
			  |ГДЕ
			  |	ПеремещениеТоваров.ПометкаУдаления = Ложь
			  |	И ПеремещениеТоваров.ВнутреннийЗаказ = &Заказ";
			  ЗАпрос.УстановитьПараметр("Заказ",Заказ);
			  
			  Рез = Запрос.Выполнить().Выбрать();
			  Продолжаем = Истина;
			  ЕстьПеремещение = Ложь;
			  Пока Рез.Следующий() Цикл
				  ЕстьПеремещение = Истина;
			  КонецЦикла;
			  Если Не ЕстьПеремещение Тогда
				  З = Заказ.ПолучитьОбъект();
				  З.Статус = Справочники.Статусы.НайтиПоКоду("000000007");
				  З.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				  Продолжаем = Ложь;
				  СнимемЗаказПоставщику(Заказ,Справочники.Статусы.НайтиПоКоду("000000010").Ссылка);
			  КонецЕсли;				
			  
			  Если НЕ Продолжаем Тогда
				  Возврат;
			  КонецЕсли;
			  
			  //2_2 Пункт
			  Запрос = Новый Запрос;
			  Запрос.Текст = "ВЫБРАТЬ
			  |	ПеремещениеТоваров.Ссылка
			  |ИЗ
			  |	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
			  |ГДЕ
			  |	ПеремещениеТоваров.ПометкаУдаления = Ложь
			  |	И ПеремещениеТоваров.ВнутреннийЗаказ = &Заказ";
			  ЗАпрос.УстановитьПараметр("Заказ",Заказ);
			  
			  Рез = Запрос.Выполнить().Выбрать();
			  Продолжаем = Истина;
			  ЕстьПеремещение = Ложь;
			  Пока Рез.Следующий() Цикл
				  Если Не ЕстьВЭкспедиторке(Рез.Ссылка) Тогда
					  З = Заказ.ПолучитьОбъект();
					  З.Статус = Справочники.Статусы.НайтиПоКоду("000000007");
					  З.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					  Продолжаем = Ложь;
					  СнимемЗаказПоставщику(Заказ,Справочники.Статусы.НайтиПоКоду("000000010").Ссылка);
					  СнимемПеремещение(Заказ,Справочники.Статусы.НайтиПоКоду("000000014").Ссылка);
					  
				  КонецЕслИ;
			  КонецЦикла;
			  
			  Если НЕ Продолжаем Тогда
				  Возврат;
			  КонецЕсли;
			  
			  //3 пункт
			  Запрос = Новый Запрос;
			  Запрос.Текст = "ВЫБРАТЬ
			  |	ПеремещениеТоваров.Ссылка
			  |ИЗ
			  |	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
			  |ГДЕ
			  |	ПеремещениеТоваров.ПометкаУдаления = ЛОЖЬ
			  |	И ПеремещениеТоваров.ВнутреннийЗаказ = &Заказ
			  |	И ПеремещениеТоваров.Статус <> &Выполнено";
			  ЗАпрос.УстановитьПараметр("Заказ",Заказ);
			  ЗАпрос.УстановитьПараметр("Выполнено",Справочники.Статусы.НайтиПоКоду("000000016").Ссылка);
			  
			  Рез = Запрос.Выполнить().Выбрать();
			  Продолжаем = Истина;
			  ЕстьПеремещение = Ложь;
			  Пока Рез.Следующий() Цикл
				  Если ЕстьВЭкспедиторке(Рез.Ссылка) Тогда
					  З = Заказ.ПолучитьОбъект();
					  З.Статус = Справочники.Статусы.НайтиПоКоду("000000009");
					  З.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					  Продолжаем = Ложь;
					  //СнимемЗаказПоставщику(Заказ,Справочники.Статусы.НайтиПоКоду("000000010").Ссылка);
					  СнимемПеремещение(Заказ,Справочники.Статусы.НайтиПоКоду("000000012").Ссылка);
