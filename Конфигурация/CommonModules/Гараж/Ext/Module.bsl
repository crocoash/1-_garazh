Функция УКого(Ном)
	 Запрос = Новый запрос; 
	 Запрос.Текст = "ВЫБРАТЬ
	                |	ЦеныНоменклатурыКонтрагентовСрезПоследних.ТипЦен.Владелец КАК Владелец,
	                |	ЦеныНоменклатурыКонтрагентовСрезПоследних.Цена * КурсыВалютСрезПоследних.Курс / КурсыВалютСрезПоследних.Кратность КАК Поле1
	                |ИЗ
	                |	РегистрСведений.ЦеныНоменклатурыКонтрагентов.СрезПоследних(, Номенклатура = &Ном) КАК ЦеныНоменклатурыКонтрагентовСрезПоследних
	                |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних КАК КурсыВалютСрезПоследних
	                |		ПО ЦеныНоменклатурыКонтрагентовСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Поле1";
	Запрос.УстановитьПараметр("Ном",Ном.Номенклатура);
	
	Рез = Запрос.Выполнить().Выбрать();
	
	Пока Рез.Следующий() Цикл
		Попытка
		Если Рез.Поле1 < 4 Тогда
			Продолжить;
		КонецЕслИ;
	Исключение
		Продолжить;
		КонецПопытки ;
		Ном.Цена = Рез.Поле1;
		Ном.Поставщик = Рез.Владелец;
		Ном.Сумма = Ном.Цена * Ном.Количество;
		ПрерватЬ;
	КонецЦикла;
КонецФункции

