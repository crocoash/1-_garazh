////////////////////////////////////////////////////////////////////////////////
// Загрузка банковских выписок (WayForPay, Приват24 Бизнес, Monobank).
//
// WayForPay настройки не требует: подразделение попадает в загрузку само,
// если у него заполнена «Настройка Wayforpay» — реквизиты продавца берутся
// оттуда же, откуда их берёт создание инвойсов в заказе покупателя.
//
// Приват24 и Monobank настраиваются реквизитами справочника Подразделения
// (ИсточникБанковскойВыписки, ТокенБанковскойВыписки, АйдиБанковскойВыписки,
// ЗагружатьБанковскуюВыписку, НаправлениеОперацийВыписки, БанковскийСчетВыписки).
//
// Полученные операции складываются в таблицу "документы к импорту" в
// ХранилищеОбщихНастроек("ОбменПриват24", "ДокументыКИмпорту"), откуда
// обработка ОбменПриват24 создаёт платёжные документы.
//
// Организацию, подразделение, договор и валюту платёжный документ получает
// из заказа (см. Документы.ПлатежноеПоручениеВходящее.СоздатьПлатежПоЗаказу),
// счёт организации — из настройки подразделения, по которой пришла выписка.
////////////////////////////////////////////////////////////////////////////////

#Область ТочкаВходаРегламентногоЗадания

// Точка входа регламентного задания ЗагрузкаПриват24.
// Организация в загрузке не участвует: настройки берутся из подразделений,
// организация платёжного документа определяется заказом.
Процедура ЗагрузкаБанковскихВыписок() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Попытка

		ПараметрыЗагрузки = СформироватьПараметрыЗагрузкиБанковскихВыписок();

		Если ПараметрыЗагрузки = Неопределено Тогда
			Возврат;
		КонецЕсли;

		ЗагрузитьБанковскиеВыписки(ПараметрыЗагрузки);

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка регламентной загрузки банковских выписок: "
			+ ОписаниеОшибки());

		Сообщить(
			"Ошибка регламентной загрузки банковских выписок: "
			+ ОписаниеОшибки());

	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Период загрузки: от Приват24НачалПериодРучной (если заполнена),
// иначе от Приват24НачалПериод, иначе "сегодня минус 2 дня".
Функция СформироватьПараметрыЗагрузкиБанковскихВыписок(
	Подразделение = Неопределено) Экспорт

	НачалоПериода = Константы.Приват24НачалПериод.Получить();

	НачалоПериодаРучное = Константы.Приват24НачалПериодРучной.Получить();

	Если ЗначениеЗаполнено(НачалоПериодаРучное) Тогда

		ДатаНачала = НачалоДня(НачалоПериодаРучное);

	ИначеЕсли ЗначениеЗаполнено(НачалоПериода) Тогда

		ДатаНачала = НачалоДня(НачалоПериода);

	Иначе

		ДатаНачала = НачалоДня(ТекущаяДата() - 2 * 24 * 60 * 60);

	КонецЕсли;

	ДатаКонца = КонецДня(ТекущаяДата());

	Если ДатаНачала > ДатаКонца Тогда

		Сообщить(
			"Загрузка банковских выписок: "
			+ "дата начала периода больше даты окончания.");

		Возврат Неопределено;

	КонецЕсли;

	Параметры = Новый Структура;

	Параметры.Вставить("Подразделение", Подразделение);
	Параметры.Вставить("ДатаНачала",    ДатаНачала);
	Параметры.Вставить("ДатаКонца",     ДатаКонца);

	Возврат Параметры;

КонецФункции

#КонецОбласти

#Область ЗагрузкаВыписок

// Основной конвейер загрузки.
//
// Параметры:
//   ПараметрыЗагрузки - Структура:
//     * ДатаНачала    - Дата - начало периода;
//     * ДатаКонца     - Дата - окончание периода;
//     * Подразделение - СправочникСсылка.Подразделения - необязательно,
//                       пусто = все настроенные подразделения.
//
Процедура ЗагрузитьБанковскиеВыписки(ПараметрыЗагрузки) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Попытка

		Если ПараметрыЗагрузки = Неопределено Тогда

			Сообщить(
				"Загрузка банковских выписок: "
				+ "не переданы параметры загрузки.");

			Возврат;

		КонецЕсли;

		ДатаНачала    = Неопределено;
		ДатаКонца     = Неопределено;
		Подразделение = Неопределено;

		Если Не ПараметрыЗагрузки.Свойство("ДатаНачала", ДатаНачала) Тогда

			Сообщить(
				"Загрузка банковских выписок: не передана дата начала.");

			Возврат;

		КонецЕсли;

		Если Не ПараметрыЗагрузки.Свойство("ДатаКонца", ДатаКонца) Тогда

			Сообщить(
				"Загрузка банковских выписок: не передана дата окончания.");

			Возврат;

		КонецЕсли;

		Если ТипЗнч(ДатаНачала) <> Тип("Дата")
			Или ТипЗнч(ДатаКонца) <> Тип("Дата") Тогда

			Сообщить(
				"Загрузка банковских выписок: "
				+ "период должен быть передан типом Дата.");

			Возврат;

		КонецЕсли;

		ПараметрыЗагрузки.Свойство("Подразделение", Подразделение);

		ДокументыКИмпорту = ПолучитьТаблицуДокументовКИмпорту();

		ДокументыКИмпорту.Очистить();

		ТаблицаНастроек = ПолучитьНастройкиЗагрузкиВыписок(Подразделение);

		Если ТаблицаНастроек.Количество() = 0 Тогда

			Если ЗначениеЗаполнено(Подразделение) Тогда

				Сообщить(
					"Загрузка банковских выписок: у подразделения «"
					+ Строка(Подразделение)
					+ "» загрузка выписки не настроена."
					+ " Очистите поле «Подразделение», чтобы загружать по всем.");

			Иначе

				Сообщить(
					"Загрузка банковских выписок: нечего загружать."
					+ " Эквайринг WayForPay берётся автоматически у каждого"
					+ " подразделения с заполненной настройкой «Wayforpay»."
					+ " Для Приват24 или Monobank нужно заполнить реквизиты"
					+ " загрузки выписки у подразделения (источник, банковский"
					+ " счёт, айди, токен и флаг «Загружать»).");

			КонецЕсли;

			СохранитьТаблицуДокументовКИмпорту(ДокументыКИмпорту);

			Возврат;

		КонецЕсли;

		ОтладкаВыписокСообщить(
			"Период " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
			+ " - " + Формат(ДатаКонца, "ДФ=dd.MM.yyyy")
			+ ", найдено настроек: " + Строка(ТаблицаНастроек.Количество()));

		Для Каждого СтрокаНастройки Из ТаблицаНастроек Цикл

			ОтладкаВыписокСообщить(
				"  подразделение: " + Строка(СтрокаНастройки.Подразделение)
				+ ", источник: " + Строка(СтрокаНастройки.Источник)
				+ ", счёт: " + Строка(СтрокаНастройки.БанковскийСчет));

			ЗагрузитьВыпискуПоНастройке(
				СтрокаНастройки,
				ДатаНачала,
				ДатаКонца,
				ДокументыКИмпорту);

		КонецЦикла;

		ДокументыКИмпорту.Сортировать("ДатаПроведения Убыв");

		// Поступления с подобранным заказом разносим сами: человеку остается
		// только то, где заказ не опознан. Задача по каждому такому платежу
		// ставится тут же, внутри.
		РазнестиПоступленияПоЗаказам(ДокументыКИмпорту);

		// Платежи без заказа — задача кассирам; они же могут переподписать
		// колонку «Ответственный», и это должно попасть в хранилище.
		СоздатьЗадачиКассирам(ДокументыКИмпорту);

		СохранитьТаблицуДокументовКИмпорту(ДокументыКИмпорту);

		ОбновитьДатуСледующейЗагрузки(ДокументыКИмпорту, ДатаКонца);

		Сообщить(
			"Загрузка банковских выписок завершена. "
			+ "Получено операций: "
			+ Строка(ДокументыКИмпорту.Количество()) + ".");

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка загрузки банковских выписок: " + ОписаниеОшибки());

		Сообщить("Ошибка загрузки банковских выписок: " + ОписаниеОшибки());

	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Настройки загрузки выписок, заданные в подразделениях.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Подразделение, БанковскийСчет, Источник,
//                     Токен, Айди, Направление.
//
Функция ПолучитьНастройкиЗагрузкиВыписок(Подразделение = Неопределено) Экспорт

	Результат = Новый ТаблицаЗначений;

	Результат.Колонки.Добавить("Подразделение");
	Результат.Колонки.Добавить("БанковскийСчет");
	Результат.Колонки.Добавить("Источник");
	Результат.Колонки.Добавить("Токен");
	Результат.Колонки.Добавить("Айди");
	Результат.Колонки.Добавить("Направление");
	Результат.Колонки.Добавить("НастройкаWayForPay");

	// Эквайринг настройки не требует: если у подразделения заполнена
	// «Настройка Wayforpay», этого достаточно — реквизиты продавца берутся
	// оттуда же, откуда их берёт создание инвойсов в заказе. Явно выбранный
	// источник (Приват24, Monobank) приоритетнее и требует токена с айди.
	// Счёт зачисления эквайринга живёт у мерчанта: у каждой настройки
	// WayForPay свой счёт и своя фирма (владелец счёта), а одно подразделение
	// принимает деньги сразу за несколько фирм. Счёт подразделения остаётся
	// для Приват24/Monobank и как запасной вариант.
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Подразделения.Ссылка КАК Подразделение,
	|	ВЫБОР
	|		КОГДА Подразделения.Настройка_WayforpayСД.БанковскийСчет <> &СчетНеЗадан
	|			ТОГДА Подразделения.Настройка_WayforpayСД.БанковскийСчет
	|		ИНАЧЕ Подразделения.БанковскийСчетВыписки
	|	КОНЕЦ КАК БанковскийСчет,
	|	ВЫБОР
	|		КОГДА Подразделения.ИсточникБанковскойВыписки = &ИсточникНеЗадан
	|			ТОГДА &WayForPay
	|		ИНАЧЕ Подразделения.ИсточникБанковскойВыписки
	|	КОНЕЦ КАК Источник,
	|	Подразделения.ТокенБанковскойВыписки КАК Токен,
	|	Подразделения.АйдиБанковскойВыписки КАК Айди,
	|	Подразделения.НаправлениеОперацийВыписки КАК Направление,
	|	Подразделения.Настройка_WayforpayСД КАК НастройкаWayForPay
	|ИЗ
	|	Справочник.Подразделения КАК Подразделения
	|ГДЕ
	|	НЕ Подразделения.ПометкаУдаления
	|	И Подразделения.ИсточникБанковскойВыписки <> &НеИспользуется
	|	И (Подразделения.ЗагружатьБанковскуюВыписку
	|			ИЛИ (Подразделения.ИсточникБанковскойВыписки = &ИсточникНеЗадан
	|				И Подразделения.Настройка_WayforpayСД <> &НастройкаНеЗадана))
	|	%УСЛОВИЕ%
	|
	|УПОРЯДОЧИТЬ ПО
	|	Подразделения.Наименование";

	Запрос = Новый Запрос;

	Если ЗначениеЗаполнено(Подразделение) Тогда

		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"%УСЛОВИЕ%",
			"И Подразделения.Ссылка = &Подразделение");

		Запрос.УстановитьПараметр("Подразделение", Подразделение);

	Иначе

		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%УСЛОВИЕ%", "");

	КонецЕсли;

	Запрос.Текст = ТекстЗапроса;

	ЭтоWayForPay = Перечисления.ИсточникиБанковскихВыписок.WayForPay;

	Запрос.УстановитьПараметр(
		"НеИспользуется",
		Перечисления.ИсточникиБанковскихВыписок.НеИспользуется);

	Запрос.УстановитьПараметр(
		"ИсточникНеЗадан",
		Перечисления.ИсточникиБанковскихВыписок.ПустаяСсылка());

	Запрос.УстановитьПараметр("WayForPay", ЭтоWayForPay);

	Запрос.УстановитьПараметр(
		"НастройкаНеЗадана",
		Справочники.wayforpay_НастройкиПодключения_СД.ПустаяСсылка());

	Запрос.УстановитьПараметр(
		"СчетНеЗадан",
		Справочники.БанковскиеСчета.ПустаяСсылка());

	Выборка = Запрос.Выполнить().Выбрать();

	// Один и тот же продавец может быть указан у нескольких подразделений —
	// опрашиваем его один раз, иначе те же транзакции придут дублями.
	ОпрошенныеПродавцы = Новый Соответствие;

	Пока Выборка.Следующий() Цикл

		// У WayForPay своих токена и айди нет: эквайринг опрашивается
		// реквизитами продавца из настройки подключения подразделения.
		Если Выборка.Источник = ЭтоWayForPay Тогда

			Если Не ЗначениеЗаполнено(Выборка.НастройкаWayForPay) Тогда

				Сообщить(
					"Подразделение «" + Строка(Выборка.Подразделение)
					+ "» пропущено: не заполнена настройка «Wayforpay».");

				Продолжить;

			КонецЕсли;

			Если ОпрошенныеПродавцы.Получить(Выборка.НастройкаWayForPay) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			ОпрошенныеПродавцы.Вставить(Выборка.НастройкаWayForPay, Истина);

		Иначе

			Если Не ЗначениеЗаполнено(Выборка.Токен) Тогда

				Сообщить(
					"Подразделение «" + Строка(Выборка.Подразделение)
					+ "» пропущено: не заполнен токен банковской выписки.");

				Продолжить;

			КонецЕсли;

			Если Не ЗначениеЗаполнено(Выборка.Айди) Тогда

				Сообщить(
					"Подразделение «" + Строка(Выборка.Подразделение)
					+ "» пропущено: не заполнен айди банковской выписки.");

				Продолжить;

			КонецЕсли;

			// Счёт организации у Приват24 и Monobank взять больше неоткуда:
			// у операции нет заказа, из которого его можно подставить.
			Если Не ЗначениеЗаполнено(Выборка.БанковскийСчет) Тогда

				Сообщить(
					"Подразделение «" + Строка(Выборка.Подразделение)
					+ "» пропущено: не заполнен банковский счет выписки.");

				Продолжить;

			КонецЕсли;

		КонецЕсли;

		НоваяСтрока = Результат.Добавить();

		НоваяСтрока.Подразделение      = Выборка.Подразделение;
		НоваяСтрока.БанковскийСчет     = Выборка.БанковскийСчет;
		НоваяСтрока.Источник           = Выборка.Источник;
		НоваяСтрока.Токен              = СокрЛП(Выборка.Токен);
		НоваяСтрока.Айди               = СокрЛП(Выборка.Айди);
		НоваяСтрока.Направление        = Выборка.Направление;
		НоваяСтрока.НастройкаWayForPay = Выборка.НастройкаWayForPay;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗагрузитьВыпискуПоНастройке(
	Настройка,
	ДатаНачала,
	ДатаКонца,
	ДокументыКИмпорту) Экспорт

	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат;

	КонецЕсли;

	Операции = Новый Массив;

	Если Настройка.Источник =
		Перечисления.ИсточникиБанковскихВыписок.Приват24Бизнес Тогда

		Операции = ПолучитьОперацииПриват24Бизнес(
			Настройка,
			ДатаНачала,
			ДатаКонца);

	ИначеЕсли Настройка.Источник =
		Перечисления.ИсточникиБанковскихВыписок.Monobank Тогда

		Операции = ПолучитьОперацииMonobank(
			Настройка,
			ДатаНачала,
			ДатаКонца);

	ИначеЕсли Настройка.Источник =
		Перечисления.ИсточникиБанковскихВыписок.WayForPay Тогда

		Операции = ПолучитьОперацииWayForPay(
			Настройка,
			ДатаНачала,
			ДатаКонца);

	КонецЕсли;

	ОтладкаВыписокСообщить(
		"Подразделение """ + Строка(Настройка.Подразделение)
		+ """, источник: " + Строка(Настройка.Источник)
		+ ", направление: "
		+ ?(ЗначениеЗаполнено(Настройка.Направление),
			Строка(Настройка.Направление), "Все")
		+ ", операций получено из банка: " + Строка(Операции.Количество()));

	Для Каждого БанковскаяОперация Из Операции Цикл

		Если Не ОперацияПодходитПоНаправлению(
			БанковскаяОперация,
			Настройка.Направление) Тогда

			Продолжить;

		КонецЕсли;

		ДобавитьБанковскуюОперациюВТаблицу(
			БанковскаяОперация,
			ДокументыКИмпорту);

	КонецЦикла;

КонецПроцедуры

// Направление = Неопределено / пустая ссылка / "Все" — операция подходит всегда.
Функция ОперацияПодходитПоНаправлению(БанковскаяОперация, Направление)

	Если Не ЗначениеЗаполнено(Направление)
		Или Направление = Перечисления.НаправлениеБанковскихОпераций.Все Тогда

		Возврат Истина;

	КонецЕсли;

	ЭтоВходящийПлатеж = Ложь;
	БанковскаяОперация.Свойство("Входящий", ЭтоВходящийПлатеж);

	Если Направление =
		Перечисления.НаправлениеБанковскихОпераций.Входящие Тогда

		Возврат ЭтоВходящийПлатеж;

	КонецЕсли;

	Если Направление =
		Перечисления.НаправлениеБанковскихОпераций.Исходящие Тогда

		Возврат Не ЭтоВходящийПлатеж;

	КонецЕсли;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ТаблицаДокументовКИмпорту

// Пустая таблица операций. Набор колонок повторяет табличную часть
// Обработка.ОбменПриват24.ДокументыКИмпорту — форма загружает таблицу
// из хранилища напрямую в неё.
//
// НомерДок = Строка(30) — ровно как НомерВходящегоДокумента у платёжных
// документов: длина ключа дедупликации задана в одном месте, значение
// не может молча усечься при записи документа.
Функция СоздатьТаблицуДокументовКИмпорту() Экспорт

	Таблица = Новый ТаблицаЗначений;

	Таблица.Колонки.Добавить("Загружать",
		Новый ОписаниеТипов("Булево"));

	Таблица.Колонки.Добавить("НомерДок",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)));

	Таблица.Колонки.Добавить("ДатаПроведения",
		Новый ОписаниеТипов("Дата"));

	// Дата зачисления средств продавцу (компенсация WayForPay).
	Таблица.Колонки.Добавить("ДатаКомпенсации",
		Новый ОписаниеТипов("Дата"));

	// Служебный флаг: дата компенсации заполнена и отличается от даты
	// платежа (по дню). По нему форма подсвечивает ячейку и меняет дату.
	Таблица.Колонки.Добавить("ДатаКомпенсацииОтличается",
		Новый ОписаниеТипов("Булево"));

	Таблица.Колонки.Добавить("Подразделение",
		Новый ОписаниеТипов("СправочникСсылка.Подразделения"));

	Таблица.Колонки.Добавить("СчетОрганизации",
		Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));

	// Счет организации из уже созданного платежного документа и признак его
	// расхождения со счетом из настройки подразделения (колонка выше).
	Таблица.Колонки.Добавить("СчетПлатежа",
		Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));

	Таблица.Колонки.Добавить("СчетОтличается",
		Новый ОписаниеТипов("Булево"));

	Таблица.Колонки.Добавить("СуммаПоступило",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	Таблица.Колонки.Добавить("СуммаСписано",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	Таблица.Колонки.Добавить("Валюта",
		Новый ОписаниеТипов("СправочникСсылка.Валюты"));

	Таблица.Колонки.Добавить("Остаток",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	Таблица.Колонки.Добавить("Терминал",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(256)));

	Таблица.Колонки.Добавить("Содержание",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000)));

	Таблица.Колонки.Добавить("Контрагент",
		Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));

	Таблица.Колонки.Добавить("Договор",
		Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));

	Таблица.Колонки.Добавить("Заказ",
		Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));

	Таблица.Колонки.Добавить("СуммаЗаказа",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	// Ответственный из заказа: по нему работает отбор «Только мои заказы».
	Таблица.Колонки.Добавить("Ответственный",
		Новый ОписаниеТипов("СправочникСсылка.Пользователи"));

	Таблица.Колонки.Добавить("ПлатежныйДокумент",
		Новый ОписаниеТипов(
			"ДокументСсылка.ПлатежноеПоручениеВходящее,"
			+ "ДокументСсылка.ПлатежноеПоручениеИсходящее,"
			+ "ДокументСсылка.ПриходныйКассовыйОрдер"));

	Таблица.Колонки.Добавить("Ошибка",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));

	// Код авторизации эквайринга: ключ дедупликации платежей WayForPay.
	Таблица.Колонки.Добавить("AuthCode",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));

	// Служебные колонки: по ним работает отбор строк на форме
	// (ОтборСтрок умеет только сравнение на равенство).
	Таблица.Колонки.Добавить("Входящий",
		Новый ОписаниеТипов("Булево"));

	Таблица.Колонки.Добавить("ЕстьДокумент",
		Новый ОписаниеТипов("Булево"));

	Возврат Таблица;

КонецФункции

// Таблица операций из хранилища общих настроек.
// Если в хранилище ничего нет либо набор колонок устарел — создаётся заново,
// поэтому регламентное задание работает и до первого открытия формы.
Функция ПолучитьТаблицуДокументовКИмпорту() Экспорт

	ДокументыКИмпорту = ХранилищеОбщихНастроек.Загрузить(
		"ОбменПриват24",
		"ДокументыКИмпорту",
		,
		"Пользователь");

	Если ТипЗнч(ДокументыКИмпорту) <> Тип("ТаблицаЗначений") Тогда
		Возврат СоздатьТаблицуДокументовКИмпорту();
	КонецЕсли;

	Эталон = СоздатьТаблицуДокументовКИмпорту();

	Для Каждого Колонка Из Эталон.Колонки Цикл

		Если ДокументыКИмпорту.Колонки.Найти(Колонка.Имя) = Неопределено Тогда

			ОтладкаВыписокСообщить(
				"Таблица операций пересоздана: в сохранённой не было "
				+ "колонки " + Колонка.Имя + ".");

			Возврат Эталон;

		КонецЕсли;

	КонецЦикла;

	Возврат ДокументыКИмпорту;

КонецФункции

Процедура СохранитьТаблицуДокументовКИмпорту(ДокументыКИмпорту) Экспорт

	ХранилищеОбщихНастроек.Сохранить(
		"ОбменПриват24",
		"ДокументыКИмпорту",
		ДокументыКИмпорту,
		,
		"Пользователь");

	ХранилищеОбщихНастроек.Сохранить(
		"ОбменПриват24",
		"ДатаПоследнейЗагрузки",
		ТекущаяДата(),
		,
		"Пользователь");

КонецПроцедуры

// Когда таблица операций последний раз обновлялась (форма показывает
// это в сводке под таблицей). Пустая дата — выписку еще не получали.
Функция ДатаПоследнегоОбновленияВыписки() Экспорт

	Дата = ХранилищеОбщихНастроек.Загрузить(
		"ОбменПриват24",
		"ДатаПоследнейЗагрузки",
		,
		"Пользователь");

	Если ТипЗнч(Дата) = Тип("Дата") Тогда
		Возврат Дата;
	КонецЕсли;

	Возврат '00010101';

КонецФункции

Процедура ОбновитьДатуСледующейЗагрузки(ДокументыКИмпорту, ДатаКонца)

	ДатаСледующейЗагрузки = НачалоДня(ДатаКонца);

	Для Каждого СтрокаДокумента Из ДокументыКИмпорту Цикл

		Если Не ЗначениеЗаполнено(СтрокаДокумента.ДатаПроведения) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(СтрокаДокумента.ПлатежныйДокумент) Тогда

			ДатаОперации = НачалоДня(СтрокаДокумента.ДатаПроведения);

			Если ДатаОперации < ДатаСледующейЗагрузки Тогда
				ДатаСледующейЗагрузки = ДатаОперации;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	// Небольшой нахлест, чтобы не потерять операции на границе периодов.
	ДатаСледующейЗагрузки = ДатаСледующейЗагрузки - 2 * 24 * 60 * 60;

	Константы.Приват24НачалПериод.Установить(ДатаСледующейЗагрузки);

КонецПроцедуры

Функция СоздатьБанковскуюОперацию() Экспорт

	Операция = Новый Структура;

	Операция.Вставить("Источник", Неопределено);
	Операция.Вставить("Идентификатор", "");
	Операция.Вставить("КлючДубляСтраниц", "");
	Операция.Вставить("БанковскийСчет", Неопределено);
	Операция.Вставить("Подразделение", Неопределено);

	// Заполняются только для эквайринга WayForPay: по паре «заказ + AuthCode»
	// ищется платёж, созданный кнопкой «Получить оплату» из самого заказа.
	Операция.Вставить("AuthCode", "");
	Операция.Вставить("Заказ", Неопределено);

	Операция.Вставить("Дата", Неопределено);

	// Дата зачисления средств продавцу (settlement). Заполняет WayForPay.
	Операция.Вставить("ДатаКомпенсации", Неопределено);

	Операция.Вставить("Сумма", 0);
	Операция.Вставить("Валюта", Неопределено);

	Операция.Вставить("Входящий", Ложь);

	Операция.Вставить("Остаток", 0);
	Операция.Вставить("Терминал", "");
	Операция.Вставить("Назначение", "");

	Возврат Операция;

КонецФункции

Процедура ДобавитьБанковскуюОперациюВТаблицу(
	БанковскаяОперация,
	ДокументыКИмпорту) Экспорт

	Если БанковскаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ДокументыКИмпорту) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторОперации = "";
	ДатаОперации          = Неопределено;
	ДатаКомпенсации       = Неопределено;
	СуммаОперации         = 0;
	ВалютаОперации        = Неопределено;
	ЭтоВходящийПлатеж     = Ложь;
	БанковскийСчет        = Неопределено;
	Подразделение         = Неопределено;
	Остаток               = 0;
	Терминал              = "";
	Назначение            = "";
	Источник              = Неопределено;

	БанковскаяОперация.Свойство("Источник",       Источник);
	БанковскаяОперация.Свойство("Идентификатор",  ИдентификаторОперации);
	БанковскаяОперация.Свойство("Дата",           ДатаОперации);
	БанковскаяОперация.Свойство("ДатаКомпенсации", ДатаКомпенсации);
	БанковскаяОперация.Свойство("Сумма",          СуммаОперации);
	БанковскаяОперация.Свойство("Валюта",         ВалютаОперации);
	БанковскаяОперация.Свойство("Входящий",       ЭтоВходящийПлатеж);
	БанковскаяОперация.Свойство("БанковскийСчет", БанковскийСчет);
	БанковскаяОперация.Свойство("Подразделение",  Подразделение);
	БанковскаяОперация.Свойство("Остаток",        Остаток);
	БанковскаяОперация.Свойство("Терминал",       Терминал);
	БанковскаяОперация.Свойство("Назначение",     Назначение);

	AuthCode = "";
	Заказ    = Неопределено;

	БанковскаяОперация.Свойство("AuthCode", AuthCode);
	БанковскаяОперация.Свойство("Заказ",    Заказ);

	ИдентификаторОперации = СокрЛП(Строка(ИдентификаторОперации));

	Если ПустаяСтрока(ИдентификаторОперации) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат;
	КонецЕсли;

	// Страховка от источника, отдавшего сумму строкой.
	СуммаОперации = ЧислоИзСтрокиПриват24(СуммаОперации);

	Если СуммаОперации < 0 Тогда
		СуммаОперации = -СуммаОперации;
	КонецЕсли;

	НоваяСтрока = ДокументыКИмпорту.Добавить();

	// Ключ дедупликации = НомерВходящегоДокумента создаваемого документа.
	// Колонка и реквизит документа одной длины — Строка(30), поэтому молчаливого
	// усечения (и разъехавшегося дедупа) здесь быть не может. Если банк вернёт
	// идентификатор длиннее — операцию не берём, чтобы не создать дубль.
	Если СтрДлина(ИдентификаторОперации) > 30 Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Операция пропущена: идентификатор длиннее 30 символов — «"
			+ ИдентификаторОперации + "».");

		ДокументыКИмпорту.Удалить(НоваяСтрока);

		Возврат;

	КонецЕсли;

	НоваяСтрока.НомерДок = ИдентификаторОперации;

	НоваяСтрока.СчетОрганизации = БанковскийСчет;
	НоваяСтрока.Подразделение   = Подразделение;
	НоваяСтрока.ДатаПроведения  = ДатаОперации;
	НоваяСтрока.Валюта          = ВалютаОперации;

	// Дата компенсации заполняется всегда — она для проверки глазами.
	// Расхождением она становится только при наличии платежного документа
	// (см. ЗаполнитьСтрокуНайденнымДокументом): пока платеж не заведен,
	// расходиться нечему — зачисление на следующий день после оплаты
	// это нормальная работа эквайринга, а не ошибка.
	Если ЗначениеЗаполнено(ДатаКомпенсации) Тогда
		НоваяСтрока.ДатаКомпенсации = ДатаКомпенсации;
	КонецЕсли;

	НоваяСтрока.Входящий = ЭтоВходящийПлатеж;

	Если ЭтоВходящийПлатеж Тогда
		НоваяСтрока.СуммаПоступило = СуммаОперации;
		НоваяСтрока.СуммаСписано   = 0;
	Иначе
		НоваяСтрока.СуммаПоступило = 0;
		НоваяСтрока.СуммаСписано   = СуммаОперации;
	КонецЕсли;

	НоваяСтрока.Остаток    = Остаток;
	НоваяСтрока.Терминал   = СокрЛП(Терминал);
	НоваяСтрока.Содержание = СокрЛП(Назначение);
	НоваяСтрока.AuthCode   = СокрЛП(Строка(AuthCode));

	Если ЗначениеЗаполнено(Заказ) Тогда
		НоваяСтрока.Заказ         = Заказ;
		НоваяСтрока.Контрагент    = Заказ.Контрагент;
		НоваяСтрока.Договор       = Заказ.ДоговорКонтрагента;
		НоваяСтрока.СуммаЗаказа   = Заказ.СуммаДокумента;
		НоваяСтрока.Ответственный = Заказ.Ответственный;
	КонецЕсли;

	// По умолчанию операцию не загружаем; ниже отметим к загрузке,
	// если заказ опознан, а платежного документа еще нет.
	НоваяСтрока.Загружать = Ложь;

	// Платёж эквайринга мог быть уже заведён кнопкой «Получить оплату»
	// из самого заказа — там ключ не НомерВходящегоДокумента, а AuthCode.
	Если ЗначениеЗаполнено(Заказ) И Не ПустаяСтрока(СокрЛП(Строка(AuthCode))) Тогда

		НайденныйДокумент =
			Документы.ПлатежноеПоручениеВходящее.НайтиПлатежноеПоручениеWayForPay(
				Заказ,
				AuthCode);

		Если Не ЗначениеЗаполнено(НайденныйДокумент) Тогда
			НайденныйДокумент = НайтиДокументПоБанковскойОперации(БанковскаяОперация);
		КонецЕсли;

	Иначе

		НайденныйДокумент = НайтиДокументПоБанковскойОперации(БанковскаяОперация);

	КонецЕсли;

	// Платеж по заказу могли завести вручную до появления загрузки выписок —
	// без входящего номера и кода авторизации. Такой опознаем по сумме.
	Если Не ЗначениеЗаполнено(НайденныйДокумент)
		И ЗначениеЗаполнено(Заказ)
		И ЭтоВходящийПлатеж Тогда

		НайденныйДокумент =
			Документы.ПлатежноеПоручениеВходящее.НайтиПлатежПоЗаказуИСумме(
				Заказ,
				СуммаОперации);

	КонецЕсли;

	ОтладкаВыписокСообщить(
		"Операция [" + ИдентификаторОперации + "]"
		+ " | " + ?(ЭтоВходящийПлатеж, "поступление", "списание")
		+ " | " + Формат(ДатаОперации, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ " | сумма " + Строка(СуммаОперации)
		+ " | документ: "
		+ ?(ЗначениеЗаполнено(НайденныйДокумент),
			Строка(НайденныйДокумент), "НЕ НАЙДЕН"));

	Если ЗначениеЗаполнено(НайденныйДокумент) Тогда

		ЗаполнитьСтрокуНайденнымДокументом(НоваяСтрока, НайденныйДокумент);

	ИначеЕсли ЭтоВходящийПлатеж Тогда

		// Новый платёж-поступление без документа: подставляем контрагента
		// по коду/ФИО из назначения, чтобы платежи в списке были опознаны.
		// Заказ подбирает пользователь: статусной модели "активного заказа"
		// в этой конфигурации нет.
		ЗаполнитьКонтрагентаПоНазначению(НоваяСтрока, Назначение);

		ОтладкаВыписокСообщить(
			"    авто-подстановка: контрагент "
			+ ?(ЗначениеЗаполнено(НоваяСтрока.Контрагент),
				Строка(НоваяСтрока.Контрагент), "—")
			+ ", к загрузке: " + ?(НоваяСтрока.Загружать, "ДА", "нет"));

	КонецЕсли;

	// Заказ опознан, документа еще нет — операцию сразу отмечаем к загрузке,
	// чтобы «Загрузить в 1С» можно было жать пачкой без ручного разбора.
	Если ЗначениеЗаполнено(Заказ) И Не ЗначениеЗаполнено(НайденныйДокумент) Тогда
		НоваяСтрока.Загружать = Истина;
	КонецЕсли;

КонецПроцедуры

// Поступления с подобранным заказом разносим автоматически: платеж создается
// сразу при получении выписки, а ответственному по заказу ставится задача
// «получена оплата». Человеку в обработке остаются только те операции,
// у которых заказ не опознан.
//
// Ответственный берется из заказа; если он сегодня не в смене (график Magento)
// или не заполнен, платеж достается наименее загруженному менеджеру смены —
// и в задаче, и в колонке «Ответственный», чтобы у заместителя работали
// отбор «Только мои заказы» и загрузка.
Процедура РазнестиПоступленияПоЗаказам(ДокументыКИмпорту)

	МенеджерыСмены = МенеджерыТекущейСмены();
	Дежурный       = Неопределено;

	Разнесено = 0;

	Для Каждого СтрокаОперации Из ДокументыКИмпорту Цикл

		Если СтрокаОперации.ЕстьДокумент
			Или Не ЗначениеЗаполнено(СтрокаОперации.Заказ)
			Или СтрокаОперации.СуммаПоступило = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Ответственный строки — он же исполнитель задачи.
		Менеджер = СтрокаОперации.Ответственный;

		Если МенеджерыСмены.Количество() > 0
			И (Не ЗначениеЗаполнено(Менеджер)
				Или МенеджерыСмены.Найти(Менеджер) = Неопределено) Тогда

			Если Дежурный = Неопределено Тогда
				Дежурный = НаименееЗагруженныйМенеджер(МенеджерыСмены);
			КонецЕсли;

			Менеджер = Дежурный;
			СтрокаОперации.Ответственный = Дежурный;

		КонецЕсли;

		Результат = СоздатьПоступлениеПоСтроке(СтрокаОперации);

		Если Не Результат.Успешно Тогда

			СтрокаОперации.Ошибка = Результат.Сообщение;

			ОтладкаВыписокСообщить(
				"    автозагрузка [" + СокрЛП(СтрокаОперации.НомерДок) + "]: "
				+ Результат.Сообщение);

			Продолжить;

		КонецЕсли;

		СтрокаОперации.Ошибка = "";

		ЗаполнитьСтрокуНайденнымДокументом(СтрокаОперации, Результат.Ссылка);

		Разнесено = Разнесено + 1;

		СоздатьЗадачуПоСозданномуПлатежу(
			СтрокаОперации.Заказ,
			Результат.Ссылка,
			Менеджер);

	КонецЦикла;

	Если Разнесено > 0 Тогда
		ОтладкаВыписокСообщить("Разнесено платежей автоматически: " + Строка(Разнесено));
	КонецЕсли;

КонецПроцедуры

// Платежное поручение входящее по строке выписки. Тот же вызов, что делает
// кнопка «Загрузить в 1С» в форме обработки: дедупликация — внутри
// СоздатьПлатежПоЗаказу, повторный запуск дублей не создает.
Функция СоздатьПоступлениеПоСтроке(СтрокаОперации)

	Платеж = Документы.ПлатежноеПоручениеВходящее.ОписаниеПлатежаПоЗаказу();

	Платеж.Сумма                   = СтрокаОперации.СуммаПоступило;
	Платеж.ДатаПлатежа             = ДатаПлатежаПоСтроке(СтрокаОперации);
	Платеж.НомерВходящегоДокумента = СтрокаОперации.НомерДок;
	Платеж.AuthCode                = СтрокаОперации.AuthCode;
	Платеж.СчетОрганизации         = СтрокаОперации.СчетОрганизации;
	Платеж.Подразделение           = СтрокаОперации.Подразделение;
	Платеж.Контрагент              = СтрокаОперации.Контрагент;
	Платеж.ДоговорКонтрагента      = СтрокаОперации.Договор;
	Платеж.НазначениеПлатежа       = СтрокаОперации.Содержание;
	Платеж.Комментарий             = "Выписка " + СокрЛП(СтрокаОперации.НомерДок);

	Возврат Документы.ПлатежноеПоручениеВходящее.СоздатьПлатежПоЗаказу(
		СтрокаОперации.Заказ,
		Платеж);

КонецФункции

// Дата создаваемого платежа: дата зачисления денег, если эквайринг ее уже
// вернул, иначе дата операции. Ставим ее сразу, чтобы платеж не оказывался
// «с расхождением» с первой же минуты жизни: у WayForPay зачисление приходит
// следующим днем. Если компенсация появится позже (платеж завели раньше, чем
// деньги зашли), строка подсветится, и дата переносится кнопкой «Изменить
// дату платежа».
Функция ДатаПлатежаПоСтроке(СтрокаОперации) Экспорт

	Если ЗначениеЗаполнено(СтрокаОперации.ДатаКомпенсации) Тогда
		Возврат СтрокаОперации.ДатаКомпенсации;
	КонецЕсли;

	Возврат СтрокаОперации.ДатаПроведения;

КонецФункции

// Платежи, у которых заказ не опознан, разбирают кассиры: каждому кассиру
// из группы ставится задача со списком таких операций.
//
// Одна задача на группу технически невозможна: реквизит адресации
// «Исполнитель» — только элемент справочника Пользователи, а типовой отбор
// задач идет по ЗадачиПоИсполнителю(ТекущийПользователь), группы он
// не раскрывает. Поэтому задача ставится каждому кассиру, а дедупликация
// по паре «исполнитель + наименование» не дает плодить их при повторных
// нажатиях «Получить выписку».
Процедура СоздатьЗадачиКассирам(ДокументыКИмпорту)

	СписокПлатежей = Новый Массив;

	Для Каждого СтрокаОперации Из ДокументыКИмпорту Цикл

		Если СтрокаОперации.ЕстьДокумент
			Или ЗначениеЗаполнено(СтрокаОперации.Заказ)
			Или СтрокаОперации.СуммаПоступило = 0 Тогда
			Продолжить;
		КонецЕсли;

		СписокПлатежей.Добавить(
			СокрЛП(СтрокаОперации.НомерДок)
			+ " от " + Формат(СтрокаОперации.ДатаПроведения, "ДФ=dd.MM.yyyy")
			+ " — " + СокрЛП(Строка(СтрокаОперации.Контрагент))
			+ ", сумма " + Строка(СтрокаОперации.СуммаПоступило));

	КонецЦикла;

	Если СписокПлатежей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Кассир Из Кассиры() Цикл
		СоздатьЗадачуКассиру(Кассир, СписокПлатежей);
	КонецЦикла;

КонецПроцедуры

// Пользователи из группы кассиров справочника Пользователи.
// Группа ищется по наименованию: у нее нет ни реквизита-признака, ни
// предопределенного элемента, а заводить их — структурная правка базы.
Функция Кассиры()

	Кассиры = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	НЕ Пользователи.ЭтоГруппа
	|	И НЕ Пользователи.ПометкаУдаления
	|	И Пользователи.Ссылка В ИЕРАРХИИ (&Группа)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пользователи.Наименование";

	Группа = ГруппаКассиров();

	Если Не ЗначениеЗаполнено(Группа) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"В справочнике Пользователи не найдена группа кассиров"
			+ " — задачи по платежам без заказа не поставлены.");

		Возврат Кассиры;

	КонецЕсли;

	Запрос.УстановитьПараметр("Группа", Группа);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Кассиры.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Кассиры;

КонецФункции

Функция ГруппаКассиров()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ЭтоГруппа
	|	И НЕ Пользователи.ПометкаУдаления
	|	И (Пользователи.Наименование ПОДОБНО &ШаблонУкр
	|		ИЛИ Пользователи.Наименование ПОДОБНО &ШаблонРус)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пользователи.Наименование";

	// Группа кассиров опознается по наименованию: ни реквизита-признака,
	// ни предопределенного элемента у нее нет.
	Запрос.УстановитьПараметр("ШаблонУкр", "%Касир%");
	Запрос.УстановитьПараметр("ШаблонРус", "%Кассир%");

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Пользователи.ПустаяСсылка();

КонецФункции

// Менеджеры текущей смены: табличная часть последнего проведенного
// документа «График работы менеджеров Magento» — точно так же текущую
// смену определяет распределение предзаказов (Справочники.Пользователи).
// Пустой массив = графиков в базе нет, переназначение не выполняется.
Функция МенеджерыТекущейСмены()

	Менеджеры = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(График.Номер) КАК Номер
	|ПОМЕСТИТЬ ВТПоследнийГрафик
	|ИЗ
	|	Документ.БП_ГрафикРаботыМенеджеровMagento КАК График
	|ГДЕ
	|	НЕ График.ПометкаУдаления
	|	И График.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГрафикМенеджера.Менеджер КАК Менеджер
	|ИЗ
	|	Документ.БП_ГрафикРаботыМенеджеровMagento.Менеджера КАК ГрафикМенеджера
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоследнийГрафик КАК ВТПоследнийГрафик
	|		ПО ГрафикМенеджера.Ссылка.Номер = ВТПоследнийГрафик.Номер
	|ГДЕ
	|	ГрафикМенеджера.Менеджер <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Менеджеры.Добавить(Выборка.Менеджер);
	КонецЦикла;

	Возврат Менеджеры;

КонецФункции

// Менеджер смены с наименьшим числом невыполненных задач по выпискам.
Функция НаименееЗагруженныйМенеджер(МенеджерыСмены)

	Если МенеджерыСмены.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачиПользователя.Исполнитель КАК Исполнитель,
	|	КОЛИЧЕСТВО(ЗадачиПользователя.Ссылка) КАК КоличествоЗадач
	|ИЗ
	|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
	|ГДЕ
	|	НЕ ЗадачиПользователя.Выполнена
	|	И ЗадачиПользователя.Наименование ПОДОБНО &Наименование
	|	И ЗадачиПользователя.Исполнитель В(&Исполнители)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗадачиПользователя.Исполнитель";

	// Загрузку считаем по невыполненным задачам об оплатах: с переходом
	// на задачу по каждому платежу общей задачи «разнести платежи»
	// у менеджеров больше нет.
	Запрос.УстановитьПараметр("Наименование", НачалоНаименованияЗадачиОбОплате() + "%");
	Запрос.УстановитьПараметр("Исполнители", МенеджерыСмены);

	Загрузка = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Загрузка.Вставить(Выборка.Исполнитель, Выборка.КоличествоЗадач);
	КонецЦикла;

	Выбранный        = МенеджерыСмены[0];
	МинимумЗадач     = Неопределено;

	Для Каждого Менеджер Из МенеджерыСмены Цикл

		ЗадачМенеджера = Загрузка[Менеджер];

		Если ЗадачМенеджера = Неопределено Тогда
			ЗадачМенеджера = 0;
		КонецЕсли;

		Если МинимумЗадач = Неопределено Или ЗадачМенеджера < МинимумЗадач Тогда
			МинимумЗадач = ЗадачМенеджера;
			Выбранный    = Менеджер;
		КонецЕсли;

	КонецЦикла;

	Возврат Выбранный;

КонецФункции

// Наименование задачи кассирам: платежи, по которым заказ не опознан.
Функция НаименованиеЗадачиПоВыписке()

	Возврат "Разнести платежи из банковской выписки";

КонецФункции

// Начало наименования задачи о поступившей оплате по заказу. По нему же
// задачи опознаются при открытии (ЭтоЗадачаПоВыписке) и считается загрузка
// менеджеров.
Функция НачалоНаименованияЗадачиОбОплате()

	Возврат "Оплачен заказ";

КонецФункции

// Задача поставлена загрузкой выписки? По таким задачам форма задачи вместо
// себя открывает обработку «Банковские выписки».
Функция ЭтоЗадачаПоВыписке(Задача) Экспорт

	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка

		Наименование = СокрЛП(Строка(Задача.Наименование));

		Возврат Лев(Наименование, СтрДлина(НачалоНаименованияЗадачиОбОплате()))
				= НачалоНаименованияЗадачиОбОплате()
			Или Наименование = НаименованиеЗадачиПоВыписке();

	Исключение

		Возврат Ложь;

	КонецПопытки;

КонецФункции

// Помечает задачу выполненной. Зовется из формы задачи в момент открытия:
// задача — это уведомление «зайди в обработку», а не единица работы,
// поэтому она закрывается самим фактом перехода в обработку.
Процедура ВыполнитьЗадачуПоВыписке(Задача) Экспорт

	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		ЗадачаОбъект = Задача.ПолучитьОбъект();

		Если ЗадачаОбъект = Неопределено Или ЗадачаОбъект.Выполнена Тогда
			Возврат;
		КонецЕсли;

		ЗадачаОбъект.Выполнена      = Истина;
		ЗадачаОбъект.ДатаИсполнения = ТекущаяДата();

		ЗадачаОбъект.Записать();

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не удалось выполнить задачу «" + Строка(Задача)
			+ "»: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Задача ответственному менеджеру заказа о созданном платежном документе.
// Вызывается после «Загрузить в 1С» из обработки БанковскиеВыписки.
//
// Дубль отсекается по паре «заказ + наименование» (в наименовании — номер
// платежного документа), выполненные задачи тоже считаются: повторное
// создание задачи по тому же платежу невозможно.
Процедура СоздатьЗадачуПоСозданномуПлатежу(
	Заказ,
	ПлатежныйДокумент,
	Исполнитель = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Заказ)
		Или Не ЗначениеЗаполнено(ПлатежныйДокумент) Тогда
		Возврат;
	КонецЕсли;

	// Исполнитель передается автозагрузкой (там уже учтена смена и тестовый
	// режим); при ручной загрузке из формы берется ответственный заказа.
	Ответственный = Исполнитель;

	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = Заказ.Ответственный;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		Возврат;
	КонецЕсли;

	Наименование = Лев(
		НачалоНаименованияЗадачиОбОплате() + " " + СокрЛП(Заказ.Номер)
		+ " — платеж " + СокрЛП(Строка(ПлатежныйДокумент.Номер)),
		100);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗадачиПользователя.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
	|ГДЕ
	|	ЗадачиПользователя.Объект = &Объект
	|	И ЗадачиПользователя.Наименование = &Наименование";

	Запрос.УстановитьПараметр("Объект", Заказ);
	Запрос.УстановитьПараметр("Наименование", Наименование);

	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;

	// Ошибка постановки задачи не должна валить создание платежей.
	Попытка

		Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();

		Задача.Наименование   = Наименование;
		Задача.Объект         = Заказ;
		Задача.Исполнитель    = Ответственный;
		Задача.Дата           = ТекущаяДата();
		Задача.СрокИсполнения = КонецДня(Задача.Дата);
		Задача.Оповещение     = Истина;
		Задача.СрокОповещения = Задача.Дата;

		Задача.Описание =
			"По заказу " + Строка(Заказ)
			+ " создан платежный документ " + Строка(ПлатежныйДокумент)
			+ " на сумму " + Строка(ПлатежныйДокумент.СуммаДокумента) + ".";

		Задача.Записать();

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не удалось создать задачу о платеже «"
			+ Строка(ПлатежныйДокумент) + "»: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Задача кассиру: платежи, по которым заказ не опознан. Пока у кассира висит
// невыполненная задача с этим наименованием, новая не создается — повторные
// нажатия «Получить выписку» задач не плодят. Если задачу закрыли, а
// неопознанные платежи остались, следующая загрузка поставит ее заново.
Процедура СоздатьЗадачуКассиру(Кассир, СписокПлатежей)

	НаименованиеЗадачи = НаименованиеЗадачиПоВыписке();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗадачиПользователя.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
	|ГДЕ
	|	НЕ ЗадачиПользователя.Выполнена
	|	И ЗадачиПользователя.Исполнитель = &Исполнитель
	|	И ЗадачиПользователя.Наименование = &Наименование";

	Запрос.УстановитьПараметр("Исполнитель", Кассир);
	Запрос.УстановитьПараметр("Наименование", НаименованиеЗадачи);

	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;

	// Ошибка постановки задачи не должна валить загрузку выписки.
	Попытка

		Описание =
			"В банковской выписке есть платежи, по которым не опознан заказ"
			+ " — откройте обработку, подберите заказ или контрагента"
			+ " и разнесите платежи:";

		Для Каждого СтрокаПлатежа Из СписокПлатежей Цикл
			Описание = Описание + Символы.ПС + СтрокаПлатежа;
		КонецЦикла;

		Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();

		Задача.Наименование   = НаименованиеЗадачи;
		Задача.Исполнитель    = Кассир;
		Задача.Дата           = ТекущаяДата();
		Задача.СрокИсполнения = КонецДня(Задача.Дата);
		Задача.Оповещение     = Истина;
		Задача.СрокОповещения = Задача.Дата;
		Задача.Описание       = Описание;

		Задача.Записать();

		ОтладкаВыписокСообщить(
			"Задача кассиру " + Строка(Кассир)
			+ ": платежей без заказа " + Строка(СписокПлатежей.Количество()));

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не удалось создать задачу для «" + Строка(Кассир)
			+ "»: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

Процедура ЗаполнитьСтрокуНайденнымДокументом(
	СтрокаИмпорта,
	ДокументОплаты) Экспорт

	Если Не ЗначениеЗаполнено(ДокументОплаты) Тогда
		Возврат;
	КонецЕсли;

	// Маркер «строка уже принята»: по нему отбор «Только новые» на форме
	// убирает уже загруженные платежи — и входящие ПП, и исходящие, и ПКО.
	СтрокаИмпорта.ПлатежныйДокумент = ДокументОплаты;
	СтрокаИмпорта.ЕстьДокумент      = Истина;

	// Реквизиты есть не у всех трёх типов документов (у ПКО нет договора
	// и документа-основания), поэтому читаем через Попытка.
	Попытка
		СтрокаИмпорта.Заказ = ДокументОплаты.ДокументОснование;
		Если ЗначениеЗаполнено(СтрокаИмпорта.Заказ) Тогда
			СтрокаИмпорта.Ответственный = СтрокаИмпорта.Заказ.Ответственный;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаИмпорта.СуммаЗаказа = ДокументОплаты.СуммаДокумента;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаИмпорта.Контрагент = ДокументОплаты.Контрагент;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаИмпорта.Договор = ДокументОплаты.ДоговорКонтрагента;
	Исключение
	КонецПопытки;

	СтрокаИмпорта.Загружать = Ложь;

	// Счет организации платежа против счета из настройки подразделения:
	// деньги пришли на один счет, а платеж заведен на другой — это ошибка
	// разнесения, и увидеть ее нужно сразу в списке.
	Попытка

		СтрокаИмпорта.СчетПлатежа = ДокументОплаты.СчетОрганизации;

		СтрокаИмпорта.СчетОтличается =
			ЗначениеЗаполнено(СтрокаИмпорта.СчетОрганизации)
			И ЗначениеЗаполнено(СтрокаИмпорта.СчетПлатежа)
			И СтрокаИмпорта.СчетПлатежа <> СтрокаИмпорта.СчетОрганизации;

	Исключение
		// У ПКО реквизита может не быть.
	КонецПопытки;

	// Расхождение — это когда дата платежного документа не совпадает с датой
	// зачисления из API, причем точно, до секунды: платеж должен стоять ровно
	// на дате компенсации. Сравниваем именно с документом, а не с датой
	// операции банка — «оплата вчера, зачисление сегодня» это норма
	// эквайринга. Строки без документа расхождением быть не могут.
	Если ЗначениеЗаполнено(СтрокаИмпорта.ДатаКомпенсации) Тогда

		СтрокаИмпорта.ДатаКомпенсацииОтличается =
			(ДокументОплаты.Дата <> СтрокаИмпорта.ДатаКомпенсации);

	Иначе

		СтрокаИмпорта.ДатаКомпенсацииОтличается = Ложь;

	КонецЕсли;

КонецПроцедуры

// Авто-подстановка контрагента для нового платежа-поступления по тексту
// назначения ("Від: <ФИО>. ... <код контрагента>").
Процедура ЗаполнитьКонтрагентаПоНазначению(СтрокаИмпорта, Назначение)

	Если ПустаяСтрока(СокрЛП(Строка(Назначение))) Тогда
		Возврат;
	КонецЕсли;

	НайденоПоКоду = Ложь;
	Контрагент = НайтиКонтрагентаПоНазначению(Назначение, НайденоПоКоду);

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СтрокаИмпорта.Контрагент = Контрагент;
	Исключение
	КонецПопытки;

	// Контрагент опознан по коду из назначения — платёж сразу отмечаем
	// к загрузке (совпадение кода — надёжный признак).
	Если НайденоПоКоду Тогда
		Попытка
			СтрокаИмпорта.Загружать = Истина;
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Контрагент по назначению: сначала по коду (9 цифр), затем по ФИО из "Від:".
// НайденоПоКоду возвращает Истина, если совпал именно код.
Функция НайтиКонтрагентаПоНазначению(Назначение, НайденоПоКоду = Ложь)

	НайденоПоКоду = Ложь;

	Код = ИзвлечьКодКонтрагентаИзНазначения(Назначение);

	Если Не ПустаяСтрока(Код) Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Код = &Код
		|	И НЕ Контрагенты.ПометкаУдаления";

		Запрос.УстановитьПараметр("Код", Код);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			НайденоПоКоду = Истина;
			Возврат Выборка.Ссылка;
		КонецЕсли;

	КонецЕсли;

	ФИО = ИзвлечьФИООтправителяИзНазначения(Назначение);

	Если Не ПустаяСтрока(ФИО) Тогда

		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(ФИО, Истина);

		Если ЗначениеЗаполнено(Контрагент) Тогда
			Возврат Контрагент;
		КонецЕсли;

	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Код контрагента — ровно 9 цифр (Справочник.Контрагенты, фикс. длина кода 9).
Функция ИзвлечьКодКонтрагентаИзНазначения(Назначение)

	Текст = Строка(Назначение);
	Цифры = "";

	Для Позиция = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Позиция, 1);

		Если Найти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		Иначе
			Если СтрДлина(Цифры) = 9 Тогда
				Возврат Цифры;
			КонецЕсли;
			Цифры = "";
		КонецЕсли;

	КонецЦикла;

	Если СтрДлина(Цифры) = 9 Тогда
		Возврат Цифры;
	КонецЕсли;

	Возврат "";

КонецФункции

// ФИО отправителя после "Від:" / "От:" / "Отправитель:" — до первой точки.
Функция ИзвлечьФИООтправителяИзНазначения(Назначение)

	Текст = Строка(Назначение);

	Метки = Новый Массив;
	Метки.Добавить("Від:");
	Метки.Добавить("От:");
	Метки.Добавить("Отправитель:");

	Для Каждого Метка Из Метки Цикл

		Поз = Найти(Текст, Метка);

		Если Поз > 0 Тогда

			Хвост = Сред(Текст, Поз + СтрДлина(Метка));

			ПозТочки = Найти(Хвост, ".");
			Если ПозТочки > 0 Тогда
				Хвост = Лев(Хвост, ПозТочки - 1);
			КонецЕсли;

			Возврат СокрЛП(Хвост);

		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область ПоискСуществующихПлатежныхДокументов

// Универсальный поиск существующего платёжного документа, чтобы не создавать
// платежи повторно.
//   Вариант 1 — передана структура банковской операции: поиск по направлению.
//   Вариант 2 — переданы код (НомерВходящегоДокумента) и дата: возвращаем
//               существующее ПлатежноеПоручениеВходящее либо пустую ссылку.
Функция НайтиДокументПоБанковскойОперации(Операция, Дата = Неопределено) Экспорт

	Если ТипЗнч(Операция) = Тип("Структура")
		Или ТипЗнч(Операция) = Тип("Соответствие") Тогда

		Возврат НайтиДокументПоСтруктуреОперации(Операция);

	КонецЕсли;

	Ссылка = НайтиВходящийБанковскийПлатеж(СокрЛП(Строка(Операция)), Дата);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Ссылка = НайтиПлатежноеПоручениеИсходящееПоОперации(
		СокрЛП(Строка(Операция)),
		Дата);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка();

КонецФункции

Функция НайтиДокументПоСтруктуреОперации(БанковскаяОперация) Экспорт

	Если БанковскаяОперация = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИдентификаторОперации = "";
	ДатаОперации          = Неопределено;
	ЭтоВходящийПлатеж     = Ложь;

	Если Не БанковскаяОперация.Свойство(
		"Идентификатор",
		ИдентификаторОперации) Тогда

		Возврат Неопределено;

	КонецЕсли;

	Если Не БанковскаяОперация.Свойство("Дата", ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не БанковскаяОперация.Свойство("Входящий", ЭтоВходящийПлатеж) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИдентификаторОперации = СокрЛП(Строка(ИдентификаторОперации));

	Если ПустаяСтрока(ИдентификаторОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЭтоВходящийПлатеж Тогда

		Возврат НайтиВходящийБанковскийПлатеж(
			ИдентификаторОперации,
			ДатаОперации);

	Иначе

		Возврат НайтиИсходящийБанковскийПлатеж(
			ИдентификаторОперации,
			ДатаОперации);

	КонецЕсли;

КонецФункции

// Реализация живёт в модуле менеджера документа: платёжная часть (эквайринг
// WayForPay) не должна зависеть от загрузки выписок, а наоборот — можно.
Функция НайтиВходящийБанковскийПлатеж(
	ИдентификаторОперации,
	ДатаОперации) Экспорт

	Возврат Документы.ПлатежноеПоручениеВходящее.НайтиПоНомеруВходящегоДокумента(
		ИдентификаторОперации,
		ДатаОперации);

КонецФункции

Функция НайтиИсходящийБанковскийПлатеж(
	ИдентификаторОперации,
	ДатаОперации) Экспорт

	ДокументОплаты = НайтиПлатежноеПоручениеИсходящееПоОперации(
		ИдентификаторОперации,
		ДатаОперации);

	Если ЗначениеЗаполнено(ДокументОплаты) Тогда
		Возврат ДокументОплаты;
	КонецЕсли;

	Возврат НайтиКассовыйОрдерПоБанковскойОперации(
		ИдентификаторОперации,
		ДатаОперации);

КонецФункции

Функция НайтиПлатежноеПоручениеИсходящееПоОперации(
	ИдентификаторОперации,
	ДатаОперации) Экспорт

	Если ПустаяСтрока(СокрЛП(Строка(ИдентификаторОперации))) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПлатежноеПоручениеИсходящее.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПлатежноеПоручениеИсходящее КАК ПлатежноеПоручениеИсходящее
	|ГДЕ
	|	НЕ ПлатежноеПоручениеИсходящее.ПометкаУдаления
	|	И ПлатежноеПоручениеИсходящее.Проведен
	|	И ПлатежноеПоручениеИсходящее.НомерВходящегоДокумента
	|		= &ИдентификаторОперации
	|	И ПлатежноеПоручениеИсходящее.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПлатежноеПоручениеИсходящее.Дата УБЫВ";

	УстановитьПараметрыПоискаПлатежа(
		Запрос,
		ИдентификаторОперации,
		ДатаОперации);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция НайтиКассовыйОрдерПоБанковскойОперации(
	ИдентификаторОперации,
	ДатаОперации) Экспорт

	Если ПустаяСтрока(СокрЛП(Строка(ИдентификаторОперации))) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПриходныйКассовыйОрдер.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	НЕ ПриходныйКассовыйОрдер.ПометкаУдаления
	|	И ПриходныйКассовыйОрдер.Проведен
	|	И ПриходныйКассовыйОрдер.НомерВходящегоДокумента
	|		= &ИдентификаторОперации
	|	И ПриходныйКассовыйОрдер.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриходныйКассовыйОрдер.Дата УБЫВ";

	УстановитьПараметрыПоискаПлатежа(
		Запрос,
		ИдентификаторОперации,
		ДатаОперации);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Окно поиска ±2 дня: дата документа может отличаться от даты операции
// (банк проводит операцию задним числом либо документ создан позже).
Процедура УстановитьПараметрыПоискаПлатежа(
	Запрос,
	ИдентификаторОперации,
	ДатаОперации)

	Запрос.УстановитьПараметр(
		"ИдентификаторОперации",
		СокрЛП(Строка(ИдентификаторОперации)));

	Запрос.УстановитьПараметр(
		"НачалоПериода",
		НачалоДня(ДатаОперации - 2 * 24 * 60 * 60));

	Запрос.УстановитьПараметр(
		"КонецПериода",
		КонецДня(ДатаОперации + 2 * 24 * 60 * 60));

КонецПроцедуры

// === Обёртки со старыми именами: их зовёт форма обработки ОбменПриват24 ===

Функция ПолучитьПлатежноеПоручениеПоКодуПриват24(Код, Дата) Экспорт

	Результат = НайтиВходящийБанковскийПлатеж(Код, Дата);

	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка();

КонецФункции

// Ищет уже существующее исходящее ПП по НомерВходящегоДокумента независимо
// от того, проведено оно или только записано (условие "И Проведен"
// пропускало непроведённые дубли).
Функция ПолучитьПлатежноеПоручениеИсходящееПоКодуПриват24(Код, Дата) Экспорт

	Результат = НайтиПлатежноеПоручениеИсходящееПоОперации(Код, Дата);

	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Документы.ПлатежноеПоручениеИсходящее.ПустаяСсылка();

КонецФункции

Функция ПолучитьПриходныйКассовыйОрдерПоКодуПриват24(Код, Дата) Экспорт

	Результат = НайтиКассовыйОрдерПоБанковскойОперации(Код, Дата);

	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Документы.ПриходныйКассовыйОрдер.ПустаяСсылка();

КонецФункции

#КонецОбласти

#Область Приват24Бизнес

Функция ПолучитьОперацииПриват24Бизнес(
	Настройка,
	ДатаНачала,
	ДатаКонца) Экспорт

	Операции = Новый Массив;

	Если Настройка = Неопределено Тогда
		Возврат Операции;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат Операции;

	КонецЕсли;

	Токен                = СокрЛП(Строка(Настройка.Токен));
	ИдентификаторКлиента = СокрЛП(Строка(Настройка.Айди));

	Если ПустаяСтрока(Токен) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Приват24Бизнес",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Настройка.Подразделение,
			"Не заполнен токен Приват24 Бизнес.");

		Возврат Операции;

	КонецЕсли;

	Если ПустаяСтрока(ИдентификаторКлиента) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Приват24Бизнес",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Настройка.Подразделение,
			"Не заполнен идентификатор (Айди) Приват24 Бизнес.");

		Возврат Операции;

	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	SSL = Новый ЗащищенноеСоединениеOpenSSL();

	UserAgentHeaders =
		"1C+EnterpriseV2|8.3|TcK|2434509383|3.0.3.4|UTP|1.2.11.1"
		+ "|8.3.10.2772|CS|OP|ru|Windows|Windows x86|";

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("User-Agent", UserAgentHeaders);
	Заголовки.Вставить("id", ИдентификаторКлиента);
	Заголовки.Вставить("token", Токен);
	Заголовки.Вставить("Content-Type", "application/json;charset=utf8");

	сДатаНачала = Формат(НачалоДня(ДатаНачала), "ДФ=dd-MM-yyyy");
	сДатаКонца  = Формат(НачалоДня(ДатаКонца),  "ДФ=dd-MM-yyyy");

	// Таймаут обязателен: зависший запрос к банку повесил бы регламентное
	// задание до перезапуска сервиса.
	Соединение = Новый HTTPСоединение("acp.privatbank.ua", , , , , 60, SSL);

	ОбработанныеИД        = Новый Соответствие;
	СледующаяСтраница     = "";
	ЕстьСледующаяСтраница = Истина;
	ОбработаноСтраниц     = 0;
	МаксимумСтраниц       = 1000; // страховка от зацикливания

	// Периодный эндпоинт отдаёт операции только за ЗАКРЫТЫЕ операционные дни.
	// Операции текущего дня доступны только через interim — запрашиваем его
	// второй фазой, если период захватывает сегодня. Дубли между фазами
	// отсекаются по ОбработанныеИД, дубли документов — по "D"+REF.
	ОчередьРесурсов = Новый Массив;
	ОчередьРесурсов.Добавить(
		"/api/statements/transactions?startDate=" + сДатаНачала
		+ "&endDate=" + сДатаКонца
		+ "&limit=200");

	Если КонецДня(ДатаКонца) >= НачалоДня(ТекущаяДата()) Тогда
		// у interim максимум limit=100 (ограничение Автоклиента)
		ОчередьРесурсов.Добавить(
			"/api/statements/transactions/interim?limit=100");
	КонецЕсли;

	ИндексРесурса = 0;

	Пока ЕстьСледующаяСтраница И ОбработаноСтраниц < МаксимумСтраниц Цикл

		ОбработаноСтраниц = ОбработаноСтраниц + 1;

		РесурсНаСервере = ОчередьРесурсов[ИндексРесурса];

		Если Не ПустаяСтрока(СледующаяСтраница) Тогда
			РесурсНаСервере = РесурсНаСервере
				+ "&followId=" + СледующаяСтраница;
		КонецЕсли;

		Запрос = Новый HTTPЗапрос(РесурсНаСервере, Заголовки);

		Попытка
			Ответ = Соединение.Получить(Запрос);
		Исключение
			ЗаписьЖурналаРегистрации(
				"БанковскиеВыписки.Приват24Бизнес",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Настройка.Подразделение,
				"Ошибка подключения к Приват24 Бизнес: " + ОписаниеОшибки());
			Прервать;
		КонецПопытки;

		КодСостояния = Ответ.КодСостояния;
		СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку();

		ОтладкаВыписокСообщить(
			"Приват24: запрос " + РесурсНаСервере
			+ ", код ответа " + Строка(КодСостояния));
		ОтладкаВыписокСообщить(
			"Приват24: тело ответа: " + Лев(СокрЛП(СтрокаОтвета), 1500));

		Если КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации(
				"БанковскиеВыписки.Приват24Бизнес",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Настройка.Подразделение,
				"Приват24 Бизнес вернул код HTTP " + Строка(КодСостояния)
				+ ". Ответ: " + Лев(СтрокаОтвета, 1000));
			Прервать;
		КонецЕсли;

		Если ПустаяСтрока(СокрЛП(СтрокаОтвета)) Тогда
			Прервать;
		КонецЕсли;

		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
			Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
			ЧтениеJSON.Закрыть();
		Исключение
			ЗаписьЖурналаРегистрации(
				"БанковскиеВыписки.Приват24Бизнес",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Настройка.Подразделение,
				"Не удалось разобрать JSON Приват24 Бизнес: "
				+ ОписаниеОшибки());
			Прервать;
		КонецПопытки;

		Статус = "";
		Попытка
			Данные.Свойство("status", Статус);
		Исключение
		КонецПопытки;

		Если ВРег(СокрЛП(Строка(Статус))) <> "SUCCESS" Тогда
			ЗаписьЖурналаРегистрации(
				"БанковскиеВыписки.Приват24Бизнес",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Настройка.Подразделение,
				"Приват24 Бизнес вернул статус """ + Строка(Статус)
				+ """. Ответ: " + Лев(СтрокаОтвета, 1000));
			Прервать;
		КонецЕсли;

		Транзакции = Неопределено;
		Данные.Свойство("transactions", Транзакции);

		Если ТипЗнч(Транзакции) = Тип("Массив") Тогда

			Для Каждого Оплата Из Транзакции Цикл

				Операция = ПреобразоватьОперациюПриват24Бизнес(
					Оплата,
					Настройка);

				Если Операция = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				// Защита от дублей между страницами — по полному ID
				// (уникальному), т.к. Идентификатор строится из REF
				// и может повторяться (REFN).
				КлючДубля = Операция.КлючДубляСтраниц;
				Если ПустаяСтрока(КлючДубля) Тогда
					КлючДубля = Операция.Идентификатор;
				КонецЕсли;

				Если ОбработанныеИД.Получить(КлючДубля) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;

				ОбработанныеИД.Вставить(КлючДубля, Истина);
				Операции.Добавить(Операция);

			КонецЦикла;

		КонецЕсли;

		// Постраничная выборка, если API её поддерживает.
		ЕстьСледующаяСтраница = Ложь;
		ПризнакСледующей      = Ложь;

		Попытка
			Данные.Свойство("exist_next_page", ПризнакСледующей);
		Исключение
		КонецПопытки;

		Если ПризнакСледующей = Истина Тогда

			НовыйИдСтраницы = "";
			Попытка
				Данные.Свойство("next_page_id", НовыйИдСтраницы);
			Исключение
			КонецПопытки;

			НовыйИдСтраницы = СокрЛП(Строка(НовыйИдСтраницы));

			Если Не ПустаяСтрока(НовыйИдСтраницы)
				И НовыйИдСтраницы <> СледующаяСтраница Тогда

				СледующаяСтраница     = НовыйИдСтраницы;
				ЕстьСледующаяСтраница = Истина;

			КонецЕсли;

		КонецЕсли;

		// Страницы текущего эндпоинта кончились — переходим к следующему
		// (interim за текущий день).
		Если Не ЕстьСледующаяСтраница
			И ИндексРесурса < ОчередьРесурсов.Количество() - 1 Тогда

			ИндексРесурса         = ИндексРесурса + 1;
			СледующаяСтраница     = "";
			ЕстьСледующаяСтраница = Истина;

		КонецЕсли;

	КонецЦикла;

	ОтладкаВыписокСообщить(
		"Приват24: итого операций получено: " + Строка(Операции.Количество()));

	Возврат Операции;

КонецФункции

Функция ПреобразоватьОперациюПриват24Бизнес(Оплата, Настройка)

	Если ТипЗнч(Оплата) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Полный ID Приват24 (REF+REFN+дата+время+тип) — уникальный, нужен только
	// для защиты от дублей между страницами ответа.
	ПолныйИД = "";
	Оплата.Свойство("ID", ПолныйИД);
	ПолныйИД = СокрЛП(Строка(ПолныйИД));

	// REF — по нему формируется НомерВходящегоДокумента ("D" + REF).
	// Ключ операции строим именно из REF: полный ID ломает дедупликацию.
	Реф = "";
	Оплата.Свойство("REF", Реф);
	Реф = СокрЛП(Строка(Реф));

	// Подстраховка: если REF пуст — берём полный ID, чтобы не потерять операцию.
	Если ПустаяСтрока(Реф) Тогда
		Реф = ПолныйИД;
	КонецЕсли;

	Если ПустаяСтрока(Реф) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДатаСтрокой = "";
	Оплата.Свойство("DATE_TIME_DAT_OD_TIM_P", ДатаСтрокой);
	ДатаОперации = ДатаИзСтрокиПриват24(ДатаСтрокой);

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	СуммаСтрокой = "";
	Оплата.Свойство("SUM", СуммаСтрокой);
	СуммаОперации = ЧислоИзСтрокиПриват24(СуммаСтрокой);

	ТипТранзакции = "";
	Оплата.Свойство("TRANTYPE", ТипТранзакции);
	ТипТранзакции = ВРег(СокрЛП(Строка(ТипТранзакции)));
	ЭтоВходящий = (ТипТранзакции = "C");

	Терминал = "";
	Оплата.Свойство("AUT_CNTR_MFO_NAME", Терминал);

	Назначение = "";
	Оплата.Свойство("OSND", Назначение);

	Операция = СоздатьБанковскуюОперацию();

	Операция.Источник         = "Приват24Бизнес";
	Операция.Идентификатор    = "D" + Реф;
	Операция.КлючДубляСтраниц = "D" + ?(ПустаяСтрока(ПолныйИД), Реф, ПолныйИД);
	Операция.БанковскийСчет   = Настройка.БанковскийСчет;
	Операция.Подразделение    = Настройка.Подразделение;
	Операция.Дата             = ДатаОперации;
	Операция.Сумма            = СуммаОперации;
	Операция.Валюта           = ПолучитьВалютуГривна();
	Операция.Входящий         = ЭтоВходящий;
	Операция.Остаток          = 0;
	Операция.Терминал         = СокрЛП(Строка(Терминал));
	Операция.Назначение       = СокрЛП(Строка(Назначение));

	Возврат Операция;

КонецФункции

Функция ДатаИзСтрокиПриват24(Знач Текст)

	Текст = СокрЛП(Строка(Текст));

	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастиДатаВремя = РазложитьСтрокуПоРазделителю(Текст, " ");

	Если ЧастиДатаВремя.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастьДаты    = ЧастиДатаВремя[0];
	ЧастьВремени = ?(ЧастиДатаВремя.Количество() > 1,
		ЧастиДатаВремя[1], "00:00:00");

	КомпонентыДаты = РазложитьСтрокуПоРазделителю(ЧастьДаты, ".");

	Если КомпонентыДаты.Количество() < 3 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КомпонентыВремени = РазложитьСтрокуПоРазделителю(ЧастьВремени, ":");

	Попытка
		Год     = Число(КомпонентыДаты[2]);
		Месяц   = Число(КомпонентыДаты[1]);
		День    = Число(КомпонентыДаты[0]);
		Час     = ?(КомпонентыВремени.Количество() > 0,
			Число(КомпонентыВремени[0]), 0);
		Минута  = ?(КомпонентыВремени.Количество() > 1,
			Число(КомпонентыВремени[1]), 0);
		Секунда = ?(КомпонентыВремени.Количество() > 2,
			Число(КомпонентыВремени[2]), 0);
		Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ЧислоИзСтрокиПриват24(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, ",", ".");

	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Monobank

Функция ПолучитьОперацииMonobank(Настройка, ДатаНачала, ДатаКонца) Экспорт

	Операции = Новый Массив;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат Операции;

	КонецЕсли;

	// Monobank отдаёт не более 31 дня за запрос — режем период на отрезки.
	ТекущаяДатаНачала = НачалоДня(ДатаНачала);

	Пока ТекущаяДатаНачала <= ДатаКонца Цикл

		ТекущаяДатаКонца = ТекущаяДатаНачала + 29 * 24 * 60 * 60;

		Если ТекущаяДатаКонца > ДатаКонца Тогда
			ТекущаяДатаКонца = ДатаКонца;
		Иначе
			ТекущаяДатаКонца = КонецДня(ТекущаяДатаКонца);
		КонецЕсли;

		ОперацииЗаПериод = ПолучитьОперацииMonobankЗаПериод(
			Настройка,
			ТекущаяДатаНачала,
			ТекущаяДатаКонца);

		Для Каждого Операция Из ОперацииЗаПериод Цикл
			Операции.Добавить(Операция);
		КонецЦикла;

		ТекущаяДатаНачала = НачалоДня(ТекущаяДатаКонца + 1);

	КонецЦикла;

	Возврат Операции;

КонецФункции

Функция ПолучитьОперацииMonobankЗаПериод(
	Настройка,
	ДатаНачала,
	ДатаКонца) Экспорт

	Операции = Новый Массив;

	Если Настройка = Неопределено Тогда
		Возврат Операции;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат Операции;

	КонецЕсли;

	Токен              = СокрЛП(Строка(Настройка.Токен));
	ИдентификаторСчета = СокрЛП(Строка(Настройка.Айди));

	Если ПустаяСтрока(Токен) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Настройка.Подразделение,
			"Не заполнен токен Monobank.");

		Возврат Операции;

	КонецЕсли;

	Если ПустаяСтрока(ИдентификаторСчета) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Настройка.Подразделение,
			"Не заполнен идентификатор счета Monobank.");

		Возврат Операции;

	КонецЕсли;

	UnixДатаНачала = ДатаВUnixTimeMonobank(НачалоДня(ДатаНачала));
	UnixДатаКонца  = ДатаВUnixTimeMonobank(КонецДня(ДатаКонца));

	ПутьЗапроса =
		"/personal/statement/"
		+ ИдентификаторСчета
		+ "/"
		+ Формат(UnixДатаНачала, "ЧГ=0")
		+ "/"
		+ Формат(UnixДатаКонца, "ЧГ=0");

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Token", Токен);
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("User-Agent", "1C-BankStatements");

	Соединение = Новый HTTPСоединение(
		"api.monobank.ua",
		443,
		,
		,
		,
		60,
		Новый ЗащищенноеСоединениеOpenSSL);

	HTTPЗапрос = Новый HTTPЗапрос(ПутьЗапроса, Заголовки);

	Попытка

		HTTPОтвет = Соединение.Получить(HTTPЗапрос);

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Настройка.Подразделение,
			"Ошибка подключения к Monobank: " + ОписаниеОшибки());

		Возврат Операции;

	КонецПопытки;

	КодСостояния = HTTPОтвет.КодСостояния;

	Попытка
		ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Исключение
		ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
	КонецПопытки;

	ОтладкаВыписокСообщить(
		"Monobank: код ответа " + Строка(КодСостояния)
		+ ", тело: " + Лев(СокрЛП(ТекстОтвета), 1500));

	Если КодСостояния <> 200 Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Настройка.Подразделение,
			ПолучитьТекстОшибкиMonobank(КодСостояния, ТекстОтвета));

		Возврат Операции;

	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
		Возврат Операции;
	КонецЕсли;

	Попытка

		ДанныеОтвета = ПрочитатьОтветJSONMonobank(ТекстОтвета);

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Настройка.Подразделение,
			"Не удалось разобрать JSON Monobank: " + ОписаниеОшибки());

		Возврат Операции;

	КонецПопытки;

	Если ДанныеОтвета = Неопределено Тогда
		Возврат Операции;
	КонецЕсли;

	Для Каждого ДанныеОперации Из ДанныеОтвета Цикл

		ИдентификаторОперации = ПолучитьЗначениеJSONMonobank(
			ДанныеОперации, "id", "");

		ИдентификаторОперации = СокрЛП(Строка(ИдентификаторОперации));

		Если ПустаяСтрока(ИдентификаторОперации) Тогда
			Продолжить;
		КонецЕсли;

		ДатаUnix = ПолучитьЗначениеJSONMonobank(ДанныеОперации, "time", 0);

		Если ДатаUnix = 0 Тогда
			Продолжить;
		КонецЕсли;

		СуммаВКопейках = ПолучитьЗначениеJSONMonobank(
			ДанныеОперации, "amount", 0);

		СуммаОперации = СуммаВКопейках;

		Если СуммаОперации < 0 Тогда
			СуммаОперации = -СуммаОперации;
		КонецЕсли;

		СуммаОперации = Окр(СуммаОперации / 100, 2);

		Если СуммаОперации = 0 Тогда
			Продолжить;
		КонецЕсли;

		ОстатокВКопейках = ПолучитьЗначениеJSONMonobank(
			ДанныеОперации, "balance", 0);

		Остаток = Окр(ОстатокВКопейках / 100, 2);

		КодВалюты = ПолучитьЗначениеJSONMonobank(
			ДанныеОперации, "currencyCode", 980);

		ОписаниеОперации = ПолучитьЗначениеJSONMonobank(
			ДанныеОперации, "description", "");

		КомментарийОперации = ПолучитьЗначениеJSONMonobank(
			ДанныеОперации, "comment", "");

		MCC = ПолучитьЗначениеJSONMonobank(ДанныеОперации, "mcc", 0);

		Назначение = СокрЛП(Строка(ОписаниеОперации));

		Если Не ПустаяСтрока(СокрЛП(Строка(КомментарийОперации))) Тогда

			Если Не ПустаяСтрока(Назначение) Тогда
				Назначение = Назначение + ". ";
			КонецЕсли;

			Назначение = Назначение + СокрЛП(Строка(КомментарийОперации));

		КонецЕсли;

		БанковскаяОперация = СоздатьБанковскуюОперацию();

		БанковскаяОперация.Источник       = "Monobank";
		БанковскаяОперация.Идентификатор  = ИдентификаторОперации;
		БанковскаяОперация.БанковскийСчет = Настройка.БанковскийСчет;
		БанковскаяОперация.Подразделение  = Настройка.Подразделение;
		БанковскаяОперация.Дата           = UnixTimeВДатуMonobank(ДатаUnix);
		БанковскаяОперация.Сумма          = СуммаОперации;
		БанковскаяОперация.Валюта         = ПолучитьВалютуПоКодуMonobank(КодВалюты);
		БанковскаяОперация.Входящий       = СуммаВКопейках > 0;
		БанковскаяОперация.Остаток        = Остаток;
		БанковскаяОперация.Терминал       = ?(MCC = 0, "", "MCC " + Строка(MCC));
		БанковскаяОперация.Назначение     = Назначение;

		Операции.Добавить(БанковскаяОперация);

	КонецЦикла;

	Возврат Операции;

КонецФункции

// Смещение часового пояса: база работает по украинскому времени, API — по UTC.
Функция ДатаВUnixTimeMonobank(ДатаЗначение) Экспорт

	Если Не ЗначениеЗаполнено(ДатаЗначение) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Цел(
		ДатаЗначение
		- Дата(1970, 1, 1, 0, 0, 0)
		- СмещениеЧасовогоПоясаВыписок());

КонецФункции

Функция UnixTimeВДатуMonobank(UnixTime) Экспорт

	Если UnixTime = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		UnixTime = Число(UnixTime);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если UnixTime <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Дата(1970, 1, 1, 0, 0, 0)
		+ UnixTime
		+ СмещениеЧасовогоПоясаВыписок();

КонецФункции

Функция ПолучитьЗначениеJSONMonobank(
	ОбъектJSON,
	ИмяСвойства,
	ЗначениеПоУмолчанию) Экспорт

	Если ОбъектJSON = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	ЗначениеСвойства = ЗначениеПоУмолчанию;

	Если ТипЗнч(ОбъектJSON) = Тип("Структура") Тогда

		Если ОбъектJSON.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
			Возврат ЗначениеСвойства;
		КонецЕсли;

	ИначеЕсли ТипЗнч(ОбъектJSON) = Тип("Соответствие") Тогда

		Если ОбъектJSON.СодержитКлюч(ИмяСвойства) Тогда
			Возврат ОбъектJSON.Получить(ИмяСвойства);
		КонецЕсли;

	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ПолучитьТекстОшибкиMonobank(КодСостояния, ТекстОтвета) Экспорт

	Если КодСостояния = 401 Тогда

		Возврат "Monobank вернул ошибку 401. "
			+ "Токен отсутствует или недействителен.";

	ИначеЕсли КодСостояния = 403 Тогда

		Возврат "Monobank вернул ошибку 403. Доступ к API запрещен.";

	ИначеЕсли КодСостояния = 429 Тогда

		Возврат "Monobank вернул ошибку 429. "
			+ "Превышена частота запросов. Повторите загрузку позже.";

	КонецЕсли;

	ТекстОшибки = "Ошибка Monobank. Код HTTP: " + Строка(КодСостояния);

	Если Не ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
		ТекстОшибки = ТекстОшибки + ". Ответ: " + Лев(ТекстОтвета, 1000);
	КонецЕсли;

	Возврат ТекстОшибки;

КонецФункции

Функция ПолучитьВалютуПоКодуMonobank(КодВалюты) Экспорт

	КодВалюты = СокрЛП(Строка(КодВалюты));

	СимвольныйКод = "";

	Если КодВалюты = "980" Тогда
		СимвольныйКод = "UAH";
	ИначеЕсли КодВалюты = "840" Тогда
		СимвольныйКод = "USD";
	ИначеЕсли КодВалюты = "978" Тогда
		СимвольныйКод = "EUR";
	ИначеЕсли КодВалюты = "985" Тогда
		СимвольныйКод = "PLN";
	КонецЕсли;

	Если Не ПустаяСтрока(СимвольныйКод) Тогда

		Валюта = Справочники.Валюты.НайтиПоКоду(СимвольныйКод);

		Если ЗначениеЗаполнено(Валюта) Тогда
			Возврат Валюта;
		КонецЕсли;

		Валюта = Справочники.Валюты.НайтиПоНаименованию(СимвольныйКод);

		Если ЗначениеЗаполнено(Валюта) Тогда
			Возврат Валюта;
		КонецЕсли;

	КонецЕсли;

	Если КодВалюты = "980" Тогда
		Возврат ПолучитьВалютуГривна();
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПрочитатьОтветJSONMonobank(ТекстОтвета) Экспорт

	Если ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;

	Попытка

		ЧтениеJSON.УстановитьСтроку(ТекстОтвета);

		Результат = ПрочитатьJSON(ЧтениеJSON);

		ЧтениеJSON.Закрыть();

	Исключение

		Попытка
			ЧтениеJSON.Закрыть();
		Исключение
		КонецПопытки;

		ВызватьИсключение
			"Ошибка разбора JSON Monobank: " + ОписаниеОшибки();

	КонецПопытки;

	Если Результат = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область WayForPay

// Выписка эквайринга: список транзакций мерчанта за период.
// Реквизиты продавца берутся из настройки подключения подразделения — той же,
// которой заказ покупателя создаёт инвойсы. Отдельных токенов не требуется.
Функция ПолучитьОперацииWayForPay(Настройка, ДатаНачала, ДатаКонца) Экспорт

	Операции = Новый Массив;

	Если Настройка = Неопределено Тогда
		Возврат Операции;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат Операции;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(Настройка.НастройкаWayForPay) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.WayForPay",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Настройка.Подразделение,
			"Не заполнена настройка подключения WayForPay.");

		Возврат Операции;

	КонецЕсли;

	Ответ = Wayforpay_ОбщийМодуль_СД.ПолучитьСписокТранзакций(
		Настройка.НастройкаWayForPay,
		ДатаНачала,
		ДатаКонца);

	Если Не Ответ.Успешно Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.WayForPay",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Настройка.Подразделение,
			Ответ.Сообщение);

		Сообщить("WayForPay: " + Ответ.Сообщение);

		Возврат Операции;

	КонецЕсли;

	ОтладкаВыписокСообщить(
		"WayForPay: транзакций получено: " + Строка(Ответ.Транзакции.Количество()));

	Для Каждого Транзакция Из Ответ.Транзакции Цикл

		Операция = ПреобразоватьОперациюWayForPay(Транзакция, Настройка);

		Если Операция = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Операции.Добавить(Операция);

	КонецЦикла;

	Возврат Операции;

КонецФункции

// В очередь импорта попадают только успешные (Approved) платежи: прочие
// статусы — Declined, InProcessing, Refunded — платежа в базе не порождают.
Функция ПреобразоватьОперациюWayForPay(Транзакция, Настройка)

	OrderReference = СокрЛП(Строка(
		ЗначениеТранзакцииWayForPay(Транзакция, "orderReference", "")));

	Если ПустаяСтрока(OrderReference) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Статус = СокрЛП(Строка(
		ЗначениеТранзакцииWayForPay(Транзакция, "transactionStatus", "")));

	Если Статус <> "Approved" Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДатаUnix = ЗначениеТранзакцииWayForPay(Транзакция, "processingDate", 0);

	Если Не ЗначениеЗаполнено(ДатаUnix) Тогда
		ДатаUnix = ЗначениеТранзакцииWayForPay(Транзакция, "createdDate", 0);
	КонецЕсли;

	ДатаОперации = UnixTimeВДатуMonobank(ДатаUnix);

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// amount может прийти и числом, и строкой — приводим явно, иначе
	// сравнения суммы дальше по конвейеру падают на несовпадении типов.
	Сумма = ЧислоИзСтрокиПриват24(
		ЗначениеТранзакцииWayForPay(Транзакция, "amount", 0));

	Если Сумма = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Email = СокрЛП(Строка(ЗначениеТранзакцииWayForPay(Транзакция, "email", "")));
	Phone = СокрЛП(Строка(ЗначениеТранзакцииWayForPay(Транзакция, "phone", "")));

	Назначение = "WayForPay, заказ " + OrderReference;

	Если Не ПустаяСтрока(Email) Тогда
		Назначение = Назначение + ", " + Email;
	КонецЕсли;

	Если Не ПустаяСтрока(Phone) Тогда
		Назначение = Назначение + ", " + Phone;
	КонецЕсли;

	Операция = СоздатьБанковскуюОперацию();

	Операция.Источник         = "WayForPay";
	Операция.Идентификатор    = OrderReference;
	Операция.КлючДубляСтраниц = OrderReference;
	Операция.AuthCode         = СокрЛП(Строка(
		ЗначениеТранзакцииWayForPay(Транзакция, "authCode", "")));
	Операция.Заказ            = НайтиЗаказПоOrderReference(OrderReference, датаОперации);
	Операция.БанковскийСчет   = Настройка.БанковскийСчет;
	Операция.Подразделение    = Настройка.Подразделение;
	Операция.Дата             = ДатаОперации;
	Операция.ДатаКомпенсации  = ДатаКомпенсацииWayForPay(Транзакция);
	Операция.Сумма            = Сумма;
	Операция.Валюта           = ПолучитьВалютуГривна();
	Операция.Входящий         = Истина;
	Операция.Остаток          = 0;
	Операция.Терминал         = "WayForPay";
	Операция.Назначение       = Назначение;

	Возврат Операция;

КонецФункции

// Дата зачисления средств продавцу (settlementDate). В зависимости от
// версии API приходит либо unix-временем (число или строка цифр), либо
// строкой "дд.мм.гггг". Если формат не распознан — возвращаем пустую дату:
// поле информационное, валить загрузку из-за него нельзя.
Функция ДатаКомпенсацииWayForPay(Транзакция)

	ПустаяДата = '00010101';

	Значение = ЗначениеТранзакцииWayForPay(Транзакция, "settlementDate", 0);

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат ПустаяДата;
	КонецЕсли;

	Попытка

		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат UnixTimeВДатуMonobank(Значение);
		КонецЕсли;

		Текст = СокрЛП(Строка(Значение));

		Если ПустаяСтрока(Текст) Тогда
			Возврат ПустаяДата;
		КонецЕсли;

		// "дд.мм.гггг" (возможно с временем после пробела).
		Если СтрДлина(Текст) >= 10 И Сред(Текст, 3, 1) = "." И Сред(Текст, 6, 1) = "." Тогда
			Возврат Дата(Сред(Текст, 7, 4) + Сред(Текст, 4, 2) + Лев(Текст, 2));
		КонецЕсли;

		// Строка цифр — unix-время.
		Возврат UnixTimeВДатуMonobank(ЧислоИзСтрокиПриват24(Текст));

	Исключение

		Возврат ПустаяДата;

	КонецПопытки;

КонецФункции

// WayForPay возвращает транзакции соответствиями; на всякий случай
// поддерживаем и структуру.
Функция ЗначениеТранзакцииWayForPay(Транзакция, ИмяСвойства, ЗначениеПоУмолчанию)

	Если ТипЗнч(Транзакция) = Тип("Соответствие") Тогда

		Если Транзакция.СодержитКлюч(ИмяСвойства) Тогда
			Возврат Транзакция.Получить(ИмяСвойства);
		КонецЕсли;

	ИначеЕсли ТипЗнч(Транзакция) = Тип("Структура") Тогда

		Значение = ЗначениеПоУмолчанию;

		Если Транзакция.Свойство(ИмяСвойства, Значение) Тогда
			Возврат Значение;
		КонецЕсли;

	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// orderReference заказа собирается как «<номер заказа>_<номер инвойса>»
// (см. форму заказа покупателя), поэтому номер — всё до последнего «_».
Функция НайтиЗаказПоOrderReference(OrderReference, ДатаОперации)

	ПустойЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();

	Текст = СокрЛП(Строка(OrderReference));

	Если ПустаяСтрока(Текст) Тогда
		Возврат ПустойЗаказ;
	КонецЕсли;

	// Сначала — связь, записанная в регистр при создании инвойса: она
	// точная и переживает смену номера заказа. Разбор номера ниже остается
	// для старых инвойсов, выставленных до появления регистра.
	ЗаказИзРегистра = ЗаказПоРегиструИнвойсов(Текст);

	Если ЗначениеЗаполнено(ЗаказИзРегистра) Тогда
		Возврат ЗаказИзРегистра;
	КонецЕсли;

	// Позиция последнего «_».
	Позиция = 0;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если Сред(Текст, Индекс, 1) = "_" Тогда
			Позиция = Индекс;
		КонецЕсли;
	КонецЦикла;

	НомерЗаказа = ?(Позиция > 0, Лев(Текст, Позиция - 1), Текст);

	Если ПустаяСтрока(НомерЗаказа) Тогда
		Возврат ПустойЗаказ;
	КонецЕсли;

	Запрос = Новый Запрос;
		Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.Номер = &Номер
	|	И НЕ ЗаказПокупателя.ПометкаУдаления
	|	И ЗаказПокупателя.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.Дата УБЫВ";

	// Номера заказов повторяются каждый год, поэтому заказ ищем только
	// в окне: не позже даты оплаты и не старше её на 90 дней.
	ДатаНачалаОкна = НачалоДня(ДатаОперации - 90 * 86400);
	ДатаКонцаОкна  = КонецДня(ДатаОперации);

	Запрос.УстановитьПараметр("Номер", НомерЗаказа);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаОкна);
	Запрос.УстановитьПараметр("ДатаКонца",  ДатаКонцаОкна);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	ОтладкаВыписокСообщить(
		"    заказ с номером «" + НомерЗаказа + "» не найден в окне "
		+ Формат(ДатаНачалаОкна, "ДФ=dd.MM.yyyy") + " - "
		+ Формат(ДатаКонцаОкна, "ДФ=dd.MM.yyyy") + ".");

	Возврат ПустойЗаказ;

КонецФункции

// Заказ по регистру «Заказы инвойсов WayForPay»: пара записывается модулем
// Wayforpay_ОбщийМодуль_СД при создании инвойса из заказа.
Функция ЗаказПоРегиструИнвойсов(OrderReference)

	ПустойЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказыИнвойсов.Заказ КАК Заказ
	|ИЗ
	|	РегистрСведений.ЗаказыИнвойсовWayForPay КАК ЗаказыИнвойсов
	|ГДЕ
	|	ЗаказыИнвойсов.OrderReference = &OrderReference
	|	И НЕ ЗаказыИнвойсов.Заказ.ПометкаУдаления";

	Запрос.УстановитьПараметр(
		"OrderReference",
		Лев(СокрЛП(Строка(OrderReference)), 100));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Заказ;
	КонецЕсли;

	Возврат ПустойЗаказ;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разложение строки по односимвольному разделителю.
// Платформенная СтрРазделить недоступна: режим совместимости конфигурации —
// "Версия 8.2.13" (см. Configuration.xml, CompatibilityMode).
Функция РазложитьСтрокуПоРазделителю(Знач Текст, Знач Разделитель)

	Результат = Новый Массив;

	Текст = Строка(Текст);

	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Пока Истина Цикл

		Позиция = Найти(Текст, Разделитель);

		Если Позиция = 0 Тогда

			Если Не ПустаяСтрока(Текст) Тогда
				Результат.Добавить(СокрЛП(Текст));
			КонецЕсли;

			Прервать;

		КонецЕсли;

		Часть = Лев(Текст, Позиция - 1);

		Если Не ПустаяСтрока(Часть) Тогда
			Результат.Добавить(СокрЛП(Часть));
		КонецЕсли;

		Текст = Сред(Текст, Позиция + СтрДлина(Разделитель));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Смещение локального времени относительно UTC (украинское летнее время).
Функция СмещениеЧасовогоПоясаВыписок()

	Возврат 3 * 60 * 60;

КонецФункции

Функция ПолучитьВалютуГривна()

	Валюта = Справочники.Валюты.НайтиПоКоду("980");

	Если ЗначениеЗаполнено(Валюта) Тогда
		Возврат Валюта;
	КонецЕсли;

	Возврат Константы.ВалютаУправленческогоУчета.Получить();

КонецФункции

// Отладка загрузки банковских выписок.
// Истина — подробные сообщения выводятся на экран при нажатии кнопки
// «Получить из Приват24». Регламентное задание работает в фоне, его сообщения
// не видны — ошибки API пишутся в журнал регистрации.
// Поставьте Ложь, когда загрузка подтверждена рабочей.
Функция ВключенаОтладкаБанковскихВыписок()

	Возврат Истина;

КонецФункции

Процедура ОтладкаВыписокСообщить(Текст)

	Если ВключенаОтладкаБанковскихВыписок() Тогда
		Сообщить("[Выписки] " + Строка(Текст));
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
