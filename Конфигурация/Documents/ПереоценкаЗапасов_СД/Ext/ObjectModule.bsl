	//ТабСвернуто = РезОст.Скопировать();
	//ТабСвернуто.Свернуть("Номенклатура,ЦенаПартииНовая");
	//для Каждого СтрСв из ТабСвернуто Цикл 
	//	 НовСтрТ = Товары.Добавить();
	//	 ЗаполнитьЗначенияСвойств(НовСтрТ, СтрСв);
	//КонецЦикла;	
	для Каждого СтрРез из РезОст Цикл 
		 НовСтр = ОстаткиПартии.Добавить();
		 ЗаполнитьЗначенияСвойств(НовСтр, СтрРез);
	 КонецЦикла;	
	 
КонецПроцедуры	

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Если Не Отказ Тогда
		// ТОВАРЫ ПО РЕГИСТРУ ПартииТоваровНаСкладах.
		
		НаборДвижений = Движения.ПартииТоваровНаСкладах;
		// Заполним таблицу движений.
		НаборДвижений.Записывать = Истина;
		// Получим таблицу значений, совпадающую со структурой набора записей регистра.
		ТаблицаДвижений = НаборДвижений.ВыгрузитьКолонки();
		ОбщегоНазначения.ЗагрузитьВТаблицуЗначений(ОстаткиПартии, ТаблицаДвижений);
		ТаблицаДвижений.ЗаполнитьЗначения(ВидДвиженияНакопления.Расход, "ВидДвижения");
		
		ОстаткиПартии_Новые = ОстаткиПартии.Выгрузить();
		ОстаткиПартии_Новые.Колонки.Удалить("Стоимость");
		ОстаткиПартии_Новые.Колонки.СтоимостьНовая.Имя = "Стоимость";
		
		//Проводки с новой Стоимостью
		ТаблицаДвижений_приход = НаборДвижений.ВыгрузитьКолонки();
		ОбщегоНазначения.ЗагрузитьВТаблицуЗначений(ОстаткиПартии_Новые, ТаблицаДвижений_приход);
		ТаблицаДвижений_приход.ЗаполнитьЗначения(ВидДвиженияНакопления.Приход, "ВидДвижения");
		
		ОбщегоНазначения.ЗагрузитьВТаблицуЗначений(ТаблицаДвижений_приход, ТаблицаДвижений);
		ТаблицаДвижений.ЗаполнитьЗначения(Дата, "Период");
		ТаблицаДвижений.ЗаполнитьЗначения(Истина, "Активность");
		//НаборДвижений.мПериод          = Дата;
		НаборДвижений.мТаблицаДвижений = ТаблицаДвижений;
		Если Не Отказ Тогда
			Движения.ПартииТоваровНаСкладах.ВыполнитьДвижения();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры



















мВалютаРегламентированногоУчета = глЗначениеПеременной("ВалютаРегламентированногоУчета");
