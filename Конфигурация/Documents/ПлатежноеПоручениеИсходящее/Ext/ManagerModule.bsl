////////////////////////////////////////////////////////////////////////////////
// Создание платежного поручения исходящего по операции банковской выписки.
//
// Списание заказом не подтверждается, поэтому организация берется у владельца
// банковского счета, на котором прошла операция, а подразделение — из настройки
// подразделения, по которой загружена выписка.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Заготовка структуры "факт списания" для СоздатьСписаниеПоВыписке.
//
// Возвращаемое значение:
//   Структура:
//     * Сумма                   - Число;
//     * ДатаПлатежа             - Дата;
//     * НомерВходящегоДокумента - Строка - идентификатор операции банка,
//                                 ключ дедупликации;
//     * СчетОрганизации         - СправочникСсылка.БанковскиеСчета;
//     * Подразделение           - СправочникСсылка.Подразделения;
//     * Организация             - СправочникСсылка.Организации - если не задана,
//                                 берется владелец счета организации;
//     * Контрагент              - СправочникСсылка.Контрагенты;
//     * ДоговорКонтрагента      - СправочникСсылка.ДоговорыКонтрагентов;
//     * НазначениеПлатежа       - Строка;
//     * Комментарий             - Строка;
//     * Проводить               - Булево.
//
Функция ОписаниеСписанияПоВыписке() Экспорт

	Результат = Новый Структура;

	Результат.Вставить("Сумма", 0);
	Результат.Вставить("ДатаПлатежа", Неопределено);
	Результат.Вставить("НомерВходящегоДокумента", "");
	Результат.Вставить("СчетОрганизации", Неопределено);
	Результат.Вставить("Подразделение", Неопределено);
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("Контрагент", Неопределено);
	Результат.Вставить("ДоговорКонтрагента", Неопределено);
	Результат.Вставить("НазначениеПлатежа", "");
	Результат.Вставить("Комментарий", "");
	Результат.Вставить("Проводить", Истина);

	Возврат Результат;

КонецФункции

// Создает платежное поручение исходящее по операции списания из выписки.
//
// Возвращаемое значение:
//   Структура - Успешно, Сообщение, Ссылка, УжеСуществует.
//
Функция СоздатьСписаниеПоВыписке(ФактСписания) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Ссылка", Документы.ПлатежноеПоручениеИсходящее.ПустаяСсылка());
	Результат.Вставить("УжеСуществует", Ложь);

	Если ФактСписания = Неопределено Тогда
		Результат.Сообщение = "Не передан факт списания.";
		Возврат Результат;
	КонецЕсли;

	Списание = ОписаниеСписанияПоВыписке();
	ЗаполнитьЗначенияСвойств(Списание, ФактСписания);

	Если Не ЗначениеЗаполнено(Списание.Сумма) Тогда
		Результат.Сообщение = "Не указана сумма списания.";
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Списание.ДатаПлатежа) Тогда
		Списание.ДатаПлатежа = ТекущаяДата();
	КонецЕсли;

	СуществующийДокумент = БанковскиеВыписки.НайтиПлатежноеПоручениеИсходящееПоОперации(
		Списание.НомерВходящегоДокумента,
		Списание.ДатаПлатежа);

	Если ЗначениеЗаполнено(СуществующийДокумент) Тогда

		Результат.Успешно       = Истина;
		Результат.УжеСуществует = Истина;
		Результат.Ссылка        = СуществующийДокумент;
		Результат.Сообщение     = "Платежное поручение уже создано.";

		Возврат Результат;

	КонецЕсли;

	Организация = Списание.Организация;

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = ОрганизацияСчета(Списание.СчетОрганизации);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.Сообщение =
			"Не удалось определить организацию: у банковского счета «"
			+ Строка(Списание.СчетОрганизации)
			+ "» владелец не организация.";
		Возврат Результат;
	КонецЕсли;

	Попытка

		Документ = Документы.ПлатежноеПоручениеИсходящее.СоздатьДокумент();

		Документ.ВидОперации = ВидОперацииСписания(Списание);

		Документ.Дата                    = Списание.ДатаПлатежа;
		Документ.ДатаОплаты              = Списание.ДатаПлатежа;
		Документ.Оплачено                = Истина;
		Документ.Организация             = Организация;
		Документ.СчетОрганизации         = Списание.СчетОрганизации;
		Документ.Подразделение           = Списание.Подразделение;
		Документ.Контрагент              = Списание.Контрагент;
		Документ.ДоговорКонтрагента      = Списание.ДоговорКонтрагента;
		Документ.СуммаДокумента          = Списание.Сумма;
		Документ.ВалютаДокумента         = ВалютаСчета(Списание.СчетОрганизации);

		Если Не ПустаяСтрока(СокрЛП(Строка(Списание.НомерВходящегоДокумента))) Тогда
			Документ.НомерВходящегоДокумента =
				СокрЛП(Строка(Списание.НомерВходящегоДокумента));
		КонецЕсли;

		Если Не ПустаяСтрока(СокрЛП(Строка(Списание.НазначениеПлатежа))) Тогда
			Документ.НазначениеПлатежа = Списание.НазначениеПлатежа;
		КонецЕсли;

		Если Не ПустаяСтрока(СокрЛП(Строка(Списание.Комментарий))) Тогда
			Документ.Комментарий = Списание.Комментарий;
		КонецЕсли;

		Попытка
			Документ.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Исключение
		КонецПопытки;

		Документ.РасшифровкаПлатежа.Очистить();
		СтрокаРасшифровки = Документ.РасшифровкаПлатежа.Добавить();

		СтрокаРасшифровки.ДоговорКонтрагента       = Списание.ДоговорКонтрагента;
		СтрокаРасшифровки.СуммаПлатежа             = Списание.Сумма;
		СтрокаРасшифровки.СуммаВзаиморасчетов      = Списание.Сумма;
		СтрокаРасшифровки.КурсВзаиморасчетов       = 1;
		СтрокаРасшифровки.КратностьВзаиморасчетов  = 1;

		СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств =
			Справочники.СтатьиДвиженияДенежныхСредств.ПрочиеРасходыДенежныхСредств;

		Если Списание.Проводить Тогда
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Документ.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		Результат.Успешно   = Истина;
		Результат.Ссылка    = Документ.Ссылка;
		Результат.Сообщение = "Платежное поручение создано.";

	Исключение

		Результат.Успешно   = Ложь;
		Результат.Сообщение =
			"Ошибка создания платежного поручения: " + ОписаниеОшибки();

	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВидОперацииСписания(Списание)

	Если ЗначениеЗаполнено(Списание.ДоговорКонтрагента)
		И ЗначениеЗаполнено(Списание.Контрагент) Тогда

		Если Списание.Контрагент.Поставщик Тогда
			Возврат Перечисления.ВидыОперацийППИсходящее.ОплатаПоставщику;
		КонецЕсли;

		Если Списание.Контрагент.Покупатель Тогда
			Возврат Перечисления.ВидыОперацийППИсходящее.ВозвратДенежныхСредствПокупателю;
		КонецЕсли;

	КонецЕсли;

	Возврат Перечисления.ВидыОперацийППИсходящее.ПрочееСписаниеБезналичныхДенежныхСредств;

КонецФункции

Функция ОрганизацияСчета(БанковскийСчет)

	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат Справочники.Организации.ПустаяСсылка();
	КонецЕсли;

	Владелец = БанковскийСчет.Владелец;

	Если ТипЗнч(Владелец) = Тип("СправочникСсылка.Организации") Тогда
		Возврат Владелец;
	КонецЕсли;

	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

Функция ВалютаСчета(БанковскийСчет)

	Если ЗначениеЗаполнено(БанковскийСчет)
		И ЗначениеЗаполнено(БанковскийСчет.ВалютаДенежныхСредств) Тогда

		Возврат БанковскийСчет.ВалютаДенежныхСредств;

	КонецЕсли;

	Возврат Константы.ВалютаУправленческогоУчета.Получить();

КонецФункции

#КонецОбласти
