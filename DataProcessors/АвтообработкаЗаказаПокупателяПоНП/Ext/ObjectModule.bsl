	КонецЦикла;
КонецПроцедуры

Процедура АвтообработкаЗаказовПоТТН(ЗаказПокупателя, ТТН) Экспорт
	    УстановитьПривилегированныйРежим(Истина);
		
		СкладНП = Справочники.Склады.НайтиПоКоду("000000012");

		СтруктураСтатусЕН = ПолучитьСтатусПоЕН(ТТН);		
		Если СтруктураСтатусЕН = Неопределено тогда
			Возврат;
		КонецЕсли;
		
		СтатусКод = СтруктураСтатусЕН.СтатусКодЕН; 
		Сообщить("Статус ТТН: " + Строка(СтруктураСтатусЕН.СтатусЕН));
		
		КомментарийМаршрута = "Маршрут:";
		ПоступлениеТоваровУслуг = Неопределено;
		
		
		Етап = ОпределитьЕтапСтатуса(СтатусКод);   
		
		Если Етап = 1 тогда
			Етап1(ЗаказПокупателя, КомментарийМаршрута, ПоступлениеТоваровУслуг);	
		ИначеЕсли Етап = 2 тогда
			Етап1(ЗаказПокупателя, КомментарийМаршрута, ПоступлениеТоваровУслуг); 
			СтворитиПаузу(2);
			Етап2(ЗаказПокупателя, КомментарийМаршрута, ПоступлениеТоваровУслуг);	
		ИначеЕсли Етап = 3 тогда
			Етап1(ЗаказПокупателя, КомментарийМаршрута, ПоступлениеТоваровУслуг);
			СтворитиПаузу(2);
			Етап2(ЗаказПокупателя, КомментарийМаршрута, ПоступлениеТоваровУслуг);
			СтворитиПаузу(2);
			Етап3(ЗаказПокупателя, КомментарийМаршрута, ПоступлениеТоваровУслуг);
		КонецЕсли;   
		
		Сообщить(КомментарийМаршрута);
		
КонецПроцедуры