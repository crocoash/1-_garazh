
Процедура ЗаполнитьПравила(Критический = Истина) Экспорт 
	Если Отладка тогда
		Сообщить("Заповнення правил призначення бейджиків.");
	КонецЕсли;

	ПравилаРасчета.Очистить();
	
	Запрос_Правила = новый Запрос;
	Запрос_Правила.Текст = "ВЫБРАТЬ
	                       |	БП_ПравилаНазначенияБейджиков.Ссылка КАК ПравилоНазначенияБейджиков,
	                       |	БП_ПравилаНазначенияБейджиков.Приоритет КАК Приоритет,
	                       |	БП_ПравилаНазначенияБейджиков.ВидНоменклатуры,
	                       |	БП_ПравилаНазначенияБейджиков.ТипЦеныРассчитанной КАК ТипЦеныРасчета
	                       |ИЗ
	                       |	Справочник.БП_ПравилаНазначенияБейджиков КАК БП_ПравилаНазначенияБейджиков
	                       |ГДЕ
	                       |	НЕ БП_ПравилаНазначенияБейджиков.ПометкаУдаления
	                       |	И НЕ БП_ПравилаНазначенияБейджиков.НеИспользуется
	                       |	И НЕ БП_ПравилаНазначенияБейджиков.ЭтоГруппа
	                       |	И БП_ПравилаНазначенияБейджиков.Бейджик.Критический = &Критический
	                       |
	                       |УПОРЯДОЧИТЬ ПО
	                       |	Приоритет";   
	
	Запрос_Правила.УстановитьПараметр("Критический",Критический);
	
	Рез_Правила = Запрос_Правила.Выполнить().Выгрузить();
	
	
	ПравилаРасчета.Загрузить(Рез_Правила);
	
КонецПроцедуры	

Процедура  ВыполнитьВсе(ТЗНоменклатура = Неопределено, Критический = Истина) Экспорт 
	
	ДатаДокументов = ТекущаяДата();
	ПроводитьДокументУР = Истина;
	
	ЗаполнитьПравила(Критический); 
	
	Если НЕ ПравилаРасчета.Количество() тогда
		Возврат;
	КонецЕсли;
	
	Если Отладка тогда
		Сообщить("Заповнення номенклатури на основі правил розрахунку цін.");
	КонецЕсли;     
	
	Если ТЗНоменклатура = Неопределено тогда 
		НоменклатураПоПравилу.Загрузить(Обработки.СозданиеУЦ_По_ПравиламРасчета_СД.ПередатьНоменклатуруКРасчетуРейтинга());
	Иначе
		НоменклатураПоПравилу.Загрузить(ТЗНоменклатура);		
	КонецЕсли;
	НазначенияБейджиков();
	СоздатьДокументы();  
	
КонецПроцедуры

Процедура НазначенияБейджиков() Экспорт
	
	Бейджики.Очистить();
	
	Для каждого СтрПравило из ПравилаРасчета цикл
		ПравилоРасчетаБейджика = СтрПравило.ПравилоНазначенияБейджиков;
		Отбор = Новый Структура("ВидНоменклатуры, ТипЦеныРассчитанной", СтрПравило.ВидНоменклатуры, СтрПравило.ТипЦеныРасчета);
		СтрокиНоменклатуры = НоменклатураПоПравилу.НайтиСтроки(Отбор);	
		ИтогоСтрок = СтрокиНоменклатуры.Количество();
			
		Если ПравилоРасчетаБейджика.ПродажыИспользовать тогда
				ТЗПродаж = СформироватьОтчетПродажи(ПравилоРасчетаБейджика.ПродажыНачалоПериода, ПравилоРасчетаБейджика.ПродажыКонецПериода, СтрПравило.ВидНоменклатуры);
		КонецЕсли; 
		//---------------

		//Если ПравилоРасчетаБейджика.ВПИспользовать тогда
		//	ТЗВП = СформироватьОтчетВаловаяПрибыль(ПравилоРасчетаБейджика.ВПНачалоПериода, ПравилоРасчетаБейджика.ВПКонецПериода, СтрПравило.ВидНоменклатуры);
		//КонецЕсли;  
		
		Для каждого СтрНоменклатура из СтрокиНоменклатуры цикл 
			
			Если ПравилоРасчетаБейджика.ВНаличии = СтрНоменклатура.ПравилоРасчета.ВНаличии ИЛИ ПравилоРасчетаБейджика.ВНаличии = Перечисления.ДаНет_сд.ПустаяСсылка() ИЛИ СтрНоменклатура.ПравилоРасчета.ВНаличии = Перечисления.ДаНет_сд.ПустаяСсылка() тогда
				ПроверкаПройдена = Истина;
			Иначе  
				ПроверкаПройдена = Ложь;
			КонецЕсли;    
			
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;    
			
			
						
			Если ПравилоРасчетаБейджика.ПродажыИспользовать  тогда  
				ПроверкаПройдена = Ложь;
				НайденнаяСтрока = ТЗПродаж.Найти(СтрНоменклатура.Номенклатура, "Номенклатура");
				Если НайденнаяСтрока = Неопределено Тогда
					ПроверкаПройдена = Ложь;	
				Иначе
					Если НЕ (НайденнаяСтрока.КоличествоОборот >= ПравилоРасчетаБейджика.ПродажыКоличествоПроданыхС И НайденнаяСтрока.КоличествоОборот <= ПравилоРасчетаБейджика.ПродажыКоличествоПроданыхПо) тогда
						ПроверкаПройдена = Ложь;	
					Иначе  
						НомерСтроки = ТЗПродаж.Индекс(НайденнаяСтрока);
						Если (НомерСтроки >= ПравилоРасчетаБейджика.ПродажыНомерСтрокиС И НомерСтроки <= ПравилоРасчетаБейджика.ПродажыНомерСтрокиПо) тогда
							ПроверкаПройдена = Истина;
						Иначе
							ПроверкаПройдена = Ложь;	
						КонецЕсли;						
					КонецЕсли;
				КонецЕсли;   
				
				Если НЕ ПроверкаПройдена тогда
					Продолжить;
				КонецЕсли; 
			КонецЕсли;			

			
			Если ПравилоРасчетаБейджика.ВПИспользовать тогда  
				ПроверкаПройдена = Ложь;
				//НайденнаяСтрока = ТЗВП.Найти(СтрНоменклатура.Номенклатура, "Номенклатура");
				//Если НайденнаяСтрока = Неопределено Тогда
				//	ПроверкаПройдена = Ложь;	
				//Иначе
				//	Если (НайденнаяСтрока.ВаловаяПрибыль >= ПравилоРасчетаБейджика.ВПБольшеСумма ИЛИ НайденнаяСтрока.Рентабельность >= ПравилоРасчетаБейджика.ВПБольшеПрцент) тогда
				//		ПроверкаПройдена = Истина;	
				//	Иначе  
				//		ПроверкаПройдена = Ложь;						
				//	КонецЕсли;
				//КонецЕсли; 
				//   
				
				Если СтрНоменклатура.ПрибыльПроцент >= ПравилоРасчетаБейджика.ВПБольшеПрцент И СтрНоменклатура.Прибыль >= ПравилоРасчетаБейджика.ВПБольшеСумма тогда
					ПроверкаПройдена = Истина;
				Иначе  
					ПроверкаПройдена = Ложь;
				КонецЕсли; 
				
				Если НЕ ПроверкаПройдена тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;  
			
			Если ПравилоРасчетаБейджика.СтараяЦенаИспользовать тогда  
				
				Если ПравилоРасчетаБейджика.СтараяЦенаЕсть тогда
					ПроверкаПройдена = ?(СтрНоменклатура.СтараяЦена > 0, Истина, Ложь);
				Иначе  
					ПроверкаПройдена = ?(СтрНоменклатура.СтараяЦена = 0, Истина, Ложь);
				КонецЕсли;  
				
				Если НЕ ПроверкаПройдена тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
		

			Если ПравилоРасчетаБейджика.БУ = Перечисления.ДаНет_сд.Да  тогда
				ПроверкаПройдена = ?(СтрНоменклатура.Номенклатура.БУ, Истина, Ложь);
			ИначеЕсли ПравилоРасчетаБейджика.БУ = Перечисления.ДаНет_сд.Нет тогда 
				ПроверкаПройдена = ?(СтрНоменклатура.Номенклатура.БУ, Ложь, Истина);   
			иначе
				ПроверкаПройдена = Истина;	
			КонецЕсли;
			
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			
			ПроверкаПройдена = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.Диаметры, СтрНоменклатура.Номенклатура.ДиаметрДиска);
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			ПроверкаПройдена = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.Сезоны, СтрНоменклатура.Номенклатура.Сезонность);
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			ПроверкаПройдена = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.ПоставщикиТекст, СтрНоменклатура.Поставщик); 
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			ПроверкаПройдена = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.Ширина, СтрНоменклатура.Номенклатура.Ширина);  
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			ПроверкаПройдена = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.ВысотаПрофиля, СтрНоменклатура.Номенклатура.ВысотаПрофиля);
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			ПроверкаПройдена = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.Номенклатура, СтрНоменклатура.Номенклатура);    
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			ПроверкаПройдена = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.ТипыНоменклатуры, СтрНоменклатура.Номенклатура.Тип); 
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			ПроверкаПройдена = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.Производители, СтрНоменклатура.Номенклатура.Производитель);  
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			ПроверкаПройдена = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.Модели, СтрНоменклатура.Номенклатура.Модель);
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			ПроверкаПройдена = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.Города, СтрНоменклатура.МІСТО);  
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			ПроверкаПройдена = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.ПоставщикиТекст, СтрНоменклатура.Поставщик);  
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			ПроверкаПройдена = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.Модели, СтрНоменклатура.Номенклатура.Модель);
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли;
			
			ПроверкаДоговораКонтрагента = Ложь;
			Для каждого СтрДоговор из СтрНоменклатура.ПравилоРасчета.ДоговораКонтрагента цикл
				ПроверкаДоговораКонтрагента = ПолучитьРейтингПоЗначению(ПравилоРасчетаБейджика.ДоговораКонтрагента,СтрДоговор.ДоговорКонтрагента);
				Если ПроверкаДоговораКонтрагента тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;	
			ПроверкаПройдена = ?(НЕ СтрНоменклатура.ПравилоРасчета.ДоговораКонтрагента.Количество(), Истина, ПроверкаДоговораКонтрагента);
			Если НЕ ПроверкаПройдена тогда
				Продолжить;
			КонецЕсли; 
			

			

			
			//Рейтинг = РейтингВНаличии + РейтингСезоны + РейтингНоменклатура + РейтингТипыНоменклатуры + РейтингПроизводители + РейтингМодель + РейтингГорода + РейтингПоставщики + РейтингБУ + РейтингДоговораКонтрагента + РейтингПрибыль + РейтингКоличество;
			
			//Если Отладка тогда
			//	Сообщить("[" + Строка(СтрНоменклатура.НомерСтроки) + "/" + Строка(ИтогоСтрок) + "]. "
			//				+ "Для номенклатури [" + Строка(СтрНоменклатура.Номенклатура) + "] встановлено рейтинг [" + Рейтинг + "]" + ", що складається з наступних показників:  "
			//				+ "наявність товару [" + Строка(РейтингВНаличии) + "], " 
			//				+ "сезоність [" + Строка(РейтингСезоны) + "], "
			//				+ "номенклатура [" + Строка(РейтингНоменклатура) + "], "
			//				+ "тип номенклатури [" + Строка(РейтингТипыНоменклатуры) + "], "
			//				+ "виробник [" + Строка(РейтингПроизводители) + "], "
			//				+ "модель [" + Строка(РейтингМодель) + "], "
			//				+ "місто [" + Строка(РейтингГорода) + "], "
			//				+ "постачальник [" + Строка(РейтингПоставщики) + "], "
			//				+ "б/у [" + Строка(РейтингБУ) + "], "
			//				+ "договора контрагентов [" + Строка(РейтингДоговораКонтрагента) + "]"
			//	            + ?(ПравилоРасчетаРейтинга.НачислятьРейтингЗаПрибыль, ", прибуток [" + Строка(РейтингПрибыль) + "]","")
			//	            + ?(ПравилоРасчетаРейтинга.НачислятьРейтингЗаКоличество, ", кількість [" + Строка(РейтингКоличество) + "]","")
			//				);
			//КонецЕсли;
			
			//СтрНоменклатура.Рейтинг = Рейтинг; 
			СтрНоменклатура.ПравилоРасчетаБейджика = ПравилоРасчетаБейджика;
			//СтрНоменклатура.РейтингРасчитан = Истина;   
			
			
			НовСтрока = Бейджики.Добавить();
			НовСтрока.Бейджик = ПравилоРасчетаБейджика.Бейджик;
			НовСтрока.Номенклатура = СтрНоменклатура.Номенклатура;
			НовСтрока.ПравилоРасчетаБейджика = ПравилоРасчетаБейджика; 
			НовСтрока.ВидНоменклатуры = СтрПравило.ВидНоменклатуры;
			НовСтрока.ТипЦеныРассчитанной = СтрПравило.ТипЦеныРасчета;
			НовСтрока.Приоритет = ПравилоРасчетаБейджика.Приоритет;
			НовСтрока.УЦ = Истина;
		КонецЦикла;
		
	КонецЦикла; 
	
	БейджикиСвернута.Очистить();
	Для каждого Стр из Бейджики цикл            
		НайденнаяСтрока = БейджикиСвернута.Найти(Стр.Номенклатура, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			НовСтрока = БейджикиСвернута.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,Стр);
			НовСтрока.БейджикиТекст = Строка(Стр.Бейджик);
		Иначе
			НайденнаяСтрока.БейджикиТекст = ?(ЗначениеЗаполнено(НайденнаяСтрока.БейджикиТекст), НайденнаяСтрока.БейджикиТекст + ", " + Строка(Стр.Бейджик),Строка(Стр.Бейджик));
		КонецЕсли; 	
	КонецЦикла;

КонецПроцедуры   

Функция ПолучитьРейтингПоЗначению(ТЗ,Значение) Экспорт
	
	Если НЕ ТЗ.Количество() тогда
		Возврат Истина;
	КонецЕсли;
	
	НайденнаяСтрока = ТЗ.Найти(Значение, "Значение");
	Если НайденнаяСтрока = Неопределено Тогда
		Возврат Ложь;	
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции  

Процедура СоздатьДокументы() Экспорт    
	Если Отладка тогда
		Сообщить("Створення документів Призначення бейджиків номенклатурі.");
	КонецЕсли;
	ДатаДокументаУР = ДатаДокументов;
	
	Бейджики.Сортировать("Бейджик УБЫВ");
	
	ТЗПравилаРасчета = ПравилаРасчета.Выгрузить(,"ВидНоменклатуры,ТипЦеныРасчета");
	ТЗПравилаРасчета.Свернуть("ВидНоменклатуры,ТипЦеныРасчета",);  
	
	Для Каждого Стр_Правило из  ТЗПравилаРасчета Цикл
		//ПравилоНазначенияБейджиков = Стр_Правило.ПравилоНазначенияБейджиков;
		
		СтруктПрав = новый Структура;
		СтруктПрав.Вставить("ТипЦеныРассчитанной", Стр_Правило.ТипЦеныРасчета);
		СтруктПрав.Вставить("ВидНоменклатуры", Стр_Правило.ВидНоменклатуры);
		
		Строки_ПоПравилу = Бейджики.НайтиСтроки(СтруктПрав);
		
		Если Строки_ПоПравилу.Количество() = 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		НовДокументУР = Документы.БП_НазначенияБейджиковНоменклатуры.СоздатьДокумент();
		НовДокументУР.Дата = ДатаДокументаУР;
		НовДокументУР.УстановитьНовыйНомер();
		НовДокументУР.ВидНоменклатуры = Стр_Правило.ВидНоменклатуры;
        НовДокументУР.ТипЦеныРасчета = Стр_Правило.ТипЦеныРасчета;   
		
		Товары = НовДокументУР.Товары;
		Для каждого СтрНом из Строки_ПоПравилу цикл 
			Если НЕ СтрНом.УЦ тогда
				Продолжить;
			КонецЕсли;
			НовСтрока = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,СтрНом);
		КонецЦикла;                                    
		
		Если ПроводитьДокументУР тогда
			НовДокументУР.Записать(РежимЗаписиДокумента.Проведение);
		Иначе  
			НовДокументУР.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
		Сообщить("Успішно створено документ: " + Строка(НовДокументУР.Ссылка));
	КонецЦикла;
		
КонецПроцедуры   

Функция СформироватьОтчетПродажи(ПродажыНачалоПериода, ПродажыКонецПериода, ВидНоменклатуры)
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПродажиОбороты.Номенклатура,
	|	СУММА(ПродажиОбороты.КоличествоОборот) КАК КоличествоОборот
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&НачПериода, &КонПериода, , Номенклатура.ВидНоменклатуры = &ВидНоменклатуры) КАК ПродажиОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	КоличествоОборот УБЫВ"; 
		
	Запрос.УстановитьПараметр("НачПериода",ПродажыНачалоПериода);
	Запрос.УстановитьПараметр("КонПериода",ПродажыКонецПериода);
	Запрос.УстановитьПараметр("ВидНоменклатуры",ВидНоменклатуры);
	
	ТЗИтог = Запрос.Выполнить().Выгрузить();
	
	Возврат ТЗИтог;
	
	
	Отчет = Отчеты.Продажи.Создать();      
	
	//Отчет.УниверсальныйОтчет.мВыбиратьИмяРегистра = Ложь;
	
	Отчет.УниверсальныйОтчет.ИмяРегистра = "Продажи";
	Отчет.УниверсальныйОтчет.УстановитьНачальныеНастройки(Истина,Неопределено);
	//Отчет.УниверсальныйОтчет.ДобавитьИзмерениеСтроки("Контрагент");
	Отчет.УниверсальныйОтчет.ДобавитьИзмерениеСтроки("Номенклатура");

	// Період
	Отчет.УниверсальныйОтчет.ДатаНач = ПродажыНачалоПериода;
	Отчет.УниверсальныйОтчет.ДатаКон  = ПродажыКонецПериода;
	Отчет.УниверсальныйОтчет.ВыводитьОбщиеИтоги = Ложь;
	Отчет.УниверсальныйОтчет.ВыводитьДетальныеЗаписи = Ложь;  
	Отчет.УниверсальныйОтчет.ПостроительОтчета.ВыводитьДетальныеЗаписи = Ложь;
	Отчет.УниверсальныйОтчет.ПостроительОтчета.ВыводитьОбщиеИтоги = Ложь;	
	//Отчет.УниверсальныйОтчет.ДобавитьОтбор("Номенклатура.ВидНоменклатуры.ТипНоменклатуры", Истина, ВидСравнения.НеРавно, Перечисления.ТипыНоменклатуры.Услуга);
	Отчет.УниверсальныйОтчет.ДобавитьОтбор("Номенклатура.ВидНоменклатуры", Истина, ВидСравнения.Равно, ВидНоменклатуры);
	ТЗИтог = Отчет.УниверсальныйОтчет.ПолучитьРезультат().Выгрузить();  
	
	ТЗИтог.Свернуть("Номенклатура,НоменклатураПредставление,КоличествоОборот"); 
	ТЗИтог.Сортировать("КоличествоОборот Убыв");
	
	Возврат ТЗИтог;
КонецФункции 

