Процедура ЗаполнитьПоШаблону() Экспорт 
	
	ПоПочте = Истина;
	
	Если НЕ ЗначениеЗаполнено(ГруппаДоговоров) или не ЗначениеЗаполнено(Поставщик)Тогда
		#Если Клиент Тогда
			Предупреждение("Укажите Поставщика и Группа договоров!");
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Поставщик) и ЗначениеЗаполнено(ГруппаДоговоров) Тогда 
		отбСр = новый Структура("Поставщик", Поставщик);
		отбСр.Вставить("ГруппаДоговоров", ГруппаДоговоров);
		ШаблонСрез = РегистрыСведений.ШаблоныЗагрузкиОстатковПоставщиков_СД.СрезПоследних(ТекущаяДата(), отбСр);
		Если не ШаблонСрез.Количество() = 0 Тогда 
			
			ЭтотОбъект.УчетнаяЗаписьЭлектроннойПочты = ШаблонСрез[0].УчетнаяЗаписьЭлектроннойПочты;
			ЭтотОбъект.ПочтаМенеджера 				 = ШаблонСрез[0].ПочтаМенеджера;
			ЭтотОбъект.НомерПервойСтроки 			 = ШаблонСрез[0].НомерПервойСтроки;
			ЭтотОбъект.НомерСтраницыЗагрузки 		 = ШаблонСрез[0].НомерСтраницыЗагрузки;
			ЭтотОбъект.НомерКолонкиНоменклатура 	 = ШаблонСрез[0].НомерКолонкиНоменклатура;
			ЭтотОбъект.НомерКолонкиКоличество 		 = ШаблонСрез[0].НомерКолонкиКоличество;
			ЭтотОбъект.НомерКолонкиЦенаСоСкидкой	 = ШаблонСрез[0].НомерКолонкиЦенаСоСкидкой;
			ЭтотОбъект.НомерКолонкиЦенаОпт      	 = ШаблонСрез[0].НомерКолонкиЦенаОпт;
			ЭтотОбъект.НомерКолонкиЦенаРекомендована = ШаблонСрез[0].НомерКолонкиЦенаРекомендована;
			ЭтотОбъект.ВидНоменклатуры				 = ШаблонСрез[0].ВидНоменклатуры;
			ЭтотОбъект.ПочтаПоставщика 				 = ШаблонСрез[0].ПочтаПоставщика;
			
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры	
