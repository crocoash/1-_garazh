// Оплата заказа с сенсорного экрана.
//
// Открывается из Форма_ЗаполненияНаряда после того, как транзакция создания
// документов зафиксирована: инвойс строится из номера заказа, а номер меняется
// при смене формы расчёта, поэтому порядок такой — форма расчёта, запись, инвойс.
//
// Вся работа с данными — в общем модуле СенсорныйЕкран_Оплата_СД, здесь только
// экран.

////////////////////////////////////////////////////////////////////////////////
// Открытие

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Заказ") Тогда
		Заказ = Параметры.Заказ;
	КонецЕсли;

	// Второго заказа может не быть — наряд делится на два только когда в нём
	// есть и товары, и услуги. Тип проверяем явно: вызывающая сторона передаёт
	// Неопределено, а реквизит формы — ссылка.
	Если Параметры.Свойство("Заказ2")
		И ТипЗнч(Параметры.Заказ2) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда

		Заказ2 = Параметры.Заказ2;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ТекущийЗаказ = Заказ;

	Элементы.ГруппаЗаказы.Видимость = ЗначениеЗаполнено(Заказ2);

	ПрочитатьЗаказ();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Способ оплаты

&НаКлиенте
Процедура ВыбратьГотивку(Команда)

	// Готівка — форма расчёта из настроек оператора, она уже стоит в заказе.
	// Заказ не перезаписываем: номер менять незачем.
	Статус = "Готівка. Замовлення " + ЗаголовокЗаказа;
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьБезнал(Команда)

	Результат = ПодготовитьБезналНаСервере();

	Если Результат.ТребуетсяВыбор Тогда

		Элементы.ФормаРасчетаВыбор.Видимость = Истина;
		Элементы.КнопкаПрименитьФормуРасчета.Видимость = Истина;
		Статус = "Оберіть форму розрахунку та натисніть «Застосувати».";
		Возврат;

	КонецЕсли;

	Если Не Результат.Успешно Тогда
		Статус = Результат.Сообщение;
		Возврат;
	КонецЕсли;

	ПоказатьЭкранОплаты();

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьФормуРасчета(Команда)

	Если Не ЗначениеЗаполнено(ФормаРасчетаВыбор) Тогда
		Статус = "Форма розрахунку не обрана.";
		Возврат;
	КонецЕсли;

	Результат = УстановитьФормуРасчетаНаСервере(ФормаРасчетаВыбор);

	Если Не Результат.Успешно Тогда
		Статус = Результат.Сообщение;
		Возврат;
	КонецЕсли;

	ПоказатьЭкранОплаты();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗаглушку(Команда)

	Статус = "Цей спосіб оплати ще не підключено.";

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЭкранОплаты()

	Элементы.ГруппаСпособ.Видимость = Ложь;
	Элементы.ГруппаОплата.Видимость = Истина;

КонецПроцедуры

// Форма расчёта для безнала: если у подразделения ровно один вариант, кроме
// текущего (готівкового), ставим его сразу; если вариантов несколько — пусть
// выбирает оператор; если нет ни одного — работаем с текущей.
&НаСервере
Функция ПодготовитьБезналНаСервере()

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("ТребуетсяВыбор", Ложь);
	Результат.Вставить("Сообщение", "");

	Данные = СенсорныйЕкран_Оплата_СД.ДанныеОплаты(ТекущийЗаказ);

	Если Не Данные.ЕстьНастройкаWayforpay Тогда
		Результат.Сообщение = "У підрозділі не вказано налаштування Wayforpay.";
		Возврат Результат;
	КонецЕсли;

	Варианты = СенсорныйЕкран_Оплата_СД.ФормыРасчетаПодразделения(Данные.Подразделение);

	Другие = Новый Массив;
	Для Каждого Строка Из Варианты Цикл
		Если Строка.Ссылка <> Данные.ФормаРасчета Тогда
			Другие.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Если Другие.Количество() = 0 Тогда
		// Отдельной безналичной формы расчёта нет — оставляем текущую.
		Результат.Успешно = Истина;
		ПрочитатьЗаказ();
		Возврат Результат;
	КонецЕсли;

	Если Другие.Количество() = 1 Тогда

		Установка = СенсорныйЕкран_Оплата_СД.УстановитьФормуРасчета(ТекущийЗаказ, Другие[0].Ссылка);

		Если Не Установка.Успешно Тогда
			Результат.Сообщение = "Не вдалося змінити форму розрахунку. " + Установка.Сообщение;
			Возврат Результат;
		КонецЕсли;

		Результат.Успешно = Истина;
		ПрочитатьЗаказ();
		Возврат Результат;

	КонецЕсли;

	Элементы.ФормаРасчетаВыбор.СписокВыбора.Очистить();
	Для Каждого Строка Из Другие Цикл
		Элементы.ФормаРасчетаВыбор.СписокВыбора.Добавить(Строка.Ссылка, Строка.Наименование);
	КонецЦикла;

	Результат.ТребуетсяВыбор = Истина;
	Возврат Результат;

КонецФункции

&НаСервере
Функция УстановитьФормуРасчетаНаСервере(ФормаРасчета)

	Результат = СенсорныйЕкран_Оплата_СД.УстановитьФормуРасчета(ТекущийЗаказ, ФормаРасчета);

	Если Результат.Успешно Тогда
		ПрочитатьЗаказ();
	КонецЕсли;

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Инвойс, QR, статус, SMS

&НаКлиенте
Процедура СоздатьИнвойсПолный(Команда)

	СоздатьИнвойсНаСервере(Ложь, 0);
	ПоказатьQR(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьИнвойсПредоплата(Команда)

	Если СуммаПредоплаты <= 0 Тогда
		Статус = "Вкажіть суму передоплати.";
		Возврат;
	КонецЕсли;

	СоздатьИнвойсНаСервере(Истина, СуммаПредоплаты);
	ПоказатьQR(Неопределено);

КонецПроцедуры

&НаСервере
Процедура СоздатьИнвойсНаСервере(Предоплата, Сумма)

	Результат = СенсорныйЕкран_Оплата_СД.СоздатьИнвойс(ТекущийЗаказ, Предоплата, Сумма);

	ПоследняяОперацияПредоплата = Предоплата;
	ПрочитатьЗаказ();

	Если Результат.Успешно Тогда
		Статус = "Інвойс створено.";
	Иначе
		Статус = Результат.Сообщение;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьQR(Команда)

	Статус = ПоказатьQRНаСервере();

КонецПроцедуры

&НаСервере
Функция ПоказатьQRНаСервере()

	URL = ?(ПоследняяОперацияПредоплата, URLИнвойсаПредоплата, URLИнвойса);

	// Если нужного инвойса нет, показываем тот, который есть.
	Если ПустаяСтрока(URL) Тогда
		URL = ?(ПустаяСтрока(URLИнвойса), URLИнвойсаПредоплата, URLИнвойса);
	КонецЕсли;

	Результат = СенсорныйЕкран_Оплата_СД.АдресКартинкиQR(URL, УникальныйИдентификатор);

	Если Результат.Успешно Тогда
		АдресQR = Результат.Адрес;
		Возврат "Наведіть камеру телефона на QR-код.";
	КонецЕсли;

	АдресQR = "";
	Возврат Результат.Сообщение;

КонецФункции

&НаКлиенте
Процедура ПроверитьСтатус(Команда)

	Статус = ПроверитьСтатусНаСервере();

КонецПроцедуры

&НаСервере
Функция ПроверитьСтатусНаСервере()

	Результат = СенсорныйЕкран_Оплата_СД.ПолучитьОплату(ТекущийЗаказ, ПоследняяОперацияПредоплата);

	ПрочитатьЗаказ();

	Возврат Результат.Сообщение;

КонецФункции

&НаКлиенте
Процедура ОтправитьСМС(Команда)

	Статус = ОтправитьСМСНаСервере();

КонецПроцедуры

&НаСервере
Функция ОтправитьСМСНаСервере()

	Результат = СенсорныйЕкран_Оплата_СД.ОтправитьСМС(ТекущийЗаказ, Телефон, ТекстСМС);

	ПрочитатьЗаказ();

	Возврат Результат.Сообщение;

КонецФункции

&НаКлиенте
Процедура УдалитьИнвойс(Команда)

	Ответ = Вопрос("Видалити інвойс?", РежимДиалогаВопрос.ДаНет);

	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;

	Статус = УдалитьИнвойсНаСервере();

КонецПроцедуры

&НаСервере
Функция УдалитьИнвойсНаСервере()

	Результат = СенсорныйЕкран_Оплата_СД.УдалитьИнвойс(ТекущийЗаказ, ПоследняяОперацияПредоплата);

	АдресQR = "";
	ПрочитатьЗаказ();

	Возврат Результат.Сообщение;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Переключение между заказами и закрытие

&НаКлиенте
Процедура ПерейтиКЗаказу1(Команда)

	ПерейтиКЗаказуНаСервере(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКЗаказу2(Команда)

	Если Не ЗначениеЗаполнено(Заказ2) Тогда
		Статус = "Друге замовлення не створювалось.";
		Возврат;
	КонецЕсли;

	ПерейтиКЗаказуНаСервере(Ложь);

КонецПроцедуры

&НаСервере
Процедура ПерейтиКЗаказуНаСервере(Первый)

	ТекущийЗаказ = ?(Первый, Заказ, Заказ2);
	АдресQR = "";
	ПоследняяОперацияПредоплата = Ложь;
	ПрочитатьЗаказ();

КонецПроцедуры

&НаКлиенте
Процедура Готово(Команда)

	Закрыть();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Служебное

&НаСервере
Процедура ПрочитатьЗаказ()

	Данные = СенсорныйЕкран_Оплата_СД.ДанныеОплаты(ТекущийЗаказ);

	Если Не Данные.Успешно Тогда
		Статус = Данные.Сообщение;
		Возврат;
	КонецЕсли;

	СуммаДокумента       = Данные.СуммаДокумента;
	СуммаПредоплаты      = Данные.СуммаПредоплаты;
	URLИнвойса           = Данные.URLИнвойса;
	URLИнвойсаПредоплата = Данные.URLИнвойсаПредоплата;
	Телефон              = Данные.Телефон;
	ТекстСМС             = Данные.ТекстСМС;

	ЗаголовокЗаказа =
		"Замовлення № " + Данные.Номер
		+ Символы.ПС + Данные.Контрагент
		+ Символы.ПС + "До сплати: " + Формат(Данные.СуммаДокумента, "ЧДЦ=2; ЧРГ= ") + " грн";

	Если Не ПустаяСтрока(Данные.idСМС) Тогда
		ЗаголовокЗаказа = ЗаголовокЗаказа + Символы.ПС + "SMS: " + Данные.СтатусСМС;
	КонецЕсли;

	Элементы.КнопкаОтправитьСМС.Доступность = Данные.ЕстьНастройкаСМС;

КонецПроцедуры
