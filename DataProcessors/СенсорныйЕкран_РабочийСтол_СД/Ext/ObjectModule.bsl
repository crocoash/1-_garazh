Функция ЗапроспоДиаметрам() Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Диаметр.Ссылка КАК Диаметр
		|ИЗ
		|	Справочник.Диаметр КАК Диаметр
		|ГДЕ
		|	Диаметр.СенсорныйЕкран_ВыводитьНаШиномонтаже_СД
		|	И НЕ Диаметр.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Диаметр.Наименование";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблДиаметр = РезультатЗапроса.Выгрузить();
	
	Возврат ТаблДиаметр;
КонецФункции