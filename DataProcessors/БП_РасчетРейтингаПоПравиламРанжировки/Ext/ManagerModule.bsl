функция ВыполнитьВсе(ТЗНоменклатура = Неопределено)  Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МассивПараметров = Новый Массив;
		ФоновыеЗадания.Выполнить("БП_ОбщийМодуль.ЗапускРанжировкиВФоне", МассивПараметров,,"РанжировкаТоваров");
		Сообщить("Вібувся запуск фонового завдання по ранжуванню товарів.");
	Исключение    
		Сообщить(ОписаниеОшибки());
		Сообщить("Не вдалося запустити ранжуванню товарів. Зверніться до адміністратора!");
	КонецПопытки;
	
КонецФункции

функция ВыполнитьВсеСФона()  Экспорт
	УстановитьПривилегированныйРежим(Истина);
	обр = Обработки.БП_РасчетРейтингаПоПравиламРанжировки.Создать();
	обр.ДатаДокументов = ТекущаяДата();
	обр.ПроводитьДокументУР = Истина;
	обр.ВыполнитьВсе();	
КонецФункции

 