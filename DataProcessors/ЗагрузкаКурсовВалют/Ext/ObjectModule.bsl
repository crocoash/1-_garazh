  Функция ПолучитьТекстПоСсылке(Ссылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		
		Если Лев(Ссылка, 8) = "https://" Тогда
			
			БезПротокола = Сред(Ссылка, 9);
			ПозицияСлеша = Найти(БезПротокола, "/");
			
			Если ПозицияСлеша > 0 Тогда
				Сервер = Лев(БезПротокола, ПозицияСлеша - 1);
				Путь = Сред(БезПротокола, ПозицияСлеша);
			Иначе
				Сервер = БезПротокола;
				Путь = "/";
			КонецЕсли;
			
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
			Соединение = Новый HTTPСоединение(Сервер, 443,,,,, ЗащищенноеСоединение);
			
		ИначеЕсли Лев(Ссылка, 7) = "http://" Тогда
			
			БезПротокола = Сред(Ссылка, 8);
			ПозицияСлеша = Найти(БезПротокола, "/");
			
			Если ПозицияСлеша > 0 Тогда
				Сервер = Лев(БезПротокола, ПозицияСлеша - 1);
				Путь = Сред(БезПротокола, ПозицияСлеша);
			Иначе
				Сервер = БезПротокола;
				Путь = "/";
			КонецЕсли;
			
			Соединение = Новый HTTPСоединение(Сервер, 80);
			
		Иначе
			Возврат "";
		КонецЕсли;
		
		Запрос = Новый HTTPЗапрос(Путь);
		Ответ = Соединение.Получить(Запрос);
		
		Если Ответ = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Если Ответ.КодСостояния <> 200 Тогда
			Возврат "";
		КонецЕсли;
		
		Возврат Ответ.ПолучитьТелоКакСтроку();
		
	Исключение
		
		// если нужно — можешь включить отладку
		// Сообщить(ОписаниеОшибки());
		
		Возврат "";
		
	КонецПопытки;
	
КонецФункции


Процедура ПолучитьСписокВалют(СписокВалют, ИсточникКурсов) Экспорт  
	
	URL = ПолучитьСсылкуКурсовВалют(ИсточникКурсов);
	
	Если НЕ ЗначениеЗаполнено(URL) Тогда
		Сообщить("Не заполнена ссылка источника курсов");
		Возврат;
	КонецЕсли;
	
	ТекстОтвета = ПолучитьТекстПоСсылке(URL);
	
	Если НЕ ЗначениеЗаполнено(ТекстОтвета) Тогда
		Сообщить("Не удалось получить ответ по ссылке: " + URL);
		Возврат;
	КонецЕсли;  
	
	
	Для каждого СтрокаСпВалют Из СписокВалют Цикл
		
		ТекВалюта = СтрокаСпВалют;
		КодВалюты = ТекВалюта.Наименование;
		Курс = Неопределено;
		
		Если ИсточникКурсов = "НБУ" Тогда
			
			Курс = ПолучитьКурсНБУИзJSON(ТекстОтвета, КодВалюты);
			
		ИначеЕсли ИсточникКурсов = "ПриватБанк" Тогда
			
			// можно заменить "buy" на "sale", если тебе нужен курс продажи
			Курс = ПолучитьКурсПриватИзJSON(ТекстОтвета, КодВалюты, "buy");
			
		ИначеЕсли ИсточникКурсов = "Monobank" Тогда
			
			Курс = ПолучитьКурсMonobankИзJSON(ТекстОтвета, КодВалюты, "rateBuy");
			
			Если Курс = Неопределено Тогда
				Курс = ПолучитьКурсMonobankИзJSON(ТекстОтвета, КодВалюты, "rateCross");
			КонецЕсли;
			
		КонецЕсли;
		
		Если Курс <> Неопределено Тогда
			Сообщить(ИсточникКурсов + " " + КодВалюты + " - " + Строка(Курс));
			
			РегистрКурсыВалют = РегистрыСведений.КурсыВалют;
			ЗаписьКурсовВалют = РегистрКурсыВалют.СоздатьМенеджерЗаписи();			
			
			ДатаКурса = ТекущаяДата();
			
			ЗаписьКурсовВалют.Валюта = ТекВалюта;
			ЗаписьКурсовВалют.Период = ДатаКурса;
			ЗаписьКурсовВалют.Прочитать();
			ЗаписьКурсовВалют.Валюта    = ТекВалюта;
			ЗаписьКурсовВалют.Период    = ДатаКурса;
			ЗаписьКурсовВалют.Курс      = Курс;
			ЗаписьКурсовВалют.Кратность = 1;
			ЗаписьКурсовВалют.Записать();

		Иначе
			Сообщить(КодВалюты + " - курс не найден");
		КонецЕсли;
	
	КонецЦикла;	
	
	ДокументыУстановкиЦен = Документы.УстановкаЦенНоменклатуры.ПолучитьДокументыДляПерепроведенияПослеИзмененияКурса();
	
	Для Каждого Док из ДокументыУстановкиЦен Цикл 
       	Док.Получитьобъект().Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла; 

КонецПроцедуры


Функция ПолучитьОбъектВалютыНБУИзJSON(ТекстJSON, КодВалюты) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ТекстJSON) ИЛИ НЕ ЗначениеЗаполнено(КодВалюты) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстJSON = СтрЗаменить(ТекстJSON, Символы.ПС, "");
	ТекстJSON = СтрЗаменить(ТекстJSON, Символы.ВК, "");
	ТекстJSON = СтрЗаменить(ТекстJSON, Символы.Таб, "");
	
	КодВалютыСтрокой = ВРег(СокрЛП(Строка(КодВалюты)));
	
	ШаблонПоиска = """cc"":""" + КодВалютыСтрокой + """";
	ПозицияКода = Найти(ТекстJSON, ШаблонПоиска);
	
	Если ПозицияКода = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	НачалоОбъекта = ПозицияКода;
	Пока НачалоОбъекта > 1 Цикл
		Если Сред(ТекстJSON, НачалоОбъекта, 1) = "{" Тогда
			Прервать;
		КонецЕсли;
		НачалоОбъекта = НачалоОбъекта - 1;
	КонецЦикла;
	
	Если Сред(ТекстJSON, НачалоОбъекта, 1) <> "{" Тогда
		Возврат "";
	КонецЕсли;
	
	КонецОбъекта = ПозицияКода;
	Пока КонецОбъекта <= СтрДлина(ТекстJSON) Цикл
		Если Сред(ТекстJSON, КонецОбъекта, 1) = "}" Тогда
			Прервать;
		КонецЕсли;
		КонецОбъекта = КонецОбъекта + 1;
	КонецЦикла;
	
	Если КонецОбъекта > СтрДлина(ТекстJSON) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Сред(ТекстJSON, НачалоОбъекта, КонецОбъекта - НачалоОбъекта + 1);
	
КонецФункции

Функция ПолучитьКурсНБУИзJSON(ТекстJSON, КодВалюты) Экспорт
	
	ТекстОбъекта = ПолучитьОбъектВалютыНБУИзJSON(ТекстJSON, КодВалюты);
	
	Если НЕ ЗначениеЗаполнено(ТекстОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаКурса = ПолучитьЗначениеJSONПоля(ТекстОбъекта, "rate");
	
	Если НЕ ЗначениеЗаполнено(СтрокаКурса) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаКурса = СтрЗаменить(СтрокаКурса, ".", ",");
	
	Попытка
		Возврат Число(СтрокаКурса);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ПолучитьДанныеВалютыНБУИзJSON(ТекстJSON, КодВалюты) Экспорт
	
	ТекстОбъекта = ПолучитьОбъектВалютыНБУИзJSON(ТекстJSON, КодВалюты);
	
	Если НЕ ЗначениеЗаполнено(ТекстОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Код", ПолучитьЗначениеJSONПоля(ТекстОбъекта, "cc"));
	Результат.Вставить("Наименование", ПолучитьЗначениеJSONПоля(ТекстОбъекта, "txt"));
	Результат.Вставить("ДатаКурса", ПолучитьЗначениеJSONПоля(ТекстОбъекта, "exchangedate"));
	Результат.Вставить("R030", ПолучитьЗначениеJSONПоля(ТекстОбъекта, "r030"));
	Результат.Вставить("Special", ПолучитьЗначениеJSONПоля(ТекстОбъекта, "special"));
	
	СтрокаКурса = ПолучитьЗначениеJSONПоля(ТекстОбъекта, "rate");
	СтрокаКурса = СтрЗаменить(СтрокаКурса, ".", ",");
	
	Попытка
		Результат.Вставить("Курс", Число(СтрокаКурса));
	Исключение
		Результат.Вставить("Курс", 0);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОбъектИзJSONПоШаблону(ТекстJSON, ШаблонПоиска) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ТекстJSON) ИЛИ НЕ ЗначениеЗаполнено(ШаблонПоиска) Тогда
		Возврат "";
