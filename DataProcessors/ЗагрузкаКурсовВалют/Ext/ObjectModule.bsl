		Возврат "";
	КонецЕсли;
	
	ТекстJSON = СтрЗаменить(ТекстJSON, Символы.ПС, "");
	ТекстJSON = СтрЗаменить(ТекстJSON, Символы.ВК, "");
	ТекстJSON = СтрЗаменить(ТекстJSON, Символы.Таб, "");
	
	ШаблонПоиска = """currencyCodeA"":" + КодMonobank + "," + """currencyCodeB"":980";
	
	Возврат ПолучитьОбъектИзJSONПоШаблону(ТекстJSON, ШаблонПоиска);
	
КонецФункции

Функция ПолучитьКурсMonobankИзJSON(ТекстJSON, КодВалюты, ВидКурса = "") Экспорт
	
	ТекстОбъекта = ПолучитьОбъектВалютыMonobankИзJSON(ТекстJSON, КодВалюты);
	
	Если НЕ ЗначениеЗаполнено(ТекстОбъекта) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидКурса) Тогда
		СтрокаКурса = ПолучитьЗначениеJSONПоля(ТекстОбъекта, "rateBuy");
		Если НЕ ЗначениеЗаполнено(СтрокаКурса) Тогда
			СтрокаКурса = ПолучитьЗначениеJSONПоля(ТекстОбъекта, "rateCross");
		КонецЕсли;
	Иначе
		СтрокаКурса = ПолучитьЗначениеJSONПоля(ТекстОбъекта, ВидКурса);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаКурса) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаКурса = СтрЗаменить(СтрокаКурса, ".", ",");
	
	Попытка
		Возврат Число(СтрокаКурса);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ПолучитьКурсИзJSONПоИсточнику(Источник, ТекстJSON, КодВалюты, ВидКурса = "") Экспорт
	
	ИсточникСтрокой = ВРег(СокрЛП(Строка(Источник)));
	
	Если ИсточникСтрокой = ВРег("НБУ") Тогда
		Возврат ПолучитьКурсНБУИзJSON(ТекстJSON, КодВалюты);
	ИначеЕсли ИсточникСтрокой = ВРег("ПриватБанк") Тогда
		
		Если НЕ ЗначениеЗаполнено(ВидКурса) Тогда
			ВидКурса = "buy";
		КонецЕсли;
		
		Возврат ПолучитьКурсПриватИзJSON(ТекстJSON, КодВалюты, ВидКурса);
		
	ИначеЕсли ИсточникСтрокой = ВРег("Monobank") Тогда
		Возврат ПолучитьКурсMonobankИзJSON(ТекстJSON, КодВалюты, ВидКурса);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции


