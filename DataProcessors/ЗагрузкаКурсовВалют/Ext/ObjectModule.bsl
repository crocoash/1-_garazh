	ТекстJSON = СтрЗаменить(ТекстJSON, Символы.ПС, "");
	ТекстJSON = СтрЗаменить(ТекстJSON, Символы.ВК, "");
	ТекстJSON = СтрЗаменить(ТекстJSON, Символы.Таб, "");
	
	ПозицияКода = Найти(ТекстJSON, ШаблонПоиска);
	
	Если ПозицияКода = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	НачалоОбъекта = ПозицияКода;
	Пока НачалоОбъекта > 1 Цикл
		Если Сред(ТекстJSON, НачалоОбъекта, 1) = "{" Тогда
			Прервать;
		КонецЕсли;
		НачалоОбъекта = НачалоОбъекта - 1;
	КонецЦикла;
	
	Если Сред(ТекстJSON, НачалоОбъекта, 1) <> "{" Тогда
		Возврат "";
	КонецЕсли;
	
	КонецОбъекта = ПозицияКода;
	Пока КонецОбъекта <= СтрДлина(ТекстJSON) Цикл
		Если Сред(ТекстJSON, КонецОбъекта, 1) = "}" Тогда
			Прервать;
		КонецЕсли;
		КонецОбъекта = КонецОбъекта + 1;
	КонецЦикла;
	
	Если КонецОбъекта > СтрДлина(ТекстJSON) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Сред(ТекстJSON, НачалоОбъекта, КонецОбъекта - НачалоОбъекта + 1);
	
КонецФункции

Функция ПолучитьЗначениеJSONПоля(ТекстОбъекта, ИмяПоля) Экспорт
	
	ШаблонПоля = """" + ИмяПоля + """:";
	ПозицияПоля = Найти(ТекстОбъекта, ШаблонПоля);
	
	Если ПозицияПоля = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	НачалоЗначения = ПозицияПоля + СтрДлина(ШаблонПоля);
	
	Пока НачалоЗначения <= СтрДлина(ТекстОбъекта) Цикл
		Символ = Сред(ТекстОбъекта, НачалоЗначения, 1);
		Если Символ <> " " И Символ <> Символы.Таб И Символ <> Символы.ПС И Символ <> Символы.ВК Тогда
			Прервать;
		КонецЕсли;
		НачалоЗначения = НачалоЗначения + 1;
	КонецЦикла;
	
	Если НачалоЗначения > СтрДлина(ТекстОбъекта) Тогда
		Возврат "";
	КонецЕсли;
	
	ПервыйСимвол = Сред(ТекстОбъекта, НачалоЗначения, 1);
	
	Если ПервыйСимвол = """" Тогда
		
		НачалоСтроки = НачалоЗначения + 1;
		КонецСтроки = НачалоСтроки;
		
		Пока КонецСтроки <= СтрДлина(ТекстОбъекта) Цикл
			Если Сред(ТекстОбъекта, КонецСтроки, 1) = """" Тогда
				Прервать;
			КонецЕсли;
			КонецСтроки = КонецСтроки + 1;
		КонецЦикла;
		
		Если КонецСтроки > СтрДлина(ТекстОбъекта) Тогда
			Возврат "";
		КонецЕсли;
		
		Возврат Сред(ТекстОбъекта, НачалоСтроки, КонецСтроки - НачалоСтроки);
		
	КонецЕсли;
	
	Если НРег(Сред(ТекстОбъекта, НачалоЗначения, 4)) = "null" Тогда
		Возврат "";
	КонецЕсли;
	
	КонецЗначения = НачалоЗначения;
	Пока КонецЗначения <= СтрДлина(ТекстОбъекта) Цикл
		Символ = Сред(ТекстОбъекта, КонецЗначения, 1);
		Если Символ = "," ИЛИ Символ = "}" ИЛИ Символ = "]" Тогда
			Прервать;
		КонецЕсли;
		КонецЗначения = КонецЗначения + 1;
	КонецЦикла;
	
	ЗначениеПоля = СокрЛП(Сред(ТекстОбъекта, НачалоЗначения, КонецЗначения - НачалоЗначения));
	Возврат ЗначениеПоля;
	
КонецФункции

Функция ПолучитьОбъектВалютыПриватИзJSON(ТекстJSON, КодВалюты) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ТекстJSON) ИЛИ НЕ ЗначениеЗаполнено(КодВалюты) Тогда
