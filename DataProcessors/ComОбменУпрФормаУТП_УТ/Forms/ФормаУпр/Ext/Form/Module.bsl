	Результат = ИсЗапрос.Выполнить();
	Выборка   = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		УИД = БазаИсточник.String(Выборка.Ссылка.УникальныйИдентификатор());
		
		РезПоиска = Документы.ПлатежноеПоручениеИсходящее.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
		Если Найти(Строка(РезПоиска),"<") = 0 Тогда
			Если Не ОбновлятьСуществующиеДокументы Тогда
				Продолжить;
			КонецЕсли; 
			Документ = РезПоиска.ПолучитьОбъект();
			Документ.РасшифровкаПлатежа.Очистить();
			Документ.РеквизитыКонтрагента.Очистить();
		Иначе
			Документ = Документы.ПлатежноеПоручениеИсходящее.СоздатьДокумент();
			Документ.УстановитьСсылкуНового(РезПоиска);
		КонецЕсли;
		
		Документ.ОтражатьВБухгалтерскомУчете    = Выборка.ОтражатьВБухгалтерскомУчете;
		Документ.ОтраженоВОперУчете             = Выборка.Ссылка.ОтражатьВУправленческомУчете;
		
		Документ.Оплачено                       = Выборка.Оплачено;
		Документ.Номер                          = Выборка.Номер;
		Документ.Дата                           = Выборка.Дата;
		Документ.ДатаОплаты                     = Выборка.Дата;
		Документ.НомерПоручения        = Выборка.НомерПоручения;
		Документ.Организация                    = ПолучитьОрганизацию(Выборка.Организация, СоответствиеДанныхВКеше);
		Документ.СчетОрганизации                = ПолучитьБанковскийСчет(БазаИсточник, Документ.Организация, Выборка.СчетОрганизации);
		Документ.ВидОперации                    = ПолучитьВидОперацийВидыОперацийППИсходящее(Выборка.ВидОперацииЗначение);
		Документ.Комментарий                    = Выборка.Комментарий;
		Документ.Ответственный                  = ПолучитьПользователя(БазаИсточник, Выборка.Ответственный);
		Документ.ВалютаДокумента                = ПолучитьВалюту(Выборка.ВалютаДокумента);
		Документ.Контрагент                     = ПолучитьКонтрагента(БазаИсточник, Выборка.Контрагент);
		Документ.ДоговорКонтрагента             = ПолучитьДоговорКонтрагента(БазаИсточник, СоответствиеДанныхВКеше, Документ.Контрагент, Выборка.ДоговорКонтрагента);
		Документ.ДокументОснование              = ПолучитьДокумент(БазаИсточник, Выборка.ДокументОснование);
		Документ.СтатьяДвиженияДенежныхСредств  = ПолучитьСтатьюДДС(БазаИсточник, Выборка.СтатьяДвиженияДенежныхСредств);
		Документ.СуммаДокумента                 = Выборка.СуммаДокумента;
		Документ.НазначениеПлатежа              = Выборка.НазначениеПлатежа;
		
		Для Каждого СтрокаРасшифровки Из Выборка.РасшифровкаПлатежа.Unload() Цикл
			НоваяРасшифровкаПлатежа = Документ.РасшифровкаПлатежа.Добавить();
			НоваяРасшифровкаПлатежа.ДоговорКонтрагента              = ПолучитьДоговорКонтрагента(БазаИсточник, СоответствиеДанныхВКеше, Документ.Контрагент, СтрокаРасшифровки.ДоговорКонтрагента);
			НоваяРасшифровкаПлатежа.Сделка                          = ПолучитьДокумент(БазаИсточник, СтрокаРасшифровки.Сделка);
			НоваяРасшифровкаПлатежа.КурсВзаиморасчетов              = СтрокаРасшифровки.КурсВзаиморасчетов;
			НоваяРасшифровкаПлатежа.СуммаПлатежа                    = СтрокаРасшифровки.СуммаПлатежа;
			НоваяРасшифровкаПлатежа.КратностьВзаиморасчетов         = СтрокаРасшифровки.КратностьВзаиморасчетов;
			НоваяРасшифровкаПлатежа.СуммаВзаиморасчетов             = СтрокаРасшифровки.СуммаВзаиморасчетов;
			НоваяРасшифровкаПлатежа.СтавкаНДС                       = ПолучитьСтавкуНДС(БазаИсточник, СтрокаРасшифровки.СтавкаНДС);
			НоваяРасшифровкаПлатежа.СуммаНДС                        = СтрокаРасшифровки.СуммаНДС;
			НоваяРасшифровкаПлатежа.СтатьяДвиженияДенежныхСредств   = ПолучитьСтатьюДДС(БазаИсточник, СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств);
		КонецЦикла;
	
		Для Каждого ИсРекв Из Выборка.РеквизитыКонтрагента.Unload() Цикл
			СтрокаРекв = Документ.РеквизитыКонтрагента.Добавить();
			СтрокаРекв.Реквизит       = ИсРекв.Реквизит;
			СтрокаРекв.Значение       = ИсРекв.Значение;
			СтрокаРекв.Представление  = ИсРекв.Представление;
			СтрокаРекв.ТипКонтрагента = ИсРекв.ТипКонтрагента;
		КонецЦикла;
		
		Документ.ПометкаУдаления       = Выборка.ПометкаУдаления;
		//Документ.Проведен              = Выборка.Проведен;
		Документ.ОбменДанными.Загрузка = Истина;
		Попытка
			Документ.Записать(РежимЗаписиДокумента.Запись);
			Если Выборка.Проведен Тогда
				Документ.ОбменДанными.Загрузка = Ложь;
				Документ.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли; 
		Исключение
			//Документ.ПолучитьФорму().Открыть();
		КонецПопытки;
		_Сообщения.ДобавитьСтроку("Обработали: " + Документ);

			
	КонецЦикла;

КонецПроцедуры

