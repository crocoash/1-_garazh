Процедура КонвДокЗаказПокупателя(БазаИсточник, СоответствиеДанныхВКеше)
	
	//ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ПродажаКомиссия;
	
	СтатусСоздан = Справочники.Статусы.Создан;
	
	ИсЗапрос = БазаИсточник.NewObject("Запрос");
	ИсЗапрос.Текст = 
		"ВЫБРАТЬ
		|	Док.Ссылка,
		|	Док.ВерсияДанных,
		|	Док.ПометкаУдаления,
		|	Док.Номер,
		|	Док.Дата КАК Дата,
		|	Док.Проведен,
		|	Док.АдресДоставки,
		|	Док.СтруктурнаяЕдиница,
		|	Док.ВалютаДокумента,
		|	Док.ДоговорКонтрагента,
		|	Док.Комментарий,
		|	Док.Контрагент,
		|	Док.КратностьВзаиморасчетов,
		|	Док.КурсВзаиморасчетов,
		|	Док.Организация,
		|	Док.Ответственный,
		|	Док.СуммаВключаетНДС,
		|	Док.СуммаДокумента,
		|	Док.ТипЦен,
		|	Док.УчитыватьНДС,
		|	Док.АвторасчетНДС,
		|	Док.Представление,
		|	Док.Товары.(
		|		Ссылка,
		|		НомерСтроки,
		|		Номенклатура,
		|		ЕдиницаИзмеренияМест,
		|		Цена,
		|		Сумма,
		|		СтавкаНДС,
		|		СуммаНДС,
		|		ХарактеристикаНоменклатуры,
		|		Коэффициент,
		|		Количество,
		|		ПроцентСкидкиНаценки,
		|		КоличествоМест,
		|		ПлановаяСебестоимость,
		|		ЕдиницаИзмерения,
		|		ПроцентАвтоматическихСкидок,
		|		УсловиеАвтоматическойСкидки,
		|		ЗначениеУсловияАвтоматическойСкидки,
		|		КлючСтроки
		|	),
		|	Док.ВозвратнаяТара.(
		|		Ссылка,
		|		НомерСтроки,
		|		Номенклатура,
		|		Количество,
		|		Цена,
		|		Сумма
		|	),
		|	Док.Услуги.(
		|		Ссылка,
		|		НомерСтроки,
		|		Содержание,
		|		Количество,
		|		Цена,
		|		Сумма,
		|		СтавкаНДС,
		|		СуммаНДС,
		|		Номенклатура,
		|		ПроцентСкидкиНаценки,
		|		ПроцентАвтоматическихСкидок,
		|		УсловиеАвтоматическойСкидки,
		|		ЗначениеУсловияАвтоматическойСкидки
		|	),
		|	Док.ДатаОплаты,
		|	Док.ДатаОтгрузки,
		|	Док.СкладГруппа
		|ИЗ
		|	Документ.ЗаказПокупателя КАК Док
		|ГДЕ
		|	Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Док.Организация В(&ОрганизацииДляОбмена)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";

	
	ОрганизацииДляОбмена = БазаИсточник.NewObject("Массив");
	
	Для каждого Организация из СпОрганизаций Цикл
		ОрганизацииДляОбмена.Добавить(БазаИсточник.Справочники.Организации.НайтиПоНаименованию(Организация.Значение.Наименование, Истина));
		//_Сообщения.ДобавитьСтроку("Организация базы -  " + Организация.Значение.Наименование);
	КонецЦикла;
	
	ИсЗапрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	ИсЗапрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	ИсЗапрос.УстановитьПараметр("ОрганизацииДляОбмена", ОрганизацииДляОбмена);
	
	Результат = ИсЗапрос.Выполнить();
	Выборка   = Результат.Выбрать();
	
	
	Пока Выборка.Следующий() Цикл
		
		УИД = БазаИсточник.String(Выборка.Ссылка.УникальныйИдентификатор()); //Выборка.Ссылка.УникальныйИдентификатор();
		
		РезПоиска = Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
		Если Найти(Строка(РезПоиска),"<") <> 0 Тогда
			Документ = Документы.ЗаказПокупателя.СоздатьДокумент();
			Документ.УстановитьСсылкуНового(РезПоиска);
		Иначе
			Если Не ОбновлятьСуществующиеДокументы Тогда
				Продолжить;
			КонецЕсли; 
			Документ = РезПоиска.Получитьобъект();	
			Документ.Товары.Очистить();
			Документ.Услуги.Очистить();
			Документ.ВозвратнаяТара.Очистить();
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Документ.Статус) Тогда
		    Документ.Статус = СтатусСоздан;
		КонецЕсли; 
		
		Документ.Номер                   = Выборка.Номер;
		Документ.Дата                    = Выборка.Дата;
		//Документ.ВидОперации = ВидОперации;//в ут нет ПолучитьВидыОперацийЗаказПокупателя(БазаИсточник, Выборка.ВидОперации);
		
		
		Документ.ДатаОплаты              = Выборка.ДатаОплаты;
		Документ.ДатаОтгрузки            = Выборка.ДатаОтгрузки;
		
		Документ.Организация             = ПолучитьОрганизацию(Выборка.Организация, СоответствиеДанныхВКеше);
		Документ.Контрагент              = ПолучитьКонтрагента(БазаИсточник, Выборка.Контрагент);
		
		Документ.ДоговорКонтрагента      = ПолучитьДоговорКонтрагента(БазаИсточник, СоответствиеДанныхВКеше, Документ.Контрагент, Выборка.ДоговорКонтрагента);

		Документ.Ответственный           = ПолучитьПользователя(БазаИсточник, Выборка.Ответственный);			
		//Документ.СтруктурнаяЕдиница      = ПолучитьСтруктурнуюЕдиницу(Выборка.СтруктурнаяЕдиница);
		//Если НЕ ЗначениеЗаполнено(Документ.СтруктурнаяЕдиница) Тогда
		//	Документ.СтруктурнаяЕдиница  = Документ.Организация.ОсновнойБанковскийСчет;
		//КонецЕсли;	
		Документ.ВалютаДокумента         = ПолучитьВалюту(Выборка.ВалютаДокумента);
		Документ.КратностьВзаиморасчетов = Выборка.КратностьВзаиморасчетов;
		Документ.КурсВзаиморасчетов      = Выборка.КурсВзаиморасчетов;
		Документ.АдресДоставки           = Выборка.АдресДоставки;
		Документ.Комментарий             = Выборка.Комментарий;
		Документ.СкладГруппа             = ПолучитьСклад(Выборка.СкладГруппа);
		Документ.СуммаВключаетНДС        = Выборка.СуммаВключаетНДС;
		Документ.СуммаДокумента          = Выборка.СуммаДокумента;
		Документ.ТипЦен                  = ПолучитьТипЦен(БазаИсточник, Выборка.ТипЦен);
		Документ.УчитыватьНДС            = Выборка.УчитыватьНДС;
		Документ.АвторасчетНДС           = Выборка.АвторасчетНДС;
		
		Для Каждого ИсТовар Из Выборка.Товары.Unload() Цикл
			СтрокаТовары = Документ.Товары.Добавить();
			СтрокаТовары.Номенклатура     = ПолучитьНоменклатуру(БазаИсточник, ИсТовар.Номенклатура);
			СтрокаТовары.ЕдиницаИзмерения = ПолучитьЕдиницуИзмерения(БазаИсточник, СтрокаТовары.Номенклатура.Ссылка, ИсТовар.ЕдиницаИзмерения);
			СтрокаТовары.Коэффициент      = ИсТовар.Коэффициент;
			СтрокаТовары.Количество       = ИсТовар.Количество;
			СтрокаТовары.Цена             = ИсТовар.Цена;
			СтрокаТовары.СтавкаНДС        = ПолучитьСтавкуНДС(БазаИсточник, ИсТовар.СтавкаНДС);
			СтрокаТовары.СуммаНДС         = ИсТовар.СуммаНДС;
			СтрокаТовары.Сумма            = ИсТовар.Сумма;
		КонецЦикла;
		
		Для Каждого ИсУслуга Из Выборка.Услуги.Unload() Цикл
			СтрокаТовары = Документ.Услуги.Добавить();
			СтрокаТовары.Номенклатура     = ПолучитьНоменклатуру(БазаИсточник, ИсУслуга.Номенклатура);
			СтрокаТовары.Содержание       = ИсУслуга.Содержание;
			СтрокаТовары.Количество       = ИсУслуга.Количество;
			СтрокаТовары.Цена             = ИсУслуга.Цена;
			СтрокаТовары.СтавкаНДС        = ПолучитьСтавкуНДС(БазаИсточник, ИсУслуга.СтавкаНДС);
			СтрокаТовары.СуммаНДС         = ИсУслуга.СуммаНДС;
			СтрокаТовары.Сумма            = ИсУслуга.Сумма;
		КонецЦикла;
		
		Для Каждого ИсТара Из Выборка.ВозвратнаяТара.Unload() Цикл
			СтрокаТовары = Документ.ВозвратнаяТара.Добавить();
			СтрокаТовары.Номенклатура     = ПолучитьНоменклатуру(БазаИсточник, ИсТара.Номенклатура);
			СтрокаТовары.Количество       = ИсТара.Количество;
			СтрокаТовары.Цена             = ИсТара.Цена;
			СтрокаТовары.Сумма            = ИсТара.Сумма;
		КонецЦикла;
		
		Документ.ПометкаУдаления       = Выборка.ПометкаУдаления;
		//Документ.Проведен              = Выборка.Проведен;
		Документ.обменДанными.Загрузка = Истина;
		Попытка
			Документ.Записать(РежимЗаписиДокумента.Запись);
			Если Выборка.Проведен Тогда
				Документ.обменДанными.Загрузка = Ложь;
				Документ.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли; 
		Исключение
			//Документ.ПолучитьФорму().Открыть();
		КонецПопытки;
		_Сообщения.ДобавитьСтроку("Обработали: " + Документ);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция  НайтиФункцияКонтрагентовВИсточнике(БазаИсточник)
	Объект.КонтрагентыИсточник.Очистить();
	
	УИД = Объект.Контрагент.УникальныйИдентификатор(); 
	УИДТам = БазаИсточник.NewObject("УникальныйИдентификатор",Строка(УИД));
	
	РезПоиска = БазаИсточник.Справочники.Контрагенты.GetRef(УИДТам);
	Если Найти(Строка(РезПоиска),"<") <> 0 Тогда
		КодПоЕДРПОУ = СокрЛП(Объект.Контрагент.КодПоЕДРПОУ);
		Если КодПоЕДРПОУ  = "" Тогда
			РезПоискаРеквизит = БазаИсточник.Справочники.Контрагенты.НайтиПоНаименованию(Объект.Контрагент.Наименование, Истина);
		Иначе	
			РезПоискаРеквизит = БазаИсточник.Справочники.Контрагенты.НайтиПоРеквизиту("КодПоЕДРПОУ",КодПоЕДРПОУ);
		КонецЕсли; 
		
		Если РезПоискаРеквизит.Пустая() Тогда
			Возврат Справочники.Контрагенты.ПустаяСсылка();
		Иначе	
			Возврат РезПоискаРеквизит.Ссылка;	
		КонецЕсли; 
	Иначе
		Возврат РезПоиска.Ссылка;	
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура НайтиКонтрагентовВИсточнике()
	Объект.КонтрагентыИсточник.Очистить();
	
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		БазаИсточник = ПодлючитьсяКУТПНаСервере();
		
		КонтрагентИсточник = НайтиФункцияКонтрагентовВИсточнике(БазаИсточник);

		Если Не КонтрагентИсточник.Description = "" Тогда
			НС = Объект.КонтрагентыИсточник.Добавить();
			Нс.Наименование = КонтрагентИсточник.Наименование;
			Нс.Код = КонтрагентИсточник.Код;
			Нс.УИД = БазаИсточник.String(КонтрагентИсточник.УникальныйИдентификатор());
		КонецЕсли; 
	
		
	
	КонецЕсли; 
КонецПроцедуры


&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()
	НайтиКонтрагентовВИсточнике();
КонецПроцедуры

