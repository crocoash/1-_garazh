			//НовыйЭлемент.СложныйНалоговыйУчет    = Источник.СложныйНалоговыйУчет;
			//НовыйЭлемент.НеОтноситьНаЗатратыПоНУ = Источник.НеОтноситьНаЗатратыПоНУ;
			НовыйЭлемент.ПроцентКомиссионногоВознаграждения = Источник.ПроцентКомиссионногоВознаграждения;
			НовыйЭлемент.ВидВзаиморасчетов       = ПолучитьВидВзаиморасчетов(Источник.ВидВзаиморасчетов);
			НовыйЭлемент.СпособРасчетаКомиссионногоВознаграждения = ПолучитьСпособРасчетаКомиссионногоВознаграждения(БазаИсточник, Источник.СпособРасчетаКомиссионногоВознаграждения);
			НовыйЭлемент.ТипЦен                  = ПолучитьТипЦен(БазаИсточник, Источник.ТипЦен);
			//НовыйЭлемент.ВидДеятельностиДляДДС   = ПолучитьВидДеятельностиДляДДС(БазаИсточник, Источник.ВидДеятельностиДляДДС);
			НовыйЭлемент.СхемаНалоговогоУчета                       = ПолучитьСхемуНалоговогоУчетаПоДоговорамКонтрагентов(Источник.СхемаНалоговогоУчета);
			НовыйЭлемент.СхемаНалоговогоУчетаПоТаре                 = ПолучитьСхемуНалоговогоУчетаПоДоговорамКонтрагентов(Источник.СхемаНалоговогоУчетаПоТаре);;
			
			НовыйЭлемент.ОбменДанными.Загрузка = Истина;
			НовыйЭлемент.Записать();
			
			Возврат НовыйЭлемент.Ссылка; 
