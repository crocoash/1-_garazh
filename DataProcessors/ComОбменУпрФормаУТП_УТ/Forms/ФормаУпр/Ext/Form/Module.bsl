		Если НЕ РезПоиска.Владелец = Контрагент Тогда
		    СпрОбъект = РезПоиска.ПолучитьОбъект();
			СпрОбъект.Владелец = Контрагент;
			СпрОбъект.ОбменДанными.Загрузка = Истина;
			СпрОбъект.Записать();
		КонецЕсли; 
		
		Возврат РезПоиска.Ссылка;	
	КонецЕсли;
