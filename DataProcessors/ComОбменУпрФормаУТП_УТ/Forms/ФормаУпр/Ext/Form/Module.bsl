			НовыйЭлемент.Организация             = ПолучитьОрганизацию(Источник.Организация, СоответствиеДанныхВКеше);
			НовыйЭлемент.Дата                    = Источник.Дата;
			НовыйЭлемент.Номер                   = СокрЛП(Источник.Номер);
			НовыйЭлемент.ВидДоговора             = ПолучитьВидДоговора(БазаИсточник, Источник.ВидДоговора);
