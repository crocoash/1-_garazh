Функция ПолучитьНоменклатуру(БазаИсточник, Источник)
	УИД = БазаИсточник.String(Источник.УникальныйИдентификатор()); 
	Приемник = Справочники.Номенклатура;
	
	РезПоиска = Приемник.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
	Если Найти(Строка(РезПоиска),"<") <> 0 Тогда
		РезПоискаРеквизит = Приемник.НайтиПоНаименованию(Источник.Наименование, Истина);
		Если РезПоискаРеквизит.Пустая() Тогда
			НовыйЭлемент = Приемник.СоздатьЭлемент();
			НовыйЭлемент.УстановитьСсылкуНового(РезПоиска);
			//ЗаполнитьЗначенияСвойств(Приемник, Источник);
			
			//НовыйЭлемент.Код                     = СокрЛП(Источник.Код);
			НовыйЭлемент.Наименование            = СокрЛП(Источник.Наименование);
			НовыйЭлемент.НаименованиеПолное      = СокрЛП(Источник.НаименованиеПолное);
			НовыйЭлемент.БазоваяЕдиницаИзмерения = ПолучитьКлассификаторЕдиницИзмерения(БазаИсточник, Источник.БазоваяЕдиницаИзмерения); 
			НовыйЭлемент.ВидНоменклатуры         = ПолучитьВидНоменклатуры(БазаИсточник, Источник.ВидНоменклатуры);
			НовыйЭлемент.ОбменДанными.Загрузка   = Истина;
			
			
			// для получения ссылки запишем элемент
			НовыйЭлемент.Записать();
			
			НовыйЭлемент.Артикул                                            = Источник.Артикул;
			НовыйЭлемент.ЕдиницаХраненияОстатков                            = ПолучитьЕдиницуИзмерения(БазаИсточник, НовыйЭлемент.Ссылка,Источник.ЕдиницаХраненияОстатков); 
			
			НовыйЭлемент.ИзмеряетсяТолькоВСуммовомВыражении                 = Источник.ИзмеряетсяТолькоВСуммовомВыражении;
			НовыйЭлемент.ТекстДляПечатиВКолонкеКоличествоНалоговойНакладной = Источник.ТекстДляПечатиВКолонкеКоличествоНалоговойНакладной;
			
			НовыйЭлемент.ТранспортнаяУслуга                                 = Источник.ТранспортнаяУслуга;
			НовыйЭлемент.Набор                                 = Источник.Набор;
			НовыйЭлемент.Услуга                                 = Источник.Услуга;
			НовыйЭлемент.Комплект                                 = Источник.Комплект;
			НовыйЭлемент.ЛьготаНДС                                          = Источник.ЛьготаНДС;
			НовыйЭлемент.Комментарий                                        = Источник.Комментарий;
			
			
			
			// записываем ставку ндс
			НовыйЭлемент.СтавкаНДС                    = ПолучитьСтавкуНДС(БазаИсточник, Источник.СтавкаНДС);
			НовыйЭлемент.НоменклатурнаяГруппа         = ПолучитьНоменклатурнуюГруппу(БазаИсточник, Источник.НоменклатурнаяГруппа);
			//НовыйЭлемент.СтатьяЗатрат                 = ПолучитьСтатьюЗатрат(БазаИсточник, Источник.СтатьяЗатрат);
			НовыйЭлемент.НоменклатураГТД              = ПолучитьНоменклатураГТДРеквизит(БазаИсточник, Источник.НоменклатураГТД);
			
			НовыйЭлемент.Записать();
			
			Возврат НовыйЭлемент.Ссылка; 
		Иначе	
			Возврат РезПоискаРеквизит.Ссылка;	
		КонецЕсли; 
	Иначе
		Возврат РезПоиска.Ссылка;	
	КонецЕсли;
КонецФункции

Функция ПолучитьКонтрагента(БазаИсточник, ИстКонтрагент)
	УИД = БазаИсточник.String(ИстКонтрагент.УникальныйИдентификатор()); 
	РезПоиска = Справочники.Контрагенты.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
	Если Найти(Строка(РезПоиска),"<") <> 0 Тогда
		КодПоЕДРПОУ = СокрЛП(ИстКонтрагент.КодПоЕДРПОУ);
		Если КодПоЕДРПОУ  = "" Тогда
			РезПоискаРеквизит = Справочники.Контрагенты.НайтиПоНаименованию(ИстКонтрагент.Наименование, Истина);
		Иначе	
			РезПоискаРеквизит = Справочники.Контрагенты.НайтиПоРеквизиту("КодПоЕДРПОУ",КодПоЕДРПОУ);
		КонецЕсли; 
		
		Если РезПоискаРеквизит.Пустая() Тогда
			Возврат КонвСпрКонтрагенты(БазаИсточник, ИстКонтрагент, РезПоиска);
		Иначе	
			Возврат РезПоискаРеквизит.Ссылка;	
		КонецЕсли; 
	Иначе
		Возврат РезПоиска.Ссылка;	
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ЗагрузитьДанныеСУТП(Команда)
	ЗагрузитьДанныеСУТПНаСервере();
КонецПроцедуры


&НаСервере
Процедура ЗагрузитьДанныеСУТПНаСервере()
	
	БазаИсточник = ПодлючитьсяКУТПНаСервере();
	
	СоответствиеДанныхВКеше = Новый Соответствие;
	СоответствиеДанныхВКеше.Вставить("Организации", Новый Соответствие());
	
	Если Объект.ЗаказПокупателя Тогда
		КонвДокЗаказПокупателя(БазаИсточник, СоответствиеДанныхВКеше);
	КонецЕсли; 
	
	Если Объект.ПоступлениеТоваровУслуг Тогда
		КонвДокПоступлениеТоваровУслуг(БазаИсточник, СоответствиеДанныхВКеше);
	КонецЕсли; 
	
	Если Объект.ПлатежноеПоручениеВходящее Тогда
		КонвДокПлатежноеПоручениеВходящее(БазаИсточник, СоответствиеДанныхВКеше);
	КонецЕсли; 
	
	Если Объект.ПлатежноеПоручениеИсходящее Тогда
		КонвДокПлатежноеПоручениеИсходящее(БазаИсточник, СоответствиеДанныхВКеше);
	КонецЕсли; 
	
	БазаИсточник = Неопределено;
	
КонецПроцедуры


&НаСервере
Функция ПодлючитьсяКУТПНаСервере()
	
