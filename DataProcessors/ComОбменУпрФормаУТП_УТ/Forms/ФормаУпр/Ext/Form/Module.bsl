	Организации = СоответствиеДанныхВКеше.Получить("Организации");
	
	Организация = Организации.Получить(ОбъктИсточникКод);
	
	Если Организация = Неопределено Тогда
		Организация = Справочники.Организации.НайтиПоНаименованию(ОбъктИсточникКод, Истина);
		Если Не ЗначениеЗаполнено(Организация) Тогда
			_Сообщения.ДобавитьСтроку("    *** Не найдена по наименованию Организация -  " + ОбъктИсточникКод);
		КонецЕсли; 
		Организации.Вставить(ОбъктИсточникКод, Организация);
		
		
		СоответствиеДанныхВКеше.Вставить("Организации",Организации);
