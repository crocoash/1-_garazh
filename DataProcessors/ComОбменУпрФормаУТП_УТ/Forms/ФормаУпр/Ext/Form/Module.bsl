	|	Док.Дата,
	|	Док.Проведен,
	|	Док.ВалютаДокумента,
	|	ВЫБОР
	|		КОГДА Док.ВидОперации = &ВидОперацииДокументаОплатаПоставщику
	|			ТОГДА ""ОплатаПоставщику""
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Док.ВидОперации = &ВидОперацииВозвратВозвратДенежныхСредствПокупателю
	|					ТОГДА ""ВозвратДенежныхСредствПокупателю""
	|				ИНАЧЕ """"
	|			КОНЕЦ
	|	КОНЕЦ КАК ВидОперацииЗначение,
	|	Док.ДоговорКонтрагента,
	|	Док.ДокументОснование,
	|	Док.Комментарий,
	|	Док.Контрагент,
	|	Док.Оплачено,
	|	Док.Организация,
	|	Док.Ответственный,
	|	Док.СтатьяДвиженияДенежныхСредств,
	|	Док.СуммаДокумента,
	|	Док.СчетКонтрагента,
	|	Док.СчетОрганизации,
	|	Док.Дата КАК ДатаВыписки,
	|	Док.НазначениеПлатежа,
	|	Док.Представление,
	|	Док.РасшифровкаПлатежа.(
	|		Ссылка,
	|		НомерСтроки,
	|		ДоговорКонтрагента,
	|		Сделка,
	|		КурсВзаиморасчетов,
	|		СуммаПлатежа,
	|		КратностьВзаиморасчетов,
	|		СуммаВзаиморасчетов,
	|		СтавкаНДС,
	|		СуммаНДС,
	|		СтатьяДвиженияДенежныхСредств,
	|		ДокументПланированияПлатежа,
	|		Проект,
	|		КурсВзаиморасчетовПлан,
	|		СуммаПлатежаПлан,
	|		ЗаТару,
	|		СтатьяДекларацииПоЕдиномуНалогу,
	|		ДокументРасчетовСКонтрагентом
	|	),
	|	Док.РеквизитыКонтрагента.(
	|		Ссылка,
	|		НомерСтроки,
	|		Реквизит,
	|		Значение,
	|		Представление,
	|		ТипКонтрагента
	|	),
	|	Док.ОтражатьВБухгалтерскомУчете
	|ИЗ
	|	Документ.ПлатежноеПоручениеИсходящее КАК Док
	|ГДЕ
	|	Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Док.ВидОперации В(&ВидыОперацийДокумента)
	|	И Док.Проведен";
	
	ИсЗапрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	ИсЗапрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	ИсЗапрос.УстановитьПараметр("ВидыОперацийДокумента", ВидыОперацийДокумента);
