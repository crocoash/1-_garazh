Функция ПолучитьПодразделение(БазаИсточник, Знач Источник)
	УИД = БазаИсточник.String(Источник.УникальныйИдентификатор()); 
	Приемник = Справочники.Подразделения;
	ИсточникКод = СокрЛП(Источник.Код);
	ИсточникНаименование = СокрЛП(Источник.Наименование);

	РезПоиска = Приемник.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
	
	Если Найти(Строка(РезПоиска),"<") <> 0 Тогда
		//РезПоискаРеквизит = Приемник.НайтиПоКоду(ИсточникКод);
		РезПоискаРеквизит = Приемник.НайтиПоНаименованию(ИсточникНаименование, Истина);
		Если РезПоискаРеквизит.Пустая() Тогда
			Если Источник.ЭтоГруппа Тогда
				НовыйЭлемент = Приемник.СоздатьГруппу();
			иначе	
				НовыйЭлемент = Приемник.СоздатьЭлемент();
			КонецЕсли; 
			
			НовыйЭлемент.УстановитьСсылкуНового(РезПоиска);
			НовыйЭлемент.Код                     = ИсточникКод;
			НовыйЭлемент.Наименование            = ИсточникНаименование;
			
			
			//***************************************************************************
			// проверяем на наличие всех родителей и если их нет то создаем
			//***************************************************************************
			ТаблицаРодителей = Новый ТаблицаЗначений;
			ТаблицаРодителей.Колонки.Добавить("НомерПП");
			ТаблицаРодителей.Колонки.Добавить("Род");
			Уров = Источник.Уровень();
			ТекРодитель = Источник;
			Для ии = 1 По Уров-1 Цикл
				СтрТаблицы = ТаблицаРодителей.Добавить();
				СтрТаблицы.НомерПП = ии;
				СтрТаблицы.Род = ТекРодитель.Родитель;
				ТекРодитель = СтрТаблицы.Род;
			КонецЦикла;
			ТаблицаРодителей.Сортировать("НомерПП убыв");
			ТекРодитель = Приемник.ПустаяСсылка();
			Для Каждого Стр Из ТаблицаРодителей Цикл
	
				ИскомыйРодитель = ПолучитьПодразделение(БазаИсточник, Стр.Род); //Приемник.НайтиПоКоду(Стр.Род.Код);
					
				//Если ИскомыйРодитель.Пустая() Тогда
				//	ИскомыйРодитель = Приемник.СоздатьГруппу();		
				//	ИскомыйРодитель.Код          = Стр.Род.Код;
				//	ИскомыйРодитель.Наименование = Стр.Род.Наименование;
				//	ИскомыйРодитель.Родитель     = ТекРодитель.Ссылка;
				//	ИскомыйРодитель.Записать();
				//КонецЕсли;
				ТекРодитель = ИскомыйРодитель;
			КонецЦикла;				
			
			НовыйЭлемент.Родитель = ТекРодитель;
			
			
			НовыйЭлемент.ОбменДанными.Загрузка = Истина;
			НовыйЭлемент.Записать();
			
			Возврат НовыйЭлемент.Ссылка; 
		Иначе	
			Возврат РезПоискаРеквизит.Ссылка;	
		КонецЕсли; 
	Иначе
		Возврат РезПоиска.Ссылка;	
	КонецЕсли;

КонецФункции


Функция ПолучитьБанковскийСчет(БазаИсточник, Владелец, Источник)
	УИД = БазаИсточник.String(Источник.УникальныйИдентификатор()); 
	Приемник = Справочники.БанковскиеСчета;
	
	РезПоиска = Приемник.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
	
	Если Найти(Строка(РезПоиска),"<") <> 0 Тогда
		РезПоискаРеквизит = Приемник.НайтиПоКоду(Источник.Код,,,Владелец);
		Если РезПоискаРеквизит.Пустая() Тогда
			НовыйЭлемент = Приемник.СоздатьЭлемент();
			НовыйЭлемент.УстановитьСсылкуНового(РезПоиска);
			НовыйЭлемент.Код                     = СокрЛП(Источник.Код);
			НовыйЭлемент.Наименование            = СокрЛП(Источник.Наименование);
			НовыйЭлемент.Владелец            = Владелец;
			
			НовыйЭлемент.НомерСчета = Источник.НомерСчета;
			НовыйЭлемент.ВалютаДенежныхСредств   = ПолучитьВалюту(Источник.ВалютаДенежныхСредств);
			НовыйЭлемент.ДатаОткрытия   = Источник.ДатаОткрытия;
			НовыйЭлемент.ДатаЗакрытия   = Источник.ДатаЗакрытия;
			НовыйЭлемент.СуммаБезКопеек   = Источник.СуммаБезКопеек;
			
			
			НовыйЭлемент.ОбменДанными.Загрузка = Истина;
			НовыйЭлемент.Записать();
			
			Возврат НовыйЭлемент.Ссылка; 
		Иначе	
			Возврат РезПоискаРеквизит.Ссылка;	
		КонецЕсли; 
	Иначе
		Возврат РезПоиска.Ссылка;	
	КонецЕсли;
КонецФункции

Процедура КонвДокПоступлениеТоваровУслуг(БазаИсточник, СоответствиеДанныхВКеше)
	
	//ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ПродажаКомиссия;
	
	СтатусСоздан = Справочники.Статусы.Создан;
	
	ИсЗапрос = БазаИсточник.NewObject("Запрос");
	ИсЗапрос.Текст = 
		"ВЫБРАТЬ
		|	Док.Ссылка,
		|	Док.ВерсияДанных,
		|	Док.ПометкаУдаления,
		|	Док.Номер,
		|	Док.Дата,
		|	Док.СкладОрдер,
		|	Док.Проведен,
		|	Док.ВалютаДокумента,
		|	Док.ДоговорКонтрагента,
		|	Док.Комментарий,
		|	Док.Контрагент,
		|	Док.КратностьВзаиморасчетов,
		|	Док.КурсВзаиморасчетов,
		|	Док.Организация,
		|	Док.Ответственный,
		|	Док.СуммаВключаетНДС,
		|	Док.СуммаДокумента,
		|	Док.ТипЦен,
		|	Док.УчитыватьНДС,
		|	Док.Представление,
		|	Док.Товары.(
		|		Ссылка,
		|		НомерСтроки,
		|		Номенклатура,
		|		ЕдиницаИзмеренияМест,
		|		Цена,
		|		Сумма,
		|		СтавкаНДС,
		|		СуммаНДС,
		|		ХарактеристикаНоменклатуры,
		|		Коэффициент,
		|		Количество,
		|		КоличествоМест,
		|		ЕдиницаИзмерения,
		|		Склад,
		|		ЗаказПоставщику,
		|		Заказ
		|	),
		|	Док.ВозвратнаяТара.(
		|		Ссылка,
		|		НомерСтроки,
		|		Номенклатура,
		|		Количество,
		|		Цена,
		|		Сумма
		|	),
		|	Док.Услуги.(
		|		Ссылка,
		|		НомерСтроки,
		|		Содержание,
		|		Количество,
		|		Цена,
		|		Сумма,
		|		СтавкаНДС,
		|		СуммаНДС,
		|		Номенклатура
		|	),
		|	Док.Сделка,
		|	Док.ОтражатьВУправленческомУчете,
		|	Док.ОтражатьВБухгалтерскомУчете,
		|	Док.Подразделение,
		|	Док.НомерВходящегоДокумента,
		|	Док.ДатаВходящегоДокумента
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК Док
		|ГДЕ
		|	Док.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Док.Организация В(&ОрганизацииДляОбмена)
		|	И ВЫБОР
		|			КОГДА &ФильтрПоКонтрагенту
		|				ТОГДА Док.Контрагент = &Контрагент
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата";

	
	ОрганизацииДляОбмена = БазаИсточник.NewObject("Массив");
	
	Для каждого Организация из СпОрганизаций Цикл
		ОрганизацииДляОбмена.Добавить(БазаИсточник.Справочники.Организации.НайтиПоНаименованию(Организация.Значение.Наименование, Истина));
		//_Сообщения.ДобавитьСтроку("Организация базы -  " + Организация.Значение.Наименование);
	КонецЦикла;
	
	ИсЗапрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	ИсЗапрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	ИсЗапрос.УстановитьПараметр("ОрганизацииДляОбмена", ОрганизацииДляОбмена);
	
	Если Не Объект.КонтрагентыИсточник.Количество() = 0 Тогда
		ИсЗапрос.УстановитьПараметр("ФильтрПоКонтрагенту", Истина);
		УИДТам = БазаИсточник.NewObject("УникальныйИдентификатор",Строка(Объект.КонтрагентыИсточник[0].УИД));
		ИсЗапрос.УстановитьПараметр("Контрагент", БазаИсточник.Справочники.Контрагенты.GetRef(УИДТам));
	Иначе
		ИсЗапрос.УстановитьПараметр("ФильтрПоКонтрагенту", Ложь);
		ИсЗапрос.УстановитьПараметр("Контрагент", БазаИсточник.Справочники.Контрагенты.ПустаяСсылка());
	КонецЕсли; 
	
	
	Результат = ИсЗапрос.Выполнить();
	Выборка   = Результат.Выбрать();
	
	
	Пока Выборка.Следующий() Цикл
		
		УИД = БазаИсточник.String(Выборка.Ссылка.УникальныйИдентификатор()); //Выборка.Ссылка.УникальныйИдентификатор();
		
		РезПоиска = Документы.ПоступлениеТоваровУслуг.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
		Если Найти(Строка(РезПоиска),"<") <> 0 Тогда
			Документ = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
			Документ.УстановитьСсылкуНового(РезПоиска);
		Иначе
			Если Не ОбновлятьСуществующиеДокументы Тогда
				Продолжить;
			КонецЕсли; 
			Документ = РезПоиска.Получитьобъект();	
			Документ.Товары.Очистить();
			Документ.Услуги.Очистить();
			Документ.ВозвратнаяТара.Очистить();
		КонецЕсли;
		
		//Если Не ЗначениеЗаполнено(Документ.Статус) Тогда
		//    Документ.Статус = СтатусСоздан;
		//КонецЕсли; 
		
		Документ.Номер                   = Выборка.Номер;
		Документ.Дата                    = Выборка.Дата;
		Документ.ВидПоступления = Перечисления.ВидыПоступленияТоваров.НаСклад;
		
		Документ.ДатаВходящегоДокумента  = Выборка.ДатаВходящегоДокумента;
		Документ.НомерВходящегоДокумента  = Выборка.НомерВходящегоДокумента;
		
		Документ.Организация             = ПолучитьОрганизацию(Выборка.Организация, СоответствиеДанныхВКеше);
		Документ.Контрагент              = ПолучитьКонтрагента(БазаИсточник, Выборка.Контрагент);
		
		Документ.ДоговорКонтрагента      = ПолучитьДоговорКонтрагента(БазаИсточник, СоответствиеДанныхВКеше, Документ.Контрагент, Выборка.ДоговорКонтрагента);

		Документ.Ответственный           = ПолучитьПользователя(БазаИсточник, Выборка.Ответственный);			
		//Документ.СтруктурнаяЕдиница      = ПолучитьСтруктурнуюЕдиницу(Выборка.СтруктурнаяЕдиница);
		//Если НЕ ЗначениеЗаполнено(Документ.СтруктурнаяЕдиница) Тогда
		//	Документ.СтруктурнаяЕдиница  = Документ.Организация.ОсновнойБанковскийСчет;
		//КонецЕсли;	
		Документ.ВалютаДокумента         = ПолучитьВалюту(Выборка.ВалютаДокумента);
		Документ.КратностьВзаиморасчетов = Выборка.КратностьВзаиморасчетов;
		Документ.КурсВзаиморасчетов      = Выборка.КурсВзаиморасчетов;
		//Документ.АдресДоставки           = Выборка.АдресДоставки;
		Документ.Комментарий             = Выборка.Комментарий;
		Документ.СкладОрдер             = ПолучитьСклад(Выборка.СкладОрдер);
		Документ.СуммаВключаетНДС        = Выборка.СуммаВключаетНДС;
		Документ.СуммаДокумента          = Выборка.СуммаДокумента;
		Документ.ТипЦен                  = ПолучитьТипЦен(БазаИсточник, Выборка.ТипЦен);
		Документ.УчитыватьНДС            = Выборка.УчитыватьНДС;
		
		Документ.ОтражатьВБухгалтерскомУчете            = Выборка.ОтражатьВБухгалтерскомУчете;
		Документ.ОтражатьВУправленческомУчете            = Выборка.ОтражатьВУправленческомУчете;
		
		Документ.Подразделение           = ПолучитьПодразделение(БазаИсточник, Выборка.Подразделение);
		Документ.Сделка           = ПолучитьДокумент(БазаИсточник, Выборка.Сделка);
		
		Для Каждого ИсТовар Из Выборка.Товары.Unload() Цикл
			СтрокаТовары = Документ.Товары.Добавить();
			СтрокаТовары.Номенклатура     = ПолучитьНоменклатуру(БазаИсточник, ИсТовар.Номенклатура);
			СтрокаТовары.ЕдиницаИзмерения = ПолучитьЕдиницуИзмерения(БазаИсточник, СтрокаТовары.Номенклатура.Ссылка, ИсТовар.ЕдиницаИзмерения);
			СтрокаТовары.Коэффициент      = ИсТовар.Коэффициент;
			СтрокаТовары.Количество       = ИсТовар.Количество;
			СтрокаТовары.Цена             = ИсТовар.Цена;
			СтрокаТовары.СтавкаНДС        = ПолучитьСтавкуНДС(БазаИсточник, ИсТовар.СтавкаНДС);
			СтрокаТовары.СуммаНДС         = ИсТовар.СуммаНДС;
			СтрокаТовары.Сумма            = ИсТовар.Сумма;
			СтрокаТовары.Заказ            = ПолучитьДокумент(БазаИсточник, ИсТовар.Заказ);
			СтрокаТовары.Склад            = ПолучитьСклад(ИсТовар.Склад);
			СтрокаТовары.ЗаказПоставщику  = ПолучитьДокумент(БазаИсточник, ИсТовар.ЗаказПоставщику);
		КонецЦикла;
		
		Для Каждого ИсУслуга Из Выборка.Услуги.Unload() Цикл
			СтрокаТовары = Документ.Услуги.Добавить();
			СтрокаТовары.Номенклатура     = ПолучитьНоменклатуру(БазаИсточник, ИсУслуга.Номенклатура);
			СтрокаТовары.Содержание       = ИсУслуга.Содержание;
			СтрокаТовары.Количество       = ИсУслуга.Количество;
			СтрокаТовары.Цена             = ИсУслуга.Цена;
			СтрокаТовары.СтавкаНДС        = ПолучитьСтавкуНДС(БазаИсточник, ИсУслуга.СтавкаНДС);
			СтрокаТовары.СуммаНДС         = ИсУслуга.СуммаНДС;
			СтрокаТовары.Сумма            = ИсУслуга.Сумма;
		КонецЦикла;
		
		Для Каждого ИсТара Из Выборка.ВозвратнаяТара.Unload() Цикл
			СтрокаТовары = Документ.ВозвратнаяТара.Добавить();
			СтрокаТовары.Номенклатура     = ПолучитьНоменклатуру(БазаИсточник, ИсТара.Номенклатура);
			СтрокаТовары.Количество       = ИсТара.Количество;
			СтрокаТовары.Цена             = ИсТара.Цена;
			СтрокаТовары.Сумма            = ИсТара.Сумма;
		КонецЦикла;
		
		Документ.ПометкаУдаления       = Выборка.ПометкаУдаления;
		//Документ.Проведен              = Выборка.Проведен;
		Документ.обменДанными.Загрузка = Истина;
		Попытка
			Документ.Записать(РежимЗаписиДокумента.Запись);
			Если Выборка.Проведен Тогда
				Документ.обменДанными.Загрузка = Ложь;
				Документ.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли; 
		Исключение
			//Документ.ПолучитьФорму().Открыть();
		КонецПопытки;
		_Сообщения.ДобавитьСтроку("Обработали: " + Документ);
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьВидОперацийВидыОперацийППИсходящее(ЗначениеТекст)
	Возврат Перечисления.ВидыОперацийППИсходящее[ЗначениеТекст];
КонецФункции

Функция ПолучитьДокумент(БазаИсточник, Источник, ДокументИмя = "")
	
	Если Не Источник = Неопределено Тогда
		УИД = БазаИсточник.String(Источник.УникальныйИдентификатор()); 

		МетаданныеПолноеИмя = Источник.Метаданные().ПолноеИмя();
		Если Не Найти(МетаданныеПолноеИмя,"Документ") = 0 Тогда
			ТипДокумента = СтрЗаменить(МетаданныеПолноеИмя,"Документ.","");
		КонецЕсли; 
		
		Приемник = Документы[ТипДокумента];
		ИсточникДата = Источник.Дата;
		ИсточникНомер = Источник.Номер;
		
		РезПоиска = Приемник.ПолучитьСсылку(Новый УникальныйИдентификатор(УИД));
		
		Если Найти(Строка(РезПоиска),"<") <> 0 Тогда

			НовыйЭлемент = Приемник.СоздатьДокумент();
			НовыйЭлемент.УстановитьСсылкуНового(РезПоиска);
			НовыйЭлемент.Дата = ИсточникДата;
			НовыйЭлемент.Номер = ИсточникНомер;
			
			НовыйЭлемент.ОбменДанными.Загрузка = Истина;
			НовыйЭлемент.Записать();
			
			Возврат НовыйЭлемент.Ссылка; 
