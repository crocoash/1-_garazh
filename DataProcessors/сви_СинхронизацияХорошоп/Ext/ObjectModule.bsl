//big_ooo добавление функциональности { [18.01.2017]
Функция ОбработатьТелефон(Знач а)
	б = СтрЗаменить(а," ","");
	б = СтрЗаменить(б,"-","");
	б = СтрЗаменить(б,"+","");
	б = СтрЗаменить(б,"(","");
	б = СтрЗаменить(б,")","");
	б = СтрЗаменить(б,".","");
	б = СтрЗаменить(б,Символы.НПП,"");
	б = СокрЛП(б);
	Возврат б;
КонецФункции


