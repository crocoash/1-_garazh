		ДатаЗаказа = Дата(Год,Мес,День,Час,Мин,Сек);
		
		//с.д.(
		//НовДок = Документы.ЗаказПокупателя.СоздатьДокумент();
		////Значения по умолчанию
		////НовДок.ВидОперации = Перечисления.ВидыОперацийЗаказПокупателя.ПродажаКомиссия;
