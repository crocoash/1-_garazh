Процедура ЗаполнитьТовары(ДокОб,заказСайт,СхемаОбмена)
	ДокОб.Товары.Очистить();
	ДокОб.Услуги.Очистить();
	ИмяРеквизитаИдентификатора = СокрЛП(СхемаОбмена.РеквизитИдентификацииНоменклатуры);
	//ПроцентСкидки = заказСайт.discount_percent+заказСайт.coupon_percent; 
	//
	Всего = 0;
	СуммаПоТоварам = 0;
	Если ИмяРеквизитаИдентификатора = "Штрихкод" Тогда
		ШтрихкодыЗаказа = Новый Массив;
		Для Каждого узСтрокаЗаказа Из заказСайт.products Цикл
			ШтрихкодыЗаказа.Добавить(узСтрокаЗаказа.article);
		КонецЦикла;	
		ЗапросШтрихкодов = Новый Запрос;
		ЗапросШтрихкодов.Текст =
		"ВЫБРАТЬ
		|	Штрихкоды.Штрихкод,
		|	Штрихкоды.Владелец,
		|	Штрихкоды.ХарактеристикаНоменклатуры
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды ГДЕ Штрихкоды.Штрихкод В (&ШтрихкодыЗаказа)";
		ЗапросШтрихкодов.УстановитьПараметр("ШтрихкодыЗаказа", ШтрихкодыЗаказа);
		ТаблШтрихкодов = ЗапросШтрихкодов.Выполнить().Выгрузить();
	КонецЕсли;	 
	Для Каждого узСтрокаЗаказа Из заказСайт.products Цикл
		Если узСтрокаЗаказа.discount_marker = "PRODUCTS_SET" ТОгда
			Продолжить;
		КонецЕсли;	
		НовСтр 		= ДокОб.Товары.Добавить();
		КодТовара 	= мпи_Доработки.УбратьШлакИзСтроки(узСтрокаЗаказа.article);
		Цена      	= Число(узСтрокаЗаказа.price);
		Кво       	= Число(узСтрокаЗаказа.quantity);
		Если ИмяРеквизитаИдентификатора = "Штрихкод" Тогда
			СтрокаШК = ТаблШтрихкодов.Найти(КодТовара, "Штрихкод");
			Если СтрокаШК = Неопределено Тогда
				Товар 		= Справочники.Номенклатура.ПустаяСсылка();	
				Характеристика = Неопределено;
			Иначе
				Товар = СтрокаШК.Владелец;
				Характеристика = СтрокаШК.ХарактеристикаНоменклатуры;
			КонецЕсли;	
		Иначе	
			Товар 		= НайтиЭлементСПР("Номенклатура",ИмяРеквизитаИдентификатора,КодТовара);	
			Характеристика = Неопределено;
			Если НЕ ЗначениеЗаполнено(Товар) Тогда
				Характеристика = НайтиЭлементСПР("ХарактеристикиНоменклатуры", "сви_КодВэбСинхронизации", КодТовара);	
				Если ЗначениеЗаполнено(Характеристика) Тогда
					Товар = Характеристика.Владелец;
				Иначе	
					Сообщить("Внимание! Не найден товар "+узСтрокаЗаказа.title+" артикул ("+узСтрокаЗаказа.article+")");
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
		НовСтр.Номенклатура = Товар;
		ДокОб.ПриИзмененииНоменклатурыТоваров(НовСтр);
		НовСтр.ХарактеристикаНоменклатуры = Характеристика;
		НовСтр.Количество 	= Кво;
		НовСтр.Цена 		= Цена;
		//НовСтр.ПроцентСкидкиНаценки  = ПроцентСкидки;
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НовСтр, ДокОб);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НовСтр, ДокОб);
		СуммаПоТоварам = СуммаПоТоварам + НовСтр.Сумма;
	КонецЦикла;
	//добавим доставку
	СтоимостьДоставки = заказСайт.delivery_price;
	Если СтоимостьДоставки > 0 Тогда
		НовСтр = ДокОб.Услуги.Добавить();
		НовСтр.Номенклатура = СхемаОбмена.НоменклатураДоставка;
		// Заполняем реквизиты табличной части.
		ОбработкаТабличныхЧастей.ЗаполнитьСодержаниеТабЧасти(НовСтр, ДокОб);
		ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(НовСтр, ДокОб, "Реализация");

		НовСтр.Количество 	= 1;
		НовСтр.Цена 		= СтоимостьДоставки;
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НовСтр, ДокОб);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НовСтр, ДокОб);
	КонецЕсли;
	//добавим общую скидку в заказ
	сумСкидки = СуммаПоТоварам - заказСайт.total_sum;
	Если сумСкидки <> 0 Тогда
		СуммаСкидкиРаспред = сумСкидки;
		НакопительныйИтог = ДокОб.Товары.Итог("Сумма");
		Для Каждого ТекСтр Из ДокОб.Товары цикл
			Если НакопительныйИтог = 0 Тогда 
				Прервать;
			КонецЕсли;	
			Если ТекСтр.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;	
			ТекСуммаСкидки = СуммаСкидкиРаспред * ТекСтр.Сумма / НакопительныйИтог;
			СуммаСкидкиРаспред = СуммаСкидкиРаспред - ТекСуммаСкидки;
			НакопительныйИтог = НакопительныйИтог - ТекСтр.Сумма;
			ТекСтр.ПроцентСкидкиНаценки = 100 * ТекСуммаСкидки / ТекСтр.Сумма;
			ТекСтр.Сумма = ТекСтр.Сумма - ТекСуммаСкидки;
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(ТекСтр, ДокОб);
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

