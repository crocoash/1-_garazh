		//НовДок.ДоговорКонтрагента 		= СпрКонтрагент.ОсновнойДоговорКонтрагента;
		//НовДок.АдресДоставки 			= СтруктураКонтрагента.Адрес;
		//НовДок.Комментарий 				= "Автоматически создан при импорте с сайта заказа № "+ИДЗаказа+"."+Инфо;
		//НовДок.сви_ТипДоставки	        = узЗаказ.delivery_type.title;
