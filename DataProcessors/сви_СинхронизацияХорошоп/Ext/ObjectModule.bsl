//ФинЛайт добавление функциональности big_ooo [13.01.2017]
Функция НайтиВСпрПоНаим(имяСпр,наим)
	
	НайденныйЭл = Справочники [имяСпр].НайтиПоНаименованию(наим);
	Если НЕ ЗначениеЗаполнено(НайденныйЭл) Тогда
		спрОб = Справочники [имяСпр].СоздатьЭлемент();
		спрОб.Наименование = наим;
		спрОб.Записать();
		НайденныйЭл = спрОб.Ссылка;
	КонецЕсли;
	Возврат НайденныйЭл;
