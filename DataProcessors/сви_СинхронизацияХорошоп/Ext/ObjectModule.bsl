Процедура ЗагрузкаЗаказов(Обновить=Ложь) Экспорт
	//СхемаОбмена = Подразделение.сви_СхемаОбменаССайтом;
	НастройкиПодключений = СхемаОбмена.НастройкаПодключения;
	
	ТокенРез = мпи_Доработки.ПолучитьТокен_Хорошоп(НастройкиПодключений); 
	
	Если ТокенРез.Статус = "OK" Тогда
		ТокенСтр = ТокенРез.Токен; 
	Иначе
		Сообщить(ТокенРез.Сообщение);
		Возврат;
	КонецЕсли;
	
    ПараметрыПОСТ = "token=#token#&additionalData=true";
    ПараметрыПОСТ = СтрЗаменить(ПараметрыПОСТ,"#token#",ТокенСтр);
    Если ЗначениеЗаполнено(Дата1) Тогда
    	ПараметрыПОСТ = ПараметрыПОСТ+"&from="+Формат(Дата1, "ДФ=dd.MM.yyyy")
    КонецЕсли;
    Если ЗначениеЗаполнено(Дата2) Тогда
    	ПараметрыПОСТ = ПараметрыПОСТ+"&to="+Формат(Дата2, "ДФ=dd.MM.yyyy")
    КонецЕсли;
		
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Language", "ru");
	Заголовки.Вставить("Accept-Charset",  "UTF-8");
	Заголовки.Вставить("Content-Language","ru");
	Заголовки.Вставить("Content-Charset", "UTF-8");
	Заголовки.Вставить("Content-Type",    "application/x-www-form-urlencoded; charset=UTF-8");
	
	АдресСкрипта = "/"+НастройкиПодключений.АдресСкриптаЗагрузкаЗаказов;
	
	Соединение = мпи_Доработки.СоздатьHTTPСоединение(НастройкиПодключений);
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресСкрипта,Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(ПараметрыПОСТ,"UTF-8",ИспользованиеByteOrderMark.НеИспользовать);
	
	HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	
	ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
	
	_Текст = Новый ТекстовыйДокумент;
	_Текст.ДобавитьСтроку(ТекстОтвета);
	
	Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
		_Текст.Записать(СхемаОбмена.ПапкаФайлаЛога + "hs_orders_answ.json");
	Иначе
		_Текст.Записать(ПолучитьИмяВременногоФайла("json"));
	КонецЕсли;
	
	ЧтениеДЖС = Новый ЧтениеJSON;
	ЧтениеДЖС.УстановитьСтроку(ТекстОтвета);
	
	Строки = ПрочитатьJSON(ЧтениеДЖС);
	
	Если НЕ (Строки.status = "OK") Тогда
		Сообщить("Ошибка. "+Строки.response.message);
		Возврат;
	КонецЕсли;
	
	МассивЗаказов = Строки.response.orders;
	Для Каждого узЗаказ ИЗ МассивЗаказов Цикл
		ИДЗаказа = мпи_Доработки.УбратьШлакИзСтроки(узЗаказ.order_id);
		
		//ТекстЗапроса = "ВЫБРАТЬ
		//               |	ЗаказПокупателя.Ссылка
		//               |ИЗ
		//               |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		//               |ГДЕ
