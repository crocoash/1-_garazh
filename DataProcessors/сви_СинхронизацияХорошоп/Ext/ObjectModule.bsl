//ФинЛайт добавление функциональности big_ooo [12.01.2017]
Процедура ЗагрузкаКатегорий(Обновить=Ложь) Экспорт
	
	КодЯзыка = ?(ЗначениеЗаполнено(СхемаОбмена.КодЯзыка),СхемаОбмена.КодЯзыка,"ru");
	
    НастройкиПодключений = СхемаОбмена.НастройкаПодключения;
	//СхемаОбмена = Подразделение.сви_СхемаОбменаССайтом;
    
    ТокенРез = мпи_Доработки.ПолучитьТокен_Хорошоп(НастройкиПодключений); 
    
    Если ТокенРез.Статус = "OK" Тогда
    	ТокенСтр = ТокенРез.Токен; 
    Иначе
    	Сообщить(ТокенРез.Сообщение);
    	Возврат;
    КонецЕсли;
	
	
	ПараметрыПОСТ = "token=#token#";
	ПараметрыПОСТ = СтрЗаменить(ПараметрыПОСТ,"#token#",ТокенСтр);
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Language", "ru");
	Заголовки.Вставить("Accept-Charset",  "UTF-8");
	Заголовки.Вставить("Content-Language","ru");
	Заголовки.Вставить("Content-Charset", "UTF-8");
	Заголовки.Вставить("Content-Type",    "application/x-www-form-urlencoded; charset=UTF-8");
	
	Адрес = НастройкиПодключений.Адрес;
	ПутьНаСервере = "/"+НастройкиПодключений.АдресСкриптаЗагрузкаКатегорий;
	
	HTTPЗапрос = Новый HTTPЗапрос(ПутьНаСервере,Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(ПараметрыПОСТ,"UTF-8",ИспользованиеByteOrderMark.НеИспользовать);
	
	Соединение = мпи_Доработки.СоздатьHTTPСоединение(НастройкиПодключений);

	HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	
	ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
	
	_Текст = Новый ТекстовыйДокумент;
	_Текст.ДобавитьСтроку(ТекстОтвета);
	
	Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
		_Текст.Записать(СхемаОбмена.ПапкаФайлаЛога + "hs_pages_answ.json");
	Иначе
		_Текст.Записать(ПолучитьИмяВременногоФайла("json"));
	КонецЕсли;
	
	
	ЧтениеДЖС = Новый ЧтениеJSON;
	ЧтениеДЖС.УстановитьСтроку(ТекстОтвета);
	
	Строки = ПрочитатьJSON(ЧтениеДЖС);
	
	Если НЕ (Строки.status = "OK") Тогда
		Сообщить("Ошибка. "+Строки.response.message);
		Возврат;
	КонецЕсли;
	
	МассивиКатегорий = Строки.response.pages;
	//ФинЛайт добавление функциональности big_ooo [20.01.2017]
	кодКорня = 0;
	кодОсновнойГруппы = 0;
	//найдем корень
	Для каждого текКатегория Из МассивиКатегорий Цикл
		КодГруппы = мпи_Доработки.УбратьШлакИзСтроки(текКатегория.id);
		КодРодителя = мпи_Доработки.УбратьШлакИзСтроки(текКатегория.parent);
		Наименование = СокрЛП(текКатегория.title[КодЯзыка]);
		Если Наименование = СхемаОбмена.ИмяКорняКаталогаТоваровНаСайте Тогда
			//запоминаем код родителя 
			кодКорня = КодРодителя;
			кодОсновнойГруппы = КодГруппы;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	//удалим лишние страницы
	мДляУдаления = Новый Массив;
	Для каждого текКатегория Из МассивиКатегорий Цикл
		КодГруппы = мпи_Доработки.УбратьШлакИзСтроки(текКатегория.id);
		КодРодителя = мпи_Доработки.УбратьШлакИзСтроки(текКатегория.parent);
		Если (КодРодителя = кодКорня и КодГруппы <>кодОсновнойГруппы) Или КодРодителя = "0" Тогда
			мДляУдаления.Добавить(текКатегория);
		КонецЕсли;
	КонецЦикла;
	Для каждого текЭл Из мДляУдаления Цикл
		поз =  МассивиКатегорий.Найти(текЭл);
		Если поз <> Неопределено Тогда
			МассивиКатегорий.Удалить(поз);			
		КонецЕсли;
		
	КонецЦикла;
	// } ФинЛайт big_ooo [20.01.2017]
	
	Если СхемаОбмена.ХранениеКатегорийСайта = Перечисления.сви_ВидыХраненияКатегорийСайта.КатегорииНоменклатуры ТОгда	
		ВидКатегорий = СхемаОбмена.ВидКатегорийНоменклатуры;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	мпи_КатегорииНоменклатуры.КодВэбСинхронизации,
		|	мпи_КатегорииНоменклатуры.Ссылка
		|ИЗ
		|	Справочник.мпи_КатегорииНоменклатуры КАК мпи_КатегорииНоменклатуры
		|ГДЕ
		|	мпи_КатегорииНоменклатуры.Владелец = &Владелец
		|	И мпи_КатегорииНоменклатуры.КодВэбСинхронизации <> """"";
		Запрос.УстановитьПараметр("Владелец", ВидКатегорий);
		ТаблКатегорий = Запрос.Выполнить().Выгрузить();
	КонецЕсли;	
		
	Для Каждого узКатегория ИЗ МассивиКатегорий Цикл
		КодГруппы = мпи_Доработки.УбратьШлакИзСтроки(узКатегория.id);
		КодРодителя = мпи_Доработки.УбратьШлакИзСтроки(узКатегория.parent);
		Наименование = СокрЛП(узКатегория.title[КодЯзыка]);
		
		Если СхемаОбмена.ХранениеКатегорийСайта = Перечисления.сви_ВидыХраненияКатегорийСайта.ГруппыНоменклатуры ТОгда
			текГруппа = НайтиРодителя(КодГруппы);
			///// ===
			Если Не ЗначениеЗаполнено(текГруппа) Тогда
				НовСпр = Справочники.Номенклатура.СоздатьГруппу();
				фСоздавать = Истина;
			Иначе
				Если НЕ Обновить Тогда   //если найдена группа и не нужно обновлять а только добавлять новые
					Продолжить;
				КонецЕсли;
				НовСпр = текГруппа.ПолучитьОбъект();
				фСоздавать = Ложь;
			КонецЕсли;
			НовСпр.Наименование = Наименование;
			НовСпр.Родитель 	= НайтиРодителя(КодРодителя);
			НовСпр.сви_КодВэбСинхронизации = КодГруппы;
			НовСпр.Записать();
			Если фСоздавать Тогда
				Сообщить("Создана новая группа : "+Наименование+"("+НовСпр.Код+")");
			Иначе
				Сообщить("Обновлена группа : "+Наименование+"("+НовСпр.Код+")");
			КонецЕсли;
		ИначеЕсли СхемаОбмена.ХранениеКатегорийСайта = Перечисления.сви_ВидыХраненияКатегорийСайта.КатегорииНоменклатуры ТОгда	
			СтрокаТаблКатегорий = ТаблКатегорий.Найти(КодГруппы, "КодВэбСинхронизации");
			Если СтрокаТаблКатегорий = Неопределено ТОгда
				НовКатегория = Справочники.мпи_КатегорииНоменклатуры.СоздатьЭлемент();
				НовКатегория.Владелец = ВидКатегорий;
				НовКатегория.Наименование = Наименование;
				НовКатегория.КодВэбСинхронизации = КодГруппы;
				СсылкаРодителя = Справочники.мпи_КатегорииНоменклатуры.ПустаяСсылка();
				Если ЗначениеЗаполнено(КодРодителя) ТОгда
					СтрокаТаблКатегорийРодитель = ТаблКатегорий.Найти(КодРодителя, "КодВэбСинхронизации");
					Если СтрокаТаблКатегорийРодитель <> Неопределено Тогда
						СсылкаРодителя = СтрокаТаблКатегорийРодитель.Ссылка;
					КонецЕсли;	
				КонецЕсли;
				НовКатегория.Родитель = СсылкаРодителя;
				НовКатегория.Записать();
				
				НовСтр = ТаблКатегорий.Добавить();
				НовСтр.Ссылка = НовКатегория.Ссылка;
				НовСтр.КодВэбСинхронизации = КодГруппы;
			Иначе
				Если НЕ Обновить Тогда   //если найдена группа и не нужно обновлять а только добавлять новые
					Продолжить;
				КонецЕсли;
				
				КатегорияОбъект = СтрокаТаблКатегорий.Ссылка.ПолучитьОбъект();
				ЕстьИзменения = Ложь;
				Если КатегорияОбъект.Наименование <> Наименование Тогда
					КатегорияОбъект.Наименование = Наименование;
					ЕстьИзменения = Истина;
				КонецЕсли;	
				СсылкаРодителя = Справочники.мпи_КатегорииНоменклатуры.ПустаяСсылка();
				Если ЗначениеЗаполнено(КодРодителя) ТОгда
					СтрокаТаблКатегорийРодитель = ТаблКатегорий.Найти(КодРодителя, "КодВэбСинхронизации");
					Если СтрокаТаблКатегорийРодитель <> Неопределено Тогда
						СсылкаРодителя = СтрокаТаблКатегорийРодитель.Ссылка;
					КонецЕсли;	
				КонецЕсли;
				Если КатегорияОбъект.Родитель <> СсылкаРодителя Тогда
					КатегорияОбъект.Родитель = СсылкаРодителя;
					ЕстьИзменения = Истина;
				КонецЕсли;	
				Если ЕстьИзменения ТОгда
					КатегорияОбъект.Записать();
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры


//ФинЛайт добавление функциональности big_ooo [12.01.2017]
Функция НайтиРодителя(КодРодителя) Экспорт
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЭтоГруппа = Истина
	|	И Номенклатура.сви_КодВэбСинхронизации = &КодВэбСинхронизации"
	;
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("КодВэбСинхронизации",КодРодителя);
	Выборка = Запрос.Выполнить().Выбрать();
	текГруппа = Неопределено;
	Если Выборка.Следующий() Тогда
		текГруппа = Выборка.Ссылка;
	КонецЕсли;
	Возврат текГруппа;
КонецФункции

Функция ПолучитьНоменклатуруССайта(Обновить)
	КодЯзыка = ?(ЗначениеЗаполнено(СхемаОбмена.КодЯзыка),СхемаОбмена.КодЯзыка,"ru");
	
	НастройкиПодключений = СхемаОбмена.НастройкаПодключения;
	//СхемаОбмена = Подразделение.сви_СхемаОбменаССайтом;
	
	ИмяРеквизитаИдентификатора = СокрЛП(СхемаОбмена.РеквизитИдентификацииНоменклатуры);
	
	тТовары = Новый ТаблицаЗначений;
	тТовары.Колонки.Добавить("ИД",ОбщегоНазначения.ПолучитьОписаниеТиповСтроки(25));
	//тТовары.Колонки.Добавить("флРодительскийАртикул");
	тТовары.Колонки.Добавить("Наименование");
	тТовары.Колонки.Добавить("ДополнительноеОписаниеНоменклатуры");
	тТовары.Колонки.Добавить("КодРодителя");
	тТовары.Колонки.Добавить("Цена",ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15,2));
	тТовары.Колонки.Добавить("ЦенаРРЦ",ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15,2));
	тТовары.Колонки.Добавить("ЦенаСтарая",ОбщегоНазначения.ПолучитьОписаниеТиповЧисла(15,2));
	тТовары.Колонки.Добавить("Валюта");

	Если СхемаОбмена.ЗагружатьСвойстваНоменклатурыССайта Тогда
		тТовары.Колонки.Добавить("СвойстваНоменклатуры"); //++
	КонецЕсли;
	
	тТовары.Колонки.Добавить("Ссылка");
	
	ТокенРез = мпи_Доработки.ПолучитьТокен_Хорошоп(НастройкиПодключений); 
	
	Если ТокенРез.Статус = "OK" Тогда
		ТокенСтр = ТокенРез.Токен; 
	Иначе
		Сообщить(ТокенРез.Сообщение);
		Возврат Неопределено;
	КонецЕсли;
	
	Соединение = мпи_Доработки.СоздатьHTTPСоединение(НастройкиПодключений);
	
	Смещение = 0; Лиммит = 500;
	
	ТегНаименования = СхемаОбмена.ТегНаименования;
	
	Пока Истина Цикл
		
		ПараметрыПОСТ = "token=#token#&offset=#offset#&limit=#limit#";
		ПараметрыПОСТ = СтрЗаменить(ПараметрыПОСТ,"#token#",ТокенСтр);
		ПараметрыПОСТ = СтрЗаменить(ПараметрыПОСТ,"#offset#",мпи_Доработки.УбратьШлакИзСтроки(Формат(Смещение,"ЧГ=0")));
		ПараметрыПОСТ = СтрЗаменить(ПараметрыПОСТ,"#limit#", мпи_Доработки.УбратьШлакИзСтроки(Формат(Лиммит,"ЧГ=0")));
		
		Заголовки = Новый Соответствие();
		Заголовки.Вставить("Accept-Language", "ru");
		Заголовки.Вставить("Accept-Charset",  "UTF-8");
		Заголовки.Вставить("Content-Language","ru");
		Заголовки.Вставить("Content-Charset", "UTF-8");
		//Заголовки.Вставить("Content-Type","application/json");
        Заголовки.Вставить("Content-Type",    "application/x-www-form-urlencoded; charset=UTF-8");
		
		АдресСкриптаЗагрузкаТоваров = "/"+НастройкиПодключений.АдресСкриптаЗагрузкаТоваров;
		
		HTTPЗапрос = Новый HTTPЗапрос(АдресСкриптаЗагрузкаТоваров,Заголовки);
		HTTPЗапрос.УстановитьТелоИзСтроки(ПараметрыПОСТ,"UTF-8",ИспользованиеByteOrderMark.НеИспользовать);
		
		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		
		ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");

		
		_Текст = Новый ТекстовыйДокумент;
		_Текст.ДобавитьСтроку(ТекстОтвета);
		Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
			_Текст.Записать(СхемаОбмена.ПапкаФайлаЛога + "hs_in_goods_answ.json");
		Иначе
			_Текст.Записать(ПолучитьИмяВременногоФайла("json"));
		КонецЕсли;
		
		// Нужно удалять глюкавые символосочетания, но не трогать их если есть двойной слеш
		
		_замена = "\f"; 
		
		Если Найти (ТекстОтвета,"\"+_замена) = 0 Тогда 
			ТекстОтвета = СтрЗаменить(ТекстОтвета,_замена,"");
		КонецЕсли;
		
		_замена = "\b"; 
		Если Найти(ТекстОтвета,"\"+_замена) = 0 Тогда 
			ТекстОтвета = СтрЗаменить(ТекстОтвета,_замена,"");
		КонецЕсли;
		
		_замена = "\t"; 
		Если Найти(ТекстОтвета,"\"+_замена) = 0 Тогда 
			ТекстОтвета = СтрЗаменить(ТекстОтвета,_замена,"");
		КонецЕсли;
		
		ЧтениеДЖС = Новый ЧтениеJSON;
		ЧтениеДЖС.УстановитьСтроку(ТекстОтвета);
				
		//Если Не ЗначениеЗаполнено(ТекстОтвета) Тогда
		//	Прервать;
		//КонецЕсли;	
		
		Строки = ПрочитатьJSON(ЧтениеДЖС,Истина);
		
		Если НЕ (Строки.Получить("status") = "OK") Тогда
			Сообщить("Ошибка.");
			Возврат Неопределено;
		КонецЕсли;
				
		МассивТоваров = Строки.Получить("response").Получить("products");
		
		Если МассивТоваров.Количество() = 0 Тогда
			фКонецЦикла = Истина;
			Прервать;
		КонецЕсли;	
		
		Для Каждого узТовар ИЗ МассивТоваров Цикл
			Если ТипЗнч(узТовар["article"]) = Тип("Число") Тогда
				ИД = мпи_Доработки.УбратьШлакИзСтроки(Формат(узТовар["article"], "ЧРД=."));
			Иначе
				ИД = мпи_Доработки.УбратьШлакИзСтроки(узТовар["article"]);
			КонецЕсли;
			//
			Если Не Обновить Тогда //добавляем только новые
				Товар = НайтиЭлементСПР("Номенклатура",ИмяРеквизитаИдентификатора,ИД);
				Если ЗначениеЗаполнено(Товар) Тогда
					Продолжить; //пропускаем те что уже есть в базе
				КонецЕсли;
			КонецЕсли;
			//
			НовСтр = тТовары.Добавить();
			НовСтр.ИД = ИД;
			//НовСтр.флРодительскийАртикул = флДоработки.УбратьШлакИзСтроки(узТовар["parent_article"]);
			
			title = узТовар ["title"] [КодЯзыка];
			mod_title = узТовар ["mod_title"] [КодЯзыка];
			
			Если ТегНаименования = "title" Тогда
				НовСтр.Наименование = title;
			ИначеЕсли ТегНаименования = "mod_title" Тогда
				НовСтр.Наименование = mod_title;
			Иначе
				Если ЗначениеЗаполнено(mod_title) Тогда
					НовСтр.Наименование = mod_title;
				Иначе
					НовСтр.Наименование = title;
				КонецЕсли;
			КонецЕсли;	
				
			НовСтр.КодРодителя  = мпи_Доработки.УбратьШлакИзСтроки(Строка(узТовар ["parent"]["id"]) );
			НовСтр.ДополнительноеОписаниеНоменклатуры = узТовар ["description"] [КодЯзыка];
			
			НовСтр.Цена					= узТовар["price"];
			НовСтр.ЦенаСтарая			= узТовар["price_old"];
			НовСтр.Валюта				= узТовар["currency"]["value"];
			
			//++ Раздел characteristcs
			Если СхемаОбмена.ЗагружатьСвойстваНоменклатурыССайта Тогда
				ТаблицаСвойств = Новый ТаблицаЗначений;
				ТаблицаСвойств.Колонки.Добавить("ИмяСвойства");
				ТаблицаСвойств.Колонки.Добавить("ЗначениеСвойства");
				
				Для Каждого ТекСвойство Из узТовар["characteristics"] Цикл
					НС = ТаблицаСвойств.Добавить();
					НС.ИмяСвойства = ТекСвойство.Ключ;
					НС.ЗначениеСвойства = ТекСвойство.Значение [КодЯзыка]; 
				КонецЦикла;
				НовСтр.СвойстваНоменклатуры = ТаблицаСвойств;
			КонецЕсли;
		КонецЦикла;
		
		Смещение = Смещение + Лиммит;
		
		//Сообщить(Смещение);
		
		//Прервать;
		
	КонецЦикла;
	
	Сообщить("Всего товаров : "+тТовары.Количество());
	
	Возврат тТовары;
КонецФункции

Процедура ЗагрузкаНоменклатуры(Обновить=Ложь) Экспорт
	
	НастройкиПодключений = СхемаОбмена.НастройкаПодключения;
	//СхемаОбмена = Подразделение.сви_СхемаОбменаССайтом;
	
	ИмяРеквизитаИдентификатора = СокрЛП(СхемаОбмена.РеквизитИдентификацииНоменклатуры);
	
	тТовары = ПолучитьНоменклатуруССайта(Обновить);
	
	Если тТовары = Неопределено Тогда
		Возврат;
	КонецЕсли;
	//ВременнаяГруппа = Справочники.Номенклатура.НайтиПоКоду("00000011066");
	
	КвоНовых = 0;
	
	Если СхемаОбмена.ХранениеКатегорийСайта = Перечисления.сви_ВидыХраненияКатегорийСайта.КатегорииНоменклатуры ТОгда	
		ВидКатегорий = СхемаОбмена.ВидКатегорийНоменклатуры;
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	мпи_КатегорииНоменклатуры.КодВэбСинхронизации,
		|	мпи_КатегорииНоменклатуры.Ссылка
		|ИЗ
		|	Справочник.мпи_КатегорииНоменклатуры КАК мпи_КатегорииНоменклатуры
		|ГДЕ
		|	мпи_КатегорииНоменклатуры.Владелец = &Владелец
		|	И мпи_КатегорииНоменклатуры.КодВэбСинхронизации <> """"";
		Запрос.УстановитьПараметр("Владелец", ВидКатегорий);
		ТаблКатегорий = Запрос.Выполнить().Выгрузить();
	КонецЕсли;	
	
	Для Каждого Стр ИЗ тТовары Цикл
		Товар = НайтиЭлементСПР("Номенклатура",ИмяРеквизитаИдентификатора,Стр.ИД);
		фСоздавать = Ложь;
		Если ЗначениеЗаполнено(Товар) Тогда
			НовСпр = Товар.ПолучитьОбъект();
		Иначе
			НовСпр = Справочники.Номенклатура.СоздатьЭлемент();
			фСоздавать = Истина;
		КонецЕсли;
		
		//реквизиты сайта
		ЗаполнитьЗначенияСвойств(НовСпр,Стр);
		//
		Если НЕ ИмяРеквизитаИдентификатора = "Штрихкод" Тогда
			НовСпр[ИмяРеквизитаИдентификатора] = Стр.ИД;
		КонецЕсли;
		
		НовСпр.Наименование 		= Стр.Наименование;
		НовСпр.НаименованиеПолное 	= НовСпр.Наименование;
		
		Если СхемаОбмена.ХранениеКатегорийСайта = Перечисления.сви_ВидыХраненияКатегорийСайта.ГруппыНоменклатуры Тогда
			НовСпр.Родитель = НайтиРодителя(Стр.КодРодителя);
		Иначе
			//Записываем номенклатуру в отдельную группу определенную в схеме синхронизации
			НовСпр.Родитель = СхемаОбмена.ГруппаНоменклатурыПриЗагрузкеИзСайта;
		КонецЕсли;	
		//реквизиты по умолч
		Если фСоздавать Тогда
			НовСпр.БазоваяЕдиницаИзмерения = СхемаОбмена.БазоваяЕдиницаИзмерения; //УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "ОсновнаяЕдиницаПоКлассификатору");
			НовСпр.СтавкаНДС = СхемаОбмена.СтавкаНДС; //УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "ОсновнаяСтавкаНДС");
			НовСпр.ВидНоменклатуры = СхемаОбмена.ВидНоменклатуры;
			НовСпр.Услуга   = (НовСпр.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга);
			НовСпр.Набор    = (НовСпр.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Набор);
			НовСпр.Комплект = (НовСпр.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Комплект);
			НовСпр.Записать();
			//добавляю единицы
			НайденнаяЕдиницаОбъект = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
			НайденнаяЕдиницаОбъект.Наименование            = СокрЛП(НовСпр.БазоваяЕдиницаИзмерения);
			НайденнаяЕдиницаОбъект.ЕдиницаПоКлассификатору = НовСпр.БазоваяЕдиницаИзмерения;
			НайденнаяЕдиницаОбъект.Коэффициент             = 1;
			НайденнаяЕдиницаОбъект.Владелец                = НовСпр.Ссылка;
			
			Попытка
				НайденнаяЕдиницаОбъект.Записать();
			Исключение
				Сообщить("Не удалось записать единицу хранения остатков: " + ОписаниеОшибки(), СтатусСообщения.Важное);
			КонецПопытки;
			НовСпр.ЕдиницаХраненияОстатков = НайденнаяЕдиницаОбъект.Ссылка;
			НовСпр.ЕдиницаДляОтчетов = НовСпр.ЕдиницаХраненияОстатков;
		КонецЕсли;	
		
		НовСпр.ДополнительноеОписаниеНоменклатуры = СокрЛП(Стр.ДополнительноеОписаниеНоменклатуры);
		//++ Дополнительное описание в форматированный документ
		Если НЕ СокрЛП(Стр.ДополнительноеОписаниеНоменклатуры) = "" Тогда
			
			СтрокаФорматированногоОписания = "<HTML><HEAD>
				|<META content=""text/html; charset=utf-8"" http-equiv=Content-Type>
				|<META name=GENERATOR content=""MSHTML 11.00.9600.17842""></HEAD>
				|<BODY>" 
				+ Стр.ДополнительноеОписаниеНоменклатуры 
				+ "</BODY></HTML>";
				
			НовСпр.ФорматированноеОписание = Новый ХранилищеЗначения (СтрокаФорматированногоОписания);
		КонецЕсли;
		
		НовСпр.Записать();
		
		//++ Свойства номенклатуры
		Если СхемаОбмена.ЗагружатьСвойстваНоменклатурыССайта Тогда
			
			//Очистим свойства перед обновлением
			Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
			Набор.Отбор.Объект.Установить (НовСпр.Ссылка);
			Набор.Прочитать();
			
			мУС = Новый Массив;
			Для Каждого ТекЗапись Из Набор Цикл
				Если НЕ ТекЗапись.Свойство.сви_СинхронизироватьССайтом Тогда
					Продолжить;
				КонецЕсли;
				НайдСтроки = Стр.СвойстваНоменклатуры.НайтиСтроки (Новый Структура ("ИмяСвойства", ТекЗапись.Свойство.Наименование));
				Если НайдСтроки.Количество() = 0 Тогда
					мУС.Добавить(ТекЗапись);
				ИначеЕсли НайдСтроки[0].ЗначениеСвойства = "" Тогда
					мУС.Добавить(ТекЗапись);
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого УС Из мУС Цикл
				Набор.Удалить(УС);
			КонецЦикла;
			Набор.Записать();
			
			Для Каждого ТекСвойство Из Стр.СвойстваНоменклатуры Цикл
				
				ЗаписатьСвойствоДляНоменклатуры(НовСпр.Ссылка, ТекСвойство.ИмяСвойства, ТекСвойство.ЗначениеСвойства);
				
			КонецЦикла;
		КонецЕсли;
		//--
		Если СхемаОбмена.ХранениеКатегорийСайта = Перечисления.сви_ВидыХраненияКатегорийСайта.КатегорииНоменклатуры ТОгда
			Если ЗначениеЗаполнено(Стр.КодРодителя) Тогда
				СтрокаТаблКатегорий = ТаблКатегорий.Найти(Стр.КодРодителя, "КодВэбСинхронизации");
				Если СтрокаТаблКатегорий <> Неопределено Тогда
					//Проверим. Если Есть несколько категорий, то надо для первой основную установить
					НЗ = РегистрыСведений.мпи_ЗначенияКатегорийНоменклатуры.СоздатьНаборЗаписей();
					НЗ.Отбор.НоменклатураОбъект.Установить(НовСпр.Ссылка);
					НЗ.Прочитать();
					Если НЗ.Количество() Тогда
						Основная = Ложь;
					Иначе
						Основная = Истина;
					КонецЕсли;	
					
					МЗ = РегистрыСведений.мпи_ЗначенияКатегорийНоменклатуры.СоздатьМенеджерЗаписи();
					МЗ.НоменклатураОбъект = НовСпр.Ссылка;
					МЗ.ВидКатегории = ВидКатегорий;
					МЗ.Значение = СтрокаТаблКатегорий.Ссылка;
					МЗ.Основная = Основная;
					МЗ.Записать();
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
		
		Если ИмяРеквизитаИдентификатора = "Штрихкод" Тогда
			МЗ = РегистрыСведений.Штрихкоды.СоздатьМенеджерЗаписи();
			МЗ.Владелец = НовСпр.Ссылка;
			МЗ.Штрихкод = Стр.ИД;
			МЗ.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
			МЗ.Качество = Справочники.Качество.Новый;
			МЗ.Записать();
		КонецЕсли;	
		
		Если фСоздавать Тогда
			Сообщить("Создан новый товар: "+НовСпр.Наименование+" Код : "+НовСпр.Код);
		Иначе
			Сообщить("Обновлен товар: "+НовСпр.Наименование+" Код : "+НовСпр.Код);
		КонецЕсли;
		КвоНовых = КвоНовых + 1;
		//ОбработкаПрерыванияПользователя();
	КонецЦикла;
	
	Сообщить("Создано товаров : "+КвоНовых);
	
КонецПроцедуры

Процедура ЗаписатьСвойствоДляНоменклатуры (НомСсылка, ИмяСвойства, ЗначениеСвойства)
	
	Если СокрЛП(ЗначениеСвойства) = "" Тогда
		Возврат;
	КонецЕсли;
	
	НайденноеСвойство = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоРеквизиту("сви_КодВэбСинхронизации", ИмяСвойства);
	Если НЕ ЗначениеЗаполнено(НайденноеСвойство) Тогда
		СвойствоОбъект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
		СвойствоОбъект.Наименование = ИмяСвойства;
		СвойствоОбъект.сви_КодВэбСинхронизации = ИмяСвойства;
		СвойствоОбъект.сви_ВидРеквизитаНаСайте = Перечисления.сви_ВидыРеквизитовСайта.Характеристика;
		СвойствоОбъект.сви_СинхронизироватьССайтом = Истина;
		СвойствоОбъект.НазначениеСвойства = ПланыВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Справочник_Номенклатура;
		СвойствоОбъект.ТипЗначения = Новый ОписаниеТипов ("СправочникСсылка.ЗначенияСвойствОбъектов");
		СвойствоОбъект.Записать();
		НайденноеСвойство = СвойствоОбъект.Ссылка;
	КонецЕсли;
	
	ЗначениеСвойстваСсылка = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию(ЗначениеСвойства,Истина,,НайденноеСвойство);
	Если НЕ ЗначениеЗаполнено(ЗначениеСвойстваСсылка) Тогда
		Если СокрЛП(ЗначениеСвойства) = "" Тогда
			ЗначениеСвойстваСсылка = Справочники.ЗначенияСвойствОбъектов.ПустаяСсылка();
		Иначе
			ЗначениеСвойстваОбъект = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
			ЗначениеСвойстваОбъект.Наименование = ЗначениеСвойства;
			ЗначениеСвойстваОбъект.Владелец = НайденноеСвойство;
			ЗначениеСвойстваОбъект.Записать();
	    	ЗначениеСвойстваСсылка = ЗначениеСвойстваОбъект.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	МЗ = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьМенеджерЗаписи();
	МЗ.Объект = НомСсылка;
	МЗ.Свойство = НайденноеСвойство;
	МЗ.Прочитать();
	
	Если НЕ МЗ.Значение = ЗначениеСвойстваСсылка Тогда
		МЗ.Объект = НомСсылка;
		МЗ.Свойство = НайденноеСвойство;
		МЗ.Значение = ЗначениеСвойстваСсылка;
		МЗ.Записать(Истина);
	КонецЕсли;
КонецПроцедуры

//ФинЛайт добавление функциональности big_ooo [13.02.2017]
Процедура ЗагрузитьЦеныНоменклатуры() Экспорт
	
	НастройкиПодключений = СхемаОбмена.НастройкаПодключения;
	//СхемаОбмена = Подразделение.сви_СхемаОбменаССайтом;
	
	ИмяРеквизитаИдентификатора = СокрЛП(СхемаОбмена.РеквизитИдентификацииНоменклатуры);
	
	тТовары = ПолучитьНоменклатуруССайта(Истина);
	
	Если тТовары = Неопределено Тогда
		Возврат;
	КонецЕсли;
	//ВременнаяГруппа = Справочники.Номенклатура.НайтиПоКоду("00000011066");
	
	КвоНовых = 0;
	НовДокПрайс = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	НовДокПрайс.Дата = ТекущаяДата();
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(НовДокПрайс, глЗначениеПеременной("глТекущийПользователь"));
	//добавим наши типы цен
	НовСтр = НовДокПрайс.ТипыЦен.Добавить();
	НовСтр.ТипЦен = СхемаОбмена.ТипЦеныПрайс;
	//
	НовДокСтарая = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	НовДокСтарая.Дата = ТекущаяДата();
	ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(НовДокСтарая, глЗначениеПеременной("глТекущийПользователь"));
	НовДокСтарая.НеПроводитьНулевыеЗначения = Истина;
	//
	НовСтр = НовДокСтарая.ТипыЦен.Добавить();
	НовСтр.ТипЦен = СхемаОбмена.ТипЦеныСтарая;
	
	Для Каждого Стр ИЗ тТовары Цикл
		Товар = НайтиЭлементСПР("Номенклатура",ИмяРеквизитаИдентификатора,Стр.ИД);
		ВалютаСайт = стр.Валюта;
		Если валютаСайт = "UAH" Тогда
			Валюта = НовДокПрайс.мВалютаРегламентированногоУчета;
		Иначе
			Валюта = Справочники.Валюты.НайтиПоРеквизиту("КодВебСинхронизации", валютаСайт);
			Если Не ЗначениеЗаполнено(Валюта) Тогда
				Валюта = НайтиВСпрПоНаим("Валюты",валютаСайт);
			КонецЕсли;
		КонецЕсли;
		Данные = Новый Структура;
		Данные.Вставить("Номенклатура",Товар);
		Данные.Вставить("ЕдиницаИзмерения",Товар.ЕдиницаХраненияОстатков);
		Данные.Вставить("Валюта",Валюта);
		//
		Данные.Вставить("Цена",Стр.Цена);
		Данные.Вставить("ТипЦен",СхемаОбмена.ТипЦеныПрайс);
		ДобавитьНоменклатуруТабличнуюЧастьОценки(НовДокПрайс,Данные);
		//
		Данные.Вставить("Цена",Стр.ЦенаСтарая);
		Данные.Вставить("ТипЦен",СхемаОбмена.ТипЦеныСтарая);
		ДобавитьНоменклатуруТабличнуюЧастьОценки(НовДокСтарая,Данные);
		
		//ОбработкаПрерыванияПользователя();
	КонецЦикла;
	НовДокПрайс.Записать();
	Сообщить("Создан документ "+НовДокПрайс.Ссылка);
	Попытка
		НовДокПрайс.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
	    Сообщить(НСтр("ru = '"+ОписаниеОшибки()+"'"), СтатусСообщения.Внимание);
	КонецПопытки;
	НовДокСтарая.Записать();
	Сообщить("Создан документ "+НовДокСтарая.Ссылка);
	Попытка
		НовДокСтарая.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
	    Сообщить(НСтр("ru = '"+ОписаниеОшибки()+"'"), СтатусСообщения.Внимание);
	КонецПопытки;
КонецПроцедуры
// } ФинЛайт big_ooo [13.02.2017]

Процедура ДобавитьНоменклатуруТабличнуюЧастьОценки(НовДок,Данные)
	НовСтр = НовДок.Товары.Добавить();
	ЗаполнитьЗначенияСвойств(НовСтр,Данные);
КонецПроцедуры
                                                      
Процедура ЗагрузкаКонтрагентов(Обновить=Ложь) Экспорт
	
	КодЯзыка = ?(ЗначениеЗаполнено(СхемаОбмена.КодЯзыка),СхемаОбмена.КодЯзыка,"ru");
	
	НастройкиПодключений = СхемаОбмена.НастройкаПодключения;
	//СхемаОбмена = 	Подразделение.сви_СхемаОбменаССайтом;
	ТокенРез = мпи_Доработки.ПолучитьТокен_Хорошоп(НастройкиПодключений); 
	
	Если ТокенРез.Статус = "OK" Тогда
		ТокенСтр = ТокенРез.Токен; 
	Иначе
		Сообщить(ТокенРез.Сообщение);
		Возврат;
	КонецЕсли;
	
		
	ПараметрыПОСТ = "token=#token#";
	ПараметрыПОСТ = СтрЗаменить(ПараметрыПОСТ,"#token#",ТокенСтр);
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Language", "ru");
	Заголовки.Вставить("Accept-Charset",  "UTF-8");
	Заголовки.Вставить("Content-Language","ru");
	Заголовки.Вставить("Content-Charset", "UTF-8");
	//Заголовки.Вставить("Content-Type","application/json");
	Заголовки.Вставить("Content-Type",    "application/x-www-form-urlencoded; charset=UTF-8");
	
	АдресСкриптаЗагрузкаКонтрагентов = "/"+НастройкиПодключений.АдресСкриптаЗагрузкаКонтрагентов;
	
	Соединение = мпи_Доработки.СоздатьHTTPСоединение(НастройкиПодключений);
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресСкриптаЗагрузкаКонтрагентов,Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(ПараметрыПОСТ,"UTF-8",ИспользованиеByteOrderMark.НеИспользовать);
	//HTTPСоединение = Новый HTTPСоединение(Адрес); 
	//HTTPОтвет = HTTPСоединение.Получить(HTTPЗапрос);
	HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	
	ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
	
	
	_Текст = Новый ТекстовыйДокумент;
	_Текст.ДобавитьСтроку(ТекстОтвета);
	
	Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
		_Текст.Записать(СхемаОбмена.ПапкаФайлаЛога + "hs_in_users_answ.json");
	Иначе
		_Текст.Записать(ПолучитьИмяВременногоФайла("json"));
	КонецЕсли;
	
	// Нужно удалять глюкавые символосочетания, но не трогать их если есть двойной слеш
	
	_замена = "\f"; 
	
	Если Найти (ТекстОтвета,"\"+_замена) = 0 Тогда 
		ТекстОтвета = СтрЗаменить(ТекстОтвета,_замена,"");
	КонецЕсли;
	
	_замена = "\b"; 
	Если Найти(ТекстОтвета,"\"+_замена) = 0 Тогда 
		ТекстОтвета = СтрЗаменить(ТекстОтвета,_замена,"");
	КонецЕсли;
	
	_замена = "\t"; 
	Если Найти(ТекстОтвета,"\"+_замена) = 0 Тогда 
		ТекстОтвета = СтрЗаменить(ТекстОтвета,_замена,"");
	КонецЕсли;
	
	ЧтениеДЖС = Новый ЧтениеJSON;
	ЧтениеДЖС.УстановитьСтроку(ТекстОтвета);
	
	//Если Не ЗначениеЗаполнено(ТекстОтвета) Тогда
	//	Прервать;
	//КонецЕсли;	
	
	Строки = ПрочитатьJSON(ЧтениеДЖС);
	
	Если НЕ (Строки.status = "OK") Тогда
		Сообщить("Ошибка.");
		Возврат;
	КонецЕсли;
	
	мКонтрагенты = Строки.response.users;
	Для каждого текКонтрагент Из мКонтрагенты Цикл
 		//ищем контрагента по ид
		контр = НайтиЭлементСПР("Контрагенты","сви_КодВэбСинхронизации",текКонтрагент.id);
		Если ЗначениеЗаполнено(контр) Тогда //нашли
			Если НЕ Обновить Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СтруктураКонтрагента = Новый Структура;
		СтруктураКонтрагента.Вставить("Обновить",Обновить);
		СтруктураКонтрагента.Вставить("сви_КодВэбСинхронизации",текКонтрагент.id);
		СтруктураКонтрагента.Вставить("Наименование", СокрЛП(текКонтрагент.title));
		СтруктураКонтрагента.Вставить("НаименованиеПолное",СтруктураКонтрагента.Наименование);
		СтруктураКонтрагента.Вставить("Покупатель", Истина);
		СтруктураКонтрагента.Вставить("ЮрФизЛицо",Перечисления.ЮрФизЛицо.ФизЛицо);
		СтруктураКонтрагента.Вставить("Комментарий","Автоматически создан при импорте с сайта");
		СтруктураКонтрагента.Вставить("Родитель",СхемаОбмена.ГруппаКонтрагентов);
		//
		СтруктураКонтрагента.Вставить("Телефон", ОбработатьТелефон(текКонтрагент.phone));
		СтруктураКонтрагента.Вставить("Емейл", 	СокрЛП(текКонтрагент.email));
		СтруктураКонтрагента.Вставить("Город",  СокрЛП(текКонтрагент.city));
		СтруктураКонтрагента.Вставить("Адрес",  СокрЛП(текКонтрагент.address));
		
		ОбновитьКонтрагента(СтруктураКонтрагента,СхемаОбмена);
		
	КонецЦикла;
	
	
КонецПроцедуры

//ФинЛайт добавление функциональности big_ooo [06.02.2017]
Функция ОбновитьКонтрагента(СтруктураКонтрагента,СхемаОбмена)
	//Возврат;
	//ищем контрагента по ид
	контр = НайтиЭлементСПР("Контрагенты","сви_КодВэбСинхронизации",СтруктураКонтрагента.сви_КодВэбСинхронизации);
	Если Не ЗначениеЗаполнено(контр) Тогда //попрубуем найти по контактам
		Пар = Новый Структура;
		Пар.Вставить("Телефон",СтруктураКонтрагента.Телефон);
		Пар.Вставить("Емейл",СтруктураКонтрагента.Емейл);
		контр = НайтиКонтрагентаПоКонтактам(Пар);
	КонецЕсли;
	
	фСоздавать = Ложь;
	Если ЗначениеЗаполнено(контр) Тогда //нашли
		Если НЕ СтруктураКонтрагента.Обновить Тогда
			Возврат контр;
		КонецЕсли;
	Иначе
		фСоздавать =  Истина;
	КонецЕсли;
	
	Если фСоздавать Тогда
		спрКонтрОбъект = Справочники.Контрагенты.СоздатьЭлемент();
	Иначе
		спрКонтрОбъект = контр.ПолучитьОбъект();
	КонецЕсли;
	//заполняем свойства
	ЗаполнитьЗначенияСвойств(спрКонтрОбъект,СтруктураКонтрагента);
	спрКонтрОбъект.Записать();
	Если фСоздавать Тогда
		ДобавитьОсновнойДоговор(спрКонтрОбъект,СхемаОбмена);
	КонецЕсли;
	
	СпрКонтрагент = спрКонтрОбъект.Ссылка;
	
	// контактная информация
	Если ЗначениеЗаполнено(СтруктураКонтрагента.Телефон) Тогда
		НовКонтакт = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		НовКонтакт.Объект 	= СпрКонтрагент;
		НовКонтакт.Вид 		= Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		НовКонтакт.Тип		= Перечисления.ТипыКонтактнойИнформации.Телефон;
		НовКонтакт.Представление = СтруктураКонтрагента.Телефон;
		//
		НовКонтакт.Записать();
	КонецЕсли;
	Если ЗначениеЗаполнено(СтруктураКонтрагента.Емейл) Тогда
		НовКонтакт = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		НовКонтакт.Объект 	= СпрКонтрагент;
		НовКонтакт.Вид 		= Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами;
		НовКонтакт.Тип		= Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		НовКонтакт.Представление = СтруктураКонтрагента.Емейл;
		//
		НовКонтакт.Записать();
	КонецЕсли;
	//адрес
	Если ЗначениеЗаполнено(СтруктураКонтрагента.Адрес) или ЗначениеЗаполнено(СтруктураКонтрагента.Город) Тогда
		НовКонтакт = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		НовКонтакт.Объект 	= СпрКонтрагент;
		НовКонтакт.Вид 		= Справочники.ВидыКонтактнойИнформации.АдресДоставкиКонтрагента;
		НовКонтакт.Тип		= Перечисления.ТипыКонтактнойИнформации.Адрес;
		НовКонтакт.Поле4	= СтруктураКонтрагента.Город;
		Если СтруктураКонтрагента.Адрес <> СтруктураКонтрагента.Город Тогда
			НовКонтакт.Поле6	= СтруктураКонтрагента.Адрес;
		КонецЕсли;
		НовКонтакт.Представление = УправлениеКонтактнойИнформацией.ПолучитьПредставлениеАдреса(НовКонтакт);

		//
		НовКонтакт.Записать();
	КонецЕсли;
	
	Если фСоздавать Тогда
		Сообщить("Создана новый контрагент : "+СпрКонтрагент.Наименование+"("+СпрКонтрагент.Код+")");
	Иначе
		Сообщить("Обновлен контрагент : "+СпрКонтрагент.Наименование+"("+СпрКонтрагент.Код+")");
	КонецЕсли;
	
	Возврат СпрКонтрагент;
		
КонецФункции

