Функция НайтиЭлементСПР(ИмяСпр,ИмяРеквизитаИдентификатора,ИД) Экспорт
	Если ИмяРеквизитаИдентификатора = "Штрихкод" Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Штрихкоды.Владелец КАК Ссылка
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Штрихкод = &ИД
		|	И Штрихкоды.Владелец ССЫЛКА Справочник.Номенклатура";
	Иначе	
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	спр.Ссылка
		|ИЗ
		|	Справочник.#ИмяСпр# КАК спр
		|ГДЕ
		|	спр.ЭтоГруппа = Ложь
		|	И спр.#ИмяРеквизита# = &ИД"
		;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#ИмяРеквизита#",ИмяРеквизитаИдентификатора);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"#ИмяСпр#",ИмяСпр);
		
		Если НЕ Метаданные.Справочники[ИмяСпр].Иерархический Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "спр.ЭтоГруппа = Ложь", "Истина");
		КонецЕсли;	
	КонецЕсли;
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ИД",ИД);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Возврат Выборка.Ссылка;
	КонецЦикла;	
	Возврат Неопределено;
КонецФункции

//ФинЛайт добавление функциональности big_ooo [18.01.2017]
Функция НайтиКонтрагентаПоКонтактам(Пар) Экспорт
	
	Рез = Справочники.Контрагенты.ПустаяСсылка();
	
	СпКонтакты = Новый СписокЗначений;
	
	Телефон = "";
	Если Пар.Свойство("Телефон",Телефон) Тогда
		Если ЗначениеЗаполнено(Телефон) Тогда
//			Телефон = ВзаимодействияКлиентСервер.ОбработатьТелефон(Телефон);
			СпКонтакты.Добавить(Телефон);
		КонецЕсли;
	КонецЕсли;
	
	Емейл = "";
	Если Пар.Свойство("Емейл",Емейл) Тогда
		Если ЗначениеЗаполнено(Емейл) Тогда
			СпКонтакты.Добавить(Емейл);
		КонецЕсли;
	КонецЕсли;
	
	Если СпКонтакты.Количество() = 0 Тогда Возврат Рез; КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	КонтактыКонтрагентов.Объект,
	               |	КонтактыКонтрагентов.Представление
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КонтактыКонтрагентов
	               |ГДЕ
	               |	ВЫРАЗИТЬ(КонтактыКонтрагентов.Представление КАК СТРОКА(200)) В (&Информация)
	               |	И КонтактыКонтрагентов.Объект.ПометкаУдаления = ЛОЖЬ"
	               ;
	//
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Информация",СпКонтакты);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ТипЗнч(Выборка.Объект) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			Возврат Выборка.Объект;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции

//ФинЛайт добавление функциональности big_ooo [18.01.2017]
Процедура ДобавитьОсновнойДоговор(спрКонтрагентОб,СхемаОбмена)
	// Создадим Основной Договор, ВидыВзаиморасчетов - ПоСделкам (УТ), Владелец - Контрагент
	Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Договор.Владелец 				= спрКонтрагентОб.Ссылка;
	Договор.Наименование 			= НСтр("ru='Основной договор';uk='Основний договір'");
	// валюта принимаем равной валюте счета, к-ый указан при импорте
	Договор.ВалютаВзаиморасчетов 	= Константы.ВалютаРегламентированногоУчета.Получить();
		
	ВидДоговора 					= Перечисления.ВидыДоговоровКонтрагентов.СПокупателем; 
	
	Договор.ВидДоговора 			= ВидДоговора;
	
	//+БП: d.matyash (23.10.2024) <>
	Договор.БП_ТипДоговора 			= Справочники.БП_ТипыДоговоровКонтрагентов.Стандартный;	
	//-БП: d.matyash (23.10.2024) <>

	//Договор.Номер					= СтруктураЗаполнения.Номер;
	//Договор.Дата					= СтруктураЗаполнения.Дата;
	
	Договор.ВедениеВзаиморасчетов 	= Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоЗаказам;
	
	Договор.СхемаНалоговогоУчета    = Справочники.СхемыНалоговогоУчетаПоДоговорамКонтрагентов.ПоПервомуСобытию;

	Договор.Организация 			= СхемаОбмена.Организация; //УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "ОсновнаяОрганизация");

	Договор.Комментарий = НСтр("ru='Автоматически создан при импорте с сайта';uk='Автоматично створений при імпорті із сайта'");
	Договор.Записать();
	
	// в созданном Контрагенте, дополним поле "ОсновнойДоговорКонтрагента"
	спрКонтрагентОб.ОсновнойДоговорКонтрагента 		= Договор.Ссылка;
	спрКонтрагентОб.Записать();	
КонецПроцедуры


Процедура ЗагрузкаИУстановкаКатегорийНоменклатуры() Экспорт
	
	Если СхемаОбмена.ХранениеКатегорийСайта <> Перечисления.сви_ВидыХраненияКатегорийСайта.КатегорииНоменклатуры Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиПодключений = СхемаОбмена.НастройкаПодключения;
	
	ИмяРеквизитаИдентификатора = СокрЛП(СхемаОбмена.РеквизитИдентификацииНоменклатуры);
	
	тТовары = ПолучитьНоменклатуруССайта(Истина);
	
	Если тТовары = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КвоНовых = 0;
	
	ВидКатегорий = СхемаОбмена.ВидКатегорийНоменклатуры;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	мпи_КатегорииНоменклатуры.КодВэбСинхронизации,
	|	мпи_КатегорииНоменклатуры.Ссылка
	|ИЗ
	|	Справочник.мпи_КатегорииНоменклатуры КАК мпи_КатегорииНоменклатуры
	|ГДЕ
	|	мпи_КатегорииНоменклатуры.Владелец = &Владелец
	|	И мпи_КатегорииНоменклатуры.КодВэбСинхронизации <> """"";
	Запрос.УстановитьПараметр("Владелец", ВидКатегорий);
	ТаблКатегорий = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Стр ИЗ тТовары Цикл
		Товар = НайтиЭлементСПР("Номенклатура",ИмяРеквизитаИдентификатора,Стр.ИД);
		Если НЕ  ЗначениеЗаполнено(Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.КодРодителя) Тогда
			СтрокаТаблКатегорий = ТаблКатегорий.Найти(Стр.КодРодителя, "КодВэбСинхронизации");
			Если СтрокаТаблКатегорий <> Неопределено Тогда
					//Проверим. Если Есть несколько категорий, то надо для первой основную установить
					НЗ = РегистрыСведений.мпи_ЗначенияКатегорийНоменклатуры.СоздатьНаборЗаписей();
					НЗ.Отбор.НоменклатураОбъект.Установить(СтрокаТаблКатегорий.Ссылка);
					НЗ.Прочитать();
					Если НЗ.Количество() Тогда
						Основная = Ложь;
					Иначе
						Основная = Истина;
					КонецЕсли;	
				
				МЗ = РегистрыСведений.мпи_ЗначенияКатегорийНоменклатуры.СоздатьМенеджерЗаписи();
				МЗ.НоменклатураОбъект = Товар;
				МЗ.ВидКатегории = ВидКатегорий;
				МЗ.Значение = СтрокаТаблКатегорий.Ссылка;
				МЗ.Основная = Основная;
				МЗ.Записать();
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры



