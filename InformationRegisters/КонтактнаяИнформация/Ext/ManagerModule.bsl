Функция ПолучитьДляТерминала(Запрос, НомерТелефона, TransactionId,ReceiptNumber, QueryType = "check") Экспорт  
	
	ResultCode = "21";
	ResultStatus = "Error";
	ResultMessage = "Заказы не найдены";
	OrdersCount = 0;
	OrdersXML = "";
	
	Попытка
		
		Если QueryType = "check" Тогда
			
			Заказы = Документы.ЗаказПокупателя.ПолучитьЗаказыДляОплатыТерминалом(НомерТелефона);
			
			Если Заказы <> Неопределено И Заказы.Количество() > 0 Тогда
				
				ResultCode = "0";
				ResultStatus = "Success";
				ResultMessage = "";
				OrdersCount = Заказы.Количество();
				
				OrdersXML = "<Orders>";
				
				Для Каждого СтрЗаказ Из Заказы Цикл
					OrdersXML = OrdersXML 
						+ Документы.ЗаказПокупателя.ПолучитьОтветПоЗакамДляОплатыВТерминале(СтрЗаказ, НомерТелефона);
				КонецЦикла;
				
				OrdersXML = OrdersXML + "</Orders>";
				
			КонецЕсли;
			
		ИначеЕсли QueryType = "pay" Тогда

			OrderId         = Запрос.ПараметрыЗапроса.Получить("OrderId");
			Amount          = Запрос.ПараметрыЗапроса.Получить("Amount");
			CharityAmount   = Запрос.ПараметрыЗапроса.Получить("CharityAmount");
			CharityCashCode = Запрос.ПараметрыЗапроса.Получить("CharityCashCode");
			CharityCashFlow = Запрос.ПараметрыЗапроса.Получить("CharityCashFlow");
			AdvanceAmount   = Запрос.ПараметрыЗапроса.Получить("AdvanceAmount");

			Если ПустаяСтрока(OrderId) Тогда

				ResultCode = "21";
				ResultStatus = "Error";
				ResultMessage = "Не передан OrderId";

			ИначеЕсли ПустаяСтрока(Amount) Тогда

				ResultCode = "21";
				ResultStatus = "Error";
				ResultMessage = "Не передана сумма оплаты";

			Иначе

				OrderGUID = Новый УникальныйИдентификатор(OrderId);
				ЗаказСсылка = Документы.ЗаказПокупателя.ПолучитьСсылку(OrderGUID);

				Если ЗаказСсылка = Неопределено Или ЗаказСсылка.Пустая() Тогда

					ResultCode = "21";
					ResultStatus = "Error";
					ResultMessage = "Заказ не найден";

				Иначе

					// проверка суммы
					СуммаОплаты = Число(СтрЗаменить(Amount, ".", ","));

					СуммаБлаготворительности = 0;
					Если Не ПустаяСтрока(CharityAmount) Тогда
						СуммаБлаготворительности = Число(СтрЗаменить(CharityAmount, ".", ","));
					КонецЕсли;

					СуммаАванса = 0;
					Если Не ПустаяСтрока(AdvanceAmount) Тогда
						СуммаАванса = Число(СтрЗаменить(AdvanceAmount, ".", ","));
					КонецЕсли;

					Если СуммаОплаты <= 0 Тогда

						ResultCode = "241";
						ResultStatus = "Error";
						ResultMessage = "Некорректная сумма оплаты";

					ИначеЕсли СуммаБлаготворительности > 0 И ПустаяСтрока(CharityCashCode) Тогда

						// Не создаем взнос "куда-нибудь": деньги физически в терминале,
						// и без кассы фонда они потерялись бы в учете молча.
						ResultCode = "21";
						ResultStatus = "Error";
						ResultMessage = "Передана сумма благотворительности без кода кассы фонда (CharityCashCode)";

					Иначе

						Комментарий =
						"Оплата через терминал. "
						+ Документы.ПриходныйКассовыйОрдер.МаркерТранзакцииТерминала(TransactionId)
						+ " ReceiptNumber: " + Строка(ReceiptNumber)
						+ "; OrderId: " + Строка(OrderId)
						+ "; Account: " + Строка(НомерТелефона);

						// Дедуп раздельный по видам операции: на одну транзакцию приходится
						// до двух ордеров, и повтор запроса должен дописать недостающий,
						// а не отбросить весь запрос как дубль.
						ПКООплаты = Документы.ПриходныйКассовыйОрдер.НайтиПКОПоТранзакцииТерминала(
							TransactionId, Перечисления.ВидыОперацийПКО.ОплатаПокупателя);

						Если ПКООплаты <> Неопределено Тогда

							ResultCode = "0";
							ResultStatus = "Success";
							ResultMessage = "Платеж уже был принят ранее";

						Иначе

							ПКО = Документы.ПриходныйКассовыйОрдер.СоздатьПКО(ЗаказСсылка, СуммаОплаты, Комментарий, "Г00000031", Ложь);

							Попытка
								// Аванс идет второй строкой того же ордера: контрагент и договор
								// те же, что у оплаты, отдельный документ был бы лишним.
								Документы.ПриходныйКассовыйОрдер.ДобавитьАвансВПКО(ПКО, ЗаказСсылка, СуммаАванса);

								ПКО.Записать(РежимЗаписиДокумента.Проведение);

								ResultCode = "0";
								ResultStatus = "Success";
								ResultMessage = "Платеж принят";

							Исключение

								ResultCode = "2";
								ResultStatus = "Error";
								ResultMessage = "Ошибка создания оплаты: " + ОписаниеОшибки();

							КонецПопытки;

						КонецЕсли;

						// Благотворительный взнос - отдельный ордер в кассу фонда.
						// Делается и тогда, когда оплата уже была принята: повтор запроса
						// от терминала должен дописать взнос, если в прошлый раз он не прошел.
						Если ResultStatus = "Success" И СуммаБлаготворительности > 0 Тогда

							ПКОВзноса = Документы.ПриходныйКассовыйОрдер.НайтиПКОПоТранзакцииТерминала(
								TransactionId, Перечисления.ВидыОперацийПКО.ПриходДенежныхСредствПрочее);

							Если ПКОВзноса = Неопределено Тогда

								Попытка

									ПКОБлаго = Документы.ПриходныйКассовыйОрдер.СоздатьПКОБлаготворительность(
										ЗаказСсылка,
										СуммаБлаготворительности,
										"Благодійний внесок. " + Комментарий,
										CharityCashCode,
										CharityCashFlow,
										Ложь);

									ПКОБлаго.Записать(РежимЗаписиДокумента.Проведение);

								Исключение

									// Оплата заказа при этом остается проведенной - терминалу
									// возвращается ошибка, и повтор допишет только взнос.
									ResultCode = "2";
									ResultStatus = "Error";
									ResultMessage = "Оплата принята, но не создан благотворительный взнос: " + ОписаниеОшибки();

								КонецПопытки;

							КонецЕсли;

						КонецЕсли;

					КонецЕсли;

				КонецЕсли;

			КонецЕсли;
		Иначе
			
			ResultCode = "299";
			ResultStatus = "Error";
			ResultMessage = "Неподдерживаемый QueryType";
			
		КонецЕсли;
		
	Исключение
		
		ResultCode = "2";
		ResultStatus = "Error";
		ResultMessage = ОписаниеОшибки();
		OrdersCount = 0;
		OrdersXML = "";
		
	КонецПопытки;
	
	XML = 
	"<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС +
	"<Response>" +
	"<TransactionId>" + XMLСтрока(TransactionId) + "</TransactionId>" +
	"<ResultCode>" + XMLСтрока(ResultCode) + "</ResultCode>" +
	"<ResultStatus>" + XMLСтрока(ResultStatus) + "</ResultStatus>" +
	"<ResultMessage>" + XMLСтрока(ResultMessage) + "</ResultMessage>" +
	"<OrdersCount>" + XMLСтрока(Строка(OrdersCount)) + "</OrdersCount>" +
	OrdersXML +
	"<Comment></Comment>" +
	"</Response>";
	
	Возврат XML;
	
КонецФункции 
