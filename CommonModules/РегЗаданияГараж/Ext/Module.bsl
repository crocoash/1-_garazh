 Функция СкачатьExcelНаСервер(СсылкаНаФайл) Экспорт
     
    // Создаем объект WinHttpRequest
    WinHttp = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");

    // Открываем соединение
    WinHttp.Open("GET", СсылкаНаФайл, Ложь);

    // Отправляем запрос
    WinHttp.Send();

    // Проверяем статус
    Если WinHttp.Status = 200 Тогда
        // Создаем поток для записи файла
        Поток = Новый COMОбъект("ADODB.Stream");
        
        // Тип потока - бинарный (1)
        Поток.Type = 1;
        // Режим - чтение/запись (3)
        Поток.Mode = 3;

        Поток.Open();
        // Записываем полученные данные
        Поток.Write(WinHttp.ResponseBody);    
		
		//ИмяВременногоФайла = "c:\temp\Tayer6.xls";  

		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xls");  
		
		// Сохраняем файл на сервере
        Поток.SaveToFile(ИмяВременногоФайла, 2); // 2 = перезаписать если есть
        Поток.Close();
        Поток = Неопределено;
    Иначе
        Сообщить("Ошибка HTTP: " + Строка(WinHttp.Status) + " " + WinHttp.StatusText);
        Возврат Неопределено;
    КонецЕсли;
   Возврат ИмяВременногоФайла; 
	
КонецФункции


Процедура ЗапуститьУдалениеУстановокЦенПакетами()

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =  
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УстановкаЦенНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
	|ГДЕ
	|	 УстановкаЦенНоменклатуры.Дата <= &ДатаГраница
	|
	|УПОРЯДОЧИТЬ ПО
	|	УстановкаЦенНоменклатуры.Дата";

	Запрос.УстановитьПараметр("ДатаГраница", ТекущаяДата() - 3 * 60 * 60 * 12);

	Выборка = Запрос.Выполнить().Выбрать();

	ВсегоВыбрано = 0;
	ВсегоУдалено = 0;

	Пока Выборка.Следующий() Цикл

		ВсегоВыбрано = ВсегоВыбрано + 1;

		Попытка
			
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокОбъект.Удалить();

			ВсегоУдалено = ВсегоУдалено + 1;

		Исключение
			
			ЗаписьЖурналаРегистрации(
				"УдалениеУстановокЦен",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Выборка.Ссылка,
				"Ошибка удаления документа: " + ОписаниеОшибки()
			);
			
		КонецПопытки;

	КонецЦикла;

	ЗаписьЖурналаРегистрации(
		"УдалениеУстановокЦен",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Удаление завершено. Выбрано: " + Строка(ВсегоВыбрано) 
		+ ", удалено: " + Строка(ВсегоУдалено)
	);

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

