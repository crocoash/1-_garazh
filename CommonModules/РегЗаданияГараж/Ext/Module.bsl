Функция НайтиСтрануДатуПроизводства(Номенклатура) 
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ДатаПроизводства","");
	СтруктураВозврата.Вставить("Страна","");
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ДатыПроизводстваСрезПоследних.Номенклатура,
	                      |	ДатыПроизводстваСрезПоследних.ДатаПроизводства,
	                      |	ДатыПроизводстваСрезПоследних.Страна
	                      |ИЗ
	                      |	РегистрСведений.ДатыПроизводства.СрезПоследних(
	                      |			&ТекДата,
	                      |			Номенклатура = &Номенклатура
	                      |				И Документ ССЫЛКА Документ.ПоступлениеТоваровУслуг) КАК ДатыПроизводстваСрезПоследних
	                      |ГДЕ
	                      |	(ДатыПроизводстваСрезПоследних.ДатаПроизводства <> """"
	                      |			ИЛИ ДатыПроизводстваСрезПоследних.Страна <> """")
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДатыПроизводстваСрезПоследних.Период УБЫВ"); 
	Запрос.УстановитьПараметр("ТекДата", ТекущаяДата());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() цикл
		СтруктураВозврата.ДатаПроизводства = Выборка.ДатаПроизводства; 
		СтруктураВозврата.Страна = Выборка.Страна; 
	КонецЦикла; 
	
	Возврат СтруктураВозврата; 
	   	
