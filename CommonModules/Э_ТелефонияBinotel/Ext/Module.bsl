Функция Э_ПоследнийПредЗаказПоКонтакту(ТекКонтрагент,Э_Лид=Неопределено) Экспорт
   Перем ЕстьОтборПоКонтрагенту,ЕстьОтборПоЭ_Лид,Запрос,Результат;	
   
   ЕстьОтборПоКонтрагенту                  =?(ЗначениеЗаполнено(ТекКонтрагент),Истина,Ложь);
   ЕстьОтборПоЭ_Лид=?(ЗначениеЗаполнено(Э_Лид),Истина,Ложь);	
   
   Если ЕстьОтборПоКонтрагенту или ЕстьОтборПоЭ_Лид Тогда
		 
	   Запрос=Новый Запрос;
	   Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                |	ПредЗаказ.Ссылка
	                |ИЗ
	                |	Документ.ПредЗаказ КАК ПредЗаказ
	                |ГДЕ
	                |	НЕ ПредЗаказ.ПометкаУдаления
	                |	И ВЫБОР
	                |			КОГДА &ЕстьОтборПоКонтрагенту
	                |				ТОГДА ПредЗаказ.Контрагент = &Контрагент
	                |			ИНАЧЕ ИСТИНА
	                |		КОНЕЦ";
					Если ЕстьОтборПоЭ_Лид Тогда
					    Запрос.Текст=Запрос.Текст+"
		                |	И ВЫБОР
		                |			КОГДА &ЕстьОтборПоЭ_Лид
		                |				ТОГДА ПредЗаказ.Э_Лид = &Э_Лид
		                |			ИНАЧЕ ИСТИНА
		                |		КОНЕЦ";
					КонецЕсли; 
				    Запрос.Текст=Запрос.Текст+"
	                |
	                |УПОРЯДОЧИТЬ ПО 
					|	ПредЗаказ.Дата УБЫВ";
					
					
	    //Запрос.УстановитьПараметр("ДатаНачало",НачалоМесяца(НачПериода));									
		Запрос.УстановитьПараметр("ЕстьОтборПоКонтрагенту",ЕстьОтборПоКонтрагенту);			
