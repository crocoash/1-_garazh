	|ИЗ
	|	РегистрСведений.Э_ТелефонияКодыКлиентов КАК ТелефонияКодыКлиентов
	|ГДЕ
	|	ТелефонияКодыКлиентов.ТелефонияКод = &CustomerID";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ТекКонтакт = Выборка.Контакт;
		
