Функция ДоступностьКнопкиПрослушиванияСохраненияЗаписиЗвонка(СтрокаИзСпискаСобытий = Неопределено, СсылкаСобытие = Неопределено) Экспорт
	
	ТекПользователь = ОбщегоНазначения.ПолучитьЗначениеПеременной("глТекущийПользователь");
	
	Доступность = Ложь;
	ЕстьСсылкаНаЗапись = Ложь;
	
	//Определим есть ли ссылка на запись
	Если СтрокаИзСпискаСобытий <> Неопределено 
		И ТипЗнч(СтрокаИзСпискаСобытий.Ссылка) = Тип("ДокументСсылка.Событие") 
		И ЗначениеЗаполнено(СтрокаИзСпискаСобытий.Ссылка.Э_CallIDЗвонкаBinotel) Тогда
				
		ЕстьСсылкаНаЗапись = Истина;
	ИначеЕсли СсылкаСобытие <> Неопределено 
		И ТипЗнч(СсылкаСобытие) = Тип("ДокументСсылка.Событие") 
		И ЗначениеЗаполнено(СсылкаСобытие.Э_CallIDЗвонкаBinotel) Тогда
		
		ЕстьСсылкаНаЗапись = Истина;
	КонецЕсли;	
	
	Если ЕстьСсылкаНаЗапись
		И (РольДоступна("ПолныеПрава") Или РольДоступна("Э_BinotelПрослушиватьЗаписиЧужихЗвонков")) Тогда
		Доступность = Истина;
	ИначеЕсли СтрокаИзСпискаСобытий <> Неопределено 
		И ТипЗнч(СтрокаИзСпискаСобытий.Ссылка) = Тип("ДокументСсылка.Событие") 
		И ТекПользователь = СтрокаИзСпискаСобытий.Ссылка.Ответственный
		И ЕстьСсылкаНаЗапись Тогда
		
		Доступность = Истина;
	ИначеЕсли СсылкаСобытие <> Неопределено 
		И ТипЗнч(СсылкаСобытие) = Тип("ДокументСсылка.Событие") 
		И ТекПользователь = СсылкаСобытие.Ответственный 
		И ЕстьСсылкаНаЗапись Тогда
		
		Доступность = Истина;
	КонецЕсли;	
	
	Возврат Доступность;
КонецФункции
//Э_Волощук)

