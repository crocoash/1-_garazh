Функция Э_СписокТелефоновПользователя(Пользователь) Экспорт 
	Перем ДлинаВнутреннегоНомераТелефона,Запрос,Выборка,СписокВнутреннихТелефонов,ТекНомер;
	
	Э_НастройкиБинотел=Э_ПолучитьНастройкиБинотел();
	Если Э_НастройкиБинотел=Неопределено Тогда
	    Э_BinotelДлинаВнутреннегоНомераТелефона = 3;
	иначе	
	    Э_BinotelДлинаВнутреннегоНомераТелефона = Э_НастройкиБинотел.Э_BinotelДлинаВнутреннегоНомераТелефона;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТипКонтактнойИнформации", Перечисления.ТипыКонтактнойИнформации.Телефон);
	//Э_NCT(20.02.2019 16:38:38 www.nct.ua 
	//Запрос.УстановитьПараметр("ВидКонтактнойИнформации", Э_НастройкиБинотел.Э_BinotelВнутреннийТелефонПользователяВид);
	//Э_NCT) 
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.CRM_НомерТелефона КАК НомерТелефона
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Пользователь
	|	И КонтактнаяИнформация.Тип = &ТипКонтактнойИнформации";
	//|	И КонтактнаяИнформация.Вид = &ВидКонтактнойИнформации";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СписокВнутреннихТелефонов=Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		ТекНомер = СокрЛП(Выборка.НомерТелефона);
		Если СтрДлина(ТекНомер) = Э_BinotelДлинаВнутреннегоНомераТелефона Тогда
			 СписокВнутреннихТелефонов.Добавить(СокрЛП(ТекНомер));
		КонецЕсли;
	КонецЦикла;;
	
	Возврат СписокВнутреннихТелефонов;
КонецФункции	
 
Функция Э_ПредставлениеРазницыВремени(ДатаВремяНачало,ДатаВремяОкончания) Экспорт
	ВремяВыполнения = ДатаВремяОкончания - ДатаВремяНачало;
	Часов = Цел(ВремяВыполнения/3600);
	Минут = Цел((ВремяВыполнения-Часов*3600)/60);
	Секунд = ВремяВыполнения - Часов*3600 - Минут*60;
	Возврат "" + ?(Часов = 0, "", Формат(Часов, "ЧЦ=2; ЧДЦ=0; ЧВН=")+ ":") + ?(Минут = 0, "00", Формат(Минут, "ЧЦ=2; ЧДЦ=0; ЧВН=")) + ":" + ?(Секунд = 0, "00", Формат(Секунд, "ЧЦ=2; ЧВН="));
КонецФункции 

Функция Э_ПолучитьДатуПоследнегоЗавершенногоЗвонка(Входящий=Ложь)
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Событие.Дата КАК Дата
	               |ИЗ
	               |	Документ.Событие КАК Событие
	               |ГДЕ
	               |	НЕ Событие.ПометкаУдаления
				   |	И Событие.ВидСобытия = &ВидСобытия
	               |	И Событие.ТипСобытия = &ТипСобытия
	               |	И Событие.Э_CallIDЗвонкаBinotel > """"
	               |	И Событие.СостояниеСобытия = &СостояниеСобытия
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ";
	Запрос.УстановитьПараметр("ВидСобытия",Перечисления.ВидыСобытий.ТелефонныйЗвонок);
	Запрос.УстановитьПараметр("ТипСобытия",?(Входящий,Перечисления.ВходящееИсходящееСобытие.Входящее,Перечисления.ВходящееИсходящееСобытие.Исходящее));
	Запрос.УстановитьПараметр("СостояниеСобытия",Перечисления.СостоянияСобытий.Завершено);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		 Возврат Выборка.Дата;
	КонецЕсли;
	Возврат неопределено; 
КонецФункции

