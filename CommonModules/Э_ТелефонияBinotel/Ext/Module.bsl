// Функция преобразовывает номер телефона (без разделителей)
//
Функция Э_ТолькоЦифрыТелефона(НомерТелефона)
	Перем ТолькоЦифрыНомера;
	
	ТолькоЦифрыНомера="";
	Для а=1 По СтрДлина(НомерТелефона) Цикл
		Если СтрЧислоВхождений("1234567890",Сред(НомерТелефона,а,1)) > 0 Тогда
			ТолькоЦифрыНомера = ТолькоЦифрыНомера + Сред(НомерТелефона,а,1);
		иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ТолькоЦифрыНомера;
КонецФункции	

// Функция преобразовывает номер телефона (без разделителей)
//
Функция Э_ПреобразоватьНомерТелефонаБезРазделителей(Знач НомерТелефона) Экспорт
	Если НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
		Возврат "";
	КонецЕсли;
	
	Если СтрДлина(НомерТелефона) < 5 Тогда
		Возврат СокрЛП(НомерТелефона);
	КонецЕсли;
	
	ПозицияЗапятой = Найти(НомерТелефона, ",");
	Если ПозицияЗапятой > 0 Тогда
		НомерТелефона = Лев(НомерТелефона, ПозицияЗапятой-1);
	КонецЕсли;	
	НомерТелефона = СтрЗаменить(НомерТелефона, Символы.НПП, "");
	НомерТелефона = СтрЗаменить(НомерТелефона, "+38", "");
	НомерТелефона = СтрЗаменить(НомерТелефона, "+3", "");
	НомерТелефона = СтрЗаменить(НомерТелефона, " ", "");
	НомерТелефона = СтрЗаменить(НомерТелефона, "(", "");
	НомерТелефона = СтрЗаменить(НомерТелефона, ")", "");
	НомерТелефона = СтрЗаменить(НомерТелефона, "-", "");
	НомерТелефона = СтрЗаменить(НомерТелефона, "+", "");
	ДлинаНомера = СтрДлина(НомерТелефона);
	Если Лев(НомерТелефона, 2) = "38" И ДлинаНомера = 12 Тогда
		НомерТелефона = Прав(НомерТелефона, ДлинаНомера-2);
	КонецЕсли;
	НомерТелефона = СокрЛП(НомерТелефона);
	
	НомерТелефона=Э_ТолькоЦифрыТелефона(НомерТелефона);
	
	Возврат НомерТелефона;
КонецФункции	

