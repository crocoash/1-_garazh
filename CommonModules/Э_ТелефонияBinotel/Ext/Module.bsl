Функция Э_ЗаписатьIDКлиентаВСистемеБинотел(CustomerID, Numbers=Неопределено, Клиент=Неопределено) Экспорт 
	Если ЗначениеЗаполнено(CustomerID) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("CustomerID", CustomerID);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Э_ТелефонияКодыКлиентов.Контакт.Ссылка
		|ИЗ
		|	РегистрСведений.Э_ТелефонияКодыКлиентов КАК Э_ТелефонияКодыКлиентов
		|ГДЕ
		|	Э_ТелефонияКодыКлиентов.ТелефонияКод = &CustomerID";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Клиент) Тогда
		НаборЗаписей = РегистрыСведений.Э_ТелефонияКодыКлиентов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Контакт.Установить(Клиент);
		Если ЗначениеЗаполнено(CustomerID) Тогда
			
			 НовЗапись = НаборЗаписей.Добавить();
			 НовЗапись.Контакт =  Клиент;
			 НовЗапись.ТелефонияКод = CustomerID ; 
		КонецЕсли;
		Попытка
			НаборЗаписей.Записать();
		Исключение
			СообщитьИнформацию(НСтр("ru='Не записано ID в виртуальной АТС для: ';uk='Не записано ID в віртуальній АТС для: '")+Строка(Клиент)+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки());  
			Возврат Ложь;
		КонецПопытки;
		
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивНомеров", Numbers);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КонтактнаяИнформация.Объект КАК Ссылка
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И КонтактнаяИнформация.CRM_НомерТелефона В(&МассивНомеров)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 1 Тогда
		СтрокаТелефонов = "";
		Для Каждого ТекТелефон Из Numbers Цикл
			СтрокаТелефонов = СтрокаТелефонов + ТекТелефон + ", ";
		КонецЦикла;
		СтрокаТелефонов = Лев(СтрокаТелефонов, СтрДлина(СтрокаТелефонов)-2);
		СообщитьИнформацию(НСтр("ru='Некоторые номера из списка принадлежат более чем одному контрагенту: ';uk='Деякі номери зі списку належать більш ніж одному контрагенту: '")+СтрокаТелефонов);  
	КонецЕсли;	
	
	Пока Выборка.Следующий() Цикл
		ТекКлиент = Выборка.Ссылка;
		//Э_NCT(23.11.2018 14:40:01 www.nct.ua 
		//Если Не (ТипЗнч(ТекКлиент)=тип("СправочникСсылка.Контрагенты") или ТипЗнч(ТекКлиент)=тип("СправочникСсылка.КонтактныеЛицаКонтрагентов")) Тогда
		Если Не (ТипЗнч(ТекКлиент)=тип("СправочникСсылка.Контрагенты") 
		или (ВернутьЕстьСправочникКонтактныеЛицаКонтрагентов() и ТипЗнч(ТекКлиент)=тип("СправочникСсылка.КонтактныеЛицаКонтрагентов")) 
		или (ВернутьЕстьСправочникКонтактныеЛица() и ТипЗнч(ТекКлиент)=тип("СправочникСсылка.КонтактныеЛица"))) Тогда
		//Э_NCT) 
		     Продолжить;
		КонецЕсли; 
		
		МенеджерЗаписи = РегистрыСведений.Э_ТелефонияКодыКлиентов.СоздатьМенеджерЗаписи();	
		МенеджерЗаписи.Контакт = ТекКлиент;
		МенеджерЗаписи.ТелефонияКод = CustomerID;
		Попытка
			МенеджерЗаписи.Записать();
		Исключение
			СообщитьИнформацию(НСтр("ru='Не записано ID в виртуальной АТС для: ';uk='Не записано ID в віртуальній АТС для: '")+Строка(ТекКлиент)+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки()); 
			Возврат Ложь;
		КонецПопытки;
		
		Возврат Истина;
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции 	

Функция Э_ЗаписатьIDСотрудникаВСистеме(employeeID, extNumber="", employeeEmail="", ТекСотрудник=Неопределено) Экспорт 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("employeeID", employeeID);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Э_ТелефонияКодыСотрудников.Сотрудник.Ссылка
	|ИЗ
	|	РегистрСведений.Э_ТелефонияКодыСотрудников КАК Э_ТелефонияКодыСотрудников
	|ГДЕ
	|	Э_ТелефонияКодыСотрудников.ТелефонияКод = &employeeID";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Э_НастройкиБинотел=Э_ПолучитьНастройкиБинотел();
	Если Э_НастройкиБинотел=Неопределено Тогда
	     Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("extNumber", extNumber);
	Запрос.УстановитьПараметр("ОтборПоВнутреннемуНомеру", ?(ЗначениеЗаполнено(extNumber),Истина,Ложь));
	Запрос.УстановитьПараметр("ТекСотрудник", ТекСотрудник);
	Запрос.УстановитьПараметр("ОтборПоСсылкеНаСотрудник", ?(ЗначениеЗаполнено(ТекСотрудник),Истина,Ложь));
	Запрос.УстановитьПараметр("ВидКонтактнойИнформации", Э_НастройкиБинотел.Э_BinotelВнутреннийТелефонПользователяВид);
	Запрос.УстановитьПараметр("Э_ДлинаВнутреннегоНомераТелефона", Э_НастройкиБинотел.Э_BinotelДлинаВнутреннегоНомераТелефона);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КонтактнаяИнформация.Объект КАК Ссылка,
	|	Э_ТелефонияКодыСотрудников.ТелефонияКод КАК Э_EmployeeID
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Э_ТелефонияКодыСотрудников КАК Э_ТелефонияКодыСотрудников
	|		ПО КонтактнаяИнформация.Объект.Ссылка = Э_ТелефонияКодыСотрудников.Сотрудник.Ссылка
	|ГДЕ
	|	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И КонтактнаяИнформация.Вид = &ВидКонтактнойИнформации
	|	И ВЫБОР
	|			КОГДА &ОтборПоСсылкеНаСотрудник
	|				ТОГДА КонтактнаяИнформация.Объект = &ТекСотрудник
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|	И ВЫБОР
	|			КОГДА &ОтборПоВнутреннемуНомеру
	|				ТОГДА ПОДСТРОКА(КонтактнаяИнформация.CRM_НомерТелефона, 1, &Э_ДлинаВнутреннегоНомераТелефона) = &extNumber
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не ЗначениеЗаполнено(ТекСотрудник) и ЗначениеЗаполнено(extNumber) и Выборка.Количество() > 1 Тогда
		СообщитьИнформацию(НСтр("ru='Внутренний номер ';uk='Внутрішній номер '")+Строка(extNumber)+НСтр("ru=' принадлежат более чем одному сотруднику.';uk=' належить більш ніж одному співробітнику.'"));   
	КонецЕсли;	
	
	Пока Выборка.Следующий() Цикл
		ТекПользователь = Выборка.Ссылка;
		НаборЗаписей = РегистрыСведений.Э_ТелефонияКодыСотрудников.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Сотрудник.Установить(ТекПользователь);
		НовЗапись = НаборЗаписей.Добавить();
		НовЗапись.Сотрудник = ТекПользователь;
		НовЗапись.ТелефонияКод = employeeID;
		//в параметрах функции добавлено параметр "employeeEmail"
		НовЗапись.employeeEmail = employeeEmail;
		Попытка
			НаборЗаписей.Записать();
		Исключение
			СообщитьИнформацию(НСтр("ru='Не записано ID в виртуальной АТС ';uk='Не записано ID в віртуальній АТС '")+Строка(extNumber)+НСтр("ru=' для пользователя ';uk=' для користувача '")+Строка(ТекПользователь)+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки());     
			Возврат Ложь;
		КонецПопытки;
		Возврат Истина;
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции 	

Процедура Э_ПередЗаписьюСобытияПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
