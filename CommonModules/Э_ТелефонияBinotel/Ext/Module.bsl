//Э_Волощук (25.03.2019 15:58:49
Процедура Э_АвтоматическиЗакрытьЗадачиПоПропущеннымЗвонкам(ИсточникСсылка)
	Э_НастройкиБинотел=Э_ПолучитьНастройкиБинотел();
	Если Э_НастройкиБинотел=Неопределено И Не Э_НастройкиБинотел.Э_АвтоматическиЗакрыватьЗадачиПоПропущеннымЗвонкам Тогда
	     Возврат;
	КонецЕсли;
	 
	Если ЗначениеЗаполнено(ИсточникСсылка) и Не ИсточникСсылка.ПометкаУдаления
		И Не ИсточникСсылка.Э_ПропущенныйЗвонок и Не ИсточникСсылка.Э_SMSСообщение 
		И (ИсточникСсылка.ОкончаниеСобытия - ИсточникСсылка.НачалоСобытия) > 0 Тогда
		
		//найдем документы события по которым создали напоминания
		Запрос = Новый Запрос;                                                            
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Событие.Ссылка,
			|	Событие.ОписаниеСобытия
			|ПОМЕСТИТЬ ВТ_СобытияДляПоискаЗадач
			|ИЗ
			|	Документ.Событие КАК Событие
			|ГДЕ
			|	Событие.ТипСобытия = ЗНАЧЕНИЕ(Перечисление.ВходящееИсходящееСобытие.Входящее)
			|	И Событие.Э_ПропущенныйЗвонок
			|	И Событие.НачалоСобытия < &ДатаЗвонка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЗадачиПользователя.Ссылка КАК Задача
			|ИЗ
			|	ВТ_СобытияДляПоискаЗадач КАК ВТ_СобытияДляПоискаЗадач
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задача.ЗадачиПользователя КАК ЗадачиПользователя
			|		ПО ВТ_СобытияДляПоискаЗадач.Ссылка = ЗадачиПользователя.Объект
			|ГДЕ
			|	Описание ПОДОБНО &ТекстВОписании
			|	И Не Выполнена";
		
		//Э_NCT(24.05.2019 11:10:16 www.nct.ua 
		//ТекстВОписании = "Звонили с :"+СокрЛП(ИсточникСсылка.Э_Лид.НомерТелефона)+";";
		ТекстВОписании = "Звонили с :"+СокрЛП(ИсточникСсылка.Э_ТелефонАбонента)+";";
		//Э_NCT) 
		Запрос.УстановитьПараметр("ДатаЗвонка", ИсточникСсылка.НачалоСобытия);
		Запрос.УстановитьПараметр("ТекстВОписании", "%"+ТекстВОписании+"%");
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Попытка
					ЗадачаОб = ВыборкаДетальныеЗаписи.Задача.ПолучитьОбъект();
					ЗадачаОб.Выполнена = Истина;
					ЗадачаОб.Записать();
				Исключение
					СообщениеОбОшибке="Ошибка: "+ ОписаниеОшибки();	
					ЗаписьЖурналаРегистрации("Виртуальная АТС", УровеньЖурналаРегистрации.Ошибка,,,СообщениеОбОшибке );
					#Если Клиент Тогда
					СообщитьИнформацию(СообщениеОбОшибке);	
					#КонецЕсли
				КонецПопытки;
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
//Э_Волощук)

//Э_Волощук (23.07.2019 17:00:32
Функция Э_ОпределитьВнутреннийНомерТелефона(ПараметрыЗвонка, Э_НастройкиБинотел)
	ВнутреннийНомерТелефона = "";
	
	Если ПараметрыЗвонка.callType="0" Тогда // входящий
		ВнутреннийНомерТелефона = ПараметрыЗвонка.dstNumbers[0].dstNumber;
		Если Найти(ВнутреннийНомерТелефона, ">") > 0 Тогда
			ВнутреннийНомерТелефона = Прав(ВнутреннийНомерТелефона, Э_НастройкиБинотел.Э_BinotelДлинаВнутреннегоНомераТелефона);
		ИначеЕсли Не ЗначениеЗаполнено(ВнутреннийНомерТелефона) Тогда
			ВнутреннийНомерТелефона = СокрЛП(ПараметрыЗвонка.did);
		КонецЕсли;
	ИначеЕсли ПараметрыЗвонка.callType="1" Тогда // исходящий
		ВнутреннийНомерТелефона = ПараметрыЗвонка.srcNumber;
	КонецЕсли;
	
	Возврат ВнутреннийНомерТелефона;
КонецФункции
