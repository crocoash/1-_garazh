Процедура ЗагрузитьКонтрагентов() Экспорт
	Перем Э_BinotelPhoneLoc;
	
	#Если Клиент Тогда	
	Ответ = Вопрос("Действительно желаете загрузить клиентов с Бинотел в ""1С""?. Соответсвующие контрагенты будут найдены в 1С по номеру телефона, если не найдены, то будут созданы новые.", РежимДиалогаВопрос.ДаНет);
	Если Ответ <> КодВозвратаДиалога.да Тогда
	    Возврат;
	КонецЕсли;
	#КонецЕсли
		
	Э_BinotelPhoneLoc = Обработки.Э_BinotelPhone.Создать();
	result_customers = Э_BinotelPhoneLoc.sendRequest("customers/list", Новый Структура());
	СтруктураРезультат = Э_РаботаСJSON.Э_ПрочитатьJSON(result_customers);
	Если ТипЗнч(СтруктураРезультат) = Тип("Структура") Тогда
		Если Найти(СтруктураРезультат["status"], "success") > 0 Тогда
			Сч=0;
			ВсегоСтрокДляОбработки=СтруктураРезультат.customerData.Количество();
			ОбработаноСтрок=0;
			Для Каждого Клиент Из СтруктураРезультат.customerData Цикл
				ДанныеКлиента = Клиент.Значение;
				ОбработаноСтрок=ОбработаноСтрок+1;
				#Если Клиент Тогда
				ПроцентОбработки=Окр(ОбработаноСтрок*100/ВсегоСтрокДляОбработки,0);
				ОбработкаПрерыванияПользователя();          
				Состояние("Обработано:"+ПроцентОбработки+"%. Синхронизация клиента """+Строка(ДанныеКлиента)+"""");
				#КонецЕсли
				Если Э_ТелефонияBinotel.Э_ЗаписатьНовогоКлиентаВСистемеБинотел(ДанныеКлиента.id,ДанныеКлиента.name, ДанныеКлиента.numbers, ДанныеКлиента.assignedToEmployeeID,ДанныеКлиента.email,ДанныеКлиента.labels) Тогда
					Сч=Сч+1;
				КонецЕсли;
			КонецЦикла;	
		Иначе
			СтатусЗвонка = "error";
			Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Ошибка: ';uk='Помилка: '")+ Строка(СтруктураРезультат["code"])+", "+СтруктураРезультат["message"]);
		КонецЕсли;
	Иначе
		СтатусЗвонка = "error";
		Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Ошибка. ';uk='Помилка. '")+Строка(result_customers));
	КонецЕсли;
	
	Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Контрагенты: синхронизовано ';uk='Контрагенти: синхронізовано '")+Строка(Сч)+НСтр("ru=' объектов.';uk=' об'єктів.'"));   
КонецПроцедуры

Функция Э_ЗаписатьНовогоКлиентаВСистемеБинотел(CustomerID,ИмяКлиента, Numbers=Неопределено,assignedToEmployeeID=Неопределено,email=Неопределено,Метки=Неопределено) Экспорт 
	ТекКлиент = Неопределено;
	Если ЗначениеЗаполнено(CustomerID) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("CustomerID", CustomerID);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Э_ТелефонияКодыКлиентов.Контакт.Ссылка как Ссылка
		|ИЗ
		|	РегистрСведений.Э_ТелефонияКодыКлиентов КАК Э_ТелефонияКодыКлиентов
		|ГДЕ
		|	Э_ТелефонияКодыКлиентов.ТелефонияКод = &CustomerID";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ТекКлиент = Выборка.Ссылка;
		КонецЕсли;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивНомеров", Numbers);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КонтактнаяИнформация.Объект КАК Ссылка
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И КонтактнаяИнформация.CRM_НомерТелефона В(&МассивНомеров)";

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 1 Тогда
		СтрокаТелефонов = "";
		Для Каждого ТекТелефон Из Numbers Цикл
			СтрокаТелефонов = СтрокаТелефонов + ТекТелефон + ", ";     
		КонецЦикла;
		СтрокаТелефонов = Лев(СтрокаТелефонов, СтрДлина(СтрокаТелефонов)-2);
		СообщитьИнформацию(НСтр("ru='Некоторые номера из списка принадлежат более чем одному контрагенту: ';uk='Деякі номера зі списку належать більш ніж одному контрагенту: '")+СтрокаТелефонов);
		Возврат Ложь;
		
	ИначеЕсли Выборка.Количество() = 0 и НЕ ЗначениеЗаполнено(ТекКлиент) Тогда
		ТекКлиент = Справочники.Контрагенты.СоздатьЭлемент();
		ТекКлиент.Наименование =  ИмяКлиента;
		ТекКлиент.НаименованиеПолное =  ИмяКлиента;
		Попытка
			ТекКлиент.Записать();              
		Исключение
			СообщитьИнформацию(НСтр("ru='Не записан контрагент с наименованием ';uk='Не записаний контрагент з найменуванням '")+Строка(ИмяКлиента)+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
		ТекКлиент = ТекКлиент.Ссылка; 
		МенеджерЗаписи = РегистрыСведений.Э_ТелефонияКодыКлиентов.СоздатьМенеджерЗаписи();	
		МенеджерЗаписи.Контакт = ТекКлиент;
		МенеджерЗаписи.ТелефонияКод = CustomerID;
		Попытка
			МенеджерЗаписи.Записать();                   
		Исключение
			СообщитьИнформацию(НСтр("ru='Не записано ID в виртуальной АТС для контрагента ';uk='Не записано ID в віртуальній АТС для контрагента '")+Строка(ТекКлиент)+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;	

	РодительскаяПапка = Неопределено;
	Если ЗначениеЗаполнено(ТекКлиент) тогда
		
		Если Метки<>Неопределено тогда
			Если ТипЗнч(Метки)=Тип("Массив") тогда 
				Если Метки.Количество()	> 0 тогда
					НазваниеРодительскойПапки = Метки[0].name;
					РодительскаяПапка = Э_ПолучитьРодительскуюПапкуПоНаименованию(НазваниеРодительскойПапки);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		
		Если РодительскаяПапка <> ТекКлиент.Родитель тогда
			ТекКлиентОбъект = ТекКлиент.ПолучитьОбъект();	
			ТекКлиентОбъект.Родитель =  РодительскаяПапка;
			ТекКлиентОбъект.Записать();
		КонецЕсли;	
		
		ОтветственныйПользователь = Э_ПолучитьСотрудникаПоIDТелефонии(assignedToEmployeeID);
		Если ЗначениеЗаполнено(ОтветственныйПользователь) Тогда
			ОтветственныйПользовательФизЛицо=ОтветственныйПользователь.ФизЛицо;

			Если ЗначениеЗаполнено(ОтветственныйПользовательФизЛицо) Тогда
				Если ОтветственныйПользовательФизЛицо <> ТекКлиент.ОтветственныйМенеджер тогда
					ТекКлиентОбъект = ТекКлиент.ПолучитьОбъект();	
					ТекКлиентОбъект.ОтветственныйМенеджер =  ОтветственныйПользовательФизЛицо;		
					ТекКлиентОбъект.Записать();
				КонецЕсли;
			иначе
				Сообщить(НСтр("ru='В карточке пользователя ';uk='В картці користувача '")+ОтветственныйПользователь+НСтр("ru=' не заполнено физическое лицо';uk=' не заповнено фізичну особу'"));     
			КонецЕсли;
		КонецЕсли;
		
		
		Если ЗначениеЗаполнено(email) Тогда
			НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Объект.Значение      = ТекКлиент;
			НаборЗаписей.Отбор.Объект.Использование = Истина;
			НаборЗаписей.Отбор.Тип.Значение         = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
			НаборЗаписей.Отбор.Тип.Использование = Истина;
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() = 0 тогда
				НоваяЗапись=НаборЗаписей.Добавить();
				НоваяЗапись.Объект=ТекКлиент;
				НоваяЗапись.Тип=Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
				НоваяЗапись.Вид=Э_ПолучитьВидКонтактнойИнформации(ТекКлиент,НоваяЗапись.Тип);
				НоваяЗапись.Представление=email;
			КонецЕсли;	
			
			Если НаборЗаписей.Модифицированность() Тогда
				Попытка
					НаборЗаписей.Записать();		  

					Возврат Истина;
				исключение
					Сообщить(НСтр("ru='Ошибка записи email контрагента ';uk='Помилка запису email контрагента '")+СокрЛП(ТекКлиент)+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки());
				КонецПопытки;	
			КонецЕсли;	
		
		КонецЕсли;
		
	КонецЕсли;

	 
	СтатусВозвратаПриДобавленииТелефонов=Э_ДобавитьТелефоныКонтрагентуКонтактномуЛицу(ТекКлиент,Numbers, Перечисления.ВидыОбъектовКонтактнойИнформации.Контрагенты);
		 
	
	Возврат СтатусВозвратаПриДобавленииТелефонов;

КонецФункции 	

Функция Э_ДобавитьТелефоныКонтрагентуКонтактномуЛицу(Клиент,Numbers,ВидОбъектаКонтактнойИнформации) Экспорт
	Если НЕ ЗначениеЗаполнено(Клиент) или НЕ ЗначениеЗаполнено(Numbers) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Тип"   , Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("ВидОбъектаКонтактнойИнформации", ВидОбъектаКонтактнойИнформации);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВидыКонтактнойИнформации.Ссылка
	|ИЗ
	|	Справочник.ВидыКонтактнойИнформации КАК ВидыКонтактнойИнформации
	|
	|ГДЕ
	|	(ВидыКонтактнойИнформации.ПометкаУдаления = ЛОЖЬ) И
	|	ВидыКонтактнойИнформации.ВидОбъектаКонтактнойИнформации = &ВидОбъектаКонтактнойИнформации  И
	|	ВидыКонтактнойИнформации.Тип = &Тип
	|";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(); 
	
	ВидыКИ = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл 
		Если Выборка.Ссылка.ПометкаУдаления тогда продолжить; КонецЕсли;
		
		ВидыКИ.Добавить(Выборка.Ссылка);
	КонецЦикла;	 
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Номер");
	ТЗ.Колонки.Добавить("ВидКИ");
	
	
	
	НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Значение      = Клиент;
	НаборЗаписей.Отбор.Объект.Использование = Истина;
	НаборЗаписей.Отбор.Тип.Значение         = Перечисления.ТипыКонтактнойИнформации.Телефон;
	НаборЗаписей.Отбор.Тип.Использование = Истина;
	НаборЗаписей.Прочитать();
	ТЗ_тек = НаборЗаписей.Выгрузить(,"CRM_НомерТелефона,Вид");
	
	Для каждого стр из ТЗ_тек Цикл
		индекс = Numbers.Найти(стр.CRM_НомерТелефона);		
		Если НЕ (индекс = Неопределено) тогда
			ВидыКИ.Удалить(ВидыКИ.НайтиПоЗначению(стр.Вид));	
		КонецЕсли;	
	КонецЦикла;		
	
	Для каждого Номер из Numbers Цикл
		НовСтр = ТЗ.Добавить();
		НовСтр.Номер = Номер;
		
		НайденнаяСтрока = ТЗ_тек.Найти(Номер,"CRM_НомерТелефона");
		Если НайденнаяСтрока = Неопределено Тогда
			Если ВидыКИ.Количество() > 0 тогда
				НовСтр.ВидКИ = ВидыКИ[0].Значение;
				ВидыКИ.Удалить(ВидыКИ[0]);
			КонецЕсли;
		иначе
			ВидКИ = НайденнаяСтрока.Вид;
			НовСтр.ВидКИ = ВидКИ;
		КонецЕсли;
	КонецЦикла;	
	
	Если ТЗ.Количество() =  ТЗ_тек.Количество() тогда	
		Возврат Ложь;
	КонецЕсли;
	
	
	ТЗ.Сортировать("ВидКИ Убыв");
	
	НаборЗаписей.Очистить();	
	Для каждого стр из ТЗ Цикл
		
		Если НЕ ЗначениеЗаполнено(стр.ВидКИ) тогда 
			СообщитьИнформацию(НСтр("ru='Не достаточно элементов контактной информации с видом ""Телефон"" для номера ';uk='Не достатньо елементів контактної інформації з видом ""Телефон"" для номера '")+Строка(стр.Номер)+" контрагента "+Строка(Клиент));      
			прервать;
		КонецЕсли;
		
		НоваяЗапись=НаборЗаписей.Добавить();
		НоваяЗапись.Объект=Клиент;
		НоваяЗапись.Тип=Перечисления.ТипыКонтактнойИнформации.Телефон;
		НоваяЗапись.Вид=стр.ВидКИ;
		НоваяЗапись.Поле3=Стр.Номер;
		НоваяЗапись.Представление=Стр.Номер;
		НоваяЗапись.CRM_НомерТелефона=Стр.Номер;
		
		
	КонецЦикла;	
	Если НаборЗаписей.Модифицированность() Тогда
		Попытка
			НаборЗаписей.Записать();		
			Возврат Истина;
		исключение
			Сообщить(НСтр("ru='Ошибка записи телефонов контрагента ';uk='Помилка запису телефонів контрагента '")+СокрЛП(Клиент)+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки());       
		КонецПопытки;	
	КонецЕсли;	 
	Возврат Ложь;
	
КонецФункции

Функция Э_ПолучитьВидКонтактнойИнформации(ТекКлиент,Тип) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Тип"   , Тип);                   
	Запрос.УстановитьПараметр("ВидОбъектаКонтактнойИнформации", УправлениеКонтактнойИнформацией.ВидОбъектаКИ(ТекКлиент));
	
	Запрос.Текст = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВидыКонтактнойИнформации.Ссылка  как Ссылка
		|ИЗ
		|	Справочник.ВидыКонтактнойИнформации КАК ВидыКонтактнойИнформации
		|
		|ГДЕ
		|	(ВидыКонтактнойИнформации.ПометкаУдаления = ЛОЖЬ) И
		|	ВидыКонтактнойИнформации.ВидОбъектаКонтактнойИнформации = &ВидОбъектаКонтактнойИнформации  И
		|	ВидыКонтактнойИнформации.Тип = &Тип
		|";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(); 
	
	Если Выборка.Следующий() тогда
		  Возврат Выборка.Ссылка;
	КонецЕсли;
	
Возврат Справочники.ВидыКонтактнойИнформации.ПустаяСсылка();
