Процедура Э_СоздатьЗадачуПоНесостоявшемусяЗвонку(ДокСобытие, ВремяЗвонка, Контрагент, КонтактноеЛицо, Лид=Неопределено)
	Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();
	Если ДокСобытие.ЭтоНовый()  тогда
		//Э_Волощук (31.07.2019 01:23:06
		//Задача.Объект = ДокСобытие.ПолучитьСсылкуНового();
		Если ДокСобытие.Ссылка = Документы.Событие.ПустаяСсылка() Тогда
			ДокСобытие.УстановитьСсылкуНового(Документы.Событие.ПолучитьСсылку());
			Задача.Объект = ДокСобытие.ПолучитьСсылкуНового();
		КонецЕсли;
		//Э_Волощук)
	иначе
		Задача.Объект = ДокСобытие.Ссылка;
	КонецЕсли;  
	Задача.Дата =  ТекущаяДата();
	Задача.Исполнитель = ДокСобытие.Ответственный;
	ТекстНаименование = ДокСобытие.СодержаниеСобытия;
	ТекстОписания =  "Дата и время звонка :"+ВремяЗвонка;
	Если ЗначениеЗаполнено(Контрагент) Тогда
	  ТекстОписания = ТекстОписания+"
	  |Контрагент :"+СокрЛП(Контрагент)+";";
	  ТекстНаименование=ТекстНаименование+"; "+СокрЛП(Контрагент);
	КонецЕсли;
	Если ЗначениеЗаполнено(КонтактноеЛицо) Тогда
	  ТекстОписания = ТекстОписания+"
	  |Контактное лицо :"+СокрЛП(КонтактноеЛицо)+";";
	  ТекстНаименование=ТекстНаименование+"; "+СокрЛП(КонтактноеЛицо);
	КонецЕсли;
	Если ЗначениеЗаполнено(Лид) Тогда
	  ТекстОписания = ТекстОписания+"
	  |Лид :"+СокрЛП(Лид)+";";
	  ТекстНаименование=ТекстНаименование+"; "+СокрЛП(Лид);
	КонецЕсли;
	//Э_Волощук (19.06.2019 15:48:05
	//Если ЗначениеЗаполнено(Лид) Тогда
	//  ТекстОписания = ТекстОписания+"
	//  |Звонили с :"+СокрЛП(Лид.НомерТелефона)+";";
	//КонецЕсли;
	ТекстОписания = ТекстОписания+"
	|Звонили с :"+СокрЛП(ДокСобытие.Э_ТелефонАбонента)+";";
	//Э_Волощук)  
	
	Задача.Наименование = ТекстНаименование;
	Задача.Описание =  ТекстОписания;
	Задача.Оповещение = истина;
	Задача.СрокОповещения =  ДокСобытие.Дата;
	Задача.СрокИсполнения =  ДокСобытие.Дата;
	Задача.Записать();
