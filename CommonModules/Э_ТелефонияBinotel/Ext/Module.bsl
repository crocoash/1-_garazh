				 //|	,Э_ОткрыватьЖурналЗаказовПоКлиентуПриСозданииЗаказаПокупателя
				 ////Э_Волощук)
				 |	,Э_ОткрыватьЖурналЗаказовПоКлиенту
				 //Э_Волощук)
				 //Э_Волощук (25.03.2019 15:50:01
				 |	,Э_АвтоматическиЗакрыватьЗадачиПоПропущеннымЗвонкам
				 //Э_Волощук)
				 //Э_Волощук (13.05.2019 20:27:05
				 |	,Э_ОткрыватьНовыйЗаказПокупателяПриПолученииИнформацииОТекущемЗвонке
				 //Э_Волощук)
				 //Э_Волощук (27.09.2019 16:11:46
				 |	,Э_КоличествоДнейОтТекущейДатыКогдаПредЗаказСчитаетсяНовым
				 //Э_Волощук)
		 		 |ИЗ
	             |	РегистрСведений.Э_BinotelНастройки КАК Э_BinotelНастройки";
		
	РезультатЗапроса=Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		СообщитьИнформацию(НСтр("ru='В регистре сведений ""Binotel:Настройки"" не обнаружена запись с настройками.';uk='У реєстрі відомостей ""Binotel:Налаштування"" не знайдено запис з налаштуваннями.'"));
	Иначе
		РезультатТаблица = РезультатЗапроса.Выгрузить();
		РезультатТаблица[0].Э_BinotelЧасовойПояс = Э_BinotelЧасовойПояс;
		 
		Если Не ЗначениеЗаполнено(РезультатТаблица[0].Э_КоличествоДнейХраненияПропущенныхЗвонков) Тогда
		     РезультатТаблица[0].Э_КоличествоДнейХраненияПропущенныхЗвонков = 3;
		КонецЕсли;
		 
		Возврат РезультатТаблица[0];
	КонецЕсли;
	
	
