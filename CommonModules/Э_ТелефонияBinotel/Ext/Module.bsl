Функция Э_ОпределитьНомерТелефонаКонтрагента(ПараметрыЗвонка) Экспорт
	Если ПараметрыЗвонка.callType="0" Тогда // входящий
		НомерТелефона = ПараметрыЗвонка.srcNumber;
	ИначеЕсли ПараметрыЗвонка.callType="1" Тогда // исходящий
		НомерТелефона = ПараметрыЗвонка.dstNumbers[0].dstNumber;
	КонецЕсли;	
	Возврат НомерТелефона;
Конецфункции	

Процедура Э_ЗарегистрироватьИзмененияПоКонтактнымЛицамКонтрагента(Контрагент) Экспорт
	Перем Э_НастройкиБинотел,Э_BinotelПланОбмена,Запрос,РезультатЗапроса;
	
	Э_НастройкиБинотел=Э_ПолучитьНастройкиБинотел();
	Если Э_НастройкиБинотел=Неопределено Тогда
	     Возврат;
	КонецЕсли;
	
	Если Не Э_НастройкиБинотел.Э_BinotelВыполнятьСинхронизациюКонтрагентов Тогда
	    Возврат;
	КонецЕсли;
	
	Э_BinotelПланОбмена	= Э_НастройкиБинотел.Э_BinotelПланОбмена;
	Если ЗначениеЗаполнено(Э_BinotelПланОбмена) Тогда
		Запрос=Новый Запрос;
		Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ
		             |	КонтактныеЛицаКонтрагентов.Ссылка
		             |ИЗ
		             |	Справочник.КонтактныеЛицаКонтрагентов КАК КонтактныеЛицаКонтрагентов
		             |ГДЕ
		             |	КонтактныеЛицаКонтрагентов.Владелец = &Контрагент";
		Запрос.УстановитьПараметр("Контрагент",Контрагент.Ссылка);			 
		РезультатЗапроса=Запрос.Выполнить().Выбрать();			 
		Пока РезультатЗапроса.Следующий() Цикл
		     ПланыОбмена.ЗарегистрироватьИзменения(Э_BinotelПланОбмена,РезультатЗапроса.Ссылка);
		КонецЦикла; 
	иначе
		СообщитьИнформацию(НСтр("ru='В настройках интеграции с Бинотел не заполнен план обмена с ""Бинотел"". Регистр сведений ""Binotel: Настройки""';uk='В налаштуваннях інтеграції з Бінотел не заповнено план обміну з ""Бінотел"". Реєстр відомостей ""Binotel: Налаштування""'"));   
	КонецЕсли;
КонецПроцедуры

