Функция ОбработатьПропущенныеИСоздатьПредЗаказ(Э_НастройкиБинотел) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Э_ТелефонияПотерянныеЗвонки.НомерТелефона,
	               |	Э_ТелефонияПотерянныеЗвонки.Э_НашНомерТелефона,
	               |	Э_ТелефонияПотерянныеЗвонки.Контрагент,
	               |	Э_ТелефонияПотерянныеЗвонки.КонтактноеЛицо,
	               |	Э_ТелефонияПотерянныеЗвонки.Э_Лид,
	               |	Э_ТелефонияПотерянныеЗвонки.ВремяЗвонка,
	               |	Э_ТелефонияПотерянныеЗвонки.ВремяОжиданияСоединения,
	               |	Э_ТелефонияПотерянныеЗвонки.Э_CallIDЗвонка,
	               |	Э_ТелефонияПотерянныеЗвонки.Ответственный,
	               |	Э_ТелефонияПотерянныеЗвонки.КомуЗвонили,
	               |	Э_ТелефонияПотерянныеЗвонки.Комментарий,
	               |	Э_ТелефонияПотерянныеЗвонки.ДатаЗаписи
	               |ИЗ
	               |	РегистрСведений.Э_ТелефонияПотерянныеЗвонки КАК Э_ТелефонияПотерянныеЗвонки";
	
	Выборка = Запрос.Выполнить().Выбрать();
		
	Пока Выборка.Следующий() Цикл
		Номер = Выборка.НомерТелефона;
		ВремяЗвонка = Выборка.ВремяЗвонка;
		Э_НашНомерТелефона = Выборка.Э_НашНомерТелефона; 
		ОбработатьПропущенный(Номер, Э_НашНомерТелефона, ВремяЗвонка);
	КонецЦикла;	
КонецФункции 

Функция ОбработатьПропущенный(Номер, НашНомер, ВремяЗвонка) Экспорт
	
	
	ТекстКомментария = "Пропущений дзвінок " + ВремяЗвонка + " " + НашНомер ;//+ Символы.ПС + "Отладка док создан - " + ТекущаяДата();
	ПредЗаказСсылка = Документы.ПредЗаказ.ПолучитьПредзаказПропущенного(Номер, ТекстКомментария);
	
	
	Ответственный = ПолучитьАктуальногоОтветственного(Номер);
	Подразделение = Справочники.Подразделения.ПолучитьПодразделениеПоНомеру(НашНомер);
	Организация = Справочники.ТипыЦенНоменклатуры
	.НайтиПоКоду("000000001")
	.Организация;
	
	
	Если ПредЗаказСсылка = Неопределено Тогда
		
		ПредЗаказ = Документы.ПредЗаказ.СоздатьДокумент();
		
		ПредЗаказ.Дата = ВремяЗвонка;
		ПредЗаказ.Телефон = Номер;
		ПредЗаказ.Комментарий = ТекстКомментария;
		
		ПредЗаказ.Статус = Справочники.Статусы.НайтиПоКоду("000000072"); //Пропущенный номер 

		ПредЗаказ.Ответственный = Ответственный;
		ПредЗаказ.ОтветственныйМенеджер = Ответственный;
		ПредЗаказ.Подразделение = Подразделение;
		ПредЗаказ.Организация = Организация;
		
		ПредЗаказ.Записать();		
	Иначе
		
		ПредЗаказ = ПредЗаказСсылка.ПолучитьОбъект();
		
		Если ПредЗаказ.Дата <> ВремяЗвонка Тогда
						
			ПредЗаказ.Дата = ВремяЗвонка;
			
			ПредЗаказ.Ответственный = Ответственный;
			ПредЗаказ.ОтветственныйМенеджер = Ответственный;
	       	ПредЗаказ.Подразделение = Подразделение;
	        ПредЗаказ.Организация = Организация;	
			ПредЗаказ.Комментарий = 		
				ПредЗаказ.Комментарий 
				+ Символы.ПС 
				+ ТекстКомментария;
			ПредЗаказ.Записать();
						
		КонецЕсли;
				
	КонецЕсли; 
		

КонецФункции  

функция ПолучитьАктуальногоОтветственного(Номер) 
	
	ПоследнийОтветсвенныйКтоКонтактировал = Справочники.Пользователи.ПолучитьПоследнегоОтветсвенногоКтоКонтактировал(Номер);
	Если ПоследнийОтветсвенныйКтоКонтактировал <> Неопределено Тогда 				
		Ответственный = ПоследнийОтветсвенныйКтоКонтактировал; 				
	Иначе 
		Ответственный = Справочники.Пользователи.ПолучитьМенеджераУКоторогоНаименьшнееКолВоПредЗаказовВСтатусеПропущенный();				
	КонецЕсли;
	Возврат Ответственный;	
КонецФункции

