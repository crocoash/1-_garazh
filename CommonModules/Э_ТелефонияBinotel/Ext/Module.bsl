Функция Э_ПолучитьКодКлиентаВТелефонии(ТекКлиент) Экспорт
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ разрешенные
	             |	Э_ТелефонияКодыКлиентов.ТелефонияКод,
	             |	Э_ТелефонияКодыКлиентов.Контакт
	             |ИЗ
	             |	РегистрСведений.Э_ТелефонияКодыКлиентов КАК Э_ТелефонияКодыКлиентов
	             |ГДЕ
	             |	Э_ТелефонияКодыКлиентов.Контакт = &Контакт";
	Запрос.УстановитьПараметр("Контакт",ТекКлиент);			 
	Результат=Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.ТелефонияКод;
	иначе
		Возврат Неопределено;
    КонецЕсли;
КонецФункции 
 
