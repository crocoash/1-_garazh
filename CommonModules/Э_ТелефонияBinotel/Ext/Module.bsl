	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	Событие.Ссылка,
	             |	Событие.Э_CallIDЗвонкаBinotel,
	             |	Событие.Контрагент,
	             |	Событие.КонтактноеЛицо,
	             |	Событие.Э_ТелефонАбонента КАК Э_ТелефонАбонента
	             |ИЗ
	             |	Документ.Событие КАК Событие
	             |ГДЕ
	             |	НЕ Событие.ПометкаУдаления
	             |	И ВЫБОР
	             |			КОГДА &Э_НомерТелефонаЗадан
	             |				ТОГДА Событие.Э_ТелефонАбонента = &Э_НомерТелефона
	             |			ИНАЧЕ ИСТИНА
	             |		КОНЕЦ
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	Событие.Дата";
	Запрос.УстановитьПараметр("Э_НомерТелефона", Э_НомерТелефона);
	Запрос.УстановитьПараметр("Э_НомерТелефонаЗадан", ЗначениеЗаполнено(Э_НомерТелефона));
	РезультатЗапроса=Запрос.Выполнить().Выбрать();
	Пока РезультатЗапроса.Следующий() Цикл
		#Если Клиент Тогда
		ОбработкаПрерыванияПользователя();	
		#КонецЕсли			
		Если (Не ЗначениеЗаполнено(РезультатЗапроса.Контрагент) или ТипЗнч(РезультатЗапроса.Контрагент)=Тип("Строка")) и ЗначениеЗаполнено(РезультатЗапроса.Э_ТелефонАбонента) Тогда
			 #Если Клиент Тогда
			 Состояние(НСтр("ru='Обработка события:';uk='Обробка події:'")+РезультатЗапроса.Ссылка);     
			 #КонецЕсли
			 
			 НомерТелефона=СокрЛП(РезультатЗапроса.Э_ТелефонАбонента);
	  
			 Если ЗначениеЗаполнено(НомерТелефона) Тогда
				  НомерТелефона = Э_ТелефонияBinotel.Э_ПреобразоватьНомерТелефонаБезРазделителей(НомерТелефона);
				  ДокОбъект=РезультатЗапроса.Ссылка.ПолучитьОбъект();
				  ВидОбъектаКонтактнойИнформации=Неопределено;
				  Э_ЗаполнитьКонтрагентаКонтактноеЛицо(ДокОбъект,НомерТелефона,ВидОбъектаКонтактнойИнформации,Ложь);
				  Если ДокОбъект.Модифицированность() Тогда
						Попытка
							ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
						Исключение
							Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Не удалось записать событие ';uk='Не вдалось записати подію '")+РезультатЗапроса.Ссылка+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки());  
						КонецПопытки;
				  КонецЕсли;	
			 КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

Процедура Э_ПриЗаписиРегистраСведенийКонтактнаяИнформацияПриЗаписи_Контрагенты(Источник, Отказ, Замещение) Экспорт
	Перем Э_НомерТелефона;
	
	Для каждого Запись Из Источник Цикл
		Если Запись.Тип<>Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			Продолжить;
		КонецЕсли;	
		Э_НомерТелефона = Запись.CRM_НомерТелефона;                                                                                                
		Если (ТипЗнч(Запись.Объект)=Тип("СправочникСсылка.Контрагенты")или 
			 //Э_NCT(22.11.2018 13:16:57 www.nct.ua 
			 //ТипЗнч(Запись.Объект)=Тип("СправочникСсылка.КонтактныеЛицаКонтрагентов")) и ЗначениеЗаполнено(Э_НомерТелефона) Тогда
			 (ВернутьЕстьСправочникКонтактныеЛицаКонтрагентов() и ТипЗнч(Запись.Объект)=Тип("СправочникСсылка.КонтактныеЛицаКонтрагентов")) или
			 (ВернутьЕстьСправочникКонтактныеЛица() и ТипЗнч(Запись.Объект)=Тип("СправочникСсылка.КонтактныеЛица"))) и
			 ЗначениеЗаполнено(Э_НомерТелефона) Тогда
			 //Э_NCT) 
			 Э_ЗаполнитьКонтактыВСобытияхГдеНеЗаполненоПоНомеруТелефона(Э_НомерТелефона);
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Функция ЗаполнитьКонтактнуюИнформацию() Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Тип,
	|	КонтактнаяИнформация.Вид
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Тип = &Тип
	|	И ПОДСТРОКА(КонтактнаяИнформация.Представление, 1, 10) <> &ПустаяСтрока
	|	И КонтактнаяИнформация.CRM_НомерТелефона = &ПустаяСтрока";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("ПустаяСтрока", "");
	Запрос.Текст = ТекстЗапроса;
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Э_ТелефонияBinotel.СообщитьИнформацию("Ошибка заполнения телефонов без разделителей: "+ОписаниеОШибки());
		Возврат Неопределено;
	КонецПопытки;
	
	Сч=0;
	Пока Выборка.Следующий() Цикл
		Попытка
			МЗ = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(МЗ, Выборка);
			МЗ.Прочитать();
			Если МЗ.Выбран() Тогда
				НомерТелефона = Э_ТелефонияBinotel.Э_ПреобразоватьНомерТелефонаБезРазделителей(МЗ.Представление);
				Если ЗначениеЗаполнено(НомерТелефона) Тогда
					МЗ.CRM_НомерТелефона = НомерТелефона;
					МЗ.Записать();
					Сч = Сч + 1;
				КонецЕсли;
			КонецЕсли;
		Исключение
			Э_ТелефонияBinotel.СообщитьИнформацию("Ошибка заполнения телефонов без разделителей: "+ОписаниеОШибки());
			Возврат Неопределено;
		КонецПопытки;
	КонецЦикла;
	
	Возврат Сч;
КонецФункции

