	Э_BinotelЧасовойПояс = ПолучитьЧасовойПояс();
				
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	             |	Э_BinotelНастройки.Э_BinotelapiKey,
	             |	Э_BinotelНастройки.Э_BinotelapiSecret,
