Процедура Э_ОчиститьРегистрЭ_ТелефонияКодыКлиентов()
    ТекРег=регистрыСведений.Э_ТелефонияКодыКлиентов.СоздатьНаборЗаписей();
	ТекРег.Прочитать();
	ТекРег.Очистить();
	ТекРег.Записать(Истина);
	Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Выполнена очистка регистра сведений ""Телефония. Клиенты""';uk='Виконано очищення реєстра відомостей ""Телефонія. Клієнти""'"));   
КонецПроцедуры

Процедура Э_ВыгрузитьДанныеКлиентовВМиниСрмМоиКлиенты(ПолнаяВыгрузка=Ложь,ЭтоРегламентноеЗадание=Ложь) Экспорт 
	Перем НомерСообщения,МассивКонтрагентовКонтактныхЛиц,Выборка,Запрос,ТЗ_КлиентыТелефоны,ТЗ_Клиенты,Отбор_Клиент,Name,NameБезЛишнихСимволов;
	Перем ТелефоныКлиента,СтрокиТелефоны,КонтрагентПередан,Сч,result_upload,СтруктураРезультат,Э_BinotelPhoneLoc;
	
	Э_НастройкиБинотел=Э_ПолучитьНастройкиБинотел();
	Если Э_НастройкиБинотел=Неопределено Тогда
	     Возврат;
	КонецЕсли;
	
	Если Э_НастройкиБинотел=Неопределено Тогда
	    Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Выгрузка клиентов в Бинотел:Не заполнены настройки по синхронизации с ""Бинотел""';uk='Вивантаження клієнтів в Бінотел:Не заповнені налаштування по синхронізації з ""Бінотел""'"));  
		Возврат;
	КонецЕсли; 
	
	Если Не Значениезаполнено(Э_НастройкиБинотел.Э_BinotelПланОбмена) Тогда
	    Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Выгрузка клиентов в Бинотел:Не заполнена настройка ""Binotel: План обмена"" в регистре сведений ""Binotel:Настройки"". Заполнить настройки можно в обработке ""Binotel IP-телефония"", нажав кнопку ""Настройка""';uk='Вивантаження клієнтів в Бінотел:Не заповнено налаштування ""Binotel: План обміну"" в реєстрі відомостей ""Binotel: Налаштування"". Заповнити налаштування можно в обробці ""Binotel IP-телефонія"", натиснувши кнопку ""Налаштування""'"));   
		Возврат;
	КонецЕсли;
	
	Если Не Э_НастройкиБинотел.Э_BinotelВыполнятьСинхронизациюКонтрагентов Тогда
	    Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Выгрузка клиентов в Бинотел:Не включена настройки ""Синхронизация контрагентов с клиентами ""Бинотел""';uk='Вивантаження клієнтів в Бінотел:Не вімкнено налаштування ""Синхронізація контрагентів з клієнтами ""Бінотел""'"));    
		Возврат;
	КонецЕсли;
	
		
	Если НЕ Э_НастройкиБинотел.Э_BinotelИспользоватьФункционалИнтеграции Тогда
	     Возврат;
	КонецЕсли;
		
	
	ГруппыПартнеров = Э_НастройкиБинотел.Э_BinotelГруппыПартнеров.Получить();
	ОграничитьВыгрузкуПартнеровПоГруппам = Э_НастройкиБинотел.Э_BinotelОграничитьВыгрузкуПартнеровПоГруппам;
	
	
	НомерСообщения = 0;
	МассивКонтрагентовКонтактныхЛиц = Новый Массив;
	Если НЕ ПолнаяВыгрузка Тогда
		Выборка = ПланыОбмена.ВыбратьИзменения(Э_НастройкиБинотел.Э_BinotelПланОбмена, НомерСообщения);
		Пока Выборка.Следующий() Цикл
			МассивКонтрагентовКонтактныхЛиц.Добавить(Выборка.Получить().Ссылка);
		КонецЦикла;	
	иначе
		Э_ОчиститьРегистрЭ_ТелефонияКодыКлиентов();
		СинхронизироватьКонтрагентов();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивКонтрагентовКонтактныхЛиц", МассивКонтрагентовКонтактныхЛиц);
	Запрос.УстановитьПараметр("ПолнаяВыгрузка", ПолнаяВыгрузка);
	
	Запрос.УстановитьПараметр("ГруппыПартнеров", ГруппыПартнеров);
	Запрос.УстановитьПараметр("ОграничитьВыгрузкуПартнеровПоГруппам", ОграничитьВыгрузкуПартнеровПоГруппам);
		
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Клиенты.Клиент,
	|	Клиенты.НомерТелефона КАК НомерТелефона,
	|	Клиенты.ОбъектКод КАК Код,
	|	Клиенты.Наименование,
	|	Клиенты.CustomerID,
	|	Клиенты.ВладелецНаименование,
	|	Клиенты.КлиентПометкаУдаления,
	|	Клиенты.ОсновнойМенеджерПокупателя,
	|	ЕСТЬNULL(Э_ТелефонияКодыСотрудников.ТелефонияКод, ""0"") КАК EmployeeID
	|ИЗ
	|	(ВЫБРАТЬ
	|		КонтактнаяИнформация.Объект КАК Клиент,
	|		КонтактнаяИнформация.CRM_НомерТелефона КАК НомерТелефона,
	|		КонтактнаяИнформация.Объект.Код КАК ОбъектКод,
	|		КонтактнаяИнформация.Объект.Наименование КАК Наименование,
	|		Э_ТелефонияКодыКлиентов.ТелефонияКод КАК CustomerID,
	|		ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(КонтактнаяИнформация.Объект.Ссылка) = ТИП(Справочник.КонтактныеЛицаКонтрагентов)
	|				ТОГДА КонтактнаяИнформация.Объект.Владелец.Наименование
	|			ИНАЧЕ """"""""
	|		КОНЕЦ КАК ВладелецНаименование,
	|		КонтактнаяИнформация.Объект.ПометкаУдаления КАК КлиентПометкаУдаления,
	|		ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(КонтактнаяИнформация.Объект.Ссылка) = ТИП(Справочник.КонтактныеЛицаКонтрагентов)
	|				ТОГДА КонтактнаяИнформация.Объект.Владелец.ОсновнойМенеджерПокупателя
	|			ИНАЧЕ КонтактнаяИнформация.Объект.ОсновнойМенеджерПокупателя
	|		КОНЕЦ КАК ОсновнойМенеджерПокупателя
	|	ИЗ
	|		РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Э_ТелефонияКодыКлиентов КАК Э_ТелефонияКодыКлиентов
	|			ПО КонтактнаяИнформация.Объект = Э_ТелефонияКодыКлиентов.Контакт
	|	ГДЕ
	|		КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|		И (ТИПЗНАЧЕНИЯ(КонтактнаяИнформация.Объект.Ссылка) = ТИП(Справочник.Контрагенты)
	|				ИЛИ ТИПЗНАЧЕНИЯ(КонтактнаяИнформация.Объект.Ссылка) = ТИП(Справочник.КонтактныеЛицаКонтрагентов))
	|		И ВЫБОР
	|				КОГДА &ПолнаяВыгрузка
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ КонтактнаяИнформация.Объект.Ссылка В (&МассивКонтрагентовКонтактныхЛиц)
