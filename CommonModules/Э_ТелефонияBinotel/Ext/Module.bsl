Процедура СинхронизироватьКонтрагентов() Экспорт
	Перем Э_BinotelPhoneLoc;
    Э_BinotelPhoneLoc = Обработки.Э_BinotelPhone.Создать();
	result_customers = Э_BinotelPhoneLoc.sendRequest("customers/list", Новый Структура());
	СтруктураРезультат = Э_РаботаСJSON.Э_ПрочитатьJSON(result_customers);
	Если ТипЗнч(СтруктураРезультат) = Тип("Структура") Тогда
		Если Найти(СтруктураРезультат["status"], "success") > 0 Тогда
			Сч=0;
			ВсегоСтрокДляОбработки=СтруктураРезультат.customerData.Количество();
			ОбработаноСтрок=0;
			Для Каждого Клиент Из СтруктураРезультат.customerData Цикл
				ДанныеКлиента = Клиент.Значение;
				ОбработаноСтрок=ОбработаноСтрок+1;
				#Если Клиент Тогда
				ПроцентОбработки=Окр(ОбработаноСтрок*100/ВсегоСтрокДляОбработки,0);
				ОбработкаПрерыванияПользователя();          
				Состояние("Обработано:"+ПроцентОбработки+"%. Синхронизация клиента """+Строка(ДанныеКлиента)+"""");
				#КонецЕсли
				Если Э_ТелефонияBinotel.Э_ЗаписатьIDКлиентаВСистемеБинотел(ДанныеКлиента.id, ДанныеКлиента.numbers) Тогда
					Сч=Сч+1;
				КонецЕсли;
			КонецЦикла;	
		Иначе
			СтатусЗвонка = "error";
			Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Ошибка: ';uk='Помилка: '")+ Строка(СтруктураРезультат["code"])+", "+СтруктураРезультат["message"]);
		КонецЕсли;
	Иначе
		СтатусЗвонка = "error";
		Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Ошибка. ';uk='Помилка. '")+Строка(result_customers));
	КонецЕсли;
	
	Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Контрагенты: синхронизовано ';uk='Контрагенти: синхронізовано '")+Строка(Сч)+НСтр("ru=' объектов.';uk=' об'єктів.'"));      

КонецПроцедуры

Функция Э_ПоследнийЗаказПоКонтрагенту(ТекКонтрагент) Экспорт
	Если Не ЗначениеЗаполнено(ТекКонтрагент) Тогда
	    Возврат Неопределено;
	КонецЕсли;
	Если Метаданные.Документы.Найти("ЗаказПокупателя")<>Неопределено Тогда
		НазваниеВидаДокументаЗаказ="ЗаказПокупателя";
	иначеЕсли Метаданные.Документы.Найти("СчетНаОплатуПокупателю")<>Неопределено Тогда
		НазваниеВидаДокументаЗаказ="СчетНаОплатуПокупателю";
	иначе                                                       
		Возврат Неопределено;
	КонецЕсли;	
	НаименованиеРеквизитаКонтрагент="Контрагент";
	
	Запрос=Новый Запрос;
	ТекстЗапроса="ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	              |	ЗаказКлиента.Ссылка
	              |ИЗ
	              |	Документ.ЗаказПокупателя КАК ЗаказКлиента
	              |ГДЕ
	              |	ЗаказКлиента.Контрагент = &Контрагент
	              |	И Не ЗаказКлиента.ПометкаУдаления
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	ЗаказКлиента.Дата УБЫВ";
	Запрос.УстановитьПараметр("Контрагент",ТекКонтрагент);			  
	
	Если НаименованиеРеквизитаКонтрагент<>"Контрагент" Тогда
	    ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"ЗаказКлиента.Контрагент","ЗаказКлиента."+НаименованиеРеквизитаКонтрагент);	
	КонецЕсли;			  
	Если НазваниеВидаДокументаЗаказ<>"ЗаказПокупателя" Тогда
	    ТекстЗапроса=СтрЗаменить(ТекстЗапроса,"Документ.ЗаказПокупателя","Документ."+НазваниеВидаДокументаЗаказ);	
	КонецЕсли;			  
	
	Запрос.Текст=ТекстЗапроса;
    РезультатЗапрос=Запрос.Выполнить().Выбрать();
	Если РезультатЗапрос.Следующий() Тогда
	    Возврат РезультатЗапрос.Ссылка;
	иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции 

