//  ПРОЦЕДУРЫ И ФУНКЦИИ ОТПРАВКИ ЗАПРОСА

// Дата в стандартном формате 
//
//Примеры:
// 1370034000 - Sat, 01 Jun 2013 00:00:00 +0300
// 1370120399 - Sat, 01 Jun 2013 23:59:59 +0300
Функция Дата_формат1С(Дата,ЧасовойПояс) Экспорт 
	Если ТипЗнч(Дата) = Тип("Число") Тогда
		ДатаUNIX = Дата;
	Иначе
		Попытка
			ДатаUNIX = Число(Дата);
		Исключение
			Возврат Дата(1,1,1);
		КонецПопытки;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНач",		Дата(1970,1,1));
	Запрос.УстановитьПараметр("ДатаUNIX",		ДатаUNIX);
	Запрос.УстановитьПараметр("ВременнойПояс",	ЧасовойПояс);
	Запрос.Текст = "ВЫБРАТЬ ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(&ДатаНач, СЕКУНДА, &ДатаUNIX), ЧАС, &ВременнойПояс) КАК Date";
		
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Date;
	Иначе
		Возврат Дата(1,1,1);
	КонецЕсли;
	
КонецФункции // Дата_unix_timestamp()

// Дата в формате unix timestamp
//
//Примеры:
// 1370034000 - Sat, 01 Jun 2013 00:00:00 +0300
// 1370120399 - Sat, 01 Jun 2013 23:59:59 +0300
Функция Дата_unix_timestamp(Дата,ЧасовойПояс) Экспорт 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНач", Дата(1970,1,1));
	Запрос.УстановитьПараметр("ДатаТек", Дата);
	Запрос.УстановитьПараметр("ВременнойПояс", ЧасовойПояс);
	Запрос.Текст = "ВЫБРАТЬ РАЗНОСТЬДАТ(&ДатаНач, ДОБАВИТЬКДАТЕ(&ДатаТек, ЧАС, -1*&ВременнойПояс), СЕКУНДА) КАК Date";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Date;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции // Дата_unix_timestamp()

Функция json_encode(params)
	json_представление = "";
	Кавычка = """";
	
	Если ТипЗнч(params) = Тип("Массив") Тогда
		Для Каждого Парам Из params Цикл
			Если НЕ ЗначениеЗаполнено(Парам) Тогда
				Продолжить;
			КонецЕсли;	
			Если ТипЗнч(Парам) = Тип("Строка") Тогда
				json_представление = json_представление +""""+Парам.Ключ+""""+":"+Кавычка+Парам+Кавычка+",";
			Иначе
				json_представление = json_представление +""""+Парам.Ключ+""""+":"+Парам.Значение+",";
			КонецЕсли;
		КонецЦикла; 
		json_представление = Лев(json_представление,СтрДлина(json_представление)-1);
		json_представление = СтрЗаменить(json_представление,Символы.НПП,"");
		json_представление = "["+json_представление+"]";
	ИначеЕсли ТипЗнч(params) = Тип("Структура") Тогда
		Для Каждого Парам Из params Цикл
			Если НЕ ЗначениеЗаполнено(Парам.Значение) Тогда
				Продолжить;
			КонецЕсли;	
			Если ТипЗнч(Парам.Значение) = Тип("Массив") Тогда
				json_представление_массив = "";
				Для Каждого ЭлМассива Из Парам.Значение Цикл
					json_представление_массив = json_представление_массив + Строка(ЭлМассива) + ","
				КонецЦикла;	
				json_представление_массив = Лев(json_представление_массив,СтрДлина(json_представление_массив)-1);
				json_представление = json_представление +""""+Парам.Ключ+""""+":"+"["+json_представление_массив+"]";
			ИначеЕсли ТипЗнч(Парам.Значение) = Тип("Строка") Тогда
				json_представление = json_представление +""""+Парам.Ключ+""""+":"+Кавычка+Парам.Значение+Кавычка+",";
			Иначе
				json_представление = json_представление +""""+Парам.Ключ+""""+":"+Парам.Значение+",";
			КонецЕсли;
		КонецЦикла; 
		json_представление = Лев(json_представление,СтрДлина(json_представление)-1);
		json_представление = СтрЗаменить(json_представление,Символы.НПП,"");
		json_представление = "{"+json_представление+"}";
	КонецЕсли;

	Возврат json_представление;
	
КонецФункции // json_encode()

Функция Э_НайтиСобытие(НачПериода,CallID, НомерТелефона,ВидОбъектаКонтактнойИнформации,Э_НастройкиБинотел) Экспорт 
	 Если Э_НастройкиБинотел=Неопределено Тогда
	    Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Не заполнены настройки по синхронизации с ""Бинотел""';uk='Не заповнені налаштування по синхронізації з ""Бінотел""'")); 
		Возврат Неопределено;
	 КонецЕсли; 
	
	 НайденноеСобытие=Э_СобытиеПоIdBinotel(CallID); 
     
	 Если НайденноеСобытие=неопределено и Э_НастройкиБинотел.Э_BinotelЕслиСобытиеНеНайденоПоIDТоИскатьПервоеЗапланированноеПоКонтрагенту и ЗначениеЗаполнено(НомерТелефона) Тогда
		ТекКонтрагент=Неопределено;
		ТекКонтактноеЛицо=Неопределено;
		ТекКонтактноеЛицоБезКонтрагента=Неопределено;
	    Э_ОпределитьКонтрагентаКонтактноеЛицо(НомерТелефона, ВидОбъектаКонтактнойИнформации,ТекКонтрагент,ТекКонтактноеЛицо,ТекКонтактноеЛицоБезКонтрагента);
	    ЕстьОтборПоКонтрагенту                  =?(ЗначениеЗаполнено(ТекКонтрагент),Истина,Ложь);
	    ЕстьОтборПоКонтактномуЛицу              =?(ЗначениеЗаполнено(ТекКонтактноеЛицо),Истина,Ложь);
	    ЕстьОтборПоКонтактномуЛицуБезКонтрагента=?(ЗначениеЗаполнено(ТекКонтактноеЛицоБезКонтрагента),Истина,Ложь);
		
		Если ЕстьОтборПоКонтрагенту или ЕстьОтборПоКонтактномуЛицу или ЕстьОтборПоКонтактномуЛицуБезКонтрагента Тогда
			
			НайденноеСобытие=Э_НайтиЗапланированноеСобытиеПоКонтакту(ТекКонтрагент,ТекКонтактноеЛицо,ТекКонтактноеЛицоБезКонтрагента,Э_НастройкиБинотел);
		КонецЕсли;	
		Если НайденноеСобытие=неопределено и Э_НастройкиБинотел.Э_BinotelУправлениеЛидами Тогда  
			ТекЭ_Лид=Э_УправлениеЛидами.Э_НайтиЛид(НомерТелефона);
		     НайденноеСобытие=Э_НайтиЗапланированноеСобытиеПоКонтакту(,,,Э_НастройкиБинотел,ТекЭ_Лид);
		КонецЕсли;
	 КонецЕсли;
	 Возврат НайденноеСобытие; 
КонецФункции	

Функция Э_НайтиЗапланированноеСобытиеПоКонтакту(ТекКонтрагент,ТекКонтактноеЛицо,ТекКонтактноеЛицоБезКонтрагента,Э_НастройкиБинотел,Э_Лид=Неопределено) Экспорт
   Перем ЕстьОтборПоКонтрагенту,ЕстьОтборПоКонтактномуЛицу,ЕстьОтборПоКонтактномуЛицуБезКонтрагента,ЕстьОтборПоЭ_Лид,Запрос,Результат;	
   
   Если Э_НастройкиБинотел=Неопределено Тогда
	    Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Не заполнены настройки по синхронизации с ""Бинотел""';uk='Не заповнені налаштування по синхронізації з ""Бінотел""'")); 
		Возврат Неопределено;
   КонецЕсли; 
   
   ЕстьОтборПоКонтрагенту                  =?(ЗначениеЗаполнено(ТекКонтрагент),Истина,Ложь);
   ЕстьОтборПоКонтактномуЛицу              =?(ЗначениеЗаполнено(ТекКонтактноеЛицо),Истина,Ложь);
   ЕстьОтборПоКонтактномуЛицуБезКонтрагента=?(ЗначениеЗаполнено(ТекКонтактноеЛицоБезКонтрагента),Истина,Ложь);
   ЕстьОтборПоЭ_Лид=?(ЗначениеЗаполнено(Э_Лид),Истина,Ложь);	
   
   Если ЕстьОтборПоКонтрагенту или ЕстьОтборПоКонтактномуЛицу или ЕстьОтборПоКонтактномуЛицуБезКонтрагента или ЕстьОтборПоЭ_Лид Тогда
		 
	   Запрос=Новый Запрос;
	   Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	                |	Событие.Ссылка
	                |ИЗ
	                |	Документ.Событие КАК Событие
	                |ГДЕ
	                |	НЕ Событие.ПометкаУдаления
	                |	И Событие.ВидСобытия = &ВидСобытия
	                |	И Событие.СостояниеСобытия = &СостояниеСобытия
	                |	И ВЫБОР
	                |			КОГДА &ЕстьОтборПоКонтрагенту
	                |				ТОГДА Событие.Контрагент = &Контрагент
	                |			ИНАЧЕ ИСТИНА
	                |		КОНЕЦ
	                |	И ВЫБОР
	                |			КОГДА &ЕстьОтборПоКонтактномуЛицу
	                |				ТОГДА Событие.КонтактноеЛицо = &КонтактноеЛицо
	                |			ИНАЧЕ ИСТИНА
	                |		КОНЕЦ
	                |	И ВЫБОР
	                |			КОГДА &ЕстьОтборПоКонтактномуЛицуБезКонтрагента
	                |				ТОГДА Событие.КонтактноеЛицоБезКонтрагента = &КонтактноеЛицоБезКонтрагента
	                |			ИНАЧЕ ИСТИНА
	                |		КОНЕЦ";
					Если Э_НастройкиБинотел.Э_BinotelУправлениеЛидами Тогда
					    Запрос.Текст=Запрос.Текст+"
		                |	И ВЫБОР
		                |			КОГДА &ЕстьОтборПоЭ_Лид
		                |				ТОГДА Событие.Э_Лид = &Э_Лид
		                |			ИНАЧЕ ИСТИНА
		                |		КОНЕЦ";
					КонецЕсли; 
				    Запрос.Текст=Запрос.Текст+"
	                |
	                |УПОРЯДОЧИТЬ ПО
					|	Событие.Дата";
					
					
	    //Запрос.УстановитьПараметр("ДатаНачало",НачалоМесяца(НачПериода));									
		Запрос.УстановитьПараметр("ЕстьОтборПоКонтрагенту",ЕстьОтборПоКонтрагенту);			
		Запрос.УстановитьПараметр("Контрагент",ТекКонтрагент);			
		Запрос.УстановитьПараметр("ЕстьОтборПоКонтактномуЛицу",ЕстьОтборПоКонтактномуЛицу);			
		Запрос.УстановитьПараметр("КонтактноеЛицо",ТекКонтактноеЛицо);			
		Запрос.УстановитьПараметр("ЕстьОтборПоКонтактномуЛицуБезКонтрагента",ЕстьОтборПоКонтактномуЛицуБезКонтрагента);			
		Запрос.УстановитьПараметр("КонтактноеЛицоБезКонтрагента",ТекКонтактноеЛицоБезКонтрагента);			
		Запрос.УстановитьПараметр("ЕстьОтборПоЭ_Лид",ЕстьОтборПоЭ_Лид);			
		Запрос.УстановитьПараметр("Э_Лид",Э_Лид);			
		Запрос.УстановитьПараметр("ВидСобытия",Перечисления.ВидыСобытий.ТелефонныйЗвонок);			
		Запрос.УстановитьПараметр("СостояниеСобытия",Перечисления.СостоянияСобытий.Запланировано);			
		Результат=Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
		     Возврат Результат.Ссылка;
		иначе	 
		     возврат Неопределено;	 
		КонецЕсли;
	иначе
		Возврат Неопределено;
	КонецЕсли;	
КонецФункции 

Функция Э_СобытиеПоIdBinotel(CallID) Экспорт 
	ЗапросЗвонок = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Док.Ссылка ИЗ Документ.Событие КАК Док ГДЕ Док.Э_CallIDЗвонкаBinotel ПОДОБНО &CallID");
	ЗапросЗвонок.УстановитьПараметр("CallID", CallID+"%");
	ВыборкаЗвонок = ЗапросЗвонок.Выполнить().Выбрать();
	Если ВыборкаЗвонок.Следующий() Тогда
		Возврат ВыборкаЗвонок.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции	


//Процедура Э_ОпределитьКонтрагентаКонтактноеЛицо(НомерТелефона, ВидОбъектаКонтактнойИнформации,ТекКонтрагент,ТекКонтактноеЛицо=Неопределено,ТекКонтактноеЛицоБезКонтрагента=Неопределено)
Процедура Э_ОпределитьКонтрагентаКонтактноеЛицо(НомерТелефона, ВидОбъектаКонтактнойИнформации,ТекКонтрагент,ТекКонтактноеЛицо=Неопределено,ТекКонтактноеЛицоБезКонтрагента=Неопределено) Экспорт

	ОбъектСобытия = Э_ТелефонияBinotel.Э_ОбъектСобытияПоНомеруТелефона(НомерТелефона, ВидОбъектаКонтактнойИнформации);
	ТекКонтрагент=Неопределено;
	ТекКонтактноеЛицо=Неопределено;
	ТекКонтактноеЛицоБезКонтрагента=Неопределено;
	Если ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.Контрагенты Тогда
		Если ВернутьЕстьСправочникКонтактныеЛицаКонтрагентов() Тогда
			Если типЗнч(ОбъектСобытия)=Тип("СправочникСсылка.КонтактныеЛицаКонтрагентов") Тогда
			    ТекКонтактноеЛицо = ОбъектСобытия;
				ТекКонтрагент     = ОбъектСобытия.Владелец;
			иначе	
				ТекКонтрагент = ОбъектСобытия;
				ТекКонтактноеЛицо = Справочники.КонтактныеЛицаКонтрагентов.ПустаяСсылка();
			КонецЕсли;
		иначеЕсли ВернутьЕстьСправочникКонтактныеЛица()Тогда
			Если типЗнч(ОбъектСобытия)=Тип("СправочникСсылка.КонтактныеЛица") Тогда
			    ТекКонтактноеЛицо = ОбъектСобытия;
				ТекКонтрагент     = ОбъектСобытия.Владелец;
			иначе	
				ТекКонтрагент = ОбъектСобытия;
				ТекКонтактноеЛицо = Справочники.КонтактныеЛица.ПустаяСсылка();
			КонецЕсли;
		иначе	
			ТекКонтрагент     = ОбъектСобытия;
		КонецЕсли;	
	ИначеЕсли ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛицаКонтрагентов Тогда
		ТекКонтрагент = ОбъектСобытия.Владелец;
		ТекКонтактноеЛицо = ОбъектСобытия;
	ИначеЕсли ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛица Тогда
		ТекКонтактноеЛицоБезКонтрагента = ОбъектСобытия;
		ТекКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
		ТекКонтактноеЛицо = Справочники.КонтактныеЛица.ПустаяСсылка();
	Иначе
		ТекКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
		ТекКонтактноеЛицо = "";
	КонецЕсли;
КонецПроцедуры

Процедура Э_ЗаполнитьКонтрагентаКонтактноеЛицо(ДокОбъект,НомерТелефона,ВидОбъектаКонтактнойИнформации,Э_ПерезаполнятьЕслиНеПустое=Ложь)
	ОбъектСобытия = Э_ТелефонияBinotel.Э_ОбъектСобытияПоНомеруТелефона(НомерТелефона, ВидОбъектаКонтактнойИнформации);
	ТекКонтрагент=Неопределено;
	ТекКонтактноеЛицо=Неопределено;
	ТекКонтактноеЛицоБезКонтрагента=Неопределено;
	Если ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.Контрагенты Тогда
		ТекКонтрагент = ОбъектСобытия;
		ТекКонтактноеЛицо = Справочники.КонтактныеЛицаКонтрагентов.ПустаяСсылка();
	ИначеЕсли ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛицаКонтрагентов Тогда
		ТекКонтрагент = ОбъектСобытия.Владелец;
		ТекКонтактноеЛицо = ОбъектСобытия;
	ИначеЕсли ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛица Тогда
		ТекКонтактноеЛицоБезКонтрагента = ОбъектСобытия;
		ТекКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
		ТекКонтактноеЛицо = Справочники.КонтактныеЛица.ПустаяСсылка();
	Иначе
		ТекКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
		ТекКонтактноеЛицо = "";
	КонецЕсли;
    Если ЗначениеЗаполнено(ТекКонтрагент) и ((ЗначениеЗаполнено(ДокОбъект.Контрагент) и ДокОбъект.Контрагент<>ТекКонтрагент и Э_ПерезаполнятьЕслиНеПустое) или 
		 (Не ЗначениеЗаполнено(ДокОбъект.Контрагент))) Тогда 
         ДокОбъект.Контрагент=ТекКонтрагент;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ТекКонтактноеЛицо) и ((ЗначениеЗаполнено(ДокОбъект.КонтактноеЛицо) и ДокОбъект.КонтактноеЛицо<>ТекКонтактноеЛицо и Э_ПерезаполнятьЕслиНеПустое) или 
		 (Не ЗначениеЗаполнено(ДокОбъект.КонтактноеЛицо))) Тогда
		 ДокОбъект.КонтактноеЛицо=ТекКонтактноеЛицо;
	КонецЕсли;	
	Если ЗначениеЗаполнено(ТекКонтактноеЛицоБезКонтрагента) и ((ЗначениеЗаполнено(ДокОбъект.КонтактноеЛицоБезКонтрагента) и ДокОбъект.КонтактноеЛицоБезКонтрагента<>ТекКонтактноеЛицоБезКонтрагента и Э_ПерезаполнятьЕслиНеПустое) или 
		 (Не ЗначениеЗаполнено(ДокОбъект.КонтактноеЛицоБезКонтрагента))) Тогда
		 ДокОбъект.КонтактноеЛицоБезКонтрагента=ТекКонтактноеЛицоБезКонтрагента;
    КонецЕсли;	
	
КонецПроцедуры	
 
Процедура Э_ОбновитьСобытиеЕслиНеПерезаписатьВсеПоля(ДокОбъект,ПараметрыЗвонка,Э_НастройкиБинотел) Экспорт
	Перем  ТекНачалоСобытия,Э_КвоСекундРазговора,ТекОкончаниеСобытия,ТекCRM_Трудозатраты;
	
	ТекНачалоСобытия = Дата_формат1С(ПараметрыЗвонка.startTime,Э_НастройкиБинотел.Э_BinotelЧасовойПояс);
	Если ДокОбъект.НачалоСобытия<>ТекНачалоСобытия Тогда
		ДокОбъект.НачалоСобытия=ТекНачалоСобытия;
	КонецЕсли;	
	
	Попытка
		Э_КвоСекундРазговора=Число(ПараметрыЗвонка.billsec);
	исключение
		Э_КвоСекундРазговора=0;
	КонецПопытки;	
	Если ПараметрыЗвонка.Свойство("billsec") и Э_КвоСекундРазговора>0 Тогда
		ТекОкончаниеСобытия = ТекНачалоСобытия + Э_КвоСекундРазговора;
	иначе
		//Э_NCT(11.05.2019 00:31:49 www.nct.ua 
		//ТекОкончаниеСобытия = ТекНачалоСобытия+60;
		ТекОкончаниеСобытия = ТекНачалоСобытия;
		//Э_NCT) 
	КонецЕсли;
	Если ДокОбъект.ОкончаниеСобытия<>ТекОкончаниеСобытия Тогда
		Если ТекОкончаниеСобытия>ТекНачалоСобытия Тогда
		     ДокОбъект.ОкончаниеСобытия=ТекОкончаниеСобытия;
		иначе
			 //Э_NCT(11.05.2019 00:32:02 www.nct.ua 
			 //ДокОбъект.ОкончаниеСобытия=ДокОбъект.НачалоСобыти+60;  //прибавляем 1 минуту
			 ДокОбъект.ОкончаниеСобытия=ДокОбъект.НачалоСобытия;  
			 //Э_NCT) 
		Конецесли;	 
	КонецЕсли;	
	ТекCRM_Трудозатраты = Окр((ДокОбъект.ОкончаниеСобытия - ТекНачалоСобытия)/3600,3);
	Если ДокОбъект.CRM_Трудозатраты<>ТекCRM_Трудозатраты Тогда
		ДокОбъект.CRM_Трудозатраты=ТекCRM_Трудозатраты;
	КонецЕсли;	
	Если ДокОбъект.ЭтоНовый() или Не ЗначениеЗаполнено(ДокОбъект.Дата) или ДокОбъект.Дата <> ТекНачалоСобытия Тогда
		ДокОбъект.Дата = ТекНачалоСобытия;
	КонецЕсли;
	ЭтоЭ_ПропущенныйЗвонок=ПараметрыЗвонка.Свойство("billsec") и Э_КвоСекундРазговора=0 и Не ПараметрыЗвонка.Свойство("smsContent");
	Если ЭтоЭ_ПропущенныйЗвонок и Не ДокОбъект.Э_ПропущенныйЗвонок Тогда
		ДокОбъект.Э_ПропущенныйЗвонок=Истина;
	иначеЕсли не ЭтоЭ_ПропущенныйЗвонок и ДокОбъект.Э_ПропущенныйЗвонок Тогда	
		ДокОбъект.Э_ПропущенныйЗвонок=Ложь;
	КонецЕсли;	
КонецПроцедуры

Функция Э_ОпределитьНашНомерТелефона(ПараметрыЗвонка)
	Перем Э_НашНомерТелефона,ЭтоВходящееСобытие;
	Э_НашНомерТелефона="";
	ЭтоВходящееСобытие = ?(ПараметрыЗвонка.callType="0", Истина, Ложь);
	Если ЭтоВходящееСобытие Тогда
		Если ЗначениеЗаполнено(СокрЛП(ПараметрыЗвонка.didName)) Тогда
		    Э_НашНомерТелефона=СокрЛП(ПараметрыЗвонка.didName);
		иначеЕсли ЗначениеЗаполнено(СокрЛП(ПараметрыЗвонка.did)) Тогда
		    Э_НашНомерТелефона=СокрЛП(ПараметрыЗвонка.did);
		КонецЕсли;	
	иначе
		Э_НашНомерТелефона=СокрЛП(ПараметрыЗвонка.trunkNumber);
	КонецЕсли;
    Возврат Э_НашНомерТелефона;
КонецФункции // Э_ОпределитьНашНомерТелефона()
 
// Заполняет документы "Событие" данными о звонке
//
//  Параметр "Звонки" имеет тип "Соответствие"
Процедура Э_ЗаполнитьСобытие(ДокОбъект, ПараметрыЗвонка,Э_НастройкиБинотел) Экспорт 
	Перем ВидОбъектаКонтактнойИнформации,НомерТелефона,ОписаниеСобытия,СодержаниеСобытия,ТекТипСобытия,ТекНачалоСобытия;
	Перем Э_КвоСекундРазговора,ТекОкончаниеСобытия,ТекCRM_Трудозатраты,ТекИсточникИнформацииПриОбращении;
	Перем ТекОтветственный, ОбъектСобытия, ТекВидОбъекта, СловоТелефонКратко; 
	
	СловоТелефонКратко="Тел.:";

	Если Э_НастройкиБинотел=Неопределено Тогда
	    Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Не заполнены настройки по синхронизации с ""Бинотел""';uk='Не заповнені налаштування по синхронізації з ""Бінотел""'")); 
		Возврат;
	КонецЕсли; 
	
	
	ОписаниеСобытия = "";
	Если ПараметрыЗвонка.Свойство("smsContent") и Не ДокОбъект.Э_SMSСообщение Тогда
		СодержаниеСобытия=ПараметрыЗвонка.smsContent;
		ДокОбъект.Э_SMSСообщение=Истина;
	иначе
		СодержаниеСобытия = "";
	 	
	КонецЕсли;	
		 
	
	Если СокрЛП(ДокОбъект.Э_CallIDЗвонкаBinotel) <> СокрЛП(ПараметрыЗвонка.CallID) Тогда
	    ДокОбъект.Э_CallIDЗвонкаBinotel = ПараметрыЗвонка.CallID;
	КонецЕсли;
	Если ДокОбъект.ВидСобытия <> Перечисления.ВидыСобытий.ТелефонныйЗвонок Тогда
	    ДокОбъект.ВидСобытия = Перечисления.ВидыСобытий.ТелефонныйЗвонок;
	КонецЕсли;
	
	ТекТипСобытия = ?(ПараметрыЗвонка.callType="0", Перечисления.ВходящееИсходящееСобытие.Входящее, Перечисления.ВходящееИсходящееСобытие.Исходящее);
	Если ДокОбъект.ТипСобытия<>ТекТипСобытия Тогда
		ДокОбъект.ТипСобытия=ТекТипСобытия;
	КонецЕсли;	
	Если ДокОбъект.СостояниеСобытия<>Перечисления.СостоянияСобытий.Завершено Тогда
	    ДокОбъект.СостояниеСобытия=Перечисления.СостоянияСобытий.Завершено;
	КонецЕсли;
	
	Э_ОбновитьСобытиеЕслиНеПерезаписатьВсеПоля(ДокОбъект,ПараметрыЗвонка,Э_НастройкиБинотел);
	
    Э_НашНомерТелефона=Э_ОпределитьНашНомерТелефона(ПараметрыЗвонка);
	Если СокрЛП(ДокОбъект.Э_НашНомерТелефона)<>Э_НашНомерТелефона Тогда
	    ДокОбъект.Э_НашНомерТелефона=Э_НашНомерТелефона;
	КонецЕсли;	
		
    Если ДокОбъект.ТипСобытия=Перечисления.ВходящееИсходящееСобытие.Входящее Тогда
		ТекИсточникИнформацииПриОбращении = Э_ТелефонияBinotel.Э_ИсточникИнформацииПоНомеруТелефона(ДокОбъект.Э_НашНомерТелефона, ДокОбъект.Дата);
		Если ДокОбъект.ИсточникИнформацииПриОбращении<>ТекИсточникИнформацииПриОбращении Тогда
		     ДокОбъект.ИсточникИнформацииПриОбращении=ТекИсточникИнформацииПриОбращении;
		КонецЕсли;
	КонецЕсли;
	
	//Э_Волощук (23.07.2019 17:03:55
	//Если ПараметрыЗвонка.callType="0" Тогда // входящий
	//	НомерТелефона = ПараметрыЗвонка.dstNumbers[0].dstNumber;
	//	Если Найти(НомерТелефона, ">") > 0 Тогда
	//		НомерТелефона = Прав(НомерТелефона, Э_НастройкиБинотел.Э_BinotelДлинаВнутреннегоНомераТелефона);
	//	ИначеЕсли Не ЗначениеЗаполнено(НомерТелефона) Тогда
	//		НомерТелефона = СокрЛП(ПараметрыЗвонка.did);
	//	КонецЕсли;
	//ИначеЕсли ПараметрыЗвонка.callType="1" Тогда // исходящий
	//	НомерТелефона = ПараметрыЗвонка.srcNumber;
	//КонецЕсли;
	
	НомерТелефона = Э_ОпределитьВнутреннийНомерТелефона(ПараметрыЗвонка, Э_НастройкиБинотел);
	//Э_Волощук)
	
	
	ТекОтветственный = Э_ТелефонияBinotel.Э_ОпределитьПользователяВБазе1С(ПараметрыЗвонка.employeeEmail, НомерТелефона);
		
	Если НЕ ЗначениеЗаполнено(ТекОтветственный) Тогда
		ОписаниеСобытия = ОписаниеСобытия + "Тел. внутр.: "+НомерТелефона+"; "   
	КонецЕсли;
	
	
	
	НомерТелефона=Э_ОпределитьНомерТелефонаКонтрагента(ПараметрыЗвонка);
		
	Если ПараметрыЗвонка.Свойство("customerData") и ЗначениеЗаполнено(ПараметрыЗвонка.customerData) Тогда
		ОбъектСобытия = Э_ТелефонияBinotel.Э_ПоискКонтактаВБазе1С(ПараметрыЗвонка.customerData.id, ВидОбъектаКонтактнойИнформации,,Э_НастройкиБинотел);
	КонецЕсли;
	Если ОбъектСобытия = Неопределено Тогда
		ОбъектСобытия = Э_ТелефонияBinotel.Э_ОбъектСобытияПоНомеруТелефона(НомерТелефона, ВидОбъектаКонтактнойИнформации, ?(Э_НастройкиБинотел.Э_BinotelВыводитьВСобытииКонтактыНайденныеПоТелефонуЕслиБольшеОдного,СодержаниеСобытия,""));
	КонецЕсли;	
		
	
	Если СокрЛП(ДокОбъект.Э_ТелефонАбонента)<>СокрЛП(НомерТелефона) Тогда
	     ДокОбъект.Э_ТелефонАбонента=НомерТелефона;
	КонецЕсли;	 
	
	Если ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.Контрагенты Тогда
		ТекВидОбъекта = Перечисления.ВидыОбъектовСобытия.Контрагент;
	ИначеЕсли ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛицаКонтрагентов Тогда
		ТекВидОбъекта = Перечисления.ВидыОбъектовСобытия.Контрагент;
	ИначеЕсли ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛица Тогда
		ТекВидОбъекта = Перечисления.ВидыОбъектовСобытия.ПрочиеКонтактныеЛица;
	Иначе
		ТекВидОбъекта = Перечисления.ВидыОбъектовСобытия.Контрагент;
		ОписаниеСобытия = ОписаниеСобытия + СловоТелефонКратко+НомерТелефона+"; "
	КонецЕсли;
	Если ДокОбъект.ВидОбъекта<>ТекВидОбъекта Тогда
	    ДокОбъект.ВидОбъекта=ТекВидОбъекта;
	КонецЕсли;
	Э_ЗаполнитьКонтрагентаКонтактноеЛицо(ДокОбъект,НомерТелефона,ВидОбъектаКонтактнойИнформации,истина);
	Если Э_НастройкиБинотел.Э_BinotelУправлениеЛидами Тогда
		 
		 Если Не ЗначениеЗаполнено(ДокОбъект.Контрагент) Тогда
			Если ПараметрыЗвонка.Свойство("customerData") и ЗначениеЗаполнено(ПараметрыЗвонка.customerData) Тогда
			     Э_НазваниеКлиентаВВиртуальнойАТС=ПараметрыЗвонка.customerData.Name;
				 CustomerIDВиртуальнойАТС        =ПараметрыЗвонка.customerData.id;
			иначе
				 Э_НазваниеКлиентаВВиртуальнойАТС="";
				 CustomerIDВиртуальнойАТС        ="";
			КонецЕсли;
		 иначе
			Э_НазваниеКлиентаВВиртуальнойАТС=СокрЛП(ДокОбъект.Контрагент);
		 Конецесли;	
		 Э_ТекЛид=Э_УправлениеЛидами.Э_СоздатьНайтиЛид(НомерТелефона,ДокОбъект.Контрагент,Э_НазваниеКлиентаВВиртуальнойАТС,,,,,ТекОтветственный,ДокОбъект.ИсточникИнформацииПриОбращении,CustomerIDВиртуальнойАТС);
		  
		 Если ДокОбъект.Э_Лид <> Э_ТекЛид Тогда
		     ДокОбъект.Э_Лид=Э_ТекЛид;
		 КонецЕсли;	 
	КонецЕсли;
	
	//Э_Волощук (25.02.2019 16:05:57
	Если ДокОбъект.Э_SMSСообщение И ДокОбъект.ТипСобытия = Перечисления.ВходящееИсходящееСобытие.Входящее Тогда
		Если ЗначениеЗаполнено(ДокОбъект.Контрагент)
			И ТипЗнч(ДокОбъект.Контрагент) = Тип("СправочникСсылка.Контрагенты")
			И ЗначениеЗаполнено(ДокОбъект.Контрагент.ОсновнойМенеджерПокупателя) Тогда
			ТекОтветственный = ДокОбъект.Контрагент.ОсновнойМенеджерПокупателя;
		Иначе
			ТекОтветственный = Справочники.Пользователи.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	//Э_Волощук)
	
	Если ДокОбъект.Ответственный <> ТекОтветственный Тогда
		 ДокОбъект.Ответственный = ТекОтветственный
	КонецЕслИ;
	
	Если Не ЗначениеЗаполнено(ДокОбъект.ОписаниеСобытия) и СокрЛП(ДокОбъект.ОписаниеСобытия) <> СокрЛП(ОписаниеСобытия) Тогда
	     ДокОбъект.ОписаниеСобытия = ОписаниеСобытия;
	КонецЕсли;	 
	
	 
	Если Не ЗначениеЗаполнено(ДокОбъект.СодержаниеСобытия) и СокрЛП(ДокОбъект.СодержаниеСобытия) <> СокрЛП(СодержаниеСобытия) Тогда
	     ДокОбъект.СодержаниеСобытия = СодержаниеСобытия;
	КонецЕсли;	
	 
	
	
	Если Э_НастройкиБинотел.Э_BinotelСоздаватьЗадачиНапоминанияПоПропущеннымЗвонкам
		и ДокОбъект.ЭтоНовый()
		 
		и ДокОбъект.ТипСобытия = Перечисления.ВходящееИсходящееСобытие.Входящее
		и НачалоДня(ДокОбъект.Дата) = НачалоДня(ТекущаяДата())
		и ЗначениеЗаполнено(ДокОбъект.Ответственный) Тогда
		Попытка
			Э_КвоСекундРазговора=Число(ПараметрыЗвонка.billsec);
		исключение
			Э_КвоСекундРазговора=0;
		КонецПопытки;	
		
		Если ПараметрыЗвонка.Свойство("billsec") и Э_КвоСекундРазговора=0 и
		     Метаданные.Задачи.Найти("ЗадачиПользователя")<>Неопределено Тогда
			Э_СоздатьЗадачуПоНесостоявшемусяЗвонку(ДокОбъект,ДокОбъект.НачалоСобытия,ДокОбъект.Контрагент,ДокОбъект.КонтактноеЛицо,?(Э_НастройкиБинотел.Э_BinotelУправлениеЛидами,ДокОбъект.Э_Лид,Неопределено));
	    КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

Процедура Э_ЗаписатьНовоеСобытие(ПараметрыЗвонка,Э_НастройкиБинотел) Экспорт 
	ДокОбъектСобытие = Документы.Событие.СоздатьДокумент();
	
	ДокОбъектСобытие.УстановитьСсылкуНового(Документы.Событие.ПолучитьСсылку(Новый УникальныйИдентификатор()));	
	
	Э_ЗаполнитьСобытие(ДокОбъектСобытие, ПараметрыЗвонка,Э_НастройкиБинотел);	
	Если ДокОбъектСобытие.Модифицированность() Тогда
		Попытка
			ДокОбъектСобытие.Записать(РежимЗаписиДокумента.Запись);
			#Если Не Клиент Тогда
			//ЗаписьЖурналаРегистрации("Виртуальная АТС", УровеньЖурналаРегистрации.Информация, ,ДокОбъектСобытие.Ссылка,"Binotel IP-телефония:Запись нового события");  //bsoft (21.08.2024)
			#КонецЕсли
		    Э_СобытиеУспешноЗаписано=Истина;
		Исключение
			Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Не удалось записать событие с ID в виртуальной АТС: ';uk='Не вдалося записати подію з ID в віртуальній АТС: '")+ПараметрыЗвонка.CallID+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки()); 
			Э_СобытиеУспешноЗаписано=Ложь;
		КонецПопытки;
		//Э_NCT(01.08.2019 00:34:00 www.nct.ua 
		Если Э_СобытиеУспешноЗаписано Тогда  //проведем событие
			Попытка
				ДокОбъектСобытие.Записать(РежимЗаписиДокумента.Проведение);
				#Если Не Клиент Тогда
				//ЗаписьЖурналаРегистрации("Виртуальная АТС", УровеньЖурналаРегистрации.Информация, ,ДокОбъектСобытие.Ссылка,"Binotel IP-телефония:Проведение нового события") ;  //bsoft (21.08.2024)
				#КонецЕсли
			Исключение
				Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Не удалось провести новое событие с ID в виртуальной АТС: ';uk='Не вдалося провести нову подію з ID в віртуальній АТС: '")+ПараметрыЗвонка.CallID+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки()); 
			КонецПопытки;
		КонецЕсли;
		//Э_NCT) 
	КонецЕсли;
КонецПроцедуры

// Записывает документы "Событие" в базу
//
//  Параметр "Звонки" имеет тип "Соответствие"
Процедура Э_СформироватьСобытия(НачПериода,ЗвонкиДетали, ПерезаписатьВсеПоля=Ложь) Экспорт
	Перем ПараметрыЗвонка,ТекCallID,ДокСобытие,ДокОбъектСобытие;
	Перем ТекНачалоСобытия,ТекОкончаниеСобытия,ВидОбъектаКонтактнойИнформации,НомерТелефона;
	
	Э_НастройкиБинотел=Э_ПолучитьНастройкиБинотел();
	Если Э_НастройкиБинотел=Неопределено Тогда
	     Возврат;
	КонецЕсли;
	
	ВсегоЗвонков=ЗвонкиДетали.Количество();
	КоличествоСтрокОбработано=0;
	Для каждого Звонок Из ЗвонкиДетали Цикл
		
		#Если Клиент Тогда
		КоличествоСтрокОбработано=КоличествоСтрокОбработано+1;
		КоличествоСтрокОбработаноПроцент=КоличествоСтрокОбработано*100/ВсегоЗвонков;	
		Состояние("Обработано записей "+Окр(КоличествоСтрокОбработаноПроцент,0)+" %");	
	    #КонецЕсли
	    	 

		Если ТипЗнч(Звонок) = Тип("Структура") Тогда
			ПараметрыЗвонка = Звонок;
		Иначе
			ПараметрыЗвонка = Звонок.Значение;
		КонецЕсли;
		
		ТекCallID = "";
		Если НЕ ПараметрыЗвонка.Свойство("callID", ТекCallID) Тогда
			Продолжить;
		КонецЕсли;	
		 
		
		 
		ВидОбъектаКонтактнойИнформации="";
		НомерТелефона=Э_ОпределитьНомерТелефонаКонтрагента(ПараметрыЗвонка);
		
		//Э_Волощук (23.07.2019 16:56:09
		////Э_Волощук (10.12.2018 15:50:43
		//Э_НашНомерТелефона=Э_ОпределитьНашНомерТелефона(ПараметрыЗвонка);
		//Если ЗначениеЗаполнено(Э_НастройкиБинотел.Э_СписокВнутреннихТелефоновПоКоторымНеЗагружатьЗвонки) и ЗначениеЗаполнено(Э_НашНомерТелефона) и Найти(Э_НастройкиБинотел.Э_СписокВнутреннихТелефоновПоКоторымНеЗагружатьЗвонки,СокрЛП(Э_НашНомерТелефона))>0 Тогда
		//	Продолжить;
		//КонецЕсли;
		
		ВнутреннийНомерТелефона = Э_ОпределитьВнутреннийНомерТелефона(ПараметрыЗвонка, Э_НастройкиБинотел);
		
		Если ЗначениеЗаполнено(Э_НастройкиБинотел.Э_СписокВнутреннихТелефоновПоКоторымНеЗагружатьЗвонки) и ЗначениеЗаполнено(ВнутреннийНомерТелефона) и Найти(Э_НастройкиБинотел.Э_СписокВнутреннихТелефоновПоКоторымНеЗагружатьЗвонки,СокрЛП(ВнутреннийНомерТелефона))>0 Тогда
			Продолжить;
		КонецЕсли;
		//Э_Волощук)
		ДокСобытие = Э_НайтиСобытие(НачПериода,ТекCallID,НомерТелефона,ВидОбъектаКонтактнойИнформации,Э_НастройкиБинотел);
		 

		Если ЗначениеЗаполнено(ДокСобытие) Тогда
			 
			#Если Не Клиент Тогда
			//ЗаписьЖурналаРегистрации("Виртуальная АТС", УровеньЖурналаРегистрации.Информация, ,ДокСобытие,"Binotel IP-телефония:Изменение существующего события"); //bsoft (21.08.2024)
			#КонецЕсли
	         
			ДокОбъектСобытие = ДокСобытие.ПолучитьОбъект();
			Попытка
			    ДокОбъектСобытие.Заблокировать();
				ФлДОкументЗаблокирован=Истина;
			исключение
				ФлДОкументЗаблокирован=Ложь;
				#Если Клиент Тогда
				Состояние(НСтр("ru='Ошибка при попытке заблокировать ';uk='Помилка при спробі заблокувати '")+ДокСобытие+НСтр("ru='. Изменения не внесены.';uk='. Зміни не внесені.'"));   
				#КонецЕсли
			КонецПопытки;	
			Если ФлДОкументЗаблокирован Тогда
				Если ПерезаписатьВсеПоля Тогда
					Э_ЗаполнитьСобытие(ДокОбъектСобытие, ПараметрыЗвонка,Э_НастройкиБинотел);
				Иначе	
					Э_ОбновитьСобытиеЕслиНеПерезаписатьВсеПоля(ДокОбъектСобытие,ПараметрыЗвонка,Э_НастройкиБинотел);
					ВидОбъектаКонтактнойИнформации="";
					НомерТелефона=Э_ОпределитьНомерТелефонаКонтрагента(ПараметрыЗвонка);
					Э_ЗаполнитьКонтрагентаКонтактноеЛицо(ДокОбъектСобытие,НомерТелефона,ВидОбъектаКонтактнойИнформации,Ложь);
				КонецЕсли;
				Э_СобытиеУспешноЗаписано = Ложь;
				Если ДокОбъектСобытие.Модифицированность() Тогда
					Попытка
						ДокОбъектСобытие.Записать(РежимЗаписиДокумента.Запись);
						Э_СобытиеУспешноЗаписано=Истина;
					Исключение
						Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Не удалось записать событие с ID в виртуальной АТС:';uk='Не вдалося записати подію з ID в віртуальній АТС:'")+ПараметрыЗвонка.CallID+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки());       
						Э_СобытиеУспешноЗаписано=Ложь;
					КонецПопытки;
				КонецЕсли;	
				//Э_NCT(01.08.2019 00:36:46 www.nct.ua 
				Если Э_СобытиеУспешноЗаписано Тогда  //проведем событие
					Попытка
						ДокОбъектСобытие.Записать(РежимЗаписиДокумента.Проведение);
						#Если Не Клиент Тогда
						//ЗаписьЖурналаРегистрации("Виртуальная АТС", УровеньЖурналаРегистрации.Информация, ,ДокОбъектСобытие.Ссылка,"Binotel IP-телефония:Проведение нового события"); //bsoft (21.08.2024)
					    #КонецЕсли
					Исключение
						Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Не удалось провести измененное событие с ID в виртуальной АТС: ';uk='Не вдалося провести змінену подію з ID в віртуальній АТС: '")+ПараметрыЗвонка.CallID+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки()); 
					КонецПопытки;
				КонецЕсли;
				//Э_NCT) 
				ДокОбъектСобытие.Разблокировать();
			КонецЕсли;	
		Иначе
			Э_ЗаписатьНовоеСобытие(ПараметрыЗвонка,Э_НастройкиБинотел);
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры	

Процедура Э_ЗаписатьНовыйПотерянныйЗвонок(Э_ПотерянныеЗвонки,ПараметрыЗвонка,Э_НастройкиБинотел) Экспорт 
    перем ВидОбъектаКонтактнойИнформации, СодержаниеСобытия;
	
	НовСтр = Э_ПотерянныеЗвонки.Добавить();
	
    НовСтр.Э_CallIDЗвонкаBinotel = ПараметрыЗвонка.CallID;
	НовСтр.НомерТелефона=Э_ОпределитьНомерТелефонаКонтрагента(ПараметрыЗвонка);
	НовСтр.ВремяЗвонка = Дата_формат1С(ПараметрыЗвонка.startTime,Э_НастройкиБинотел.Э_BinotelЧасовойПояс);
	НовСтр.Комментарий = ПараметрыЗвонка.comment;
	
	НовСтр.ВремяОжиданияСоединения = Дата(1, 1, 1, 0, 0,0)+Число(ПараметрыЗвонка.waitsec) ; //Дата_формат1С(ПараметрыЗвонка.startTime);

	ОбъектСобытия = Э_ТелефонияBinotel.Э_ОбъектСобытияПоНомеруТелефона(НовСтр.НомерТелефона, ВидОбъектаКонтактнойИнформации, СодержаниеСобытия);
	ПараметрыЗвонка.Вставить("ВидОбъектаКонтактнойИнформации", ВидОбъектаКонтактнойИнформации);
	Если ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.Контрагенты Тогда
		НовСтр["Контрагент"] = ОбъектСобытия;
	ИначеЕсли ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛицаКонтрагентов Тогда
		НовСтр["Контрагент"] = ОбъектСобытия.Владелец;
		НовСтр["КонтактноеЛицо"]=ОбъектСобытия;
	ИначеЕсли ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛица Тогда
		НовСтр["КонтактноеЛицо"]= ОбъектСобытия;
	Иначе	
	КонецЕсли;

	НомерТелефонаСотрудникаКомуПервомуПозвонили="";
	КомуЗвонили="";
	Если ПараметрыЗвонка.Свойство("dstnumbers") и ТипЗнч(ПараметрыЗвонка.dstnumbers)=тип("Массив") и ПараметрыЗвонка.dstnumbers.Количество()>0 Тогда
		ПоследнееЗначениеМассива=ПараметрыЗвонка.dstnumbers[ПараметрыЗвонка.dstnumbers.Количество()-1];
		Для каждого ЗначениеМассива Из ПараметрыЗвонка.dstnumbers Цикл
			Если типЗнч(ЗначениеМассива)=Тип("Структура") и ЗначениеМассива.Свойство("dstNumber")Тогда
			    КомуЗвонили=ЗначениеМассива.dstNumber+?(ПустаяСтрока(КомуЗвонили),"","->")+КомуЗвонили;
			    Если ЗначениеМассива=ПоследнееЗначениеМассива Тогда
		             НомерТелефонаСотрудникаКомуПервомуПозвонили=ЗначениеМассива.dstNumber;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;                                     
	Если ЗначениеЗаполнено(КомуЗвонили) Тогда
	    НовСтр["КомуЗвонили"]= КомуЗвонили;
	КонецЕсли;
	Если НомерТелефонаСотрудникаКомуПервомуПозвонили="" Тогда
	     НомерТелефонаСотрудникаКомуПервомуПозвонили = ПараметрыЗвонка.internalNumber;					
	КонецЕсли; 
    НовСтр["Ответственный"]= Э_ТелефонияBinotel.Э_ПользовательПоНомеруТелефона(НомерТелефонаСотрудникаКомуПервомуПозвонили);

КонецПроцедуры

Процедура Э_ЗаписатьНовыйПотерянныйЗвонокВРегистр(ПараметрыЗвонка,Э_НастройкиБинотел) Экспорт 
    перем ВидОбъектаКонтактнойИнформации, СодержаниеСобытия;
	
	//Найдем основные значения для записи в регистр
	СтруктураПараметров = Новый Структура;
	
	//Э_Волощук (23.07.2019 17:09:42
	////Э_Волощук (22.07.2019 14:28:05
	////не записываем пропущенные с номеров, которые в настройках
	//Э_НашНомерТелефона=Э_ОпределитьНашНомерТелефона(ПараметрыЗвонка);
	//СтруктураПараметров.Вставить("Э_НашНомерТелефона", Э_НашНомерТелефона);
	//
	//Если ЗначениеЗаполнено(Э_НастройкиБинотел.Э_СписокВнутреннихТелефоновПоКоторымНеЗагружатьЗвонки) и ЗначениеЗаполнено(Э_НашНомерТелефона) и Найти(Э_НастройкиБинотел.Э_СписокВнутреннихТелефоновПоКоторымНеЗагружатьЗвонки,СокрЛП(Э_НашНомерТелефона))>0 Тогда
	//	Возврат;
	//КонецЕсли;
	////Э_Волощук)
	
	ВнутреннийНомерТелефона = Э_ОпределитьВнутреннийНомерТелефона(ПараметрыЗвонка, Э_НастройкиБинотел);
	
	Если ЗначениеЗаполнено(Э_НастройкиБинотел.Э_СписокВнутреннихТелефоновПоКоторымНеЗагружатьЗвонки) и ЗначениеЗаполнено(ВнутреннийНомерТелефона) и Найти(Э_НастройкиБинотел.Э_СписокВнутреннихТелефоновПоКоторымНеЗагружатьЗвонки,СокрЛП(ВнутреннийНомерТелефона))>0 Тогда
		Возврат;
	КонецЕсли;
	//Э_Волощук)
	
	СтруктураПараметров.Вставить("НомерТелефона", Э_ОпределитьНомерТелефонаКонтрагента(ПараметрыЗвонка));
		
	ОбъектСобытия = Э_ТелефонияBinotel.Э_ОбъектСобытияПоНомеруТелефона(СтруктураПараметров.НомерТелефона, ВидОбъектаКонтактнойИнформации, СодержаниеСобытия);
	ПараметрыЗвонка.Вставить("ВидОбъектаКонтактнойИнформации", ВидОбъектаКонтактнойИнформации);
	СтруктураПараметров.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	СтруктураПараметров.Вставить("КонтактноеЛицо", Справочники.КонтактныеЛицаКонтрагентов.ПустаяСсылка());
	Если ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.Контрагенты Тогда
		СтруктураПараметров.Контрагент = ОбъектСобытия;
	ИначеЕсли ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛицаКонтрагентов Тогда
		СтруктураПараметров.Контрагент = ОбъектСобытия.Владелец;
		СтруктураПараметров.КонтактноеЛицо = ОбъектСобытия;
	ИначеЕсли ВидОбъектаКонтактнойИнформации = Перечисления.ВидыОбъектовКонтактнойИнформации.КонтактныеЛица Тогда
		СтруктураПараметров.КонтактноеЛицо = ОбъектСобытия;
	Иначе	
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ВремяЗвонка", Дата_формат1С(ПараметрыЗвонка.startTime,Э_НастройкиБинотел.Э_BinotelЧасовойПояс));
	СтруктураПараметров.Вставить("ВремяОжиданияСоединения", Дата(1, 1, 1, 0, 0,0)+Число(ПараметрыЗвонка.waitsec));
	СтруктураПараметров.Вставить("Э_CallIDЗвонка", ПараметрыЗвонка.CallID);
	
	НомерТелефонаСотрудникаКомуПервомуПозвонили="";
	СтруктураПараметров.Вставить("КомуЗвонили","");
	Если ПараметрыЗвонка.Свойство("dstnumbers") и ТипЗнч(ПараметрыЗвонка.dstnumbers)=тип("Массив") и ПараметрыЗвонка.dstnumbers.Количество()>0 Тогда
		ПоследнееЗначениеМассива=ПараметрыЗвонка.dstnumbers[ПараметрыЗвонка.dstnumbers.Количество()-1];
		Для каждого ЗначениеМассива Из ПараметрыЗвонка.dstnumbers Цикл
			Если типЗнч(ЗначениеМассива)=Тип("Структура") и ЗначениеМассива.Свойство("dstNumber")Тогда
