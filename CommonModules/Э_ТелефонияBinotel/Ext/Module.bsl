	Э_BinotelPhoneLoc = Обработки.Э_BinotelPhone.Создать();
	ПрерватьИмпорт = Ложь;
		
	ТаблицаЗвонки = Новый ТаблицаЗначений;
	ТаблицаЗвонки.Колонки.Добавить("CallID");
	ТаблицаЗвонки.Колонки.Добавить("StartTime");
		
	КонецВыборкиПериод = КонПериодаUnix;
	Пока Не ПрерватьИмпорт Цикл
		ПолученУспешныйОтвет = Ложь;
		КоличествоПопыток = 3;
			
		Для счетчик = 1 По КоличествоПопыток Цикл
			Если счетчик <> 1 Тогда
				Пауза(12);
			КонецЕсли;
				
			Если ТипЗвонков = "входящие" Тогда
				result = Э_BinotelPhoneLoc.sendRequest("stats/incoming-calls-for-period", Новый Структура("startTime,stopTime",НачПериодаUnix,КонПериодаUnix),,ФоновоеЗадание);
			ИначеЕсли ТипЗвонков = "исходящие" Тогда
				result = Э_BinotelPhoneLoc.sendRequest("stats/outgoing-calls-for-period", Новый Структура("startTime,stopTime",НачПериодаUnix,КонПериодаUnix),,ФоновоеЗадание);
			КонецЕсли;
			СтруктураРезультат = Э_РаботаСJSON.Э_ПрочитатьJSON(result);
			Если ТипЗнч(СтруктураРезультат) = Тип("Структура") Тогда
				Если Найти(СтруктураРезультат["status"], "success") > 0 Тогда
					ПолученУспешныйОтвет = Истина;
					Прервать;
				Иначе
					Если счетчик = КоличествоПопыток Тогда
						Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Ошибка: ';uk='Помилка: '")+ Строка(СтруктураРезультат["code"])+", "+СтруктураРезультат["message"]);
					КонецЕсли;	
				КонецЕсли;
			Иначе
				Если счетчик = КоличествоПопыток Тогда
					Э_ТелефонияBinotel.СообщитьИнформацию(НСтр("ru='Ошибка. ';uk='Помилка. '")+Строка(result));   
					#Если Не Клиент Тогда
					Если ТипЗвонков = "входящие" Тогда	
						СообщениеОбОшибке="Ошибка выполнения команды ""Получение входящих звонков"": Результат выполнения ""stats/incoming-calls-for-period"":"+СокрЛП(result)+", результат работы JSON:"+СокрЛП(СтруктураРезультат)+". Начало периода:"+СокрЛП(НачПериода)+", конец периода:"+СокрЛП(КонПериода);
					ИначеЕсли ТипЗвонков = "исходящие" Тогда
						СообщениеОбОшибке="Ошибка выполнения команды ""Получение исходящих звонков"": Результат выполнения ""stats/outgoing-calls-for-period"":"+СокрЛП(result)+", результат работы JSON:"+СокрЛП(СтруктураРезультат)+". Начало периода:"+СокрЛП(НачПериода)+", конец периода:"+СокрЛП(КонПериода);
					КонецЕсли;
					//ЗаписьЖурналаРегистрации("Виртуальная АТС", УровеньЖурналаРегистрации.Ошибка,,,СообщениеОбОшибке );  //bsoft (21.08.2024)
					#КонецЕсли
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
			
		Если ПолученУспешныйОтвет Тогда
			СоответствиеЗвонки = СтруктураРезультат["callDetails"];
					
			ПрерватьИмпорт = Истина;
				
			МассивКлючейДляУдаления = Новый Массив;
			//Э_Волощук (04.07.2019 10:37:29
			КонецВыборкиИнтервала = 0;
			//Э_Волощук)
			Для Каждого запись Из СоответствиеЗвонки Цикл
				НайденныеСтроки = ТаблицаЗвонки.НайтиСтроки(Новый Структура("CallID", запись.Ключ));
						
				Если НайденныеСтроки.Количество() = 0 Тогда
					ПрерватьИмпорт = Ложь;
						
					НоваяСтрока = ТаблицаЗвонки.Добавить();
					НоваяСтрока.CallID = запись.Ключ;
					НоваяСтрока.StartTime = запись.Значение.Starttime;
						
					//Э_Волощук (04.07.2019 10:38:23
					//Если Число(НоваяСтрока.StartTime) < КонецВыборкиПериод Тогда
					//	КонецВыборкиПериод = Число(НоваяСтрока.StartTime);
					Если Число(НоваяСтрока.StartTime) > КонецВыборкиИнтервала Тогда
						КонецВыборкиИнтервала = Число(НоваяСтрока.StartTime);
					//Э_Волощук)
					КонецЕсли;
				Иначе
					МассивКлючейДляУдаления.Добавить(запись.Ключ);
				КонецЕсли;
			КонецЦикла;
			
			//Э_Волощук (04.07.2019 10:39:05
			Если КонецВыборкиИнтервала > 0 И КонецВыборкиИнтервала < КонецВыборкиПериод Тогда
				КонецВыборкиПериод = КонецВыборкиИнтервала;
			КонецЕсли;
			//Э_Волощук)
			
			Для Каждого стр Из МассивКлючейДляУдаления Цикл 
				СоответствиеЗвонки.Удалить(стр);
			КонецЦикла;
				
			Э_ТелефонияBinotel.Э_СформироватьСобытия(НачПериода,СоответствиеЗвонки, ПерезаписатьВсеПоля);
				
			Если Не ПрерватьИмпорт Тогда
				Пауза(12);
			КонецЕсли;
		Иначе
			ПрерватьИмпорт = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
