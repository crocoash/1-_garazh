// Процедура выполняет импорт звонков с сервера Binotel
//
Процедура Э_ИмпортВходящихЗвонковBinotel() Экспорт
	Перем НачПериода,НачПериодаЧасНазад,КонПериода;
		
	НачПериода = Э_ПолучитьДатуПоследнегоЗавершенногоЗвонка(Истина);
	//Э_NCT(10.05.2019	
	НачПериодаЧасНазад = ТекущаяДата() - (3600);
	Если НачПериода <> неопределено и НачПериодаЧасНазад<НачПериода Тогда
		 НачПериода=НачПериодаЧасНазад;
	//Э_NCT)
	иначеЕсли НачПериода = неопределено тогда
		 НачПериода = НачалоДня(ТекущаяДата());
	КонецЕсли;
		
	КонПериода = ТекущаяДата();
	
	Э_ПолучитьЗвонкиЗаПериод(НачПериода, КонПериода, Истина, Ложь,,ИСТИНА);
КонецПроцедуры

