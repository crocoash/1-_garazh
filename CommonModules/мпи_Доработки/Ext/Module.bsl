			УдалитьФайлы(ИмяФайлаОтвета);
		КонецЕсли;
		
		Соединение.ОтправитьДляОбработки(ИмяИсходящегоФайла, АдресСкриптаВыгрузка, ИмяФайлаОтвета, Заголовки);
			
		ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
		
		Если ФайлОтвета.Существует() Тогда
			
			ТекстОтвета = Новый ТекстовыйДокумент();
			ТекстОтвета.Прочитать(ИмяФайлаОтвета);
			Если ТекстОтвета.КоличествоСтрок()>0 Тогда
				ОтветСервера = ТекстОтвета.ПолучитьТекст();	
			Иначе
				Т = "Получен пустой ответ сервера.";
				Сообщить(Т);
				Рез.Вставить("Успешно",Ложь);
				Рез.Вставить("Сообщение",Т);
				Успешно = Ложь;
				Возврат Рез;
			КонецЕсли;	
			
		Иначе	
			Т = "Ответ сервера не получен.";
			Сообщить(Т);
			Рез.Вставить("Успешно",Ложь);
			Рез.Вставить("Сообщение",Т);
			Успешно = Ложь;
			Возврат Рез;
		КонецЕсли;
		
		ОбработкаОтвета(ИмяФайлаОтвета, НастройкиПодключений, ТабЧасть,Истина,, Успешно);
	КонецЦикла;
	//ОчисткаРегистрацииНовых(сп);
			
	Рез.Вставить("Успешно",Истина);	
	Возврат Рез;
	
	
КонецФункции	

Функция ПолучитьФорматированноеОписание (НомСсылка)
	
	Рез = "";
	ДетальноеОписание = НомСсылка.ФорматированноеОписание.Получить();
	НачТела = Найти (ДетальноеОписание,"<BODY>") + 6;
	КонТела = Найти (ДетальноеОписание,"/BODY");
	Если НЕ НачТела + КонТела = 0 Тогда
		ТелоОписания = Сред(ДетальноеОписание, НачТела, КонТела-НачТела-1);
		Рез = ТелоОписания;
	КонецЕсли;
	
	Возврат Рез;
КонецФункции

Процедура флПриЗаписиХранилищеДополнительнойИнформацииПриЗаписи(Источник, Отказ) Экспорт
	Товар = Источник.Объект;
	Если ТипЗнч(Товар)  <> Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат;
	КонецЕсли;	
	Если Не ЗначениеЗаполнено(Товар) Тогда
		Возврат;
	КонецЕсли;	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	сви_ИзмененияФотографийНоменклатуры.Номенклатура
	|ИЗ
	|	РегистрСведений.сви_ИзмененияФотографийНоменклатуры КАК сви_ИзмененияФотографийНоменклатуры
	|ГДЕ
	|	сви_ИзмененияФотографийНоменклатуры.Номенклатура = &Номенклатура";
	Запрос.УстановитьПараметр("Номенклатура", Товар);
	Если Запрос.Выполнить().Пустой() ТОгда
		МЗ = РегистрыСведений.сви_ИзмененияФотографийНоменклатуры.СоздатьМенеджерЗаписи();
		МЗ.Номенклатура = Товар;
		МЗ.Записать();
	КонецЕсли;	
КонецПроцедуры

