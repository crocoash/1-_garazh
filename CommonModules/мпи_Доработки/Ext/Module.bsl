Функция ПеревестиНаУкраинский(ФразаСтрока)
	ФразаСтрока_Перевод = ФразаСтрока;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокПереводов_СД.НаРуском,
		|	СписокПереводов_СД.НаУкраинском
		|ИЗ
		|	РегистрСведений.СписокПереводов_СД КАК СписокПереводов_СД";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ФразаСтрока_Перевод = СтрЗаменить(ФразаСтрока_Перевод,ВыборкаДетальныеЗаписи.НаРуском,ВыборкаДетальныеЗаписи.НаУкраинском);
	КонецЦикла;
	
	Возврат ФразаСтрока_Перевод;		
КонецФункции

Процедура ПроверкаУстановленыхКатегорийДляСайта() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.Номенклатура,
		|	ВложенныйЗапрос.Значение,
		|	ВложенныйЗапрос.Количество
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВложенныйЗапрос.Номенклатура КАК Номенклатура,
		|		ЕСТЬNULL(мпи_ЗначенияКатегорийНоменклатуры.Значение, """") КАК Значение,
		|		ВложенныйЗапрос.Количество КАК Количество
		|	ИЗ
		|		(ВЫБРАТЬ
		|			ВложенныйЗапрос.Номенклатура КАК Номенклатура,
		|			СУММА(ВложенныйЗапрос.Количество) КАК Количество
		|		ИЗ
		|			(ВЫБРАТЬ
		|				ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
		|				СУММА(ТоварыНаСкладахОстаткиИОбороты.КоличествоКонечныйОстаток) КАК Количество
		|			ИЗ
		|				РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(&Дата, &Дата, , , ) КАК ТоварыНаСкладахОстаткиИОбороты
		|			
		|			СГРУППИРОВАТЬ ПО
		|				ТоварыНаСкладахОстаткиИОбороты.Номенклатура
		|			
		|			ОБЪЕДИНИТЬ ВСЕ
		|			
		|			ВЫБРАТЬ
		|				ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура,
		|				ЦеныНоменклатурыКонтрагентовСрезПоследних.Остаток
		|			ИЗ
		|				РегистрСведений.ЦеныНоменклатурыКонтрагентов.СрезПоследних(, ) КАК ЦеныНоменклатурыКонтрагентовСрезПоследних
		|			
		|			СГРУППИРОВАТЬ ПО
		|				ЦеныНоменклатурыКонтрагентовСрезПоследних.Номенклатура,
		|				ЦеныНоменклатурыКонтрагентовСрезПоследних.Остаток) КАК ВложенныйЗапрос
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ВложенныйЗапрос.Номенклатура) КАК ВложенныйЗапрос
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.мпи_ЗначенияКатегорийНоменклатуры КАК мпи_ЗначенияКатегорийНоменклатуры
		|			ПО ВложенныйЗапрос.Номенклатура = мпи_ЗначенияКатегорийНоменклатуры.НоменклатураОбъект) КАК ВложенныйЗапрос
		|ГДЕ
		|	ВложенныйЗапрос.Значение = """"";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Номенклатура.ВидНоменклатуры.КатегорияСайтаХорошоп_СД) Тогда
			Продолжить;
		КонецЕсли;
		ПолНом = ВыборкаДетальныеЗаписи.Номенклатура.ПолучитьОбъект();
		ПолНом.Активная_СайтХорошоп_СД = истина;
		ПолНом.Записать();
		
		МЗ = РегистрыСведений.мпи_ЗначенияКатегорийНоменклатуры.СоздатьМенеджерЗаписи();
		МЗ.ВидКатегории = ВыборкаДетальныеЗаписи.Номенклатура.ВидНоменклатуры.КатегорияСайтаХорошоп_СД.Владелец;
		МЗ.Значение = ВыборкаДетальныеЗаписи.Номенклатура.ВидНоменклатуры.КатегорияСайтаХорошоп_СД;
		МЗ.НоменклатураОбъект = ВыборкаДетальныеЗаписи.Номенклатура;
		МЗ.Основная = Истина;
		МЗ.Записать(); 
		
		#Если Клиент Тогда
			Сообщить("Установлена категория " + ВыборкаДетальныеЗаписи.Номенклатура.ВидНоменклатуры.КатегорияСайтаХорошоп_СД + " для товара " + ВыборкаДетальныеЗаписи.Номенклатура);
		#КонецЕсли	
	КонецЦикла;
	
	
КонецПроцедуры

Процедура Гараж_СенсорныйЕкран_СДДействие() Экспорт
	ПроверкаУстановленыхКатегорийДляСайта();
КонецПроцедуры
