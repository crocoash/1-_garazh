	ОбъектыДляСнятияСРегистрации = Новый Массив;
	
	Для Каждого ТекСтрТоваров Из ТаблТоваров ЦИкл
		СтрокиТекТовара = ТаблКартинок.НайтиСтроки(Новый Структура("КодСинхронизации", ТекСтрТоваров.КодСинхронизации));
		ИндексФайла = 0;
		ДЛя Каждого ТекСтр Из СтрокиТекТовара ЦИкл
			//Если ОбъектыДляСнятияСРегистрации.Найти(ТекСтр.Объект) = Неопределено ТОгда
			//	ОбъектыДляСнятияСРегистрации.Добавить(ТекСтр.Объект);
			//КонецЕсли;	
			Данные = ТекСтр.Хранилище.Получить();
			Расширение = "";
			Если ТипЗнч(Данные) = Тип("Картинка") Тогда
				ДвоичныеДанные = Данные.ПОлучитьДвоичныеДанные();
				ФОрматТекКартинки = Данные.Формат();
				Если ФОрматТекКартинки = ФорматКартинки.BMP ТОгда
					Расширение = "bmp";
				ИначеЕсли  ФОрматТекКартинки = ФорматКартинки.GIF ТОгда
					Расширение = "gif";
				ИначеЕсли  ФОрматТекКартинки = ФорматКартинки.JPEG ТОгда
					Расширение = "jpg";
				ИначеЕсли  ФОрматТекКартинки = ФорматКартинки.PNG ТОгда
					Расширение = "png";
				КонецЕсли;	
			ИначеЕсли ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
				ДвоичныеДанные = Данные;
			Иначе
				Продолжить;
			КонецЕсли;
			Если Расширение = "" Тогда
				Длина = СтрДлина(ТекСтр.ИмяФайла);
				ДЛя хх = 0 По Длина - 1 ЦИкл
					ТекСИмвол = Сред(ТекСтр.ИмяФайла, Длина - хх, 1);
					Если ТекСИмвол = "." ТОгда
						Расширение = Прав(ТекСтр.ИмяФайла, хх);
						Прервать;
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;	
			Если Расширение = "" ТОгда
				Продолжить;
			КонецЕсли;	
			
			ИмяВыходногоФайла = СокрЛП(ТекСтрТоваров.КодСинхронизации);
			Если ИндексФайла > 0 Тогда
				ИмяВыходногоФайла = ИмяВыходногоФайла + "@" + Формат(ИндексФайла, "ЧГ=");
			КонецЕсли;	
			ИмяВыходногоФайла = ИмяВыходногоФайла + "." + Расширение;
			
			ЛокФайл = Каталог + ИмяВыходногоФайла;
			ДвоичныеДанные.Записать(ЛокФайл);
			
			ТекСтр.ИмяФайла = ИмяВыходногоФайла;
			
			ИндексФайла = ИндексФайла + 1;
			
			transferResult = session.PutFiles(ЛокФайл, ИмяВыходногоФайла);
			transferResult.Check();

			Если transferResult.IsSuccess  = Истина Тогда
				ТекСтр.Успешно = Истина;
			КонецЕсли;	
			
		КонецЦикла;	
	КонецЦикла;	
	
	Рез = Новый Структура;
	Рез.Вставить("Успешно",Ложь);
	Рез.Вставить("Сообщение","");
	
	ИмяРеквизитаИдентификатора = СокрЛП(СхемаОбмена.РеквизитИдентификацииНоменклатуры);
	
	ТокенРез = ПолучитьТокен_Хорошоп(НастройкиПодключения); 
	Если ТокенРез.Статус = "OK" Тогда
		ТокенСтр = ТокенРез.Токен; 
	Иначе
		Сообщить(ТокенРез.Сообщение);
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
		ИмяИсходящегоФайла = СхемаОбмена.ПапкаФайлаЛога + "hs_images.json";
	Иначе
		ИмяИсходящегоФайла = ПолучитьИмяВременногоФайла("json");
	КонецЕсли;
	
	ЗаписьДЖС = Новый ЗаписьJSON;
	ЗаписьДЖС.ПроверятьСтруктуру = Истина;
	ПараметрыЗаписиДЖС = Новый ПараметрыЗаписиJSON(,Символы.Таб);
	ЗаписьДЖС.ОткрытьФайл(ИмяИсходящегоФайла,КодировкаТекста.UTF8,Ложь,ПараметрыЗаписиДЖС);
	
	ЗаписьДЖС.ЗаписатьНачалоОбъекта();
	ЗаписьДЖС.ЗаписатьИмяСвойства("token");
	ЗаписьДЖС.ЗаписатьЗначение(ТокенСтр);
	ЗаписьДЖС.ЗаписатьИмяСвойства("removePrevImages");
	ЗаписьДЖС.ЗаписатьЗначение(Истина);
	ЗаписьДЖС.ЗаписатьКонецОбъекта();
	ЗаписьДЖС.Закрыть();
	
	Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
		ИмяФайлаОтвета = СхемаОбмена.ПапкаФайлаЛога + "hs_images_answ.json";
	Иначе
		ИмяФайлаОтвета = ПолучитьИмяВременногоФайла("json");
	КонецЕсли;
	
	АдресСкриптаАутентификация 	= СокрЛП(НастройкиПодключения.АдресСкриптаАутентификация);
	АдресСкрипта        		= СокрЛП(НастройкиПодключения.АдресСкриптаВыгрузкаИзображений);
	ОбновлениеКаталога = Ложь;
	
	Соединение = СоздатьHTTPСоединение(НастройкиПодключения);
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Language","ru");
	Заголовки.Вставить("Accept-Charset","UTF-8");
	Заголовки.Вставить("Content-Language","ru");
	Заголовки.Вставить("Content-Charset","UTF-8");
	Заголовки.Вставить("Content-Type","application/json");
	
	Соединение.ОтправитьДляОбработки(ИмяИсходящегоФайла, АдресСкрипта, ИмяФайлаОтвета, Заголовки);
	
	ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
	
	Если ФайлОтвета.Существует() Тогда
		
		ТекстОтвета = Новый ТекстовыйДокумент();
		ТекстОтвета.Прочитать(ИмяФайлаОтвета);
		Если ТекстОтвета.КоличествоСтрок()>0 Тогда
			ОтветСервера = ТекстОтвета.ПолучитьТекст();	
		Иначе
			Т = "Получен пустой ответ сервера.";
			Сообщить(Т);
			Возврат Неопределено;
		КонецЕсли;	
		
	Иначе	
		Т = "Ответ сервера не получен.";
		Сообщить(Т);
		Возврат Неопределено;
	КонецЕсли;
	
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ИмяФайлаОтвета);
	СтруктураОтвета = ПрочитатьJSON(Чтение);
	
	Успех = Ложь;
	Если СтруктураОтвета.Свойство("status") Тогда
		Если СтруктураОтвета.status = "OK" Тогда
			Успех = Истина;
			Если СтруктураОтвета.Свойство("response") Тогда
				Если СтруктураОтвета.response.Свойство("log") ТОгда
					Для Каждого ТекФайл Из СтруктураОтвета.response.log ЦИкл
						СтрокаТабл = ТаблКартинок.Найти(ТекФайл.fileName, "ИмяФайла");
						Если НЕ СтрокаТабл = Неопределено Тогда
							Если ТекФайл.code = 0 Тогда
								СтрокаТабл.Успешно = Истина;
								СтрокаТабл.ОтветФОто = "OK";
							Иначе	
								СтрокаТабл.Успешно = Ложь;
								СтрокаТабл.ОтветФОто = ТекФайл.message;
							КонецЕсли;	
						КонецЕсли;	
					КонецЦикла;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Если Не Успех Тогда
		Сообщить("При выгрузке изображений возникли проблемы");
		Возврат Неопределено;
	КонецЕсли;	
	Статусы = ТаблКартинок.Скопировать();
	Статусы.Свернуть("Объект, ОтветФото");
	
	Для Каждого ТекСтр Из ТаблЧасть ЦИкл
		СтрокиТекТовара = Статусы.НайтиСтроки(Новый Структура("Объект", ТекСТр.Номенклатура));
		ТекСтр.ОтветФОто = "";
		ДЛя Каждого СТрокаСТатуса Из СтрокиТекТовара Цикл
			Если НЕ ЗначениеЗаполнено(СТрокаСТатуса.ОтветФото) Тогда
				Продолжить;
			КонецЕсли;	
			Если ТекСтр.ОтветФОто <> "" ТОгда
				ТекСтр.ОтветФОто = ТекСтр.ОтветФОто + ","
			КонецЕсли;	
			ТекСтр.ОтветФОто = ТекСтр.ОтветФОто + СТрокаСТатуса.ОтветФото;
		КонецЦикла;	
	КонецЦикла;	
	
	ТаблКартинок.Свернуть("Объект, Успешно");
	Для Каждого ТекСтр Из ТаблКартинок ЦИкл
		Если ТекСтр.Успешно Тогда
			ОбъектыДляСнятияСРегистрации.Добавить(ТекСтр.Объект);
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого ТекСтр Из ТаблКартинок ЦИкл
		Если ТекСтр.Успешно = Ложь Тогда
			Инд = ОбъектыДляСнятияСРегистрации.Найти(ТекСтр.Объект);
			Если Инд <> Неопределено ТОгда
				ОбъектыДляСнятияСРегистрации.Удалить(Инд);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Для Каждого ТекОбъект Из ОбъектыДляСнятияСРегистрации Цикл
		СТрокиТаблЧасти = ТаблЧасть.НайтиСтроки(Новый Структура("Номенклатура", ТекОбъект));
		Для Каждого СТрокаТаблЧасти Из СТрокиТаблЧасти Цикл
			Если СТрокаТаблЧасти <> Неопределено ТОгда
				СТрокаТаблЧасти.ВыгружатьКартинки = Ложь;
			КонецЕсли;	
		КонецЦикла;
		
		НЗ = РегистрыСведений.сви_ИзмененияФотографийНоменклатуры.СоздатьНаборЗаписей();
		НЗ.Отбор.Номенклатура.Установить(ТекОбъект);
		НЗ.Записать();
	КонецЦикла;	
	
КонецФункции

Процедура мпи_ПередЗаписьюВзаиморасчетовСКонтрагентомПередЗаписью(Источник, Отказ, Замещение) Экспорт
	Узлы = Новый Массив;
	
	СхемыОбмена = Справочники.сви_СхемыОбменаССайтом.Выбрать();
	Пока СхемыОбмена.Следующий() Цикл
		Если ЗначениеЗаполнено(СхемыОбмена.УзелПланаОбменаБалансСКлиентомБ2Б) Тогда
			Узлы.Добавить(СхемыОбмена.УзелПланаОбменаБалансСКлиентомБ2Б);
		КонецЕсли;
	КонецЦикла;	
	
	Если Узлы.Количество() = 0 ТОгда
		Возврат;
	КонецЕсли;	
	
	КонтрагентыИзИсточника = Новый Массив;
	Для Каждого ТекЗапись Из Источник Цикл
		Если КонтрагентыИзИсточника.Найти(ТекЗапись.Контрагент) = Неопределено Тогда
			КонтрагентыИзИсточника.Добавить(ТекЗапись.Контрагент);
		КонецЕсли;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	сви_ЗарегистрированныеКонтрагентыБ2Б.Контрагент
	               |ИЗ
	               |	РегистрСведений.сви_ЗарегистрированныеКонтрагентыБ2Б КАК сви_ЗарегистрированныеКонтрагентыБ2Б
	               |ГДЕ
	               |	сви_ЗарегистрированныеКонтрагентыБ2Б.Контрагент В(&КонтрагентыИзИсточника)";
	Запрос.УстановитьПараметр("КонтрагентыИзИсточника",КонтрагентыИзИсточника);
	КонтрагентыДляРегистрации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контрагент");
	
	Источник.ДополнительныеСвойства.Вставить("КонтрагентыДляРегистрации", КонтрагентыДляРегистрации);
	Источник.ДополнительныеСвойства.Вставить("УзлыДляРегистрации", Узлы);
КонецПроцедуры

Процедура мпи_ПриЗаписиВзаиморасчетовСКонтрагентомПриЗаписи(Источник, Отказ, Замещение) Экспорт
	КонтрагентыДляРегистрации = Неопределено;
	Узлы = Неопределено;
	
	Если Источник.ДополнительныеСвойства.Свойство("КонтрагентыДляРегистрации", КонтрагентыДляРегистрации) И Источник.ДополнительныеСвойства.Свойство("УзлыДляРегистрации", Узлы) ТОгда
		Для Каждого УзелДляРегистрации Из Узлы Цикл
			ДЛя Каждого ТекКонтрагент Из КонтрагентыДляРегистрации Цикл
				ПланыОбмена.ЗарегистрироватьИзменения(УзелДляРегистрации, ТекКонтрагент);
			КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

Процедура флПередЗаписьРегистраПередЗаписью(Источник, Отказ, Замещение) Экспорт
	Узлы = Новый Массив;
	
	СхемыОбмена = Справочники.сви_СхемыОбменаССайтом.Выбрать();
	Пока СхемыОбмена.Следующий() Цикл
		Если ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ТоварыНаСкладах") 
			ИЛИ ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ТоварыВРезервеНаСкладах") 
			//с.д.(
			ИЛИ ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ЦеныНоменклатурыКонтрагентов") 
			//с.д.)
			Тогда
			Если Не ЗначениеЗаполнено(СхемыОбмена.УзелПланаОбменаОстатки) Тогда Продолжить; КонецЕсли;
			Узлы.Добавить(СхемыОбмена.УзелПланаОбменаОстатки);
			//с.д.(
			Узлы.Добавить(СхемыОбмена.УзелПланаОбменаТовары);//може змінитися країна і дата виробництва
			//с.д.)
		Иначе
			Если Не ЗначениеЗаполнено(СхемыОбмена.УзелПланаОбменаЦены) Тогда Продолжить; КонецЕсли;
			Узлы.Добавить(СхемыОбмена.УзелПланаОбменаЦены);
		КонецЕсли;
	КонецЦикла;	
	
	Если Узлы.Количество() = 0 ТОгда
		Возврат;
	КонецЕсли;	
	
	ТоварыДляРегистрации = Новый Массив;
	
	
	Если Замещение Тогда
		
		Если НЕ Найти(Строка (Источник),"РегистрНакопления") = 0 Тогда
			ИмяБазовогоТипа = "РегистрыНакопления";
		Иначе
			ИмяБазовогоТипа = "РегистрыСведений";
		КонецЕсли;
		
		ТипЗначенияИсточника = ТипЗнч(Источник);
	
		МетаданныеРегистра = Метаданные.НайтиПоТипу(ТипЗначенияИсточника);
	
		//СтарыйНаборЗаписей = РегистрыСведений[МетаданныеРегистра.Имя].СоздатьНаборЗаписей();
		
		Если ИмяБазовогоТипа = "РегистрыСведений" Тогда
			СтарыйНаборЗаписей = РегистрыСведений[МетаданныеРегистра.Имя].СоздатьНаборЗаписей();
		ИначеЕсли ИмяБазовогоТипа = "РегистрыНакопления" Тогда
			СтарыйНаборЗаписей = РегистрыНакопления[МетаданныеРегистра.Имя].СоздатьНаборЗаписей();
		КонецЕсли;
		
		
		Для Каждого ЗначениеОтбора Из Источник.Отбор Цикл
			
			Если ЗначениеОтбора.Использование = Ложь Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаОтбора = СтарыйНаборЗаписей.Отбор.Найти(ЗначениеОтбора.Имя);
			СтрокаОтбора.Значение = ЗначениеОтбора.Значение;
			СтрокаОтбора.Использование = Истина;
			
		КонецЦикла;
		
		СтарыйНаборЗаписей.Прочитать();
		
		Для Каждого ТекЗапись Из СтарыйНаборЗаписей Цикл
			Если ТоварыДляРегистрации.Найти(ТекЗапись.Номенклатура) = Неопределено ТОгда
				ТоварыДляРегистрации.Добавить(ТекЗапись.Номенклатура);
			КонецЕсли;	
		КонецЦикла;		
		
		
	КонецЕсли;	
	
	
	
	Для Каждого ТекЗапись Из Источник Цикл
		Если ТоварыДляРегистрации.Найти(ТекЗапись.Номенклатура) = Неопределено ТОгда
			ТоварыДляРегистрации.Добавить(ТекЗапись.Номенклатура);
		КонецЕсли;	
	КонецЦикла;
	
	Регистратор = Источник.Отбор.Регистратор.Значение;
	Если ЗначениеЗаполнено(Регистратор) тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Регистр.Номенклатура
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры КАК Регистр
		|ГДЕ
		|	Регистр.Регистратор = &Регистратор
		|	И НЕ Регистр.Номенклатура В (&Номенклатура)";
		Если ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ТоварыНаСкладах") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "РегистрСведений.ЦеныНоменклатуры", "РегистрНакопления.ТоварыНаСкладах");
		ИначеЕсли ТипЗнч(Источник) = Тип("РегистрНакопленияНаборЗаписей.ТоварыВРезервеНаСкладах") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "РегистрСведений.ЦеныНоменклатуры", "РегистрНакопления.ТоварыВРезервеНаСкладах");
		//с.д.(
		ИначеЕсли ТипЗнч(Источник) = Тип("РегистрСведенийНаборЗаписей.ЦеныНоменклатурыКонтрагентов") Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "РегистрСведений.ЦеныНоменклатуры", "РегистрСведений.ЦеныНоменклатурыКонтрагентов");
		//с.д.)
		КонецЕсли;	
		
		Запрос.УстановитьПараметр("Регистратор", Регистратор);
		Запрос.УстановитьПараметр("Номенклатура", ТоварыДляРегистрации);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ТоварыДляРегистрации.Добавить(Выборка.Номенклатура);
		КонецЦикла;	
	КонецЕсли;	
	Источник.ДополнительныеСвойства.Вставить("ТоварыДляРегистрации", ТоварыДляРегистрации);
	Источник.ДополнительныеСвойства.Вставить("УзлыДляРегистрации", Узлы);
КонецПроцедуры

Процедура флПриЗаписиРегистраПриЗаписи(Источник, Отказ, Замещение) Экспорт
	ТоварыДляРегистрации = Неопределено;
	Узлы = Неопределено;
	
	Если Источник.ДополнительныеСвойства.Свойство("ТоварыДляРегистрации", ТоварыДляРегистрации) И Источник.ДополнительныеСвойства.Свойство("УзлыДляРегистрации", Узлы) ТОгда
		Для Каждого УзелДляРегистрации Из Узлы Цикл
			ДЛя Каждого ТекТовар Из ТоварыДляРегистрации Цикл
				ПланыОбмена.ЗарегистрироватьИзменения(УзелДляРегистрации, ТекТовар);
			КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

Процедура флПередЗаписьюСвойствПередЗаписью(Источник, Отказ, Замещение) Экспорт
	Узлы = Новый Массив;
	
	СхемыОбмена = Справочники.сви_СхемыОбменаССайтом.Выбрать();
	Пока СхемыОбмена.Следующий() Цикл
		Узлы.Добавить(СхемыОбмена.УзелПланаОбменаТовары);
	КонецЦикла;	
	
	Если Узлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ТоварыДляРегистрации = Новый Массив;
	Для Каждого ТекЗапись Из Источник Цикл
		Если ЗначениеЗаполнено(ТекЗапись.Объект) Тогда
			Если ТипЗнч(ТекЗапись.Объект) = Тип("СправочникСсылка.Номенклатура") Тогда
				ТекТовар = ТекЗапись.Объект;
			ИначеЕсли ТипЗнч(ТекЗапись.Объект) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
				ТекТовар = ТекЗапись.Объект.Владелец;
			Иначе	
				Продолжить;
			КонецЕсли;	
			Если ТоварыДляРегистрации.Найти(ТекТовар) = Неопределено Тогда
				ТоварыДляРегистрации.Добавить(ТекТовар);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	Если Источник.Отбор.Объект.Использование Тогда
		ТекТовар = Неопределено;
		Если ТипЗнч(Источник.Отбор.Объект.Значение) = Тип("СправочникСсылка.Номенклатура") Тогда
			ТекТовар = Источник.Отбор.Объект.Значение;
		ИначеЕсли ТипЗнч(Источник.Отбор.Объект.Значение) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры") Тогда
			ТекТовар = Источник.Отбор.Объект.Значение.Владелец;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекТовар) Тогда
			Если ТоварыДляРегистрации.Найти(ТекТовар) = Неопределено Тогда
				ТоварыДляРегистрации.Добавить(ТекТовар);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	Если ТоварыДляРегистрации.Количество() Тогда
		Источник.ДополнительныеСвойства.Вставить("ТоварыДляРегистрации", ТоварыДляРегистрации);
		Источник.ДополнительныеСвойства.Вставить("УзелДляРегистрации", Узлы);
	КонецЕсли;	
КонецПроцедуры

Процедура флПриЗаписиСвойствПриЗаписи(Источник, Отказ, Замещение) Экспорт
	ТоварыДляРегистрации = Неопределено;
	Узлы = Неопределено;
	
	Если Источник.ДополнительныеСвойства.Свойство("ТоварыДляРегистрации", ТоварыДляРегистрации) И Источник.ДополнительныеСвойства.Свойство("УзлыДляРегистрации", Узлы) ТОгда
		Для Каждого УзелДляРегистрации Из Узлы Цикл
			Для Каждого ТекТовар Из ТоварыДляРегистрации Цикл
				ПланыОбмена.ЗарегистрироватьИзменения(УзелДляРегистрации, ТекТовар);
			КонецЦикла;	
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

