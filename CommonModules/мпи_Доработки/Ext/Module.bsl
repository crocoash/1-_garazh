	ЛокальныеФайлы = Новый Массив;
	
	Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
		Каталог = СхемаОбмена.ПапкаФайлаЛога + "pictures\";
		УдалитьФайлы(Каталог, "*.*");
