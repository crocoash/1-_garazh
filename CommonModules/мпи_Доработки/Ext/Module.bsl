Функция ПолучитьТокен_Хорошоп(НастройкиПодключений) Экспорт
	
	Рез = Новый Структура;
	Рез.Вставить("Статус","");
	Рез.Вставить("Сообщение","");
	Рез.Вставить("Токен","");
	
	Соединение = СоздатьHTTPСоединение(НастройкиПодключений);
	АдресСкриптаАутентификация 	= "/" +СокрЛП(НастройкиПодключений.АдресСкриптаАутентификация);
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Language","ru");
	Заголовки.Вставить("Accept-Charset","UTF-8");
	Заголовки.Вставить("Content-Language","ru");
	Заголовки.Вставить("Content-Charset","UTF-8");
	Заголовки.Вставить("Content-Type","application/x-www-form-urlencoded; charset=UTF-8");
	
	ПараметрыПОСТ = "login=#login#&password=#pass#";
	ПараметрыПОСТ = СтрЗаменить(ПараметрыПОСТ,"#login#",НастройкиПодключений.ИмяПользователя);
	ПараметрыПОСТ = СтрЗаменить(ПараметрыПОСТ,"#pass#",НастройкиПодключений.Пароль);
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресСкриптаАутентификация,Заголовки);
	HTTPЗапрос.УстановитьТелоИзСтроки(ПараметрыПОСТ,"Windows-1251"); //"UTF-8");
	
	HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	
	ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");
	
	
	
	ЧтениеДЖС = Новый ЧтениеJSON;
	ЧтениеДЖС.УстановитьСтроку(ТекстОтвета);
	
	Строки = ПрочитатьJSON(ЧтениеДЖС);
	Рез.Вставить("Статус", Строки.status);
	
	Если Строки.status = "OK" Тогда
		Рез.Вставить("Токен",Строки.response.token);
	Иначе
		Рез.Вставить("Сообщение", Строки.response.message);
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции	

Функция СоздатьHTTPСоединение (НастройкиПодключений) Экспорт
	
	Если НастройкиПодключений.ЗащищенноеСоединение Тогда
		Порт    = 443;
		ЗС 		= Новый ЗащищенноеСоединениеOpenSSL; 
	Иначе
		Порт    = 80;
		ЗС 		= Неопределено; 
	КонецЕсли;
	
	Адрес          = НастройкиПодключений.Адрес;
	Пользователь   = НастройкиПодключений.ИмяПользователя;
	Пароль         = НастройкиПодключений.Пароль;
	ИнтернетПрокси = Неопределено;
	АдресСкриптаАутентификация = СокрЛП(НастройкиПодключений.АдресСкриптаАутентификация);
	
	Соединение = Новый HTTPСоединение(Адрес, Порт, Пользователь, Пароль, ИнтернетПрокси,,ЗС);
	
	Возврат Соединение;
	
КонецФункции

Функция УбратьШлакИзСтроки(Знач а) Экспорт
	Рез = СтрЗаменить(а,Символы.НПП,"");
	Возврат СокрЛП(Рез);
КонецФункции	

Процедура ДобавитьЗаписьДЖС(ЗаписьДЖС,Имя,Значение)
	ЗаписьДЖС.ЗаписатьНачалоОбъекта();
	ЗаписьДЖС.ЗаписатьИмяСвойства(Имя);
	ЗаписьДЖС.ЗаписатьЗначение(СокрЛП(Значение));
	ЗаписьДЖС.ЗаписатьКонецОбъекта();
КонецПроцедуры	

Функция ВыгрузкаЦен_Хорошоп(табл,ТабЧасть,НастройкиПодключений,ОбновитьТовары=Ложь, СхемаОбмена, Успешно = Ложь) Экспорт
	Успешно = Истина;
	Рез = Новый Структура;
	Рез.Вставить("Успешно",Ложь);
	Рез.Вставить("Сообщение","");
	
	ИмяРеквизитаИдентификатора = СокрЛП(СхемаОбмена.РеквизитИдентификацииНоменклатуры);
	
	ТокенРез = ПолучитьТокен_Хорошоп(НастройкиПодключений); 
	Если ТокенРез.Статус = "OK" Тогда
		ТокенСтр = ТокенРез.Токен; 
	Иначе
		Сообщить(ТокенРез.Сообщение);
		Успешно = Ложь;
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
		ИмяИсходящегоФайла = СхемаОбмена.ПапкаФайлаЛога + "hs_price.json";
	Иначе
		ИмяИсходящегоФайла = ПолучитьИмяВременногоФайла("json");
	КонецЕсли;
	
	Соединение = СоздатьHTTPСоединение(НастройкиПодключений);
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Language","ru");
	Заголовки.Вставить("Accept-Charset","UTF-8");
	Заголовки.Вставить("Content-Language","ru");
	Заголовки.Вставить("Content-Charset","UTF-8");
	Заголовки.Вставить("Content-Type","application/json");
	
	Лимит = СхемаОбмена.РазмерПакетаПереаваемыхДанных;
	Если Лимит = 0 тогда
		 Лимит = 300;
	КонецЕсли; 
	
	Кво = Табл.Количество();
	КвоВыгружено = 0;
	Пока КвоВыгружено < Кво Цикл
		
		Файл = Новый Файл(ИмяИсходящегоФайла);
		Если Файл.Существует() ТОгда
			УдалитьФайлы(Файл);
		КонецЕсли;	
		
		ЗаписьДЖС = Новый ЗаписьJSON;
		ЗаписьДЖС.ПроверятьСтруктуру = Истина;
		ПараметрыЗаписиДЖС = Новый ПараметрыЗаписиJSON(,Символы.Таб);
		ЗаписьДЖС.ОткрытьФайл(ИмяИсходящегоФайла,КодировкаТекста.UTF8,Ложь,ПараметрыЗаписиДЖС);
		
		ЗаписьДЖС.ЗаписатьНачалоОбъекта();
		ЗаписьДЖС.ЗаписатьИмяСвойства("token");
		ЗаписьДЖС.ЗаписатьЗначение(ТокенСтр);
		ЗаписьДЖС.ЗаписатьИмяСвойства("products");
		ЗаписьДЖС.ЗаписатьНачалоМассива();
		
		КвоВПорции = 0;
		Для хх = КвоВыгружено ПО Кво - 1 Цикл
			//
			Стр = Табл[хх];
			
			КвоВПорции = КвоВПорции + 1;
			
			ЗаписьДЖС.ЗаписатьНачалоОбъекта();
			ЗаписьДЖС.ЗаписатьИмяСвойства("article");
			ЗаписьДЖС.ЗаписатьЗначение(СокрЛП(Стр.КодТовара));
			//
			выгружатьЦену = Истина;
			Если стр.Цена = 0 Тогда
				Если НЕ стр.ВыгружатьНулевыеЦеныПрайс Тогда
					выгружатьЦену = Ложь;
				КонецЕсли;
			КонецЕсли;
			Если выгружатьЦену Тогда
				ЗаписьДЖС.ЗаписатьИмяСвойства("price");
				Ц = СтрЗаменить(Стр.Цена,",",".");
				Ц = СтрЗаменить(Ц,Символы.НПП,"");
				ЗаписьДЖС.ЗаписатьЗначение(Ц);
			КонецЕсли;
			//
			выгружатьЦену = Истина;
			Если стр.ЦенаСтарая = 0 Тогда
				Если НЕ стр.ВыгружатьНулевыеЦеныСтарая Тогда
					выгружатьЦену = Ложь;
				КонецЕсли;
			КонецЕсли;
			Если выгружатьЦену Тогда
				ЗаписьДЖС.ЗаписатьИмяСвойства("price_old");
				Ц = СтрЗаменить(Стр.ЦенаСтарая,",",".");
				Ц = СтрЗаменить(Ц,Символы.НПП,"");
				ЗаписьДЖС.ЗаписатьЗначение(Ц);
			КонецЕсли;
			//
			ЗаписьДЖС.ЗаписатьИмяСвойства("currency");
			Если Стр.ВалютаИД = Неопределено Тогда
				ЗаписьДЖС.ЗаписатьЗначение(Стр.ВалютаСтр);
			Иначе
				ЗаписьДЖС.ЗаписатьНачалоОбъекта();
				ЗаписьДЖС.ЗаписатьИмяСвойства("id");
				ЗаписьДЖС.ЗаписатьЗначение(Стр.ВалютаИД);
				ЗаписьДЖС.ЗаписатьКонецОбъекта();
			КонецЕсли;
			//
			ЗаписьДЖС.ЗаписатьИмяСвойства("discount");
			ЗаписьДЖС.ЗаписатьЗначение("0");
			
			// остатки привязаны к ценам, если 0 - нет в наличии
			КоличествоСПривязкойКЦене = ?(Стр.Цена=0,0,1);
			Наличие = ПолучитьНаличие(КоличествоСПривязкойКЦене,СхемаОбмена);
			ЗаписьДЖС.ЗаписатьИмяСвойства("presence");
			ЗаписьДЖС.ЗаписатьЗначение(наличие);
			
			//
			ЗаписьДЖС.ЗаписатьКонецОбъекта();
			Если КвоВПорции >= Лимит Тогда
				Прервать;
			КонецЕсли;	
		КонецЦикла;	  
		КвоВыгружено = КвоВыгружено + КвоВПорции;
		
		ЗаписьДЖС.ЗаписатьКонецМассива();
		ЗаписьДЖС.ЗаписатьКонецОбъекта();
		
		ЗаписьДЖС.Закрыть();	
		//
		Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
			ИмяФайлаОтвета = СхемаОбмена.ПапкаФайлаЛога + "hs_price_answ.json";
		Иначе
			ИмяФайлаОтвета = ПолучитьИмяВременногоФайла("json");
		КонецЕсли;
		
		АдресСкриптаЦены       		= СокрЛП(НастройкиПодключений.АдресСкриптаВыгрузкаЦен);
		ОбновлениеКаталога = Ложь;
		Если ОбновитьТовары Тогда
			АдресСкриптаЦены		 	= СокрЛП(НастройкиПодключений.АдресСкриптаВыгрузкаТоваров);
			ОбновлениеКаталога = Истина;
		КонецЕсли;
		
		Соединение.ОтправитьДляОбработки(ИмяИсходящегоФайла, АдресСкриптаЦены, ИмяФайлаОтвета, Заголовки);
		
		ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
		
		Если ФайлОтвета.Существует() Тогда
			
			ТекстОтвета = Новый ТекстовыйДокумент();
			ТекстОтвета.Прочитать(ИмяФайлаОтвета);
			Если ТекстОтвета.КоличествоСтрок()>0 Тогда
				ОтветСервера = ТекстОтвета.ПолучитьТекст();	
			Иначе
				Т = "Получен пустой ответ сервера.";
				Сообщить(Т);
				Успешно = Ложь;
				Возврат Неопределено;
			КонецЕсли;	
			
		Иначе	
			Т = "Ответ сервера не получен.";
			Сообщить(Т);
			Успешно = Ложь;
			Возврат Неопределено;
		КонецЕсли;
		
		ОбработкаОтвета(ИмяФайлаОтвета, НастройкиПодключений, ТабЧасть, ОбновлениеКаталога, "ОтветЦена",Успешно);				
	
	КонецЦикла;
	
	Рез.Вставить("Успешно",Истина);	
	Возврат Рез;
	
КонецФункции

Процедура ОбработкаОтвета(ИмяФайлаОтвета, НастройкиПодключений, ТабЧасть, ОбновлениеКаталога=Ложь, ИмяРеквизитаТабЧасти = "ТекстОтвета", Успешно = Истина)
	
	Если ТабЧасть = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЧтениеДЖС = Новый ЧтениеJSON;
	ЧтениеДЖС.ОткрытьФайл(ИмяФайлаОтвета);
	Записи = ПрочитатьJSON(ЧтениеДЖС);
	Статус = ""; МассивОтвет = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если Запись.Ключ = "status" Тогда
			Статус = Запись.Значение;
		КонецЕсли;
		Если Запись.Ключ = "response" Тогда
			МассивОтвет = Запись.Значение;
		КонецЕсли;
	КонецЦикла;
	
	МассивЗначенийЛога = Новый Массив;
	Для Каждого Эл Из МассивОтвет Цикл
		МассивЗначенийЛога = Эл.Значение;
	КонецЦикла;
	Если (Статус = "ERROR")  ИЛИ (Статус = "HTTP_ERROR") Тогда
		Сообщить(МассивЗначенийЛога);
		Возврат;
	КонецЕсли;
	
	ИдТовара = ""; МассивОтветовПоЭлементу = Новый Массив;
	КодОтвета = ""; ТекстОтвета = "";
	Для Каждого Эл2 Из МассивЗначенийЛога Цикл
		ИдТовара    = УбратьШлакИзСтроки(Эл2.article); //хорошоп возвращает без лидирующих нулей
		Если ОбновлениеКаталога Тогда
			КодОтвета   = Эл2.info[0].Code;
			ТекстОтвета = Эл2.info[0].message;
		Иначе
			КодОтвета   = Эл2.status;
			ТекстОтвета = Эл2.message;	
		КонецЕсли;
		
		//
		стр = ТабЧасть.Найти(ИдТовара,"ИД");
		Если стр <> Неопределено Тогда
			Если ОбновлениеКаталога Тогда
				Если Найти(ТекстОтвета,"Товар обновлен") > 0 Тогда
					Стр.Результат = "Обновлен";
				ИначеЕсли Найти(ТекстОтвета,"Товар добавлен") > 0 Тогда 	
					Стр.Результат = "Добавлен";
				Иначе
					Стр.Результат = ТекстОтвета;
				КонецЕсли;
			Иначе
				Если Найти(ТекстОтвета,"UPDATED") > 0 Тогда
					Стр.Результат = "Обновлен";
				Иначе
					Стр.Результат = "Ошибка";//Перечисления.ВариантыОтветаСервераНоменклатура.Ошибка;
				КонецЕсли;
			КонецЕсли;
			Стр.КодОтвета = КодОтвета;
			Если КодОтвета <> 0 И КодОтвета <> "OK" ТОгда
				Успешно = Ложь;
			КонецЕсли;	
			Стр[ИмяРеквизитаТабЧасти] = ТекстОтвета;
		КонецЕсли;	
		//
	КонецЦикла;

КонецПроцедуры

Функция ВыгрузкаНаличия_Хорошоп(табл,ТабЧасть,НастройкиПодключений, СхемаОбмена, Успешно = Ложь) Экспорт
	
	Успешно = Истина;
	Рез = Новый Структура;
	Рез.Вставить("Успешно",Ложь);
	Рез.Вставить("Сообщение","");
	
	ИмяРеквизитаИдентификатора = СокрЛП(СхемаОбмена.РеквизитИдентификацииНоменклатуры);
	
	ТокенРез = ПолучитьТокен_Хорошоп(НастройкиПодключений); 
	Если ТокенРез.Статус = "OK" Тогда
		ТокенСтр = ТокенРез.Токен; 
	Иначе
		Сообщить(ТокенРез.Сообщение);
		Успешно = Ложь;
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
		ИмяИсходящегоФайла = СхемаОбмена.ПапкаФайлаЛога + "hs_res.json";
	Иначе
		ИмяИсходящегоФайла = ПолучитьИмяВременногоФайла("json");
	КонецЕсли;
	
	Если СхемаОбмена.ВыгружатьОстатокКакСтатус Тогда
		АдресСкриптаОстатки 	= СокрЛП(НастройкиПодключений.АдресСкриптаВыгрузкаТоваров);
		ИдСтатус	 			= "presence";
	Иначе
		АдресСкриптаОстатки     = СокрЛП(НастройкиПодключений.АдресСкриптаВыгрузкаОстатков);
		ИдСтатус	 			= "quantity";
	КонецЕсли;
	
	Кво = Табл.Количество();
	Для хх = 1 По Кво Цикл
		ТекСтр = Табл[Кво - хх];
		выгружатьОстаток = Истина;
		Если ТекСтр.Наличие = 0 Тогда
			Если НЕ ТекСтр.ВыгружатьНулевыеОстатки Тогда
				Табл.Удалить(ТекСтр);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;		
	
	Кво = Табл.Количество();
	КвоВыгружено = 0;
	Лимит = СхемаОбмена.РазмерПакетаПереаваемыхДанных;
	Если Лимит = 0 тогда
		 Лимит = 300;
	КонецЕсли; 
	
	Соединение = СоздатьHTTPСоединение(НастройкиПодключений);
		
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Language","ru");
	Заголовки.Вставить("Accept-Charset","UTF-8");
	Заголовки.Вставить("Content-Language","ru");
	Заголовки.Вставить("Content-Charset","UTF-8");
	Заголовки.Вставить("Content-Type","application/json");
	
	Пока КвоВыгружено < Кво Цикл
		Файл = Новый Файл(ИмяИсходящегоФайла);
		Если Файл.Существует() Тогда
			УдалитьФайлы(ИмяИсходящегоФайла);
		КонецЕсли;

		ЗаписьДЖС = Новый ЗаписьJSON;
		ЗаписьДЖС.ПроверятьСтруктуру = Истина;
		ПараметрыЗаписиДЖС = Новый ПараметрыЗаписиJSON(,Символы.Таб);
		ЗаписьДЖС.ОткрытьФайл(ИмяИсходящегоФайла,КодировкаТекста.UTF8,Ложь,ПараметрыЗаписиДЖС);
		
		ЗаписьДЖС.ЗаписатьНачалоОбъекта();
		ЗаписьДЖС.ЗаписатьИмяСвойства("token");
		ЗаписьДЖС.ЗаписатьЗначение(ТокенСтр);
		ЗаписьДЖС.ЗаписатьИмяСвойства("products");
		ЗаписьДЖС.ЗаписатьНачалоМассива();
		КвоВПорции = 0;
		Для хх = КвоВыгружено По Кво - 1 Цикл
			Стр = Табл[хх];
			КвоВПорции = КвоВПорции + 1;
			
			ЗаписьДЖС.ЗаписатьНачалоОбъекта();
			ЗаписьДЖС.ЗаписатьИмяСвойства("article");
			ЗаписьДЖС.ЗаписатьЗначение(СокрЛП(Стр.КодТовара));
			//
			Если НЕ СхемаОбмена.ВыгружатьОстатокКакСтатус Тогда
				ЗаписьДЖС.ЗаписатьИмяСвойства("warehouse");
				ЗаписьДЖС.ЗаписатьЗначение("office");
			КонецЕсли;
			//
			
			наличие = ПолучитьНаличие(Стр.Наличие,СхемаОбмена);
			ЗаписьДЖС.ЗаписатьИмяСвойства(ИдСтатус);
			ЗаписьДЖС.ЗаписатьЗначение(наличие);
			//
			ЗаписьДЖС.ЗаписатьКонецОбъекта();
			Если КвоВПорции >= Лимит Тогда
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		КвоВыгружено = КвоВыгружено + КвоВПорции;
		ЗаписьДЖС.ЗаписатьКонецМассива();
		ЗаписьДЖС.ЗаписатьКонецОбъекта();
		
		ЗаписьДЖС.Закрыть();	
		//
		Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
			ИмяФайлаОтвета = СхемаОбмена.ПапкаФайлаЛога + "hs_res_answ.json";
		Иначе
			ИмяФайлаОтвета = ПолучитьИмяВременногоФайла("json");
		КонецЕсли;
		
		ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
		Если ФайлОтвета.Существует() Тогда
			УдалитьФайлы(ИмяФайлаОтвета);
		КонецЕсли;	
			
		Соединение.ОтправитьДляОбработки(ИмяИсходящегоФайла, АдресСкриптаОстатки, ИмяФайлаОтвета, Заголовки);
		
		ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
		
		Если ФайлОтвета.Существует() Тогда
			
			ТекстОтвета = Новый ТекстовыйДокумент();
			ТекстОтвета.Прочитать(ИмяФайлаОтвета);
			Если ТекстОтвета.КоличествоСтрок()>0 Тогда
				ОтветСервера = ТекстОтвета.ПолучитьТекст();	
			Иначе
				Т = "Получен пустой ответ сервера.";
				Успешно = Ложь;
				Сообщить(Т);
				Возврат Неопределено;
			КонецЕсли;	
			
		Иначе	
			Т = "Ответ сервера не получен.";
			Сообщить(Т);
			Успешно = Ложь;
			Возврат Неопределено;
		КонецЕсли;
		
		ОбработкаОтвета(ИмяФайлаОтвета, НастройкиПодключений, ТабЧасть, СхемаОбмена.ВыгружатьОстатокКакСтатус, "ОтветОстаток", Успешно);
	КонецЦикла;		
	Рез.Вставить("Успешно",Истина);	
	Возврат Рез;
	
КонецФункции

Функция ПолучитьНаличие(Остаток,СхемаОбмена)
	
	Если НЕ СхемаОбмена.ВыгружатьОстатокКакСтатус Тогда
		Возврат Остаток;
	КонецЕсли;
	
	//определим статус
	Для каждого текСтр Из СхемаОбмена.СтатусыОстатков Цикл
		Если Остаток <= текСтр.ВерхняяГраница Тогда
			Возврат СокрЛП(текСтр.Статус);
		КонецЕсли;
	КонецЦикла		
 	
	
КонецФункции

Функция СтандартизироватьТелефон(ИсходныйТелефон)
	Телефон = СокрЛП(ИсходныйТелефон);
	Рез = "";
	Длина = СтрДлина(Телефон);
	Для хх = 1 По Длина Цикл
		ТекСимвол = Сред(Телефон, хх, 1);
		Если Найти("0123456789", ТекСимвол) Тогда
			Рез = Рез + ТекСимвол;
		КонецЕсли;	
	КонецЦикла;	
	
	Рез = Прав(Рез, 10);
	Если СтрДлина(Рез) = 10 И Лев(Рез, 1) = "0" Тогда
		Возврат "+38" + Рез;
	КонецЕсли;
КонецФункции	

Функция ВыгрузкаКонтрагентов_Хорошоп(СхемаОбмена, НастройкиПодключений) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СкидкиНаценкиНоменклатурыСрезПоследних.ПолучательСкидки,
	|	СкидкиНаценкиНоменклатурыСрезПоследних.ПроцентСкидкиНаценки КАК ПроцентСкидкиНаценки,
	|	СкидкиНаценкиНоменклатурыСрезПоследних.ДатаОкончания
	|ПОМЕСТИТЬ ВсеСкидки
	|ИЗ
	|	РегистрСведений.СкидкиНаценкиНоменклатуры.СрезПоследних(
	|			,
	|			ПолучательСкидки ССЫЛКА Справочник.Контрагенты
	|				И Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				И (ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ДатаОкончания > &ДатаСреза)
	|				И Условие = ЗНАЧЕНИЕ(Перечисление.УсловияСкидкиНаценки.ПоКоличествуТовара)
	|				И ЗначениеУсловия = 0) КАК СкидкиНаценкиНоменклатурыСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СкидкиНаценкиНоменклатурыСрезПоследних.ЗначениеУсловия.ВладелецКарты,
	|	СкидкиНаценкиНоменклатурыСрезПоследних.ПроцентСкидкиНаценки,
	|	СкидкиНаценкиНоменклатурыСрезПоследних.ДатаОкончания
	|ИЗ
	|	РегистрСведений.СкидкиНаценкиНоменклатуры.СрезПоследних(
	|			,
	|			ПолучательСкидки = ЗНАЧЕНИЕ(Справочник.ДоговорыКОнтрагентов.ПустаяСсылка)
	|				И Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				И (ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ ДатаОкончания > &ДатаСреза)
	|				И Условие = ЗНАЧЕНИЕ(Перечисление.УсловияСкидкиНаценки.ПоДисконтнойКарте)
	|				И ЗначениеУсловия ССЫЛКА Справочник.ИнформационныеКарты) КАК СкидкиНаценкиНоменклатурыСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеСкидки.ПолучательСкидки,
	|	МАКСИМУМ(ВсеСкидки.ПроцентСкидкиНаценки) КАК ПроцентСкидкиНаценки
	|ПОМЕСТИТЬ МаксимальныйПроцент
	|ИЗ
	|	ВсеСкидки КАК ВсеСкидки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВсеСкидки.ПолучательСкидки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеСкидки.ПолучательСкидки,
	|	ВсеСкидки.ПроцентСкидкиНаценки,
	|	МИНИМУМ(ВсеСкидки.ДатаОкончания) КАК ДатаОкончания
	|ПОМЕСТИТЬ Скидки
	|ИЗ
	|	ВсеСкидки КАК ВсеСкидки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МаксимальныйПроцент КАК МаксимальныйПроцент
	|		ПО ВсеСкидки.ПолучательСкидки = МаксимальныйПроцент.ПолучательСкидки
	|			И ВсеСкидки.ПроцентСкидкиНаценки = МаксимальныйПроцент.ПроцентСкидкиНаценки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВсеСкидки.ПолучательСкидки,
	|	ВсеСкидки.ПроцентСкидкиНаценки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Контрагенты.Наименование,
	|	ВЫРАЗИТЬ(КонтактнаяИнформация.Представление КАК СТРОКА(100)) КАК Емейл,
	|	Скидки.ПроцентСкидкиНаценки КАК Скидка,
	|	КонтактнаяИнформацияТелефон.Представление КАК Телефон,
	|	КонтактнаяИнформацияАдрес.Представление КАК Адрес,
	|	КонтактнаяИнформацияАдрес.Поле4 КАК Город,
	|	Скидки.ДатаОкончания КАК СрокДействияСкидки
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|			ЛЕВОЕ СОЕДИНЕНИЕ Скидки КАК Скидки
	|			ПО Контрагенты.Ссылка = Скидки.ПолучательСкидки
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияТелефон
	|			ПО Контрагенты.Ссылка = КонтактнаяИнформацияТелефон.Объект
	|				И (КонтактнаяИнформацияТелефон.Вид = &ТелефонКонтрагента)
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформацияАдрес
	|			ПО Контрагенты.Ссылка = КонтактнаяИнформацияАдрес.Объект
	|				И (КонтактнаяИнформацияАдрес.Вид = &АдресКонтрагента)
	|		ПО КонтактнаяИнформация.Объект = Контрагенты.Ссылка
	|			И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))";
	Запрос.УстановитьПараметр("ДатаСреза", ТекущаяДата());
	Запрос.УстановитьПараметр("ТелефонКонтрагента", Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
	Запрос.УстановитьПараметр("АдресКонтрагента", Справочники.ВидыКонтактнойИнформации.АдресДоставкиКонтрагента);
	Выборка = Запрос.Выполнить().Выбрать();

	Рез = Новый Структура;
	Рез.Вставить("Успешно",Ложь);
	Рез.Вставить("Сообщение","");
	
	ТокенРез = ПолучитьТокен_Хорошоп(НастройкиПодключений); 
	
	Если ТокенРез.Статус = "OK" Тогда
		ТокенСтр = ТокенРез.Токен; 
	Иначе
		Рез.Вставить("Сообщение", ТокенРез.Сообщение);
		Успешно = Ложь;
		Возврат Рез;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
		ИмяИсходящегоФайла = СхемаОбмена.ПапкаФайлаЛога + "hs_clients.json";
	Иначе
		ИмяИсходящегоФайла = ПолучитьИмяВременногоФайла("json");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СхемаОбмена.ПапкаФайлаЛога) Тогда
		ИмяФайлаОтвета = СхемаОбмена.ПапкаФайлаЛога + "hs_clients_answ.json";
	Иначе
		ИмяФайлаОтвета = ПолучитьИмяВременногоФайла("json");
	КонецЕсли;
	
	АдресСкриптаВыгрузка       = НастройкиПодключений.АдресСкриптаВыгрузкаКонтрагентов;
	
	Соединение = СоздатьHTTPСоединение(НастройкиПодключений);
		
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Language","ru");
	Заголовки.Вставить("Accept-Charset","UTF-8");
	Заголовки.Вставить("Content-Language","ru");
	Заголовки.Вставить("Content-Charset","UTF-8");
	Заголовки.Вставить("Content-Type","application/json");
	
	Лимит = СхемаОбмена.РазмерПакетаПереаваемыхДанных;
	Если Лимит = 0 тогда
		 Лимит = 300;
	КонецЕсли; 
	Пока Истина ЦИкл
	
		ЗаписьДЖС = Новый ЗаписьJSON;
		ЗаписьДЖС.ПроверятьСтруктуру = Истина;
		ПараметрыЗаписиДЖС = Новый ПараметрыЗаписиJSON(,Символы.Таб);
		ЗаписьДЖС.ОткрытьФайл(ИмяИсходящегоФайла,КодировкаТекста.UTF8,Ложь,ПараметрыЗаписиДЖС);
		//ЗаписьДЖС.УстановитьСтроку();
			
		ЗаписьДЖС.ЗаписатьНачалоОбъекта();
		ЗаписьДЖС.ЗаписатьИмяСвойства("token");
		ЗаписьДЖС.ЗаписатьЗначение(ТокенСтр);
		ЗаписьДЖС.ЗаписатьИмяСвойства("users");
		ЗаписьДЖС.ЗаписатьНачалоМассива();
		
		КвоЗаписейВФайле = 0;
		Пока Выборка.Следующий() Цикл
			Если Не ЗначениеЗаполнено(Выборка.Наименование) Тогда
				Продолжить;
			КонецЕсли;	
			
			КвоЗаписейВФайле = КвоЗаписейВФайле + 1;
			//
			ЗаписьДЖС.ЗаписатьНачалоОбъекта();
			
			ЗаписьДЖС.ЗаписатьИмяСвойства("title");
			ЗаписьДЖС.ЗаписатьЗначение(СокрЛП(Выборка.Наименование));
			
			ЗаписьДЖС.ЗаписатьИмяСвойства("email");
			ЗаписьДЖС.ЗаписатьЗначение(СокрЛП(Выборка.Емейл));
			
			СтандартизированныйТелефон = СтандартизироватьТелефон(Выборка.Телефон);
			Если ЗначениеЗаполнено(СтандартизированныйТелефон) Тогда
				ЗаписьДЖС.ЗаписатьИмяСвойства("phone");
				ЗаписьДЖС.ЗаписатьЗначение(СтандартизированныйТелефон);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СокрЛП(Выборка.Город)) Тогда
				ЗаписьДЖС.ЗаписатьИмяСвойства("city");
				ЗаписьДЖС.ЗаписатьЗначение(СокрЛП(Выборка.Город));
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СокрЛП(Выборка.Адрес)) Тогда
				ЗаписьДЖС.ЗаписатьИмяСвойства("address");
				ЗаписьДЖС.ЗаписатьЗначение(СокрЛП(Выборка.Адрес));
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.Скидка) Тогда
				ЗаписьДЖС.ЗаписатьИмяСвойства("discount_card");
				ЗаписьДЖС.ЗаписатьНачалоОбъекта();
				ЗаписьДЖС.ЗаписатьИмяСвойства("discount");
				ЗаписьДЖС.ЗаписатьЗначение(Формат(Выборка.Скидка, "ЧГ="));
				
				ЗаписьДЖС.ЗаписатьИмяСвойства("active");
				ЗаписьДЖС.ЗаписатьЗначение(1);
				
				Если ЗначениеЗаполнено(Выборка.СрокДействияСкидки) Тогда
					ЗаписьДЖС.ЗаписатьИмяСвойства("date_limit");
					ЗаписьДЖС.ЗаписатьЗначение(Формат(Выборка.СрокДействияСкидки, "ДФ=yyyy-MM-dd"));
				Иначе	
					ЗаписьДЖС.ЗаписатьИмяСвойства("date_limit");
					ЗаписьДЖС.ЗаписатьЗначение(Формат(ДобавитьМесяц(ТекущаяДата(), 12), "ДФ=yyyy-MM-dd"));
				КонецЕсли;	
				
				ЗаписьДЖС.ЗаписатьИмяСвойства("status");
				ЗаписьДЖС.ЗаписатьЗначение(1);
				
				ЗаписьДЖС.ЗаписатьКонецОбъекта();
			КонецЕсли;	
			
			ЗаписьДЖС.ЗаписатьКонецОбъекта();
			Если КвоЗаписейВФайле >= Лимит Тогда
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
		Если КвоЗаписейВФайле = 0 Тогда
			Прервать;
		КонецЕсли;	
		ЗаписьДЖС.ЗаписатьКонецМассива();
		ЗаписьДЖС.ЗаписатьКонецОбъекта();
		
		ЗаписьДЖС.Закрыть();	
		//
		
		ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
		Если ФайлОтвета.Существует() Тогда
			УдалитьФайлы(ИмяФайлаОтвета);
		КонецЕсли;
		
		Соединение.ОтправитьДляОбработки(ИмяИсходящегоФайла, АдресСкриптаВыгрузка, ИмяФайлаОтвета, Заголовки);
			
		ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
		
		Если ФайлОтвета.Существует() Тогда
			
			ТекстОтвета = Новый ТекстовыйДокумент();
			ТекстОтвета.Прочитать(ИмяФайлаОтвета, "UTF-8");
			Если ТекстОтвета.КоличествоСтрок()>0 Тогда
				ОтветСервера = ТекстОтвета.ПолучитьТекст();	
				
				Чтение = Новый ЧтениеJSON;
				Чтение.УстановитьСтроку(ОтветСервера);
				СтруктураОтвета = ПрочитатьJSON(Чтение);
				Если СтруктураОтвета.status = "OK" Тогда
					Рез.Вставить("Успешно", Истина);
					Возврат Рез;
				Иначе
					Рез.Вставить("Успешно", Ложь);
					Рез.Вставить("Сообщение", ОтветСервера);
					Возврат Рез;
				КонецЕсли;	
			Иначе
				Т = "Получен пустой ответ сервера.";
				Сообщить(Т);
				Рез.Вставить("Успешно",Ложь);
				Рез.Вставить("Сообщение",Т);
				Возврат Рез;
			КонецЕсли;	
			
		Иначе	
			Т = "Ответ сервера не получен.";
			Сообщить(Т);
			Рез.Вставить("Успешно",Ложь);
			Рез.Вставить("Сообщение",Т);
			Успешно = Ложь;
			Возврат Рез;
		КонецЕсли;
		
		//ОбработкаОтвета(ИмяФайлаОтвета, НастройкиПодключений, ТабЧасть,Истина,, Успешно);
	КонецЦикла;
	//ОчисткаРегистрацииНовых(сп);
			
	Рез.Вставить("Успешно",Истина);	
	Возврат Рез;
	
КонецФункции

Функция ВыгрузкаТоваров_Хорошоп(Сп,ТабЧасть,НастройкиПодключений, СхемаОбмена, Успешно) Экспорт
	Успешно = Истина;
	
	ЗапросСвойств = Новый Запрос;
	ЗапросСвойств.Текст = 
	"ВЫБРАТЬ
	|	ЗначенияСвойствОбъектов.Свойство.сви_КодВэбСинхронизации КАК КодСвойства,
	|	ЗначенияСвойствОбъектов.Значение,
	|	ЗначенияСвойствОбъектов.Объект,
	|	ЗначенияСвойствОбъектов.Свойство.сви_ВидРеквизитаНаСайте КАК ВидРеквизитаНаСайте
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Свойство.сви_КодВэбСинхронизации <> """"
	|	И ЗначенияСвойствОбъектов.Свойство.сви_СинхронизироватьССайтом";
	ТаблСвойств = ЗапросСвойств.Выполнить().Выгрузить();
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Штрихкоды.Владелец,
