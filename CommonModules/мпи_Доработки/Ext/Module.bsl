Функция ЗарегистрироватьКонтрагентаБТБ(Клиент,СхемаОбмена) Экспорт
	
	Рез = Новый Структура;
	Рез.Вставить("Успешно",Ложь);
	Рез.Вставить("Сообщение","");
	
	Магазин = Справочники.Подразделения.НайтиПоРеквизиту("сви_СхемаОбменаССайтом",СхемаОбмена);
	Если Не ЗначениеЗаполнено(Магазин) Тогда
		Т = "Назначте подразделение для этого сайта";
		Рез.Вставить("Сообщение",Т);
		Возврат Рез;
	КонецЕсли;	
	
	КодГруппыПользователей = "";
	Для Каждого Стр ИЗ Клиент.сви_ТипЦен.сви_КодыМагазинов Цикл
		Если Стр.Магазин = Магазин Тогда
			КодГруппыПользователей = Стр.КодГруппыПокупателей;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(КодГруппыПользователей) Тогда
		Т = "Тип цен не связан с группой покупателей в Хорошопе";
		Рез.Вставить("Сообщение",Т);
		Возврат Рез;
	КонецЕсли;	
	
	ВалютаБаланса = СхемаОбмена.ВалютаБалансаДляСайта;
	Если Не ЗначениеЗАполнено(ВалютаБаланса) Тогда
		Т = "Не заполнена валюта баланса в схеме обмена. Регистрация не возможна.";
		Рез.Вставить("Сообщение",Т);
		Возврат Рез;
	КонецЕсли;	
	
	Емейл = "";
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)"
	;
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Объект",Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Емейл = Выборка.Представление;
	КонецЦикла;
	
	//Поскольку в Хорошоп идентификация происходит по Емейлу
	//то если оно не заполнено, то не передаем контрагента на сайт
	Если Емейл = "" Тогда
		Рез.Вставить("Сообщение","У текущего контрагента не заполнена электронная почта.");
		Возврат Рез;
	КонецЕсли;	
		
	Телефон = "";
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Тип = &Тип"
	;
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Объект",Клиент);
	Запрос.УстановитьПараметр("Тип",Перечисления.ТипыКонтактнойИнформации.Телефон);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Телефон = Выборка.Представление;
	КонецЦикла;
	
	//БАЛАНС
	СуммаБаланса = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВзаиморасчетыСКонтрагентамиОстатки.СуммаУпрОстаток КАК СуммаБаланса
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(, Контрагент = &Клиент) КАК ВзаиморасчетыСКонтрагентамиОстатки";
	Запрос.УстановитьПараметр("Клиент",Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СуммаБаланса = Выборка.СуммаБаланса;
	КонецЕсли;
	
	ВалютаУпрУчета = Константы.ВалютаУправленческогоУчета.Получить();
	
	Если ВалютаБаланса <> ВалютаУпрУчета Тогда
		КурсВалютаБаланса = МодульВалютногоУчета.ПолучитьКурсВалюты(ВалютаБаланса,ТекущаяДата());
		КурсВалютаУпрУчета = МодульВалютногоУчета.ПолучитьКурсВалюты(ВалютаУпрУчета,ТекущаяДата());
		
		СуммаБаланса = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(СуммаБаланса,ВалютаУпрУчета,ВалютаБаланса,КурсВалютаУпрУчета.Курс,КурсВалютаБаланса.КУрс,КурсВалютаУпрУчета.Кратность,КурсВалютаБаланса.Кратность);
	КонецЕсли;
	//----------------
	
	НП = СхемаОбмена.НастройкаПодключения;
	ТокенРез = ПолучитьТокен_Хорошоп(НП); 
	Если ТокенРез.Статус = "OK" Тогда
		ТокенСтр = ТокенРез.Токен; 
	Иначе
		Рез.Вставить("Сообщение",ТокенСтр.Сообщение);
		Возврат Рез;
	КонецЕсли;
	//
	ЗаписьДЖС = Новый ЗаписьJSON;
	ЗаписьДЖС.ПроверятьСтруктуру = Истина;
	ПараметрыЗаписиДЖС = Новый ПараметрыЗаписиJSON(,Символы.Таб);
	ЗаписьДЖС.УстановитьСтроку(ПараметрыЗаписиДЖС);
	
	ЗаписьДЖС.ЗаписатьНачалоОбъекта();
	ЗаписьДЖС.ЗаписатьИмяСвойства("token");
	ЗаписьДЖС.ЗаписатьЗначение(ТокенСтр);
	ЗаписьДЖС.ЗаписатьИмяСвойства("users");
	ЗаписьДЖС.ЗаписатьНачалоМассива();
	//
	ЗаписьДЖС.ЗаписатьНачалоОбъекта();
	
	ЗаписьДЖС.ЗаписатьИмяСвойства("title");
	ЗаписьДЖС.ЗаписатьЗначение(СокрЛП(Клиент.Наименование));
	
	ЗаписьДЖС.ЗаписатьИмяСвойства("email");
	ЗаписьДЖС.ЗаписатьЗначение(Емейл);
	
	СтандартизированныйТелефон = СтандартизироватьТелефон(Телефон);
	ЗаписьДЖС.ЗаписатьИмяСвойства("phone");
	ЗаписьДЖС.ЗаписатьЗначение(СтандартизированныйТелефон);
	
	ЗаписьДЖС.ЗаписатьИмяСвойства("customer_group_id");
	ЗаписьДЖС.ЗаписатьЗначение(КодГруппыПользователей);
	ЗаписьДЖС.ЗаписатьИмяСвойства("company");
	ЗаписьДЖС.ЗаписатьЗначение(Клиент.Наименование);
	
	////БАЛАНС  
	Если ЗначениеЗаполнено(ВалютаБаланса.КодВебСинхронизации) Тогда
		ЗаписьДЖС.ЗаписатьИмяСвойства("balance");
		ЗаписьДЖС.ЗаписатьЗначение(СуммаБаланса);
		
		ЗаписьДЖС.ЗаписатьИмяСвойства("balance_currency");
		ЗаписьДЖС.ЗаписатьЗначение(ВалютаБаланса.КодВебСинхронизации);
	КонецЕсли;
	//
	ЗаписьДЖС.ЗаписатьКонецОбъекта();
	ЗаписьДЖС.ЗаписатьКонецМассива();
	ЗаписьДЖС.ЗаписатьКонецОбъекта();
	ТелоЗапроса = ЗаписьДЖС.Закрыть();
	
	Если НП.ЗащищенноеСоединение Тогда
		Порт = 443;
		ЗС   = Новый ЗащищенноеСоединениеOpenSSL; 
	Иначе
		ЗС 	 = Неопределено;
		Порт = 80;
	КонецЕсли;
	Прокси     = Новый ИнтернетПрокси(Ложь);		
	Соединение = Новый HTTPСоединение(НП.Адрес,Порт, , , Прокси,,ЗС);
	
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Content-Type","application/json");
	
	Сервис = "/api/users/import/";
	ЗапросHTTP = Новый HTTPЗапрос(Сервис,Заголовки);
	ЗапросHTTP.УстановитьТелоИзСтроки(ТелоЗапроса,,ИспользованиеByteOrderMark.НеИспользовать);
	РезультатЗапроса = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
	
	Если РезультатЗапроса.КодСостояния <> 200 Тогда
		Т = "Ошибка выполнения. Код "+РезультатЗапроса.КодСостояния;
		Т = Т+Символы.ПС+РезультатЗапроса.ПолучитьТелоКакСтроку();
		Рез.Вставить("Сообщение",Т);
		Сообщить(Т);
		Возврат Рез;
	КонецЕсли;
	
	Рез.Вставить("Успешно",Истина);
	Возврат Рез;
	
КонецФункции	

