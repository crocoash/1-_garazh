
// Обработчик события ПриНачалеРаботыСистемы вызывается
// для выполнения действий, требуемых для подсистемы ОткрытиеФормПриНачалеРаботыСистемы.
//
Процедура ОткрытиеФормПриНачалеРаботыСистемы() Экспорт
	ОткрытьФорму("Обработка.Э_BinotelPhone.Форма.ТелефонУправляемая",,, "Phone");
	
КонецПроцедуры

// Процедура вызывается из карточек тех объектов, у которых необходимо набрать номер
//
Процедура НабратьНомерКИ(ТекущаяСтрока, ИмяПоля="") Экспорт
		
	Если НЕ ЗначениеЗаполнено(ИмяПоля) Тогда
		ИмяПоля = "CRM_НомерТелефона";
	КонецЕсли;
	
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		Если ТекущаяСтрока.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			НомерАбонента = СокрЛП(ТекущаяСтрока[ИмяПоля]);
			Если НЕ ЗначениеЗаполнено(НомерАбонента) Тогда
				НомерАбонента = Э_ТелефонияBinotel.Э_ПреобразоватьНомерТелефонаБезРазделителей(ТекущаяСтрока.Представление);
			Иначе
				НомерАбонента = Э_ТелефонияBinotel.Э_ПреобразоватьНомерТелефонаБезРазделителей(НомерАбонента);
			КонецЕсли;	
			
			НабратьНомер(НомерАбонента);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура НабратьНомер(НомерАбонента) Экспорт
	Перем ФормаТелефон;
	
	ФормаТелефон = Э_BinotelPhone.ПолучитьФорму("Телефон");
	ФормаТелефон.Активизировать();
	Если НЕ ФормаТелефон.Открыта() Тогда
		ФормаТелефон.Открыть();
	КонецЕсли;
	ФормаТелефон.PhoneNumber = НомерАбонента;
	ФормаТелефон.Э_Позвонить();
КонецПроцедуры
 
Процедура Э_ОткрытьПанельБинотел(Э_BinotelPhone,ВыдаватьПредпреждение=Ложь) Экспорт
	Если РольДоступна("Э_BinotelПользователь") Тогда
		Если не ТипЗнч(Э_BinotelPhone)=Тип("ОбработкаМенеджер.Э_BinotelPhone") Тогда
		    Э_BinotelPhone=Обработки.Э_BinotelPhone;
		КонецЕсли;
		ФормаТелефонBinotel = Э_BinotelPhone.ПолучитьФорму("Телефон");
		Если НЕ ФормаТелефонBinotel.Открыта() Тогда
			ФормаТелефонBinotel.Открыть();
		иначе
		    ФормаТелефонBinotel.Активизировать();
			ФормаТелефонBinotel.КомандаЗвонкиОнлайн();
		КонецЕсли;
	иначе
		Если ВыдаватьПредпреждение Тогда
		     Сообщить(НСтр("ru='Для данного пользователя не доступна роль ""Binotel:Пользователь""';uk='Для цього користувача не доступна роль ""Binotel:Користувач""'")); 
		КонецЕсли; 
	КонецЕсли;
КонецПроцедуры
 
Процедура Э_BinotelПользовательДействие() Экспорт
    Э_ОткрытьПанельБинотел(Э_BinotelPhone,Истина);
КонецПроцедуры
 
Процедура Э_СписокАбонентовПозвонить(ТекКонтрагентСсылка) Экспорт
	Если не ЗначениеЗаполнено(ТекКонтрагентСсылка) Тогда
		Сообщить(НСтр("ru='Пустая ссылка на элемент справочника ""Контрагенты"". Возможно, элемент не записан.';uk='Порожнє посилання на елемент довідника ""Контрагенти"". Можливо, елемент не записаний.'"));     
		Возврат;	
	КонецЕсли; 
	
	ФормаАбоненты	 			=	ПолучитьОбщуюФорму("Э_ТелефонияСписокАбонентовПозвонить",,ТекКонтрагентСсылка); 	
	ФормаАбоненты.Контрагент	= 	ТекКонтрагентСсылка;
	ФормаАбоненты.Открыть();
КонецПроцедуры

Функция Э_ПозвонитьНаБинотел(СтатусЗвонка,PhoneNumber) Экспорт
	Перем Э_BinotelPhoneLoc;
	
	
	НомерТелефонаДляБинотел=Э_ТелефонияBinotel.Э_ПреобразоватьНомерТелефонаБезРазделителей(PhoneNumber);
	Э_BinotelPhoneLoc = Обработки.Э_BinotelPhone.Создать();
	generalCallID = Э_BinotelPhoneLoc.НабратьНомер(НомерТелефонаДляБинотел); 
	Если ЗначениеЗаполнено(generalCallID) Тогда 
		ВремяНачалаЗвонка = ТекущаяДата();
		СтатусЗвонка = Э_СтатусЗвонка(generalCallID);
	Иначе	
		СтатусЗвонка = Неопределено;
	КонецЕсли;
	Возврат generalCallID;
КонецФункции

Функция Э_СтатусЗвонка(generalCallID) Экспорт
	СтатусЗвонка = "";
	
	Если ЗначениеЗаполнено(generalCallID) Тогда
		result_details = Э_ТелефонияBinotel.sendRequest("stats/call-details", Новый Структура("generalCallID",generalCallID));
		СтруктураРезультат = Э_РаботаСJSON.Э_ПрочитатьJSON(result_details);
		Если ТипЗнч(СтруктураРезультат) = Тип("Структура") Тогда
			Если Найти(СтруктураРезультат["status"], "success") > 0 Тогда
				callDetails = СтруктураРезультат.callDetails.Получить(generalCallID);
				Если НЕ callDetails = Неопределено Тогда
					Если Найти(callDetails.disposition, "ONLINE") > 0 Тогда
						СтатусЗвонка = "ONLINE";
					ИначеЕсли callDetails.disposition <> "" Тогда
						СтатусЗвонка = "COMPLETED";
					КонецЕсли;	
				КонецЕсли;	
			Иначе	
				СтатусЗвонка = "not_success";
			КонецЕсли;
		Иначе
			СтатусЗвонка = "error";
		КонецЕсли;	
	КонецЕсли;	
	
	Если СтатусЗвонка <> "ONLINE" Тогда
		generalCallID = "";
		ВремяНачалаЗвонка = Дата(1,1,1); 
	КонецЕсли;	
	
	Возврат СтатусЗвонка;
КонецФункции	
 
Процедура ОтборВФормеСписка_ПредложитьСнятьИерархическийПросмотр(ТабличноеПолеПоиска,СпрашиватьСниматьЛиИерархическийПросмотр=Истина) Экспорт
	Если ТабличноеПолеПоиска.ИерархическийПросмотр Тогда
		Если СпрашиватьСниматьЛиИерархическийПросмотр=Неопределено или СпрашиватьСниматьЛиИерархическийПросмотр Тогда
		    ОтветНаВопрос = Вопрос("Для удобства поиска рекомендуется снять режим иерархического просмотра. Снять?", РежимДиалогаВопрос.ДаНет);
			Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
				ТабличноеПолеПоиска.ИерархическийПросмотр = Ложь;
			КонецЕсли; 
		иначе
			ТабличноеПолеПоиска.ИерархическийПросмотр = Ложь;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


// Функция Определяет индекс картинки
//
// Параметры
//  ВидСобытия - ПеречислениеСсылка.ВидыСобытий
//  ТипСобытия - ПеречислениеСсылка.ВходящееИсходящееСобытие
//
// Возвращаемое значение:
//  Индекс - число
//
Функция ОпределитьИндексКартинкиВидаСобытия(Объект,ТипСобытия = Неопределено) Экспорт

	Если ТипЗнч(Объект) = Тип("ДокументСсылка.Событие") Тогда
		ВидСобытия = Объект.ВидСобытия;
		ТипСобытия = Объект.ТипСобытия;
	Иначе
		ВидСобытия = Объект;
	КонецЕсли;
	
	Если ТипЗнч(ВидСобытия) = Тип("ПеречислениеСсылка.ВидыСобытий") Тогда
		
		Если ВидСобытия = Перечисления.ВидыСобытий.ТелефонныйЗвонок Тогда
			Если ТипСобытия = Перечисления.ВходящееИсходящееСобытие.Исходящее Тогда
				Возврат 14;
			Иначе
				Возврат 9;
			КонецЕсли;
		ИначеЕсли ВидСобытия = Перечисления.ВидыСобытий.ЛичнаяВстреча Тогда
			Если ТипСобытия = Перечисления.ВходящееИсходящееСобытие.Исходящее Тогда
				Возврат 15;
			Иначе
				Возврат 10;
			КонецЕсли;
		ИначеЕсли ВидСобытия = Перечисления.ВидыСобытий.ЭлектронноеПисьмо Тогда
			Если ТипСобытия = Перечисления.ВходящееИсходящееСобытие.Исходящее Тогда
				Возврат 16;
			Иначе
				Возврат 11;
			КонецЕсли;
		ИначеЕсли ВидСобытия = Перечисления.ВидыСобытий.ПочтовоеПисьмо Тогда
			Если ТипСобытия = Перечисления.ВходящееИсходящееСобытие.Исходящее Тогда
				Возврат 17;
			Иначе
				Возврат 12;
			КонецЕсли;
		Иначе
			Если ТипСобытия = Перечисления.ВходящееИсходящееСобытие.Исходящее Тогда
				Возврат 13;
			Иначе
				Возврат 8;
			КонецЕсли;
		КонецЕсли;
			
	Иначе
		Возврат 21;
	КонецЕсли;

КонецФункции // ОпределитьИндексКартинкиВидаСобытия()

