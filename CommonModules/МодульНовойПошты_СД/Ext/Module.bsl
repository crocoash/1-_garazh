Процедура  СозданиеДокументовПриИзмененииСтатуса(ДокЗаказа)
	Если ЗначениеЗаполнено(ДокЗаказа.НП_Статус) Тогда
		Если ДокЗаказа.НП_Статус.ВидДействия_СД = Перечисления.ВидыДействийДляСтатусаНП_СД.СозданиеВозврата Тогда
			СписокСозданияДокументов = Новый СписокЗначений;
			СписокСозданияДокументов.Добавить(Истина,"СоздатьВозврат");
			СписокСозданияДокументов.Добавить(Ложь,"СоздатьРТиУ");
			СписокСозданияДокументов.Добавить(Ложь,"СоздатьПКО");
		ИначеЕсли ДокЗаказа.НП_Статус.ВидДействия_СД = Перечисления.ВидыДействийДляСтатусаНП_СД.СозданиеРТиУ Тогда
			СписокСозданияДокументов = Новый СписокЗначений;
			СписокСозданияДокументов.Добавить(Ложь,"СоздатьВозврат");
			СписокСозданияДокументов.Добавить(Истина,"СоздатьРТиУ");
			СписокСозданияДокументов.Добавить(Ложь,"СоздатьПКО");
		ИначеЕсли ДокЗаказа.НП_Статус.ВидДействия_СД = Перечисления.ВидыДействийДляСтатусаНП_СД.СозданиеПКО Тогда
			СписокСозданияДокументов = Новый СписокЗначений;
			СписокСозданияДокументов.Добавить(Ложь,"СоздатьВозврат");
			СписокСозданияДокументов.Добавить(Истина,"СоздатьРТиУ");
			СписокСозданияДокументов.Добавить(Истина,"СоздатьПКО");
		Иначе
			Возврат;
		КонецЕсли;
		
		Для каждого Стр из СписокСозданияДокументов Цикл
			Если стр.Представление = "СоздатьВозврат" и стр.Значение Тогда
				СоздатьВозврат(ДокЗаказа);
			КонецЕсли;
			Если стр.Представление = "СоздатьРТиУ" и стр.Значение Тогда
				СоздатьРТиУ(ДокЗаказа);
			КонецЕсли;
			Если стр.Представление = "СоздатьПКО" и стр.Значение Тогда
				СоздатьПКО(ДокЗаказа);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура СоздатьВозврат(ДокЗаказа)   	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВозвратТоваровОтПокупателя.Ссылка
	|ИЗ
	|	Документ.ВозвратТоваровОтПокупателя КАК ВозвратТоваровОтПокупателя
	|ГДЕ
	|	НЕ ВозвратТоваровОтПокупателя.ПометкаУдаления
	|	И ВозвратТоваровОтПокупателя.ДокументЗаказНП_СД = &ДокументЗаказНП_СД";
	
	Запрос.УстановитьПараметр("ДокументЗаказНП_СД", ДокЗаказа.ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат;
	КонецЦикла;
	
	
	
	
	Запрос1 = Новый Запрос;
	Запрос1.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	НЕ РеализацияТоваровУслуг.ПометкаУдаления
	|	И РеализацияТоваровУслуг.ДокументЗаказНП_СД = &ДокументЗаказНП_СД";
	
	Запрос1.УстановитьПараметр("ДокументЗаказНП_СД", ДокЗаказа.ссылка);
	
	РезультатЗапроса1 = Запрос1.Выполнить();
	
	ВыборкаДетальныеЗаписи1 = РезультатЗапроса1.Выбрать();
	
	ДокРтиУ = Неопределено;
	Пока ВыборкаДетальныеЗаписи1.Следующий() Цикл
		ДокРтиУ = ВыборкаДетальныеЗаписи1.Ссылка;
	КонецЦикла; 
	
	Если ДокРтиУ = Неопределено тогда
		#Если Клиент тогда
			Сообщить("По заказу :" + ДокЗаказа + " не найтена реализация. Создания возврата невозможно");
		#КонецЕсли
		Возврат;
	КонецЕсли;
	
	
	
	НовыйДок = Документы.ВозвратТоваровОтПокупателя.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДата();
	НовыйДок.ДокументЗаказНП_СД = ДокЗаказа.ссылка;
	
	НовыйДок.СкладОрдер = ПолучитьСкладДляНП(НовыйДок.Дата);
	
	
	// Заполним реквизиты из стандартного набора по документу основанию.
	ЗаполнениеДокументов.ЗаполнитьШапкуДокументаПоОснованию(НовыйДок, ДокРтиУ.ссылка);
	
	Если ДокЗаказа.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.Оборудование Тогда
		НовыйДок.ВидОперации = Перечисления.ВидыОперацийВозвратТоваровОтПокупателя.Оборудование;
	КонецЕсли;
	
	НовыйДок.ВидПоступления = Перечисления.ВидыПоступленияТоваров.НаСклад;
	НовыйДок.Проект         = ДокРтиУ.Проект;
	НовыйДок.Сделка         = ДокРтиУ.ссылка; // заполняем сделку заказом покупателя или счетом на оплату
	
	Если ДокЗаказа.Проведен Тогда
		
		Если НовыйДок.ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером Тогда
			НовыйДок.ЗаполнитьТоварыНереализованнымиУпр("ПоДокументу", ДокРтиУ);
		Иначе
			// Скопируем табличные части из документа основания.
			НовыйДок.ЗаполнитьТоварыПоОснованию(ДокРтиУ);
		КонецЕсли;
		
		НовыйДок.ЗаполнитьВозвратнуюТаруПоОснованию(ДокРтиУ);
		
	КонецЕсли;
	СчетаУчета = УправлениеВзаиморасчетами.ПолучитьСчетаРасчетовСКонтрагентом(НовыйДок.Организация, НовыйДок.Контрагент, НовыйДок.ДоговорКонтрагента);
	
	Если НовыйДок.ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером Тогда
		НовыйДок.СчетУчетаРасчетовСКонтрагентом = СчетаУчета.СчетРасчетовПокупателя;
	ИначеЕсли НовыйДок.ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Бартерный Тогда
		НовыйДок.СчетУчетаРасчетовСКонтрагентом = СчетаУчета.СчетРасчетовПокупателяПриБартере;
	Иначе
		НовыйДок.СчетУчетаРасчетовСКонтрагентом = СчетаУчета.СчетРасчетовПокупателя;
	КонецЕсли;
	
	НовыйДок.СчетУчетаРасчетовПоАвансам     = НовыйДок.СчетУчетаРасчетовСКонтрагентом;
	
	НовыйДок.СчетУчетаРасчетовПоТаре          = СчетаУчета.СчетУчетаТарыПокупателя;
	НовыйДок.СчетУчетаРасчетовПоТареПоАвансам = НовыйДок.СчетУчетаРасчетовПоТаре;
	НовыйДок.СчетУчетаНДС 					 = СчетаУчета.СчетУчетаНДСПродаж;
	НовыйДок.СчетУчетаНДСПодтвержденный  	 = СчетаУчета.СчетУчетаНДСПродажПодтвержденный;
	
	НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
	
	#Если Клиент тогда
		Сообщить("По заказу :" + ДокЗаказа + " создан документ: " + НовыйДок);
	#КонецЕсли
	
