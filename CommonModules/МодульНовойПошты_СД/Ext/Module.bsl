Процедура ЗаполнитьСправочникУлицПоВыбраномуГороду(Дата = Неопределено)Экспорт 
	
	Метод = "getStreet";
	
	Если Дата = Неопределено Тогда
		датан=ТекущаяДата();
	Иначе
		датан = дата;
	КонецЕсли;
	
	КлючAPI = ПолучитьAPIКлючПоДате(датан);
	Если СокрЛП(КлючAPI) = "" Тогда
		СообщитьПользователю("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	Ключ = СокрЛП(КлючAPI);
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("КлючАПИ",Ключ);
	//Если ТаблицаМетодов = Неопределено Тогда
	//	ТаблицаМетодов = ПолучитьТаблицуМетодов();
	//КонецЕсли;
	//Для каждого Строка Из ТаблицаМетодов Цикл
	#Если Клиент тогда
	ОбработкаПрерыванияПользователя();
	#КонецЕсли
	ПараметрыМетода.Вставить("ИмяМетода",Метод);
	//Сообщить(Строка.Метод);
	//Если Строка.Метод = "getStreet" Или Строка.Метод = "getWarehouses" Или Строка.Метод = "getTimeIntervals" Тогда
	Форма_СД = Справочники.НП_Города.ПолучитьФормуВыбора();
	ВыбранГород = Форма_СД.ОткрытьМодально();
	Если ВыбранГород = Неопределено или ВыбранГород = Справочники.НП_Города.ПустаяСсылка() Тогда
		#Если Клиент тогда
		Предупреждение("Не выбран город");
		#КонецЕсли
		Возврат;
	КонецЕсли;
	//тзГорода = ПолучитьТаблицуСправочникаНП_Города();
	//Для Каждого Стр Из тзГорода Цикл
	//сообщить(Стр.Наименование);
	ПараметрыМетода.Вставить("CityRef",ВыбранГород.Идентификатор);
	ПараметрыМетода.Вставить("CityDescription",ВыбранГород.Наименование);
	Для Стр = 1 По 7 Цикл 
		ПараметрыМетода.Вставить("Page",Стр);
		ТекстЗапроса = ПолучитьТекстЗапроса(Метод,ПараметрыМетода);
		Если не ЗначениеЗаполнено(ТекстЗапроса) тогда
			СообщитьПользователю("Не удалось сформировать запрос по методу: "+Метод);
			Продолжить;
		КонецЕсли;
		ДокументДом  = ПолучитьОтветДОМ(ПолучитьТочкуВхода(),ТекстЗапроса,КлючAPI,ложь);
		Если  ДокументДом = Неопределено тогда
			СообщитьПользователю("Ошибка при получении ответа, метод: "+ Метод);
		КонецЕсли;
		Если не  ЭтоУспех(ДокументДом) тогда
			ТекстИсключения = ВернутьЕрор(ДокументДом);
			СообщитьПользователю(ТекстИсключения+" "+Метод);
		КонецЕсли;
		лВыполняемаяобработка = ПолучитьПроцедуруПоМетоду(Метод);
		Если не ЗначениеЗаполнено(лВыполняемаяобработка) тогда
			СообщитьПользователю(ТекстИсключения = "Не назначен обработчик методу: "+ Метод);
		КонецЕсли;
		Результат = новый Структура();
		РаспарситьОтвет(лВыполняемаяобработка, ДокументДом,Результат, Метод,ПараметрыМетода,КлючAPI,ложь);
		Если Метод <> "getStreet" И Метод <> "GETSTREET" И Стр >=1 Тогда
			Прервать;
		КонецЕсли;
	Конеццикла;
	//Конеццикла;
	//КонецЕсли;
	//КонецЦикла;
КонецПроцедуры

