Функция ПолучитьНомерПоследней(запрос,квостр,КлючAPI,Отладка)
	НомерПоследней = 1;
	Всего = 1;
	Ответ=GetXMLResponserNewPost(запрос,КлючAPI,Отладка);
	ОтветФорма=Ответ;
	Чтение=новый ЧтениеXML;
	Чтение.УстановитьСтроку(Ответ);	
	while(Чтение.Прочитать()) do
		if чтение.Имя="totalCount" and чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента тогда
			чтение.Прочитать();
			Всего=Число(чтение.Значение);			
		endif;
	enddo;
	НомерПоследней = ?(Всего/квостр - Цел(Всего/квостр) = 0,Цел(Всего/квостр),Цел(Всего/квостр)+1);
	Возврат НомерПоследней;
КонецФункции

