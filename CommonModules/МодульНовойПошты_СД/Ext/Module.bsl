  	Функция СоздатьВызовКурьера(ТекущийКлюч, CounterpartySender, ContactSenderRef, AddressSenderRef, PreferredDeliveryDate, PlanedWeight, TimeInterval) Экспорт
	
	Если ПустаяСтрока(ТекущийКлюч) Тогда
		СообщитьПользователю("Не указан API ключ");
		Возврат Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(PreferredDeliveryDate) Тогда
		СообщитьПользователю("Не указана дата доставки");
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПустаяСтрока(PlanedWeight) Тогда
		СообщитьПользователю("Не указан вес");
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПустаяСтрока(TimeInterval) Тогда
		СообщитьПользователю("Не указан интервал времени");
		Возврат Неопределено;
	КонецЕсли;

	ТекстЗапроса = "<?xml version=""1.0"" encoding=""UTF-8"" ?>
	|<root>
	|<apiKey>"+ТекущийКлюч+"</apiKey>
	|<system>API2</system>
	|<modelName>CarCallGeneral</modelName>
	|<calledMethod>saveCourierCall</calledMethod>
	|<methodProperties>
	|<CounterpartySender>"+CounterpartySender+"</CounterpartySender>
	|<ContactSenderRef>"+ContactSenderRef+"</ContactSenderRef>
	|<AddressSenderRef>"+AddressSenderRef+"</AddressSenderRef>
	|<PreferredDeliveryDate>"+Формат(PreferredDeliveryDate,"ДФ=dd.MM.yyyy")+"</PreferredDeliveryDate>
	|<PlanedWeight>"+PlanedWeight+"</PlanedWeight>
	|<TimeInterval>"+TimeInterval+"</TimeInterval>
	|</methodProperties>
	|</root>
	|";

	Попытка
		
		Попытка
			ХМЛХТТП = ПолучитьCOMОбъект("", "MSXML2.ServerXMLHTTP.6.0");
		Исключение
			ХМЛХТТП = ПолучитьCOMОбъект("", "Microsoft.XMLHTTP");
		КонецПопытки;

		ХМЛХТТП.Open("POST", ПолучитьТочкуВхода(), Ложь);
		ХМЛХТТП.SetRequestHeader("Content-Type", "text/xml; charset=utf-8");
		ХМЛХТТП.Send(ТекстЗапроса);

		ОтветXML = ХМЛХТТП.ResponseText;
		Если ПустаяСтрока(ОтветXML) Тогда
			Сообщить("Пустой ответ от API");
			Возврат Неопределено;
		КонецЕсли;
		
		
		Если НЕ API_ОбработатьОтветИСообщить(ОтветXML) Тогда
			Возврат Неопределено;
		КонецЕсли;

		
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ОтветXML);
		
		Barcode = Неопределено;
		
		Пока ЧтениеXML.Прочитать() Цикл
			
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента
				И ЧтениеXML.Имя = "Barcode" Тогда
				
				ЧтениеXML.Прочитать(); // переходим к тексту
				Barcode = ЧтениеXML.Значение;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат Barcode;  
		

	Исключение
		Сообщить(""+ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

