Процедура СоздатьПКО(ДокЗаказа)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПриходныйКассовыйОрдер.Ссылка
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	НЕ ПриходныйКассовыйОрдер.ПометкаУдаления
	|	И ПриходныйКассовыйОрдер.ДокументЗаказНП_СД = &ДокументЗаказНП_СД";
	
	Запрос.УстановитьПараметр("ДокументЗаказНП_СД", ДокЗаказа.ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат;
	КонецЦикла;
	
	
	
	НовыйДок = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
	НовыйДок.Дата = ТекущаяДата();
	НовыйДок.ОтражатьВУправленческомУчете = Истина;
	НовыйДок.ОтражатьВБухгалтерскомУчете = Истина;
	НовыйДок.Оплачено = Истина;
	НовыйДок.Организация = ДокЗаказа.Организация;
	НовыйДок.Касса = ПолучитьКассаДляНП(НовыйДок.Дата);//ДокЗаказа.Организация.ОсновнаяКасса;
	
	//НовыйДок.ВидОплаты_ТС = ВидОплаты;
	НовыйДок.ВидОперации = Перечисления.ВидыОперацийПКО.ОплатаПокупателя;                            
	НовыйДок.СуммаДокумента = ?(ДокЗаказа.НП_СуммаОбратнойДоставки = 0,ДокЗаказа.СуммаДокумента,ДокЗаказа.НП_СуммаОбратнойДоставки);
	НовыйДок.ВалютаДокумента = ДокЗаказа.ДоговорКонтрагента.ВалютаВзаиморасчетов;
	НовыйДок.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	
	СтруктураКурсаВзаиморасчетов = МодульВалютногоУчета.ПолучитьКурсВалюты(НовыйДок.ВалютаДокумента, НовыйДок.Дата);
	
	НовыйДок.КурсДокумента      = СтруктураКурсаВзаиморасчетов.Курс;
	НовыйДок.КратностьДокумента = СтруктураКурсаВзаиморасчетов.Кратность;
	
	Если НовыйДок.Касса.ВалютаДенежныхСредств = Константы.ВалютаРегламентированногоУчета.Получить() тогда
		НовыйДок.СчетКасса = ПланыСчетов.Хозрасчетный.КассаВНациональнойВалюте; 		
	иначе
		НовыйДок.СчетКасса = ПланыСчетов.Хозрасчетный.КассаВИностраннойВалюте;
	КонецЕсли;
	
	
	НовыйДок.Контрагент = ДокЗаказа.Контрагент;
	НовыйДок.ДоговорКонтрагента = ДокЗаказа.ДоговорКонтрагента;
	
	НовыйДок.ДокументОснование = ДокЗаказа.ссылка;
	НовыйДок.ДокументЗаказНП_СД = ДокЗаказа.ссылка;
	
	#Если Клиент тогда
	РаботаСДиалогами.ПриИзмененииЗначенияКассыБанковскогоСчета(НовыйДок.ВалютаДокумента, НовыйДок.КурсДокумента, НовыйДок.КратностьДокумента, НовыйДок.Дата, НовыйДок.СуммаДокумента, НовыйДок.Касса.ВалютаДенежныхСредств,Ложь);
	#КонецЕсли
	
	СтрокаПлатеж = НовыйДок.РасшифровкаПлатежа.Добавить();
	СтрокаПлатеж.ДоговорКонтрагента = НовыйДок.ДоговорКонтрагента;
	СтрокаПлатеж.СуммаПлатежа = ?(ДокЗаказа.НП_СуммаОбратнойДоставки = 0,ДокЗаказа.СуммаДокумента,ДокЗаказа.НП_СуммаОбратнойДоставки);
	СуммаНДС_СД = ДокЗаказа.Товары.Итог("СуммаНДС") + ДокЗаказа.Услуги.Итог("СуммаНДС");
	Если Не СуммаНДС_СД = 0 Тогда
		СтрокаПлатеж.СтавкаНДС = Перечисления.СтавкиНДС.НДС20;
		СтрокаПлатеж.СуммаНДС = СтрокаПлатеж.СуммаПлатежа / 6;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НовыйДок.Организация) Тогда
		
		НовыйДок.Организация = СтрокаПлатеж.ДоговорКонтрагента.Организация;
		
	КонецЕсли;
	
	СтрокаПлатеж.Сделка = ДокЗаказа.ссылка;
	СтрокаПлатеж.СтатьяДвиженияДенежныхСредств = СтрокаПлатеж.ДоговорКонтрагента.ОсновнаяСтатьяДвиженияДенежныхСредств; 
	УправлениеДенежнымиСредствами.УстановитьСтатьюДДСПоУмолчанию(СтрокаПлатеж,НовыйДок.ВидОперации);
	
	СтрокаПлатеж.ДокументПланированияПлатежа=Документы.ПланируемоеПоступлениеДенежныхСредств.ПустаяСсылка();
	
	СтрокаПлатеж.КурсВзаиморасчетов      = СтруктураКурсаВзаиморасчетов.Курс;
	СтрокаПлатеж.КратностьВзаиморасчетов = СтруктураКурсаВзаиморасчетов.Кратность;
	
	РассчитатьСуммуВзаиморасчетов(СтрокаПлатеж,НовыйДок);
	
	НовыйДок.ОпределитьСчетаУчетаРасчетовСКонтрагентом(СтрокаПлатеж);
	НовыйДок.Комментарий = "" + ДокЗаказа.НП_КонтактОтправителя;
	
	НовыйДок.Записать(РежимЗаписиДокумента.Проведение);
	
	#Если Клиент тогда
		Сообщить("По заказу :" + ДокЗаказа + " создан документ: " + НовыйДок);
	#КонецЕсли
	
КонецПроцедуры

Процедура РассчитатьСуммуВзаиморасчетов(СтрокаПлатеж,Док)
	
	ПроверкаКурсовВалют(СтрокаПлатеж);
	
	Если Док.ВидОперации=Перечисления.ВидыОперацийПКО.ВозвратДенежныхСредствПодотчетником Тогда
		ВалютаВзаиморасчетов=Док.ВалютаВзаиморасчетовРаботника;
	Иначе
		ВалютаВзаиморасчетов= СтрокаПлатеж.ДоговорКонтрагента.ВалютаВзаиморасчетов;
	КонецЕсли;
	
	Если (СтрокаПлатеж.КурсВзаиморасчетов <> 0) И (Док.КратностьДокумента <> 0) Тогда
		СтрокаПлатеж.СуммаВзаиморасчетов=МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(СтрокаПлатеж.СуммаПлатежа, Док.ВалютаДокумента,
		ВалютаВзаиморасчетов,
		Док.КурсДокумента, СтрокаПлатеж.КурсВзаиморасчетов,
		Док.КратностьДокумента, СтрокаПлатеж.КратностьВзаиморасчетов);	
	Иначе
		СтрокаПлатеж.СуммаВзаиморасчетов = 0;
	КонецЕсли;
	
	
КонецПроцедуры // РассчитатьСуммуВзаиморасчетов()

Процедура ПроверкаКурсовВалют(СтрокаПлатеж) Экспорт
	
	КурсДокумента=?(КурсДокумента=0,1, КурсДокумента);
	КратностьДокумента=?(КратностьДокумента=0,1, КратностьДокумента);
	
	Если Не СтрокаПлатеж=Неопределено Тогда
		СтрокаПлатеж.КурсВзаиморасчетов=?(СтрокаПлатеж.КурсВзаиморасчетов=0,1,СтрокаПлатеж.КурсВзаиморасчетов);
		СтрокаПлатеж.КратностьВзаиморасчетов=?(СтрокаПлатеж.КратностьВзаиморасчетов=0,1,СтрокаПлатеж.КратностьВзаиморасчетов);
	КонецЕсли;
	
КонецПроцедуры // ПроверкаКурсовВалют()

Функция ПолучитьТекстЗапроса(знач ИмяМетода, ПараметрыМетода = неопределено)
	
	Текст = "";
