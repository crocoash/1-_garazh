// Ref элемента справочника Новой Почты. Реквизиты заказа составного типа
// (НП_ОтделениеПолучения — Отделения/Почтоматы/АдресаКонтрагента/Строка), поэтому
// прямое обращение к .Идентификатор на строке или Неопределено падает.
Функция НП_ИдентификаторЗначения(Значение)

	Если Значение = Неопределено ИЛИ ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат СокрЛП(Значение.Идентификатор);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Контактное лицо в НП принадлежит конкретному контрагенту, и чужое она не принимает.
// Возвращает текст ошибки со списком подходящих контактов либо пустую строку.
// Контакты старых загрузок могут быть без реквизита Контрагент — их не трогаем,
// пусть решает сама НП, иначе заблокируем работающие заказы.
Функция НП_ОшибкаПринадлежностиКонтакта(Контакт, РефКонтрагента, Подпись, Контрагент)

	Если Не ЗначениеЗаполнено(Контакт) ИЛИ ПустаяСтрока(РефКонтрагента) Тогда
		Возврат "";
	КонецЕсли;

	РефКонтрагентаКонтакта = "";
	Попытка
		РефКонтрагентаКонтакта = СокрЛП(Контакт.Контрагент);
	Исключение
	КонецПопытки;

	Если ПустаяСтрока(РефКонтрагентаКонтакта) ИЛИ РефКонтрагентаКонтакта = РефКонтрагента Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 10
	                      |	НП_КонтактныеЛица.Наименование
	                      |ИЗ
	                      |	Справочник.НП_КонтактныеЛица КАК НП_КонтактныеЛица
	                      |ГДЕ
	                      |	НП_КонтактныеЛица.Контрагент = &РефКонтрагента
	                      |	И НЕ НП_КонтактныеЛица.ПометкаУдаления");
	Запрос.УстановитьПараметр("РефКонтрагента", РефКонтрагента);

	Подходящие = "";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Подходящие = ?(ПустаяСтрока(Подходящие), Выборка.Наименование, Подходящие + ", " + Выборка.Наименование);
	КонецЦикла;

	Текст = Символы.ПС + "- контакт " + Подпись + " «" + СокрЛП(Строка(Контакт))
		+ "» заведён в Новой Почте на другого контрагента, а не на «" + СокрЛП(Строка(Контрагент)) + "»";

	Если ПустаяСтрока(Подходящие) Тогда
		Текст = Текст + Символы.ПС + "  Подходящих контактов в справочнике нет — загрузите контактные лица этого контрагента из Новой Почты.";
	Иначе
		Текст = Текст + Символы.ПС + "  Подходят: " + Подходящие;
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Улица и дом из адреса получателя. Отдельные реквизиты элемента справочника
// приоритетнее наименования; если их нет — режем наименование («Центральна 2/1»)
// по последнему слову с цифрой, оно и есть дом.
Процедура НП_РазобратьАдресНаУлицуИДом(Знач ТекстАдреса, Улица, Дом)

	Улица = "";
	Дом = "";

	ТекстАдреса = СокрЛП(СтрЗаменить(ТекстАдреса, ",", " "));
	Если ПустаяСтрока(ТекстАдреса) Тогда
		Возврат;
	КонецЕсли;

	Слова = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ТекстАдреса, " ");
	ЦифрыСтрока = "0123456789";

	// дом — последнее слово, в котором есть цифра («2/1», «17-Б»)
	Для Каждого Слово Из Слова Цикл
		Слово = СокрЛП(Слово);
		Для Поз = 1 По СтрДлина(Слово) Цикл
			Если Найти(ЦифрыСтрока, Сред(Слово, Поз, 1)) > 0 Тогда
				Дом = Слово;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Слово Из Слова Цикл
		Если СокрЛП(Слово) = Дом Тогда
			Продолжить;
		КонецЕсли;
		Улица = ?(ПустаяСтрока(Улица), СокрЛП(Слово), Улица + " " + СокрЛП(Слово));
	КонецЦикла;

КонецПроцедуры

// Блок нового адреса для InternetDocument.save. Нужен, когда адрес получателя
// заведён в 1С руками и Ref Новой Почты у него нет: НП заводит адрес сама по тексту.
// Пустая строка — собрать не из чего, вызывающий код сообщает об этом пользователю.
Функция НП_БлокНовогоАдреса(ЗначениеАдреса)

	Улица = "";
	Дом = "";
	Квартира = "";

	Если ТипЗнч(ЗначениеАдреса) = Тип("Строка") Тогда
		НП_РазобратьАдресНаУлицуИДом(ЗначениеАдреса, Улица, Дом);
	ИначеЕсли ТипЗнч(ЗначениеАдреса) = Тип("СправочникСсылка.НП_АдресаКонтрагента")
		И ЗначениеЗаполнено(ЗначениеАдреса) Тогда
		Улица = СокрЛП(ЗначениеАдреса.Улица);
		Дом = СокрЛП(ЗначениеАдреса.Дом);
		Квартира = СокрЛП(ЗначениеАдреса.Квартира);
		Если ПустаяСтрока(Улица) ИЛИ ПустаяСтрока(Дом) Тогда
			УлицаИзИмени = "";
			ДомИзИмени = "";
			ТекстАдреса = ?(ПустаяСтрока(СокрЛП(ЗначениеАдреса.Адрес)), ЗначениеАдреса.Наименование, ЗначениеАдреса.Адрес);
			НП_РазобратьАдресНаУлицуИДом(ТекстАдреса, УлицаИзИмени, ДомИзИмени);
			Улица = ?(ПустаяСтрока(Улица), УлицаИзИмени, Улица);
			Дом = ?(ПустаяСтрока(Дом), ДомИзИмени, Дом);
		КонецЕсли;
	Иначе
		Возврат "";
	КонецЕсли;

	Если ПустаяСтрока(Улица) ИЛИ ПустаяСтрока(Дом) Тогда
		Возврат "";
	КонецЕсли;

	Возврат "
	|<NewAddress>1</NewAddress>
	|<RecipientAddressName>"+Улица+"</RecipientAddressName>
	|<RecipientHouse>"+Дом+"</RecipientHouse>
	|<RecipientFlat>"+Квартира+"</RecipientFlat>";

КонецФункции

Процедура ЗарегистрироватьЭН(ДокуменЗаказ,Обновить) Экспорт
	
	Если СокрЛП(ДокуменЗаказ.НП_APIКлюч) = "" Тогда
		СообщитьПользователю("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	Если ДокуменЗаказ.НП_Вес = 0 И ДокуменЗаказ.НП_Объем = 0 Тогда
		СообщитьПользователю("Введите значение веса или объема отправления");
		Возврат;
	КонецЕсли;
	Если Не Обновить Тогда
		Метод = "save";
		РефДок = "";
		ЕНРефДок = "";
		IntDocNumber = "";
	Иначе
		//Метод = "save";
		РефДок = "";
		ЕНРефДок = ДокуменЗаказ.НП_RefDoc;
		IntDocNumber = ДокуменЗаказ.НП_DocNumber;
		Метод = "update";
		Если Не ПроверитьРедактирование(ДокуменЗаказ.НП_DocNumber,ДокуменЗаказ.НП_ТелефонПолучателя,ДокуменЗаказ.НП_APIКлюч) = 1 Тогда
			СообщитьПользователю("Редактирование данного документа запрещено!");
			Возврат;
		КонецЕсли;
		РефДок = "
		|<Ref>"+ЕНРефДок+"</Ref>";
		//СообщитьПользователю("Для редактирования документа используйте кнопку Испарвить!");
		//Возврат;
	КонецЕсли;
	
	Места = "";  
	//возможно нужно будет доработать
	//Если ТабПараметрыМестСтр.Количество() > 0 Тогда
	Если ТипЗнч(ДокуменЗаказ.НП_ОтделениеПолучения) = Тип("СправочникСсылка.НП_Почтоматы") Тогда
		Места = Места + "
		|<OptionsSeat>";
		//Для Каждого строка Из ТабПараметрыМестСтр Цикл
			Места = Места + "
			|<item>
			|<volumetricVolume>"+(ДокуменЗаказ.НП_Вес*((40*30*10)/4000))+"</volumetricVolume>
			|<volumetricWidth>"+"40"+"</volumetricWidth>
			|<volumetricLength>"+"30"+"</volumetricLength>
			|<volumetricHeight>"+"10"+"</volumetricHeight>
			|<weight>"+ДокуменЗаказ.НП_Вес+"</weight>
			|</item>";
		//Конеццикла;
		Места = Места + "
		|</OptionsSeat>";
	КонецЕсли;
	ДопУслуги = ""; 
	//возможно нужно будет доработать
	//Если сокрЛП(НомерУпаковки) <> "" Тогда
	//	ДопУслуги = ДопУслуги + "
	//	|	<PackingNumber>"+сокрЛП(НомерУпаковки)+"</PackingNumber>";
	//КонецЕсли;
	Если ДокуменЗаказ.НП_КонтрольОплаты и не ДокуменЗаказ.НП_СуммаКонтрольОплаты = 0  Тогда
		ДопУслуги = ДопУслуги + "
		|	<AfterpaymentOnGoodsCost>"+стрЗаменить(ДокуменЗаказ.НП_СуммаКонтрольОплаты,Символы.НПП,"")+"</AfterpaymentOnGoodsCost>";
	КонецЕсли;

	Если сокрЛП(ДокуменЗаказ.НП_ВнутреннийНомер) <> "" Тогда
		ДопУслуги = ДопУслуги + "
		|	<InfoRegClientBarcodes>"+сокрЛП(ДокуменЗаказ.НП_ВнутреннийНомер)+"</InfoRegClientBarcodes>";
	КонецЕсли;
	//Если Суббота Тогда
	//	ДопУслуги = ДопУслуги + "
	//	|	<SaturdayDelivery>1</SaturdayDelivery>";
	//КонецЕсли;
	//Если Этаж > 0 Тогда
	//	//ДопУслуги = ДопУслуги + "
	//	//|<NumberOfFloorsLifting>"+Этаж+"</NumberOfFloorsLifting>"; //пока не делаем
	//конецЕсли;
	//Если ЭПалета Тогда
	//	ДопУслуги = ДопУслуги + "
	//	|<ExpressPallet>1</ExpressPallet>";
	//конецЕсли;
	//Если сокрЛП(СопровДок) <> "" Тогда
	//	ДопУслуги = ДопУслуги + "
	//	|	<AccompanyingDocuments>"+сокрЛП(СопровДок)+"</AccompanyingDocuments>";
	//КонецЕсли;
	Если сокрЛП(ДокуменЗаказ.НП_ДополнительнаяИнформация) <> "" Тогда
		ДопУслуги = ДопУслуги + "
		|	<AdditionalInformation>"+сокрЛП(ДокуменЗаказ.НП_ДополнительнаяИнформация)+"</AdditionalInformation>";
	КонецЕсли;
	//Если ЗначениеЗаполнено(ЖДД)  Тогда
	//	ДопУслуги = ДопУслуги + "
	//	|	<PreferredDeliveryDate>"+Формат(ЖДД,"ДФ=dd.MM.yyyy")+"</PreferredDeliveryDate>";
	//КонецЕсли;
		//Если ДеньВДень Тогда
	//	ДопУслуги = ДопУслуги + "
	//	|	<SameDayDelivery>1</SameDayDelivery>";
	//КонецЕсли;
	////Если ЗабратьДоверенность Тогда
	////	ДопУслуги = ДопУслуги + "
	////	|	<IsTakeAttorney>1</IsTakeAttorney>";
	////КонецЕсли;
	//Если ЛичноВРуки Тогда
	//	ДопУслуги = ДопУслуги + "
	//	|	<DeliveryByHand>1</DeliveryByHand>";
	//	Для Каждого Лицо Из тзПолучатели Цикл
	//		ДопУслуги = ДопУслуги + "
	//		|	<DeliveryByHandRecipients>"+Лицо.ФИО+"</DeliveryByHandRecipients>";
	//	Конеццикла;
	//КонецЕсли;
	
	Если не ДокуменЗаказ.НП_СуммаОбратнойДоставки = 0 Тогда //пока только возврат денег
		RedeliveryString = "Money";
		SumRedeliv = ДокуменЗаказ.НП_СуммаОбратнойДоставки;
		PayerRedel = ДокуменЗаказ.НП_ТипПлательщика.Идентификатор;
	иначе
		RedeliveryString = "";
	КонецЕсли;
	ОбратнаяДоставка = "";
	Если сокрЛП(RedeliveryString) <> "" Тогда 
		СуммаОД = "";
		Если RedeliveryString = "Money" Тогда
			Если SumRedeliv = 0 Тогда
				СообщитьПользователю("Сумма обратной доставки не указана!");
				Возврат;
			КонецЕсли;
			СуммаОД = "
			|	<RedeliveryString>"+СтрЗаменить(Строка(SumRedeliv),Символы.НПП,"")+"</RedeliveryString>";
			//ИначеЕсли RedeliveryString = "Documents" Тогда
			//	Если СокрЛП(DescRedeliv) = "" Тогда
			//		СообщитьПользователю("Описание документов обратной доставки не указано!");
			//		Возврат;
			//	КонецЕсли;
			//	СуммаОД = "
			//	|	<RedeliveryString>"+DescRedeliv+"</RedeliveryString>";
			//ИначеЕсли RedeliveryString = "Trays" Тогда
			//	Если тзПоддоныОбр.Итог("Количество") = 0 Тогда
			//		СообщитьПользователю("Количество поддонов для обратной доставки не указано!");
			//		Возврат;
			//	КонецЕсли;
			//	Поддоны = "";
			//	Для Каждого Под Из тзПоддоныОбр Цикл
			//		Поддоны = Поддоны + "
			//		|	<item>
			//		|	<Amount>"+Под.Количество+"</Amount>
			//		|	<CargoDescription>"+Под.ПоддонРеф+"</CargoDescription>
			//		|	</item>";
			//	КонецЦикла;
			//	СуммаОД = "
			//	|	<RedeliveryString>"+RedeliveryString_+"</RedeliveryString>
			//	|	<Trays>"+Поддоны+"
			//	|	</Trays>";
		КонецЕсли;
		ОбратнаяДоставка = ОбратнаяДоставка + "
		|	<BackwardDeliveryData>
		|	<item>
		|	<PayerType>"+сокрЛП(PayerRedel)+"</PayerType>
		|	<CargoType>"+сокрЛП(RedeliveryString)+"</CargoType>"+СуммаОД+"
		|	</item>
		|	</BackwardDeliveryData>";
		//Если RedeliveryString = "Trays" Тогда
		//	ОбратнаяДоставка = СтрЗаменить(ОбратнаяДоставка,"item","element");//превращаем в массив
		//КонецЕсли;	
	КонецЕсли;
	
	Если ДокуменЗаказ.НП_КонтрольОплаты тогда
		ОбратнаяДоставка = "";
	КонецЕсли;
	
	Amount = ДокуменЗаказ.НП_КоличествоМест;
	CargoDesc = ДокуменЗаказ.НП_ТипГруза.Наименование;
	ОписаниеГрузаДет = "";
	//Если ЗначениеЗаполнено(ДокуменЗаказ.НП_ДопИнформацияГруз) Тогда
	Если не ДокуменЗаказ.НП_ДопИнформацияГруз_табл.Количество() = 0 Тогда
	//Если CargoDesc <> "" И CargoDesc <> "Documents" Тогда
		ОписаниеГрузаДет = ОписаниеГрузаДет + "
		|<CargoDetails>";
		Для Каждого Стр_ДИ из ДокуменЗаказ.НП_ДопИнформацияГруз_табл Цикл
			ОписаниеГрузаДет = ОписаниеГрузаДет + "
		|<item>
		|<CargoDescription>"+Стр_ДИ.НП_ДопИнформацияГруз.Идентификатор+"</CargoDescription>
		|<Amount>"+стрЗаменить(Строка(Стр_ДИ.Количество),символы.НПП,"")+"</Amount>
		|</item>";
		КонецЦикла;
		ОписаниеГрузаДет = ОписаниеГрузаДет + "
		|</CargoDetails>";
	//КонецЕсли;
	КонецЕсли;
	
	Person3 = "";
	Лицо3 = "";
	//Если PayerType="ThirdPerson" И PForm = "NonCash" Тогда
	//	Лицо3 = "
	//	|<ThirdPerson>"+Person3+"</ThirdPerson>";
	//КонецЕсли;
	
	ServiceType = НП_ИдентификаторЗначения(ДокуменЗаказ.НП_ТипДоставки);

	CityRecipient = НП_ИдентификаторЗначения(ДокуменЗаказ.НП_ГородПолучателя);
	Recipient = НП_ИдентификаторЗначения(ДокуменЗаказ.НП_Получатель);
	Адрес = НП_ИдентификаторЗначения(ДокуменЗаказ.НП_ОтделениеПолучения);
	ContactRecipient = НП_ИдентификаторЗначения(ДокуменЗаказ.НП_КонтактПолучателя);

	// Адрес получателя без Ref (заведён руками, а не пришёл из кабинета НП) — отправляем
	// его как новый адрес текстом, иначе RecipientAddress уйдёт пустым и НП откажет.
	НовыйАдрес = "";
	Если ПустаяСтрока(Адрес) Тогда
		НовыйАдрес = НП_БлокНовогоАдреса(ДокуменЗаказ.НП_ОтделениеПолучения);
	КонецЕсли;

	// Новая Почта на пустые Ref отвечает невнятным «RecipientAddress not selected» —
	// говорим прямо, какое поле заказа не заполнено, и не тратим вызов API.
	ОшибкиПолучателя = "";
	Если ПустаяСтрока(CityRecipient) Тогда
		ОшибкиПолучателя = ОшибкиПолучателя + Символы.ПС + "- город получателя (НП_ГородПолучателя)";
	КонецЕсли;
	Если ПустаяСтрока(Адрес) И ПустаяСтрока(НовыйАдрес) Тогда
		Если ТипЗнч(ДокуменЗаказ.НП_ОтделениеПолучения) = Тип("СправочникСсылка.НП_АдресаКонтрагента")
			И ЗначениеЗаполнено(ДокуменЗаказ.НП_ОтделениеПолучения) Тогда
			ОшибкиПолучателя = ОшибкиПолучателя + Символы.ПС
				+ "- у адреса «" + СокрЛП(ДокуменЗаказ.НП_ОтделениеПолучения.Наименование)
				+ "» пуст Идентификатор (Ref Новой Почты), а по полям Улица и Дом адрес не собрать."
				+ Символы.ПС + "  Заполните в справочнике НП_АдресаКонтрагента реквизиты Улица и Дом.";
		ИначеЕсли ТипЗнч(ДокуменЗаказ.НП_ОтделениеПолучения) = Тип("Строка") И Не ПустаяСтрока(ДокуменЗаказ.НП_ОтделениеПолучения) Тогда
			ОшибкиПолучателя = ОшибкиПолучателя + Символы.ПС
				+ "- отделение получения введено текстом (""" + СокрЛП(ДокуменЗаказ.НП_ОтделениеПолучения)
				+ """), а нужно выбрать из справочника отделений/почтоматов/адресов";
		Иначе
			ОшибкиПолучателя = ОшибкиПолучателя + Символы.ПС + "- отделение (адрес) получения (НП_ОтделениеПолучения)";
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Recipient) Тогда
		ОшибкиПолучателя = ОшибкиПолучателя + Символы.ПС + "- получатель (НП_Получатель)";
	КонецЕсли;
	Если ПустаяСтрока(ContactRecipient) Тогда
		ОшибкиПолучателя = ОшибкиПолучателя + Символы.ПС + "- контактное лицо получателя (НП_КонтактПолучателя)";
	КонецЕсли;

	// НП требует, чтобы контактное лицо принадлежало именно этому контрагенту,
	// иначе отвечает «ContactSender/ContactRecipient does not belong to this Sender/Recipient».
	ОшибкиПолучателя = ОшибкиПолучателя + НП_ОшибкаПринадлежностиКонтакта(
		ДокуменЗаказ.НП_КонтактОтправителя,
		НП_ИдентификаторЗначения(ДокуменЗаказ.НП_Отправитель),
		"отправителя",
		ДокуменЗаказ.НП_Отправитель);
	ОшибкиПолучателя = ОшибкиПолучателя + НП_ОшибкаПринадлежностиКонтакта(
		ДокуменЗаказ.НП_КонтактПолучателя,
		Recipient,
		"получателя",
		ДокуменЗаказ.НП_Получатель);

	Если Не ПустаяСтрока(ОшибкиПолучателя) Тогда
		СообщитьПользователю("ЭН не создана. Проблемы с реквизитами Новой Почты:" + ОшибкиПолучателя);
		Возврат;
	КонецЕсли;

	БлокПолучателя = "";
	//Если Не Recipient_ = "Приватна особа - ввод по строке" Тогда
	Если ПустаяСтрока(Адрес) Тогда
		БлокПолучателя = БлокПолучателя + "
		|<CityRecipient>"+сокрлп(CityRecipient)+"</CityRecipient>
		|<Recipient>"+сокрлп(Recipient)+"</Recipient>"+НовыйАдрес+"
		|<ContactRecipient>"+сокрлп(ContactRecipient)+"</ContactRecipient>";
	Иначе
		БлокПолучателя = БлокПолучателя + "
		|<CityRecipient>"+сокрлп(CityRecipient)+"</CityRecipient>
