Процедура НП_ПолучитьИСохранитьКартинку(ЗаказПокупателя) Экспорт
	
	Если ЗаказПокупателя = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	ТТН = ЗаказПокупателя.НП_ТТН;
	ТекущийКлюч = ЗаказПокупателя.НП_APIКлюч;
	БазовыйКаталог = "N:\1С\НоваяПошта";

	
	Если Не ЗначениеЗаполнено(ТТН) Тогда
		Возврат;
	КонецЕсли;
	
		
	ЕДРПОУ = "";
	Если ЗначениеЗаполнено(ЗаказПокупателя.НП_Отправитель) Тогда
		Попытка
			ЕДРПОУ = ЗаказПокупателя.НП_Отправитель.ЕДРПОУ;
		Исключение
			ЕДРПОУ = "";
		КонецПопытки;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущийКлюч) Тогда  
		#Если Клиент Тогда
			Предупреждение("Не удалось сохранить ттн так как Не указан API ключ");
		#КонецЕсли

		
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЕДРПОУ) Тогда
		#Если Клиент Тогда 
			Предупреждение("Не удалось сохранить ттн так как указан ЕДРПОУ");
		#КонецЕсли	
		Возврат;
	КонецЕсли;
	
	Если Прав(БазовыйКаталог, 1) <> "\" Тогда
		БазовыйКаталог = БазовыйКаталог + "\";
	КонецЕсли;
	
	КаталогЕДРПОУ = БазовыйКаталог + НП_ПодготовитьИмяФайла(ЕДРПОУ);
	
	ФайлКаталога = Новый Файл(КаталогЕДРПОУ);
	Если Не ФайлКаталога.Существует() Тогда
		СоздатьКаталог(КаталогЕДРПОУ);
	КонецЕсли;
	
	ПолныйПуть = КаталогЕДРПОУ + "\" + НП_ПодготовитьИмяФайла(ТТН) + "_" + ЗаказПокупателя.Номер + ".pdf";
	
	ТекстЗапроса = "<?xml version=""1.0"" encoding=""UTF-8"" ?>"
	+ "<root>"
	+ "<apiKey>" + ТекущийКлюч + "</apiKey>"
	+ "<modelName>InternetDocument</modelName>"
	+ "<calledMethod>printDocument</calledMethod>"
	+ "<methodProperties>"
	+ "<DocumentRefs>"
	+ "<item>" + СокрЛП(ТТН) + "</item>"
	+ "</DocumentRefs>"
	+ "<Type>pdf</Type>"
	+ "</methodProperties>"
	+ "</root>";
	
	Попытка
		
		Попытка
			ХМЛХТТП = ПолучитьCOMОбъект("", "MSXML2.ServerXMLHTTP.6.0");
		Исключение
			ХМЛХТТП = ПолучитьCOMОбъект("", "Microsoft.XMLHTTP");
		КонецПопытки;
		
		ХМЛХТТП.Open("POST", ПолучитьТочкуВхода(), Ложь);
		ХМЛХТТП.SetRequestHeader("Content-Type", "text/xml");
		ХМЛХТТП.Send(ТекстЗапроса);
		
		ТипКонтента = "";
		Попытка
			ТипКонтента = ХМЛХТТП.GetResponseHeader("Content-Type");
		Исключение
		КонецПопытки;
		
		Если Найти(НРег(ТипКонтента), "xml") > 0 Или Найти(НРег(ТипКонтента), "html") > 0 Тогда
			#Если клиент Тогда
				Предупреждение("НП не вернула PDF: " + ХМЛХТТП.ResponseText);
			#КонецЕсли
			
			Возврат;
		КонецЕсли;
		
		Буфер = ХМЛХТТП.ResponseBody();
		
		Поток = Новый COMОбъект("ADODB.Stream");	
		Поток.Type = 1;
		Поток.Mode = 3;
		Поток.Open();	
		Поток.Write(Буфер);
		
		ФайлPDF = Новый Файл(ПолныйПуть);
		Если ФайлPDF.Существует() Тогда
			УдалитьФайлы(ПолныйПуть);
		КонецЕсли;
		
		Поток.SaveToFile(ПолныйПуть);
		Поток.Close();
		
	Исключение
		#Если клиент Тогда
				Предупреждение("Ошибка получения/сохранения PDF: " + ОписаниеОшибки());
			#КонецЕсли
		
		Возврат;
	КонецПопытки;
	
КонецПроцедуры


Функция НП_ПолучитьПутьКPDF(ЗаказПокупателя) Экспорт
	
	Если ЗаказПокупателя = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ТТН = ЗаказПокупателя.НП_ТТН;
	БазовыйКаталог = "N:\1С\НоваяПошта";
	
	ЕДРПОУ = "";
	Если ЗначениеЗаполнено(ЗаказПокупателя.НП_Отправитель) Тогда
		Попытка
			ЕДРПОУ = ЗаказПокупателя.НП_Отправитель.ЕДРПОУ;
		Исключение
			ЕДРПОУ = "";
		КонецПопытки;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЕДРПОУ) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТТН) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Прав(БазовыйКаталог, 1) <> "\" Тогда
		БазовыйКаталог = БазовыйКаталог + "\";
	КонецЕсли;
	
	КаталогЕДРПОУ = БазовыйКаталог + НП_ПодготовитьИмяФайла(ЕДРПОУ);
	ПолныйПуть = КаталогЕДРПОУ + "\" + НП_ПодготовитьИмяФайла(ТТН) + "_" + ЗаказПокупателя.Номер + ".pdf";
	
	Возврат ПолныйПуть;
	
КонецФункции

 Процедура НП_УдалитьPDFФайлПоПути(ПолныйПуть) Экспорт
	
	Если ПустаяСтрока(ПолныйПуть) Тогда
		Возврат;
	КонецЕсли;
	
	ФайлPDF = Новый Файл(ПолныйПуть);
	Если Не ФайлPDF.Существует() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		FSO = Новый COMОбъект("Scripting.FileSystemObject");
		FSO.DeleteFile(ПолныйПуть, Истина);
	Исключение
		СообщитьПользователю("Не удалось удалить PDF файл: " + ПолныйПуть + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры



Процедура НП_ОткрытьКартинку(ЗаказПокупателя) Экспорт
	
	Если ЗаказПокупателя = Неопределено Тогда
		Сообщить("Не передан заказ");
		Возврат;
	КонецЕсли;
	
	ПолныйПуть = НП_ПолучитьПутьКPDF(ЗаказПокупателя);
	Если ПустаяСтрока(ПолныйПуть) Тогда
		Сообщить("Не удалось сформировать путь к PDF");
		Возврат;
	КонецЕсли;
	
	ФайлPDF = Новый Файл(ПолныйПуть);
	Если Не ФайлPDF.Существует() Тогда
		Попытка
			НП_ПолучитьИСохранитьКартинку(ЗаказПокупателя);
		Исключение
			Сообщить("Не удалось получить файл: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		
		ФайлPDF = Новый Файл(ПолныйПуть);
		Если Не ФайлPDF.Существует() Тогда
			Сообщить("Файл не удалось сохранить: " + ПолныйПуть);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЗапуститьПриложение(ПолныйПуть);
	
КонецПроцедуры


Функция НП_ПодготовитьИмяФайла(СтрокаИмени) Экспорт
	
	Результат = СокрЛП(СтрокаИмени);
	
	Результат = СтрЗаменить(Результат, "\", "_");
	Результат = СтрЗаменить(Результат, "/", "_");
	Результат = СтрЗаменить(Результат, ":", "_");
	Результат = СтрЗаменить(Результат, "*", "_");
	Результат = СтрЗаменить(Результат, "?", "_");
