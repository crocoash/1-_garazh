  Функция Обработать_getCounterpartyContactPersons(
	ЭлементДом,
	Результат,
	Владелец,
	Параметры) Экспорт
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("Ref", "");
	СтруктураПараметров.Вставить("Description", "");
	СтруктураПараметров.Вставить("Phones", "");
	СтруктураПараметров.Вставить("Email", "");
	СтруктураПараметров.Вставить("LastName", "");
	СтруктураПараметров.Вставить("FirstName", "");
	СтруктураПараметров.Вставить("MiddleName", "");
	
	Пока ЭлементДом <> Неопределено Цикл
		
		ИмяУзла = "";
		ЗначениеУзла = "";
		
		Попытка
			ИмяУзла = СокрЛП(Строка(ЭлементДом.ИмяУзла));
		Исключение
			ИмяУзла = "";
		КонецПопытки;
		
		// Пропускаем служебные узлы XML:
		// #text, #comment и другие.
		Если Не ПустаяСтрока(ИмяУзла)
			И Лев(ИмяУзла, 1) <> "#" Тогда
			
			Попытка
				ЗначениеУзла =
					СокрЛП(
						Строка(
							ЭлементДом.ТекстовоеСодержимое));
			Исключение
				ЗначениеУзла = "";
			КонецПопытки;
			
			Если ИмяУзла = "Ref" Тогда
				
				СтруктураПараметров.Ref = ЗначениеУзла;
				
			ИначеЕсли ИмяУзла = "Description" Тогда
				
				СтруктураПараметров.Description = ЗначениеУзла;
				
			ИначеЕсли ИмяУзла = "Phones" Тогда
				
				СтруктураПараметров.Phones = ЗначениеУзла;
				
			ИначеЕсли ИмяУзла = "Email" Тогда
				
				СтруктураПараметров.Email = ЗначениеУзла;
				
			ИначеЕсли ИмяУзла = "LastName" Тогда
				
				СтруктураПараметров.LastName = ЗначениеУзла;
				
			ИначеЕсли ИмяУзла = "FirstName" Тогда
				
				СтруктураПараметров.FirstName = ЗначениеУзла;
				
			ИначеЕсли ИмяУзла = "MiddleName" Тогда
				
				СтруктураПараметров.MiddleName = ЗначениеУзла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЭлементДом = ЭлементДом.СледующийСоседний;
		
	КонецЦикла;
	
	// Новая Почта вернула ошибку вместо контактного лица,
	// например Counterparty not found.
	// Ничего не показываем и просто пропускаем эту запись.
	Если ПустаяСтрока(СтруктураПараметров.Ref) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НайденСправочник =
		Справочники.НП_КонтактныеЛица.НайтиПоРеквизиту(
			"Идентификатор",
			СтруктураПараметров.Ref);
	
	Если НайденСправочник =
		Справочники.НП_КонтактныеЛица.ПустаяСсылка() Тогда
		
		ЕлементСправочника =
			Справочники.НП_КонтактныеЛица.СоздатьЭлемент();
		
		#Если Клиент Тогда
			
			Сообщить(
				"Записано контактное лицо: "
				+ СтруктураПараметров.Description);
			
		#КонецЕсли
		
	Иначе
		
		ЕлементСправочника =
			НайденСправочник.ПолучитьОбъект();
		
		#Если Клиент Тогда
			
			Сообщить(
				"Обновлено контактное лицо: "
				+ ЕлементСправочника.Наименование);
			
		#КонецЕсли
		
	КонецЕсли;
	
	Попытка
		ЕлементСправочника.Контрагент = Параметры.Контрагент;
	Исключение
		ЕлементСправочника.Контрагент = Владелец;
	КонецПопытки;
	
	ЕлементСправочника.Идентификатор =
		СтруктураПараметров.Ref;
	
	ЕлементСправочника.КонтактноеЛицо =
		СтруктураПараметров.Description;
	
	ЕлементСправочника.Телефон =
		СтруктураПараметров.Phones;
	
	ЕлементСправочника.Email =
		СтруктураПараметров.Email;
	
	ЕлементСправочника.Фамилия =
		СтруктураПараметров.LastName;
	
	ЕлементСправочника.Имя =
		СтруктураПараметров.FirstName;
	
	ЕлементСправочника.Отчество =
		СтруктураПараметров.MiddleName;
	
	Если Не ПустаяСтрока(СтруктураПараметров.Description) Тогда
		
		ЕлементСправочника.Наименование =
			СтруктураПараметров.Description;
		
	Иначе
		
		ПолноеИмя =
			СокрЛП(
				СтруктураПараметров.LastName
				+ " "
				+ СтруктураПараметров.FirstName
				+ " "
				+ СтруктураПараметров.MiddleName);
		
		Если Не ПустаяСтрока(ПолноеИмя) Тогда
			
			ЕлементСправочника.Наименование = ПолноеИмя;
			
		Иначе
			
			ЕлементСправочника.Наименование =
				СтруктураПараметров.Ref;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Попытка
		
		ЕлементСправочника.API_ключ =
			Параметры.КлючAPI;
		
	Исключение
		
		Попытка
			
			ЕлементСправочника.API_ключ =
				Параметры.КлючАПИ;
			
		Исключение
		КонецПопытки;
		
	КонецПопытки;
	
	Попытка
		
		ЕлементСправочника.Записать();
		
	Исключение
		
		// Ошибка одной записи не должна останавливать
		// обновление остальных контактных лиц.
		Возврат Неопределено;
		
	КонецПопытки;
	
	Возврат ЕлементСправочника.Ссылка;
	
КонецФункции

Функция Обработать_getTimeIntervals(ЭлементДом,Результат, Владелец, Параметры)
	СтруктураПараметров = Новый структура;
	
	Пока не ЭлементДом = неопределено цикл
		Если не СтруктураПараметров.Свойство(ЭлементДом.ИмяУзла)  тогда
			СтруктураПараметров.Вставить(Строка(ЭлементДом.ИмяУзла),ЭлементДом.ТекстовоеСодержимое);
		Иначе
			Текст = "Ошибка getTimeIntervals";
			ВызватьИсключение Текст;
		КонецЕсли;	 
		ЭлементДом = ЭлементДом.СледующийСоседний; 
	КонецЦикла;
	СтруктураПараметров.Вставить("Владелец",Владелец);
	//Строка = ЭтаФорма.тзИнтервалы.Добавить();
	ПоискНаименованию = ""+Параметры.CityRef + " " + СтруктураПараметров.Number + " " + СтруктураПараметров.Start + " " + СтруктураПараметров.End;  
	НайденСправочник = Справочники.НП_ВременныеИнтервалы.НайтиПоНаименованию(ПоискНаименованию);
	Если НайденСправочник = Справочники.НП_ВременныеИнтервалы.ПустаяСсылка() Тогда
		ЕлементСправочника	= Справочники.НП_ВременныеИнтервалы.СоздатьЭлемент();
		#Если клиент тогда 
			Сообщить("Записан интервал : " + ПоискНаименованию + "");
		#КонецЕсли 
	Иначе
		ЕлементСправочника	= НайденСправочник.ПолучитьОбъект();
		#Если клиент тогда 
			Сообщить("Обновлен интервал : " + ЕлементСправочника.Наименование + "");
		#КонецЕсли 
	КонецЕсли;
	ЕлементСправочника.Город = Параметры.CityRef;
	ЕлементСправочника.НомерИнтервала = СтруктураПараметров.Number;
	ЕлементСправочника.ИнтервалНачало = СтруктураПараметров.Start;
	ЕлементСправочника.ИнтервалКонец = СтруктураПараметров.End;
	ЕлементСправочника.Дата = ТекущаяДата();
	ЕлементСправочника.Наименование = ПоискНаименованию;
	ЕлементСправочника.Записать();
КонецФункции

