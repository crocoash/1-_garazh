	Функция ПолучитьИнтервалыСамовывоза(SenderSettlementRef, Дата, ТекущийКлюч) Экспорт

	// === Проверки ===
	Если ПустаяСтрока(ТекущийКлюч) Тогда
		СообщитьПользователю("Не указан API ключ");
		Возврат Неопределено;
	КонецЕсли;

	// === Формируем XML ===
	ТекстЗапроса =
	"<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС +
	"<root>" + Символы.ПС +
	"  <apiKey>" + ТекущийКлюч + "</apiKey>" + Символы.ПС +
	"  <modelName>Common</modelName>" + Символы.ПС +
	"  <calledMethod>getPickupTimeIntervals</calledMethod>" + Символы.ПС +
	"  <methodProperties>" + Символы.ПС +
	"    <SenderCityRef>" + SenderSettlementRef + "</SenderCityRef>" + Символы.ПС +
	"    <DateTime>" + Формат(Дата, "ДФ=dd.MM.yyyy") + "</DateTime>" + Символы.ПС +
	"  </methodProperties>" + Символы.ПС +
	"</root>";

	Попытка

		// === HTTP ===
		Попытка
			HTTP = ПолучитьCOMОбъект("", "MSXML2.ServerXMLHTTP.6.0");
		Исключение
			HTTP = ПолучитьCOMОбъект("", "Microsoft.XMLHTTP");
		КонецПопытки;

		ТочкаВхода = ПолучитьТочкуВхода();

		HTTP.Open("POST", ТочкаВхода, Ложь);
		HTTP.SetRequestHeader("Content-Type", "text/xml; charset=utf-8");
		HTTP.Send(ТекстЗапроса);

		ОтветXML = HTTP.ResponseText; 
		
		Если НЕ API_ОбработатьОтветИСообщить(ОтветXML) Тогда
			Возврат Неопределено;
		КонецЕсли;

		
		Возврат XML_ВыгрузитьItemsВТаблицуЗначений(ОтветXML);
		 
	Исключение
		Сообщить("❌ Ошибка API:");
		Сообщить(ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

