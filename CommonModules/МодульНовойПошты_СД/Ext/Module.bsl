Функция ПолучитьСтатусИзПравочника(СтатусНаименование)
	Если СтатусНаименование = "" ТОгда
		Возврат Справочники.НП_Статусы.ПустаяСсылка();
	КонецЕсли;
	
	
	СтатусНаименование = ?(Найти(СтатусНаименование,"Відправлення прямує до міста") = 0,СтатусНаименование,"Відправлення прямує до міста одержувача");
	
	СтатусНаименование = ?(Найти(СтатусНаименование,"Відправлення прямує до м") = 0,СтатусНаименование,"Відправлення прямує до міста одержувача");
	
	СтатусНаименование = ?(Найти(СтатусНаименование,"Відправлення прямує до") = 0,СтатусНаименование,"Відправлення прямує до міста одержувача");
	
	СтатусНаименование = ?(Найти(СтатусНаименование,"Готується до відправлення") = 0,СтатусНаименование,"Готується до відправлення");
	
	СтатусНаименование = ?(Найти(СтатусНаименование,"Видано кур'єру у") = 0,СтатусНаименование,"Видано кур'єру");
	
	СтатусНаименование = ?(Найти(СтатусНаименование,"Відправлення у") = 0,СтатусНаименование,"Відправлення у місці отримання");
	
	если не Найти(СтатусНаименование,"Відправлення отримано. Протягом доби відправник отримає SMS-повідомлення")= 0 Тогда
		СтатусНаименование = "Відправлення отримано. Протягом доби відправник отримає SMS-повідомлення";
	КонецЕсли;
	
	
	если не Найти(СтатусНаименование,"Відправлення у місті")= 0 Тогда
		Если не СтатусНаименование = "Відправлення у місті Київ" Тогда
			СтатусНаименование = "Відправлення у місті одержувача";
		КонецЕсли;
	КонецЕсли;
	
	НайденСтатус = Справочники.НП_Статусы.НайтиПоНаименованию(СтатусНаименование,истина);
	Если НайденСтатус = Неопределено или НайденСтатус = Справочники.НП_Статусы.ПустаяСсылка() Тогда
		НовыйСтатус = Справочники.НП_Статусы.СоздатьЭлемент();
		НовыйСтатус.Наименование = СтатусНаименование;
		НовыйСтатус.НаименованиеПолное = СтатусНаименование;
		НовыйСтатус.ВидДействия_СД = Перечисления.ВидыДействийДляСтатусаНП_СД.ПропуститьСтатус;
		НовыйСтатус.Записать();
		
		
		#Если Клиент Тогда
			Предупреждение("Укажите вид действия для статуса :" + СтатусНаименование);
			Форма_СД = НовыйСтатус.ПолучитьФорму("ФормаЭлемента");
			Форма_СД.ОткрытьМодально();
		#КонецЕсли
		Возврат НовыйСтатус.Ссылка;
	Иначе
		Возврат НайденСтатус.Ссылка;
	КонецЕсли;
КонецФункции

Функция ПолучитьСписокКлючейЗаПериод(Нач,Кон) Экспорт 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Период,
	|	ВложенныйЗапрос.API_ключ
	|ИЗ
	|	(ВЫБРАТЬ
	|		НастройкаОбменаНоваяПошта_СДСрезПервых.Период КАК Период,
	|		НастройкаОбменаНоваяПошта_СДСрезПервых.API_ключ КАК API_ключ
	|	ИЗ
	|		РегистрСведений.НастройкаОбменаНоваяПошта_СД.СрезПервых(&Нач, ) КАК НастройкаОбменаНоваяПошта_СДСрезПервых
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		НастройкаОбменаНоваяПошта_СДСрезПоследних.Период,
	|		НастройкаОбменаНоваяПошта_СДСрезПоследних.API_ключ
	|	ИЗ
	|		РегистрСведений.НастройкаОбменаНоваяПошта_СД.СрезПоследних(&Кон, ) КАК НастройкаОбменаНоваяПошта_СДСрезПоследних) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Период,
	|	ВложенныйЗапрос.API_ключ";
	
	Запрос.УстановитьПараметр("Кон", КонецДня(Кон));
	Запрос.УстановитьПараметр("Нач", НачалоДня(Нач));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
	
	Для каждого Стр из ВыборкаДетальныеЗаписи Цикл
		Если НачалоДня(Стр.Период) < НачалоДня(Нач) Тогда
			Стр.Период = НачалоДня(Нач);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВыборкаДетальныеЗаписи;
	
КонецФункции

Функция ПолучитьAPIКлючПоДате(Дата,ТолькоАктивныеОтправители = Ложь)Экспорт 
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Даний фрагмент побудований конструктором.
	// При повторному використанні конструктора, внесені вручну зміни будуть втрачені!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	НастройкаОбменаНоваяПошта_СД.API_ключ,
	|	НастройкаОбменаНоваяПошта_СД.Период КАК Период,
	|	НастройкаОбменаНоваяПошта_СД.АктивныйКлюч
	|ИЗ
	|	РегистрСведений.НастройкаОбменаНоваяПошта_СД КАК НастройкаОбменаНоваяПошта_СД
	|ГДЕ
	|	НастройкаОбменаНоваяПошта_СД.Период <= &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ТолькоАктивныеОтправители Тогда
			Если ВыборкаДетальныеЗаписи.АктивныйКлюч Тогда
				Возврат ВыборкаДетальныеЗаписи.API_ключ
			Иначе
				Продолжить;
			КонецЕсли;
		Иначе
			Возврат ВыборкаДетальныеЗаписи.API_ключ;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
КонецФункции

