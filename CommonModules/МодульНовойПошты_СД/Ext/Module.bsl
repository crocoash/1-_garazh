Процедура УдалитьПомеченныеНажатие(ДокументЗнач) Экспорт 
	Если СокрЛП(ДокументЗнач.НП_APIКлюч) = "" Тогда
		СообщитьПользователю("Не внесен ключ API, функционал недоступен!");
		Возврат;
	КонецЕсли;
	ТаблДок = Новый ТаблицаЗначений;
	ТаблДок.Колонки.Добавить("ЕНреф");
	Новаястрока =ТаблДок.Добавить();
	Новаястрока.ЕНреф = ДокументЗнач.НП_RefDoc;
	УдалитьИзРеестра(ДокументЗнач.НП_APIКлюч,ТаблДок);
	//СписокУдаленных.Добавить(СтруктураОтбора.ЕНреф);
	//Строка.Удален = "Y";
	ПараметрыМетода = Новый Структура;
	ПараметрыМетода.Вставить("API20",ДокументЗнач.НП_APIКлюч);
	ПараметрыМетода.Вставить("ТабРеф",ТаблДок);
	ПараметрыМетода.Вставить("Заказ",ДокументЗнач);
	ТекстЗапроса = ПолучитьЗапрос_deleteDoc(ПараметрыМетода);
	ДокументДом  = ПолучитьОтветДОМ(ПолучитьТочкуВхода(),ТекстЗапроса,ДокументЗнач.НП_APIКлюч,ложь);
	Если ДокументДом = Неопределено тогда
		СообщитьПользователю("Ошибка при получении ответа, метод: insertDocumentsScanSheet");
	КонецЕсли;
	Если не  ЭтоУспех(ДокументДом) тогда
		ТекстИсключения = ВернутьЕрор(ДокументДом);
		СообщитьПользователю(ТекстИсключения+" deleteDoc");
	КонецЕсли;
	лВыполняемаяобработка = ПолучитьПроцедуруПоМетоду("deleteDoc");
	Если не ЗначениеЗаполнено(лВыполняемаяобработка) тогда
		СообщитьПользователю(ТекстИсключения = "Не назначен обработчик методу: deleteDoc");
	КонецЕсли;
	Результат = новый Структура();
	РаспарситьОтвет(лВыполняемаяобработка, ДокументДом,Результат, "deleteDoc",ПараметрыМетода,ДокументЗнач.НП_APIКлюч,ложь);
КонецПроцедуры



