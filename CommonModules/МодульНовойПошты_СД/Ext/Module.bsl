Функция ЗарегистрироватьНовоеКонтактноеЛицо(ТекущийКлюч,Идентификатор,ФамилияКонтакт,ИмяКонтакт,ОтчествоКонтакт,ТелефонКонтакт,EmailКонтакт)Экспорт 
	Если СокрЛП(ТекущийКлюч) = "" Тогда
		СообщитьПользователю("Не внесен ключ API, функционал недоступен!");
		Возврат "";
	КонецЕсли;
	Если сокрЛП(ТелефонКонтакт) <> "" Тогда
		Если СтрДлина(СокрЛП(ТелефонКонтакт)) = 10 и Лев(СокрЛП(ТелефонКонтакт),2) <> "38" Тогда
			ТелефонКонтакт = "38"+СокрЛП(ТелефонКонтакт);
		иначеЕсли НЕ (СтрДлина(СокрЛП(ТелефонКонтакт)) = 12 и Лев(СокрЛП(ТелефонКонтакт),2) = "38") Тогда
			СообщитьПользователю("Телефон задан неверно! Пожалуйста, введите телефон в формате 38-код-номер");
			возврат "";
		КонецЕсли;
	КонецЕсли;	
	Если СокрЛП(Идентификатор) <> "" Тогда
		ТекстЗАпроса = "<?xml version=""1.0"" encoding=""UTF-8"" ?>
		|<file>
		|<apiKey>"+ТекущийКлюч+"</apiKey>
		|<modelName>ContactPersonGeneral</modelName>
		|<calledMethod>save</calledMethod>
		|<methodProperties>
		//|<MarketplacePartnerToken>005056887b8d-856b-11e6-908b-c675fbc3</MarketplacePartnerToken>
		|<CounterpartyRef>"+СокрЛП(Идентификатор)+"</CounterpartyRef>
		//|<Email>"+СокрЛП(EmailКонтакт)+"</Email>
		|<FirstName>"+СокрЛП(ИмяКонтакт)+"</FirstName>
		|<LastName>"+СокрЛП(ФамилияКонтакт)+"</LastName>
		|<MiddleName>"+СокрЛП(ОтчествоКонтакт)+"</MiddleName>
		|<Phone>"+СокрЛП(ТелефонКонтакт)+"</Phone>
		|</methodProperties>
		|</file>
		|";
		Попытка
			ХМЛХТТП = ПолучитьCOMОбъект("", "MSXML2.ServerXMLHTTP.6.0");
		Исключение
			ХМЛХТТП = ПолучитьCOMОбъект("", "Microsoft.XMLHTTP");
		КонецПопытки;
		ХМЛХТТП.Open("POST", ПолучитьТочкуВхода(), Ложь);
		ХМЛХТТП.SetRequestHeader("Content-Type", "text/xml");
		ХМЛХТТП.Send(ТекстЗапроса);
		Ответ = ХМЛХТТП.ResponseText;
		Если СтрЧислоВхождений(Ответ,"<success>true</success>") > 0 Тогда
			//НовыеДанные = Истина;
			//НовыеДанные.Вставить("Контакт",Истина);
			#Если Клиент тогда
			Вопрос("Контакт записан!",РежимДиалогавопрос.ОК);
			#КонецЕсли
			Чтение = Новый ЧтениеXML;
			Чтение.УстановитьСтроку(Ответ);
			Пока(Чтение.Прочитать()) Цикл
				Если Чтение.Имя="Ref" И Чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
					Чтение.Прочитать();
					КонтактИнд=СокрЛП(Чтение.Значение);
				ИначеЕсли Чтение.Имя="Description" И Чтение.ТипУзла=ТипУзлаXML.НачалоЭлемента Тогда
					//ЭлементыФормы.НадписьКонтакт.Заголовок = СокрЛП(Чтение.Значение);
				КонецЕсли;
			КонецЦикла;
			Возврат КонтактИнд;
		Иначе
			СообщитьПользователю(Ответ);
		КонецЕсли;
	КонецЕсли;
КонецФункции

