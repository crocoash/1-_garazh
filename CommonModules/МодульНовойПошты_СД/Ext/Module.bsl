Функция Обработать_getCounterparties(ЭлементДом,Результат, Владелец, Параметры)
	СтруктураПараметров = Новый структура;
	
	ИзменитьНаименование_СД = Истина;
	Пока не ЭлементДом = неопределено цикл
		Если не СтруктураПараметров.Свойство(ЭлементДом.ИмяУзла)  тогда
			СтруктураПараметров.Вставить(Строка(ЭлементДом.ИмяУзла),ЭлементДом.ТекстовоеСодержимое);
		Иначе
			Текст = "Ошибка getCounterparties";
			ВызватьИсключение Текст;
		КонецЕсли;	 
		ЭлементДом = ЭлементДом.СледующийСоседний; 
	КонецЦикла;
	СтруктураПараметров.Вставить("Владелец",Владелец);
	Если Параметры.Тип = "Recipient" Тогда
		//Строка = Этаформа.тзКонтрагентыПолучатели.Добавить();
		НайденСправочник = Справочники.НП_КонтрагентыПолучатели.НайтиПоРеквизиту("Идентификатор",СтруктураПараметров.Ref);
		Если НайденСправочник = Справочники.НП_КонтрагентыПолучатели.ПустаяСсылка() Тогда
			ЕлементСправочника	= Справочники.НП_КонтрагентыПолучатели.СоздатьЭлемент();
			#Если клиент тогда 
				Сообщить("Записан контрагент получатель : " + СтруктураПараметров.Description + "");
			#КонецЕсли 
		Иначе
			ЕлементСправочника	= НайденСправочник.ПолучитьОбъект();
			#Если клиент тогда 
				Сообщить("Обновлен контрагент получатель : " + ЕлементСправочника.Наименование + "");
			#КонецЕсли 
		КонецЕсли;		
	ИначеЕсли Параметры.Тип = "Sender" Тогда
		//Строка = Этаформа.тзКонтрагентыОтправители.Добавить();
		НайденСправочник = Справочники.НП_КонтрагентыОтправители.НайтиПоРеквизиту("Идентификатор",СтруктураПараметров.Ref);
		Если НайденСправочник = Справочники.НП_КонтрагентыОтправители.ПустаяСсылка() Тогда
			ЕлементСправочника	= Справочники.НП_КонтрагентыОтправители.СоздатьЭлемент();
			#Если клиент тогда 
				Сообщить("Записан контрагент отправитель : " + СтруктураПараметров.Description + "");
			#КонецЕсли 
		Иначе
			ЕлементСправочника	= НайденСправочник.ПолучитьОбъект();
			#Если клиент тогда 
				Сообщить("Обновлен контрагент отправитель : " + ЕлементСправочника.Наименование + "");
			#КонецЕсли 
			ИзменитьНаименование_СД = Ложь;
		КонецЕсли;
	ИначеЕсли Параметры.Тип = "ThirdPerson" Тогда
		//Строка = Этаформа.тзКонтрагентыТретьеЛицо.Добавить();
		НайденСправочник = Справочники.НП_КонтрагентыТретьеЛицо.НайтиПоРеквизиту("Идентификатор",СтруктураПараметров.Ref);
		Если НайденСправочник = Справочники.НП_КонтрагентыТретьеЛицо.ПустаяСсылка() Тогда
			ЕлементСправочника	= Справочники.НП_КонтрагентыТретьеЛицо.СоздатьЭлемент();
			#Если клиент тогда 
				Сообщить("Записан контрагент третье лицо : " + СтруктураПараметров.Description + "");
			#КонецЕсли 
		Иначе
			ЕлементСправочника	= НайденСправочник.ПолучитьОбъект();
			#Если клиент тогда 
				Сообщить("Обновлен контрагент  третье лицо : " + ЕлементСправочника.Наименование + "");
			#КонецЕсли 
		КонецЕсли;
	КонецЕсли;
	ЕлементСправочника.Идентификатор = СтруктураПараметров.Ref;
	ЕлементСправочника.Контрагент = СтруктураПараметров.Description;
	ЕлементСправочника.Город = СтруктураПараметров.City;
	ЕлементСправочника.ГородИмя = СтруктураПараметров.CityDescription;
	ЕлементСправочника.Фамилия = СтруктураПараметров.LastName;
	ЕлементСправочника.Имя = СтруктураПараметров.FirstName;
	ЕлементСправочника.Отчество = СтруктураПараметров.MiddleName;
	ЕлементСправочника.ФормаСобственностиRef = СтруктураПараметров.OwnershipFormRef;
	ЕлементСправочника.ФормаСобственности = СтруктураПараметров.OwnershipFormDescription;
	ЕлементСправочника.ЕДРПОУ = СтруктураПараметров.EDRPOU;
	ЕлементСправочника.ТипКонтрагента = СтруктураПараметров.CounterpartyType;
	Если ИзменитьНаименование_СД Тогда
		ЕлементСправочника.Наименование = ЕлементСправочника.Контрагент;
	КонецЕсли;
	Попытка
		ЕлементСправочника.API_ключ = Параметры.КлючAPI;
	Исключение 
		ЕлементСправочника.API_ключ = Параметры.КлючАПИ;
	КонецПопытки;
	ЕлементСправочника.Записать();

КонецФункции

