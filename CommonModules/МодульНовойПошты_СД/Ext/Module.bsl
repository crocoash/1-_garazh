			Сообщить("Записан город : " + СтруктураПараметров.Description + "");
		#КонецЕсли 
	Иначе
		ЕлементСправочника	= НайденСправочник.ПолучитьОбъект();
		#Если клиент тогда 
			Сообщить("Обновлен город : " + ЕлементСправочника.Наименование + "");
		#КонецЕсли 
	КонецЕсли;
	ЕлементСправочника.Наименование = СтруктураПараметров.Description;
	ЕлементСправочника.НаименованиеRU = СтруктураПараметров.DescriptionRu;
	ЕлементСправочника.Идентификатор = СтруктураПараметров.Ref;
	ЕлементСправочника.Регион = СтруктураПараметров.Area;	 	
	ЕлементСправочника.CityID = СтруктураПараметров.CityID;
	ЕлементСправочника.Доставка1 = ?(СтруктураПараметров.Delivery1 = "1",Истина,Ложь);
	ЕлементСправочника.Доставка2 = ?(СтруктураПараметров.Delivery2 = "1",Истина,Ложь);
	ЕлементСправочника.Доставка3 = ?(СтруктураПараметров.Delivery3 = "1",Истина,Ложь);
	ЕлементСправочника.Доставка4 = ?(СтруктураПараметров.Delivery4 = "1",Истина,Ложь);
	ЕлементСправочника.Доставка5 = ?(СтруктураПараметров.Delivery5 = "1",Истина,Ложь);
	ЕлементСправочника.Доставка6 = ?(СтруктураПараметров.Delivery6 = "1",Истина,Ложь);
	ЕлементСправочника.Доставка7 = ?(СтруктураПараметров.Delivery7 = "1",Истина,Ложь);
	ЕлементСправочника.Записать();
	
	
КонецФункции

Функция Обработать_getStreet(ЭлементДом,Результат, Владелец,Параметры)
	СтруктураПараметров = Новый структура;
	
	Пока не ЭлементДом = неопределено цикл
		Если не СтруктураПараметров.Свойство(ЭлементДом.ИмяУзла)  тогда
			СтруктураПараметров.Вставить(Строка(ЭлементДом.ИмяУзла),ЭлементДом.ТекстовоеСодержимое);
		Иначе
			Текст = "Ошибка getStreet";
			ВызватьИсключение Текст;
		КонецЕсли;	 
		ЭлементДом = ЭлементДом.СледующийСоседний; 
	КонецЦикла;
	СтруктураПараметров.Вставить("Владелец",Владелец);
	НайденСправочник = Справочники.НП_Улицы.НайтиПоРеквизиту("Идентификатор",СтруктураПараметров.Ref);
	Если НайденСправочник = Справочники.НП_Улицы.ПустаяСсылка() Тогда
		ЕлементСправочника	= Справочники.НП_Улицы.СоздатьЭлемент();
		#Если клиент тогда 
			Сообщить("Записана улица : " + СтруктураПараметров.Description + "");
		#КонецЕсли 
