Функция API_РазобратьОтвет(ОтветXML) Экспорт
	
	Рез = Новый Структура;
	Рез.Вставить("Успех", Ложь);
	Рез.Вставить("Ошибки", Новый Массив);
	Рез.Вставить("Предупреждения", Новый Массив);
	Рез.Вставить("КодыОшибок", Новый Массив);
	Рез.Вставить("TotalCount", Неопределено);
	
	Если ПустаяСтрока(ОтветXML) Тогда
		Рез.Ошибки.Добавить("Пустой ответ от API");
		Возврат Рез;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ОтветXML);
	
	ТекущийРаздел = ""; // errors / warnings / errorCodes / info ...
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если ЧтениеXML.Имя = "success" Тогда
				ЧтениеXML.Прочитать();
				Рез.Успех = (НРег(СокрЛП(ЧтениеXML.Значение)) = "true");
				
			ИначеЕсли ЧтениеXML.Имя = "errors" Тогда
				ТекущийРаздел = "errors";
				
			ИначеЕсли ЧтениеXML.Имя = "warnings" Тогда
				ТекущийРаздел = "warnings";
				
			ИначеЕсли ЧтениеXML.Имя = "errorCodes" Тогда
				ТекущийРаздел = "errorCodes";
				
			ИначеЕсли ЧтениеXML.Имя = "info" Тогда
				ТекущийРаздел = "info";
				
			ИначеЕсли ЧтениеXML.Имя = "totalCount" Тогда
				ЧтениеXML.Прочитать();
				Попытка
					Рез.TotalCount = Число(ЧтениеXML.Значение);
				Исключение
					// оставим Неопределено
				КонецПопытки;
				
			ИначеЕсли ЧтениеXML.Имя = "item" Тогда
				// item может быть внутри errors/warnings/errorCodes
				ЧтениеXML.Прочитать();
				Текст = СокрЛП(ЧтениеXML.Значение);
				
				Если ТекущийРаздел = "errors" Тогда
					Если НЕ ПустаяСтрока(Текст) Тогда
						Рез.Ошибки.Добавить(Текст);
					КонецЕсли;
				ИначеЕсли ТекущийРаздел = "warnings" Тогда
					Если НЕ ПустаяСтрока(Текст) Тогда
						Рез.Предупреждения.Добавить(Текст);
					КонецЕсли;
				ИначеЕсли ТекущийРаздел = "errorCodes" Тогда
					Если НЕ ПустаяСтрока(Текст) Тогда
						Рез.КодыОшибок.Добавить(Текст);
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			// когда вышли из разделов — сбрасываем
			Если ЧтениеXML.Имя = "errors"
				Или ЧтениеXML.Имя = "warnings"
				Или ЧтениеXML.Имя = "errorCodes"
				Или ЧтениеXML.Имя = "info" Тогда
				ТекущийРаздел = "";
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Рез;
	
КонецФункции

// Показать пользователю ошибки/предупреждения.
// Отдельно обрабатывает "API key expired".
//
// Возврат: Булево (Истина если success=true)
Функция API_ОбработатьОтветИСообщить(ОтветXML) Экспорт
	
	Данные = API_РазобратьОтвет(ОтветXML);
	
	// Предупреждения (не фатальные)
	Для Каждого Предупреждение Из Данные.Предупреждения Цикл
		Если НЕ ПустаяСтрока(Предупреждение) Тогда
			Сообщить("⚠ " + Предупреждение);
		КонецЕсли;
	КонецЦикла;
	
	Если Данные.TotalCount = 0 Тогда
		Сообщить("⚠ TotalCount = 0"); 
		Возврат Ложь;
	КонецЕсли;
	
	Если Данные.Успех Тогда
		Возврат Истина;
	КонецЕсли;
	
	// Ошибки
	Для Каждого Ошибка Из Данные.Ошибки Цикл
		
		Если НРег(СокрЛП(Ошибка)) = "api key expired" Тогда
			СообщитьПользователю("API ключ просрочен. Обновите/сгенерируйте новый ключ в кабинете и замените его в настройках 1С.");
		Иначе
			Сообщить("❌ " + Ошибка);
		КонецЕсли;
		
	КонецЦикла;
	
	// Коды ошибок (если есть)
	Если Данные.КодыОшибок.Количество() > 0 Тогда
		Сообщить("Коды ошибок API: " + СоединитьМассивВСтроку(Данные.КодыОшибок, ", "));
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции  

// Соединить элементы массива в строку через разделитель
Функция СоединитьМассивВСтроку(МассивЗначений, Разделитель) Экспорт
	
	Результат = "";
	
	Для Каждого Значение Из МассивЗначений Цикл
		Если ПустаяСтрока(Результат) Тогда
			Результат = Строка(Значение);
		Иначе
			Результат = Результат + Разделитель + Строка(Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


Функция XML_ВыгрузитьItemsВСписокЗначений(ОтветXML) Экспорт
	
	Список = Новый СписокЗначений;
	
	Если ПустаяСтрока(ОтветXML) Тогда
		Возврат Список;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ОтветXML);
	
	ТекущийТекст = "";
	ВнутриItem = Ложь;
	Индекс = 0;
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если ЧтениеXML.Имя = "item" Тогда
				ВнутриItem = Истина;
				ТекущийТекст = "";
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			
			Если ВнутриItem Тогда
				ТекущийТекст = ТекущийТекст + " | " + ЧтениеXML.Значение;
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			Если ЧтениеXML.Имя = "item" Тогда
				
				Текст = ТекущийТекст;
				Если НЕ ПустаяСтрока(Текст) Тогда
					Список.Добавить(Индекс, Текст);
					Индекс = Индекс + 1;
				КонецЕсли;
				
				ВнутриItem = Ложь;
				ТекущийТекст = "";
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Список;
	
КонецФункции

Функция XML_ВыгрузитьItemsВТаблицуЗначений(ОтветXML) Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	
	Если ПустаяСтрока(ОтветXML) Тогда
		Возврат Таблица;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ОтветXML);
	
	ВнутриItem = Ложь;
	СтрокаТаблицы = Неопределено;
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если ЧтениеXML.Имя = "item" Тогда
				ВнутриItem = Истина;
				СтрокаТаблицы = Таблица.Добавить();
				Продолжить;
			КонецЕсли;
			
			Если ВнутриItem Тогда
				
				ИмяПоля = ЧтениеXML.Имя;
				
				// читаем элемент в структуру (текст + подэлементы)
				Рез = XML_ПрочитатьЭлементВСтруктуру(ЧтениеXML);
				
				Если Рез.Свойство("Дети") И Рез.Дети.Количество() > 0 Тогда
					// Вложенный объект -> разнесем в колонки
					Для каждого КлючЗначение Из Рез.Дети Цикл
						ИмяКолонки = КлючЗначение.Ключ;
						Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
							Таблица.Колонки.Добавить(ИмяКолонки);
						КонецЕсли;
						
						СтрокаТаблицы[ИмяКолонки] = Рез.Дети[КлючЗначение.Ключ];
					КонецЦикла;
				Иначе
					// Обычное значение
					Если Таблица.Колонки.Найти(ИмяПоля) = Неопределено Тогда
						Таблица.Колонки.Добавить(ИмяПоля);
					КонецЕсли;
					СтрокаТаблицы[ИмяПоля] = Рез.Текст;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			Если ЧтениеXML.Имя = "item" Тогда
				ВнутриItem = Ложь;
				СтрокаТаблицы = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции


// Мы стоим на "НачалоЭлемента". Возвращает:
// Структура("Имя, Текст, Дети")
// Дети = Структура ключ=значение (для вложенных тегов 1 уровня)
Функция XML_ПрочитатьЭлементВСтруктуру(ЧтениеXML) Экспорт
	
	ИмяТега = ЧтениеXML.Имя;
	Текст = "";
	Дети = Новый Структура;
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			Текст = Текст + ЧтениеXML.Значение;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ИмяДоч = ЧтениеXML.Имя;
			ЗначДоч = XML_ПрочитатьЗначениеЭлемента(ЧтениеXML); // рекурсивно как текст/влож.
			
			// если одинаковые имена повторяются — можно склеить через ";"
			Если Дети.Свойство(ИмяДоч) Тогда
				Дети.Вставить(ИмяДоч, Дети[ИмяДоч] + "; " + ЗначДоч);
			Иначе
				Дети.Вставить(ИмяДоч, ЗначДоч);
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если ЧтениеXML.Имя = ИмяТега Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("Имя,Текст,Дети", ИмяТега, СокрЛП(Текст), Дети);
	
КонецФункции


// Возвращает строковое значение текущего элемента (может быть и с вложенностью)
// После выхода ЧтениеXML стоит на КонецЭлемента этого тега
Функция XML_ПрочитатьЗначениеЭлемента(ЧтениеXML) Экспорт
	
	ИмяТега = ЧтениеXML.Имя;
	Текст = "";
	Пары = Новый Массив;
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			Текст = Текст + ЧтениеXML.Значение;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ИмяВлож = ЧтениеXML.Имя;
			ЗначВлож = XML_ПрочитатьЗначениеЭлемента(ЧтениеXML);
			Пары.Добавить(ИмяВлож + "=" + ЗначВлож);
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если ЧтениеXML.Имя = ИмяТега Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Текст = СокрЛП(Текст);
	Если Пары.Количество() > 0 Тогда
		Возврат СоединитьМассивВСтроку(Пары, "; ");
	Иначе
		Возврат Текст;
	КонецЕсли;
	
КонецФункции



//Сохранение истории ттн
////////////////////////////////////////////////////////////////////////////////
// ОСНОВНОЙ МЕТОД
////////////////////////////////////////////////////////////////////////////////

Процедура НП_СкачатьPDFТТНЗаПериод(ДатаНач, ДатаКон, ТекущийКлюч, БазовыйКаталог = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ТекущийКлюч) Тогда
		Сообщить("Не указан API ключ Новой Почты");
		Возврат;
	КонецЕсли;
	
	Если ДатаНач > ДатаКон Тогда
		Сообщить("Дата начала периода больше даты конца");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(БазовыйКаталог) Тогда
		БазовыйКаталог = КаталогВременныхФайлов();
	КонецЕсли;
	
	Если Прав(БазовыйКаталог, 1) <> "\" Тогда
		БазовыйКаталог = БазовыйКаталог + "\";
	КонецЕсли;
	
	ИмяПапкиПериода = Формат(ДатаНач, "ДФ=yyyy-MM-dd") + "_" + Формат(ДатаКон, "ДФ=yyyy-MM-dd");
	КаталогПериода = БазовыйКаталог + ИмяПапкиПериода;
	
	ФайлКаталога = Новый Файл(КаталогПериода);
	Если Не ФайлКаталога.Существует() Тогда
		СоздатьКаталог(КаталогПериода);
	КонецЕсли;
	
	Сообщить("Получаем список ТТН за период: " 
		+ Формат(ДатаНач, "ДФ=dd.MM.yyyy") + " - " 
		+ Формат(ДатаКон, "ДФ=dd.MM.yyyy"));
	
	ТаблицаТТН = НП_ПолучитьСписокТТНЗаПериод(ДатаНач, ДатаКон, ТекущийКлюч);
	
	Если ТаблицаТТН = Неопределено Тогда
		Сообщить("Не удалось получить список ТТН");
		Возврат;
	КонецЕсли;
	
	Если ТаблицаТТН.Количество() = 0 Тогда
		Сообщить("За период ТТН не найдены");
		Возврат;
	КонецЕсли;
	
	Сообщить("Найдено ТТН: " + Строка(ТаблицаТТН.Количество()));
	
	Для Каждого СтрокаТТН Из ТаблицаТТН Цикл
		
		НомерТТН = "";
		Если ЗначениеЗаполнено(СтрокаТТН.IntDocNumber) Тогда
			НомерТТН = СокрЛП(СтрокаТТН.IntDocNumber);
		КонецЕсли;
		
		Если НомерТТН = "" Тогда
			Продолжить;
		КонецЕсли;
		
		ТелефонПолучателя = ПолучитьТелефонПолучателя(НомерТТН);
		ТелефонПолучателя = НП_НормализоватьТелефон(ТелефонПолучателя);
		
		КлиентБаркод = "";
		
		Если ЗначениеЗаполнено(ТелефонПолучателя) Тогда
			КлиентБаркод = НП_ПолучитьClientBarcodeПоТТН(НомерТТН, ТелефонПолучателя, ТекущийКлюч);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КлиентБаркод) Тогда
			ИмяФайла = НП_ПодготовитьИмяФайла(КлиентБаркод) + "_" + НП_ПодготовитьИмяФайла(НомерТТН) +".pdf";
		Иначе
			ИмяФайла = НП_ПодготовитьИмяФайла(НомерТТН) + ".pdf";
		КонецЕсли;
		
		Попытка
			НП_СохранитьPDFПоТТН(НомерТТН, ТекущийКлюч, КаталогПериода, ИмяФайла);
			Сообщить("Сохранен файл: " + ИмяФайла);
		Исключение
			Сообщить("Ошибка сохранения PDF по ТТН " + НомерТТН + ": " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	Сообщить("Готово. Каталог: " + КаталогПериода);
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПОЛУЧЕНИЕ СПИСКА ТТН ЗА ПЕРИОД
////////////////////////////////////////////////////////////////////////////////

Функция НП_ПолучитьСписокТТНЗаПериод(ДатаНач, ДатаКон, ТекущийКлюч) Экспорт
	
	ТекстЗапроса = ""
	+ "<?xml version=""1.0"" encoding=""UTF-8""?>"
	+ "<file>"
	+ "<apiKey>" + ТекущийКлюч + "</apiKey>"
	+ "<modelName>InternetDocumentGeneral</modelName>"
	+ "<calledMethod>getDocumentList</calledMethod>"
	+ "<methodProperties>"
	+ "<DateTimeFrom>" + Формат(ДатаНач, "ДФ=dd.MM.yyyy") + "</DateTimeFrom>"
	+ "<DateTimeTo>" + Формат(ДатаКон, "ДФ=dd.MM.yyyy") + "</DateTimeTo>"
	+ "<Page>1</Page>"
	+ "<GetFullList>1</GetFullList>"
	+ "</methodProperties>"
	+ "</file>";
	
	ОтветXML = НП_ВыполнитьXMLЗапрос(ТекстЗапроса);
	
	Если Не ЗначениеЗаполнено(ОтветXML) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НП_XMLСодержитУспехЛожь(ОтветXML) Тогда
		Сообщить("НП вернула ошибку при получении списка ТТН");
		Сообщить(ОтветXML);
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат НП_РазобратьСписокТТНИзXML(ОтветXML);
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// РАЗБОР СПИСКА ТТН ИЗ XML
////////////////////////////////////////////////////////////////////////////////

Функция НП_РазобратьСписокТТНИзXML(ТекстXML) Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Ref");
	Таблица.Колонки.Добавить("DateTime");
	Таблица.Колонки.Добавить("PreferredDeliveryDate");
	Таблица.Колонки.Добавить("RecipientDateTime");
	Таблица.Колонки.Добавить("EWDateCreated");
	Таблица.Колонки.Добавить("IntDocNumber");
	Таблица.Колонки.Добавить("StateId");
	Таблица.Колонки.Добавить("StateName");
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	
	// Буфер значений
	Буфер = Новый Структура;
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если Чтение.Имя = "data" Тогда
				Буфер = Новый Структура;
				Продолжить;
			КонецЕсли;
			
			Если Чтение.Имя = "Ref" Тогда
				Буфер.Вставить("Ref", НП_ПрочитатьТекстТекущегоЭлементаXML(Чтение));
			ИначеЕсли Чтение.Имя = "DateTime" Тогда
				Буфер.Вставить("DateTime", НП_ПрочитатьТекстТекущегоЭлементаXML(Чтение));
			ИначеЕсли Чтение.Имя = "PreferredDeliveryDate" Тогда
				Буфер.Вставить("PreferredDeliveryDate", НП_ПрочитатьТекстТекущегоЭлементаXML(Чтение));
			ИначеЕсли Чтение.Имя = "RecipientDateTime" Тогда
				Буфер.Вставить("RecipientDateTime", НП_ПрочитатьТекстТекущегоЭлементаXML(Чтение));
			ИначеЕсли Чтение.Имя = "EWDateCreated" Тогда
				Буфер.Вставить("EWDateCreated", НП_ПрочитатьТекстТекущегоЭлементаXML(Чтение));
			ИначеЕсли Чтение.Имя = "IntDocNumber" Тогда
				Буфер.Вставить("IntDocNumber", НП_ПрочитатьТекстТекущегоЭлементаXML(Чтение));
			ИначеЕсли Чтение.Имя = "StateId" Тогда
				Буфер.Вставить("StateId", НП_ПрочитатьТекстТекущегоЭлементаXML(Чтение));
			ИначеЕсли Чтение.Имя = "StateName" Тогда
				Буфер.Вставить("StateName", НП_ПрочитатьТекстТекущегоЭлементаXML(Чтение));
			КонецЕсли;
			
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			Если Чтение.Имя = "data" Тогда
				
				Если Буфер.Свойство("IntDocNumber") 
					И ЗначениеЗаполнено(Буфер.IntDocNumber) Тогда
					
					Строка = Таблица.Добавить();
					
					Если Буфер.Свойство("Ref") Тогда
						Строка.Ref = Буфер.Ref;
					КонецЕсли;
					
					Если Буфер.Свойство("DateTime") Тогда
						Строка.DateTime = Буфер.DateTime;
					КонецЕсли;
					
					Если Буфер.Свойство("PreferredDeliveryDate") Тогда
						Строка.PreferredDeliveryDate = Буфер.PreferredDeliveryDate;
					КонецЕсли;
					
					Если Буфер.Свойство("RecipientDateTime") Тогда
						Строка.RecipientDateTime = Буфер.RecipientDateTime;
					КонецЕсли;
					
					Если Буфер.Свойство("EWDateCreated") Тогда
						Строка.EWDateCreated = Буфер.EWDateCreated;
					КонецЕсли;
					
					Строка.IntDocNumber = Буфер.IntDocNumber;
					
					Если Буфер.Свойство("StateId") Тогда
						Строка.StateId = Буфер.StateId;
					КонецЕсли;
					
					Если Буфер.Свойство("StateName") Тогда
						Строка.StateName = Буфер.StateName;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ПОЛУЧЕНИЕ ТЕЛЕФОНА ПОЛУЧАТЕЛЯ ИЗ БАЗЫ
////////////////////////////////////////////////////////////////////////////////

Функция ПолучитьТелефонПолучателя(ТТН) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НП_ТТН", ТТН);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказПокупателя.НП_ТелефонПолучателя КАК ТелефонПолучателя
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.НП_ТТН = &НП_ТТН
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.ТелефонПолучателя) Тогда
			Возврат СокрЛП(Выборка.ТелефонПолучателя);
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ПОЛУЧЕНИЕ ClientBarcode ПО ТТН
////////////////////////////////////////////////////////////////////////////////

Функция НП_ПолучитьClientBarcodeПоТТН(НомерТТН, Телефон, ТекущийКлюч) Экспорт
	
	Если Не ЗначениеЗаполнено(НомерТТН) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Телефон) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстЗапроса = ""
	+ "<?xml version=""1.0"" encoding=""UTF-8""?>"
	+ "<file>"
	+ "<apiKey>" + ТекущийКлюч + "</apiKey>"
	+ "<modelName>TrackingDocumentGeneral</modelName>"
	+ "<calledMethod>getStatusDocuments</calledMethod>"
	+ "<methodProperties>"
	+ "<Documents>"
	+ "<item>"
	+ "<DocumentNumber>" + НомерТТН + "</DocumentNumber>"
	+ "<Phone>" + Телефон + "</Phone>"
	+ "</item>"
	+ "</Documents>"
	+ "</methodProperties>"
	+ "</file>";
	
	Ответ = НП_ВыполнитьXMLЗапрос(ТекстЗапроса);
	
	Если Не ЗначениеЗаполнено(Ответ) Тогда
		Возврат "";
	КонецЕсли;
	
	// Сначала пытаемся вытащить как XML
	КлиентБаркод = НП_ПолучитьЗначениеТегаИзXML(Ответ, "ClientBarcode");
	Если ЗначениеЗаполнено(КлиентБаркод) Тогда
		Возврат КлиентБаркод;
	КонецЕсли;
	
	// Если пришел JSON - вытаскиваем строкой
	КлиентБаркод = НП_ПолучитьЗначениеИзJSONСтрокой(Ответ, "ClientBarcode");
	
	Возврат КлиентБаркод;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// СОХРАНЕНИЕ PDF ПО ТТН
////////////////////////////////////////////////////////////////////////////////

Процедура НП_СохранитьPDFПоТТН(ТТН, ТекущийКлюч, КаталогСохранения, ИмяФайла = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ТекущийКлюч) Тогда
		ВызватьИсключение "Не указан API ключ";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТТН) Тогда
		ВызватьИсключение "Не указан номер ТТН";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КаталогСохранения) Тогда
		КаталогСохранения = КаталогВременныхФайлов();
	КонецЕсли;
	
	Если Прав(КаталогСохранения, 1) <> "\" Тогда
		КаталогСохранения = КаталогСохранения + "\";
	КонецЕсли;
	
	ФайлКаталога = Новый Файл(КаталогСохранения);
		Если Не ФайлКаталога.Существует() Тогда

		СоздатьКаталог(КаталогСохранения);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		ИмяФайла = "Doc_" + СокрЛП(ТТН) + ".pdf";
	КонецЕсли;
	
	ТекстЗапроса = "<?xml version=""1.0"" encoding=""UTF-8"" ?>"
	+ "<root>"
	+ "<apiKey>" + ТекущийКлюч + "</apiKey>"
	+ "<modelName>InternetDocument</modelName>"
	+ "<calledMethod>printDocument</calledMethod>"
	+ "<methodProperties>"
	+ "<DocumentRefs>"
	+ "<item>" + СокрЛП(ТТН) + "</item>"
	+ "</DocumentRefs>"
	+ "<Type>pdf</Type>"
	+ "</methodProperties>"
	+ "</root>";
	
	Попытка
		
		Попытка
			ХМЛХТТП = ПолучитьCOMОбъект("", "MSXML2.ServerXMLHTTP.6.0");
		Исключение
			ХМЛХТТП = ПолучитьCOMОбъект("", "Microsoft.XMLHTTP");
		КонецПопытки;
		
		ХМЛХТТП.Open("POST", ПолучитьТочкуВхода(), Ложь);
		ХМЛХТТП.SetRequestHeader("Content-Type", "text/xml; charset=UTF-8");
		ХМЛХТТП.Send(ТекстЗапроса);
		
		Буфер = ХМЛХТТП.ResponseBody();
		
		Поток = Новый COMОбъект("ADODB.Stream");
		Поток.Type = 1;
		Поток.Mode = 3;
		Поток.Open();
		Поток.Write(Буфер);
		
		ПолноеИмяФайла = КаталогСохранения + ИмяФайла;
		
		ФайлКаталога = Новый Файл(КаталогСохранения);
		Если ФайлКаталога.Существует() Тогда
			УдалитьФайлы(ПолноеИмяФайла);
		КонецЕсли;
		
		Поток.SaveToFile(ПолноеИмяФайла);
		Поток.Close();
		
	Исключение
		ВызватьИсключение "Ошибка сохранения PDF по ТТН " + ТТН + ": " + ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБЩИЙ XML ЗАПРОС К НП
////////////////////////////////////////////////////////////////////////////////

Функция НП_ВыполнитьXMLЗапрос(ТекстЗапроса) Экспорт
	
	Попытка
		
		Попытка
			ХМЛХТТП = ПолучитьCOMОбъект("", "MSXML2.ServerXMLHTTP.6.0");
		Исключение
			ХМЛХТТП = ПолучитьCOMОбъект("", "Microsoft.XMLHTTP");
		КонецПопытки;
		
		ХМЛХТТП.Open("POST", ПолучитьТочкуВхода(), Ложь);
		ХМЛХТТП.SetRequestHeader("Content-Type", "text/xml; charset=UTF-8");
		ХМЛХТТП.Send(ТекстЗапроса);
		
		Возврат ХМЛХТТП.ResponseText;
		
	Исключение
		Сообщить("Ошибка HTTP запроса НП: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ЧТЕНИЕ ТЕКСТА ТЕКУЩЕГО XML ЭЛЕМЕНТА
////////////////////////////////////////////////////////////////////////////////

Функция НП_ПрочитатьТекстТекущегоЭлементаXML(Чтение) Экспорт
	
	Результат = "";
	
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			Результат = Чтение.Значение;
			Возврат Результат;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ПОЛУЧИТЬ ЗНАЧЕНИЕ ПЕРВОГО ТЕГА ИЗ XML
////////////////////////////////////////////////////////////////////////////////

Функция НП_ПолучитьЗначениеТегаИзXML(ТекстXML, ИмяТега) Экспорт
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстXML);
	
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.Имя = ИмяТега Тогда
				Возврат НП_ПрочитатьТекстТекущегоЭлементаXML(Чтение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ВЫТАЩИТЬ ЗНАЧЕНИЕ ИЗ JSON СТРОКОЙ
////////////////////////////////////////////////////////////////////////////////

Функция НП_ПолучитьЗначениеИзJSONСтрокой(ТекстJSON, ИмяПоля) Экспорт
	
	Если Не ЗначениеЗаполнено(ТекстJSON) Тогда
		Возврат "";
	КонецЕсли;
	
	Шаблон = """" + ИмяПоля + """";
	ПозицияПоля = Найти(ТекстJSON, Шаблон);
	
	Если ПозицияПоля = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Остаток = Сред(ТекстJSON, ПозицияПоля + СтрДлина(Шаблон));
	ПозицияДвоеточия = Найти(Остаток, ":");
	
	Если ПозицияДвоеточия = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Остаток = СокрЛП(Сред(Остаток, ПозицияДвоеточия + 1));
	
	Если Лев(Остаток, 1) = """" Тогда
		Остаток = Сред(Остаток, 2);
		ПозицияЗакрКавычки = Найти(Остаток, """");
		Если ПозицияЗакрКавычки > 0 Тогда
			Возврат Лев(Остаток, ПозицияЗакрКавычки - 1);
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ПРОВЕРКА success = false В XML
////////////////////////////////////////////////////////////////////////////////

Функция НП_XMLСодержитУспехЛожь(ТекстXML) Экспорт
	
	Успех = НП_ПолучитьЗначениеТегаИзXML(ТекстXML, "success");
	
	Если НРег(СокрЛП(Успех)) = "false" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// НОРМАЛИЗАЦИЯ ТЕЛЕФОНА
////////////////////////////////////////////////////////////////////////////////

Функция НП_НормализоватьТелефон(Телефон) Экспорт
	
	Результат = СокрЛП(Телефон);
	
	Результат = СтрЗаменить(Результат, "+", "");
	Результат = СтрЗаменить(Результат, "(", "");
	Результат = СтрЗаменить(Результат, ")", "");
	Результат = СтрЗаменить(Результат, "-", "");
	Результат = СтрЗаменить(Результат, " ", "");
	
	Если Лев(Результат, 1) = "0" Тогда
		Результат = "38" + Результат;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


