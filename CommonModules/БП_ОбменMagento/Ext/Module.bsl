КонецФункции 

Процедура AsyncAnswerОбработка(СтрокаJSON, Ответ, request_id, ЭтоГараж = Ложь) Экспорт
	
    Результат = Новый ЧтениеJSON;
    Результат.УстановитьСтроку(СтрокаJSON);
    Данные = ПрочитатьJSON(Результат); 
	
	Если ЭтоГараж тогда
		НаборЗаписей = РегистрыСведений.БП_АсинхроннаяПакетнаяВыгрузкаGarazh.СоздатьНаборЗаписей(); 	
	Иначе
		НаборЗаписей = РегистрыСведений.БП_АсинхроннаяПакетнаяВыгрузка.СоздатьНаборЗаписей(); 
	КонецЕсли;
	//НаборЗаписей = РегистрыСведений.БП_АсинхроннаяПакетнаяВыгрузка.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КодПакету.Установить(request_id); 
	НаборЗаписей.Прочитать();
	Для Каждого СтрокаТаблицы Из НаборЗаписей Цикл 
		СтрокаТаблицы.Получен = Истина; 
		СтрокаТаблицы.ДатаПолученияОтвета = ТекущаяДата(); 
	КонецЦикла; 
