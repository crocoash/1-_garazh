	КонецЦикла; 
	
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("magento_id", );
	СтруктураОтвета.Вставить("erp_id", request_id);
	
	ОтветCustomerУспех(Ответ, СтруктураОтвета);     
	
	Если КоличествоНеуспешних > 0 тогда  
