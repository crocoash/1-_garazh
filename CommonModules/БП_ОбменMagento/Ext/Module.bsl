Функция MagentoМасоваяВыгрузкаНоменклатуры(Источник, Отказ, MagentoID = "MagentoID") Экспорт
	
	
	Если MagentoID = "MagentoGarazhID" тогда
		ТипЦенДляСайта = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("GarazhUA",,,); 
	Иначе
		ТипЦенДляСайта = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("ionity.tires",,,); 
	КонецЕсли;
	
	АдресМетода = "/erp/products/safe-update-multiple/";
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	БП_БейджикиНоменклатурыСрезПоследних.Номенклатура,
	|	БП_БейджикиНоменклатурыСрезПоследних.БейджикиТекст,
	|	БП_БейджикиНоменклатурыСрезПоследних.БейджикиJSON
	|ИЗ
	|	РегистрСведений.БП_БейджикиНоменклатуры.СрезПоследних(
	|			&Дата,
	|			ТипЦеныРасчета = &ТипЦеныРасчета
	|				И Номенклатура В (&МассивНоменклатури)) КАК БП_БейджикиНоменклатурыСрезПоследних");
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("ТипЦеныРасчета", ТипЦенДляСайта);
	Запрос.УстановитьПараметр("МассивНоменклатури", Источник.Ссылка);   
	
	ТЗБейджики = Запрос.Выполнить().Выгрузить();  
	
	Запрос = Новый Запрос("ВЫБРАТЬ 
	|	БП_РейтингНоменклатуры.Номенклатура,
	|	БП_РейтингНоменклатуры.Рейтинг
	|ИЗ
	|	РегистрСведений.БП_РейтингНоменклатуры.СрезПоследних(&Дата, ТипЦеныРасчета = &ТипЦеныРасчета И Номенклатура В (&МассивНоменклатури)) КАК БП_РейтингНоменклатуры");
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("ТипЦеныРасчета", ТипЦенДляСайта);
	Запрос.УстановитьПараметр("МассивНоменклатури", Источник.Ссылка);
	
	ТЗРейтинг = Запрос.Выполнить().Выгрузить();  
	
	СтараяЦена = ТипЦенДляСайта.ТипСтаройЦены;      
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Дата,
	|			Номенклатура В (&МассивНоменклатури)
	|				И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних"); 
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("МассивНоменклатури", Источник.Ссылка);
	Запрос.УстановитьПараметр("ТипЦен", СтараяЦена);
	
	ТЗСтараяЦена = Запрос.Выполнить().Выгрузить(); 
	

	
	ДатаПроизводства = ""; 
	Страна = "";
	price = 0;  
	qty = 0;  
	
	ТЗИнфо = ПоказатьЦеныПоставщика(Источник.Ссылка, ТипЦенДляСайта);
	Если ТЗИнфо.Количество() > 0 Тогда
		ДатаПроизводства = ТЗИнфо[0].ДатаПроизводства; 
		Страна = ТЗИнфо[0].Страна;   
		price = ТЗИнфо[0].ЦенаПродажи;
		qty = ТЗИнфо.Итог("Количество");
	КонецЕсли;
	

	
	Если qty = Неопределено тогда 
		qty = 0;
	КонецЕсли;  
	
	НайденнаяСтрока = ТЗРейтинг.Найти(Источник.Ссылка, "Номенклатура");
	Если НайденнаяСтрока = Неопределено Тогда
		raiting = 0;
	Иначе
		raiting = НайденнаяСтрока.Рейтинг;
	КонецЕсли;  
	
	НайденнаяСтрока = ТЗСтараяЦена.Найти(Источник.Ссылка, "Номенклатура");
	Если НайденнаяСтрока = Неопределено Тогда
		price_old = 0;
	Иначе
		price_old = НайденнаяСтрока.Цена;
	КонецЕсли;
	
	Если price = 0 тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
		|	ЦеныНоменклатурыСрезПоследних.Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			,
		|			Номенклатура В (&МассивНоменклатури)
		|				И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних"); 
		
		//Запрос.УстановитьПараметр("Дата", ТекущаяДата());
		Запрос.УстановитьПараметр("МассивНоменклатури", Источник.Ссылка);
		Запрос.УстановитьПараметр("ТипЦен", ТипЦенДляСайта);
		
		ТЗЗапаснаяЦена = Запрос.Выполнить().Выгрузить();
		
		Если ТЗЗапаснаяЦена.Количество() тогда
			price = ТЗЗапаснаяЦена[0].Цена;	
		КонецЕсли;	
	КонецЕсли;
	
	
	НайденнаяСтрока = ТЗБейджики.Найти(Источник.Ссылка, "Номенклатура");
	Если НайденнаяСтрока = Неопределено Тогда
		МассивБейджиковНаименования = Новый Массив;
	Иначе
		БейджикиJSON = НайденнаяСтрока.БейджикиJSON;
		Результат = Новый ЧтениеJSON;
		Результат.УстановитьСтроку(БейджикиJSON);
		Данные = ПрочитатьJSON(Результат);
		МассивБейджиковНаименования = Новый Массив;
		Для каждого Стр из Данные цикл
			МассивБейджиковНаименования.Добавить(Стр.Наименование);	
		КонецЦикла;
	КонецЕсли;		
	
	МассивРеквизитовКОтправке = Новый Массив; 
	МассивКатегорий = Новый Массив;
	СтруктураОтправки_category = Новый Структура; 
	
	МассивРеквизитовКОтправке = ПолучитьЗначенияРевизитовПоВидуНоменклутри(Источник, Источник.ВидНоменклатуры); 
	МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","producer_country",Страна));
	МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","manufacturer_year",ДатаПроизводства));
	МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value", "labels", МассивБейджиковНаименования));
	
	МассивСортировок = Новый Массив;
	МассивСортировок.Добавить(Новый Структура("code, rating", "Popular", raiting));
	
	СтруктураОтправки_category.Вставить("sku", Источник.Код);
	СтруктураОтправки_category.Вставить("erp_id", Источник.Код);	
	СтруктураОтправки_category.Вставить("name", Источник.Наименование);	
	СтруктураОтправки_category.Вставить("price", price);  
	СтруктураОтправки_category.Вставить("price_old", price_old); 
	СтруктураОтправки_category.Вставить("attribute_set_erp_id", Источник.ВидНоменклатуры.Код);
	СтруктураОтправки_category.Вставить("stock_item",Новый Структура("qty, is_in_stock",qty,true));     
	
	СтруктураОтправки_category.Вставить("attributes_values", МассивРеквизитовКОтправке); 
	СтруктураОтправки_category.Вставить("categories_erp_ids", МассивКатегорий);
	СтруктураОтправки_category.Вставить("sort_options", МассивСортировок);   
	
		ПустойМассив = Новый Массив;
		МассивЛокализации = Новый Массив;
		СтруктураОтправки_i18n = Новый Структура("locale, name, attributes_values", "ua", Источник.Наименование, ПустойМассив);
        МассивЛокализации.Добавить(СтруктураОтправки_i18n);
		СтруктураОтправки_i18n = Новый Структура("locale, name, attributes_values", "ru", Источник.БП_НаименованиеРу, ПустойМассив);
        МассивЛокализации.Добавить(СтруктураОтправки_i18n);		
		СтруктураОтправки_category.Вставить("i18n", МассивЛокализации);
	
	Возврат СтруктураОтправки_category;			
	
КонецФункции     

Функция MagentoМасоваяВыгрузкаНоменклатурыДляАсинхронойОтправки(Источник, Отказ, MagentoID = "MagentoID", СкладськийПошук = Ложь) Экспорт
	
	
	Если MagentoID = "MagentoGarazhID" тогда
		ТипЦенДляСайта = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("GarazhUA",,,); 
	Иначе
		ТипЦенДляСайта = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("ionity.tires",,,); 
	КонецЕсли;
		
	Запрос = Новый Запрос("ВЫБРАТЬ
