		МассивПараметров.Добавить(Источник.Метаданные().Иерархический);
		МассивПараметров.Добавить(Отказ);
        МассивПараметров.Добавить("Garazh");
	   
		ФоновыеЗадания.Выполнить("БП_ОбменMagentoВФоне.БП_ВыполнитьОтправкуНаСайтАтрибутов", МассивПараметров,,"ОтправкаАтрибутовНаСайтGarazh");
