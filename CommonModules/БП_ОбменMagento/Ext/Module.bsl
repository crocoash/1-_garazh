//+БП: claude (27.08.2026) <>
// Телефон с сайта приходит в международном виде "+380671234567", а в ПредЗаказе
// поле "Телефон мобильный" ведут без кода страны - "0671234567". Дальше по цепочке
// этот формат и ожидается: форма ПредЗаказа при создании ЗаказаПокупателя сама
// достраивает "38" для номера длиной 10 символов.
//
// Параметры:
//  Телефон - Строка - номер, как пришёл с сайта
//
// Возвращаемое значение:
//  Строка - только цифры, без "+38"; если номер на украинский не похож,
//           возвращается исходное значение: лучше так, чем потерять номер.
//
Функция ТелефонБезКодаСтраны(Знач Телефон) Экспорт
	
	Телефон = СокрЛП(Строка(Телефон));
	Если ПустаяСтрока(Телефон) Тогда
		Возврат "";
	КонецЕсли;
	
	// Разделители бывают любые: "+38 (067) 123-45-67".
	Цифры = "";
	Для Поз = 1 По СтрДлина(Телефон) Цикл
		Символ = Сред(Телефон, Поз, 1);
		Если Найти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;
	КонецЦикла;
	
	// 380671234567 -> 0671234567
	Если СтрДлина(Цифры) = 12 И Лев(Цифры, 2) = "38" Тогда
		Возврат Сред(Цифры, 3);
	КонецЕсли;
	
	// 671234567 -> 0671234567
	Если СтрДлина(Цифры) = 9 И Лев(Цифры, 1) <> "0" Тогда
		Возврат "0" + Цифры;
	КонецЕсли;
	
	Если СтрДлина(Цифры) = 10 Тогда
		Возврат Цифры;
	КонецЕсли;
	
	Возврат Телефон;
	
КонецФункции
