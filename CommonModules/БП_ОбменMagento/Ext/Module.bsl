		ТЗЗапаснаяЦена = Запрос.Выполнить().Выгрузить();
		
		Если ТЗЗапаснаяЦена.Количество() тогда
			price = ТЗЗапаснаяЦена[0].Цена;	
		КонецЕсли;	
	КонецЕсли;
	
	
	НайденнаяСтрока = ТЗБейджики.Найти(Источник.Ссылка, "Номенклатура");
	Если НайденнаяСтрока = Неопределено Тогда
		МассивБейджиковНаименования = Новый Массив;
	Иначе
