Функция ВыполнитьОтправкуНаСайт(АдресМетода = "", Заголовки = Неопределено, СтруктураОтправкиJSON = "", Метод = "", ЭтоGarazh = Ложь) Экспорт
	
	Если Заголовки = Неопределено тогда
		Заголовки = Новый Соответствие;
	КонецЕсли;
			
	Попытка
		//HTTPСоединение = Новый HTTPСоединение(Константы.MagentoАдрес.Получить(),,,,,,Новый ЗащищенноеСоединениеOpenSSL(),); 
		Если ЭтоGarazh тогда
			HTTPСоединение = Новый HTTPСоединение("api.garazh.ua",,,,,,Новый ЗащищенноеСоединениеOpenSSL(),);	
		Иначе	
			HTTPСоединение = Новый HTTPСоединение("api.ionity.tires",,,,,,Новый ЗащищенноеСоединениеOpenSSL(),);
		КонецЕсли;                                  
	Исключение
		Сообщить("Не вдалося виконати з'єднання з сервером Magento:" 
		+ Символы.ПС + ИнформацияОбОшибке().Описание, СтатусСообщения.Важное);
		Возврат Неопределено;
	КонецПопытки;
	
	//создаем запрос данных методом POST
	ЗапросPOST = Новый HTTPЗапрос("/rest/default/V1" + АдресМетода, Заголовки);
	
	ЗапросPOST.Заголовки.Вставить("Content-type", "application/json"); 
	Если ЭтоGarazh тогда
		ЗапросPOST.Заголовки.Вставить("Authorization", "Bearer " + СтрЗаменить(Константы.MagentoGarazhТокен.Получить(),"""",""));
	Иначе
	 	ЗапросPOST.Заголовки.Вставить("Authorization", "Bearer " + СтрЗаменить(Константы.MagentoТокен.Получить(),"""",""));
	КонецЕсли;
	ЗапросPOST.УстановитьТелоИзСтроки(СтруктураОтправкиJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		
	//Отправка на сайт
	Попытка
		Если Метод = "PUT" тогда
			Результат = HTTPСоединение.ВызватьHTTPМетод("PUT", ЗапросPOST);
		Иначе
			Результат = HTTPСоединение.ОтправитьДляОбработки(ЗапросPOST); 
		КонецЕсли;
	Исключение
		Сообщить("Не вдалося опрацювати метод Magento: " + АдресМетода   
		+ Символы.ПС + ИнформацияОбОшибке().Описание, СтатусСообщения.Важное);
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Результат;	
	
КонецФункции

Процедура СоздатьCustomerMagento(СтрокаJSON, Ответ) Экспорт
	
    Результат = Новый ЧтениеJSON;
    Результат.УстановитьСтроку(СтрокаJSON);
    Данные = ПрочитатьJSON(Результат);
	
	Наименование = СокрЛ(Данные.lastname + " " + Данные.firstname);
	MagentoID = СтрЗаменить(СокрЛП(Данные.common_id.magento_id)," ","");
	Email = Данные.email;
	Телефон = Данные.phone;
	   	
	Контрагент = ПоискКонтрагента(MagentoID, Телефон , Email);
	
	addressesВозврат = Новый Массив;
	Если Контрагент = Справочники.Контрагенты.ПустаяСсылка() тогда
		
		НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
		НовыйКонтрагент.Наименование = Наименование;
		НовыйКонтрагент.Покупатель = истина;
		НовыйКонтрагент.MagentoID = MagentoID;
		//НовыйКонтрагент.Родитель =  НастройкаAPI.ГруппаДляСозданияНовыхКлиентов;
		НовыйКонтрагент.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
		НовыйКонтрагент.НаименованиеПолное = Наименование;   
		НовыйКонтрагент.MagentoЗапись = Истина;
		НовыйКонтрагент.Записать();
		
		Контрагент = НовыйКонтрагент.Ссылка;
				
		//Email
		Если ЗначениеЗаполнено(Email) тогда
			НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей(); 			
			НаборЗаписей.Отбор.Объект.Установить(НовыйКонтрагент.Ссылка);
			НаборЗаписей.Отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
			НаборЗаписей.Отбор.Вид.Установить(Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("Г00000014",,,)); //			
			НоваяЗапись = НаборЗаписей.Добавить(); 			
			НоваяЗапись.Объект = НовыйКонтрагент.Ссылка; 
			НоваяЗапись.Период = ТекущаяДата(); 
			НоваяЗапись.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты; 
			НоваяЗапись.Вид = Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("Г00000014",,,);   
			НоваяЗапись.Представление = Email;
			НаборЗаписей.Записать(); 		
		КонецЕсли;
		
		
		//Телефон
		Если ЗначениеЗаполнено(Телефон) тогда
			НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей(); 			
			НаборЗаписей.Отбор.Объект.Установить(НовыйКонтрагент.Ссылка);
			НаборЗаписей.Отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.Телефон);
			НаборЗаписей.Отбор.Вид.Установить(Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);			
			НоваяЗапись = НаборЗаписей.Добавить(); 	
			НоваяЗапись.Период = ТекущаяДата();
			НоваяЗапись.Объект = НовыйКонтрагент.Ссылка; 
			НоваяЗапись.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон; 
			НоваяЗапись.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента; 
			НоваяЗапись.Представление = Телефон;
			НаборЗаписей.Записать(); 
		КонецЕсли;
		
		
		
		Для Каждого Адрес Из Данные.addresses Цикл
			СтрокаУлица = ""; 
			Для Каждого Вулиця Из Адрес.street Цикл
				СтрокаУлица = ?(СтрокаУлица = "", Вулиця, СтрокаУлица + ", " + Вулиця);
			КонецЦикла;
			 Адрес_magento_id = СтрЗаменить(СокрЛП(Адрес.common_id.magento_id)," ","");
			 
			 Если Адрес.common_id.Свойство("erp_id") тогда
				 АдресКонтрагента = Справочники.ВидыКонтактнойИнформации.НайтиПоКоду(Адрес.common_id.erp_id,,,);
				 
			 Иначе
				 //АдресКонтрагента = Справочники.ВидыКонтактнойИнформации.НайтиПоРеквизиту("MagentoID",Адрес_magento_id,,);	
				 АдресКонтрагента = Справочники.ВидыКонтактнойИнформации.ПустаяСсылка();
			 КонецЕсли;
			 Если АдресКонтрагента = Справочники.ВидыКонтактнойИнформации.ПустаяСсылка() тогда
				 АдресКонтрагента = ПроверитьСвободенЛиАдресДляЗаписи(Контрагент);
			 КонецЕсли;
			 
			 //Факт адрес
			НаборЗаписей = РегистрыСведений.КонтактнаяИнформация.СоздатьНаборЗаписей(); 			
			НаборЗаписей.Отбор.Объект.Установить(НовыйКонтрагент.Ссылка);
			НаборЗаписей.Отбор.Тип.Установить(Перечисления.ТипыКонтактнойИнформации.Адрес);
			НаборЗаписей.Отбор.Вид.Установить(АдресКонтрагента);
			
			НоваяЗапись = НаборЗаписей.Добавить(); 			
			НоваяЗапись.Объект = НовыйКонтрагент.Ссылка; 
			НоваяЗапись.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес; 
			НоваяЗапись.Вид = АдресКонтрагента; 
			НоваяЗапись.Поле1 = Адрес.postcode;
			НоваяЗапись.Поле2 = Адрес.region_name;
			//НоваяЗапись.Поле3 = Адрес.postcode;
			НоваяЗапись.Поле4 = Адрес.city;
			НоваяЗапись.Поле6 = СтрокаУлица;
			НоваяЗапись.Представление = УправлениеКонтактнойИнформацией.ПолучитьПредставлениеАдреса(НоваяЗапись);
			
			НаборЗаписей.Записать();
			
			addressesВозврат.Добавить(Новый Структура("magento_id, erp_id",Адрес_magento_id,АдресКонтрагента.Код));
			
		КонецЦикла;
		
	
	КонецЕсли;
	
	СтруктураОтвета = Новый Структура;
	СтруктураОтвета.Вставить("magento_id", MagentoID);
	СтруктураОтвета.Вставить("erp_id", СокрЛП(Контрагент.Код));	
	СтруктураОтвета.Вставить("addresses", addressesВозврат);

	ОтветCustomerУспех(Ответ, СтруктураОтвета);
	
КонецПроцедуры

Функция JSONСтрока(Значение)

    Если Значение = Null Или Значение = Неопределено Тогда

        Возврат "";

    КонецЕсли;

    Возврат Строка(Значение);

КонецФункции

