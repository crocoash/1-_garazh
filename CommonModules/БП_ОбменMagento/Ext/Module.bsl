	|	РегистрСведений.ЦеныНоменклатурыКонтрагентов.СрезПоследних(, Номенклатура = &Ном) КАК ЦеныНоменклатурыКонтрагентовСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	Валюта,
	|	Цена";
	Запрос.УстановитьПараметр("Ном",_номенклатура);
	
	Рез = Запрос.Выполнить().Выбрать();
	
	ЗапросД = Новый Запрос;
	ЗапросД.Текст = "ВЫБРАТЬ
	|	ДатыПроизводстваСрезПоследних.ДатаПроизводства КАК Дата,
	|	ДатыПроизводстваСрезПоследних.Страна,
	|	ДатыПроизводстваСрезПоследних.Поставщик,
	|	ДатыПроизводстваСрезПоследних.Поставщик.ВидСклада Как Вид
	|ИЗ
	|	РегистрСведений.ДатыПроизводства.СрезПоследних(&Момент, Номенклатура = &Ном) КАК ДатыПроизводстваСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатыПроизводстваСрезПоследних.Период возр";  
	
	//ЗапросД.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	//|	ДатыПроизводстваСрезПоследних.ДатаПроизводства КАК Дата,
	//|	ДатыПроизводстваСрезПоследних.Страна,
	//|	ДатыПроизводстваСрезПоследних.Поставщик,
	//|	ДатыПроизводстваСрезПоследних.Поставщик.ВидСклада КАК Вид,
	//|	ДатыПроизводстваСрезПоследних.Период КАК Период
	//|ИЗ
	//|	РегистрСведений.ДатыПроизводства.СрезПоследних(&Момент, Номенклатура = &Ном) КАК ДатыПроизводстваСрезПоследних
	//|
	//|УПОРЯДОЧИТЬ ПО
	//|	Период УБЫВ"	
	ЗапросД.УстановитьПараметр("Ном",_номенклатура);
	ЗапросД.УстановитьПараметр("момент",ТекущаяДата());
	
	РезД = ЗапросД.Выполнить().Выбрать();
	
	ЦеныПоставщиков = Новый ТаблицаЗначений;
	ЦеныПоставщиков.Колонки.Добавить("Поставщик"); 
	ЦеныПоставщиков.Колонки.Добавить("Остаток");
	ЦеныПоставщиков.Колонки.Добавить("Количество");
	ЦеныПоставщиков.Колонки.Добавить("ЦенаПродажи");
	ЦеныПоставщиков.Колонки.Добавить("ТипЦены");
	ЦеныПоставщиков.Колонки.Добавить("Валюта");
	ЦеныПоставщиков.Колонки.Добавить("ЦенаЗакупки");
	ЦеныПоставщиков.Колонки.Добавить("Прибыль");
	ЦеныПоставщиков.Колонки.Добавить("ДатаПроизводства");
	ЦеныПоставщиков.Колонки.Добавить("Страна");       
	ЦеныПоставщиков.Колонки.Добавить("Колонка1");   

	ЦеныПоставщиков.Очистить();
	
	Пока Рез.Следующий() Цикл
		Если РЕз.ЦенаБН = 0 и Рез.Цена = 0 Тогда
			Продолжить;
		КонецЕслИ;
		Цена1 = Рез.РекОпт;
		Цена2 = Рез.РекОптБН;
		Цена3 = Рез.РекРозница;
		Цена4 = Рез.РекРозницаБН;
		
		Стр = ЦеныПоставщиков.Добавить();
		Стр.Поставщик = Рез.Поставщик;
		Стр.Количество = Рез.Остаток;
		Стр.ТипЦены = Рез.ТипЦен;
		если ТипЦены.Безнал Тогда
			Стр.ЦенаЗакупки = Рез.ЦенаБН;
		Иначе
			Стр.ЦенаЗакупки = Рез.Цена;
		КонецЕслИ;
		ЦенаЗакупки = Стр.ЦенаЗакупки;
		//с.д. Рижий 2024-02-14 )
	
        Стр.ЦенаПродажи = _получитьЦеныНоменклатуры(_номенклатура,ТИПЦЕНЫ, Стр.Поставщик);
		//с.д. Рижий 2024-02-14 )
	

		Стр.Валюта = Рез.Валюта;
		Курс = МодульВалютногоучета.ПолучитьКурсВалюты(Рез.Валюта,ТекущаяДата());
		
		Стр.Прибыль = Стр.ЦенаПродажи - Стр.ЦенаЗакупки*курс.Курс/курс.Кратность;
		
		РезД.Сбросить();
		Струк = Новый Структура;
		Струк.Вставить("Поставщик",Рез.Поставщик);
		пока РезД.Найтиследующий(Струк)  Цикл
			Стр.ДатаПроизводства = РезД.Дата;
			Стр.Страна = РезД.Страна;
		КонецЦикла;
	КонецЦикла;   
	
	ЗапросП = Новый Запрос;
	ЗапросП.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ПеремещениеТоваровТовары.Ссылка.СкладОтправитель,
	               |	ПеремещениеТоваровТовары.Ссылка.СкладПолучатель,
	               |	ПеремещениеТоваровТовары.Номенклатура,
	               |	ПеремещениеТоваровТовары.Ссылка.Дата КАК Дата
	               |ИЗ
	               |	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	               |ГДЕ
	               |	ПеремещениеТоваровТовары.Ссылка.Проведен
	               |	И ПеремещениеТоваровТовары.Ссылка.СкладПолучатель = &СкладПолучатель
	               |	И ПеремещениеТоваровТовары.Номенклатура = &Ном
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ";    
	
	ЗапросП.УстановитьПараметр("Ном",_номенклатура);
	


	
	
	Запрос = Новый Запрос;  //FOFA При открытии остатки
	Запрос.Текст = "ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоКонечныйОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)) КАК Резерв,
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОстатки.Склад,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоКонечныйОстаток, 1) <> 0
	|			ТОГДА ТоварыНаСкладахОстатки.СтоимостьКонечныйОстаток / ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоКонечныйОстаток, 1)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Поле1,
	|	ВложенныйЗапрос.Регистратор
	|ИЗ
	|	РегистрНакопления.ПартииТоваровНаСкладах.ОстаткиИОбороты(&ТекДата,&ТекДата, Регистратор, ,Номенклатура В (&Номенклатура)) КАК ТоварыНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Номенклатура В (&Номенклатура)) КАК ТоварыВРезервеНаСкладахОстатки
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
	|			И ТоварыНаСкладахОстатки.Склад = ТоварыВРезервеНаСкладахОстатки.Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ ПЕРВЫЕ 1
	|			ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|			ВложенныйЗапрос.Регистратор КАК Регистратор
	|		ИЗ
	|			(ВЫБРАТЬ
	|				ТоварыНаСкладахОстаткиИОбороты.Номенклатура КАК Номенклатура,
	|				ТоварыНаСкладахОстаткиИОбороты.Регистратор КАК Регистратор,
	|				МАКСИМУМ(ТоварыНаСкладахОстаткиИОбороты.Регистратор.Дата) КАК РегистраторДата
	|			ИЗ
	|				РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(, , Регистратор, , Номенклатура = &Номенклатура) КАК ТоварыНаСкладахОстаткиИОбороты
	|			ГДЕ
	|				ТоварыНаСкладахОстаткиИОбороты.Регистратор.ВидПоступления = &ВидО
	|			
	|			СГРУППИРОВАТЬ ПО
	|				ТоварыНаСкладахОстаткиИОбороты.Номенклатура,
	|				ТоварыНаСкладахОстаткиИОбороты.Регистратор) КАК ВложенныйЗапрос
	|		
	|		УПОРЯДОЧИТЬ ПО
	|			ВложенныйЗапрос.РегистраторДата УБЫВ) КАК ВложенныйЗапрос
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = ВложенныйЗапрос.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладахОстатки.Номенклатура,
	|	ТоварыНаСкладахОстатки.Склад,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоКонечныйОстаток, 1) <> 0
	|			ТОГДА ТоварыНаСкладахОстатки.СтоимостьКонечныйОстаток / ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоКонечныйОстаток, 1)
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВложенныйЗапрос.Регистратор";
	Запрос.УстановитьПараметр("Номенклатура",_номенклатура);
	Запрос.УстановитьПараметр("ВидО",перечисления.ВидыПоступленияТоваров.НаСклад); 
	Запрос.УстановитьПараметр("ТекДата",КонецДня(ТекущаяДата()));
	
	Рез = Запрос.Выполнить().Выбрать();
	Пока Рез.Следующий() Цикл
		Стр = ЦеныПоставщиков.Добавить();
		Стр.Поставщик = Рез.Склад;
		Стр.Количество = Рез.Резерв;
		Стр.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
		Попытка
			Стр.ЦенаЗакупки = Рез.поле1/Рез.Регистратор.КурсВзаиморасчетов*Рез.Регистратор.КратностьВзаиморасчетов;
			Стр.Валюта = Рез.Регистратор.ВалютаДокумента;
		Исключение
			Стр.ЦенаЗакупки = Рез.поле1;
		КонецПопытки;
		РезД.Сбросить();   
		
		ТоварНайден = Ложь;
		Струк = Новый Структура; 
		Струк.Вставить("Поставщик",Рез.Склад);
		//Струк.Вставить("Вид",Перечисления.ВидыСкладов.Оптовый);
		пока РезД.Найтиследующий(Струк)  Цикл
			Стр.ДатаПроизводства = РезД.Дата;
			Стр.Страна = РезД.Страна;
			ТоварНайден = Истина;
		КонецЦикла;              
		
		Если Не ТоварНайден тогда  
			
			ЗапросП.УстановитьПараметр("СкладПолучатель",Рез.Склад);			
			Выборка = ЗапросП.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				Струк = Новый Структура; 
				Струк.Вставить("Поставщик",Выборка.СкладОтправитель);
				//Струк.Вставить("Вид",Перечисления.ВидыСкладов.Оптовый);
				пока РезД.Найтиследующий(Струк)  Цикл
					Стр.ДатаПроизводства = РезД.Дата;
					Стр.Страна = РезД.Страна;
				КонецЦикла; 			
			КонецЦикла;
			
		КонецЕсли;
		//Стр.ЦенаПродажи = Ценообразование.ПолучитьЦенуНоменклатуры(_номенклатура,,ТИПЦЕНЫ,,,Константы.ВалютаРегламентированногоУчета.Получить()); 
		Стр.ЦенаПродажи = _получитьЦеныНоменклатуры(_номенклатура,ТИПЦЕНЫ);
		Стр.Прибыль = Стр.ЦенаПродажи - Рез.поле1;
		Стр.Колонка1 = -1;
	КонецЦикла;
	ЦеныПоставщиков.Сортировать("Колонка1, ЦенаПродажи Возр");
	
	Возврат ЦеныПоставщиков;
КонецФункции           

Функция _получитьЦеныНоменклатуры(номенклатура, ТипЦен, Контрагент  = Неопределено) 
	
	
	Если Контрагент = Неопределено тогда  
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Склады.Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	_своиСклады = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	_своиСклады.Добавить(Справочники.Склады.ПустаяСсылка());
	_своиСклады.Добавить(Справочники.Контрагенты.ПустаяСсылка());
	_своиСклады.Добавить(Неопределено);

		Контрагент = _своиСклады;	
	КонецЕсли;
	
	результатФункции = 0;
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Даний фрагмент побудований конструктором.
	// При повторному використанні конструктора, внесені вручну зміни будуть втрачені!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Цена,
	|	ЦеныНоменклатурыСрезПоследних.Валюта
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			Номенклатура = &Номенклатура
	|				И ТипЦен = &ТипЦен
	|				И Поставщик В (&Контрагент)) КАК ЦеныНоменклатурыСрезПоследних";
	
	//Запрос.УстановитьПараметр("ДатаДокумента", ТекущаяДата());
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		// Вставити обробку вибірки ВыборкаДетальныеЗаписи 
		Если ВыборкаДетальныеЗаписи.Валюта <> Валюта тогда
			Курс = МодульВалютногоучета.ПолучитьКурсВалюты(ВыборкаДетальныеЗаписи.Валюта,ТекущаяДата());
			результатФункции  = ВыборкаДетальныеЗаписи.цена*курс.Курс/курс.Кратность;
		Иначе
			результатФункции  = ВыборкаДетальныеЗаписи.цена;
		КонецЕсли;
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
	
	возврат результатФункции;
КонецФункции


//Вивантаження на два сайти  

Процедура MagentoВидНоменклатуры(Источник, Отказ, MagentoID = "MagentoID")
	
	Если Не ЗначениеЗаполнено(Источник[MagentoID]) тогда
		
		АдресМетода = "/erp/products/attribute-sets";
		
		Если Не ЗначениеЗаполнено(Источник.Код) тогда
			Источник.УстановитьНовыйКод();
		КонецЕсли;
		
		МассивРеквизитовВидаНоменклатуры = ПолучитьРеквизитыВидовНоменклатуры(Источник.Ссылка); 

		СтруктураОтправки_category = Новый Структура;
		СтруктураОтправки_category.Вставить("erp_id", Источник.Код);	
		СтруктураОтправки_category.Вставить("attribute_set_name", Источник.Наименование);	
		СтруктураОтправки_category.Вставить("sort_order", 0);
		СтруктураОтправки_category.Вставить("attributes_codes", МассивРеквизитовВидаНоменклатуры);
		//СтруктураОтправки_category.Вставить("parent_erp_id", "");
		
				
		СтруктураОтправки = Новый Структура;
		СтруктураОтправки.Вставить("attribute_set", СтруктураОтправки_category);			
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураОтправки);
		СтруктураОтправкиJSON = ЗаписьJSON.Закрыть();
		
		Заголовки = Новый Соответствие;
		
		Если MagentoID = "MagentoGarazhID" тогда
			Результат = ВыполнитьОтправкуНаСайт(АдресМетода, Заголовки, СтруктураОтправкиJSON,,Истина); 
		Иначе
			Результат = ВыполнитьОтправкуНаСайт(АдресМетода, Заголовки, СтруктураОтправкиJSON); 
		КонецЕсли;
		
		Если Результат = Неопределено тогда
			Возврат;
		КонецЕсли;
		
		Если Результат.КодСостояния = 200 Тогда 
			Попытка
				РезультатJSON = Новый ЧтениеJSON;
				РезультатJSON.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
				Данные = ПрочитатьJSON(РезультатJSON);
				Источник[MagentoID] = Данные.magento_id;
			Исключение
				Сообщить("Не вдалося отримати MagentoID!");
			КонецПопытки;				
		Иначе
			Сообщить("Помилка підключення! " + Результат.ПолучитьТелоКакСтроку());
		КонецЕсли;  
	
	Иначе
		
		АдресМетода = "/erp/products/attribute-sets/" + СокрЛП(Источник.Код);	
		
		МассивРеквизитовВидаНоменклатуры = ПолучитьРеквизитыВидовНоменклатуры(Источник.Ссылка); 

		СтруктураОтправки_category = Новый Структура;
		СтруктураОтправки_category.Вставить("erp_id", Источник.Код);	
