Функция Транслитерировать(Текст)

	Таблица = Новый Соответствие;

	// Русские буквы
	Таблица.Вставить("А", "_a");     Таблица.Вставить("а", "a");
	Таблица.Вставить("Б", "_b");     Таблица.Вставить("б", "b");
	Таблица.Вставить("В", "_v");     Таблица.Вставить("в", "v");
	Таблица.Вставить("Г", "_g");     Таблица.Вставить("г", "g");
	Таблица.Вставить("Д", "_d");     Таблица.Вставить("д", "d");
	Таблица.Вставить("Е", "_e");     Таблица.Вставить("е", "e");
	Таблица.Вставить("Ё", "_e");     Таблица.Вставить("ё", "e");
	Таблица.Вставить("Ж", "_zh");    Таблица.Вставить("ж", "zh");
	Таблица.Вставить("З", "_z");     Таблица.Вставить("з", "z");
	Таблица.Вставить("И", "_i");     Таблица.Вставить("и", "i");
	Таблица.Вставить("Й", "_y");     Таблица.Вставить("й", "y");
	Таблица.Вставить("К", "_k");     Таблица.Вставить("к", "k");
	Таблица.Вставить("Л", "_l");     Таблица.Вставить("л", "l");
	Таблица.Вставить("М", "_m");     Таблица.Вставить("м", "m");
	Таблица.Вставить("Н", "_n");     Таблица.Вставить("н", "n");
	Таблица.Вставить("О", "_o");     Таблица.Вставить("о", "o");
	Таблица.Вставить("П", "_p");     Таблица.Вставить("п", "p");
	Таблица.Вставить("Р", "_r");     Таблица.Вставить("р", "r");
	Таблица.Вставить("С", "_s");     Таблица.Вставить("с", "s");
	Таблица.Вставить("Т", "_t");     Таблица.Вставить("т", "t");
	Таблица.Вставить("У", "_u");     Таблица.Вставить("у", "u");
	Таблица.Вставить("Ф", "_f");     Таблица.Вставить("ф", "f");
	Таблица.Вставить("Х", "_kh");    Таблица.Вставить("х", "kh");
	Таблица.Вставить("Ц", "_ts");    Таблица.Вставить("ц", "ts");
	Таблица.Вставить("Ч", "_ch");    Таблица.Вставить("ч", "ch");
	Таблица.Вставить("Ш", "_sh");    Таблица.Вставить("ш", "sh");
	Таблица.Вставить("Щ", "_shch");  Таблица.Вставить("щ", "shch");
	Таблица.Вставить("Ъ", "");      Таблица.Вставить("ъ", "");
	Таблица.Вставить("Ы", "_y");     Таблица.Вставить("ы", "y");
	Таблица.Вставить("Ь", "");      Таблица.Вставить("ь", "");
	Таблица.Вставить("Э", "_e");     Таблица.Вставить("э", "e");
	Таблица.Вставить("Ю", "_yu");    Таблица.Вставить("ю", "yu");
	Таблица.Вставить("Я", "_ya");    Таблица.Вставить("я", "ya");

	// Украинские буквы
	Таблица.Вставить("Ґ", "_g");     Таблица.Вставить("ґ", "g");
	Таблица.Вставить("Є", "_ie");    Таблица.Вставить("є", "ie");
	Таблица.Вставить("І", "_i");     Таблица.Вставить("і", "i");
	Таблица.Вставить("Ї", "_i");    Таблица.Вставить("ї", "i");  
	
	Результат = "";

    Для Инд = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Инд, 1);
		Если Таблица[Символ] <> Неопределено Тогда
			Результат = Результат + Таблица[Символ];
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;  
		Если Инд = 1 тогда
			Результат = СтрЗаменить(Результат, "_", "");	   	
		КонецЕсли;
    КонецЦикла;

    Возврат Результат;

КонецФункции

Процедура ОтправитьНовыйАтрибутНаСайт(НовЭлемент)
	АдресМетода = "/erp/products/attributes";  
	СтруктураЗначений = Новый Структура;
	МассивВозвратаЗначений = Новый Массив;	
	
	Попытка
		ИмяМетаданных = Справочники.Номенклатура.найтиПоКоду("",,,)[НовЭлемент.Наименование].Метаданные().Имя;
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	Атрибут.Ссылка,
		|	Атрибут.Код
		|ИЗ
		|	Справочник."+ ИмяМетаданных + " КАК Атрибут
		|ГДЕ
		|	НЕ Атрибут.ПометкаУдаления");
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		
		Для каждого Стр из ТЗ цикл 
			СтруктураЗначений = Новый Структура("label, value",Строка(Стр.Ссылка),Строка(Стр.Код));
			МассивВозвратаЗначений.Добавить(СтруктураЗначений)	
		КонецЦикла;
	Исключение  
		
	КонецПопытки;
	
	СтруктураОтправки_category = Новый Структура;
	СтруктураОтправки_category.Вставить("attribute_code", НовЭлемент.attribute_code);	
	СтруктураОтправки_category.Вставить("erp_id", НовЭлемент.Наименование);
	СтруктураОтправки_category.Вставить("frontend_input", НовЭлемент.frontend_input);
	СтруктураОтправки_category.Вставить("is_required", 0);  
	СтруктураОтправки_category.Вставить("is_filterable", false);  
	СтруктураОтправки_category.Вставить("default_frontend_label", НовЭлемент.Наименование);
	СтруктураОтправки_category.Вставить("options", МассивВозвратаЗначений);
		
	СтруктураОтправки = Новый Структура;
	СтруктураОтправки.Вставить("attribute", СтруктураОтправки_category);			
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураОтправки);
	СтруктураОтправкиJSON = ЗаписьJSON.Закрыть();
	
	Заголовки = Новый Соответствие;
	
	Результат = ВыполнитьОтправкуНаСайт(АдресМетода, Заголовки, СтруктураОтправкиJSON,""); 
	
	Если Результат = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.КодСостояния <> 200 Тогда 
		Сообщить("Помилка підключення! " + Результат.ПолучитьТелоКакСтроку());
	КонецЕсли;	
КонецПроцедуры  


