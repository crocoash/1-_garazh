Функция ПроверитьСвободенЛиАдресДляЗаписи(Контрагент)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КонтактнаяИнформация.Объект,
	                      |	КонтактнаяИнформация.Вид,
	                      |	КонтактнаяИнформация.Представление
	                      |ИЗ
	                      |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	                      |ГДЕ
	                      |	КонтактнаяИнформация.Объект = &Объект
	                      |	И КонтактнаяИнформация.Вид В(&Вид)");
	
	МассивАдресов = Новый Массив;
	МассивАдресов.Добавить(Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000025")); 
	МассивАдресов.Добавить(Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000026"));
