Функция ОбработатьСоответствиеАтрибутов(МассивВозврата)
	
	МассивВозвратаАтрибутов = Новый Массив;
		 
	Макет = ПолучитьОбщийМакет("MagentoСоответствиеАтрибутов");	
	
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Макет.Область());  	
	
	ТабДанные = Построитель.Результат.Выгрузить(); 

	ТЗДок = ТабДанные.Скопировать(,"attribute_code,	ИмяРеквизита1, ИмяРеквизита2");

	Для каждого ЭлементМассив из МассивВозврата цикл  
				
		НайденнаяСтрока = ТЗДок.Найти(ЭлементМассив, "ИмяРеквизита1");
		Если НайденнаяСтрока = Неопределено Тогда
			НайденнаяСтрока = ТЗДок.Найти(ЭлементМассив, "ИмяРеквизита2");
			Если НайденнаяСтрока <> Неопределено Тогда
				attribute_code = НайденнаяСтрока.attribute_code; 
				МассивВозвратаАтрибутов.Добавить(attribute_code);
			иначе     
				НайденнаяСтрока = Справочники.MagentoСоответствиеРеквизитовНоменклатуры.НайтиПоНаименованию(ЭлементМассив,Истина,,);
				Если НайденнаяСтрока <> Справочники.MagentoСоответствиеРеквизитовНоменклатуры.ПустаяСсылка() Тогда
					attribute_code = НайденнаяСтрока.attribute_code; 
					МассивВозвратаАтрибутов.Добавить(attribute_code);
				иначе
					
					//створюємо атрибут сет  
					Попытка
						ТипРеквизита = ТипЗнч(Справочники.Номенклатура.найтиПоКоду("",,,)[ЭлементМассив]);
						Если ТипРеквизита = Тип("Строка") тогда
							ТипРеквизита = "text";        
						ИначеЕсли ТипРеквизита = Тип("Булево") тогда
							ТипРеквизита = "boolean";
						Иначе 
							ТипРеквизита = "select";
						КонецЕсли;
					Исключение
						ТипРеквизита = "text";
					КонецПопытки;
					
					//Справочники.Номенклатура.Метаданные()
					НовЭлемент = Справочники.MagentoСоответствиеРеквизитовНоменклатуры.СоздатьЭлемент();
					НовЭлемент.attribute_code = Транслитерировать(ЭлементМассив);
					НовЭлемент.Наименование = ЭлементМассив;
					НовЭлемент.frontend_input = ТипРеквизита; 
					Если НовЭлемент.attribute_code = "material_tsentrovochnykh_kolets" тогда
						НовЭлемент.frontend_input = "select";	
					КонецЕсли;
					НовЭлемент.Записать();
					
					МассивВозвратаАтрибутов.Добавить(НовЭлемент.attribute_code);
					
					ОтправитьНовыйАтрибутНаСайт(НовЭлемент);
				КонецЕсли;
			КонецЕсли;
		Иначе
			attribute_code = НайденнаяСтрока.attribute_code; 
			МассивВозвратаАтрибутов.Добавить(attribute_code);
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат МассивВозвратаАтрибутов;
	
КонецФункции

