функция ПоискКонтрагента(MagentoID = "", Телефон = "", Email = "", НомерКотрагента = "")
	
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();          
	
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Контрагенты.Ссылка
	                      |ИЗ
	                      |	Справочник.Контрагенты КАК Контрагенты
	                      |ГДЕ
	                      |	(Контрагенты.MagentoID = &MagentoID
	                      |			)
	                      |	И НЕ Контрагенты.ПометкаУдаления
	                      |	И НЕ Контрагенты.ЭтоГруппа");
	
	Запрос.УстановитьПараметр("MagentoID", MagentoID);
	Запрос.УстановитьПараметр("НомерКотрагента", НомерКотрагента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() цикл
		Контрагент = Выборка.Ссылка;	
	КонецЦикла; 
	
	Если ЗначениеЗаполнено(Контрагент) тогда
		Возврат Контрагент;	
	КонецЕсли;
	
	//Возврат Контрагент;
	
	Если ЗначениеЗаполнено(Телефон) тогда 
		
		МассивВидов = Новый Массив;
		МассивВидов.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
		МассивВидов.Добавить(Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("Г00000013",,,)); 
		МассивВидов.Добавить(Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("Г00000002",,,));
		МассивВидов.Добавить(Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000031",,,)); 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	КонтактнаяИнформация.Объект.Код КАК Код,
		               |	КонтактнаяИнформация.Объект,
		               |	КонтактнаяИнформация.Вид,
		               |	КонтактнаяИнформация.Представление
		               |ИЗ
		               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		               |ГДЕ
		               |	ПОДСТРОКА(КонтактнаяИнформация.Представление, 1, 20) ПОДОБНО ""%"" + &Телефон
		               |	И КонтактнаяИнформация.Тип = &ТИП
		               |	И КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты
		               |	И КонтактнаяИнформация.Вид В(&Вид)";
		Запрос.УстановитьПараметр("Телефон", Строка(Прав(Телефон,9)));
		Запрос.УстановитьПараметр("ТИП",Перечисления.ТипыКонтактнойИнформации.Телефон);
		Запрос.УстановитьПараметр("Вид",МассивВидов);
		
		РезЗапроса = Запрос.Выполнить().Выгрузить();
		Если РезЗапроса.Количество()  Тогда
			Возврат РезЗапроса[0].Объект; 
		КонецЕсли; 
		
	КонецЕсли;   
	
	Если ЗначениеЗаполнено(Email) тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактнаяИнформация.Объект.Код КАК Код,
		|	КонтактнаяИнформация.Объект,
		|	КонтактнаяИнформация.Вид,
		|	КонтактнаяИнформация.Представление
		|ИЗ
		|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	ПОДСТРОКА(КонтактнаяИнформация.Представление, 1, 30) ПОДОБНО ""%"" + &Email
		|	И КонтактнаяИнформация.Тип = &ТИП
		|	И КонтактнаяИнформация.Объект ССЫЛКА Справочник.Контрагенты";
		Запрос.УстановитьПараметр("Email",Email);
		Запрос.УстановитьПараметр("ТИП",Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		
		РезЗапроса = Запрос.Выполнить().Выгрузить();
		Если РезЗапроса.Количество()  Тогда
			Возврат РезЗапроса[0].Объект;			
		КонецЕсли; 
		
	КонецЕсли;

	
	Возврат Контрагент;
	
КонецФункции       

Процедура УстановитьСтатусОтправки(Документ, Статус, Комментарий = "") Экспорт  
	
	Если ТипЗнч(Документ) <> Тип("ДокументСсылка.УстановкаЦенНоменклатуры") тогда
		Возврат;
	КонецЕсли;
	
	Запись = РегистрыСведений.БП_MagentoОчередьУстановкаЦенНоменклатуры.СоздатьМенеджерЗаписи();
	Запись.Документ = Документ;
	Запись.Прочитать();
	Запись.Статус = Статус; // тут заполняете новыми нужными данными 
	Запись.Комментарий = Комментарий; 
	Запись.Записать();	
	
КонецПроцедуры

Процедура УстановкаЦенНоменклатуриОтправить(СтруктураОтправки, Документ = Неопределено, MagentoID = "MagentoID") Экспорт 
	Если MagentoID = "MagentoGarazhID" тогда
		ЭтоГараж = Истина; 
	Иначе
		ЭтоГараж = Ложь; 
	КонецЕсли;	
	//АдресМетода = "/erp/products/"+ СтруктураОтправки.product.erp_id +  "/stock";
	///erp/products/stock-multiple-async/{request_id}
	АдресМетода = "/erp/products/stock-multiple-async/" + СтруктураОтправки.request_id;
			
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураОтправки);
	СтруктураОтправкиJSON = ЗаписьJSON.Закрыть();
	
	Заголовки = Новый Соответствие;
	
	Результат = ВыполнитьОтправкуНаСайт(АдресМетода, Заголовки, СтруктураОтправкиJSON, "PUT", ЭтоГараж); 
	
	Если Результат = Неопределено тогда
		Возврат;
	КонецЕсли;  
	
	//Запись про отправку 
	Если ЭтоГараж тогда
		МенеджерЗаписи = РегистрыСведений.БП_АсинхроннаяПакетнаяВыгрузкаGarazh.СоздатьМенеджерЗаписи(); 	
	Иначе
		МенеджерЗаписи = РегистрыСведений.БП_АсинхроннаяПакетнаяВыгрузка.СоздатьМенеджерЗаписи(); 
	КонецЕсли;
	МенеджерЗаписи.КодПакету = СтруктураОтправки.request_id; 
	МенеджерЗаписи.Отправлен = Истина;   
	МенеджерЗаписи.ДатаОтправления = ТекущаяДата(); 
	МенеджерЗаписи.Получен = Ложь; 
	МенеджерЗаписи.Документ = Документ; 
	МенеджерЗаписи.Записать(Истина);

	
	Если Результат.КодСостояния = 200 Тогда        
		Попытка
						
			РезультатJSON = Новый ЧтениеJSON;
			РезультатJSON.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
			Данные = ПрочитатьJSON(РезультатJSON);
			//Источник.MagentoID = Данные.magento_id; 
				
		Исключение
			Сообщить("Не вдалося отримати MagentoID!");
		КонецПопытки;				
	Иначе 
		
		СтрокаТелоОтвет = Результат.ПолучитьТелоКакСтроку();
		Сообщить("Помилка підключення! " + СтрокаТелоОтвет);
		
		РезультатJSON = Новый ЧтениеJSON;
		РезультатJSON.УстановитьСтроку(СтрокаТелоОтвет);
		РезультатДанные = ПрочитатьJSON(РезультатJSON);

		//УстановитьСтатусОтправки(Документ, Перечисления.БП_СтатусОтправкиСообщения.НеОтправлено, Результат.ПолучитьТелоКакСтроку()); 
		
		//Запись про неуспешную отправку 
		
		Если РезультатДанные.count = 0 тогда  
			Если ЭтоГараж тогда
				НаборЗаписей = РегистрыСведений.БП_АсинхроннаяПакетнаяВыгрузкаGarazh.СоздатьМенеджерЗаписи(); 	
			Иначе
				НаборЗаписей = РегистрыСведений.БП_АсинхроннаяПакетнаяВыгрузка.СоздатьМенеджерЗаписи(); 
			КонецЕсли;

			//НаборЗаписей = РегистрыСведений.БП_АсинхроннаяПакетнаяВыгрузка.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.КодПакету.Установить(СтруктураОтправки.request_id); 
			НаборЗаписей.Прочитать();
			Для Каждого СтрокаТаблицы Из НаборЗаписей Цикл 
				СтрокаТаблицы.Получен = Истина; 
				СтрокаТаблицы.ДатаПолученияОтвета = ТекущаяДата(); 
				СтрокаТаблицы.Комментарий = РезультатДанные.error_message; 
			КонецЦикла; 
			НаборЗаписей.Записать();
			
		Иначе	
			Для каждого Стр из СтруктураОтправки.products цикл           
				Если ЭтоГараж тогда
					МенеджерЗаписи = РегистрыСведений.БП_MagentoСтатусыОтправленойНоменклатурыGarazh.СоздатьМенеджерЗаписи(); 	
				Иначе
					МенеджерЗаписи = РегистрыСведений.БП_MagentoСтатусыОтправленойНоменклатуры.СоздатьМенеджерЗаписи(); 
				КонецЕсли;

				//МенеджерЗаписи = РегистрыСведений.БП_MagentoСтатусыОтправленойНоменклатуры.СоздатьМенеджерЗаписи();
				МенеджерЗаписи.Номенклатура = Справочники.Номенклатура.НайтиПоКоду(Стр.erp_id,,,); 
				//МенеджерЗаписи.Документ = Документ;   
				МенеджерЗаписи.Комментарий = СтрокаТелоОтвет;  
				МенеджерЗаписи.КодПакету = СтруктураОтправки.request_id;
				МенеджерЗаписи.Успешно = Ложь; 
				МенеджерЗаписи.Записать(Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли; 

