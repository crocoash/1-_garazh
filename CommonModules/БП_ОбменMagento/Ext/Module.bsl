Процедура MagentoПередЗаписьюЗаказаПокупателяПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	//	Если ПараметрыСеанса.ТекущийПользователь <> Справочники.Пользователи.НайтиПоНаименованию("Діма_СrmAdmin") тогда;
	//	Возврат;
	//КонецЕсли;

	Если Отказ тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение тогда
		Возврат;	
	КонецЕсли;
	
	// Заказы с сенсорного экрана на сайт не отправляем: это наряды шиномонтажа,
	// им в Magento делать нечего. Раньше они сюда не доходили вовсе — терминал
	// писал заказ без проведения; с проведением подписка стала бы создавать
	// заказ на сайте. Метку ставит сам терминал перед записью.
	Если Источник.ДополнительныеСвойства.Свойство("СенсорныйЕкран_НеОтправлятьНаСайт") тогда
		Возврат;
	КонецЕсли;
	
	ЭтоГараж = (Источник.ТипЦен <> Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("ionity.tires",,,));
	
	//тогда
	//	Возврат;
	//КонецЕсли;
	
	
	Если Не ЗначениеЗаполнено(Источник.MagentoID) тогда
		
		АдресМетода = "/erp/orders/create";
		
		Если Не ЗначениеЗаполнено(Источник.номер) тогда
			Источник.УстановитьНовыйНомер();
		КонецЕсли;
		
		МассивРеквизитовКОтправке = Новый Массив; 
		МассивКатегорий = Новый Массив;
		СтруктураОтправки_category = Новый Структура;
		//МассивРеквизитовКОтправке = ПолучитьЗначенияРевизитовПоВидуНоменклутри(Источник, Источник.ВидНоменклатуры);                     
		СтруктураОтправки_category.Вставить("common_id", Новый Структура("erp_id",Источник.номер));
		//СтруктураОтправки_category.Вставить("erp_id", Источник.Код);	
		СтруктураОтправки_category.Вставить("customer", ПолучитьСтруктуруОтправкиКастомераДляЗаказа(Источник.Контрагент,Источник.АдресДоставки));
		
		
		ИтогСкидка = 0;
		subtotal = 0;
		МассивТоваров = Новый Массив;
		Для каждого Стр Из Источник.Товары Цикл
			СтруктураТовара = Новый Структура;
			СтруктураТовара.Вставить("sku",Стр.Номенклатура.Код);
		    СтруктураТовара.Вставить("name",Стр.Номенклатура.Наименование); 
			СтруктураТовара.Вставить("qty_ordered",Стр.Количество);
			СтруктураТовара.Вставить("qty_canceled", 0); 
			СтруктураТовара.Вставить("qty_invoiced", 0);
			СтруктураТовара.Вставить("qty_refunded", 0);
			СтруктураТовара.Вставить("qty_shipped", 0);
			СтруктураТовара.Вставить("price", Стр.Цена);  
			Скидка = ( (Стр.Количество * Стр.Цена) - Стр.Сумма); 
			Скидка = ?(Скидка > 0.05, Скидка, 0);
			СтруктураТовара.Вставить("discount_amount", Скидка); 
			СтруктураТовара.Вставить("row_total", Стр.Сумма); 
			МассивТоваров.Добавить(СтруктураТовара);    
			ИтогСкидка = ИтогСкидка + Скидка;    
			subtotal = subtotal +  (Стр.Количество * Стр.Цена);
		КонецЦикла;  
		
		Для каждого Стр Из Источник.Услуги Цикл
			СтруктураТовара = Новый Структура;
			СтруктураТовара.Вставить("sku",Стр.Номенклатура.Код);
		    СтруктураТовара.Вставить("name",Стр.Номенклатура.Наименование); 
			СтруктураТовара.Вставить("qty_ordered",Стр.Количество);
			СтруктураТовара.Вставить("qty_canceled", 0); 
			СтруктураТовара.Вставить("qty_invoiced", 0);
			СтруктураТовара.Вставить("qty_refunded", 0);
			СтруктураТовара.Вставить("qty_shipped", 0);
			СтруктураТовара.Вставить("price", Стр.Цена);  
			Скидка = ( (Стр.Количество * Стр.Цена) - Стр.Сумма); 
			Скидка = ?(Скидка > 0.05, Скидка, 0);
			СтруктураТовара.Вставить("discount_amount", Скидка); 
			СтруктураТовара.Вставить("row_total", Стр.Сумма); 
			МассивТоваров.Добавить(СтруктураТовара);    
			ИтогСкидка = ИтогСкидка + Скидка;    
			subtotal = subtotal +  (Стр.Количество * Стр.Цена);
		КонецЦикла;

		
		СтруктураОтправки_category.Вставить("items", МассивТоваров);    
		
		
		СтруктураОтправки_category.Вставить("customer_note", Источник.Комментарий); 
		СтруктураОтправки_category.Вставить("use_storage", Источник.use_storage);

        СтруктураОтправки_category.Вставить("subtotal", subtotal );
		СтруктураОтправки_category.Вставить("discount_amount", ИтогСкидка);
		СтруктураОтправки_category.Вставить("grand_total", Источник.СуммаДокумента);

		СтруктураОтправки_category.Вставить("payment_method",Строка(Источник.ФормаРасчета.Код));     
		СтруктураОтправки_category.Вставить("shipping_method",Строка(Источник.УсловиеПоставки.Код));
		СтруктураОтправки_category.Вставить("shipping_amount", 0); 
		СтруктураОтправки_category.Вставить("status", Строка(Источник.Статус.Код));
		СтруктураОтправки_category.Вставить("created_at", Формат(ТекущаяДата(),"ДЛФ=DT"));
		СтруктураОтправки_category.Вставить("tire_service", false);
     
				
		СтруктураОтправки = Новый Структура;
		СтруктураОтправки.Вставить("order", СтруктураОтправки_category);			
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
