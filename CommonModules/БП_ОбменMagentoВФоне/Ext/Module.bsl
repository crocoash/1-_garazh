// Выгружает массив номенклатуры на сайт пачками.
//
// Нужна потому, что штатный путь - подписка MagentoПередЗаписьюНоменклатурыПередЗаписью -
// на каждую запись пускает фоновое задание с фиксированным ключом "MagentoID", и при
// массовой перезаписи задания конфликтуют по ключу. Пакетная перегенерация пишет
// с ОбменДанными.Загрузка = Истина (подписка молчит) и вызывает эту процедуру один раз.
Процедура ВыгрузитьМассивНоменклатурыНаСайт(МассивНоменклатуры, MagentoID = "MagentoID") Экспорт

	МассивТоваровДляОтправки       = Новый Массив;
	МассивТоваровДляОтправкиGarazh = Новый Массив;

	МаксКоличествоВПакете = Константы.MagentoКочествоПозицыйВПакетнойВыгрузке.Получить();
	Если НЕ ЗначениеЗаполнено(МаксКоличествоВПакете) Тогда
		МаксКоличествоВПакете = 50;
	КонецЕсли;

	НомерПакета       = 1;
	КоличествоВПакете = 0;

	Для Каждого СсылкаНоменклатуры Из МассивНоменклатуры Цикл

		КоличествоВПакете = КоличествоВПакете + 1;

		СтруктураОтправки_category = БП_ОбменMagento.MagentoМасоваяВыгрузкаНоменклатурыДляАсинхронойОтправки(
			СсылкаНоменклатуры, Ложь, MagentoID);

		МассивТоваровДляОтправки.Добавить(СтруктураОтправки_category);

		Если КоличествоВПакете >= МаксКоличествоВПакете Тогда
			ВыполнитьОтправкуПакета(МассивТоваровДляОтправки, МассивТоваровДляОтправкиGarazh, НомерПакета, MagentoID);
			КоличествоВПакете = 0;
			МассивТоваровДляОтправки.Очистить();
			НомерПакета = НомерПакета + 1;
		КонецЕсли;

	КонецЦикла;

	ВыполнитьОтправкуПакета(МассивТоваровДляОтправки, МассивТоваровДляОтправкиGarazh, НомерПакета, MagentoID);

КонецПроцедуры // ВыгрузитьМассивНоменклатурыНаСайт()
