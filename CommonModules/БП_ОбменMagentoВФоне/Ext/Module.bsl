Процедура БП_ВыполнитьОтправкуНаСайтРейтинга(Дата,ТипЦеныРасчета,Ссылка) Экспорт 
	Товары = Ссылка.Товары;
		
	Номенклатура = Товары.ВыгрузитьКолонку("Номенклатура"); 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	БП_БейджикиНоменклатурыСрезПоследних.Номенклатура,
	                      |	БП_БейджикиНоменклатурыСрезПоследних.БейджикиТекст,
	                      |	БП_БейджикиНоменклатурыСрезПоследних.БейджикиJSON
	                      |ИЗ
	                      |	РегистрСведений.БП_БейджикиНоменклатуры.СрезПоследних(
	                      |			&Дата,
	                      |			ТипЦеныРасчета = &ТипЦеныРасчета
	                      |				И Номенклатура В (&МассивНоменклатури)) КАК БП_БейджикиНоменклатурыСрезПоследних");
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ТипЦеныРасчета", ТипЦеныРасчета);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);   
	
	ТЗБейджики = Запрос.Выполнить().Выгрузить(); 

	
	Запрос = Новый Запрос("ВЫБРАТЬ 
	                      |	БП_РейтингНоменклатуры.Номенклатура,
	                      |	БП_РейтингНоменклатуры.Рейтинг
	                      |ИЗ
	                      |	РегистрСведений.БП_РейтингНоменклатуры.СрезПоследних(&Дата, ТипЦеныРасчета = &ТипЦеныРасчета И Номенклатура В (&МассивНоменклатури) И Регистратор <> &Ссылка) КАК БП_РейтингНоменклатуры
	                      |ГДЕ
	                      |	БП_РейтингНоменклатуры.Регистратор.Ссылка <> &Ссылка");
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ТипЦеныРасчета", ТипЦеныРасчета);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);
	Запрос.УстановитьПараметр("Ссылка", Ссылка); 
	
	ТЗСтарыйРейтинг = Запрос.Выполнить().Выгрузить();  
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	                      |	ЦеныНоменклатурыСрезПоследних.Цена
	                      |ИЗ
	                      |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	                      |			&Дата,
	                      |			Номенклатура В (&МассивНоменклатури)
	                      |				И ТипЦен = &ТипЦеныРасчета) КАК ЦеныНоменклатурыСрезПоследних");
	Запрос.УстановитьПараметр("ТипЦеныРасчета", ТипЦеныРасчета);
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);

	ТЗЦена = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос("ВЫБРАТЬ 
	                      |	ДатыПроизводстваСрезПоследних.Номенклатура,
	                      |	ДатыПроизводстваСрезПоследних.Поставщик,
	                      |	ДатыПроизводстваСрезПоследних.ДатаПроизводства,
	                      |	ДатыПроизводстваСрезПоследних.Страна
	                      |ИЗ
	                      |	РегистрСведений.ДатыПроизводства.СрезПоследних(&Дата, Номенклатура В (&МассивНоменклатури)) КАК ДатыПроизводстваСрезПоследних");
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);
 
	ТЗДатыПроизводства = Запрос.Выполнить().Выгрузить(); 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТоварыНаСкладахОстатки.Номенклатура,
	                      |	СУММА(ТоварыНаСкладахОстатки.КоличествоОстаток) КАК КоличествоОстаток
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, Номенклатура В (&МассивНоменклатури)) КАК ТоварыНаСкладахОстатки
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ТоварыНаСкладахОстатки.Номенклатура");
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);
 
	ТЗОстаток = Запрос.Выполнить().Выгрузить(); 
	

	СтараяЦена = ТипЦеныРасчета.ТипСтаройЦены; 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Дата,
	|			Номенклатура В (&МассивНоменклатури)
	|				И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних"); 
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);
	Запрос.УстановитьПараметр("ТипЦен", СтараяЦена);
	
	ТЗСтараяЦена = Запрос.Выполнить().Выгрузить(); 

	МассивТоваровДляОтправки = Новый Массив;
	МаксКоличествоВПакете = Константы.MagentoКочествоПозицыйВПакетнойВыгрузке.Получить();
	
	Для каждого Стр из Товары цикл
			
		СтруктураОтправки_category = Новый Структура;
		МассивРеквизитовКОтправке = Новый Массив;  
		МассивСортировок = Новый Массив;
		СтруктураОтправки_category.Вставить("sku", Стр.Номенклатура.Код);
		СтруктураОтправки_category.Вставить("erp_id", Стр.Номенклатура.Код);
		
		НайденнаяСтрока = ТЗСтарыйРейтинг.Найти(Стр.Номенклатура, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			rating_old = 0;
		Иначе
			rating_old = НайденнаяСтрока.Рейтинг;
		КонецЕсли;
		
		Если rating_old = Стр.Рейтинг тогда
			Продолжить;
		КонецЕсли; 
		
		НайденнаяСтрока = ТЗБейджики.Найти(Стр.Номенклатура, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			МассивБейджиковНаименования = Новый Массив;
		Иначе
			БейджикиJSON = НайденнаяСтрока.БейджикиJSON;
			Результат = Новый ЧтениеJSON;
			Результат.УстановитьСтроку(БейджикиJSON);
			Данные = ПрочитатьJSON(Результат);

			МассивБейджиковНаименования = Новый Массив;
			Для каждого Стр1 из Данные цикл
				МассивБейджиковНаименования.Добавить(Стр1.Наименование);	
			КонецЦикла;
		КонецЕсли;

		
		//НайденнаяСтрока = ТЗОстаток.Найти(Стр.Номенклатура, "Номенклатура");
		//Если НайденнаяСтрока = Неопределено Тогда
		//	qty = 0;
		//Иначе
		//	qty = НайденнаяСтрока.КоличествоОстаток;
		//КонецЕсли; 
		
		НайденнаяСтрока = ТЗЦена.Найти(Стр.Номенклатура, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			Цена = 0;
		Иначе
			Цена = НайденнаяСтрока.Цена;
		КонецЕсли; 
		
		ДатаПроизводства = ""; 
		Страна = "";
		price = 0;  
		qty = 0;  
		
		ТЗИнфо = БП_ОбменMagento.ПоказатьЦеныПоставщика(Стр.Номенклатура,ТипЦеныРасчета);
		Если ТЗИнфо.Количество() > 0 Тогда
			ДатаПроизводства = ТЗИнфо[0].ДатаПроизводства; 
			Страна = ТЗИнфо[0].Страна;   
			price = ТЗИнфо[0].ЦенаПродажи;
			qty = ТЗИнфо.Итог("Количество");
		КонецЕсли; 
		
		Если qty = Неопределено тогда 
			qty = 0;
		КонецЕсли;  
		
		
		НайденнаяСтрока = ТЗСтараяЦена.Найти(Стр.Номенклатура, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			price_old = 0;
		Иначе
			price_old = НайденнаяСтрока.Цена;
		КонецЕсли;



		
		
		//Отбор = Новый Структура("Номенклатура, Поставщик",Стр.Номенклатура, Стр.Поставщик);
		//Строки = ТЗДатыПроизводства.НайтиСтроки(Отбор);
		//Если Строки.Количество() > 0 Тогда
		//	ДатаПроизводства = Строки[0].ДатаПроизводства; 
		//	Страна = Строки[0].Страна;
		//КонецЕсли; 
		
		МассивСортировок.Добавить(Новый Структура("code, rating", "Popular", Стр.Рейтинг));		
		
		//СтруктураОтправки_category.Вставить("name", Источник.Наименование);	
		СтруктураОтправки_category.Вставить("price_old", price_old);  
		СтруктураОтправки_category.Вставить("price_new", price); 
		СтруктураОтправки_category.Вставить("qty", qty);
		СтруктураОтправки_category.Вставить("currency", "UAH"); 
		СтруктураОтправки_category.Вставить("sort_options", МассивСортировок);
		
		
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","producer_country",Страна));
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","manufacturer_year",ДатаПроизводства));
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value", "labels", МассивБейджиковНаименования));

		СтруктураОтправки_category.Вставить("attributes_values", МассивРеквизитовКОтправке); 
		
		МассивТоваровДляОтправки.Добавить(СтруктураОтправки_category);
		
		
		
		КоличествоВПакете = МассивТоваровДляОтправки.Количество();
		
		Если КоличествоВПакете >= МаксКоличествоВПакете тогда
			
			UUID_ = Новый УникальныйИдентификатор;
			request_id = НРег(СтрЗаменить(Строка(UUID_), "-", ""));
			
			СтруктураОтправки = Новый Структура;      
			СтруктураОтправки.Вставить("request_id", request_id);
			СтруктураОтправки.Вставить("products", МассивТоваровДляОтправки);
			СтруктураОтправки.Вставить("count", КоличествоВПакете);	
			
			БП_ОбменMagento.УстановкаЦенНоменклатуриОтправить(СтруктураОтправки); 
			
			МассивТоваровДляОтправки.Очистить(); 
		КонецЕсли;

		
	КонецЦикла; 
	
	КоличествоТоваровДляОтправки = МассивТоваровДляОтправки.Количество();	
	
	Если КоличествоТоваровДляОтправки тогда
		UUID_ = Новый УникальныйИдентификатор;
		request_id = НРег(СтрЗаменить(Строка(UUID_), "-", ""));
		
		СтруктураОтправки = Новый Структура;      
		СтруктураОтправки.Вставить("request_id", request_id);
		СтруктураОтправки.Вставить("products", МассивТоваровДляОтправки);
		СтруктураОтправки.Вставить("count", КоличествоТоваровДляОтправки);	
		
		БП_ОбменMagento.УстановкаЦенНоменклатуриОтправить(СтруктураОтправки); 
	КонецЕсли;
	
КонецПроцедуры  

Процедура БП_ВыполнитьОтправкуНаСайтБейджиков(Дата,ТипЦеныРасчета,Ссылка) Экспорт 
	Товары = Ссылка.Товары;    
	Номенклатура = Новый Массив;
	НовыйНабор = Новый Соответствие;
	Для Каждого Строка Из Товары Цикл
		
		// Проверка наличия ключа
		МассивБейджиков = НовыйНабор.Получить(Строка.Номенклатура);
		Если МассивБейджиков = Неопределено Тогда
			МассивБейджиков = Новый Массив;
			НовыйНабор.Вставить(Строка.Номенклатура, МассивБейджиков);
			Номенклатура.Добавить(Строка.Номенклатура);
		КонецЕсли;
		СтруктураБейджика = Новый Структура("Код, Наименование", Строка.Бейджик.Код,Строка.Бейджик.Наименование);
		МассивБейджиков.Добавить(СтруктураБейджика);
		
	КонецЦикла;
		
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	БП_БейджикиНоменклатурыСрезПоследних.Номенклатура,
	                      |	БП_БейджикиНоменклатурыСрезПоследних.БейджикиТекст,
	                      |	БП_БейджикиНоменклатурыСрезПоследних.БейджикиJSON
	                      |ИЗ
	                      |	РегистрСведений.БП_БейджикиНоменклатуры.СрезПоследних(
	                      |			&Дата,
	                      |			ТипЦеныРасчета = &ТипЦеныРасчета
	                      |				И Номенклатура В (&МассивНоменклатури) И Регистратор <> &Ссылка) КАК БП_БейджикиНоменклатурыСрезПоследних");
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ТипЦеныРасчета", ТипЦеныРасчета);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);   
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	
	ТЗБейджики = Запрос.Выполнить().Выгрузить(); 
	
	Запрос = Новый Запрос("ВЫБРАТЬ 
	                      |	БП_РейтингНоменклатуры.Номенклатура,
	                      |	БП_РейтингНоменклатуры.Рейтинг
	                      |ИЗ
	                      |	РегистрСведений.БП_РейтингНоменклатуры.СрезПоследних(&Дата, ТипЦеныРасчета = &ТипЦеныРасчета И Номенклатура В (&МассивНоменклатури)) КАК БП_РейтингНоменклатуры");
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ТипЦеныРасчета", ТипЦеныРасчета);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);
	
	ТЗРейтинг = Запрос.Выполнить().Выгрузить();  
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	                      |	ЦеныНоменклатурыСрезПоследних.Цена
	                      |ИЗ
	                      |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	                      |			&Дата,
	                      |			Номенклатура В (&МассивНоменклатури)
	                      |				И ТипЦен = &ТипЦеныРасчета) КАК ЦеныНоменклатурыСрезПоследних");
	Запрос.УстановитьПараметр("ТипЦеныРасчета", ТипЦеныРасчета);
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);

	ТЗЦена = Запрос.Выполнить().Выгрузить();
	
	Запрос = Новый Запрос("ВЫБРАТЬ 
	                      |	ДатыПроизводстваСрезПоследних.Номенклатура,
	                      |	ДатыПроизводстваСрезПоследних.Поставщик,
	                      |	ДатыПроизводстваСрезПоследних.ДатаПроизводства,
	                      |	ДатыПроизводстваСрезПоследних.Страна
	                      |ИЗ
	                      |	РегистрСведений.ДатыПроизводства.СрезПоследних(&Дата, Номенклатура В (&МассивНоменклатури)) КАК ДатыПроизводстваСрезПоследних");
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);
 
	ТЗДатыПроизводства = Запрос.Выполнить().Выгрузить(); 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТоварыНаСкладахОстатки.Номенклатура,
	                      |	СУММА(ТоварыНаСкладахОстатки.КоличествоОстаток) КАК КоличествоОстаток
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, Номенклатура В (&МассивНоменклатури)) КАК ТоварыНаСкладахОстатки
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ТоварыНаСкладахОстатки.Номенклатура");
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);
 
	ТЗОстаток = Запрос.Выполнить().Выгрузить(); 
	

	СтараяЦена = ТипЦеныРасчета.ТипСтаройЦены; 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Дата,
	|			Номенклатура В (&МассивНоменклатури)
	|				И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних"); 
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);
	Запрос.УстановитьПараметр("ТипЦен", СтараяЦена);
	
	ТЗСтараяЦена = Запрос.Выполнить().Выгрузить(); 

	МассивТоваровДляОтправки = Новый Массив;
	СписокНоменклатур = Новый Массив; 
	МаксКоличествоВПакете = Константы.MagentoКочествоПозицыйВПакетнойВыгрузке.Получить();

	Для Каждого Номенклатура Из НовыйНабор Цикл
		СписокНоменклатур.Добавить(Номенклатура.Ключ);
		
		МассивБейджиковНаименования = Новый Массив;
		БейджикиТекст = "";
		Для каждого СтрБ из Номенклатура.Значение цикл
			БейджикиТекст = ?(БейджикиТекст = "", СтрБ.Наименование,БейджикиТекст + ", " + СтрБ.Наименование);
			МассивБейджиковНаименования.Добавить(СтрБ.Наименование); 
		КонецЦикла;
		
		НайденнаяСтрока = ТЗБейджики.Найти(Номенклатура.Ключ, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			БейджикиТекст_олд = "";
		Иначе
			БейджикиТекст_олд = НайденнаяСтрока.БейджикиТекст;
		КонецЕсли;

		
		Если БейджикиТекст = БейджикиТекст_олд тогда
			Продолжить;	
		КонецЕсли;
		
		СтруктураОтправки_category = Новый Структура;
		МассивРеквизитовКОтправке = Новый Массив;  
		МассивСортировок = Новый Массив;
		СтруктураОтправки_category.Вставить("sku", Номенклатура.Ключ.Код);
		СтруктураОтправки_category.Вставить("erp_id", Номенклатура.Ключ.Код);
		
		НайденнаяСтрока = ТЗРейтинг.Найти(Номенклатура.Ключ, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			rating = 0;
		Иначе
			rating = НайденнаяСтрока.Рейтинг;
		КонецЕсли;
				
		//НайденнаяСтрока = ТЗОстаток.Найти(Номенклатура.Ключ, "Номенклатура");
		//Если НайденнаяСтрока = Неопределено Тогда
		//	qty = 0;
		//Иначе
		//	qty = НайденнаяСтрока.КоличествоОстаток;
		//КонецЕсли; 
		
		НайденнаяСтрока = ТЗЦена.Найти(Номенклатура.Ключ, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			Цена = 0;
		Иначе
			Цена = НайденнаяСтрока.Цена;
		КонецЕсли; 
		
		ДатаПроизводства = ""; 
		Страна = "";
		price = 0;  
		qty = 0;  
		
		ТЗИнфо = БП_ОбменMagento.ПоказатьЦеныПоставщика(Номенклатура.Ключ, ТипЦеныРасчета);
		Если ТЗИнфо.Количество() > 0 Тогда
			ДатаПроизводства = ТЗИнфо[0].ДатаПроизводства; 
			Страна = ТЗИнфо[0].Страна;   
			price = ТЗИнфо[0].ЦенаПродажи;
			qty = ТЗИнфо.Итог("Количество");
		КонецЕсли; 
		
		Если qty = Неопределено тогда 
			qty = 0;
		КонецЕсли;  
		
		
		НайденнаяСтрока = ТЗСтараяЦена.Найти(Номенклатура.Ключ, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			price_old = 0;
		Иначе
			price_old = НайденнаяСтрока.Цена;
		КонецЕсли; 
		
		МассивСортировок.Добавить(Новый Структура("code, rating", "Popular", rating));		
			
		СтруктураОтправки_category.Вставить("price_old", price_old);  
		СтруктураОтправки_category.Вставить("price_new", price); 
		СтруктураОтправки_category.Вставить("qty", qty);
		СтруктураОтправки_category.Вставить("currency", "UAH"); 
		СтруктураОтправки_category.Вставить("sort_options", МассивСортировок);
		
		
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","producer_country",Страна));
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","manufacturer_year",ДатаПроизводства));
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value", "labels", МассивБейджиковНаименования));
		СтруктураОтправки_category.Вставить("attributes_values", МассивРеквизитовКОтправке); 
		
		МассивТоваровДляОтправки.Добавить(СтруктураОтправки_category);

		КоличествоВПакете = МассивТоваровДляОтправки.Количество();
		
		Если КоличествоВПакете >= МаксКоличествоВПакете тогда
			UUID_ = Новый УникальныйИдентификатор;
			request_id = НРег(СтрЗаменить(Строка(UUID_), "-", ""));

			СтруктураОтправки = Новый Структура;          
			СтруктураОтправки.Вставить("request_id", request_id);
			СтруктураОтправки.Вставить("products", МассивТоваровДляОтправки);
			СтруктураОтправки.Вставить("count", КоличествоВПакете);	
			
			БП_ОбменMagento.УстановкаЦенНоменклатуриОтправить(СтруктураОтправки); 
			
			МассивТоваровДляОтправки.Очистить(); 
		КонецЕсли;

		
	КонецЦикла; 
	
	КоличествоТоваровДляОтправки = МассивТоваровДляОтправки.Количество();	
	
	Если КоличествоТоваровДляОтправки тогда 
		UUID_ = Новый УникальныйИдентификатор;
		request_id = НРег(СтрЗаменить(Строка(UUID_), "-", ""));
       		
		СтруктураОтправки = Новый Структура;      
		СтруктураОтправки.Вставить("request_id", request_id);
		СтруктураОтправки.Вставить("products", МассивТоваровДляОтправки);
		СтруктураОтправки.Вставить("count", КоличествоТоваровДляОтправки);	
		
		БП_ОбменMagento.УстановкаЦенНоменклатуриОтправить(СтруктураОтправки); 
	КонецЕсли;
		
КонецПроцедуры  

