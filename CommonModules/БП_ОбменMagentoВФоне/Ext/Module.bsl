	                      |	ДатыПроизводстваСрезПоследних.Поставщик,
	                      |	ДатыПроизводстваСрезПоследних.ДатаПроизводства,
	                      |	ДатыПроизводстваСрезПоследних.Страна
	                      |ИЗ
	                      |	РегистрСведений.ДатыПроизводства.СрезПоследних(&Дата, Номенклатура В (&МассивНоменклатури)) КАК ДатыПроизводстваСрезПоследних");
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);
 
	ТЗДатыПроизводства = Запрос.Выполнить().Выгрузить(); 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТоварыНаСкладахОстатки.Номенклатура,
	                      |	СУММА(ТоварыНаСкладахОстатки.КоличествоОстаток) КАК КоличествоОстаток
	                      |ИЗ
	                      |	РегистрНакопления.ТоварыНаСкладах.Остатки(&Дата, Номенклатура В (&МассивНоменклатури)) КАК ТоварыНаСкладахОстатки
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ТоварыНаСкладахОстатки.Номенклатура");
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);
 
	ТЗОстаток = Запрос.Выполнить().Выгрузить(); 
	
	
	СтараяЦена = ТипЦен.ТипСтаройЦены; 
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Дата,
	|			Номенклатура В (&МассивНоменклатури)
	|				И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних"); 
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("МассивНоменклатури", Номенклатура);
	Запрос.УстановитьПараметр("ТипЦен", СтараяЦена);
	
	ТЗСтараяЦена = Запрос.Выполнить().Выгрузить(); 
	
	МассивТоваровДляОтправки = Новый Массив;
	МаксКоличествоВПакете = Константы.MagentoКочествоПозицыйВПакетнойВыгрузке.Получить();
	
	Для каждого Стр из Товары цикл
			
		СтруктураОтправки_category = Новый Структура;
		МассивРеквизитовКОтправке = Новый Массив;  
		МассивСортировок = Новый Массив;
		СтруктураОтправки_category.Вставить("sku", Стр.Номенклатура.Код);
		СтруктураОтправки_category.Вставить("erp_id", Стр.Номенклатура.Код);  
		
		НайденнаяСтрока = ТЗПредыдущаяЦена.Найти(Стр.Номенклатура, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			price_old = 0;
		Иначе
			price_old = НайденнаяСтрока.Цена;
		КонецЕсли;
		
		Если price_old = Стр.Цена тогда
			Продолжить;
		КонецЕсли;
		//
		//НайденнаяСтрока = ТЗОстаток.Найти(Стр.Номенклатура, "Номенклатура");
		//Если НайденнаяСтрока = Неопределено Тогда
		//	qty = 0;
		//Иначе
		//	qty = НайденнаяСтрока.КоличествоОстаток;
		//КонецЕсли;  
		
		НайденнаяСтрока = ТЗБейджики.Найти(Стр.Номенклатура, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			МассивБейджиковНаименования = Новый Массив;
		Иначе
			БейджикиJSON = НайденнаяСтрока.БейджикиJSON;
			Результат = Новый ЧтениеJSON;
			Результат.УстановитьСтроку(БейджикиJSON);
			Данные = ПрочитатьJSON(Результат);
			
			МассивБейджиковНаименования = Новый Массив;
			Для каждого Стр1 из Данные цикл
				МассивБейджиковНаименования.Добавить(Стр1.Наименование);	
			КонецЦикла;
		КонецЕсли;

		
		НайденнаяСтрока = ТЗСтараяЦена.Найти(Стр.Номенклатура, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			price_old = 0;
		Иначе
			price_old = НайденнаяСтрока.Цена;
		КонецЕсли;

		
		
		ДатаПроизводства = ""; 
		Страна = "";
		price = 0;  
		qty = 0;   
		
		
		Если НоменклатураКИскоючению.Найти(Стр.Номенклатура) <> Неопределено тогда
			НайденнаяСтрока = ТЗОстаток.Найти(Стр.Номенклатура, "Номенклатура");
			Если НайденнаяСтрока = Неопределено Тогда
				qty = 0;
			Иначе
				qty = НайденнаяСтрока.КоличествоОстаток;
			КонецЕсли;  	
			
		Иначе		
			ТЗИнфо = БП_ОбменMagento.ПоказатьЦеныПоставщика(Стр.Номенклатура, ТипЦен);
			Если ТЗИнфо.Количество() > 0 Тогда
				ДатаПроизводства = ТЗИнфо[0].ДатаПроизводства; 
				Страна = ТЗИнфо[0].Страна;   
				price = ТЗИнфо[0].ЦенаПродажи;
				qty = ТЗИнфо.Итог("Количество");
			КонецЕсли; 			
		КонецЕсли;
		
		Если qty = Неопределено тогда 
			qty = 0;
		КонецЕсли;   
		
		Если price = 0 тогда
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
			|	ЦеныНоменклатурыСрезПоследних.Цена
			|ИЗ
			|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
			|			,
			|			Номенклатура В (&МассивНоменклатури)
			|				И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних"); 
			
			//Запрос.УстановитьПараметр("Дата", ТекущаяДата());
			Запрос.УстановитьПараметр("МассивНоменклатури", Стр.Номенклатура);
			Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
			
			ТЗЗапаснаяЦена = Запрос.Выполнить().Выгрузить();
			
			Если ТЗЗапаснаяЦена.Количество() тогда
				price = ТЗЗапаснаяЦена[0].Цена;	
			КонецЕсли;	
		КонецЕсли;


		
		НайденнаяСтрока = ТЗРейтинг.Найти(Стр.Номенклатура, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			raiting = 0;
		Иначе
			raiting = НайденнаяСтрока.Рейтинг;
		КонецЕсли;

		
		
		//Отбор = Новый Структура("Номенклатура, Поставщик",Стр.Номенклатура, Стр.Поставщик);
		//Строки = ТЗДатыПроизводства.НайтиСтроки(Отбор);
		//Если Строки.Количество() > 0 Тогда
		//	ДатаПроизводства = Строки[0].ДатаПроизводства; 
		//	Страна = Строки[0].Страна;
		//КонецЕсли;
		
		МассивСортировок.Добавить(Новый Структура("code, rating", "Popular", raiting));
		
		//СтруктураОтправки_category.Вставить("name", Источник.Наименование);	
		СтруктураОтправки_category.Вставить("price_old", price_old);  
		СтруктураОтправки_category.Вставить("price_new", price); 
		СтруктураОтправки_category.Вставить("qty", qty);
		СтруктураОтправки_category.Вставить("currency", "UAH"); 
		СтруктураОтправки_category.Вставить("sort_options", МассивСортировок);
		
		
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","producer_country",Страна));
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","manufacturer_year",ДатаПроизводства));  
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value", "labels", МассивБейджиковНаименования));
		СтруктураОтправки_category.Вставить("attributes_values", МассивРеквизитовКОтправке); 
		
		МассивТоваровДляОтправки.Добавить(СтруктураОтправки_category);

		КоличествоВПакете = МассивТоваровДляОтправки.Количество();
		
		Если КоличествоВПакете >= МаксКоличествоВПакете тогда
			
			UUID_ = Новый УникальныйИдентификатор;
			request_id = НРег(СтрЗаменить(Строка(UUID_), "-", ""));
			
			СтруктураОтправки = Новый Структура;      
			СтруктураОтправки.Вставить("request_id", request_id);
			СтруктураОтправки.Вставить("products", МассивТоваровДляОтправки);
			СтруктураОтправки.Вставить("count", КоличествоВПакете);	
			
			БП_ОбменMagento.УстановкаЦенНоменклатуриОтправить(СтруктураОтправки, Ссылка, MagentoID); 
			
			МассивТоваровДляОтправки.Очистить(); 
		КонецЕсли;
		
		
	КонецЦикла; 
	
	КоличествоТоваровДляОтправки = МассивТоваровДляОтправки.Количество();	
	
	Если КоличествоТоваровДляОтправки тогда
		UUID_ = Новый УникальныйИдентификатор;
		request_id = НРег(СтрЗаменить(Строка(UUID_), "-", ""));
       		
		СтруктураОтправки = Новый Структура;      
		СтруктураОтправки.Вставить("request_id", request_id);
		СтруктураОтправки.Вставить("products", МассивТоваровДляОтправки);
		СтруктураОтправки.Вставить("count", КоличествоТоваровДляОтправки);	
		
		БП_ОбменMagento.УстановкаЦенНоменклатуриОтправить(СтруктураОтправки, Ссылка, MagentoID); 
	КонецЕсли;
	
	
КонецПроцедуры

Процедура MagentoПередЗаписьюНоменклатурыВФоне(Источник, Отказ) Экспорт
	
	Если Отказ  тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Источник.MagentoID) тогда
		
		АдресМетода = "/erp/products";
		
		Если Не ЗначениеЗаполнено(Источник.Код) тогда
			Источник.УстановитьНовыйКод();
		КонецЕсли; 
				
		ДатаПроизводства = ""; 
		Страна = "";
		price = 0;  
		qty = 0;  
		
		ТЗИнфо = БП_ОбменMagento.ПоказатьЦеныПоставщика(Источник.Ссылка);
		Если ТЗИнфо.Количество() > 0 Тогда
			ДатаПроизводства = ТЗИнфо[0].ДатаПроизводства; 
			Страна = ТЗИнфо[0].Страна;   
			price = ТЗИнфо[0].ЦенаПродажи;
			qty = ТЗИнфо.Итог("Количество");
		КонецЕсли; 
		
		Если qty = Неопределено тогда 
			qty = 0;
		КонецЕсли;
		
		

		
		МассивРеквизитовКОтправке = Новый Массив;

		МассивКатегорий = Новый Массив;
		СтруктураОтправки_category = Новый Структура;
		МассивРеквизитовКОтправке = БП_ОбменMagento.ПолучитьЗначенияРевизитовПоВидуНоменклутри(Источник, Источник.ВидНоменклатуры);
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","producer_country",Страна));
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","manufacturer_year",ДатаПроизводства));

		СтруктураОтправки_category.Вставить("sku", Источник.Код);
		СтруктураОтправки_category.Вставить("erp_id", Источник.Код);	
		СтруктураОтправки_category.Вставить("name", Источник.Наименование);	
		СтруктураОтправки_category.Вставить("price", price);
		СтруктураОтправки_category.Вставить("attribute_set_erp_id", Источник.ВидНоменклатуры.Код);
		СтруктураОтправки_category.Вставить("stock_item",Новый Структура("qty, is_in_stock",qty,true));     
		
		СтруктураОтправки_category.Вставить("attributes_values", МассивРеквизитовКОтправке); 
		СтруктураОтправки_category.Вставить("categories_erp_ids", МассивКатегорий);
		
		
		
		

		        
				
		СтруктураОтправки = Новый Структура;
		СтруктураОтправки.Вставить("product", СтруктураОтправки_category);			
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураОтправки);
		СтруктураОтправкиJSON = ЗаписьJSON.Закрыть();
		
		Заголовки = Новый Соответствие;
		
		Результат = БП_ОбменMagento.ВыполнитьОтправкуНаСайт(АдресМетода, Заголовки, СтруктураОтправкиJSON); 
		
		Если Результат = Неопределено тогда
			Возврат;
		КонецЕсли;
		
		Если Результат.КодСостояния = 200 Тогда 
			Попытка
				РезультатJSON = Новый ЧтениеJSON;
				РезультатJSON.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
				Данные = ПрочитатьJSON(РезультатJSON);
				Источник.MagentoID = Данные.magento_id;
			Исключение
				Сообщить("Не вдалося отримати MagentoID!");
			КонецПопытки;				
		Иначе
			Сообщить("Помилка підключення! " + Результат.ПолучитьТелоКакСтроку());
		КонецЕсли;  
	
	Иначе
		
		АдресМетода = "/erp/products/" + Источник.Код;
		
		Если Не ЗначениеЗаполнено(Источник.Код) тогда
			Источник.УстановитьНовыйКод();
		КонецЕсли; 
	
		ДатаПроизводства = ""; 
		Страна = "";
		price = 0;  
		qty = 0;  
		
		ТЗИнфо = БП_ОбменMagento.ПоказатьЦеныПоставщика(Источник.Ссылка);
		Если ТЗИнфо.Количество() > 0 Тогда
			ДатаПроизводства = ТЗИнфо[0].ДатаПроизводства; 
			Страна = ТЗИнфо[0].Страна;   
			price = ТЗИнфо[0].ЦенаПродажи;
			qty = ТЗИнфо.Итог("Количество");
		КонецЕсли; 
		
		Если qty = Неопределено тогда 
			qty = 0;
		КонецЕсли;

          МассивРеквизитовКОтправке = Новый Массив; 
		  МассивКатегорий = Новый Массив;
		СтруктураОтправки_category = Новый Структура;
		МассивРеквизитовКОтправке = БП_ОбменMagento.ПолучитьЗначенияРевизитовПоВидуНоменклутри(Источник, Источник.ВидНоменклатуры); 
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","producer_country",Страна));
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","manufacturer_year",ДатаПроизводства));

		СтруктураОтправки_category.Вставить("sku", Источник.Код);
		СтруктураОтправки_category.Вставить("erp_id", Источник.Код);	
		СтруктураОтправки_category.Вставить("name", Источник.Наименование);	
		СтруктураОтправки_category.Вставить("price", price);
		СтруктураОтправки_category.Вставить("attribute_set_erp_id", Источник.ВидНоменклатуры.Код);
		СтруктураОтправки_category.Вставить("stock_item",Новый Структура("qty, is_in_stock",qty,true));     
		
		СтруктураОтправки_category.Вставить("attributes_values", МассивРеквизитовКОтправке); 
		СтруктураОтправки_category.Вставить("categories_erp_ids", МассивКатегорий);				        
				
		СтруктураОтправки = Новый Структура;
		СтруктураОтправки.Вставить("product", СтруктураОтправки_category);			
		
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, СтруктураОтправки);
		СтруктураОтправкиJSON = ЗаписьJSON.Закрыть();
		
		Заголовки = Новый Соответствие;
		
		Результат = БП_ОбменMagento.ВыполнитьОтправкуНаСайт(АдресМетода, Заголовки, СтруктураОтправкиJSON, "PUT"); 
		
		Если Результат = Неопределено тогда
			Возврат;
		КонецЕсли;
		
		Если Результат.КодСостояния = 200 Тогда 
			Попытка
				РезультатJSON = Новый ЧтениеJSON;
				РезультатJSON.УстановитьСтроку(Результат.ПолучитьТелоКакСтроку());
				Данные = ПрочитатьJSON(РезультатJSON);
				Источник.MagentoID = Данные.magento_id;
			Исключение
				Сообщить("Не вдалося отримати MagentoID!");
			КонецПопытки;				
		Иначе
			Сообщить("Помилка підключення! " + Результат.ПолучитьТелоКакСтроку());
		КонецЕсли;  
		
	КонецЕсли;
КонецПроцедуры      

Процедура БП_ВыполнитьОтправкуНаСайтАтрибутов(ИмяМетаданных,Иерархический, Отказ, ИмяСайта = "") Экспорт
	
	ДвойнаяЗапись = ложь;
	ТройнаяЗапись = Ложь;
	ЧетвертаяЗапись = ложь;
	
	ИмяАтрибута = "";
	attribute_code = "";   
	is_filterable = false; 
	frontend_input = "select";
	//ИмяМетаданных = Источник.Метаданные().Имя;
	Если ИмяМетаданных = "Ширина" тогда            
		ИмяАтрибута = "Ширина";
		attribute_code = "width"; 
		is_filterable = true; 
		frontend_input = "select";    
		// + Аккумуляторы  
	ИначеЕсли ИмяМетаданных = "Емкости" тогда  
		ИмяАтрибута = "Емкость";
		attribute_code = "emkost"; 
		is_filterable = true; 
		frontend_input = "select"; 
	ИначеЕсли ИмяМетаданных = "ПусковыеТоки" тогда  
		ИмяАтрибута = "ПусковойТок";
		attribute_code = "puskovoy_tok"; 
		is_filterable = true; 
		frontend_input = "select"; 
	ИначеЕсли ИмяМетаданных = "Полярности" тогда  
		ИмяАтрибута = "Полярность";
		attribute_code = "polyarnost"; 
