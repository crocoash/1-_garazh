Процедура БП_ОбработкаОчередиОтправкиНаСайт() Экспорт 
	Возврат; // не актуально	
	ionity = Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("ionity.tires",,,);
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	БП_MagentoОчередьУстановкаЦенНоменклатуры.Документ,
	                      |	БП_MagentoОчередьУстановкаЦенНоменклатуры.Статус,
	                      |	БП_MagentoОчередьУстановкаЦенНоменклатуры.ОтправленоОповещениеОбОшыбке
	                      |ИЗ
	                      |	РегистрСведений.БП_MagentoОчередьУстановкаЦенНоменклатуры КАК БП_MagentoОчередьУстановкаЦенНоменклатуры
	                      |ГДЕ
	                      |	БП_MagentoОчередьУстановкаЦенНоменклатуры.Статус <> &Статус
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	БП_MagentoОчередьУстановкаЦенНоменклатуры.ДатаДобавленияВОчередь");
	
	Запрос.УстановитьПараметр("Статус", Перечисления.БП_СтатусОтправкиСообщения.Отправлено);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() цикл
		Если Выборка.Статус = Перечисления.БП_СтатусОтправкиСообщения.ВОбработке тогда
			Прервать;
		КонецЕсли; 

		Если Выборка.Статус = Перечисления.БП_СтатусОтправкиСообщения.НеОтправлено тогда 
			Если НЕ Выборка.ОтправленоОповещениеОбОшыбке тогда
				ВыполнитьОтправкуСообщения(Выборка.Документ);	
			КонецЕсли;
			Прервать;
		КонецЕсли; 

		
		
		ЭтоЦеныНомеклатуры = Истина;
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(Выборка.Документ.Дата);
		МассивПараметров.Добавить(ionity);
		МассивПараметров.Добавить(Выборка.Документ); 
		МассивПараметров.Добавить(ЭтоЦеныНомеклатуры);
		ФоновыеЗадания.Выполнить("БП_ОбменMagentoВФоне.БП_ВыполнитьОтправкуНаСайтЦеныНоменклатуры", МассивПараметров,,"ОтправкаЦенНоменклатурыНаСайт");		
		
	КонецЦикла;
КонецПроцедуры    

Процедура ВыполнитьОтправкуСообщения(Ссылка)
	ЭлектронныеПисьма = Новый Соответствие;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	БП_СообщениеДляАдминистратораMagento.Ссылка,
	                      |	БП_СообщениеДляАдминистратораMagento.ПочтаПолучателя
	                      |ИЗ
	                      |	Справочник.БП_СообщениеДляАдминистратораMagento КАК БП_СообщениеДляАдминистратораMagento
	                      |ГДЕ
	                      |	НЕ БП_СообщениеДляАдминистратораMagento.ПометкаУдаления
	                      |	И БП_СообщениеДляАдминистратораMagento.Отправлять");
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Пока Выборка.Следующий() цикл
		СтруктураВложений  = Новый СписокЗначений; 
		
		Адрес = Выборка.ПочтаПолучателя;
		
		СписокАдресов = Новый СписокЗначений;
		Если НЕ Адрес = Неопределено Тогда
			СписокАдресов.Добавить(Адрес, Адрес);
		КонецЕсли;
		
		ТекстПисьма = "Не вдалося виконати відправку на сайт документ " + Строка(Ссылка);  
		ТекстПисьмаHTML = "<HTML><HEAD><META http-equiv=Content-Type content=""text/html; charset=utf-8""><META content=""MSHTML 6.00.2800.1476"" name=GENERATOR></HEAD><BODY><P>";
		ТекстПисьмаHTML = ТекстПисьмаHTML + СтрЗаменить(ТекстПисьма, Символы.ПС, "</P><P>");
		ТекстПисьмаHTML = ТекстПисьмаHTML + "</P></BODY></HTML>"; 
		
		СтруктураНовогоПисьма                      = Новый Структура("Тело, Тема, СписокФайловВложений, Кому");
		СтруктураНовогоПисьма.СписокФайловВложений = СтруктураВложений;
		СтруктураНовогоПисьма.Тело                 = ТекстПисьмаHTML;
		СтруктураНовогоПисьма.Тема                 = "Magento! Не вдалося виконати відправку на сайт!";
		СтруктураНовогоПисьма.Кому                 = СписокАдресов;
		
		СтруктураПисьма = УправлениеЭлектроннойПочтой.НаписатьПисьмо(глЗначениеПеременной("глТекущийПользователь"), СтруктураНовогоПисьма, , , , , ,Истина , ЛОЖЬ);
		
		Если ТипЗнч(СтруктураПисьма) = Тип("Структура") Тогда
			ЭлектронныеПисьма.Вставить(СтруктураПисьма.ПисьмоСсылка,);
		КонецЕсли; 
		
	КонецЦикла;
	
	Если ЭлектронныеПисьма.Количество() тогда
		УправлениеЭлектроннойПочтой.ОтправитьПисьма(ЭлектронныеПисьма, глЗначениеПеременной("глСоответствиеТекстовЭлектронныхПисем"), глЗначениеПеременной("глТекущийПользователь"));
	КонецЕсли;
	
	//Запись = РегистрыСведений.БП_MagentoОчередьУстановкаЦенНоменклатуры.СоздатьМенеджерЗаписи();
	//Запись.Документ = Ссылка;
	//Запись.Прочитать();
	//Если Запись.Выбран() Тогда
	//	Запись.ОтправленоОповещениеОбОшыбке = Истина;
	//	Запись.Записать();
	//КонецЕсли;
	
КонецПроцедуры

Процедура БП_ПовторнаяОтправкаНоменклатурыНаСайт() Экспорт
	
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	БП_MagentoСтатусыОтправленойНоменклатуры.Номенклатура
	                      |ИЗ
	                      |	РегистрСведений.БП_MagentoСтатусыОтправленойНоменклатуры КАК БП_MagentoСтатусыОтправленойНоменклатуры
	                      |ГДЕ
	                      |	НЕ БП_MagentoСтатусыОтправленойНоменклатуры.Успешно
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	БП_MagentoСтатусыОтправленойНоменклатуры.Номенклатура"); 
	
	ТЗ_Ionity = Запрос.Выполнить().Выгрузить();
	
	МассивТоваровДляОтправки = Новый Массив;
	МассивТоваровДляОтправкиGarazh = Новый Массив;	
	
	
	МаксКоличествоВПакете = Константы.MagentoКочествоПозицыйВПакетнойВыгрузке.Получить();;
	НомерПакета = 1;  
	КоличествоВПакете = 0;	
	Для каждого Стр из ТЗ_Ionity Цикл
		
		КоличествоВПакете = КоличествоВПакете + 1;
				
		СтруктураОтправки_category = БП_ОбменMagento.MagentoМасоваяВыгрузкаНоменклатурыДляАсинхронойОтправки(Стр.Номенклатура, ложь, "MagentoID");		
		
		МассивТоваровДляОтправки.Добавить(СтруктураОтправки_category);

		Если КоличествоВПакете >= МаксКоличествоВПакете тогда			
			ВыполнитьОтправкуПакета(МассивТоваровДляОтправки,МассивТоваровДляОтправкиGarazh, НомерПакета);
			КоличествоВПакете = 0;
			МассивТоваровДляОтправки.Очистить(); 
			НомерПакета = НомерПакета + 1;
		КонецЕсли;
		
	КонецЦикла;  
	
	Если ТЗ_Ionity.Количество() тогда
		НаборЗаписей = РегистрыСведений.БП_MagentoСтатусыОтправленойНоменклатуры.СоздатьНаборЗаписей(); 
		НаборЗаписей.Записать();         
	КонецЕсли;
	
	ВыполнитьОтправкуПакета(МассивТоваровДляОтправки,МассивТоваровДляОтправкиGarazh, НомерПакета);	
КонецПроцедуры   

Процедура ВыполнитьОтправкуПакета(МассивТоваровДляОтправки,МассивТоваровДляОтправкиGarazh, НомерПакета, MagentoID = "MagentoID", Документ = Неопределено)
	
	КоличествоТоваровДляОтправки = МассивТоваровДляОтправки.Количество();	
	
	Если КоличествоТоваровДляОтправки тогда  
		
		UUID_ = Новый УникальныйИдентификатор;
		request_id = НРег(СтрЗаменить(Строка(UUID_), "-", ""));
       		
		СтруктураОтправки = Новый Структура;      
		СтруктураОтправки.Вставить("request_id", request_id);   
		СтруктураОтправки.Вставить("count", КоличествоТоваровДляОтправки);
		СтруктураОтправки.Вставить("products", МассивТоваровДляОтправки);
				 
		БП_ОбменMagento.УстановкаЦенНоменклатуриОтправить(СтруктураОтправки, Документ, MagentoID);
	КонецЕсли;	
КонецПроцедуры


