	Иначе
		ИмяФайлаОтвета = КаталогВременныхФайлов() + "answ_status.json";
	КонецЕсли;

	
	Соединение = СоздатьHTTPСоединение(НастройкиПодключений);
	
	
	ЗаписьДЖС = Новый ЗаписьJSON;
	ЗаписьДЖС.ПроверятьСтруктуру = Истина;
	ПараметрыЗаписиДЖС = Новый ПараметрыЗаписиJSON(,Символы.Таб);
	ЗаписьДЖС.ОткрытьФайл(ИмяИсходящегоФайла,КодировкаТекста.UTF8,Ложь,ПараметрыЗаписиДЖС);
	
	ЗаписьДЖС.ЗаписатьНачалоОбъекта();
	ЗаписьДЖС.ЗаписатьИмяСвойства("messages");
	ЗаписьДЖС.ЗаписатьНачалоМассива();
	ЗаписьДЖС.ЗаписатьЗначение(ИД_сообщения);
	ЗаписьДЖС.ЗаписатьКонецМассива();
			
		
	ЗаписьДЖС.ЗаписатьКонецОбъекта();
	ЗаписьДЖС.Закрыть();

	
		
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Charset","UTF-8");
	Заголовки.Вставить("Authorization","Basic " + НастройкиПодключений.API_ключ);
	Заголовки.Вставить("Content-Type","application/json");

	
	ОтветСервера = Соединение.ОтправитьДляОбработки(ИмяИсходящегоФайла, НастройкиПодключений.МетодДляПроверкиСтатусаДостаки, ИмяФайлаОтвета, Заголовки);

	
	ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
	
	Если ФайлОтвета.Существует() Тогда
		
		ТекстОтвета = Новый ТекстовыйДокумент();
		ТекстОтвета.Прочитать(ИмяФайлаОтвета);
		Если ТекстОтвета.КоличествоСтрок()>0 Тогда
			ОтветСервера = ТекстОтвета.ПолучитьТекст();	
		Иначе
			Т = "Получен пустой ответ сервера.";
			//Сообщить(Т);
			Рез.Вставить("Успешно",Ложь);
			Рез.Вставить("Сообщение",Т);
			Рез.Вставить("Статус","");
			Возврат Рез;
		КонецЕсли;	
		
	Иначе	
		Т = "Ответ сервера не получен.";
		//Сообщить(Т);
		Рез.Вставить("Успешно",Ложь);
		Рез.Вставить("Сообщение",Т);
		Рез.Вставить("Статус","");
		Возврат Рез;
	КонецЕсли;
	
	
	ЧтениеДЖС = Новый ЧтениеJSON;
	ЧтениеДЖС.ОткрытьФайл(ИмяФайлаОтвета);
	Записи = ПрочитатьJSON(ЧтениеДЖС);
	Статус = ""; МассивОтвет = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если Запись.Ключ = "response_status" Тогда
			Статус = СтрЗаменить(Запись.Значение,"Delivered","Доставлено");
		КонецЕсли;
		Если Запись.Ключ = "response_result" Тогда
			МассивОтвет = Запись.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Если Не Статус = "OK" Тогда
		Рез.Вставить("Успешно",Ложь);
		Рез.Вставить("Сообщение",Статус);
		Рез.Вставить("Статус","");
		Возврат Рез;
	Иначе
		СтатусОтправки = ""; 
		Для каждого Стр_Б из МассивОтвет Цикл
			СтатусОтправки = Стр_Б.status;
		КонецЦикла;
		
		Рез.Вставить("Успешно",Истина);
		Рез.Вставить("Сообщение","");
		Рез.Вставить("Статус",СтатусОтправки);
	КонецЕсли;

	

	
	Возврат Рез;

КонецФункции

Функция СоздатьHTTPСоединение(НастройкиПодключений)
	Если НастройкиПодключений.ЗащищенноеСоединение Тогда
		Порт    = 443;
		ЗС 		= Новый ЗащищенноеСоединениеOpenSSL; 
	Иначе
		Порт    = 80;
		ЗС 		= Неопределено; 
	КонецЕсли;
	
	Адрес          = НастройкиПодключений.АдресДляПодключения;
	ИнтернетПрокси = Неопределено;
	
	Соединение = Новый HTTPСоединение(Адрес, Порт, , , ИнтернетПрокси,,ЗС);
	
	Возврат Соединение;  
КонецФункции

Функция ФайлСуществует(Знач ПутьКФайлу) Экспорт
	
	Файл = Новый Файл(ПутьКФайлу);
	Возврат Файл.Существует();
	
КонецФункции

Функция ПолучитьТекстСМС(ШаблонСМС,ДокЗаказ) Экспорт 
	ТекстШаблон = ШаблонСМС.ШаблонСМС;
	
	ТекстШаблон = СтрЗаменить(ТекстШаблон,"[ДатаЗаказ]",Формат(ДокЗаказ.Дата,"ЧЦ=15; ЧДЦ=2"));
	ТекстШаблон = СтрЗаменить(ТекстШаблон,"[НомерЗаказ]",ДокЗаказ.Номер);

	Если ЗначениеЗаполнено(ДокЗаказ.ПредЗаказ) Тогда
		ТекстШаблон = СтрЗаменить(ТекстШаблон,"[ДатаПредЗаказ]",Формат(ДокЗаказ.ПредЗаказ.Дата,"ЧЦ=15; ЧДЦ=2"));
		ТекстШаблон = СтрЗаменить(ТекстШаблон,"[НомерЗаказ]",ДокЗаказ.ПредЗаказ.Номер);
	Иначе
		ТекстШаблон = СтрЗаменить(ТекстШаблон,"[ДатаПредЗаказ]","");
		ТекстШаблон = СтрЗаменить(ТекстШаблон,"[НомерЗаказ]","");
	КонецЕсли;
	
	ТекстШаблон = СтрЗаменить(ТекстШаблон,"[Контрагент]",ДокЗаказ.Контрагент);
	ТекстШаблон = СтрЗаменить(ТекстШаблон,"[СуммаЗаказа]",Формат(ДокЗаказ.СуммаДокумента,"ЧЦ=15; ЧДЦ=2"));
	ТекстШаблон = СтрЗаменить(ТекстШаблон,"[Ответственный]",ДокЗаказ.Ответственный);
	ТекстШаблон = СтрЗаменить(ТекстШаблон,"[ТТН_НП]",ДокЗаказ.НП_ТТН);
	ТекстШаблон = СтрЗаменить(ТекстШаблон,"[URL_инвойс_ПолнаяОплата]",ДокЗаказ.Wayforpay_url_INVOICE);
	ТекстШаблон = СтрЗаменить(ТекстШаблон,"[URL_инвойс_Предоплата]",ДокЗаказ.Wayforpay_url_INVOICE_предоплата);
	ТекстШаблон = СтрЗаменить(ТекстШаблон,"[СуммаПредоплата]",Формат(ДокЗаказ.НП_ОплатаНаКарту,"ЧЦ=15; ЧДЦ=2"));
	ТекстШаблон = СтрЗаменить(ТекстШаблон,"[СуммаПредоплатаДодТекст]",?(ДокЗаказ.НП_ОплатаНаКарту=0,"","Предоплата : "+Формат(ДокЗаказ.НП_ОплатаНаКарту,"ЧЦ=15; ЧДЦ=2")+"грн."));
	
	ТоварСтрока = "";
	Сч = 1;
	Для каждого Стр из ДокЗаказ.Товары Цикл
		ТоварСтрока = ТоварСтрока + ?(Не Сч = 1,Символы.ПС,"") + "" + стр.Номенклатура + " " + стр.Количество + "" + стр.ЕдиницаИзмерения;
		Сч = Сч + 1;
	КонецЦикла;
	ТекстШаблон = СтрЗаменить(ТекстШаблон,"[Товары]",ТоварСтрока);
	
	Возврат ТекстШаблон

КонецФункции