Функция ПолучитьБаланс(НастройкиПодключений)Экспорт 
	Рез = Новый Структура;
	Рез.Вставить("Успешно",Ложь);
	Рез.Вставить("Сообщение","");
	Рез.Вставить("Баланс",0);


	
	Если ЗначениеЗаполнено(НастройкиПодключений.ПапкаФайлаЛога) и ФайлСуществует(НастройкиПодключений.ПапкаФайлаЛога) Тогда
		ИмяФайлаОтвета = НастройкиПодключений.ПапкаФайлаЛога + "\answ_balance.json";
	Иначе
		ИмяФайлаОтвета = КаталогВременныхФайлов() + "answ_balance.json";
	КонецЕсли;

	
	Соединение = СоздатьHTTPСоединение(НастройкиПодключений);
		
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Charset","UTF-8");
	Заголовки.Вставить("Authorization","Basic " + НастройкиПодключений.API_ключ);
	Заголовки.Вставить("Content-Type","application/json");

	ЗапросHTTP = Новый HTTPЗапрос(НастройкиПодключений.МетодДляПроверкиБаланса,Заголовки);
	
	ОтветСервера = Соединение.ОтправитьДляОбработки(ЗапросHTTP,ИмяФайлаОтвета);

	ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
	
	Если ФайлОтвета.Существует() Тогда
		
		ТекстОтвета = Новый ТекстовыйДокумент();
		ТекстОтвета.Прочитать(ИмяФайлаОтвета);
		Если ТекстОтвета.КоличествоСтрок()>0 Тогда
			ОтветСервера = ТекстОтвета.ПолучитьТекст();	
		Иначе
			Т = "Получен пустой ответ сервера.";
			//Сообщить(Т);
			Рез.Вставить("Успешно",Ложь);
			Рез.Вставить("Сообщение",Т);
			Рез.Вставить("Баланс",0);
			Возврат Рез;
		КонецЕсли;	
		
	Иначе	
		Т = "Ответ сервера не получен.";
		//Сообщить(Т);
		Рез.Вставить("Успешно",Ложь);
		Рез.Вставить("Сообщение",Т);
		Рез.Вставить("Баланс",0);
		Возврат Рез;
	КонецЕсли;
	
	
	ЧтениеДЖС = Новый ЧтениеJSON;
	ЧтениеДЖС.ОткрытьФайл(ИмяФайлаОтвета);
	Записи = ПрочитатьJSON(ЧтениеДЖС);
	Статус = ""; МассивОтвет = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если Запись.Ключ = "response_status" Тогда
			Статус = Запись.Значение;
		КонецЕсли;
		Если Запись.Ключ = "response_result" Тогда
			МассивОтвет = Запись.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Если Не Статус = "OK" Тогда
		Рез.Вставить("Успешно",Ложь);
		Рез.Вставить("Сообщение",Статус);
		Рез.Вставить("Баланс",0);
		Возврат Рез;
	Иначе
		Баланс = 0;
		Для каждого Стр_Б из МассивОтвет Цикл
			Если Стр_Б.Ключ = "balance" Тогда
				Баланс = Стр_Б.Значение;
			КонецЕсли;
		КонецЦикла;
		
		Рез.Вставить("Успешно",Истина);
		Рез.Вставить("Сообщение","");
		Рез.Вставить("Баланс",Баланс);
	КонецЕсли;

	

	
	Возврат Рез;
КонецФункции

Функция ОтправитьСообщение(НастройкиПодключений,НомерПолучателя,ТекстСообщения)Экспорт 
	Рез = Новый Структура;
	Рез.Вставить("Успешно",Ложь);
	Рез.Вставить("Сообщение","");


	Если ЗначениеЗаполнено(НастройкиПодключений.ПапкаФайлаЛога) и ФайлСуществует(НастройкиПодключений.ПапкаФайлаЛога) Тогда
		ИмяИсходящегоФайла = НастройкиПодключений.ПапкаФайлаЛога + "\send.json";
	Иначе
		ИмяИсходящегоФайла = КаталогВременныхФайлов() + "send.json";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиПодключений.ПапкаФайлаЛога) и ФайлСуществует(НастройкиПодключений.ПапкаФайлаЛога) Тогда
		ИмяФайлаОтвета = НастройкиПодключений.ПапкаФайлаЛога + "\answ_send.json";
	Иначе
		ИмяФайлаОтвета = КаталогВременныхФайлов() + "answ_send.json";
	КонецЕсли;

	
	Соединение = СоздатьHTTPСоединение(НастройкиПодключений);
	
	
	ЗаписьДЖС = Новый ЗаписьJSON;
	ЗаписьДЖС.ПроверятьСтруктуру = Истина;
	ПараметрыЗаписиДЖС = Новый ПараметрыЗаписиJSON(,Символы.Таб);
	ЗаписьДЖС.ОткрытьФайл(ИмяИсходящегоФайла,КодировкаТекста.UTF8,Ложь,ПараметрыЗаписиДЖС);
	
	ЗаписьДЖС.ЗаписатьНачалоОбъекта();
	ЗаписьДЖС.ЗаписатьИмяСвойства("sender");
	ЗаписьДЖС.ЗаписатьЗначение(НастройкиПодключений.ИмяОтправителя);
	ЗаписьДЖС.ЗаписатьИмяСвойства("recipients");
	ЗаписьДЖС.ЗаписатьНачалоМассива();
	ЗаписьДЖС.ЗаписатьЗначение(НомерПолучателя);
	ЗаписьДЖС.ЗаписатьКонецМассива();
	Если НастройкиПодключений.ОтправлятьСМС Тогда
		ЗаписьДЖС.ЗаписатьИмяСвойства("sms");
		ЗаписьДЖС.ЗаписатьНачалоОбъекта();
		ЗаписьДЖС.ЗаписатьИмяСвойства("text");
		ЗаписьДЖС.ЗаписатьЗначение(ТекстСообщения);
		ЗаписьДЖС.ЗаписатьКонецОбъекта();
	КонецЕсли;
	Если НастройкиПодключений.ОтправлятьViber Тогда
		ЗаписьДЖС.ЗаписатьИмяСвойства("viber");
		ЗаписьДЖС.ЗаписатьНачалоОбъекта();
		ЗаписьДЖС.ЗаписатьИмяСвойства("text");
		ЗаписьДЖС.ЗаписатьЗначение(ТекстСообщения);
		ЗаписьДЖС.ЗаписатьКонецОбъекта();
	КонецЕсли;
		
		
	ЗаписьДЖС.ЗаписатьКонецОбъекта();
	ЗаписьДЖС.Закрыть();

	
		
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Charset","UTF-8");
	Заголовки.Вставить("Authorization","Basic " + НастройкиПодключений.API_ключ);
	Заголовки.Вставить("Content-Type","application/json");

	
	ОтветСервера = Соединение.ОтправитьДляОбработки(ИмяИсходящегоФайла, НастройкиПодключений.МетодДляОтправки, ИмяФайлаОтвета, Заголовки);

	
	ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
	
	Если ФайлОтвета.Существует() Тогда
		
		ТекстОтвета = Новый ТекстовыйДокумент();
		ТекстОтвета.Прочитать(ИмяФайлаОтвета);
		Если ТекстОтвета.КоличествоСтрок()>0 Тогда
			ОтветСервера = ТекстОтвета.ПолучитьТекст();	
		Иначе
			Т = "Получен пустой ответ сервера.";
			//Сообщить(Т);
			Рез.Вставить("Успешно",Ложь);
			Рез.Вставить("Сообщение",Т);
			Возврат Рез;
		КонецЕсли;	
		
	Иначе	
		Т = "Ответ сервера не получен.";
		//Сообщить(Т);
		Рез.Вставить("Успешно",Ложь);
		Рез.Вставить("Сообщение",Т);
		Возврат Рез;
	КонецЕсли;
	
	
	ЧтениеДЖС = Новый ЧтениеJSON;
	ЧтениеДЖС.ОткрытьФайл(ИмяФайлаОтвета);
	Записи = ПрочитатьJSON(ЧтениеДЖС);
	Статус = ""; МассивОтвет = Новый Массив;
	Для Каждого Запись Из Записи Цикл
		Если Запись.Ключ = "response_status" Тогда
			Статус = Запись.Значение;
		КонецЕсли;
		Если Запись.Ключ = "response_result" Тогда
			МассивОтвет = Запись.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Если Не Статус = "SUCCESS_MESSAGE_SENT" Тогда
		Рез.Вставить("Успешно",Ложь);
		Рез.Вставить("Сообщение",Статус);
		Возврат Рез;
	Иначе
		СтатусОтправки = "";message_id = ""; 
		Для каждого Стр_Б из МассивОтвет Цикл
			СтатусОтправки = Стр_Б.response_status;
			message_id = Стр_Б.message_id;
		КонецЦикла;
		
		Рез.Вставить("Успешно",Истина);
		Рез.Вставить("Сообщение",""+СтатусОтправки);
		Рез.Вставить("message_id",message_id);
	КонецЕсли;

	

	
	Возврат Рез;

КонецФункции

Функция ПолучитьСтатусСообщения(НастройкиПодключений,ИД_сообщения)Экспорт 
	Рез = Новый Структура;
	Рез.Вставить("Успешно",Ложь);
	Рез.Вставить("Сообщение","");
	Рез.Вставить("Статус","");


	Если ЗначениеЗаполнено(НастройкиПодключений.ПапкаФайлаЛога) и ФайлСуществует(НастройкиПодключений.ПапкаФайлаЛога) Тогда
		ИмяИсходящегоФайла = НастройкиПодключений.ПапкаФайлаЛога + "\status.json";
	Иначе
		ИмяИсходящегоФайла = КаталогВременныхФайлов() + "status.json";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиПодключений.ПапкаФайлаЛога) и ФайлСуществует(НастройкиПодключений.ПапкаФайлаЛога) Тогда
