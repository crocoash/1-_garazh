////////////////////////////////////////////////////////////////////////////////
// Загрузка банковских выписок (WayForPay, Приват24 Бизнес, Monobank).
//
// WayForPay настройки не требует: подразделение попадает в загрузку само,
// если у него заполнена «Настройка Wayforpay» — реквизиты продавца берутся
// оттуда же, откуда их берёт создание инвойсов в заказе покупателя.
//
// Приват24 и Monobank настраиваются реквизитами справочника Подразделения
// (ИсточникБанковскойВыписки, ТокенБанковскойВыписки, АйдиБанковскойВыписки,
// ЗагружатьБанковскуюВыписку, НаправлениеОперацийВыписки, БанковскийСчетВыписки).
//
// Полученные операции складываются в таблицу "документы к импорту" в
// ХранилищеОбщихНастроек("ОбменПриват24", "ДокументыКИмпорту"), откуда
// обработка ОбменПриват24 создаёт платёжные документы.
//
// Организацию, подразделение, договор и валюту платёжный документ получает
// из заказа (см. Документы.ПлатежноеПоручениеВходящее.СоздатьПлатежПоЗаказу),
// счёт организации — из настройки подразделения, по которой пришла выписка.
////////////////////////////////////////////////////////////////////////////////

#Область ТочкаВходаРегламентногоЗадания

// Точка входа регламентного задания ЗагрузкаПриват24.
// Организация в загрузке не участвует: настройки берутся из подразделений,
// организация платёжного документа определяется заказом.
Процедура ЗагрузкаБанковскихВыписок() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Попытка

		ПараметрыЗагрузки = СформироватьПараметрыЗагрузкиБанковскихВыписок();

		Если ПараметрыЗагрузки = Неопределено Тогда
			Возврат;
		КонецЕсли;

		ЗагрузитьБанковскиеВыписки(ПараметрыЗагрузки);

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка регламентной загрузки банковских выписок: "
			+ ОписаниеОшибки());

		Сообщить(
			"Ошибка регламентной загрузки банковских выписок: "
			+ ОписаниеОшибки());

	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Период загрузки: от Приват24НачалПериодРучной (если заполнена),
// иначе от Приват24НачалПериод, иначе "сегодня минус 2 дня".
Функция СформироватьПараметрыЗагрузкиБанковскихВыписок(
	Подразделение = Неопределено) Экспорт

	НачалоПериода = Константы.Приват24НачалПериод.Получить();

	НачалоПериодаРучное = Константы.Приват24НачалПериодРучной.Получить();

	Если ЗначениеЗаполнено(НачалоПериодаРучное) Тогда

		ДатаНачала = НачалоДня(НачалоПериодаРучное);

	ИначеЕсли ЗначениеЗаполнено(НачалоПериода) Тогда

		ДатаНачала = НачалоДня(НачалоПериода);

	Иначе

		ДатаНачала = НачалоДня(ТекущаяДата() - 2 * 24 * 60 * 60);

	КонецЕсли;

	ДатаКонца = КонецДня(ТекущаяДата());

	Если ДатаНачала > ДатаКонца Тогда

		Сообщить(
			"Загрузка банковских выписок: "
			+ "дата начала периода больше даты окончания.");

		Возврат Неопределено;

	КонецЕсли;

	Параметры = Новый Структура;

	Параметры.Вставить("Подразделение", Подразделение);
	Параметры.Вставить("ДатаНачала",    ДатаНачала);
	Параметры.Вставить("ДатаКонца",     ДатаКонца);

	Возврат Параметры;

КонецФункции

#КонецОбласти

#Область ЗагрузкаВыписок

// Основной конвейер загрузки.
//
// Параметры:
//   ПараметрыЗагрузки - Структура:
//     * ДатаНачала    - Дата - начало периода;
//     * ДатаКонца     - Дата - окончание периода;
//     * Подразделение - СправочникСсылка.Подразделения - необязательно,
//                       пусто = все настроенные подразделения.
//
Процедура ЗагрузитьБанковскиеВыписки(ПараметрыЗагрузки) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Попытка

		Если ПараметрыЗагрузки = Неопределено Тогда

			Сообщить(
				"Загрузка банковских выписок: "
				+ "не переданы параметры загрузки.");

			Возврат;

		КонецЕсли;

		ДатаНачала    = Неопределено;
		ДатаКонца     = Неопределено;
		Подразделение = Неопределено;

		Если Не ПараметрыЗагрузки.Свойство("ДатаНачала", ДатаНачала) Тогда

			Сообщить(
				"Загрузка банковских выписок: не передана дата начала.");

			Возврат;

		КонецЕсли;

		Если Не ПараметрыЗагрузки.Свойство("ДатаКонца", ДатаКонца) Тогда

			Сообщить(
				"Загрузка банковских выписок: не передана дата окончания.");

			Возврат;

		КонецЕсли;

		Если ТипЗнч(ДатаНачала) <> Тип("Дата")
			Или ТипЗнч(ДатаКонца) <> Тип("Дата") Тогда

			Сообщить(
				"Загрузка банковских выписок: "
				+ "период должен быть передан типом Дата.");

			Возврат;

		КонецЕсли;

		ПараметрыЗагрузки.Свойство("Подразделение", Подразделение);

		СохранённыеСтроки = ПолучитьТаблицуДокументовКИмпорту();

		// Таблицу больше не очищаем: регламент ходит каждые несколько минут,
		// и очистка стирала подобранный руками заказ вместе с отметками.
		// Свежие строки собираются отдельно и сливаются со старыми по ключу.
		ДокументыКИмпорту = СоздатьТаблицуДокументовКИмпорту();

		// Ключи строк тех источников, которые платежи сами не заводят.
		// Читаются из хранилища: строка могла попасть в таблицу на прошлом
		// запуске и уже не попадать в текущий период выборки.
		БезАвтосоздания = ПрочитатьКлючиБезАвтосоздания();

		ТаблицаНастроек = ПолучитьНастройкиЗагрузкиВыписок(Подразделение);

		Если ТаблицаНастроек.Количество() = 0 Тогда

			Если ЗначениеЗаполнено(Подразделение) Тогда

				Сообщить(
					"Загрузка банковских выписок: у подразделения «"
					+ Строка(Подразделение)
					+ "» загрузка выписки не настроена."
					+ " Очистите поле «Подразделение», чтобы загружать по всем.");

			Иначе

				Сообщить(
					"Загрузка банковских выписок: нечего загружать."
					+ " Эквайринг WayForPay берётся автоматически у каждого"
					+ " подразделения с заполненной настройкой «Wayforpay»."
					+ " Для Приват24 или Monobank нужно заполнить реквизиты"
					+ " загрузки выписки у подразделения (источник, банковский"
					+ " счёт, айди, токен и флаг «Загружать»).");

			КонецЕсли;

			// Настроек нет — таблицу оставляем как была: собранные ранее
			// строки к настройкам отношения не имеют.
			СохранитьТаблицуДокументовКИмпорту(СохранённыеСтроки);

			Возврат;

		КонецЕсли;

		ОтладкаВыписокСообщить(
			"Период " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
			+ " - " + Формат(ДатаКонца, "ДФ=dd.MM.yyyy")
			+ ", найдено настроек: " + Строка(ТаблицаНастроек.Количество()));

		Для Каждого СтрокаНастройки Из ТаблицаНастроек Цикл

			ОтладкаВыписокСообщить(
				"  подразделение: " + Строка(СтрокаНастройки.Подразделение)
				+ ", источник: " + Строка(СтрокаНастройки.Источник)
				+ ", счёт: " + Строка(СтрокаНастройки.БанковскийСчет));

			ЗагрузитьВыпискуПоНастройке(
				СтрокаНастройки,
				ДатаНачала,
				ДатаКонца,
				ДокументыКИмпорту,
				БезАвтосоздания);

		КонецЦикла;

		ДокументыКИмпорту = ОбъединитьСтрокиВыписки(
			ДокументыКИмпорту,
			СохранённыеСтроки,
			ДатаКонца);

		ДокументыКИмпорту.Сортировать("ДатаПроведения Убыв");

		// Поступления с подобранным заказом разносим сами: человеку остается
		// только то, где заказ не опознан. Задача по каждому такому платежу
		// ставится тут же, внутри.
		РазнестиПоступленияПоЗаказам(ДокументыКИмпорту, БезАвтосоздания);

		// Платежи без заказа — задача кассирам; они же могут переподписать
		// колонку «Ответственный», и это должно попасть в хранилище.
		СоздатьЗадачиКассирам(ДокументыКИмпорту, БезАвтосоздания);

		СохранитьТаблицуДокументовКИмпорту(ДокументыКИмпорту);

		СохранитьКлючиБезАвтосоздания(БезАвтосоздания, ДокументыКИмпорту);

		ОбновитьДатуСледующейЗагрузки(ДокументыКИмпорту, ДатаКонца);

		Сообщить(
			"Загрузка банковских выписок завершена. "
			+ "Получено операций: "
			+ Строка(ДокументыКИмпорту.Количество()) + ".");

		СводкаВыписокВЖурнал(
			"Загрузка завершена. Строк в таблице: "
			+ Строка(ДокументыКИмпорту.Количество())
			+ ", настроек обработано: " + Строка(ТаблицаНастроек.Количество())
			+ ", период " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
			+ " - " + Формат(ДатаКонца, "ДФ=dd.MM.yyyy") + ".");

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка загрузки банковских выписок: " + ОписаниеОшибки());

		Сообщить("Ошибка загрузки банковских выписок: " + ОписаниеОшибки());

	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Настройки загрузки выписок, заданные в подразделениях.
//
// Возвращаемое значение:
//   ТаблицаЗначений - колонки Подразделение, БанковскийСчет, Источник,
//                     Токен, Айди, Направление.
//
Функция ПолучитьНастройкиЗагрузкиВыписок(Подразделение = Неопределено) Экспорт

	Результат = Новый ТаблицаЗначений;

	Результат.Колонки.Добавить("Подразделение");
	Результат.Колонки.Добавить("БанковскийСчет");
	Результат.Колонки.Добавить("ОрганизацияМерчанта");
	Результат.Колонки.Добавить("Источник");
	Результат.Колонки.Добавить("Токен");
	Результат.Колонки.Добавить("Айди");
	Результат.Колонки.Добавить("Направление");
	Результат.Колонки.Добавить("НастройкаWayForPay");

	// Операции раньше этой даты источник не отдаёт: старую историю,
	// разнесённую руками, тянуть в базу незачем.
	Результат.Колонки.Добавить("НачалоЗагрузки");

	// Ложь — источник только складывает строки в таблицу обработки:
	// ни платежей, ни задач по ним автоматика не создаёт, документы
	// заводит человек кнопкой «Загрузить в 1С».
	Результат.Колонки.Добавить("СоздаватьПлатежи");

	// У подразделения может быть два источника сразу: эквайринг WayForPay
	// (настройка мерчанта) и выписка банка (источник, счёт, токен). Поэтому
	// запрос отдаёт сырые реквизиты, а строки настроек собираются ниже —
	// до двух на подразделение.
	//
	// Счёт зачисления у каждого источника свой:
	//   эквайринг — счёт из настройки мерчанта (у каждого мерчанта своя фирма
	//     и свой счёт, а одно подразделение принимает деньги за несколько фирм);
	//   выписка банка — реквизит подразделения, рядом с токеном и айди.
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Подразделения.Ссылка КАК Подразделение,
	|	Подразделения.ИсточникБанковскойВыписки КАК Источник,
	|	Подразделения.ЗагружатьБанковскуюВыписку КАК Загружать,
	|	Подразделения.БанковскийСчетВыписки КАК БанковскийСчет,
	|	Подразделения.НачалоЗагрузкиВыписки КАК НачалоЗагрузки,
	|	Подразделения.ТокенБанковскойВыписки КАК Токен,
	|	Подразделения.АйдиБанковскойВыписки КАК Айди,
	|	Подразделения.НаправлениеОперацийВыписки КАК Направление,
	|	Подразделения.Настройка_WayforpayСД КАК НастройкаWayForPay,
	|	Подразделения.Настройка_WayforpayСД.БанковскийСчет КАК СчетМерчанта,
	|	Подразделения.Настройка_WayforpayСД.Организация КАК ОрганизацияМерчанта
	|ИЗ
	|	Справочник.Подразделения КАК Подразделения
	|ГДЕ
	|	НЕ Подразделения.ПометкаУдаления
	|	И Подразделения.ИсточникБанковскойВыписки <> &НеИспользуется
	|	И (Подразделения.ЗагружатьБанковскуюВыписку
	|			ИЛИ Подразделения.Настройка_WayforpayСД <> &НастройкаНеЗадана)
	|	%УСЛОВИЕ%
	|
	|УПОРЯДОЧИТЬ ПО
	|	Подразделения.Наименование";

	Запрос = Новый Запрос;

	Если ЗначениеЗаполнено(Подразделение) Тогда

		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"%УСЛОВИЕ%",
			"И Подразделения.Ссылка = &Подразделение");

		Запрос.УстановитьПараметр("Подразделение", Подразделение);

	Иначе

		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%УСЛОВИЕ%", "");

	КонецЕсли;

	Запрос.Текст = ТекстЗапроса;

	Запрос.УстановитьПараметр(
		"НеИспользуется",
		Перечисления.ИсточникиБанковскихВыписок.НеИспользуется);

	Запрос.УстановитьПараметр(
		"НастройкаНеЗадана",
		Справочники.wayforpay_НастройкиПодключения_СД.ПустаяСсылка());

	ЭтоWayForPay    = Перечисления.ИсточникиБанковскихВыписок.WayForPay;
	ИсточникНеЗадан = Перечисления.ИсточникиБанковскихВыписок.ПустаяСсылка();
	ЭтоРеестрGoogle = Перечисления.ИсточникиБанковскихВыписок.РеестрЗачисленийGoogle;

	Выборка = Запрос.Выполнить().Выбрать();

	// Один и тот же продавец может быть указан у нескольких подразделений —
	// опрашиваем его один раз, иначе те же транзакции придут дублями.
	ОпрошенныеПродавцы = Новый Соответствие;

	Пока Выборка.Следующий() Цикл

		// 1. Эквайринг. Своих токена и айди у него нет: реквизиты продавца
		// берутся из настройки подключения подразделения.
		//
		// Опрашивается всегда, когда настройка мерчанта заполнена. Выбранный
		// банковский источник его не отменяет: это два разных потока денег,
		// а не альтернатива. Проверено ценой ошибки 17.09.2026 — стоило
		// проставить подразделению источник «Реестр зачислений», как его
		// мерчант перестал опрашиваться вовсе.
		Если ЗначениеЗаполнено(Выборка.НастройкаWayForPay) Тогда

			Если ОпрошенныеПродавцы.Получить(Выборка.НастройкаWayForPay) = Неопределено Тогда

				ОпрошенныеПродавцы.Вставить(Выборка.НастройкаWayForPay, Истина);

				СтрокаЭквайринга = Результат.Добавить();

				СтрокаЭквайринга.Подразделение       = Выборка.Подразделение;
				СтрокаЭквайринга.БанковскийСчет      = Выборка.СчетМерчанта;
				СтрокаЭквайринга.ОрганизацияМерчанта = Выборка.ОрганизацияМерчанта;
				СтрокаЭквайринга.Источник            = ЭтоWayForPay;
				СтрокаЭквайринга.Токен               = "";
				СтрокаЭквайринга.Айди                = "";
				СтрокаЭквайринга.Направление         = Выборка.Направление;
				СтрокаЭквайринга.НастройкаWayForPay  = Выборка.НастройкаWayForPay;
				СтрокаЭквайринга.НачалоЗагрузки      = Выборка.НачалоЗагрузки;
				СтрокаЭквайринга.СоздаватьПлатежи    = Истина;

			КонецЕсли;

		КонецЕсли;

		// 2. Выписка банка либо реестр зачислений — только по явно выбранному
		// источнику и включённому флагу «Загружать».
		Если Выборка.Источник = ИсточникНеЗадан
			Или Выборка.Источник = ЭтоWayForPay
			Или Не Выборка.Загружать Тогда

			Продолжить;

		КонецЕсли;

		ЭтоРеестр = (Выборка.Источник = ЭтоРеестрGoogle);

		Если Не ЗначениеЗаполнено(Выборка.Токен) Тогда

			Сообщить(
				"Подразделение «" + Строка(Выборка.Подразделение)
				+ "» пропущено: не заполнен реквизит «Токен банковской выписки»"
				+ ?(ЭтоРеестр, " — в нём хранится ссылка на таблицу реестра.", "."));

			Продолжить;

		КонецЕсли;

		// У реестра «Айди» — это gid листа, и пустой он означает первый лист.
		Если Не ЭтоРеестр И Не ЗначениеЗаполнено(Выборка.Айди) Тогда

			Сообщить(
				"Подразделение «" + Строка(Выборка.Подразделение)
				+ "» пропущено: не заполнен айди банковской выписки.");

			Продолжить;

		КонецЕсли;

		// Счёт зачисления взять больше неоткуда: у операции нет заказа,
		// из которого его можно подставить. Реестр — исключение: там счёт
		// приходит в самой строке, и настройка ему не нужна.
		Если Не ЭтоРеестр И Не ЗначениеЗаполнено(Выборка.БанковскийСчет) Тогда

			Сообщить(
				"Подразделение «" + Строка(Выборка.Подразделение)
				+ "» пропущено: не заполнен банковский счет выписки.");

			Продолжить;

		КонецЕсли;

		СтрокаБанка = Результат.Добавить();

		СтрокаБанка.Подразделение       = Выборка.Подразделение;
		СтрокаБанка.БанковскийСчет      = Выборка.БанковскийСчет;
		СтрокаБанка.ОрганизацияМерчанта = Выборка.ОрганизацияМерчанта;
		СтрокаБанка.Источник            = Выборка.Источник;
		СтрокаБанка.Токен               = СокрЛП(Выборка.Токен);
		СтрокаБанка.Айди                = СокрЛП(Выборка.Айди);
		СтрокаБанка.Направление         = Выборка.Направление;
		СтрокаБанка.НастройкаWayForPay  = Выборка.НастройкаWayForPay;
		СтрокаБанка.НачалоЗагрузки      = Выборка.НачалоЗагрузки;

		// Реестр зачислений пока только наполняет таблицу: платежи по нему
		// заводит человек. Приват24 и Monobank работают как раньше.
		СтрокаБанка.СоздаватьПлатежи = Не ЭтоРеестр;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// БезАвтосоздания - Соответствие - заполняется ключами строк тех источников,
//   которые только наполняют таблицу: по ним ни платежи, ни задачи
//   автоматически не создаются.
Процедура ЗагрузитьВыпискуПоНастройке(
	Настройка,
	ДатаНачала,
	ДатаКонца,
	ДокументыКИмпорту,
	БезАвтосоздания = Неопределено) Экспорт

	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат;

	КонецЕсли;

	Операции = Новый Массив;

	Если Настройка.Источник =
		Перечисления.ИсточникиБанковскихВыписок.Приват24Бизнес Тогда

		Операции = ПолучитьОперацииПриват24Бизнес(
			Настройка,
			ДатаНачала,
			ДатаКонца);

	ИначеЕсли Настройка.Источник =
		Перечисления.ИсточникиБанковскихВыписок.Monobank Тогда

		Операции = ПолучитьОперацииMonobank(
			Настройка,
			ДатаНачала,
			ДатаКонца);

	ИначеЕсли Настройка.Источник =
		Перечисления.ИсточникиБанковскихВыписок.WayForPay Тогда

		Операции = ПолучитьОперацииWayForPay(
			Настройка,
			ДатаНачала,
			ДатаКонца);

	ИначеЕсли Настройка.Источник =
		Перечисления.ИсточникиБанковскихВыписок.РеестрЗачисленийGoogle Тогда

		Операции = ПолучитьОперацииРеестраGoogle(
			Настройка,
			ДатаНачала,
			ДатаКонца);

	КонецЕсли;

	ТекстИтога =
		"Подразделение «" + Строка(Настройка.Подразделение)
		+ "», источник: " + Строка(Настройка.Источник)
		+ ", направление: "
		+ ?(ЗначениеЗаполнено(Настройка.Направление),
			Строка(Настройка.Направление), "Все")
		+ ", операций получено: " + Строка(Операции.Количество())
		+ ", платежи создаются автоматически: "
		+ ?(СоздаватьПлатежиПоНастройке(Настройка), "да", "нет");

	ОтладкаВыписокСообщить(ТекстИтога);
	СводкаВыписокВЖурнал(ТекстИтога);

	Для Каждого БанковскаяОперация Из Операции Цикл

		Если Не ОперацияПодходитПоНаправлению(
			БанковскаяОперация,
			Настройка.Направление) Тогда

			// Молчаливый отсев: списание при настройке «Входящие» выглядит
			// в форме как «банк ничего не прислал». Проговариваем.
			ВходящаяОперация = Ложь;
			БанковскаяОперация.Свойство("Входящий", ВходящаяОперация);

			ИдентификаторДляОтладки = "";
			БанковскаяОперация.Свойство("Идентификатор", ИдентификаторДляОтладки);

			ОтладкаВыписокСообщить(
				"  ОТСЕЯНА ПО НАПРАВЛЕНИЮ [" + СокрЛП(Строка(ИдентификаторДляОтладки)) + "]: "
				+ ?(ВходящаяОперация, "поступление", "списание")
				+ ", а в подразделении задано «"
				+ Строка(Настройка.Направление) + "».");

			Продолжить;

		КонецЕсли;

		ДобавитьБанковскуюОперациюВТаблицу(
			БанковскаяОперация,
			ДокументыКИмпорту);

		// Источник только собирает таблицу — запоминаем ключ строки, чтобы
		// разнесение платежей и задачи её не трогали.
		Если ТипЗнч(БезАвтосоздания) = Тип("Соответствие")
			И Не СоздаватьПлатежиПоНастройке(Настройка) Тогда

			КлючСтроки = "";
			БанковскаяОперация.Свойство("Идентификатор", КлючСтроки);

			БезАвтосоздания.Вставить(СокрЛП(Строка(КлючСтроки)), Истина);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Настройка может прийти из старого кода без колонки «СоздаватьПлатежи»
// (например, из формы обработки) — тогда поведение прежнее.
Функция СоздаватьПлатежиПоНастройке(Настройка)

	Попытка

		Если ТипЗнч(Настройка.СоздаватьПлатежи) = Тип("Булево") Тогда
			Возврат Настройка.СоздаватьПлатежи;
		КонецЕсли;

	Исключение
	КонецПопытки;

	Возврат Истина;

КонецФункции

// Строка пришла из источника, который платежи сам не заводит?
Функция СтрокаБезАвтосоздания(БезАвтосоздания, СтрокаОперации)

	Если ТипЗнч(БезАвтосоздания) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат БезАвтосоздания.Получить(СокрЛП(СтрокаОперации.НомерДок)) <> Неопределено;

КонецФункции

// Направление = Неопределено / пустая ссылка / "Все" — операция подходит всегда.
Функция ОперацияПодходитПоНаправлению(БанковскаяОперация, Направление)

	Если Не ЗначениеЗаполнено(Направление)
		Или Направление = Перечисления.НаправлениеБанковскихОпераций.Все Тогда

		Возврат Истина;

	КонецЕсли;

	ЭтоВходящийПлатеж = Ложь;
	БанковскаяОперация.Свойство("Входящий", ЭтоВходящийПлатеж);

	Если Направление =
		Перечисления.НаправлениеБанковскихОпераций.Входящие Тогда

		Возврат ЭтоВходящийПлатеж;

	КонецЕсли;

	Если Направление =
		Перечисления.НаправлениеБанковскихОпераций.Исходящие Тогда

		Возврат Не ЭтоВходящийПлатеж;

	КонецЕсли;

	Возврат Истина;

КонецФункции

#КонецОбласти

#Область ТаблицаДокументовКИмпорту

// Пустая таблица операций. Набор колонок повторяет табличную часть
// Обработка.ОбменПриват24.ДокументыКИмпорту — форма загружает таблицу
// из хранилища напрямую в неё.
//
// НомерДок = Строка(30) — ровно как НомерВходящегоДокумента у платёжных
// документов: длина ключа дедупликации задана в одном месте, значение
// не может молча усечься при записи документа.
Функция СоздатьТаблицуДокументовКИмпорту() Экспорт

	Таблица = Новый ТаблицаЗначений;

	Таблица.Колонки.Добавить("Загружать",
		Новый ОписаниеТипов("Булево"));

	Таблица.Колонки.Добавить("НомерДок",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30)));

	Таблица.Колонки.Добавить("ДатаПроведения",
		Новый ОписаниеТипов("Дата"));

	// Дата зачисления средств продавцу (компенсация WayForPay).
	Таблица.Колонки.Добавить("ДатаКомпенсации",
		Новый ОписаниеТипов("Дата"));

	// Служебный флаг: дата компенсации заполнена и отличается от даты
	// платежа (по дню). По нему форма подсвечивает ячейку и меняет дату.
	Таблица.Колонки.Добавить("ДатаКомпенсацииОтличается",
		Новый ОписаниеТипов("Булево"));

	Таблица.Колонки.Добавить("Подразделение",
		Новый ОписаниеТипов("СправочникСсылка.Подразделения"));

	Таблица.Колонки.Добавить("СчетОрганизации",
		Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));

	// Счет организации из уже созданного платежного документа и признак его
	// расхождения со счетом из настройки подразделения (колонка выше).
	Таблица.Колонки.Добавить("СчетПлатежа",
		Новый ОписаниеТипов("СправочникСсылка.БанковскиеСчета"));

	Таблица.Колонки.Добавить("СчетОтличается",
		Новый ОписаниеТипов("Булево"));

	// Организация заказа против организации созданного платежа: платеж,
	// заведенный не на ту фирму, деньгами не пахнет, но в учете разъезжается.
	Таблица.Колонки.Добавить("ОрганизацияЗаказа",
		Новый ОписаниеТипов("СправочникСсылка.Организации"));

	Таблица.Колонки.Добавить("ОрганизацияПлатежа",
		Новый ОписаниеТипов("СправочникСсылка.Организации"));

	// Фирма мерчанта эквайринга — из настройки WayForPay подразделения.
	Таблица.Колонки.Добавить("ОрганизацияМерчанта",
		Новый ОписаниеТипов("СправочникСсылка.Организации"));

	Таблица.Колонки.Добавить("ОрганизацияОтличается",
		Новый ОписаниеТипов("Булево"));

	Таблица.Колонки.Добавить("СуммаПоступило",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	Таблица.Колонки.Добавить("СуммаСписано",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	Таблица.Колонки.Добавить("Валюта",
		Новый ОписаниеТипов("СправочникСсылка.Валюты"));

	Таблица.Колонки.Добавить("Остаток",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	Таблица.Колонки.Добавить("Терминал",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(256)));

	Таблица.Колонки.Добавить("Содержание",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1000)));

	Таблица.Колонки.Добавить("Контрагент",
		Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));

	Таблица.Колонки.Добавить("Договор",
		Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));

	Таблица.Колонки.Добавить("Заказ",
		Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));

	// Сумма самого заказа — чтобы видеть частичную оплату и переплату.
	// Заполняется только из заказа: сумму платежного документа сюда писать
	// нельзя, иначе колонка показывает не то, что обещает названием.
	// Отметка «посчитать в итоге»: живёт отдельно от «Загружать», потому что
	// отмечать нужно и строки с уже заведённым платежом, а туда галку
	// загрузки ставить нельзя — это защита от дубля.
	Таблица.Колонки.Добавить("Позначено",
		Новый ОписаниеТипов("Булево"));

	Таблица.Колонки.Добавить("СуммаЗаказа",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	// Ответственный из заказа: по нему работает отбор «Только мои заказы».
	Таблица.Колонки.Добавить("Ответственный",
		Новый ОписаниеТипов("СправочникСсылка.Пользователи"));

	Таблица.Колонки.Добавить("ПлатежныйДокумент",
		Новый ОписаниеТипов(
			"ДокументСсылка.ПлатежноеПоручениеВходящее,"
			+ "ДокументСсылка.ПлатежноеПоручениеИсходящее,"
			+ "ДокументСсылка.ПриходныйКассовыйОрдер"));

	Таблица.Колонки.Добавить("Ошибка",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));

	// Код авторизации эквайринга: ключ дедупликации платежей WayForPay.
	Таблица.Колонки.Добавить("AuthCode",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));

	// Служебные колонки: по ним работает отбор строк на форме
	// (ОтборСтрок умеет только сравнение на равенство).
	Таблица.Колонки.Добавить("Входящий",
		Новый ОписаниеТипов("Булево"));

	Таблица.Колонки.Добавить("ЕстьДокумент",
		Новый ОписаниеТипов("Булево"));

	Возврат Таблица;

КонецФункции

// Таблица операций из хранилища общих настроек.
// Если в хранилище ничего нет либо набор колонок устарел — создаётся заново,
// поэтому регламентное задание работает и до первого открытия формы.
Функция ПолучитьТаблицуДокументовКИмпорту() Экспорт

	ДокументыКИмпорту = ХранилищеОбщихНастроек.Загрузить(
		"ОбменПриват24",
		"ДокументыКИмпорту",
		,
		"Пользователь");

	Если ТипЗнч(ДокументыКИмпорту) <> Тип("ТаблицаЗначений") Тогда
		Возврат СоздатьТаблицуДокументовКИмпорту();
	КонецЕсли;

	Эталон = СоздатьТаблицуДокументовКИмпорту();

	Для Каждого Колонка Из Эталон.Колонки Цикл

		Если ДокументыКИмпорту.Колонки.Найти(Колонка.Имя) = Неопределено Тогда

			ОтладкаВыписокСообщить(
				"Таблица операций пересоздана: в сохранённой не было "
				+ "колонки " + Колонка.Имя + ".");

			Возврат Эталон;

		КонецЕсли;

	КонецЦикла;

	// И наоборот: колонку могли убрать из обработки, а в сохранённой таблице
	// она осталась — загрузка такой таблицы в табличную часть формы падает.
	Для Каждого Колонка Из ДокументыКИмпорту.Колонки Цикл

		Если Эталон.Колонки.Найти(Колонка.Имя) = Неопределено Тогда

			ОтладкаВыписокСообщить(
				"Таблица операций пересоздана: в сохранённой осталась "
				+ "лишняя колонка " + Колонка.Имя + ".");

			Возврат Эталон;

		КонецЕсли;

	КонецЦикла;

	Возврат ДокументыКИмпорту;

КонецФункции

Процедура СохранитьТаблицуДокументовКИмпорту(ДокументыКИмпорту) Экспорт

	ХранилищеОбщихНастроек.Сохранить(
		"ОбменПриват24",
		"ДокументыКИмпорту",
		ДокументыКИмпорту,
		,
		"Пользователь");

	ХранилищеОбщихНастроек.Сохранить(
		"ОбменПриват24",
		"ДатаПоследнейЗагрузки",
		ТекущаяДата(),
		,
		"Пользователь");

КонецПроцедуры

// Слияние свежих строк выписки с уже лежавшими в таблице.
//
// Ключ строки — НомерДок. У найденных обеих сторон строка берётся свежая,
// но подобранное человеком (заказ, контрагент, договор, отметки) переносится
// из старой: регламент ходит каждые несколько минут, и терять ручную работу
// он не имеет права.
//
// Строки, которых в свежей выборке нет, остаются в таблице, пока не станут
// старше глубины хранения: иначе операция, выпавшая из периода запроса,
// исчезала бы вместе с незаконченным разбором.
Функция ОбъединитьСтрокиВыписки(НовыеСтроки, СохранённыеСтроки, ДатаКонца) Экспорт

	Если ТипЗнч(СохранённыеСтроки) <> Тип("ТаблицаЗначений") Тогда
		Возврат НовыеСтроки;
	КонецЕсли;

	ГраницаХранения = НачалоДня(ДатаКонца) - 45 * 24 * 60 * 60;

	СтарыеПоКлючу = Новый Соответствие;

	Для Каждого СтараяСтрока Из СохранённыеСтроки Цикл

		Ключ = СокрЛП(СтараяСтрока.НомерДок);

		Если Не ПустаяСтрока(Ключ) Тогда
			СтарыеПоКлючу.Вставить(Ключ, СтараяСтрока);
		КонецЕсли;

	КонецЦикла;

	Обработанные = Новый Соответствие;

	Для Каждого НоваяСтрока Из НовыеСтроки Цикл

		Ключ = СокрЛП(НоваяСтрока.НомерДок);

		СтараяСтрока = СтарыеПоКлючу.Получить(Ключ);

		Если СтараяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Обработанные.Вставить(Ключ, Истина);

		ПеренестиРучнойПодборСтроки(НоваяСтрока, СтараяСтрока);

	КонецЦикла;

	Перенесено = 0;

	Для Каждого СтараяСтрока Из СохранённыеСтроки Цикл

		Ключ = СокрЛП(СтараяСтрока.НомерДок);

		Если ПустаяСтрока(Ключ)
			Или Обработанные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтараяСтрока.ДатаПроведения)
			И СтараяСтрока.ДатаПроведения < ГраницаХранения Тогда
			Продолжить;
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(НовыеСтроки.Добавить(), СтараяСтрока);

		Перенесено = Перенесено + 1;

	КонецЦикла;

	ОтладкаВыписокСообщить(
		"Слияние таблицы: свежих строк " + Строка(НовыеСтроки.Количество() - Перенесено)
		+ ", сохранено прежних " + Строка(Перенесено) + ".");

	Возврат НовыеСтроки;

КонецФункции

Процедура ПеренестиРучнойПодборСтроки(НоваяСтрока, СтараяСтрока)

	Если Не ЗначениеЗаполнено(НоваяСтрока.Заказ)
		И ЗначениеЗаполнено(СтараяСтрока.Заказ) Тогда

		НоваяСтрока.Заказ             = СтараяСтрока.Заказ;
		НоваяСтрока.СуммаЗаказа       = СтараяСтрока.СуммаЗаказа;
		НоваяСтрока.ОрганизацияЗаказа = СтараяСтрока.ОрганизацияЗаказа;

		Если Не ЗначениеЗаполнено(НоваяСтрока.Ответственный) Тогда
			НоваяСтрока.Ответственный = СтараяСтрока.Ответственный;
		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(НоваяСтрока.Контрагент)
		И ЗначениеЗаполнено(СтараяСтрока.Контрагент) Тогда

		НоваяСтрока.Контрагент = СтараяСтрока.Контрагент;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(НоваяСтрока.Договор)
		И ЗначениеЗаполнено(СтараяСтрока.Договор) Тогда

		НоваяСтрока.Договор = СтараяСтрока.Договор;

	КонецЕсли;

	НоваяСтрока.Позначено = СтараяСтрока.Позначено;

	// Галку загрузки, снятую человеком, обратно не ставим.
	Если Не НоваяСтрока.ЕстьДокумент И Не СтараяСтрока.Загружать Тогда
		НоваяСтрока.Загружать = Ложь;
	КонецЕсли;

КонецПроцедуры

// Ключи строк, по которым платежи автоматически не создаются. Хранятся
// рядом с самой таблицей: признак должен пережить и перезапуск регламента,
// и выпадение строки из периода выборки.
Функция ПрочитатьКлючиБезАвтосоздания() Экспорт

	Результат = Новый Соответствие;

	Сохранённое = ХранилищеОбщихНастроек.Загрузить(
		"ОбменПриват24",
		"БезАвтосоздания",
		,
		"Пользователь");

	Если ТипЗнч(Сохранённое) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Ключ Из Сохранённое Цикл
		Результат.Вставить(СокрЛП(Строка(Ключ)), Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура СохранитьКлючиБезАвтосоздания(БезАвтосоздания, ДокументыКИмпорту) Экспорт

	Если ТипЗнч(БезАвтосоздания) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	// Ключей, которым в таблице уже ничего не соответствует, не храним:
	// иначе список растёт бесконечно.
	КлючиТаблицы = Новый Соответствие;

	Для Каждого СтрокаТаблицы Из ДокументыКИмпорту Цикл
		КлючиТаблицы.Вставить(СокрЛП(СтрокаТаблицы.НомерДок), Истина);
	КонецЦикла;

	Ключи = Новый Массив;

	Для Каждого КлючИЗначение Из БезАвтосоздания Цикл

		Если КлючиТаблицы.Получить(КлючИЗначение.Ключ) <> Неопределено Тогда
			Ключи.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;

	КонецЦикла;

	ХранилищеОбщихНастроек.Сохранить(
		"ОбменПриват24",
		"БезАвтосоздания",
		Ключи,
		,
		"Пользователь");

КонецПроцедуры

// Когда таблица операций последний раз обновлялась (форма показывает
// это в сводке под таблицей). Пустая дата — выписку еще не получали.
Функция ДатаПоследнегоОбновленияВыписки() Экспорт

	Дата = ХранилищеОбщихНастроек.Загрузить(
		"ОбменПриват24",
		"ДатаПоследнейЗагрузки",
		,
		"Пользователь");

	Если ТипЗнч(Дата) = Тип("Дата") Тогда
		Возврат Дата;
	КонецЕсли;

	Возврат '00010101';

КонецФункции

Процедура ОбновитьДатуСледующейЗагрузки(ДокументыКИмпорту, ДатаКонца)

	ДатаСледующейЗагрузки = НачалоДня(ДатаКонца);

	Для Каждого СтрокаДокумента Из ДокументыКИмпорту Цикл

		Если Не ЗначениеЗаполнено(СтрокаДокумента.ДатаПроведения) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(СтрокаДокумента.ПлатежныйДокумент) Тогда

			ДатаОперации = НачалоДня(СтрокаДокумента.ДатаПроведения);

			Если ДатаОперации < ДатаСледующейЗагрузки Тогда
				ДатаСледующейЗагрузки = ДатаОперации;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	// Небольшой нахлест, чтобы не потерять операции на границе периодов.
	ДатаСледующейЗагрузки = ДатаСледующейЗагрузки - 2 * 24 * 60 * 60;

	// Ограничитель. Дата начала двигается назад до самой старой операции
	// без документа, а у источника, который платежи не создаёт, такие строки
	// живут долго — период рос бы бесконечно и тянул за собой опрос эквайринга.
	ГраницаОкна = НачалоДня(ДатаКонца - 14 * 24 * 60 * 60);

	Если ДатаСледующейЗагрузки < ГраницаОкна Тогда
		ДатаСледующейЗагрузки = ГраницаОкна;
	КонецЕсли;

	// Пишем, только если дата реально изменилась. Регламент ходит каждые три
	// минуты, а значение почти всегда то же самое: лишняя запись константы
	// упиралась в блокировку SQL («Lock request time out period exceeded»)
	// и валила конец загрузки — ловили 18.09.2026 пять раз за сутки.
	Если Константы.Приват24НачалПериод.Получить() = ДатаСледующейЗагрузки Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Константы.Приват24НачалПериод.Установить(ДатаСледующейЗагрузки);

	Исключение

		// Не повод терять уже собранную таблицу: следующий запуск повторит.
		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не удалось сдвинуть начало периода загрузки: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

Функция СоздатьБанковскуюОперацию() Экспорт

	Операция = Новый Структура;

	Операция.Вставить("Источник", Неопределено);
	Операция.Вставить("Идентификатор", "");
	Операция.Вставить("КлючДубляСтраниц", "");
	Операция.Вставить("БанковскийСчет", Неопределено);
	Операция.Вставить("Подразделение", Неопределено);

	// Фирма, на которую заведён мерчант эквайринга: заполняется из настройки
	// WayForPay и сравнивается с организацией заказа.
	Операция.Вставить("ОрганизацияМерчанта", Неопределено);

	// Заполняются только для эквайринга WayForPay: по паре «заказ + AuthCode»
	// ищется платёж, созданный кнопкой «Получить оплату» из самого заказа.
	Операция.Вставить("AuthCode", "");
	Операция.Вставить("Заказ", Неопределено);

	Операция.Вставить("Дата", Неопределено);

	// Дата зачисления средств продавцу (settlement). Заполняет WayForPay.
	Операция.Вставить("ДатаКомпенсации", Неопределено);

	Операция.Вставить("Сумма", 0);
	Операция.Вставить("Валюта", Неопределено);

	Операция.Вставить("Входящий", Ложь);

	Операция.Вставить("Остаток", 0);
	Операция.Вставить("Терминал", "");
	Операция.Вставить("Назначение", "");

	// Заполняет реестр зачислений: в выписке банка плательщик и его код есть
	// отдельными полями, и по ним контрагент опознаётся надёжнее, чем по тексту
	// назначения.
	Операция.Вставить("Плательщик", "");
	Операция.Вставить("КодПлательщика", "");

	Возврат Операция;

КонецФункции

Процедура ДобавитьБанковскуюОперациюВТаблицу(
	БанковскаяОперация,
	ДокументыКИмпорту) Экспорт

	Если БанковскаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(ДокументыКИмпорту) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;

	ИдентификаторОперации = "";
	ДатаОперации          = Неопределено;
	ДатаКомпенсации       = Неопределено;
	СуммаОперации         = 0;
	ВалютаОперации        = Неопределено;
	ЭтоВходящийПлатеж     = Ложь;
	БанковскийСчет        = Неопределено;
	Подразделение         = Неопределено;
	ОрганизацияМерчанта   = Неопределено;
	Остаток               = 0;
	Терминал              = "";
	Назначение            = "";
	Источник              = Неопределено;

	БанковскаяОперация.Свойство("Источник",       Источник);
	БанковскаяОперация.Свойство("Идентификатор",  ИдентификаторОперации);
	БанковскаяОперация.Свойство("Дата",           ДатаОперации);
	БанковскаяОперация.Свойство("ДатаКомпенсации", ДатаКомпенсации);
	БанковскаяОперация.Свойство("Сумма",          СуммаОперации);
	БанковскаяОперация.Свойство("Валюта",         ВалютаОперации);
	БанковскаяОперация.Свойство("Входящий",       ЭтоВходящийПлатеж);
	БанковскаяОперация.Свойство("БанковскийСчет", БанковскийСчет);
	БанковскаяОперация.Свойство("Подразделение",  Подразделение);
	БанковскаяОперация.Свойство("ОрганизацияМерчанта", ОрганизацияМерчанта);
	БанковскаяОперация.Свойство("Остаток",        Остаток);
	БанковскаяОперация.Свойство("Терминал",       Терминал);
	БанковскаяОперация.Свойство("Назначение",     Назначение);

	AuthCode = "";
	Заказ    = Неопределено;

	БанковскаяОперация.Свойство("AuthCode", AuthCode);
	БанковскаяОперация.Свойство("Заказ",    Заказ);

	// Есть только у выписки банка: плательщик отдельным полем и его код.
	Плательщик     = "";
	КодПлательщика = "";

	БанковскаяОперация.Свойство("Плательщик",     Плательщик);
	БанковскаяОперация.Свойство("КодПлательщика", КодПлательщика);

	ИдентификаторОперации = СокрЛП(Строка(ИдентификаторОперации));

	Если ПустаяСтрока(ИдентификаторОперации) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат;
	КонецЕсли;

	// Страховка от источника, отдавшего сумму строкой.
	СуммаОперации = ЧислоИзСтрокиПриват24(СуммаОперации);

	Если СуммаОперации < 0 Тогда
		СуммаОперации = -СуммаОперации;
	КонецЕсли;

	НоваяСтрока = ДокументыКИмпорту.Добавить();

	// Ключ дедупликации = НомерВходящегоДокумента создаваемого документа.
	// Колонка и реквизит документа одной длины — Строка(30), поэтому молчаливого
	// усечения (и разъехавшегося дедупа) здесь быть не может. Если банк вернёт
	// идентификатор длиннее — операцию не берём, чтобы не создать дубль.
	Если СтрДлина(ИдентификаторОперации) > 30 Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Операция пропущена: идентификатор длиннее 30 символов — «"
			+ ИдентификаторОперации + "».");

		ДокументыКИмпорту.Удалить(НоваяСтрока);

		Возврат;

	КонецЕсли;

	НоваяСтрока.НомерДок = ИдентификаторОперации;

	НоваяСтрока.СчетОрганизации     = БанковскийСчет;
	НоваяСтрока.Подразделение       = Подразделение;
	НоваяСтрока.ОрганизацияМерчанта = ОрганизацияМерчанта;
	НоваяСтрока.ДатаПроведения  = ДатаОперации;
	НоваяСтрока.Валюта          = ВалютаОперации;

	// Дата компенсации заполняется всегда — она для проверки глазами.
	// Расхождением она становится только при наличии платежного документа
	// (см. ЗаполнитьСтрокуНайденнымДокументом): пока платеж не заведен,
	// расходиться нечему — зачисление на следующий день после оплаты
	// это нормальная работа эквайринга, а не ошибка.
	Если ЗначениеЗаполнено(ДатаКомпенсации) Тогда
		НоваяСтрока.ДатаКомпенсации = ДатаКомпенсации;
	КонецЕсли;

	НоваяСтрока.Входящий = ЭтоВходящийПлатеж;

	Если ЭтоВходящийПлатеж Тогда
		НоваяСтрока.СуммаПоступило = СуммаОперации;
		НоваяСтрока.СуммаСписано   = 0;
	Иначе
		НоваяСтрока.СуммаПоступило = 0;
		НоваяСтрока.СуммаСписано   = СуммаОперации;
	КонецЕсли;

	НоваяСтрока.Остаток    = Остаток;
	НоваяСтрока.Терминал   = СокрЛП(Терминал);
	НоваяСтрока.Содержание = СокрЛП(Назначение);
	НоваяСтрока.AuthCode   = СокрЛП(Строка(AuthCode));

	Если ЗначениеЗаполнено(Заказ) Тогда
		НоваяСтрока.Заказ             = Заказ;
		НоваяСтрока.Контрагент        = Заказ.Контрагент;
		НоваяСтрока.Договор           = Заказ.ДоговорКонтрагента;
		НоваяСтрока.СуммаЗаказа       = Заказ.СуммаДокумента;
		НоваяСтрока.Ответственный     = Заказ.Ответственный;
		НоваяСтрока.ОрганизацияЗаказа = ОрганизацияЗаказа(Заказ);

		// Платежа ещё нет — сравниваем фирму заказа с фирмой мерчанта:
		// расхождение видно сразу, не дожидаясь разнесения.
		НоваяСтрока.ОрганизацияОтличается =
			ЗначениеЗаполнено(НоваяСтрока.ОрганизацияМерчанта)
			И ЗначениеЗаполнено(НоваяСтрока.ОрганизацияЗаказа)
			И НоваяСтрока.ОрганизацияМерчанта <> НоваяСтрока.ОрганизацияЗаказа;

	КонецЕсли;

	// По умолчанию операцию не загружаем; ниже отметим к загрузке,
	// если заказ опознан, а платежного документа еще нет.
	НоваяСтрока.Загружать = Ложь;

	// Платёж эквайринга мог быть уже заведён кнопкой «Получить оплату»
	// из самого заказа — там ключ не НомерВходящегоДокумента, а AuthCode.
	Если ЗначениеЗаполнено(Заказ) И Не ПустаяСтрока(СокрЛП(Строка(AuthCode))) Тогда

		НайденныйДокумент =
			Документы.ПлатежноеПоручениеВходящее.НайтиПлатежноеПоручениеWayForPay(
				Заказ,
				AuthCode);

		Если Не ЗначениеЗаполнено(НайденныйДокумент) Тогда
			НайденныйДокумент = НайтиДокументПоБанковскойОперации(БанковскаяОперация);
		КонецЕсли;

	Иначе

		НайденныйДокумент = НайтиДокументПоБанковскойОперации(БанковскаяОперация);

	КонецЕсли;

	// Платеж по заказу могли завести вручную до появления загрузки выписок —
	// без входящего номера и кода авторизации. Такой опознаем по сумме.
	Если Не ЗначениеЗаполнено(НайденныйДокумент)
		И ЗначениеЗаполнено(Заказ)
		И ЭтоВходящийПлатеж Тогда

		НайденныйДокумент =
			Документы.ПлатежноеПоручениеВходящее.НайтиПлатежПоЗаказуИСумме(
				Заказ,
				СуммаОперации);

	КонецЕсли;

	ОтладкаВыписокСообщить(
		"Операция [" + ИдентификаторОперации + "]"
		+ " | " + ?(ЭтоВходящийПлатеж, "поступление", "списание")
		+ " | " + Формат(ДатаОперации, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ " | сумма " + Строка(СуммаОперации)
		+ " | документ: "
		+ ?(ЗначениеЗаполнено(НайденныйДокумент),
			Строка(НайденныйДокумент), "НЕ НАЙДЕН"));

	Если ЗначениеЗаполнено(НайденныйДокумент) Тогда

		ЗаполнитьСтрокуНайденнымДокументом(НоваяСтрока, НайденныйДокумент);

	ИначеЕсли ЭтоВходящийПлатеж Тогда

		// Новый платёж-поступление без документа: подставляем контрагента
		// по коду/ФИО из назначения, чтобы платежи в списке были опознаны.
		// Заказ подбирает пользователь: статусной модели "активного заказа"
		// в этой конфигурации нет.
		//
		// У выписки банка код плательщика приходит отдельным полем — это
		// надёжнее любого разбора текста, поэтому сначала он.
		КонтрагентПоКоду = НайтиКонтрагентаПоКодуВыписки(КодПлательщика);

		Если ЗначениеЗаполнено(КонтрагентПоКоду) Тогда
			НоваяСтрока.Контрагент = КонтрагентПоКоду;
		Иначе
			ЗаполнитьКонтрагентаПоНазначению(НоваяСтрока, Назначение);
		КонецЕсли;

		ОтладкаВыписокСообщить(
			"    авто-подстановка: контрагент "
			+ ?(ЗначениеЗаполнено(НоваяСтрока.Контрагент),
				Строка(НоваяСтрока.Контрагент), "—")
			+ ", к загрузке: " + ?(НоваяСтрока.Загружать, "ДА", "нет"));

	КонецЕсли;

	// Заказ опознан, документа еще нет — операцию сразу отмечаем к загрузке,
	// чтобы «Загрузить в 1С» можно было жать пачкой без ручного разбора.
	Если ЗначениеЗаполнено(Заказ) И Не ЗначениеЗаполнено(НайденныйДокумент) Тогда
		НоваяСтрока.Загружать = Истина;
	КонецЕсли;

КонецПроцедуры

// Поступления с подобранным заказом разносим автоматически: платеж создается
// сразу при получении выписки, а ответственному по заказу ставится задача
// «получена оплата». Человеку в обработке остаются только те операции,
// у которых заказ не опознан.
//
// Ответственный берется из заказа; если он сегодня не в смене (график Magento)
// или не заполнен, платеж достается наименее загруженному менеджеру смены —
// и в задаче, и в колонке «Ответственный», чтобы у заместителя работали
// отбор «Только мои заказы» и загрузка.
Процедура РазнестиПоступленияПоЗаказам(ДокументыКИмпорту, БезАвтосоздания = Неопределено)

	МенеджерыСмены = МенеджерыТекущейСмены();
	Дежурный       = Неопределено;

	Разнесено = 0;

	Для Каждого СтрокаОперации Из ДокументыКИмпорту Цикл

		Если СтрокаОперации.ЕстьДокумент
			Или Не ЗначениеЗаполнено(СтрокаОперации.Заказ)
			Или СтрокаОперации.СуммаПоступило = 0
			Или СтрокаБезАвтосоздания(БезАвтосоздания, СтрокаОперации) Тогда
			Продолжить;
		КонецЕсли;

		// Ответственный строки — он же исполнитель задачи.
		Менеджер = СтрокаОперации.Ответственный;

		Если МенеджерыСмены.Количество() > 0
			И (Не ЗначениеЗаполнено(Менеджер)
				Или МенеджерыСмены.Найти(Менеджер) = Неопределено) Тогда

			Если Дежурный = Неопределено Тогда
				Дежурный = НаименееЗагруженныйМенеджер(МенеджерыСмены);
			КонецЕсли;

			Менеджер = Дежурный;
			СтрокаОперации.Ответственный = Дежурный;

		КонецЕсли;

		Результат = СоздатьПоступлениеПоСтроке(СтрокаОперации);

		Если Не Результат.Успешно Тогда

			СтрокаОперации.Ошибка = Результат.Сообщение;

			ОтладкаВыписокСообщить(
				"    автозагрузка [" + СокрЛП(СтрокаОперации.НомерДок) + "]: "
				+ Результат.Сообщение);

			Продолжить;

		КонецЕсли;

		СтрокаОперации.Ошибка = "";

		ЗаполнитьСтрокуНайденнымДокументом(СтрокаОперации, Результат.Ссылка);

		Разнесено = Разнесено + 1;

		СоздатьЗадачуПоСозданномуПлатежу(
			СтрокаОперации.Заказ,
			Результат.Ссылка,
			Менеджер);

	КонецЦикла;

	Если Разнесено > 0 Тогда
		ОтладкаВыписокСообщить("Разнесено платежей автоматически: " + Строка(Разнесено));
	КонецЕсли;

КонецПроцедуры

// Платежное поручение входящее по строке выписки. Тот же вызов, что делает
// кнопка «Загрузить в 1С» в форме обработки: дедупликация — внутри
// СоздатьПлатежПоЗаказу, повторный запуск дублей не создает.
Функция СоздатьПоступлениеПоСтроке(СтрокаОперации)

	Платеж = Документы.ПлатежноеПоручениеВходящее.ОписаниеПлатежаПоЗаказу();

	Платеж.Сумма                   = СтрокаОперации.СуммаПоступило;
	Платеж.ДатаПлатежа             = ДатаПлатежаПоСтроке(СтрокаОперации);
	Платеж.НомерВходящегоДокумента = СтрокаОперации.НомерДок;
	Платеж.AuthCode                = СтрокаОперации.AuthCode;
	Платеж.СчетОрганизации         = СтрокаОперации.СчетОрганизации;
	// Счёт зачисления берём только из настройки источника: подставлять
	// вместо него счёт из заказа для платежа по выписке нельзя.
	Платеж.СтрогийСчет             = Истина;
	Платеж.Подразделение           = СтрокаОперации.Подразделение;
	Платеж.Контрагент              = СтрокаОперации.Контрагент;
	Платеж.ДоговорКонтрагента      = СтрокаОперации.Договор;
	Платеж.НазначениеПлатежа       = СтрокаОперации.Содержание;
	Платеж.Комментарий             = "Выписка " + СокрЛП(СтрокаОперации.НомерДок);

	Возврат Документы.ПлатежноеПоручениеВходящее.СоздатьПлатежПоЗаказу(
		СтрокаОперации.Заказ,
		Платеж);

КонецФункции

// Организация заказа. Реквизит «Организация» у заказа покупателя составной
// (организация или пользователь), поэтому лишнее отсекаем по типу.
Функция ОрганизацияЗаказа(Заказ) Экспорт

	ПустаяОрганизация = Справочники.Организации.ПустаяСсылка();

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат ПустаяОрганизация;
	КонецЕсли;

	Попытка

		Организация = Заказ.Организация;

		Если ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
			Возврат Организация;
		КонецЕсли;

	Исключение
	КонецПопытки;

	Возврат ПустаяОрганизация;

КонецФункции

// Дата создаваемого платежа: дата зачисления денег, если эквайринг ее уже
// вернул, иначе дата операции. Ставим ее сразу, чтобы платеж не оказывался
// «с расхождением» с первой же минуты жизни: у WayForPay зачисление приходит
// следующим днем. Если компенсация появится позже (платеж завели раньше, чем
// деньги зашли), строка подсветится, и дата переносится кнопкой «Изменить
// дату платежа».
Функция ДатаПлатежаПоСтроке(СтрокаОперации) Экспорт

	Если ЗначениеЗаполнено(СтрокаОперации.ДатаКомпенсации) Тогда
		Возврат СтрокаОперации.ДатаКомпенсации;
	КонецЕсли;

	Возврат СтрокаОперации.ДатаПроведения;

КонецФункции

// Платежи, у которых заказ не опознан, разбирают кассиры: на группу кассиров
// ставится одна задача со списком таких операций. Дедупликация по паре
// «исполнитель + наименование» не дает плодить задачи при повторных нажатиях
// «Получить выписку».
//
// Исполнитель — группа справочника Пользователи. Записать группу в реквизит
// адресации можно (тип тот же), но типовая выборка задач идет через
// ЗадачиПоИсполнителю(ТекущийПользователь) и групп не раскрывает: чтобы
// кассиры видели такую задачу, отбор в формах списка и оповещения о задачах
// должен учитывать группы пользователя. Это правится в Конфигураторе,
// в двоичных типовых формах.
Процедура СоздатьЗадачиКассирам(ДокументыКИмпорту, БезАвтосоздания = Неопределено)

	СписокПлатежей = Новый Массив;

	Для Каждого СтрокаОперации Из ДокументыКИмпорту Цикл

		Если СтрокаОперации.ЕстьДокумент
			Или ЗначениеЗаполнено(СтрокаОперации.Заказ)
			Или СтрокаОперации.СуммаПоступило = 0
			Или СтрокаБезАвтосоздания(БезАвтосоздания, СтрокаОперации) Тогда
			Продолжить;
		КонецЕсли;

		СписокПлатежей.Добавить(
			СокрЛП(СтрокаОперации.НомерДок)
			+ " от " + Формат(СтрокаОперации.ДатаПроведения, "ДФ=dd.MM.yyyy")
			+ " — " + СокрЛП(Строка(СтрокаОперации.Контрагент))
			+ ", сумма " + Строка(СтрокаОперации.СуммаПоступило));

	КонецЦикла;

	Если СписокПлатежей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Группа = ГруппаКассиров();

	Если Не ЗначениеЗаполнено(Группа) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"В справочнике Пользователи не найдена группа кассиров"
			+ " — задача по платежам без заказа не поставлена.");

		Возврат;

	КонецЕсли;

	СоздатьЗадачуКассиру(Группа, СписокПлатежей);

КонецПроцедуры

Функция ГруппаКассиров()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ЭтоГруппа
	|	И НЕ Пользователи.ПометкаУдаления
	|	И (Пользователи.Наименование ПОДОБНО &ШаблонУкр
	|		ИЛИ Пользователи.Наименование ПОДОБНО &ШаблонРус)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пользователи.Наименование";

	// Группа кассиров опознается по наименованию: ни реквизита-признака,
	// ни предопределенного элемента у нее нет.
	Запрос.УстановитьПараметр("ШаблонУкр", "%Касир%");
	Запрос.УстановитьПараметр("ШаблонРус", "%Кассир%");

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Пользователи.ПустаяСсылка();

КонецФункции

// Менеджеры текущей смены: табличная часть последнего проведенного
// документа «График работы менеджеров Magento» — точно так же текущую
// смену определяет распределение предзаказов (Справочники.Пользователи).
// Пустой массив = графиков в базе нет, переназначение не выполняется.
Функция МенеджерыТекущейСмены()

	Менеджеры = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(График.Номер) КАК Номер
	|ПОМЕСТИТЬ ВТПоследнийГрафик
	|ИЗ
	|	Документ.БП_ГрафикРаботыМенеджеровMagento КАК График
	|ГДЕ
	|	НЕ График.ПометкаУдаления
	|	И График.Проведен
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГрафикМенеджера.Менеджер КАК Менеджер
	|ИЗ
	|	Документ.БП_ГрафикРаботыМенеджеровMagento.Менеджера КАК ГрафикМенеджера
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПоследнийГрафик КАК ВТПоследнийГрафик
	|		ПО ГрафикМенеджера.Ссылка.Номер = ВТПоследнийГрафик.Номер
	|ГДЕ
	|	ГрафикМенеджера.Менеджер <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Менеджеры.Добавить(Выборка.Менеджер);
	КонецЦикла;

	Возврат Менеджеры;

КонецФункции

// Менеджер смены с наименьшим числом невыполненных задач по выпискам.
Функция НаименееЗагруженныйМенеджер(МенеджерыСмены)

	Если МенеджерыСмены.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачиПользователя.Исполнитель КАК Исполнитель,
	|	КОЛИЧЕСТВО(ЗадачиПользователя.Ссылка) КАК КоличествоЗадач
	|ИЗ
	|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
	|ГДЕ
	|	НЕ ЗадачиПользователя.Выполнена
	|	И ЗадачиПользователя.Наименование ПОДОБНО &Наименование
	|	И ЗадачиПользователя.Исполнитель В(&Исполнители)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗадачиПользователя.Исполнитель";

	// Загрузку считаем по невыполненным задачам об оплатах: с переходом
	// на задачу по каждому платежу общей задачи «разнести платежи»
	// у менеджеров больше нет.
	Запрос.УстановитьПараметр("Наименование", НачалоНаименованияЗадачиОбОплате() + "%");
	Запрос.УстановитьПараметр("Исполнители", МенеджерыСмены);

	Загрузка = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Загрузка.Вставить(Выборка.Исполнитель, Выборка.КоличествоЗадач);
	КонецЦикла;

	Выбранный        = МенеджерыСмены[0];
	МинимумЗадач     = Неопределено;

	Для Каждого Менеджер Из МенеджерыСмены Цикл

		ЗадачМенеджера = Загрузка[Менеджер];

		Если ЗадачМенеджера = Неопределено Тогда
			ЗадачМенеджера = 0;
		КонецЕсли;

		Если МинимумЗадач = Неопределено Или ЗадачМенеджера < МинимумЗадач Тогда
			МинимумЗадач = ЗадачМенеджера;
			Выбранный    = Менеджер;
		КонецЕсли;

	КонецЦикла;

	Возврат Выбранный;

КонецФункции

// Наименование задачи кассирам: платежи, по которым заказ не опознан.
Функция НаименованиеЗадачиПоВыписке()

	Возврат "Разнести платежи из банковской выписки";

КонецФункции

// Начало наименования задачи о поступившей оплате по заказу. По нему же
// задачи опознаются при открытии (ЭтоЗадачаПоВыписке) и считается загрузка
// менеджеров.
Функция НачалоНаименованияЗадачиОбОплате()

	Возврат "Оплачен заказ";

КонецФункции

// Задача поставлена загрузкой выписки? По таким задачам форма задачи вместо
// себя открывает обработку «Банковские выписки».
Функция ЭтоЗадачаПоВыписке(Задача) Экспорт

	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка

		Наименование = СокрЛП(Строка(Задача.Наименование));

		Возврат Лев(Наименование, СтрДлина(НачалоНаименованияЗадачиОбОплате()))
				= НачалоНаименованияЗадачиОбОплате()
			Или Наименование = НаименованиеЗадачиПоВыписке();

	Исключение

		Возврат Ложь;

	КонецПопытки;

КонецФункции

// Помечает задачу выполненной. Зовется из формы задачи в момент открытия:
// задача — это уведомление «зайди в обработку», а не единица работы,
// поэтому она закрывается самим фактом перехода в обработку.
Процедура ВыполнитьЗадачуПоВыписке(Задача) Экспорт

	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		ЗадачаОбъект = Задача.ПолучитьОбъект();

		Если ЗадачаОбъект = Неопределено Или ЗадачаОбъект.Выполнена Тогда
			Возврат;
		КонецЕсли;

		ЗадачаОбъект.Выполнена      = Истина;
		ЗадачаОбъект.ДатаИсполнения = ТекущаяДата();

		ЗадачаОбъект.Записать();

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не удалось выполнить задачу «" + Строка(Задача)
			+ "»: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Задача ответственному менеджеру заказа о созданном платежном документе.
// Вызывается после «Загрузить в 1С» из обработки БанковскиеВыписки.
//
// Дубль отсекается по паре «заказ + наименование» (в наименовании — номер
// платежного документа), выполненные задачи тоже считаются: повторное
// создание задачи по тому же платежу невозможно.
Процедура СоздатьЗадачуПоСозданномуПлатежу(
	Заказ,
	ПлатежныйДокумент,
	Исполнитель = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Заказ)
		Или Не ЗначениеЗаполнено(ПлатежныйДокумент) Тогда
		Возврат;
	КонецЕсли;

	// Исполнитель передается автозагрузкой (там уже учтена смена и тестовый
	// режим); при ручной загрузке из формы берется ответственный заказа.
	Ответственный = Исполнитель;

	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = Заказ.Ответственный;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Ответственный) Тогда
		Возврат;
	КонецЕсли;

	Наименование = Лев(
		НачалоНаименованияЗадачиОбОплате() + " " + СокрЛП(Заказ.Номер)
		+ " — платеж " + СокрЛП(Строка(ПлатежныйДокумент.Номер)),
		100);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗадачиПользователя.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
	|ГДЕ
	|	ЗадачиПользователя.Объект = &Объект
	|	И ЗадачиПользователя.Наименование = &Наименование";

	Запрос.УстановитьПараметр("Объект", Заказ);
	Запрос.УстановитьПараметр("Наименование", Наименование);

	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;

	// Ошибка постановки задачи не должна валить создание платежей.
	Попытка

		Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();

		Задача.Наименование   = Наименование;
		Задача.Объект         = Заказ;
		Задача.Исполнитель    = Ответственный;
		Задача.Дата           = ТекущаяДата();
		Задача.СрокИсполнения = КонецДня(Задача.Дата);
		Задача.Оповещение     = Истина;
		Задача.СрокОповещения = Задача.Дата;

		Задача.Описание =
			"По заказу " + Строка(Заказ)
			+ " создан платежный документ " + Строка(ПлатежныйДокумент)
			+ " на сумму " + Строка(ПлатежныйДокумент.СуммаДокумента) + ".";

		Задача.Записать();

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не удалось создать задачу о платеже «"
			+ Строка(ПлатежныйДокумент) + "»: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Задача на группу кассиров: платежи, по которым заказ не опознан. Пока
// у группы висит невыполненная задача с этим наименованием, новая не
// создается — повторные нажатия «Получить выписку» задач не плодят. Если
// задачу закрыли, а неопознанные платежи остались, следующая загрузка
// поставит ее заново.
Процедура СоздатьЗадачуКассиру(Кассир, СписокПлатежей)

	НаименованиеЗадачи = НаименованиеЗадачиПоВыписке();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗадачиПользователя.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
	|ГДЕ
	|	НЕ ЗадачиПользователя.Выполнена
	|	И ЗадачиПользователя.Исполнитель = &Исполнитель
	|	И ЗадачиПользователя.Наименование = &Наименование";

	Запрос.УстановитьПараметр("Исполнитель", Кассир);
	Запрос.УстановитьПараметр("Наименование", НаименованиеЗадачи);

	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;

	// Ошибка постановки задачи не должна валить загрузку выписки.
	Попытка

		Описание =
			"В банковской выписке есть платежи, по которым не опознан заказ"
			+ " — откройте обработку, подберите заказ или контрагента"
			+ " и разнесите платежи:";

		Для Каждого СтрокаПлатежа Из СписокПлатежей Цикл
			Описание = Описание + Символы.ПС + СтрокаПлатежа;
		КонецЦикла;

		Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();

		Задача.Наименование   = НаименованиеЗадачи;
		Задача.Исполнитель    = Кассир;
		Задача.Дата           = ТекущаяДата();
		Задача.СрокИсполнения = КонецДня(Задача.Дата);
		Задача.Оповещение     = Истина;
		Задача.СрокОповещения = Задача.Дата;
		Задача.Описание       = Описание;

		Задача.Записать();

		ОтладкаВыписокСообщить(
			"Задача кассиру " + Строка(Кассир)
			+ ": платежей без заказа " + Строка(СписокПлатежей.Количество()));

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не удалось создать задачу для «" + Строка(Кассир)
			+ "»: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

Процедура ЗаполнитьСтрокуНайденнымДокументом(
	СтрокаИмпорта,
	ДокументОплаты) Экспорт

	Если Не ЗначениеЗаполнено(ДокументОплаты) Тогда
		Возврат;
	КонецЕсли;

	// Маркер «строка уже принята»: по нему отбор «Только новые» на форме
	// убирает уже загруженные платежи — и входящие ПП, и исходящие, и ПКО.
	СтрокаИмпорта.ПлатежныйДокумент = ДокументОплаты;
	СтрокаИмпорта.ЕстьДокумент      = Истина;

	// Реквизиты есть не у всех трёх типов документов (у ПКО нет договора
	// и документа-основания), поэтому читаем через Попытка.
	Попытка
		СтрокаИмпорта.Заказ = ДокументОплаты.ДокументОснование;
		Если ЗначениеЗаполнено(СтрокаИмпорта.Заказ) Тогда
			СтрокаИмпорта.Ответственный = СтрокаИмпорта.Заказ.Ответственный;
			СтрокаИмпорта.СуммаЗаказа   = СтрокаИмпорта.Заказ.СуммаДокумента;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаИмпорта.Контрагент = ДокументОплаты.Контрагент;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаИмпорта.Договор = ДокументОплаты.ДоговорКонтрагента;
	Исключение
	КонецПопытки;

	СтрокаИмпорта.Загружать = Ложь;

	// Счет организации платежа против счета из настройки подразделения:
	// деньги пришли на один счет, а платеж заведен на другой — это ошибка
	// разнесения, и увидеть ее нужно сразу в списке.
	Попытка

		СтрокаИмпорта.СчетПлатежа = ДокументОплаты.СчетОрганизации;

		СтрокаИмпорта.СчетОтличается =
			ЗначениеЗаполнено(СтрокаИмпорта.СчетОрганизации)
			И ЗначениеЗаполнено(СтрокаИмпорта.СчетПлатежа)
			И СтрокаИмпорта.СчетПлатежа <> СтрокаИмпорта.СчетОрганизации;

	Исключение
		// У ПКО реквизита может не быть.
	КонецПопытки;

	// Организация платежа против организации заказа: платеж, заведенный
	// не на ту фирму, виден только так — в самом документе он выглядит
	// нормально.
	Попытка

		СтрокаИмпорта.ОрганизацияПлатежа = ДокументОплаты.Организация;

		Если Не ЗначениеЗаполнено(СтрокаИмпорта.ОрганизацияЗаказа)
			И ЗначениеЗаполнено(СтрокаИмпорта.Заказ) Тогда

			СтрокаИмпорта.ОрганизацияЗаказа = ОрганизацияЗаказа(СтрокаИмпорта.Заказ);

		КонецЕсли;

		СтрокаИмпорта.ОрганизацияОтличается =
			ЗначениеЗаполнено(СтрокаИмпорта.ОрганизацияЗаказа)
			И ЗначениеЗаполнено(СтрокаИмпорта.ОрганизацияПлатежа)
			И СтрокаИмпорта.ОрганизацияПлатежа <> СтрокаИмпорта.ОрганизацияЗаказа;

	Исключение
	КонецПопытки;

	// Расхождение — это когда дата платежного документа не совпадает с датой
	// зачисления из API, причем точно, до секунды: платеж должен стоять ровно
	// на дате компенсации. Сравниваем именно с документом, а не с датой
	// операции банка — «оплата вчера, зачисление сегодня» это норма
	// эквайринга. Строки без документа расхождением быть не могут.
	Если ЗначениеЗаполнено(СтрокаИмпорта.ДатаКомпенсации) Тогда

		СтрокаИмпорта.ДатаКомпенсацииОтличается =
			(ДокументОплаты.Дата <> СтрокаИмпорта.ДатаКомпенсации);

	Иначе

		СтрокаИмпорта.ДатаКомпенсацииОтличается = Ложь;

	КонецЕсли;

КонецПроцедуры

// Авто-подстановка контрагента для нового платежа-поступления по тексту
// назначения ("Від: <ФИО>. ... <код контрагента>").
Процедура ЗаполнитьКонтрагентаПоНазначению(СтрокаИмпорта, Назначение)

	Если ПустаяСтрока(СокрЛП(Строка(Назначение))) Тогда
		Возврат;
	КонецЕсли;

	НайденоПоКоду = Ложь;
	Контрагент = НайтиКонтрагентаПоНазначению(Назначение, НайденоПоКоду);

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СтрокаИмпорта.Контрагент = Контрагент;
	Исключение
	КонецПопытки;

	// Контрагент опознан по коду из назначения — платёж сразу отмечаем
	// к загрузке (совпадение кода — надёжный признак).
	Если НайденоПоКоду Тогда
		Попытка
			СтрокаИмпорта.Загружать = Истина;
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

// Контрагент по назначению: сначала по коду (9 цифр), затем по ФИО из "Від:".
// НайденоПоКоду возвращает Истина, если совпал именно код.
Функция НайтиКонтрагентаПоНазначению(Назначение, НайденоПоКоду = Ложь)

	НайденоПоКоду = Ложь;

	Код = ИзвлечьКодКонтрагентаИзНазначения(Назначение);

	Если Не ПустаяСтрока(Код) Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Код = &Код
		|	И НЕ Контрагенты.ПометкаУдаления";

		Запрос.УстановитьПараметр("Код", Код);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			НайденоПоКоду = Истина;
			Возврат Выборка.Ссылка;
		КонецЕсли;

	КонецЕсли;

	ФИО = ИзвлечьФИООтправителяИзНазначения(Назначение);

	Если Не ПустаяСтрока(ФИО) Тогда

		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(ФИО, Истина);

		Если ЗначениеЗаполнено(Контрагент) Тогда
			Возврат Контрагент;
		КонецЕсли;

	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Код контрагента — ровно 9 цифр (Справочник.Контрагенты, фикс. длина кода 9).
Функция ИзвлечьКодКонтрагентаИзНазначения(Назначение)

	Текст = Строка(Назначение);
	Цифры = "";

	Для Позиция = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Позиция, 1);

		Если Найти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		Иначе
			Если СтрДлина(Цифры) = 9 Тогда
				Возврат Цифры;
			КонецЕсли;
			Цифры = "";
		КонецЕсли;

	КонецЦикла;

	Если СтрДлина(Цифры) = 9 Тогда
		Возврат Цифры;
	КонецЕсли;

	Возврат "";

КонецФункции

// ФИО отправителя после "Від:" / "От:" / "Отправитель:" — до первой точки.
Функция ИзвлечьФИООтправителяИзНазначения(Назначение)

	Текст = Строка(Назначение);

	Метки = Новый Массив;
	Метки.Добавить("Від:");
	Метки.Добавить("От:");
	Метки.Добавить("Отправитель:");

	Для Каждого Метка Из Метки Цикл

		Поз = Найти(Текст, Метка);

		Если Поз > 0 Тогда

			Хвост = Сред(Текст, Поз + СтрДлина(Метка));

			ПозТочки = Найти(Хвост, ".");
			Если ПозТочки > 0 Тогда
				Хвост = Лев(Хвост, ПозТочки - 1);
			КонецЕсли;

			Возврат СокрЛП(Хвост);

		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

#КонецОбласти

#Область ПоискСуществующихПлатежныхДокументов

// Универсальный поиск существующего платёжного документа, чтобы не создавать
// платежи повторно.
//   Вариант 1 — передана структура банковской операции: поиск по направлению.
//   Вариант 2 — переданы код (НомерВходящегоДокумента) и дата: возвращаем
//               существующее ПлатежноеПоручениеВходящее либо пустую ссылку.
Функция НайтиДокументПоБанковскойОперации(Операция, Дата = Неопределено) Экспорт

	Если ТипЗнч(Операция) = Тип("Структура")
		Или ТипЗнч(Операция) = Тип("Соответствие") Тогда

		Возврат НайтиДокументПоСтруктуреОперации(Операция);

	КонецЕсли;

	Ссылка = НайтиВходящийБанковскийПлатеж(СокрЛП(Строка(Операция)), Дата);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Ссылка = НайтиПлатежноеПоручениеИсходящееПоОперации(
		СокрЛП(Строка(Операция)),
		Дата);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка();

КонецФункции

Функция НайтиДокументПоСтруктуреОперации(БанковскаяОперация) Экспорт

	Если БанковскаяОперация = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИдентификаторОперации = "";
	ДатаОперации          = Неопределено;
	ЭтоВходящийПлатеж     = Ложь;

	Если Не БанковскаяОперация.Свойство(
		"Идентификатор",
		ИдентификаторОперации) Тогда

		Возврат Неопределено;

	КонецЕсли;

	Если Не БанковскаяОперация.Свойство("Дата", ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не БанковскаяОперация.Свойство("Входящий", ЭтоВходящийПлатеж) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИдентификаторОперации = СокрЛП(Строка(ИдентификаторОперации));

	Если ПустаяСтрока(ИдентификаторОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ЭтоВходящийПлатеж Тогда

		Возврат НайтиВходящийБанковскийПлатеж(
			ИдентификаторОперации,
			ДатаОперации);

	Иначе

		Возврат НайтиИсходящийБанковскийПлатеж(
			ИдентификаторОперации,
			ДатаОперации);

	КонецЕсли;

КонецФункции

// Реализация живёт в модуле менеджера документа: платёжная часть (эквайринг
// WayForPay) не должна зависеть от загрузки выписок, а наоборот — можно.
Функция НайтиВходящийБанковскийПлатеж(
	ИдентификаторОперации,
	ДатаОперации) Экспорт

	Возврат Документы.ПлатежноеПоручениеВходящее.НайтиПоНомеруВходящегоДокумента(
		ИдентификаторОперации,
		ДатаОперации);

КонецФункции

Функция НайтиИсходящийБанковскийПлатеж(
	ИдентификаторОперации,
	ДатаОперации) Экспорт

	ДокументОплаты = НайтиПлатежноеПоручениеИсходящееПоОперации(
		ИдентификаторОперации,
		ДатаОперации);

	Если ЗначениеЗаполнено(ДокументОплаты) Тогда
		Возврат ДокументОплаты;
	КонецЕсли;

	Возврат НайтиКассовыйОрдерПоБанковскойОперации(
		ИдентификаторОперации,
		ДатаОперации);

КонецФункции

Функция НайтиПлатежноеПоручениеИсходящееПоОперации(
	ИдентификаторОперации,
	ДатаОперации) Экспорт

	Если ПустаяСтрока(СокрЛП(Строка(ИдентификаторОперации))) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПлатежноеПоручениеИсходящее.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПлатежноеПоручениеИсходящее КАК ПлатежноеПоручениеИсходящее
	|ГДЕ
	|	НЕ ПлатежноеПоручениеИсходящее.ПометкаУдаления
	|	И ПлатежноеПоручениеИсходящее.Проведен
	|	И ПлатежноеПоручениеИсходящее.НомерВходящегоДокумента
	|		= &ИдентификаторОперации
	|	И ПлатежноеПоручениеИсходящее.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПлатежноеПоручениеИсходящее.Дата УБЫВ";

	УстановитьПараметрыПоискаПлатежа(
		Запрос,
		ИдентификаторОперации,
		ДатаОперации);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция НайтиКассовыйОрдерПоБанковскойОперации(
	ИдентификаторОперации,
	ДатаОперации) Экспорт

	Если ПустаяСтрока(СокрЛП(Строка(ИдентификаторОперации))) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПриходныйКассовыйОрдер.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	НЕ ПриходныйКассовыйОрдер.ПометкаУдаления
	|	И ПриходныйКассовыйОрдер.Проведен
	|	И ПриходныйКассовыйОрдер.НомерВходящегоДокумента
	|		= &ИдентификаторОперации
	|	И ПриходныйКассовыйОрдер.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриходныйКассовыйОрдер.Дата УБЫВ";

	УстановитьПараметрыПоискаПлатежа(
		Запрос,
		ИдентификаторОперации,
		ДатаОперации);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Окно поиска ±2 дня: дата документа может отличаться от даты операции
// (банк проводит операцию задним числом либо документ создан позже).
Процедура УстановитьПараметрыПоискаПлатежа(
	Запрос,
	ИдентификаторОперации,
	ДатаОперации)

	Запрос.УстановитьПараметр(
		"ИдентификаторОперации",
		СокрЛП(Строка(ИдентификаторОперации)));

	Запрос.УстановитьПараметр(
		"НачалоПериода",
		НачалоДня(ДатаОперации - 2 * 24 * 60 * 60));

	Запрос.УстановитьПараметр(
		"КонецПериода",
		КонецДня(ДатаОперации + 2 * 24 * 60 * 60));

КонецПроцедуры

// === Обёртки со старыми именами: их зовёт форма обработки ОбменПриват24 ===

Функция ПолучитьПлатежноеПоручениеПоКодуПриват24(Код, Дата) Экспорт

	Результат = НайтиВходящийБанковскийПлатеж(Код, Дата);

	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка();

КонецФункции

// Ищет уже существующее исходящее ПП по НомерВходящегоДокумента независимо
// от того, проведено оно или только записано (условие "И Проведен"
// пропускало непроведённые дубли).
Функция ПолучитьПлатежноеПоручениеИсходящееПоКодуПриват24(Код, Дата) Экспорт

	Результат = НайтиПлатежноеПоручениеИсходящееПоОперации(Код, Дата);

	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Документы.ПлатежноеПоручениеИсходящее.ПустаяСсылка();

КонецФункции

Функция ПолучитьПриходныйКассовыйОрдерПоКодуПриват24(Код, Дата) Экспорт

	Результат = НайтиКассовыйОрдерПоБанковскойОперации(Код, Дата);

	Если ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Документы.ПриходныйКассовыйОрдер.ПустаяСсылка();

КонецФункции

#КонецОбласти

#Область Приват24Бизнес

Функция ПолучитьОперацииПриват24Бизнес(
	Настройка,
	ДатаНачала,
	ДатаКонца) Экспорт

	Операции = Новый Массив;

	Если Настройка = Неопределено Тогда
		Возврат Операции;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат Операции;

	КонецЕсли;

	Токен                = СокрЛП(Строка(Настройка.Токен));
	ИдентификаторКлиента = СокрЛП(Строка(Настройка.Айди));

	Если ПустаяСтрока(Токен) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Приват24Бизнес",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Настройка.Подразделение,
			"Не заполнен токен Приват24 Бизнес.");

		Возврат Операции;

	КонецЕсли;

	Если ПустаяСтрока(ИдентификаторКлиента) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Приват24Бизнес",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Настройка.Подразделение,
			"Не заполнен идентификатор (Айди) Приват24 Бизнес.");

		Возврат Операции;

	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	SSL = Новый ЗащищенноеСоединениеOpenSSL();

	UserAgentHeaders =
		"1C+EnterpriseV2|8.3|TcK|2434509383|3.0.3.4|UTP|1.2.11.1"
		+ "|8.3.10.2772|CS|OP|ru|Windows|Windows x86|";

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("User-Agent", UserAgentHeaders);
	Заголовки.Вставить("id", ИдентификаторКлиента);
	Заголовки.Вставить("token", Токен);
	Заголовки.Вставить("Content-Type", "application/json;charset=utf8");

	сДатаНачала = Формат(НачалоДня(ДатаНачала), "ДФ=dd-MM-yyyy");
	сДатаКонца  = Формат(НачалоДня(ДатаКонца),  "ДФ=dd-MM-yyyy");

	// Таймаут обязателен: зависший запрос к банку повесил бы регламентное
	// задание до перезапуска сервиса.
	Соединение = Новый HTTPСоединение("acp.privatbank.ua", , , , , 60, SSL);

	ОбработанныеИД        = Новый Соответствие;
	СледующаяСтраница     = "";
	ЕстьСледующаяСтраница = Истина;
	ОбработаноСтраниц     = 0;
	МаксимумСтраниц       = 1000; // страховка от зацикливания

	// Периодный эндпоинт отдаёт операции только за ЗАКРЫТЫЕ операционные дни.
	// Операции текущего дня доступны только через interim — запрашиваем его
	// второй фазой, если период захватывает сегодня. Дубли между фазами
	// отсекаются по ОбработанныеИД, дубли документов — по "D"+REF.
	ОчередьРесурсов = Новый Массив;
	ОчередьРесурсов.Добавить(
		"/api/statements/transactions?startDate=" + сДатаНачала
		+ "&endDate=" + сДатаКонца
		+ "&limit=200");

	Если КонецДня(ДатаКонца) >= НачалоДня(ТекущаяДата()) Тогда
		// у interim максимум limit=100 (ограничение Автоклиента)
		ОчередьРесурсов.Добавить(
			"/api/statements/transactions/interim?limit=100");
	КонецЕсли;

	ИндексРесурса = 0;

	Пока ЕстьСледующаяСтраница И ОбработаноСтраниц < МаксимумСтраниц Цикл

		ОбработаноСтраниц = ОбработаноСтраниц + 1;

		РесурсНаСервере = ОчередьРесурсов[ИндексРесурса];

		Если Не ПустаяСтрока(СледующаяСтраница) Тогда
			РесурсНаСервере = РесурсНаСервере
				+ "&followId=" + СледующаяСтраница;
		КонецЕсли;

		Запрос = Новый HTTPЗапрос(РесурсНаСервере, Заголовки);

		Попытка
			Ответ = Соединение.Получить(Запрос);
		Исключение
			ЗаписьЖурналаРегистрации(
				"БанковскиеВыписки.Приват24Бизнес",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Настройка.Подразделение,
				"Ошибка подключения к Приват24 Бизнес: " + ОписаниеОшибки());
			Прервать;
		КонецПопытки;

		КодСостояния = Ответ.КодСостояния;
		СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку();

		ОтладкаВыписокСообщить(
			"Приват24: запрос " + РесурсНаСервере
			+ ", код ответа " + Строка(КодСостояния));
		ОтладкаВыписокСообщить(
			"Приват24: тело ответа: " + Лев(СокрЛП(СтрокаОтвета), 1500));

		Если КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации(
				"БанковскиеВыписки.Приват24Бизнес",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Настройка.Подразделение,
				"Приват24 Бизнес вернул код HTTP " + Строка(КодСостояния)
				+ ". Ответ: " + Лев(СтрокаОтвета, 1000));
			Прервать;
		КонецЕсли;

		Если ПустаяСтрока(СокрЛП(СтрокаОтвета)) Тогда
			Прервать;
		КонецЕсли;

		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
			Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
			ЧтениеJSON.Закрыть();
		Исключение
			ЗаписьЖурналаРегистрации(
				"БанковскиеВыписки.Приват24Бизнес",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Настройка.Подразделение,
				"Не удалось разобрать JSON Приват24 Бизнес: "
				+ ОписаниеОшибки());
			Прервать;
		КонецПопытки;

		Статус = "";
		Попытка
			Данные.Свойство("status", Статус);
		Исключение
		КонецПопытки;

		Если ВРег(СокрЛП(Строка(Статус))) <> "SUCCESS" Тогда
			ЗаписьЖурналаРегистрации(
				"БанковскиеВыписки.Приват24Бизнес",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Настройка.Подразделение,
				"Приват24 Бизнес вернул статус """ + Строка(Статус)
				+ """. Ответ: " + Лев(СтрокаОтвета, 1000));
			Прервать;
		КонецЕсли;

		Транзакции = Неопределено;
		Данные.Свойство("transactions", Транзакции);

		Если ТипЗнч(Транзакции) = Тип("Массив") Тогда

			Для Каждого Оплата Из Транзакции Цикл

				Операция = ПреобразоватьОперациюПриват24Бизнес(
					Оплата,
					Настройка);

				Если Операция = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				// Защита от дублей между страницами — по полному ID
				// (уникальному), т.к. Идентификатор строится из REF
				// и может повторяться (REFN).
				КлючДубля = Операция.КлючДубляСтраниц;
				Если ПустаяСтрока(КлючДубля) Тогда
					КлючДубля = Операция.Идентификатор;
				КонецЕсли;

				Если ОбработанныеИД.Получить(КлючДубля) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;

				ОбработанныеИД.Вставить(КлючДубля, Истина);
				Операции.Добавить(Операция);

			КонецЦикла;

		КонецЕсли;

		// Постраничная выборка, если API её поддерживает.
		ЕстьСледующаяСтраница = Ложь;
		ПризнакСледующей      = Ложь;

		Попытка
			Данные.Свойство("exist_next_page", ПризнакСледующей);
		Исключение
		КонецПопытки;

		Если ПризнакСледующей = Истина Тогда

			НовыйИдСтраницы = "";
			Попытка
				Данные.Свойство("next_page_id", НовыйИдСтраницы);
			Исключение
			КонецПопытки;

			НовыйИдСтраницы = СокрЛП(Строка(НовыйИдСтраницы));

			Если Не ПустаяСтрока(НовыйИдСтраницы)
				И НовыйИдСтраницы <> СледующаяСтраница Тогда

				СледующаяСтраница     = НовыйИдСтраницы;
				ЕстьСледующаяСтраница = Истина;

			КонецЕсли;

		КонецЕсли;

		// Страницы текущего эндпоинта кончились — переходим к следующему
		// (interim за текущий день).
		Если Не ЕстьСледующаяСтраница
			И ИндексРесурса < ОчередьРесурсов.Количество() - 1 Тогда

			ИндексРесурса         = ИндексРесурса + 1;
			СледующаяСтраница     = "";
			ЕстьСледующаяСтраница = Истина;

		КонецЕсли;

	КонецЦикла;

	ОтладкаВыписокСообщить(
		"Приват24: итого операций получено: " + Строка(Операции.Количество()));

	Возврат Операции;

КонецФункции

Функция ПреобразоватьОперациюПриват24Бизнес(Оплата, Настройка)

	Если ТипЗнч(Оплата) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Полный ID Приват24 (REF+REFN+дата+время+тип) — уникальный, нужен только
	// для защиты от дублей между страницами ответа.
	ПолныйИД = "";
	Оплата.Свойство("ID", ПолныйИД);
	ПолныйИД = СокрЛП(Строка(ПолныйИД));

	// REF — по нему формируется НомерВходящегоДокумента ("D" + REF).
	// Ключ операции строим именно из REF: полный ID ломает дедупликацию.
	Реф = "";
	Оплата.Свойство("REF", Реф);
	Реф = СокрЛП(Строка(Реф));

	// Подстраховка: если REF пуст — берём полный ID, чтобы не потерять операцию.
	Если ПустаяСтрока(Реф) Тогда
		Реф = ПолныйИД;
	КонецЕсли;

	Если ПустаяСтрока(Реф) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДатаСтрокой = "";
	Оплата.Свойство("DATE_TIME_DAT_OD_TIM_P", ДатаСтрокой);
	ДатаОперации = ДатаИзСтрокиПриват24(ДатаСтрокой);

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	СуммаСтрокой = "";
	Оплата.Свойство("SUM", СуммаСтрокой);
	СуммаОперации = ЧислоИзСтрокиПриват24(СуммаСтрокой);

	ТипТранзакции = "";
	Оплата.Свойство("TRANTYPE", ТипТранзакции);
	ТипТранзакции = ВРег(СокрЛП(Строка(ТипТранзакции)));
	ЭтоВходящий = (ТипТранзакции = "C");

	Терминал = "";
	Оплата.Свойство("AUT_CNTR_MFO_NAME", Терминал);

	Назначение = "";
	Оплата.Свойство("OSND", Назначение);

	Операция = СоздатьБанковскуюОперацию();

	Операция.Источник         = "Приват24Бизнес";
	Операция.Идентификатор    = "D" + Реф;
	Операция.КлючДубляСтраниц = "D" + ?(ПустаяСтрока(ПолныйИД), Реф, ПолныйИД);
	Операция.БанковскийСчет   = Настройка.БанковскийСчет;
	Операция.Подразделение    = Настройка.Подразделение;
	Операция.ОрганизацияМерчанта = Настройка.ОрганизацияМерчанта;
	Операция.Дата             = ДатаОперации;
	Операция.Сумма            = СуммаОперации;
	Операция.Валюта           = ПолучитьВалютуГривна();
	Операция.Входящий         = ЭтоВходящий;
	Операция.Остаток          = 0;

	// В колонке «Источник» обработки должно быть видно, откуда строка:
	// у Приват24 это банк-корреспондент, само по себе не говорящее.
	Операция.Терминал         = Лев(
		"Приват24"
		+ ?(ПустаяСтрока(СокрЛП(Строка(Терминал))),
			"", ": " + СокрЛП(Строка(Терминал))),
		256);

	Операция.Назначение       = СокрЛП(Строка(Назначение));

	Возврат Операция;

КонецФункции

Функция ДатаИзСтрокиПриват24(Знач Текст)

	Текст = СокрЛП(Строка(Текст));

	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастиДатаВремя = РазложитьСтрокуПоРазделителю(Текст, " ");

	Если ЧастиДатаВремя.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастьДаты    = ЧастиДатаВремя[0];
	ЧастьВремени = ?(ЧастиДатаВремя.Количество() > 1,
		ЧастиДатаВремя[1], "00:00:00");

	КомпонентыДаты = РазложитьСтрокуПоРазделителю(ЧастьДаты, ".");

	Если КомпонентыДаты.Количество() < 3 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КомпонентыВремени = РазложитьСтрокуПоРазделителю(ЧастьВремени, ":");

	Попытка
		Год     = Число(КомпонентыДаты[2]);
		Месяц   = Число(КомпонентыДаты[1]);
		День    = Число(КомпонентыДаты[0]);
		Час     = ?(КомпонентыВремени.Количество() > 0,
			Число(КомпонентыВремени[0]), 0);
		Минута  = ?(КомпонентыВремени.Количество() > 1,
			Число(КомпонентыВремени[1]), 0);
		Секунда = ?(КомпонентыВремени.Количество() > 2,
			Число(КомпонентыВремени[2]), 0);
		Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ЧислоИзСтрокиПриват24(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, ",", ".");

	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Monobank

Функция ПолучитьОперацииMonobank(Настройка, ДатаНачала, ДатаКонца) Экспорт

	Операции = Новый Массив;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат Операции;

	КонецЕсли;

	// Monobank отдаёт не более 31 дня за запрос — режем период на отрезки.
	ТекущаяДатаНачала = НачалоДня(ДатаНачала);

	Пока ТекущаяДатаНачала <= ДатаКонца Цикл

		ТекущаяДатаКонца = ТекущаяДатаНачала + 29 * 24 * 60 * 60;

		Если ТекущаяДатаКонца > ДатаКонца Тогда
			ТекущаяДатаКонца = ДатаКонца;
		Иначе
			ТекущаяДатаКонца = КонецДня(ТекущаяДатаКонца);
		КонецЕсли;

		ОперацииЗаПериод = ПолучитьОперацииMonobankЗаПериод(
			Настройка,
			ТекущаяДатаНачала,
			ТекущаяДатаКонца);

		Для Каждого Операция Из ОперацииЗаПериод Цикл
			Операции.Добавить(Операция);
		КонецЦикла;

		ТекущаяДатаНачала = НачалоДня(ТекущаяДатаКонца + 1);

	КонецЦикла;

	Возврат Операции;

КонецФункции

Функция ПолучитьОперацииMonobankЗаПериод(
	Настройка,
	ДатаНачала,
	ДатаКонца) Экспорт

	Операции = Новый Массив;

	Если Настройка = Неопределено Тогда
		Возврат Операции;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат Операции;

	КонецЕсли;

	Токен              = СокрЛП(Строка(Настройка.Токен));
	ИдентификаторСчета = СокрЛП(Строка(Настройка.Айди));

	Если ПустаяСтрока(Токен) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Настройка.Подразделение,
			"Не заполнен токен Monobank.");

		Возврат Операции;

	КонецЕсли;

	Если ПустаяСтрока(ИдентификаторСчета) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Настройка.Подразделение,
			"Не заполнен идентификатор счета Monobank.");

		Возврат Операции;

	КонецЕсли;

	UnixДатаНачала = ДатаВUnixTimeMonobank(НачалоДня(ДатаНачала));
	UnixДатаКонца  = ДатаВUnixTimeMonobank(КонецДня(ДатаКонца));

	ПутьЗапроса =
		"/personal/statement/"
		+ ИдентификаторСчета
		+ "/"
		+ Формат(UnixДатаНачала, "ЧГ=0")
		+ "/"
		+ Формат(UnixДатаКонца, "ЧГ=0");

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Token", Токен);
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("User-Agent", "1C-BankStatements");

	Соединение = Новый HTTPСоединение(
		"api.monobank.ua",
		443,
		,
		,
		,
		60,
		Новый ЗащищенноеСоединениеOpenSSL);

	HTTPЗапрос = Новый HTTPЗапрос(ПутьЗапроса, Заголовки);

	Попытка

		HTTPОтвет = Соединение.Получить(HTTPЗапрос);

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Настройка.Подразделение,
			"Ошибка подключения к Monobank: " + ОписаниеОшибки());

		Возврат Операции;

	КонецПопытки;

	КодСостояния = HTTPОтвет.КодСостояния;

	Попытка
		ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Исключение
		ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
	КонецПопытки;

	ОтладкаВыписокСообщить(
		"Monobank: код ответа " + Строка(КодСостояния)
		+ ", тело: " + Лев(СокрЛП(ТекстОтвета), 1500));

	Если КодСостояния <> 200 Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Настройка.Подразделение,
			ПолучитьТекстОшибкиMonobank(КодСостояния, ТекстОтвета));

		Возврат Операции;

	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
		Возврат Операции;
	КонецЕсли;

	Попытка

		ДанныеОтвета = ПрочитатьОтветJSONMonobank(ТекстОтвета);

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Настройка.Подразделение,
			"Не удалось разобрать JSON Monobank: " + ОписаниеОшибки());

		Возврат Операции;

	КонецПопытки;

	Если ДанныеОтвета = Неопределено Тогда
		Возврат Операции;
	КонецЕсли;

	Для Каждого ДанныеОперации Из ДанныеОтвета Цикл

		ИдентификаторОперации = ПолучитьЗначениеJSONMonobank(
			ДанныеОперации, "id", "");

		ИдентификаторОперации = СокрЛП(Строка(ИдентификаторОперации));

		Если ПустаяСтрока(ИдентификаторОперации) Тогда
			Продолжить;
		КонецЕсли;

		ДатаUnix = ПолучитьЗначениеJSONMonobank(ДанныеОперации, "time", 0);

		Если ДатаUnix = 0 Тогда
			Продолжить;
		КонецЕсли;

		СуммаВКопейках = ПолучитьЗначениеJSONMonobank(
			ДанныеОперации, "amount", 0);

		СуммаОперации = СуммаВКопейках;

		Если СуммаОперации < 0 Тогда
			СуммаОперации = -СуммаОперации;
		КонецЕсли;

		СуммаОперации = Окр(СуммаОперации / 100, 2);

		Если СуммаОперации = 0 Тогда
			Продолжить;
		КонецЕсли;

		ОстатокВКопейках = ПолучитьЗначениеJSONMonobank(
			ДанныеОперации, "balance", 0);

		Остаток = Окр(ОстатокВКопейках / 100, 2);

		КодВалюты = ПолучитьЗначениеJSONMonobank(
			ДанныеОперации, "currencyCode", 980);

		ОписаниеОперации = ПолучитьЗначениеJSONMonobank(
			ДанныеОперации, "description", "");

		КомментарийОперации = ПолучитьЗначениеJSONMonobank(
			ДанныеОперации, "comment", "");

		MCC = ПолучитьЗначениеJSONMonobank(ДанныеОперации, "mcc", 0);

		Назначение = СокрЛП(Строка(ОписаниеОперации));

		Если Не ПустаяСтрока(СокрЛП(Строка(КомментарийОперации))) Тогда

			Если Не ПустаяСтрока(Назначение) Тогда
				Назначение = Назначение + ". ";
			КонецЕсли;

			Назначение = Назначение + СокрЛП(Строка(КомментарийОперации));

		КонецЕсли;

		БанковскаяОперация = СоздатьБанковскуюОперацию();

		БанковскаяОперация.Источник       = "Monobank";
		БанковскаяОперация.Идентификатор  = ИдентификаторОперации;
		БанковскаяОперация.БанковскийСчет = Настройка.БанковскийСчет;
		БанковскаяОперация.Подразделение  = Настройка.Подразделение;
		БанковскаяОперация.ОрганизацияМерчанта = Настройка.ОрганизацияМерчанта;
		БанковскаяОперация.Дата           = UnixTimeВДатуMonobank(ДатаUnix);
		БанковскаяОперация.Сумма          = СуммаОперации;
		БанковскаяОперация.Валюта         = ПолучитьВалютуПоКодуMonobank(КодВалюты);
		БанковскаяОперация.Входящий       = СуммаВКопейках > 0;
		БанковскаяОперация.Остаток        = Остаток;
		БанковскаяОперация.Терминал       = ?(MCC = 0,
			"Monobank", "Monobank, MCC " + Строка(MCC));
		БанковскаяОперация.Назначение     = Назначение;

		Операции.Добавить(БанковскаяОперация);

	КонецЦикла;

	Возврат Операции;

КонецФункции

// Смещение часового пояса: база работает по украинскому времени, API — по UTC.
Функция ДатаВUnixTimeMonobank(ДатаЗначение) Экспорт

	Если Не ЗначениеЗаполнено(ДатаЗначение) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Цел(
		ДатаЗначение
		- Дата(1970, 1, 1, 0, 0, 0)
		- СмещениеЧасовогоПоясаВыписок());

КонецФункции

Функция UnixTimeВДатуMonobank(UnixTime) Экспорт

	Если UnixTime = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		UnixTime = Число(UnixTime);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если UnixTime <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Дата(1970, 1, 1, 0, 0, 0)
		+ UnixTime
		+ СмещениеЧасовогоПоясаВыписок();

КонецФункции

Функция ПолучитьЗначениеJSONMonobank(
	ОбъектJSON,
	ИмяСвойства,
	ЗначениеПоУмолчанию) Экспорт

	Если ОбъектJSON = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	ЗначениеСвойства = ЗначениеПоУмолчанию;

	Если ТипЗнч(ОбъектJSON) = Тип("Структура") Тогда

		Если ОбъектJSON.Свойство(ИмяСвойства, ЗначениеСвойства) Тогда
			Возврат ЗначениеСвойства;
		КонецЕсли;

	ИначеЕсли ТипЗнч(ОбъектJSON) = Тип("Соответствие") Тогда

		Если ОбъектJSON.СодержитКлюч(ИмяСвойства) Тогда
			Возврат ОбъектJSON.Получить(ИмяСвойства);
		КонецЕсли;

	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ПолучитьТекстОшибкиMonobank(КодСостояния, ТекстОтвета) Экспорт

	Если КодСостояния = 401 Тогда

		Возврат "Monobank вернул ошибку 401. "
			+ "Токен отсутствует или недействителен.";

	ИначеЕсли КодСостояния = 403 Тогда

		Возврат "Monobank вернул ошибку 403. Доступ к API запрещен.";

	ИначеЕсли КодСостояния = 429 Тогда

		Возврат "Monobank вернул ошибку 429. "
			+ "Превышена частота запросов. Повторите загрузку позже.";

	КонецЕсли;

	ТекстОшибки = "Ошибка Monobank. Код HTTP: " + Строка(КодСостояния);

	Если Не ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
		ТекстОшибки = ТекстОшибки + ". Ответ: " + Лев(ТекстОтвета, 1000);
	КонецЕсли;

	Возврат ТекстОшибки;

КонецФункции

Функция ПолучитьВалютуПоКодуMonobank(КодВалюты) Экспорт

	КодВалюты = СокрЛП(Строка(КодВалюты));

	СимвольныйКод = "";

	Если КодВалюты = "980" Тогда
		СимвольныйКод = "UAH";
	ИначеЕсли КодВалюты = "840" Тогда
		СимвольныйКод = "USD";
	ИначеЕсли КодВалюты = "978" Тогда
		СимвольныйКод = "EUR";
	ИначеЕсли КодВалюты = "985" Тогда
		СимвольныйКод = "PLN";
	КонецЕсли;

	Если Не ПустаяСтрока(СимвольныйКод) Тогда

		Валюта = Справочники.Валюты.НайтиПоКоду(СимвольныйКод);

		Если ЗначениеЗаполнено(Валюта) Тогда
			Возврат Валюта;
		КонецЕсли;

		Валюта = Справочники.Валюты.НайтиПоНаименованию(СимвольныйКод);

		Если ЗначениеЗаполнено(Валюта) Тогда
			Возврат Валюта;
		КонецЕсли;

	КонецЕсли;

	Если КодВалюты = "980" Тогда
		Возврат ПолучитьВалютуГривна();
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПрочитатьОтветJSONMonobank(ТекстОтвета) Экспорт

	Если ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;

	Попытка

		ЧтениеJSON.УстановитьСтроку(ТекстОтвета);

		Результат = ПрочитатьJSON(ЧтениеJSON);

		ЧтениеJSON.Закрыть();

	Исключение

		Попытка
			ЧтениеJSON.Закрыть();
		Исключение
		КонецПопытки;

		ВызватьИсключение
			"Ошибка разбора JSON Monobank: " + ОписаниеОшибки();

	КонецПопытки;

	Если Результат = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область WayForPay

// Выписка эквайринга: список транзакций мерчанта за период.
// Реквизиты продавца берутся из настройки подключения подразделения — той же,
// которой заказ покупателя создаёт инвойсы. Отдельных токенов не требуется.
Функция ПолучитьОперацииWayForPay(Настройка, ДатаНачала, ДатаКонца) Экспорт

	Операции = Новый Массив;

	Если Настройка = Неопределено Тогда
		Возврат Операции;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат Операции;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(Настройка.НастройкаWayForPay) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.WayForPay",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Настройка.Подразделение,
			"Не заполнена настройка подключения WayForPay.");

		Возврат Операции;

	КонецЕсли;

	Ответ = Wayforpay_ОбщийМодуль_СД.ПолучитьСписокТранзакций(
		Настройка.НастройкаWayForPay,
		ДатаНачала,
		ДатаКонца);

	Если Не Ответ.Успешно Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.WayForPay",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Настройка.Подразделение,
			Ответ.Сообщение);

		Сообщить("WayForPay: " + Ответ.Сообщение);

		Возврат Операции;

	КонецЕсли;

	ОтладкаВыписокСообщить(
		"WayForPay: транзакций получено: " + Строка(Ответ.Транзакции.Количество())
		+ ", период "
		+ Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - "
		+ Формат(ДатаКонца, "ДФ=dd.MM.yyyy"));

	ПутьОтвета = "";
	Ответ.Свойство("ФайлОтвета", ПутьОтвета);

	Если Не ПустаяСтрока(СокрЛП(Строка(ПутьОтвета))) Тогда

		ОтладкаВыписокСообщить(
			"WayForPay: сырой ответ эквайринга — " + СокрЛП(Строка(ПутьОтвета)));

	КонецЕсли;

	Принято   = 0;
	Пропущено = 0;
	Дампов    = 0;

	Для Каждого Транзакция Из Ответ.Транзакции Цикл

		ПричинаПропуска = "";

		Операция = ПреобразоватьОперациюWayForPay(
			Транзакция,
			Настройка,
			ПричинаПропуска);

		ЭтоПропуск = (Операция = Неопределено);

		Если ЭтоПропуск Тогда

			Пропущено = Пропущено + 1;

			ОтладкаВыписокСообщить(
				"  ПРОПУЩЕНА: " + ПричинаПропуска
				+ Символы.ПС + "    " + ОписаниеТранзакцииWayForPay(Транзакция));

		Иначе

			Принято = Принято + 1;

			ОтладкаВыписокСообщить(
				"  принята: " + ОписаниеТранзакцииWayForPay(Транзакция));

			// Оплата принята, но по ней же эквайринг показывает возврат:
			// значит возврат приходит не отдельной транзакцией, а полем
			// на исходной оплате — загрузкой выписки он не ловится.
			СуммаВозвратаПоОплате = ЧислоИзСтрокиПриват24(
				ЗначениеТранзакцииWayForPay(Транзакция, "refundAmount", 0));

			Если СуммаВозвратаПоОплате <> 0 Тогда

				ОтладкаВыписокСообщить(
					"    ВНИМАНИЕ: по этой оплате указан возврат refundAmount="
					+ Строка(СуммаВозвратаПоОплате)
					+ " — отдельной операцией списания он сейчас в выписку НЕ попадает.");

			КонецЕсли;

		КонецЕсли;

		// Полный список полей печатаем у всех отброшенных транзакций и один раз
		// у принятой — чтобы было с чем сравнивать. Именно здесь видно, как
		// эквайринг показывает возврат: отдельной записью transactionType=REFUND
		// или полем refundAmount на исходной оплате.
		НуженДамп = ЭтоПропуск Или (Принято = 1 И Не ЭтоПропуск);

		Если НуженДамп И Дампов < 20 Тогда

			Дампов = Дампов + 1;

			ОтладкаВыписокСообщить(
				"    все поля транзакции:"
				+ ПолныйДампТранзакцииWayForPay(Транзакция));

		ИначеЕсли НуженДамп И Дампов = 20 Тогда

			Дампов = Дампов + 1;

			ОтладкаВыписокСообщить(
				"    (полный дамп дальше не печатается: показано 20 транзакций"
				+ " — остальные смотрите в файле сырого ответа)");

		КонецЕсли;

		Если Не ЭтоПропуск Тогда
			Операции.Добавить(Операция);
		КонецЕсли;

	КонецЦикла;

	ОтладкаВыписокСообщить(
		"WayForPay: принято в выписку " + Строка(Принято)
		+ ", отброшено " + Строка(Пропущено) + ".");

	Если ВключенаГлубокаяДиагностикаВозвратовWayForPay() Тогда
		ДиагностикаВозвратовWayForPay(Настройка, ДатаНачала, ДатаКонца);
	КонецЕсли;

	Возврат Операции;

КонецФункции

// Глубокая диагностика возвратов WayForPay.
//
// Ложь — обычная работа. Истина — после загрузки выписки по каждому инвойсу
// из регистра ЗаказыИнвойсовWayForPay дополнительно спрашивается статус
// (метод CHECK_STATUS) и печатается сумма возврата.
//
// Нужна для одного вопроса: как эквайринг показывает возврат по оплате,
// которая прошла давно. В список транзакций за последние дни такая оплата
// уже не попадает, и загрузка выписки её не видит в принципе.
//
// В рабочем режиме держать Истина нельзя: каждый заказ — отдельный запрос
// к API, на пятидесяти заказах это пятьдесят обращений на одно нажатие
// «Получить выписку».
Функция ВключенаГлубокаяДиагностикаВозвратовWayForPay() Экспорт

	Возврат Ложь;

КонецФункции

Процедура ДиагностикаВозвратовWayForPay(Настройка, ДатаНачала, ДатаКонца)

	ГлубинаДней = 30;

	НачалоВыборки = НачалоДня(ДатаНачала - ГлубинаДней * 24 * 60 * 60);

	ОтладкаВыписокСообщить(
		"WayForPay: глубокая диагностика возвратов — инвойсы по заказам с "
		+ Формат(НачалоВыборки, "ДФ=dd.MM.yyyy")
		+ " по " + Формат(ДатаКонца, "ДФ=dd.MM.yyyy")
		+ " (не более 50 заказов, по каждому отдельный запрос CHECK_STATUS).");

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	ЗаказыИнвойсов.OrderReference КАК OrderReference,
	|	ЗаказыИнвойсов.Заказ КАК Заказ,
	|	ЗаказыИнвойсов.Заказ.Дата КАК ДатаЗаказа
	|ИЗ
	|	РегистрСведений.ЗаказыИнвойсовWayForPay КАК ЗаказыИнвойсов
	|ГДЕ
	|	ЗаказыИнвойсов.Заказ.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗаказа УБЫВ";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоВыборки);
	Запрос.УстановитьПараметр("КонецПериода",  КонецДня(ДатаКонца));

	Выборка = Запрос.Выполнить().Выбрать();

	Проверено      = 0;
	СВозвратом     = 0;
	ПервыйОтвет    = Истина;

	Пока Выборка.Следующий() Цикл

		// Диагностика не имеет права уронить загрузку выписки: у CHECK_STATUS
		// нет внутренней защиты от сетевых ошибок.
		Попытка

			Статус = Wayforpay_ОбщийМодуль_СД.ПолучитьСтатусИнвойса(
				Настройка.НастройкаWayForPay,
				Выборка.OrderReference);

		Исключение

			ОтладкаВыписокСообщить(
				"  инвойс " + СокрЛП(Строка(Выборка.OrderReference))
				+ ": ошибка запроса статуса — " + ОписаниеОшибки());

			Продолжить;

		КонецПопытки;

		Проверено = Проверено + 1;

		СуммаВозврата = ЧислоИзСтрокиПриват24(Статус.СуммаВозврата);

		Строчка =
			"  инвойс " + СокрЛП(Строка(Выборка.OrderReference))
			+ " (заказ " + Строка(Выборка.Заказ) + ")"
			+ " | статус=" + ?(ПустаяСтрока(Строка(Статус.СтатусОплаты)),
				"<пусто>", Строка(Статус.СтатусОплаты))
			+ " | сумма=" + Строка(Статус.Сумма)
			+ " | возврат=" + Строка(СуммаВозврата)
			+ " | authCode=" + Строка(Статус.AuthCode);

		Если Не Статус.Успешно Тогда
			Строчка = Строчка + " | ОТВЕТ НЕ ПРИНЯТ: " + Строка(Статус.Сообщение);
		КонецЕсли;

		Если СуммаВозврата <> 0 Тогда
			СВозвратом = СВозвратом + 1;
			Строчка = "  >>> ЕСТЬ ВОЗВРАТ <<<" + Символы.ПС + Строчка;
		КонецЕсли;

		ОтладкаВыписокСообщить(Строчка);

		// Сырой ответ печатаем у первого инвойса и у каждого с возвратом:
		// по нему видно полный набор полей CHECK_STATUS.
		Если ПервыйОтвет Или СуммаВозврата <> 0 Тогда

			ПервыйОтвет = Ложь;

			ОтветСервера = "";
			Статус.Свойство("ОтветСервера", ОтветСервера);

			Если Не ПустаяСтрока(СокрЛП(Строка(ОтветСервера))) Тогда

				ОтладкаВыписокСообщить(
					"    сырой ответ CHECK_STATUS:" + Символы.ПС
					+ "      " + СокрЛП(Строка(ОтветСервера)));

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	ОтладкаВыписокСообщить(
		"WayForPay: диагностика возвратов завершена. Проверено инвойсов: "
		+ Строка(Проверено) + ", с ненулевым возвратом: " + Строка(СВозвратом) + ".");

	Если Выборка.Количество() = 50 Тогда

		ОтладкаВыписокСообщить(
			"WayForPay: взяты первые 50 инвойсов — более старые"
			+ " в диагностику не попали.");

	КонецЕсли;

КонецПроцедуры

// Короткая строка по транзакции: ключевые поля, по которым разбирается,
// что это за операция и почему она попала или не попала в выписку.
Функция ОписаниеТранзакцииWayForPay(Транзакция)

	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("orderReference");
	ИменаПолей.Добавить("transactionType");
	ИменаПолей.Добавить("transactionStatus");
	ИменаПолей.Добавить("amount");
	ИменаПолей.Добавить("refundAmount");
	ИменаПолей.Добавить("authCode");
	ИменаПолей.Добавить("processingDate");
	ИменаПолей.Добавить("createdDate");
	ИменаПолей.Добавить("settlementDate");
	ИменаПолей.Добавить("reasonCode");
	ИменаПолей.Добавить("reason");

	Текст = "";

	Для Каждого ИмяПоля Из ИменаПолей Цикл

		Значение = ЗначениеТранзакцииWayForPay(Транзакция, ИмяПоля, Неопределено);

		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Текст = Текст
			+ ?(ПустаяСтрока(Текст), "", " | ")
			+ ИмяПоля + "=" + ПредставлениеПоляТранзакции(ИмяПоля, Значение);

	КонецЦикла;

	Если ПустаяСтрока(Текст) Тогда
		Возврат "<ни одного знакомого поля>";
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Все поля транзакции как их прислал WayForPay — без отбора «знакомых»:
// поле возврата может называться не так, как мы ожидаем.
Функция ПолныйДампТранзакцииWayForPay(Транзакция)

	Текст = "";

	Если ТипЗнч(Транзакция) = Тип("Соответствие")
		Или ТипЗнч(Транзакция) = Тип("Структура") Тогда

		Для Каждого КлючИЗначение Из Транзакция Цикл

			Текст = Текст
				+ Символы.ПС + "      "
				+ Строка(КлючИЗначение.Ключ) + " = "
				+ ПредставлениеПоляТранзакции(
					Строка(КлючИЗначение.Ключ),
					КлючИЗначение.Значение);

		КонецЦикла;

	Иначе

		Текст = Символы.ПС + "      " + Строка(Транзакция);

	КонецЕсли;

	Если ПустаяСтрока(Текст) Тогда
		Возврат Символы.ПС + "      <полей нет>";
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Значение поля в читаемом виде. Unix-время расшифровывается: иначе
// «1770000000» в отладке ни о чём не говорит.
Функция ПредставлениеПоляТранзакции(ИмяПоля, Значение)

	Если Значение = Неопределено Тогда
		Возврат "<нет>";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат "<массив, элементов: " + Строка(Значение.Количество()) + ">";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Соответствие")
		Или ТипЗнч(Значение) = Тип("Структура") Тогда

		Возврат "<вложенный объект, полей: " + Строка(Значение.Количество()) + ">";

	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "Истина", "Ложь");
	КонецЕсли;

	// Поля дат приходят unix-временем — показываем и число, и дату.
	Если Найти(НРег(ИмяПоля), "date") > 0 И ТипЗнч(Значение) = Тип("Число") Тогда

		Если Значение > 0 Тогда

			Возврат Формат(Значение, "ЧГ=0; ЧН=0")
				+ " (" + Формат(
					UnixTimeВДатуMonobank(Значение),
					"ДФ=dd.MM.yyyy HH:mm:ss") + ")";

		КонецЕсли;

	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧН=0");
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));

	Если ПустаяСтрока(Текст) Тогда
		Возврат "<пусто>";
	КонецЕсли;

	Возврат Текст;

КонецФункции

// В очередь импорта попадают только успешные (Approved) платежи: прочие
// статусы — Declined, InProcessing, Refunded — платежа в базе не порождают.
//
// ПричинаПропуска — возвращается вызывающему для отладки: почему транзакция
// не стала операцией выписки. Возвраты денег покупателю сейчас отсеиваются
// здесь же, по статусу.
Функция ПреобразоватьОперациюWayForPay(Транзакция, Настройка, ПричинаПропуска = "")

	ПричинаПропуска = "";

	OrderReference = СокрЛП(Строка(
		ЗначениеТранзакцииWayForPay(Транзакция, "orderReference", "")));

	Если ПустаяСтрока(OrderReference) Тогда
		ПричинаПропуска = "не заполнен orderReference";
		Возврат Неопределено;
	КонецЕсли;

	Статус = СокрЛП(Строка(
		ЗначениеТранзакцииWayForPay(Транзакция, "transactionStatus", "")));

	Если Статус <> "Approved" Тогда

		ПричинаПропуска =
			"статус «" + ?(ПустаяСтрока(Статус), "<пусто>", Статус)
			+ "» — в выписку берутся только Approved";

		Возврат Неопределено;

	КонецЕсли;

	ДатаUnix = ЗначениеТранзакцииWayForPay(Транзакция, "processingDate", 0);

	Если Не ЗначениеЗаполнено(ДатаUnix) Тогда
		ДатаUnix = ЗначениеТранзакцииWayForPay(Транзакция, "createdDate", 0);
	КонецЕсли;

	ДатаОперации = UnixTimeВДатуMonobank(ДатаUnix);

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		ПричинаПропуска = "не удалось разобрать дату (processingDate и createdDate пусты)";
		Возврат Неопределено;
	КонецЕсли;

	// amount может прийти и числом, и строкой — приводим явно, иначе
	// сравнения суммы дальше по конвейеру падают на несовпадении типов.
	Сумма = ЧислоИзСтрокиПриват24(
		ЗначениеТранзакцииWayForPay(Транзакция, "amount", 0));

	Если Сумма = 0 Тогда
		ПричинаПропуска = "нулевая сумма (amount)";
		Возврат Неопределено;
	КонецЕсли;

	Email = СокрЛП(Строка(ЗначениеТранзакцииWayForPay(Транзакция, "email", "")));
	Phone = СокрЛП(Строка(ЗначениеТранзакцииWayForPay(Транзакция, "phone", "")));

	Назначение = "WayForPay, заказ " + OrderReference;

	Если Не ПустаяСтрока(Email) Тогда
		Назначение = Назначение + ", " + Email;
	КонецЕсли;

	Если Не ПустаяСтрока(Phone) Тогда
		Назначение = Назначение + ", " + Phone;
	КонецЕсли;

	Операция = СоздатьБанковскуюОперацию();

	Операция.Источник         = "WayForPay";
	Операция.Идентификатор    = OrderReference;
	Операция.КлючДубляСтраниц = OrderReference;
	Операция.AuthCode         = СокрЛП(Строка(
		ЗначениеТранзакцииWayForPay(Транзакция, "authCode", "")));
	Операция.Заказ            = НайтиЗаказПоOrderReference(OrderReference, датаОперации);
	Операция.БанковскийСчет   = Настройка.БанковскийСчет;
	Операция.Подразделение    = Настройка.Подразделение;
	Операция.ОрганизацияМерчанта = Настройка.ОрганизацияМерчанта;
	Операция.Дата             = ДатаОперации;
	Операция.ДатаКомпенсации  = ДатаКомпенсацииWayForPay(Транзакция);
	Операция.Сумма            = Сумма;
	Операция.Валюта           = ПолучитьВалютуГривна();
	Операция.Входящий         = Истина;
	Операция.Остаток          = 0;
	Операция.Терминал         = "WayForPay";
	Операция.Назначение       = Назначение;

	Возврат Операция;

КонецФункции

// Дата зачисления средств продавцу (settlementDate). В зависимости от
// версии API приходит либо unix-временем (число или строка цифр), либо
// строкой "дд.мм.гггг". Если формат не распознан — возвращаем пустую дату:
// поле информационное, валить загрузку из-за него нельзя.
Функция ДатаКомпенсацииWayForPay(Транзакция)

	ПустаяДата = '00010101';

	Значение = ЗначениеТранзакцииWayForPay(Транзакция, "settlementDate", 0);

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат ПустаяДата;
	КонецЕсли;

	Попытка

		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Возврат UnixTimeВДатуMonobank(Значение);
		КонецЕсли;

		Текст = СокрЛП(Строка(Значение));

		Если ПустаяСтрока(Текст) Тогда
			Возврат ПустаяДата;
		КонецЕсли;

		// "дд.мм.гггг" (возможно с временем после пробела).
		Если СтрДлина(Текст) >= 10 И Сред(Текст, 3, 1) = "." И Сред(Текст, 6, 1) = "." Тогда
			Возврат Дата(Сред(Текст, 7, 4) + Сред(Текст, 4, 2) + Лев(Текст, 2));
		КонецЕсли;

		// Строка цифр — unix-время.
		Возврат UnixTimeВДатуMonobank(ЧислоИзСтрокиПриват24(Текст));

	Исключение

		Возврат ПустаяДата;

	КонецПопытки;

КонецФункции

// WayForPay возвращает транзакции соответствиями; на всякий случай
// поддерживаем и структуру.
Функция ЗначениеТранзакцииWayForPay(Транзакция, ИмяСвойства, ЗначениеПоУмолчанию)

	Если ТипЗнч(Транзакция) = Тип("Соответствие") Тогда

		Если Транзакция.СодержитКлюч(ИмяСвойства) Тогда
			Возврат Транзакция.Получить(ИмяСвойства);
		КонецЕсли;

	ИначеЕсли ТипЗнч(Транзакция) = Тип("Структура") Тогда

		Значение = ЗначениеПоУмолчанию;

		Если Транзакция.Свойство(ИмяСвойства, Значение) Тогда
			Возврат Значение;
		КонецЕсли;

	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

// orderReference заказа собирается как «<номер заказа>_<номер инвойса>»
// (см. форму заказа покупателя), поэтому номер — всё до последнего «_».
Функция НайтиЗаказПоOrderReference(OrderReference, ДатаОперации)

	ПустойЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();

	Текст = СокрЛП(Строка(OrderReference));

	Если ПустаяСтрока(Текст) Тогда
		Возврат ПустойЗаказ;
	КонецЕсли;

	// Сначала — связь, записанная в регистр при создании инвойса: она
	// точная и переживает смену номера заказа. Разбор номера ниже остается
	// для старых инвойсов, выставленных до появления регистра.
	ЗаказИзРегистра = ЗаказПоРегиструИнвойсов(Текст);

	Если ЗначениеЗаполнено(ЗаказИзРегистра) Тогда
		Возврат ЗаказИзРегистра;
	КонецЕсли;

	// Позиция последнего «_».
	Позиция = 0;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если Сред(Текст, Индекс, 1) = "_" Тогда
			Позиция = Индекс;
		КонецЕсли;
	КонецЦикла;

	НомерЗаказа = ?(Позиция > 0, Лев(Текст, Позиция - 1), Текст);

	Если ПустаяСтрока(НомерЗаказа) Тогда
		Возврат ПустойЗаказ;
	КонецЕсли;

	Запрос = Новый Запрос;
		Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.Номер = &Номер
	|	И НЕ ЗаказПокупателя.ПометкаУдаления
	|	И ЗаказПокупателя.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.Дата УБЫВ";

	// Номера заказов повторяются каждый год, поэтому заказ ищем только
	// в окне: не позже даты оплаты и не старше её на 90 дней.
	ДатаНачалаОкна = НачалоДня(ДатаОперации - 90 * 86400);
	ДатаКонцаОкна  = КонецДня(ДатаОперации);

	Запрос.УстановитьПараметр("Номер", НомерЗаказа);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаОкна);
	Запрос.УстановитьПараметр("ДатаКонца",  ДатаКонцаОкна);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	ОтладкаВыписокСообщить(
		"    заказ с номером «" + НомерЗаказа + "» не найден в окне "
		+ Формат(ДатаНачалаОкна, "ДФ=dd.MM.yyyy") + " - "
		+ Формат(ДатаКонцаОкна, "ДФ=dd.MM.yyyy") + ".");

	Возврат ПустойЗаказ;

КонецФункции

// Заказ по регистру «Заказы инвойсов WayForPay»: пара записывается модулем
// Wayforpay_ОбщийМодуль_СД при создании инвойса из заказа.
Функция ЗаказПоРегиструИнвойсов(OrderReference)

	ПустойЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказыИнвойсов.Заказ КАК Заказ
	|ИЗ
	|	РегистрСведений.ЗаказыИнвойсовWayForPay КАК ЗаказыИнвойсов
	|ГДЕ
	|	ЗаказыИнвойсов.OrderReference = &OrderReference
	|	И НЕ ЗаказыИнвойсов.Заказ.ПометкаУдаления";

	Запрос.УстановитьПараметр(
		"OrderReference",
		Лев(СокрЛП(Строка(OrderReference)), 100));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Заказ;
	КонецЕсли;

	Возврат ПустойЗаказ;

КонецФункции

#КонецОбласти

#Область ОпознаниеЗаказаПоВыписке

// Заказ по строке банковской выписки.
//
// Порядок проверен на 167 строках реестра за 12 дней против того, как те же
// платежи разнесли руками:
//   1) номер из назначения И точная сумма — 84 строки, все верно;
//   2) фамилия плательщика И точная сумма  — 58 строк, все верно;
//   3) номер из назначения при несовпавшей сумме — частичная оплата,
//      заказ показываем, разницу человек видит в колонках «Сумма заказа»
//      и «Поступило».
// Шаг 2 стоит выше шага 3 намеренно: в трёх строках плательщик ошибся
// в номере («10841» вместо «10481»), и сумма указала на верный заказ.
Функция НайтиЗаказПоДаннымВыписки(
	Назначение,
	Плательщик,
	Сумма,
	ДатаОперации,
	Организация) Экспорт

	ПустойЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();

	Если Не ЗначениеЗаполнено(ДатаОперации) Или Сумма = 0 Тогда
		Возврат ПустойЗаказ;
	КонецЕсли;

	Кандидаты = НомераЗаказовИзНазначения(Назначение);

	Для Каждого Номер Из Кандидаты Цикл

		Заказ = НайтиЗаказПоНомеруВыписки(
			Номер,
			ДатаОперации,
			Организация,
			Сумма);

		Если ЗначениеЗаполнено(Заказ) Тогда
			Возврат Заказ;
		КонецЕсли;

	КонецЦикла;

	Заказ = НайтиЗаказПоПлательщикуИСумме(
		Плательщик,
		Сумма,
		ДатаОперации,
		Организация);

	Если ЗначениеЗаполнено(Заказ) Тогда
		Возврат Заказ;
	КонецЕсли;

	Для Каждого Номер Из Кандидаты Цикл

		Заказ = НайтиЗаказПоНомеруВыписки(
			Номер,
			ДатаОперации,
			Организация,
			0);

		Если ЗначениеЗаполнено(Заказ) Тогда
			Возврат Заказ;
		КонецЕсли;

	КонецЦикла;

	Возврат ПустойЗаказ;

КонецФункции

// Числа из назначения, похожие на номер заказа.
//
// Сначала идут те, что стоят после слова-указателя («рахунок», «замовлення»,
// «№», «N», «#»), потом остальные: в назначении попадаются размеры шин
// («205/55 R16») и годы, и брать их наравне с номером нельзя.
Функция НомераЗаказовИзНазначения(Знач Назначение) Экспорт

	Результат = Новый Массив;

	Текст = Строка(Назначение);

	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	ТекстВРег = ВРег(Текст);

	Указатели = Новый Массив;
	Указатели.Добавить("РАХУН");
	Указатели.Добавить("СЧЁТ");
	Указатели.Добавить("СЧЕТ");
	Указатели.Добавить("ЗАМОВЛЕН");
	Указатели.Добавить("ЗАКАЗ");
	Указатели.Добавить("№");
	Указатели.Добавить("#");

	ПослеУказателя = Новый Массив;
	Прочие         = Новый Массив;

	Цифры        = "";
	НачалоЧисла  = 0;
	Позиция      = 1;
	Длина        = СтрДлина(Текст);

	Пока Позиция <= Длина + 1 Цикл

		Символ = ?(Позиция > Длина, " ", Сред(Текст, Позиция, 1));

		Если Найти("0123456789", Символ) > 0 Тогда

			Если ПустаяСтрока(Цифры) Тогда
				НачалоЧисла = Позиция;
			КонецЕсли;

			Цифры = Цифры + Символ;

		Иначе

			Если СтрДлина(Цифры) >= 4 Тогда

				// Год оплаты и телефоны номером заказа не бывают.
				ЭтоГод = (СтрДлина(Цифры) = 4 И Лев(Цифры, 2) = "20");

				Если Не ЭтоГод Тогда

					Ключ = ?(СтрДлина(Цифры) > 6, Прав(Цифры, 6), Цифры);

					// Слово-указатель ищем в 30 символах слева от числа.
					Начало = Макс(1, НачалоЧисла - 30);
					Контекст = Сред(ТекстВРег, Начало, НачалоЧисла - Начало);

					ЕстьУказатель = Ложь;

					Для Каждого Указатель Из Указатели Цикл
						Если Найти(Контекст, Указатель) > 0 Тогда
							ЕстьУказатель = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;

					Если ЕстьУказатель Тогда
						ПослеУказателя.Добавить(Ключ);
					Иначе
						Прочие.Добавить(Ключ);
					КонецЕсли;

				КонецЕсли;

			КонецЕсли;

			Цифры = "";

		КонецЕсли;

		Позиция = Позиция + 1;

	КонецЦикла;

	Для Каждого Ключ Из ПослеУказателя Цикл
		Результат.Добавить(Ключ);
	КонецЦикла;

	Для Каждого Ключ Из Прочие Цикл
		Результат.Добавить(Ключ);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заказ по хвосту номера. Номера повторяются каждый год, поэтому ищем
// в окне: не позже дня оплаты и не старше её на 90 дней. Организация —
// владелец счёта зачисления: у каждой фирмы своя серия номеров, и без
// этого отбора «11056» найдётся сразу у нескольких.
//
//   Сумма - Число - 0: сумма не проверяется (частичная оплата).
//
Функция НайтиЗаказПоНомеруВыписки(
	Знач Номер,
	ДатаОперации,
	Организация,
	Знач Сумма = 0) Экспорт

	ПустойЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();

	Номер = СокрЛП(Строка(Номер));

	Если ПустаяСтрока(Номер) Тогда
		Возврат ПустойЗаказ;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	НЕ ЗаказПокупателя.ПометкаУдаления
	|	И ЗаказПокупателя.Номер ПОДОБНО &Шаблон
	|	И ЗаказПокупателя.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|	%ОРГАНИЗАЦИЯ%
	|	%СУММА%
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.Дата УБЫВ";

	Запрос = Новый Запрос;

	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"%ОРГАНИЗАЦИЯ%",
			"И ЗаказПокупателя.Организация = &Организация");
		Запрос.УстановитьПараметр("Организация", Организация);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ОРГАНИЗАЦИЯ%", "");
	КонецЕсли;

	Если Сумма <> 0 Тогда
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"%СУММА%",
			"И ЗаказПокупателя.СуммаДокумента = &Сумма");
		Запрос.УстановитьПараметр("Сумма", Сумма);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%СУММА%", "");
	КонецЕсли;

	Запрос.Текст = ТекстЗапроса;

	Запрос.УстановитьПараметр("Шаблон", "%" + Номер);
	Запрос.УстановитьПараметр(
		"ДатаНачала",
		НачалоДня(ДатаОперации - 90 * 24 * 60 * 60));
	Запрос.УстановитьПараметр("ДатаКонца", КонецДня(ДатаОперации));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		Возврат ПустойЗаказ;
	КонецЕсли;

	Первый = Выборка.Ссылка;

	// Под хвост номера подошли два заказа — какой из них оплачен, решает
	// человек. Молча брать первый нельзя.
	Если Выборка.Следующий() Тогда
		Возврат ПустойЗаказ;
	КонецЕсли;

	Возврат Первый;

КонецФункции

// Заказ по фамилии плательщика и точной сумме — для платежей, где номера
// в назначении нет вовсе («Сплата за товар»). Берём только однозначный
// случай: одна фамилия, одна сумма, один заказ.
Функция НайтиЗаказПоПлательщикуИСумме(
	Плательщик,
	Сумма,
	ДатаОперации,
	Организация) Экспорт

	ПустойЗаказ = Документы.ЗаказПокупателя.ПустаяСсылка();

	Фамилия = ФамилияИзПредставления(Плательщик);

	Если ПустаяСтрока(Фамилия) Или Сумма = 0 Тогда
		Возврат ПустойЗаказ;
	КонецЕсли;

	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	ЗаказПокупателя.Ссылка КАК Ссылка,
	|	ЗаказПокупателя.Контрагент.Наименование КАК Контрагент
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	НЕ ЗаказПокупателя.ПометкаУдаления
	|	И ЗаказПокупателя.СуммаДокумента = &Сумма
	|	И ЗаказПокупателя.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|	%ОРГАНИЗАЦИЯ%
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.Дата УБЫВ";

	Запрос = Новый Запрос;

	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстЗапроса = СтрЗаменить(
			ТекстЗапроса,
			"%ОРГАНИЗАЦИЯ%",
			"И ЗаказПокупателя.Организация = &Организация");
		Запрос.УстановитьПараметр("Организация", Организация);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ОРГАНИЗАЦИЯ%", "");
	КонецЕсли;

	Запрос.Текст = ТекстЗапроса;

	Запрос.УстановитьПараметр("Сумма", Сумма);
	Запрос.УстановитьПараметр(
		"ДатаНачала",
		НачалоДня(ДатаОперации - 30 * 24 * 60 * 60));
	Запрос.УстановитьПараметр("ДатаКонца", КонецДня(ДатаОперации));

	Выборка = Запрос.Выполнить().Выбрать();

	Найденный = ПустойЗаказ;
	Совпадений = 0;

	Пока Выборка.Следующий() Цикл

		Если ФамилияИзПредставления(Выборка.Контрагент) = Фамилия Тогда
			Найденный = Выборка.Ссылка;
			Совпадений = Совпадений + 1;
		КонецЕсли;

	КонецЦикла;

	Если Совпадений = 1 Тогда
		Возврат Найденный;
	КонецЕсли;

	Возврат ПустойЗаказ;

КонецФункции

// Фамилия из «ФО-П ПАЛЬШИН ЮРІЙ ІГОРОВИЧ» или «Ставицький Віталій».
// Латинская «I» приводится к украинской: банк пишет «РИЖКОВ IГОР»
// латиницей, и в выписке, и в письмах.
Функция ФамилияИзПредставления(Знач Представление) Экспорт

	Текст = ВРег(СокрЛП(Строка(Представление)));

	Текст = СтрЗаменить(Текст, "ФО-П", " ");
	Текст = СтрЗаменить(Текст, "ФОП", " ");
	Текст = СтрЗаменить(Текст, "ТОВ", " ");
	Текст = СтрЗаменить(Текст, "ПРИВАТНЕ ПІДПРИЄМСТВО", " ");
	Текст = СтрЗаменить(Текст, "ПП ", " ");
	Текст = СтрЗаменить(Текст, """", " ");
	Текст = СтрЗаменить(Текст, ".", " ");
	Текст = СтрЗаменить(Текст, ",", " ");

	Слова = РазложитьСтрокуПоРазделителю(Текст, " ");

	Если Слова.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Слово = Слова[0];

	Слово = СтрЗаменить(Слово, "I", "І");
	Слово = СтрЗаменить(Слово, "Ї", "Ї");

	Возврат Слово;

КонецФункции

// Контрагент по коду ЄДРПОУ или РНОКПП из выписки. Только однозначное
// совпадение: один код — один контрагент.
Функция НайтиКонтрагентаПоКодуВыписки(Знач Код) Экспорт

	ПустойКонтрагент = Справочники.Контрагенты.ПустаяСсылка();

	Код = СокрЛП(Строка(Код));

	Если СтрДлина(Код) < 8 Тогда
		Возврат ПустойКонтрагент;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	И НЕ Контрагенты.ЭтоГруппа
	|	И (Контрагенты.КодПоЕДРПОУ = &Код
	|		ИЛИ Контрагенты.ИНН = &Код)";

	Запрос.УстановитьПараметр("Код", Код);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		Возврат ПустойКонтрагент;
	КонецЕсли;

	Первый = Выборка.Ссылка;

	Если Выборка.Следующий() Тогда
		Возврат ПустойКонтрагент;
	КонецЕсли;

	Возврат Первый;

КонецФункции

#КонецОбласти

#Область РеестрЗачисленийGoogle

// Реестр зачислений — Google-таблица, которую наполняет разбор писем банка
// и дневных выписок. Своего API у неё нет: таблица отдаётся как CSV по адресу
// gviz/tq. Именно gviz, а не export: export отвечает редиректом на
// googleusercontent, а платформа по редиректам сама не ходит.
//
// Настройка подразделения:
//   Токен банковской выписки — ссылка на таблицу целиком либо её идентификатор;
//   Айди банковской выписки  — gid листа (пусто = первый лист);
//   Банковский счет выписки  — счёт зачисления. По нему же строки и отбираются:
//     в таблице может быть несколько счетов, берём только свой;
//   Начало загрузки выписки  — операции раньше этой даты не берём.
//
// Платежи по этому источнику автоматически не создаются и задачи не ставятся
// (см. ИсточникСобираетТолькоТаблицу): строки только складываются в таблицу
// обработки, документы заводит человек кнопкой «Загрузить в 1С».
Функция ПолучитьОперацииРеестраGoogle(Настройка, ДатаНачала, ДатаКонца) Экспорт

	Операции = Новый Массив;

	Если Настройка = Неопределено Тогда
		Возврат Операции;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаКонца) Тогда
		Возврат Операции;
	КонецЕсли;

	АдресТаблицы = СокрЛП(Строка(Настройка.Токен));

	Если ПустаяСтрока(АдресТаблицы) Тогда

		ОшибкаРеестраЗачислений(
			Настройка,
			"Не указана ссылка на таблицу реестра зачислений"
			+ " (реквизит «Токен банковской выписки» подразделения).");

		Возврат Операции;

	КонецЕсли;

	ИдентификаторТаблицы = ИдентификаторТаблицыGoogle(АдресТаблицы);

	Если ПустаяСтрока(ИдентификаторТаблицы) Тогда

		ОшибкаРеестраЗачислений(
			Настройка,
			"Из ссылки «" + АдресТаблицы
			+ "» не удалось выделить идентификатор таблицы.");

		Возврат Операции;

	КонецЕсли;

	// Счёт берём из самой строки, а не из настройки: в таблице несколько
	// счетов и несколько фирм сразу (18.09.2026 там уже были ОТП Банк ФОПа
	// и Райффайзен ТОВ рядом с исходным счётом). Строка принимается, если её
	// счёт заведён в справочнике и принадлежит организации.
	СчетаПоНомеру = СчетаОрганизацийПоНомеру();

	Если СчетаПоНомеру.Количество() = 0 Тогда

		ОшибкаРеестраЗачислений(
			Настройка,
			"В справочнике банковских счетов нет ни одного счёта организации"
			+ " — сопоставлять строки реестра не с чем.");

		Возврат Операции;

	КонецЕсли;

	Лист = СокрЛП(Строка(Настройка.Айди));

	Если ПустаяСтрока(Лист) Тогда
		Лист = "0";
	КонецЕсли;

	Ресурс = "/spreadsheets/d/" + ИдентификаторТаблицы
		+ "/gviz/tq?tqx=out:csv&gid=" + Лист;

	ТекстТаблицы = ПолучитьТекстПоHTTPS("docs.google.com", Ресурс, Настройка, 0);

	Если ТекстТаблицы = Неопределено Тогда
		Возврат Операции;
	КонецЕсли;

	СтрокиCSV = РазобратьCSV(ТекстТаблицы);

	Если СтрокиCSV.Количество() < 2 Тогда

		ОшибкаРеестраЗачислений(
			Настройка,
			"Таблица реестра зачислений пуста либо отдана не в виде CSV."
			+ " Получено символов: " + Строка(СтрДлина(ТекстТаблицы)) + ".");

		Возврат Операции;

	КонецЕсли;

	Заголовки = СтрокиCSV[0];

	// Колонки ищем по заголовкам, а не по номерам: таблицу ведёт сторонний
	// сценарий, и порядок колонок в ней не наш.
	ИндексДаты        = ИндексКолонкиCSV(Заголовки, "Дата документа");
	ИндексВремени     = ИндексКолонкиCSV(Заголовки, "Час документа");
	ИндексТипа        = ИндексКолонкиCSV(Заголовки, "Тип операції");
	ИндексСуммы       = ИндексКолонкиCSV(Заголовки, "Сума");
	ИндексСчета       = ИндексКолонкиCSV(Заголовки, "Рахунок отримувача");
	ИндексПлательщика = ИндексКолонкиCSV(Заголовки, "Платник");
	ИндексКода        = ИндексКолонкиCSV(Заголовки, "Код РНОКПП");
	ИндексНомера      = ИндексКолонкиCSV(Заголовки, "Номер документа");
	ИндексНазначения  = ИндексКолонкиCSV(Заголовки, "Призначення платежу");
	ИндексИсточника   = ИндексКолонкиCSV(Заголовки, "Джерело");

	ОтсутствующиеКолонки = "";

	Если ИндексДаты < 0 Тогда
		ОтсутствующиеКолонки = ОтсутствующиеКолонки + " «Дата документа»";
	КонецЕсли;

	Если ИндексСуммы < 0 Тогда
		ОтсутствующиеКолонки = ОтсутствующиеКолонки + " «Сума, грн.»";
	КонецЕсли;

	Если ИндексНомера < 0 Тогда
		ОтсутствующиеКолонки = ОтсутствующиеКолонки + " «Номер документа»";
	КонецЕсли;

	Если ИндексСчета < 0 Тогда
		ОтсутствующиеКолонки = ОтсутствующиеКолонки + " «Рахунок отримувача»";
	КонецЕсли;

	Если Не ПустаяСтрока(ОтсутствующиеКолонки) Тогда

		ОшибкаРеестраЗачислений(
			Настройка,
			"В таблице реестра нет обязательных колонок:"
			+ ОтсутствующиеКолонки + ".");

		Возврат Операции;

	КонецЕсли;

	НачалоОтбора = НачалоДня(ДатаНачала);

	// Отсечка «грузим только с такого-то числа»: старую историю таблицы
	// в базу не тянем, её уже разнесли руками.
	Если ЗначениеЗаполнено(Настройка.НачалоЗагрузки)
		И НачалоДня(Настройка.НачалоЗагрузки) > НачалоОтбора Тогда

		НачалоОтбора = НачалоДня(Настройка.НачалоЗагрузки);

	КонецЕсли;

	КонецОтбора = КонецДня(ДатаКонца);

	ЧужойСчет   = 0;
	ВнеПериода  = 0;
	БезДанных   = 0;

	// Номера счетов, которых нет в справочнике: по ним видно, что в таблицу
	// добавили новый счёт, а в базе его ещё не завели.
	НеопознанныеСчета = Новый Соответствие;

	Для Сч = 1 По СтрокиCSV.Количество() - 1 Цикл

		СтрокаCSV = СтрокиCSV[Сч];

		НомерДокумента = СокрЛП(ЗначениеCSV(СтрокаCSV, ИндексНомера));
		СчетПолучателя = НормализованнаяСтрокаСчета(
			ЗначениеCSV(СтрокаCSV, ИндексСчета));

		Если ПустаяСтрока(НомерДокумента) Тогда
			БезДанных = БезДанных + 1;
			Продолжить;
		КонецЕсли;

		ДанныеСчета = СчетаПоНомеру.Получить(СчетПолучателя);

		// Счёт не заведён в базе либо номер числится сразу за несколькими
		// фирмами — строку всё равно берём (решение заказчика от 18.09.2026):
		// пустой счёт в таблице лучше, чем пропавший платёж. Заказ по такой
		// строке ищется без отбора по организации, а в платёжном документе
		// поле счёта остаётся пустым — подставлять «похожий» счёт нельзя.
		Если ДанныеСчета = Неопределено
			Или ТипЗнч(ДанныеСчета) <> Тип("Структура") Тогда

			ЧужойСчет = ЧужойСчет + 1;

			Если Не ПустаяСтрока(СчетПолучателя) Тогда
				НеопознанныеСчета.Вставить(СчетПолучателя, Истина);
			КонецЕсли;

			СчетСтроки = Справочники.БанковскиеСчета.ПустаяСсылка();
			Организация = Справочники.Организации.ПустаяСсылка();

		Иначе

			СчетСтроки = ДанныеСчета.Счет;
			Организация = ДанныеСчета.Организация;

		КонецЕсли;

		ДатаОперации = ДатаИзСтрокиРеестра(
			ЗначениеCSV(СтрокаCSV, ИндексДаты),
			ЗначениеCSV(СтрокаCSV, ИндексВремени));

		Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
			БезДанных = БезДанных + 1;
			Продолжить;
		КонецЕсли;

		Если ДатаОперации < НачалоОтбора Или ДатаОперации > КонецОтбора Тогда
			ВнеПериода = ВнеПериода + 1;
			Продолжить;
		КонецЕсли;

		СуммаОперации = ЧислоИзСтрокиРеестра(ЗначениеCSV(СтрокаCSV, ИндексСуммы));

		Если СуммаОперации = 0 Тогда
			БезДанных = БезДанных + 1;
			Продолжить;
		КонецЕсли;

		ТипОперации = ВРег(СокрЛП(ЗначениеCSV(СтрокаCSV, ИндексТипа)));

		// «Зарахування» / «Списання». Колонки может не быть вовсе — тогда
		// считаем поступлением: реестр для того и заведён.
		ЭтоВходящий = (Найти(ТипОперации, "СПИСАН") = 0);

		Плательщик = СокрЛП(ЗначениеCSV(СтрокаCSV, ИндексПлательщика));
		КодПлательщика = ТолькоЦифры(ЗначениеCSV(СтрокаCSV, ИндексКода));
		Назначение = СокрЛП(ЗначениеCSV(СтрокаCSV, ИндексНазначения));
		ИсточникСтроки = СокрЛП(ЗначениеCSV(СтрокаCSV, ИндексИсточника));

		Операция = СоздатьБанковскуюОперацию();

		Операция.Источник         = "РеестрЗачисленийGoogle";
		Операция.Идентификатор    = ИдентификаторОперацииРеестра(
			НомерДокумента,
			ДатаОперации);
		Операция.КлючДубляСтраниц = Операция.Идентификатор;
		Операция.БанковскийСчет   = СчетСтроки;
		Операция.Подразделение    = Настройка.Подразделение;
		Операция.ОрганизацияМерчанта = Настройка.ОрганизацияМерчанта;
		Операция.Дата             = ДатаОперации;
		Операция.Сумма            = СуммаОперации;
		Операция.Валюта           = ПолучитьВалютуГривна();
		Операция.Входящий         = ЭтоВходящий;
		Операция.Остаток          = 0;
		Операция.Терминал         = ИсточникСтрокиРеестра(ИсточникСтроки);
		Операция.Назначение       = Назначение;
		Операция.Плательщик       = Плательщик;
		Операция.КодПлательщика   = КодПлательщика;

		// Заказ ищем здесь же: строка выписки без заказа человеку почти
		// бесполезна, а в структуре операции поле для него уже есть.
		Если ЭтоВходящий Тогда

			Операция.Заказ = НайтиЗаказПоДаннымВыписки(
				Назначение,
				Плательщик,
				СуммаОперации,
				ДатаОперации,
				Организация);

		КонецЕсли;

		Операции.Добавить(Операция);

	КонецЦикла;

	ПримерыНеопознанных = "";
	Показано = 0;

	Для Каждого КлючИЗначение Из НеопознанныеСчета Цикл

		Если Показано >= 5 Тогда
			Прервать;
		КонецЕсли;

		ПримерыНеопознанных = ПримерыНеопознанных
			+ ?(ПустаяСтрока(ПримерыНеопознанных), "", ", ")
			+ КлючИЗначение.Ключ;

		Показано = Показано + 1;

	КонецЦикла;

	ТекстРазбора =
		"Реестр зачислений: строк в таблице " + Строка(СтрокиCSV.Количество() - 1)
		+ ", взято " + Строка(Операции.Количество())
		+ ", счёт не наш или не заведён " + Строка(ЧужойСчет)
		+ ", вне периода " + Строка(ВнеПериода)
		+ ", без данных " + Строка(БезДанных)
		+ " (период с " + Формат(НачалоОтбора, "ДФ=dd.MM.yyyy")
		+ " по " + Формат(КонецОтбора, "ДФ=dd.MM.yyyy")
		+ ", счетов организаций в базе " + Строка(СчетаПоНомеру.Количество()) + ")"
		+ ?(ПустаяСтрока(ПримерыНеопознанных),
			"", ". Не найдены в справочнике: " + ПримерыНеопознанных)
		+ ".";

	ОтладкаВыписокСообщить(ТекстРазбора);
	СводкаВыписокВЖурнал(ТекстРазбора);

	Возврат Операции;

КонецФункции

// Что показывать в колонке «Источник» у строки реестра. Сырой адрес почты
// в таблице ничего не объясняет, поэтому письмо банка так и называется;
// дневная выписка приходит строкой вида «Виписка АТ … за 08.09.2026».
Функция ИсточникСтрокиРеестра(Знач ИсточникСтроки) Экспорт

	Текст = СокрЛП(Строка(ИсточникСтроки));

	Если ПустаяСтрока(Текст) Тогда
		Возврат "Реєстр зарахувань";
	КонецЕсли;

	Если Найти(Текст, "@") > 0 Тогда
		Возврат "Реєстр: лист банку";
	КонецЕсли;

	Возврат Лев("Реєстр: " + Текст, 256);

КонецФункции

// Ключ строки выписки. Номер документа в реестре — это номер платёжки
// плательщика, а не референс банка: встречаются «95» и «1044», которые
// у разных плательщиков повторяются. Поэтому в ключ добавляется дата
// операции. Длина ключа — не больше 30 символов: столько же у реквизита
// НомерВходящегоДокумента, по которому ищется созданный платёж.
Функция ИдентификаторОперацииРеестра(НомерДокумента, ДатаОперации) Экспорт

	Ключ = "G" + Формат(ДатаОперации, "ДФ=ddMM") + "-" + СокрЛП(Строка(НомерДокумента));

	Возврат Лев(Ключ, 30);

КонецФункции

Процедура ОшибкаРеестраЗачислений(Настройка, Текст)

	Подразделение = Неопределено;

	Если Настройка <> Неопределено Тогда
		Подразделение = Настройка.Подразделение;
	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		"БанковскиеВыписки.РеестрЗачислений",
		УровеньЖурналаРегистрации.Ошибка,
		,
		Подразделение,
		Текст);

	ОтладкаВыписокСообщить("Реестр зачислений: " + Текст);

КонецПроцедуры

// GET с одним разрешённым переходом по редиректу (Apps Script отвечает 302
// на script.googleusercontent.com; сама платформа за редиректом не идёт).
Функция ПолучитьТекстПоHTTPS(Хост, Ресурс, Настройка, Глубина)

	Если Глубина > 3 Тогда

		ОшибкаРеестраЗачислений(
			Настройка,
			"Слишком много перенаправлений при чтении таблицы.");

		Возврат Неопределено;

	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("User-Agent", "1C-BankStatements");
	Заголовки.Вставить("Accept", "text/csv,text/plain,*/*");

	Соединение = Новый HTTPСоединение(
		Хост,
		443,
		,
		,
		,
		60,
		Новый ЗащищенноеСоединениеOpenSSL);

	Попытка

		Ответ = Соединение.Получить(Новый HTTPЗапрос(Ресурс, Заголовки));

	Исключение

		ОшибкаРеестраЗачислений(
			Настройка,
			"Ошибка обращения к " + Хост + ": " + ОписаниеОшибки());

		Возврат Неопределено;

	КонецПопытки;

	КодСостояния = Ответ.КодСостояния;

	Если КодСостояния = 301 Или КодСостояния = 302
		Или КодСостояния = 303 Или КодСостояния = 307 Или КодСостояния = 308 Тогда

		НовыйАдрес = ЗаголовокОтвета(Ответ, "location");

		Если ПустаяСтрока(НовыйАдрес) Тогда

			ОшибкаРеестраЗачислений(
				Настройка,
				"Сервер ответил кодом " + Строка(КодСостояния)
				+ " без адреса перенаправления.");

			Возврат Неопределено;

		КонецЕсли;

		АдресРазобран = РазобратьАдресHTTPS(НовыйАдрес);

		Если АдресРазобран = Неопределено Тогда

			ОшибкаРеестраЗачислений(
				Настройка,
				"Не удалось разобрать адрес перенаправления «" + НовыйАдрес + "».");

			Возврат Неопределено;

		КонецЕсли;

		Возврат ПолучитьТекстПоHTTPS(
			АдресРазобран.Хост,
			АдресРазобран.Ресурс,
			Настройка,
			Глубина + 1);

	КонецЕсли;

	Если КодСостояния <> 200 Тогда

		ОшибкаРеестраЗачислений(
			Настройка,
			"Сервер " + Хост + " ответил кодом HTTP " + Строка(КодСостояния)
			+ ". Если таблица закрыта, доступ по ссылке нужно вернуть"
			+ " либо отдавать её через скрипт с ключом.");

		Возврат Неопределено;

	КонецЕсли;

	Попытка
		Возврат Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Исключение
		Возврат Ответ.ПолучитьТелоКакСтроку();
	КонецПопытки;

КонецФункции

Функция ЗаголовокОтвета(Ответ, ИмяЗаголовка)

	Попытка

		Для Каждого КлючИЗначение Из Ответ.Заголовки Цикл

			Если НРег(Строка(КлючИЗначение.Ключ)) = НРег(ИмяЗаголовка) Тогда
				Возврат СокрЛП(Строка(КлючИЗначение.Значение));
			КонецЕсли;

		КонецЦикла;

	Исключение
	КонецПопытки;

	Возврат "";

КонецФункции

Функция РазобратьАдресHTTPS(Знач Адрес)

	Адрес = СокрЛП(Строка(Адрес));

	Если Лев(НРег(Адрес), 8) = "https://" Тогда
		Адрес = Сред(Адрес, 9);
	ИначеЕсли Лев(НРег(Адрес), 7) = "http://" Тогда
		Адрес = Сред(Адрес, 8);
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Позиция = Найти(Адрес, "/");

	Если Позиция = 0 Тогда
		Возврат Новый Структура("Хост, Ресурс", Адрес, "/");
	КонецЕсли;

	Возврат Новый Структура(
		"Хост, Ресурс",
		Лев(Адрес, Позиция - 1),
		Сред(Адрес, Позиция));

КонецФункции

// Из ссылки вида .../spreadsheets/d/<id>/edit#gid=0 берём <id>.
// Если передан голый идентификатор — возвращаем как есть.
Функция ИдентификаторТаблицыGoogle(Знач Ссылка) Экспорт

	Ссылка = СокрЛП(Строка(Ссылка));

	Позиция = Найти(Ссылка, "/d/");

	Если Позиция = 0 Тогда

		// Голый идентификатор: букв, цифр, дефисов и подчёркиваний.
		Если Найти(Ссылка, "/") > 0 Тогда
			Возврат "";
		КонецЕсли;

		Возврат Ссылка;

	КонецЕсли;

	Хвост = Сред(Ссылка, Позиция + 3);

	КонецИдентификатора = Найти(Хвост, "/");

	Если КонецИдентификатора > 0 Тогда
		Хвост = Лев(Хвост, КонецИдентификатора - 1);
	КонецЕсли;

	ЗнакВопроса = Найти(Хвост, "?");

	Если ЗнакВопроса > 0 Тогда
		Хвост = Лев(Хвост, ЗнакВопроса - 1);
	КонецЕсли;

	Возврат СокрЛП(Хвост);

КонецФункции

// Разбор CSV: кавычки, удвоенные кавычки внутри значения, переводы строк
// внутри кавычек. Платформенных средств для этого нет, СтрРазделить в режиме
// совместимости 8.2.13 недоступна.
//
// Возвращаемое значение:
//   Массив - строки таблицы, каждая строка — массив значений колонок.
Функция РазобратьCSV(Знач Текст) Экспорт

	Результат = Новый Массив;

	Текст = Строка(Текст);

	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	ТекущаяСтрока = Новый Массив;
	Значение      = "";
	ВКавычках     = Ложь;

	Позиция = 1;
	Длина   = СтрДлина(Текст);

	Пока Позиция <= Длина Цикл

		Символ = Сред(Текст, Позиция, 1);

		Если ВКавычках Тогда

			Если Символ = """" Тогда

				Если Позиция < Длина И Сред(Текст, Позиция + 1, 1) = """" Тогда
					Значение = Значение + """";
					Позиция  = Позиция + 1;
				Иначе
					ВКавычках = Ложь;
				КонецЕсли;

			Иначе

				Значение = Значение + Символ;

			КонецЕсли;

		Иначе

			Если Символ = """" Тогда

				ВКавычках = Истина;

			ИначеЕсли Символ = "," Тогда

				ТекущаяСтрока.Добавить(Значение);
				Значение = "";

			ИначеЕсли Символ = Символы.ПС Или Символ = Символы.ВК Тогда

				// CRLF — один разрыв, а не два.
				Если Символ = Символы.ВК
					И Позиция < Длина
					И Сред(Текст, Позиция + 1, 1) = Символы.ПС Тогда

					Позиция = Позиция + 1;

				КонецЕсли;

				ТекущаяСтрока.Добавить(Значение);
				Результат.Добавить(ТекущаяСтрока);

				ТекущаяСтрока = Новый Массив;
				Значение      = "";

			Иначе

				Значение = Значение + Символ;

			КонецЕсли;

		КонецЕсли;

		Позиция = Позиция + 1;

	КонецЦикла;

	Если Не ПустаяСтрока(Значение) Или ТекущаяСтрока.Количество() > 0 Тогда
		ТекущаяСтрока.Добавить(Значение);
		Результат.Добавить(ТекущаяСтрока);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Колонку ищем по началу заголовка: «Сума, грн.» может оказаться
// «Сума, грн» или «Сума».
Функция ИндексКолонкиCSV(Заголовки, Знач Имя) Экспорт

	Имя = ВРег(СокрЛП(Строка(Имя)));

	Для Сч = 0 По Заголовки.Количество() - 1 Цикл

		Заголовок = ВРег(СокрЛП(Строка(Заголовки[Сч])));

		Если Заголовок = Имя Или Лев(Заголовок, СтрДлина(Имя)) = Имя Тогда
			Возврат Сч;
		КонецЕсли;

	КонецЦикла;

	Возврат -1;

КонецФункции

Функция ЗначениеCSV(СтрокаCSV, Индекс)

	Если Индекс < 0 Или Индекс > СтрокаCSV.Количество() - 1 Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(СтрокаCSV[Индекс]);

КонецФункции

// «16 036,00» и «16 036,00» с неразрывным пробелом (так отдаёт gviz).
Функция ЧислоИзСтрокиРеестра(Знач Текст) Экспорт

	Если ТипЗнч(Текст) = Тип("Число") Тогда
		Возврат Текст;
	КонецЕсли;

	Текст = СокрЛП(Строка(Текст));

	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символ(160), "");
	Текст = СтрЗаменить(Текст, Символы.НПП, "");
	Текст = СтрЗаменить(Текст, ",", ".");

	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// «14.09.2026» + «10:05:04».
Функция ДатаИзСтрокиРеестра(Знач ЧастьДаты, Знач ЧастьВремени) Экспорт

	ЧастьДаты = СокрЛП(Строка(ЧастьДаты));

	Если ПустаяСтрока(ЧастьДаты) Тогда
		Возврат Неопределено;
	КонецЕсли;

	КомпонентыДаты = РазложитьСтрокуПоРазделителю(ЧастьДаты, ".");

	Если КомпонентыДаты.Количество() < 3 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КомпонентыВремени = РазложитьСтрокуПоРазделителю(
		СокрЛП(Строка(ЧастьВремени)),
		":");

	Попытка

		Год   = Число(КомпонентыДаты[2]);
		Месяц = Число(КомпонентыДаты[1]);
		День  = Число(КомпонентыДаты[0]);

		Час = ?(КомпонентыВремени.Количество() > 0,
			Число(КомпонентыВремени[0]), 0);

		Минута = ?(КомпонентыВремени.Количество() > 1,
			Число(КомпонентыВремени[1]), 0);

		Секунда = ?(КомпонентыВремени.Количество() > 2,
			Число(КомпонентыВремени[2]), 0);

		Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);

	Исключение

		Возврат Неопределено;

	КонецПопытки;

КонецФункции

Функция ТолькоЦифры(Знач Текст) Экспорт

	Текст = Строка(Текст);
	Результат = "";

	Для Позиция = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Позиция, 1);

		Если Найти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НормализованнаяСтрокаСчета(Знач Текст) Экспорт

	Текст = ВРег(СокрЛП(Строка(Текст)));

	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, Символ(160), "");

	Возврат Текст;

КонецФункции

Функция НормализованныйНомерСчета(Счет) Экспорт

	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат НормализованнаяСтрокаСчета(Счет.НомерСчета);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Счета организаций, разложенные по нормализованному номеру.
//
// Возвращаемое значение:
//   Соответствие - ключ: номер счёта без пробелов, в верхнем регистре;
//                  значение: Структура(Счет, Организация).
//
// Счета контрагентов сюда не попадают: строка реестра — это зачисление
// НАМ, и получателем может быть только наша фирма.
Функция СчетаОрганизацийПоНомеру() Экспорт

	Результат = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	БанковскиеСчета.Ссылка КАК Счет,
	|	БанковскиеСчета.НомерСчета КАК НомерСчета,
	|	БанковскиеСчета.Владелец КАК Владелец
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	НЕ БанковскиеСчета.ПометкаУдаления
	|	И ТИПЗНАЧЕНИЯ(БанковскиеСчета.Владелец) = ТИП(Справочник.Организации)";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Номер = НормализованнаяСтрокаСчета(Выборка.НомерСчета);

		Если ПустаяСтрока(Номер) Тогда
			Продолжить;
		КонецЕсли;

		Известное = Результат.Получить(Номер);

		Если Известное <> Неопределено Тогда

			// Один и тот же номер у двух карточек одной фирмы — обычное дело
			// (с IBAN и без), берём первую. А вот номер, числящийся за разными
			// фирмами, опознанием считать нельзя: в базе таких сорок. Такую
			// строку оставляем без счёта, чем подставляем чужую фирму.
			Если Известное <> Неопределено
				И ТипЗнч(Известное) = Тип("Структура")
				И Известное.Организация <> Выборка.Владелец Тогда

				Результат.Вставить(Номер, "неоднозначный");

			КонецЕсли;

			Продолжить;

		КонецЕсли;

		Результат.Вставить(
			Номер,
			Новый Структура("Счет, Организация", Выборка.Счет, Выборка.Владелец));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Организация — владелец счёта зачисления. У счёта владелец составной
// (организация или контрагент), поэтому лишнее отсекаем по типу.
Функция ОрганизацияБанковскогоСчета(Счет) Экспорт

	ПустаяОрганизация = Справочники.Организации.ПустаяСсылка();

	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат ПустаяОрганизация;
	КонецЕсли;

	Попытка

		Владелец = Счет.Владелец;

		Если ТипЗнч(Владелец) = Тип("СправочникСсылка.Организации") Тогда
			Возврат Владелец;
		КонецЕсли;

	Исключение
	КонецПопытки;

	Возврат ПустаяОрганизация;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разложение строки по односимвольному разделителю.
// Платформенная СтрРазделить недоступна: режим совместимости конфигурации —
// "Версия 8.2.13" (см. Configuration.xml, CompatibilityMode).
Функция РазложитьСтрокуПоРазделителю(Знач Текст, Знач Разделитель)

	Результат = Новый Массив;

	Текст = Строка(Текст);

	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Пока Истина Цикл

		Позиция = Найти(Текст, Разделитель);

		Если Позиция = 0 Тогда

			Если Не ПустаяСтрока(Текст) Тогда
				Результат.Добавить(СокрЛП(Текст));
			КонецЕсли;

			Прервать;

		КонецЕсли;

		Часть = Лев(Текст, Позиция - 1);

		Если Не ПустаяСтрока(Часть) Тогда
			Результат.Добавить(СокрЛП(Часть));
		КонецЕсли;

		Текст = Сред(Текст, Позиция + СтрДлина(Разделитель));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Смещение локального времени относительно UTC (украинское летнее время).
Функция СмещениеЧасовогоПоясаВыписок()

	Возврат 3 * 60 * 60;

КонецФункции

Функция ПолучитьВалютуГривна()

	Валюта = Справочники.Валюты.НайтиПоКоду("980");

	Если ЗначениеЗаполнено(Валюта) Тогда
		Возврат Валюта;
	КонецЕсли;

	Возврат Константы.ВалютаУправленческогоУчета.Получить();

КонецФункции

// Отладка загрузки банковских выписок.
// Истина — подробные сообщения выводятся на экран при нажатии кнопки
// «Получить из Приват24». Регламентное задание работает в фоне, его сообщения
// не видны — ошибки API пишутся в журнал регистрации.
// Поставьте Ложь, когда загрузка подтверждена рабочей.
Функция ВключенаОтладкаБанковскихВыписок()

	Возврат Истина;

КонецФункции

Процедура ОтладкаВыписокСообщить(Текст)

	Если ВключенаОтладкаБанковскихВыписок() Тогда
		Сообщить("[Выписки] " + Строка(Текст));
	КонецЕсли;

КонецПроцедуры

// Короткий итог работы источника — в журнал регистрации.
//
// Отладка через Сообщить в регламентном задании не видна никому: сообщения
// фонового сеанса не показываются и нигде не сохраняются. Поэтому то немногое,
// по чему разбирают «почему строк нет», пишется отдельным событием — его видно
// и снаружи, через канал /db/cmd, действие log.
Процедура СводкаВыписокВЖурнал(Текст) Экспорт

	ЗаписьЖурналаРегистрации(
		"БанковскиеВыписки.Сводка",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		Строка(Текст));

КонецПроцедуры

#КонецОбласти
