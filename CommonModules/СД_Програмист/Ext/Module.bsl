				НаборЗаписей1.Отбор.ОбъектОбмена.Установить(ВыборкаДетальныеЗаписи.ОбъектОбмена);
				НаборЗаписей1.Отбор.Тип.Установить("СправочникСсылка.Клиенты");
				НаборЗаписей1.Записать(); 
