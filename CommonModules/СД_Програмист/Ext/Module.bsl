Процедура ОброботкаЗаполнения_СДОбработкаЗаполнения(Источник, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ДанныеЗаполнения = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	ТипЗначенияИсточник_ = ТипЗнч(Источник);    
	МетаданныеИсточник_ = Метаданные.НайтиПоТипу(ТипЗначенияИсточник_);   
	
	ТипЗначенияДанныеЗаполнения_ = ТипЗнч(ДанныеЗаполнения);    
	МетаданныеДанныеЗаполнения_ = Метаданные.НайтиПоТипу(ТипЗначенияДанныеЗаполнения_);   

	Если МетаданныеДанныеЗаполнения_ = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Основной_Контрагент_СД", МетаданныеИсточник_) 
		и ОбщегоНазначения.ЕстьРеквизитДокумента("Основной_Контрагент_СД", МетаданныеДанныеЗаполнения_) Тогда 
		  Источник.Основной_Контрагент_СД = ДанныеЗаполнения.Основной_Контрагент_СД;
	КонецЕсли;    
	  
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ОсновнойДоговорКонтрагента_СД", МетаданныеИсточник_) 
		и ОбщегоНазначения.ЕстьРеквизитДокумента("ОсновнойДоговорКонтрагента_СД", МетаданныеДанныеЗаполнения_) Тогда 
		  Источник.ОсновнойДоговорКонтрагента_СД = ДанныеЗаполнения.ОсновнойДоговорКонтрагента_СД;
	КонецЕсли;   
	  
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ОсновнаяСделка_СД", МетаданныеИсточник_) 
		и ОбщегоНазначения.ЕстьРеквизитДокумента("ОсновнаяСделка_СД", МетаданныеДанныеЗаполнения_) Тогда 
		  Источник.ОсновнаяСделка_СД = ДанныеЗаполнения.ОсновнаяСделка_СД;
  	КонецЕсли; 
	  
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ОсновнойДокументРасчетовСКонтрагентом_СД", МетаданныеИсточник_) 
		и ОбщегоНазначения.ЕстьРеквизитДокумента("ОсновнойДокументРасчетовСКонтрагентом_СД", МетаданныеДанныеЗаполнения_) Тогда 
		  Источник.ОсновнойДокументРасчетовСКонтрагентом_СД = ДанныеЗаполнения.ОсновнойДокументРасчетовСКонтрагентом_СД;
	КонецЕсли;  
	  
	//Если ТипЗначенияИсточник_ = Тип("ДокументОбъект.ПоступлениеТоваровУслуг") и 
	//	 ТипЗначенияИсточник_ = Тип("ДокументСсылка.ЗаказПоставщику") Тогда 
	//	  Источник.ОсновнаяСделка_СД = ДанныеЗаполнения;
	//КонецЕсли;	 

КонецПроцедуры
