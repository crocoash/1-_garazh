Процедура ОбновлениеСтатусовНП_СД() Экспорт
	//КлючAPI = Константы.КлючAPI_НП_СД.Получить();
	
	//Форма_СД = ПолучитьОбщуюФорму("ФормаВыбораПериода_СД");
	//Форма_СД.ОткрытьМодально();
	
	//мПотверждено = Форма_СД.мПотверждено;
	мНачПериода = НачалоДня(ТекущаяДата()) - 60 * 60 * 24 * 30;
	мКонПериода = КонецДня(ТекущаяДата());;
	
	//Если не мПотверждено Тогда
	//	Возврат;
	//КонецЕсли;
	
	//ТаблицаКлючейAPI = МодульНовойПошты_СД.ПолучитьСписокКлючейЗаПериод(мНачПериода,мКонПериода);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПокупателя.НП_APIКлюч
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.НП_ДатаНакладной МЕЖДУ &Дата1 И &Дата2
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПокупателя.НП_APIКлюч";
	
	Запрос.УстановитьПараметр("Дата1", мНачПериода);
	Запрос.УстановитьПараметр("Дата2", мКонПериода);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаКлючейAPI = РезультатЗапроса.Выгрузить();
	


	
	СтрСчетчик = 0;
	Для каждого СтрКлючей из ТаблицаКлючейAPI Цикл
		
		КлючAPI = СтрКлючей.НП_APIКлюч;
		//мНачПериода = СтрКлючей.Период;
		//Попытка
		//	мКонПериода = ТаблицаКлючейAPI[СтрСчетчик + 1].Период;
		//Исключение
		//	мКонПериода = КонецДня(ТекущаяДата());
		//КонецПопытки;
		СтрСчетчик = СтрСчетчик + 1;
		Если СокрЛП(КлючAPI) = "" Тогда
			//МодульНовойПошты_СД.СообщитьПользователю("Не внесен ключ API, функционал недоступен!");
			Продолжить;;
		КонецЕсли;
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказПокупателя.Ссылка,
		|	ЗаказПокупателя.НП_ТТН КАК НомерДок
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.НП_ДатаНакладной МЕЖДУ &Дата1 И &Дата2
		|	И ЗаказПокупателя.Проведен
		|	И ЗаказПокупателя.НП_APIКлюч = &НП_APIКлюч";
		
		Запрос.УстановитьПараметр("Дата1", НачалоДня(мНачПериода));
		Запрос.УстановитьПараметр("Дата2", КонецДня(мКонПериода));
		Запрос.УстановитьПараметр("НП_APIКлюч", КлючAPI);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ТабРеф = РезультатЗапроса.Выгрузить();	
		Сч = 0;
		КолСтрок = 0;
		Для каждого Стр из ТабРеф Цикл
			//Пока Сч < 100 Цикл
				КолСтрок = КолСтрок + 1;
				Если Сч = 0 тогда
					ТабЗаказов = Новый ТаблицаЗначений;
					ТабЗаказов.Колонки.Добавить("Ссылка");
					ТабЗаказов.Колонки.Добавить("НомерДок");
				КонецЕсли;
				
				Если не Стр.НомерДок = "" Тогда
					НоваяСтрока = ТабЗаказов.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
					Сч = Сч + 1;
				КонецЕсли;
				
				Если СЧ = 99 или КолСтрок = ТабРеф.Количество() и не ТабЗаказов.Количество() = 0 Тогда
					ТекущийКлюч = КлючAPI;
					ПараметрыМетода = Новый Структура;
					ПараметрыМетода.Вставить("API20",ТекущийКлюч);
					ПараметрыМетода.Вставить("ТабРеф",ТабЗаказов);
					ТекстЗапроса = МодульНовойПошты_СД.ПолучитьЗапрос_getStatusDocuments(ПараметрыМетода);
					ДокументДом  = МодульНовойПошты_СД.ПолучитьОтветДОМ(МодульНовойПошты_СД.ПолучитьТочкуВхода(),ТекстЗапроса,КлючAPI,Ложь);
					Если  ДокументДом = Неопределено тогда
						МодульНовойПошты_СД.СообщитьПользователю("Ошибка при получении ответа, метод: getStatusDocuments");
					КонецЕсли;
					Если не  МодульНовойПошты_СД.ЭтоУспех(ДокументДом) тогда
						ТекстИсключения = МодульНовойПошты_СД.ВернутьЕрор(ДокументДом);
						МодульНовойПошты_СД.СообщитьПользователю(ТекстИсключения+" getStatusDocuments");
					КонецЕсли;
					лВыполняемаяобработка = МодульНовойПошты_СД.ПолучитьПроцедуруПоМетоду("getStatusDocuments");
					Если не ЗначениеЗаполнено(лВыполняемаяобработка) тогда
						МодульНовойПошты_СД.СообщитьПользователю(ТекстИсключения = "Не назначен обработчик методу: getStatusDocuments");
					КонецЕсли;
					Результат = новый Структура();
					МодульНовойПошты_СД.РаспарситьОтвет(лВыполняемаяобработка, ДокументДом,Результат, "getStatusDocuments",ПараметрыМетода,ТекущийКлюч,Ложь);
					Сч = 0;
				КонецЕсли;
			//КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ОбновлениеОтделенийНП_СД() Экспорт
	Метод = "getWarehouses";
	ТаблицаМетодов = Новый ТаблицаЗначений;
	ТаблицаМетодов.Колонки.Добавить("Метод");
	Строка = ТаблицаМетодов.Добавить();
	Строка.Метод = Метод;
	МодульНовойПошты_СД.ЗаполнитьСправочникиНП(ТаблицаМетодов,ТекущаяДата()); 
КонецПроцедуры

Процедура ЗаписатьИзмененияДляКабинетаКлиента_СДПриЗаписи(Источник, Отказ) Экспорт
	
	Если не Отказ Тогда
		Если ТипЗнч(Источник.Ссылка) = Тип("СправочникСсылка.Номенклатура") Тогда
			//Если Источник.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоКоду("000000002") Тогда
			Если Источник.ЭтоГруппа Тогда
				Возврат;
