Функция СоздатьОбновитьСвойство(Base1С,СправочникПоиска,ЗначениеПоиска, МодельПроизводтель = "")
	
	Если ЗначениеПоиска = "" Тогда
		Возврат Base1С.Справочники[СправочникПоиска].ПустаяСсылка();	
	КонецЕсли;
	
	РезПоиска =  Base1С.Справочники[СправочникПоиска].ПустаяСсылка();
	Попытка	
		Запрос = Base1С.NewObject("Запрос");
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СправочникПоиска.Ссылка
		|ИЗ
		|	Справочник."+СправочникПоиска+" КАК СправочникПоиска
		|ГДЕ
		|	СправочникПоиска.НаименованиеУТ = &НаименованиеУТ";
		
		Запрос.УстановитьПараметр("НаименованиеУТ",ЗначениеПоиска);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			РезПоиска = ВыборкаДетальныеЗаписи.ссылка;
		КонецЦикла;
	Исключение	
		РезПоиска = Base1С.Справочники[СправочникПоиска].НайтиПоНаименованию(ЗначениеПоиска,истина);
	КонецПопытки;
	Если РезПоиска =  Base1С.Справочники[СправочникПоиска].ПустаяСсылка() Тогда
		НовыйОбъект = Base1С.Справочники[СправочникПоиска].СоздатьЭлемент();
		НовыйОбъект.Наименование = ЗначениеПоиска;
		НовыйОбъект.НаименованиеУТ = ЗначениеПоиска;
		
		Если не МодельПроизводтель = "" Тогда 
			НовыйОбъект.Производитель = СоздатьОбновитьСвойство(Base1С,"ЗначениеПараметраПроизводитель",МодельПроизводтель);	
		КонецЕсли;
		
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
	Иначе
		Возврат РезПоиска.ссылка;
	КонецЕсли;	

КонецФункции

Функция ПолучитьЗначенияСвойств()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияСвойствОбъектов.Объект,
		|	ЗначенияСвойствОбъектов.Свойство,
		|	ЗначенияСвойствОбъектов.Значение
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
	
	Возврат ВыборкаДетальныеЗаписи;
КонецФункции
