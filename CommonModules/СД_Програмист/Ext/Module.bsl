			НоваяЗапись1.Тип ="СправочникСсылка.УсловияОплаты";
			
			НаборЗаписей1.Записать();
			
		ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("СправочникСсылка.Склады") Тогда 
			Если Источник.ЭтоГруппа Тогда
				Возврат;
			КонецЕсли;
			НаборЗаписей1 = РегистрыСведений.ОбъектыДляОбмена.СоздатьНаборЗаписей();
			
			НаборЗаписей1.Отбор.ОбъектОбмена.Установить(Источник.Ссылка);
