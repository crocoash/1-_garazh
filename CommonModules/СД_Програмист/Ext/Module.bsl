		//		НоваяЗапись1 = НаборЗаписей1.Добавить();
		//		
		//		НоваяЗапись1.период = ТекущаяДата();
		//		НоваяЗапись1.ОбъектОбмена=Источник.Ссылка;
		//		НоваяЗапись1.Тип ="СправочникСсылка.Статусы";
		//		
		//		НаборЗаписей1.Записать();
		//	ИначеЕсли Источник.ТипДокумента = Перечисления.ТипыДокументовДляСтатусов.ЗаказПокупателя Тогда 
		//		НаборЗаписей1 = РегистрыСведений.ОбъектыДляОбмена.СоздатьНаборЗаписей();
		//		
		//		НаборЗаписей1.Отбор.ОбъектОбмена.Установить(Источник.Ссылка);
		//		НаборЗаписей1.Отбор.Тип.Установить("СправочникСсылка.Статусы_ЗаказПокупателя");
		//		
		//		НоваяЗапись1 = НаборЗаписей1.Добавить();
		//		
		//		НоваяЗапись1.период = ТекущаяДата();
		//		НоваяЗапись1.ОбъектОбмена=Источник.Ссылка;
