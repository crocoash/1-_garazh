				//	НоваяЗапись1.ОбъектОбмена=Источник.Ссылка;
				//	НоваяЗапись1.Тип ="ДокументСсылка.Изменения_ПредЗаказ";
				//	НаборЗаписей1.Записать();
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя")
			или ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ВозвратТоваровПоставщику")
			или ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ПеремещениеТоваров") 
			или ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровУслуг") 
			или ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг")
			или ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.СписаниеТоваров") Тогда	
			Для каждого Стр из Источник.Товары Цикл
				НаборЗаписей1 = РегистрыСведений.ОбъектыДляОбмена.СоздатьНаборЗаписей();
				
				НаборЗаписей1.Отбор.ОбъектОбмена.Установить(Стр.Номенклатура);
				НаборЗаписей1.Отбор.Тип.Установить("СправочникСсылка.Остаток_Номенклатура");
				
				НоваяЗапись1 = НаборЗаписей1.Добавить();
				
				НоваяЗапись1.период = ТекущаяДата();
