Функция ПолучитьВидНоменклатуры(Base1С,ВидНоменклатуры)
	НайденВид = Base1С.справочники.ВидНоменклатуры.НайтиПоРеквизиту("ВнешнийКод",ВидНоменклатуры.Код);
	Если НайденВид = Base1С.справочники.ВидНоменклатуры.ПустаяСсылка() Тогда
		НовыйВид = Base1С.справочники.ВидНоменклатуры.СоздатьЭлемент();
		НовыйВид.Наименование = ВидНоменклатуры.Наименование; 
		НовыйВид.ВнешнийКод = ВидНоменклатуры.Код;
        НовыйВид.Записать();
		Возврат НовыйВид.Ссылка;
	Иначе
		Возврат НайденВид.ссылка;
	КонецЕсли;
КонецФункции

