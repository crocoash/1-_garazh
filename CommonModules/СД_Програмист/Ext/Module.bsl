			НоваяЗапись1.Тип ="СправочникСсылка.Клиенты";
			
			НаборЗаписей1.Записать(); 
		ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда 
			//Если не Источник.Проведен Тогда
			//	Возврат;
			//КонецЕсли;   
			
			Для каждого Стр из Источник.Товары Цикл
				НаборЗаписей1 = РегистрыСведений.ОбъектыДляОбмена.СоздатьНаборЗаписей();
				
				НаборЗаписей1.Отбор.ОбъектОбмена.Установить(Стр.Номенклатура);
				НаборЗаписей1.Отбор.Тип.Установить("СправочникСсылка.Остаток_Номенклатура");
				
				НоваяЗапись1 = НаборЗаписей1.Добавить();
				
				НоваяЗапись1.период = ТекущаяДата();
				НоваяЗапись1.ОбъектОбмена=Стр.Номенклатура;
				НоваяЗапись1.Тип ="СправочникСсылка.Остаток_Номенклатура";
				
				НаборЗаписей1.Записать();
				
			КонецЦикла;  	
			
			
			
			Если не ЗначениеЗаполнено(Источник.ПредЗаказ) Тогда
				Возврат;
			КонецЕсли; 
			
			Если Источник.ПредЗаказ.НомерКабинет = "" Тогда
				Возврат;
			КонецЕсли;
			НаборЗаписей1 = РегистрыСведений.ОбъектыДляОбмена.СоздатьНаборЗаписей();
			
			НаборЗаписей1.Отбор.ОбъектОбмена.Установить(Источник.ПредЗаказ.Ссылка);
			НаборЗаписей1.Отбор.Тип.Установить("ДокументСсылка.ПредЗаказ");
			
			НоваяЗапись1 = НаборЗаписей1.Добавить();
			
			НоваяЗапись1.период = ТекущаяДата();
			НоваяЗапись1.ОбъектОбмена=Источник.ПредЗаказ.Ссылка;
			НоваяЗапись1.Тип ="ДокументСсылка.ПредЗаказ";
			
			НаборЗаписей1.Записать();
		ИначеЕсли ТипЗнч(Источник.Ссылка) = Тип("ДокументСсылка.ПредЗаказ") и не Источник.ПометкаУдаления Тогда
			НайденКлиентОпт = Справочники.Клиенты.НайтиПоРеквизиту("Контрагент",Источник.Контрагент);
			Если Не НайденКлиентОпт = Справочники.Клиенты.ПустаяСсылка() Тогда 
