Процедура ОбменНоменклатурой(Base1С,НомСсылка) Экспорт 
	КлючПоиска         = СокрЛП(НомСсылка.Код);
	//
	
	РезПоиска = Base1С.Справочники.Номенклатура.НайтиПоРеквизиту("ВнешнийКод",КлючПоиска); 
	
	Если РезПоиска =  Base1С.Справочники.Номенклатура.ПустаяСсылка() Тогда
		НовыйОбъект = Base1С.Справочники.Номенклатура.СоздатьЭлемент();
	Иначе
		НовыйОбъект = РезПоиска.ПОлучитьОбъект();
	КонецЕсли;	 
	НовыйОбъект.ВидНоменклатуры = ПолучитьВидНоменклатуры(Base1С,НомСсылка.ВидНоменклатуры);
	НовыйОбъект.Наименование = НомСсылка.Наименование;
	НовыйОбъект.ВнешнийКод = НомСсылка.Код; 
	НовыйОбъект.Артикул = НомСсылка.Артикул;
	НовыйОбъект.Ширина = СоздатьОбновитьСвойство(Base1С,"ЗначениеПараметраШирина",НомСсылка.Ширина.Наименование);
	НовыйОбъект.Высота = СоздатьОбновитьСвойство(Base1С,"ЗначениеПараметраВысота",НомСсылка.ВысотаПрофиля.Наименование);
	НовыйОбъект.Диаметр = СоздатьОбновитьСвойство(Base1С,"ЗначениеПараметраДиаметр",НомСсылка.ДиаметрДиска.Наименование);
	НовыйОбъект.Сезон = СоздатьОбновитьСвойство(Base1С,"ЗначениеПараметраСезон",Строка(НомСсылка.Сезонность));
	НовыйОбъект.Производитель = СоздатьОбновитьСвойство(Base1С,"ЗначениеПараметраПроизводитель",НомСсылка.Производитель.Наименование);
	НовыйОбъект.Модель = СоздатьОбновитьСвойство(Base1С,"ЗначениеПараметраМодель",НомСсылка.Модель.Наименование,НомСсылка.Модель.Владелец.Наименование);
	НовыйОбъект.Усиление = СоздатьОбновитьСвойство(Base1С,"ЗначениеПараметраУсиление",НомСсылка.СпециальныйИндекс.Наименование);
	НовыйОбъект.Шипы = ?(ЗначениеЗаполнено(НомСсылка.Шипы),истина,Ложь);
