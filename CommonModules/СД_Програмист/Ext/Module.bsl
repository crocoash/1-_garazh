Процедура Регсистры_Взаиморасчеты_Основные_СДПередЗаписью(Источник, Отказ, Замещение) Экспорт
	Регистратор_ = Источник.Отбор.Регистратор.Значение;
	ТипЗначенияИсточника = ТипЗнч(Источник);    
	ТипЗначенияРегистратор_ = ТипЗнч(Регистратор_);    
	МетаданныеРегистратор_ = Метаданные.НайтиПоТипу(ТипЗначенияРегистратор_);
	МетаданныеРегистра = Метаданные.НайтиПоТипу(ТипЗначенияИсточника);
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("ОсновнойДокументРасчетовСКонтрагентом_СД", МетаданныеРегистратор_) Тогда 		
		Если ТипЗначенияИсточника = Тип("РегистрНакопленияНаборЗаписей.ВзаиморасчетыСКонтрагентамиПоДокументамРасчетов") Тогда
			Если ЗначениеЗаполнено(Регистратор_.ОсновнойДокументРасчетовСКонтрагентом_СД) Тогда 
				для Каждого СтрПров из Источник Цикл 
					СтрПров.ДокументРасчетовСКонтрагентом = Регистратор_.ОсновнойДокументРасчетовСКонтрагентом_СД;	
				КонецЦикла;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	Если ОбщегоНазначения.ЕстьРеквизитДокумента("Основной_Контрагент_СД", МетаданныеРегистратор_) Тогда 
		для Каждого СтрПров из Источник Цикл    
			Если ЗначениеЗаполнено(Регистратор_.Основной_Контрагент_СД) Тогда 
				СтрПров.Контрагент = Регистратор_.Основной_Контрагент_СД;
			КонецЕсли;	  
			Если ЗначениеЗаполнено(Регистратор_.ОсновнойДоговорКонтрагента_СД) Тогда 
				СтрПров.ДоговорКонтрагента = Регистратор_.ОсновнойДоговорКонтрагента_СД;
			КонецЕсли;				
			Если ОбщегоНазначения.ЕстьРеквизитДокумента("ОсновнаяСделка_СД", МетаданныеРегистратор_) Тогда  
				Если ЗначениеЗаполнено(Регистратор_.ОсновнаяСделка_СД) Тогда 
					СтрПров.Сделка = Регистратор_.ОсновнаяСделка_СД;
				КонецЕсли;				
            КонецЕсли;
		КонецЦикла; 
		//+БП: d.matyash (27.06.2024) <> 
		Если ТипЗнч(Регистратор_) = Тип("ДокументСсылка.ПлатежноеПоручениеИсходящее") И Источник.Количество() > 0 тогда	
			БП_РасшифровкаПлатежа = Регистратор_.БП_РасшифровкаПлатежа;
			Если БП_РасшифровкаПлатежа.Количество() > 1 И Регистратор_.РасшифровкаПлатежа.Количество() = 1  тогда
				ПервыйОбход = Истина; 
				
				Для каждого РасшифровкаПлатежа из БП_РасшифровкаПлатежа цикл
					Если ПервыйОбход тогда
						СтрПров.Сделка = РасшифровкаПлатежа.ОсновнаяСделка_СД; 
						СтрПров.СуммаВзаиморасчетов = РасшифровкаПлатежа.СуммаПлатежа;
						СтрПров.СуммаУпр = РасшифровкаПлатежа.СуммаПлатежа;
						ПервыйОбход = Ложь;
						Продолжить;
					КонецЕсли;
					
					Проводка = Источник.Добавить(); 
					ЗаполнитьЗначенияСвойств(Проводка, СтрПров);
					Проводка.Сделка = РасшифровкаПлатежа.ОсновнаяСделка_СД; 
					Проводка.СуммаВзаиморасчетов = РасшифровкаПлатежа.СуммаПлатежа;
					Проводка.СуммаУпр = РасшифровкаПлатежа.СуммаПлатежа;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли; 
		//-БП: d.matyash (27.06.2024) <> 
	КонецЕсли;
	
КонецПроцедуры
