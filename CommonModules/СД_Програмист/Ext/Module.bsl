							ЗаписьЖурналаРегистрации("Документы.ПереоценкаЗапасов_СД" ,УровеньЖурналаРегистрации.Ошибка,Метаданные.Обработки.ЗагрузкаОстаткаИЦенПоставщика_СД,ОписаниеОшибки(), ОписаниеОшибки());
						КонецПопытки;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		//КонецЦикла;	              
	КонецЦикла;	              
			
КонецПроцедуры

Процедура ОтправкаПродаажПоставщиу_сд() Экспорт
	// Вставити вміст обробника.
	
	
		
	ЗапросШаблоны = новый запрос;
	ЗапросШаблоны.Текст = "ВЫБРАТЬ
	                      |	ШаблоныЗагрузкиОстатковПоставщиков_СДСрезПоследних.Поставщик,
	                      |	ШаблоныЗагрузкиОстатковПоставщиков_СДСрезПоследних.ГруппаДоговоров
	                      |ИЗ
	                      |	РегистрСведений.ШаблоныЗагрузкиОстатковПоставщиков_СД.СрезПоследних(&ДатаСреза, ) КАК ШаблоныЗагрузкиОстатковПоставщиков_СДСрезПоследних
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ШаблоныЗагрузкиОстатковПоставщиков_СДСрезПоследних.ГруппаДоговоров,
	                      |	ШаблоныЗагрузкиОстатковПоставщиков_СДСрезПоследних.Поставщик";
	
	ЗапросШаблоны.УстановитьПараметр("ДатаСреза", ТекущаяДата());
	РезШаблоны = ЗапросШаблоны.Выполнить().Выгрузить();
	для Каждого СтрШ из РезШаблоны Цикл 
		
		
		НовОбработка = Обработки.ОтправитьПродажиНаПочту_СД.Создать();
		//НовОбработка.ПоПочте = Истина;
		НовОбработка.Поставщик = СтрШ.Поставщик;
		НовОбработка.ГруппаДоговоров = СтрШ.ГруппаДоговоров; 
		//с.д. Рижий 2023-09-11 (
		//НовОбработка.ДатаПродажи = ТекущаяДата() ;  
		
		НовОбработка.ДатаПродажи = НачалоДня(ТекущаяДата()) -1 ;  
		НовОбработка.ДатаЗаказПоставщика = ТекущаяДата();
		//с.д. Рижий 2023-09-11 )
		
		Попытка
			НовОбработка.ЗаполнитьПоШаблону(); 		
			НовОбработка.ЗаполнитьПродажи(); 
			НовОбработка.ОтправитьПоставщику(); 
			НовОбработка.СоздатьЗаказПоставщику();
			
		Исключение
	        ЗаписьЖурналаРегистрации("ОтправитьПродажиНаПочту_СД." ,УровеньЖурналаРегистрации.Ошибка,Метаданные.Обработки.ОтправитьПродажиНаПочту_СД,ОписаниеОшибки(), ОписаниеОшибки());
		КонецПопытки;
	
	конецЦикла;	
	
	
КонецПроцедуры
