	КлючПоиска         = СокрЛП(НомСсылка.Код);
	//
	
	РезПоиска = Справочники.Клиенты.НайтиПоРеквизиту("ВнешнийКод",КлючПоиска); 
	
	Если РезПоиска =  Справочники.Клиенты.ПустаяСсылка() Тогда
		НовыйОбъект = Справочники.Клиенты.СоздатьЭлемент();
	Иначе
		НовыйОбъект = РезПоиска.ПОлучитьОбъект();
	КонецЕсли;	
	НовыйОбъект.Наименование = НомСсылка.Наименование;
	НовыйОбъект.ВнешнийКод = НомСсылка.Код; 
	НовыйОбъект.НомерТелефона = НомСсылка.НомерТелефона;
	
	НовыйОбъект.Сайт = НомСсылка.Сайт;
	НовыйОбъект.Email = НомСсылка.Email;
	НовыйОбъект.Комментарий = НомСсылка.Комментарий;
	НовыйОбъект.Пароль = НомСсылка.Пароль;
	
	НовыйОбъект.Город = НомСсылка.Город;
	НовыйОбъект.Область = НомСсылка.Область;
	
	Попытка
	НовыйОбъект.Контрагент = ?(ЗначениеЗаполнено(НомСсылка.Контрагент.код),Справочники.Контрагенты.НайтиПоКоду(НомСсылка.Контрагент.код),Справочники.Контрагенты.ПустаяСсылка()); 
	Исключение КонецПопытки;
	НовыйОбъект.Логин = НомСсылка.Логин;
	НовыйОбъект.ВидДеятельности = НомСсылка.ВидДеятельности.Наименование;
	
	НовыйОбъект.СтатусКлиента = Перечисления.СтатусыКлиентов.Получить(Base1С.Перечисления.СтатусыКлиентов.Индекс(НомСсылка.СтатусКлиента));
		
	
	НовыйОбъект.Записать();	
	
КонецПроцедуры

Процедура ОбменЗаказыИзКабинета(Base1С,ЗакаСсылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПредЗаказ.Ссылка
		|ИЗ
		|	Документ.ПредЗаказ КАК ПредЗаказ
		|ГДЕ
		|	ПредЗаказ.НомерКабинет = &НомерКабинет
		|	И НачалоПериода(ПредЗаказ.ДатаКабинет,День) = НачалоПериода(&ДатаКабинет,День)";
	
	Запрос.УстановитьПараметр("НомерКабинет", ЗакаСсылка.Номер);
	Запрос.УстановитьПараметр("ДатаКабинет", ЗакаСсылка.Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	обновление = Ложь;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовыйДокумент = ВыборкаДетальныеЗаписи.ссылка.ПолучитьОбъект(); 
		обновление = Истина;
	КонецЦикла; 
	
	Если Не обновление Тогда
		НовыйДокумент = Документы.ПредЗаказ.СоздатьДокумент();
		НовыйДокумент.НомерКабинет = ЗакаСсылка.Номер;
		НовыйДокумент.ДатаКабинет = ЗакаСсылка.Дата;
		НовыйДокумент.ТипЦены = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000006");
		НовыйДокумент.Организация = НовыйДокумент.ТипЦены.Организация;
		НовыйДокумент.Дата = ЗакаСсылка.Дата;	
		НовыйДокумент.Клиент = Справочники.Клиенты.НайтиПоРеквизиту("ВнешнийКод",ЗакаСсылка.Клиент.Код);
		НовыйДокумент.Контрагент = НовыйДокумент.Клиент.Контрагент;
		НовыйДокумент.ДоговорКонтрагента = ПолучитьДоговор(НовыйДокумент.Контрагент,НовыйДокумент.Организация);
		НовыйДокумент.ЮрФизЛицо = НовыйДокумент.Контрагент.ЮрФизЛицо;
		НовыйДокумент.Телефон = НовыйДокумент.Клиент.НомерТелефона;  
		НовыйДокумент.ВремяПоступленияЗаявки = ЗакаСсылка.Дата;
		НовыйДокумент.ФормаРасчета = Справочники.ФормыРасчета.Наличныйрасчетвточкепродажи;
		//+БП: d.matyash (03.12.2024) <> 
		БП_ОбщийМодуль.ИзменитьОрганизацию(НовыйДокумент, Истина);
		//-БП: d.matyash (03.12.2024) <>
		НовыйДокумент.УсловиеПриема = Справочники.УсловияПриема.НайтиПоКоду("0006"); 
		НовыйДокумент.ДатаОтгрузки = КонецДня(ТекущаяДата()) + 1;
		//Если ЗначениеЗаполнено(ЗакаСсылка.УсловиеОплаты) Тогда
		//НовыйДокумент.УсловиеОплаты = Справочники.УсловияПоставки.НайтиПоКоду(ЗакаСсылка.УсловиеДоставки.ВнешнийКод);
		//КонецЕсли;
		
		ТекНомМенеджер = константы.ТекущийМенеджерОПТ_СД.Получить();
		Константы.ТекущийМенеджерОПТ_СД.Установить(ТекНомМенеджер+1);
		Мен = Константы.ТекущийМенеджерОПТ_СД.Получить();
		Док = Документы.ГрафикРаботыМенеджеров_Опт.Выбрать(ТекущаяДата()-90*24*60*60,ТекущаяДата()+90*24*60*60);
		Пока Док.Следующий() Цикл
			Если Док.Проведен Тогда
				Если Док.ДатаПо >= ТекущаяДата() и Док.Дата <= ТекущаяДата()  Тогда
					
					Кво = Док.Менеджера.Количество();
					Поз = Мен-Цел(Мен/Кво)*Кво;
					Если Поз = 0 Тогда
						Поз = Кво;
					КонецЕсли; 
					НовыйДокумент.Ответственный = Док.Менеджера.Получить(Поз-1).Менеджер;
					НовыйДокумент.ОтветственныйМенеджер = Док.Менеджера.Получить(Поз-1).Менеджер;
					
					ПрерватЬ;
				КонецЕсли; 
			КонецЕсли; 	
		КонецЦикла; 
		
		
	
		
		
		//НовыйДокумент.Ответственный = ОператорСсылка;
		//НовыйДокумент.ОтветственныйМенеджер = НастройкиПользователя.ОтветственныйМенеджер;
		НовыйДокумент.Подразделение = Справочники.Подразделения.НайтиПоКоду("Г00000031"); 
		Если не ЗакаСсылка.СкладОтгрузки.ВнешнийКод = "" Тогда
			НовыйДокумент.Склад = Справочники.Склады.НайтиПоКоду(ЗакаСсылка.СкладОтгрузки.ВнешнийКод);
		КонецЕсли;
		НовыйДокумент.АдресДоставки = ЗакаСсылка.Адрес;
		НовыйДокумент.Статус = Справочники.Статусы.НайтиПоКоду(ЗакаСсылка.статус.ВнешнийКод);
		НовыйДокумент.Комментарий = ЗакаСсылка.Комментарий;
		Если ЗначениеЗаполнено(ЗакаСсылка.УсловиеДоставки.ВнешнийКод) Тогда
			НовыйДокумент.УсловияДоставки = Справочники.УсловияПоставки.НайтиПоКоду(ЗакаСсылка.УсловиеДоставки.ВнешнийКод);
		КонецЕсли;
		//НовыйДокумент.ДатаОтгрузки = ТекущаяДата();
		
		Для каждого Стр из ЗакаСсылка.товары Цикл
			НоваяСтрока = НовыйДокумент.Товары.Добавить();
			НоваяСтрока.Номенклатура = Справочники.Номенклатура.НайтиПоКоду(Стр.Номенклатура.ВнешнийКод);
			НоваяСтрока.Цена = стр.Цена;
			НоваяСтрока.Количество = стр.количество;
			НоваяСтрока.Сумма = стр.Сумма;
			НоваяСтрока.СуммаСоСкидкой = стр.Сумма;
			Если не стр.Склад.ВнешнийКод = "" Тогда
				НоваяСтрока.Контрагент = Справочники.Склады.НайтиПоКоду(стр.Склад.ВнешнийКод);
			КонецЕсли; 
			НоваяСтрока.ДатаПроизводства = Стр.ДатаПроизводства;
			НоваяСтрока.Страна = Стр.Страна;
		КонецЦикла; 
		НовыйДокумент.ВыводитьОповищениеОптовыйКабинет = Истина;
	иначе  
		НовыйДокумент.Дата = ТекущаяДата();
		НовыйДокумент.АдресДоставки = ЗакаСсылка.Адрес;
		НовыйДокумент.Статус = Справочники.Статусы.НайтиПоКоду(ЗакаСсылка.статус.ВнешнийКод);
		НовыйДокумент.Комментарий = ЗакаСсылка.Комментарий;
		Если ЗначениеЗаполнено(ЗакаСсылка.УсловиеДоставки.ВнешнийКод) Тогда
			НовыйДокумент.УсловияДоставки = Справочники.УсловияПоставки.НайтиПоКоду(ЗакаСсылка.УсловиеДоставки.ВнешнийКод);
		КонецЕсли;  
		НовыйДокумент.ВыводитьОповищениеОптовыйКабинет = Истина;
	КонецЕсли;
	НовыйДокумент.ИсторияИзменений.Очистить();
	Для каждого СтрИстирия из ЗакаСсылка.ИсторияИзменений Цикл
		НоваяСтрокаИстория = НовыйДокумент.ИсторияИзменений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаИстория,СтрИстирия);
	КонецЦикла;
	
	НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
	Если не обновление Тогда
		СоздатьЗаказНаОснованииПредЗаказа(НовыйДокумент);
		
	Иначе
		Если НовыйДокумент.Статус = Справочники.Статусы.НайтиПоКоду("000000025") Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗаказПокупателя.Ссылка
			|ИЗ
			|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
			|ГДЕ
			|	ЗаказПокупателя.ПредЗаказ = &ПредЗаказ";
			
			Запрос.УстановитьПараметр("ПредЗаказ", НовыйДокумент.Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				ПолДок = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
				ПолДок.Статус = Справочники.Статусы.НайтиПоКоду("000000008");    				
				ПолДок.Записать(?(ПолДок.Проведен,РежимЗаписиДокумента.ОтменаПроведения,РежимЗаписиДокумента.Запись)); 
				
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Ссылка.ПредЗаказ) Тогда
					ПолПредЗаказ = ВыборкаДетальныеЗаписи.Ссылка.ПредЗаказ.Ссылка.ПолучитьОбъект();
					НоваяСтрока = ПолПредЗаказ.ИсторияИзменений.Добавить();
					НоваяСтрока.Дата = ТекущаяДата();
					НоваяСтрока.КтоИзменил = ПараметрыСеанса.ТекущийПользователь.Наименование;
					НоваяСтрока.НовоеЗначение = Строка(ВыборкаДетальныеЗаписи.Ссылка.Статус);
					НоваяСтрока.ЧтоИзменилось = "Статус заказа";
					ПолПредЗаказ.Записать(РежимЗаписиДокумента.Запись);
					
					
					НаборЗаписей1 = РегистрыСведений.ОбъектыДляОбмена.СоздатьНаборЗаписей();
					
					НаборЗаписей1.Отбор.ОбъектОбмена.Установить(ВыборкаДетальныеЗаписи.Ссылка.ПредЗаказ.Ссылка);
					НаборЗаписей1.Отбор.Тип.Установить("ДокументСсылка.ПредЗаказ");
					
					НоваяЗапись1 = НаборЗаписей1.Добавить();
					
					НоваяЗапись1.период = ТекущаяДата();
					НоваяЗапись1.ОбъектОбмена=ВыборкаДетальныеЗаписи.Ссылка.ПредЗаказ.Ссылка;
					НоваяЗапись1.Тип ="ДокументСсылка.ПредЗаказ";
					
					НаборЗаписей1.Записать();
					
				КонецЕсли;

			КонецЦикла;			
		КонецЕсли;
	КонецЕсли;
 КонецПроцедуры   
 
 Процедура СоздатьЗаказНаОснованииПредЗаказа(ПредЗаказ)
	ЗаказПокупателя = Документы.ЗаказПокупателя.СоздатьДокумент();
	ЗаказПокупателя.Дата = ТекущаяДата();
	//ЗаказПокупателя.ДатаОтгрузки = КонецДня(ТекущаяДата()) + 1;
	ЗаказПокупателя.АдресДоставки = ПредЗаказ.АдресДоставки;
	ЗаказПокупателя.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	ЗаказПокупателя.ДатаОтгрузки = ПредЗаказ.ДатаОтгрузки;
	ЗаказПокупателя.ДоговорКонтрагента = ПредЗаказ.ДоговорКонтрагента;
	ЗаказПокупателя.Контрагент = ПредЗаказ.Контрагент;
	ЗаказПокупателя.КратностьВзаиморасчетов = 1;
	ЗаказПокупателя.КурсВзаиморасчетов = 1;
	ЗаказПокупателя.Организация = ПредЗаказ.Организация;
	ЗаказПокупателя.Ответственный = ПредЗаказ.Ответственный;
	ЗаказПокупателя.ОтветственныйМенеджер = ПредЗаказ.ОтветственныйМенеджер;
	ЗаказПокупателя.СкладГруппа = ПредЗаказ.Склад;
	ЗаказПокупателя.СуммаВключаетНДС = Истина;
	ЗаказПокупателя.СуммаДокумента = ПредЗаказ.Товары.Итог("Сумма");
	ЗаказПокупателя.ТипЦен = ПредЗаказ.ТипЦены;
	ЗаказПокупателя.УчитыватьНДС = Истина;
	ЗаказПокупателя.ДополнениеКАдресуДоставки = ПредЗаказ.ДополнениеКАдресуДоставки;
	ЗаказПокупателя.УсловиеПоставки = ПредЗаказ.УсловияДоставки;
	ЗаказПокупателя.ФормаРасчета = ПредЗаказ.ФормаРасчета; 
	//+БП: d.matyash (03.12.2024) <> 
	ЗаказПокупателя.БП_Марка = ПредЗаказ.БП_Марка;
	ЗаказПокупателя.БП_ТипАвто = ПредЗаказ.БП_ТипАвто;
	ЗаказПокупателя.БП_Модель = ПредЗаказ.БП_Модель;
	ЗаказПокупателя.БП_НомерВинКода = ПредЗаказ.БП_НомерВинКода;
	ЗаказПокупателя.БП_НомернойЗнак = ПредЗаказ.БП_НомернойЗнак; 
	//+БП: @Cvet_kov (02.09.2026) <>
	// Организация выбирается по сумме заказа - таблица ОрганизацииПоСумме в форме расчёта.
	БП_ОбщийМодуль.ИзменитьОрганизацию(ЗаказПокупателя, Истина, Истина, Ложь, ПредЗаказ.Товары.Итог("Сумма"));
	//-БП: @Cvet_kov (02.09.2026) <>
	//-БП: d.matyash (03.12.2024) <>
	ЗаказПокупателя.УсловиеОплаты = Справочники.УсловияОплаты.Оплатапофактупоставки;
	ЗаказПокупателя.УсловиеПриема = ПредЗаказ.УсловиеПриема;
	ЗаказПокупателя.ВремяС = ПредЗаказ.ВремяС;
	ЗаказПокупателя.ВремяПо = ПредЗаказ.ВремяПо;
	ЗаказПокупателя.Создал = параметрыСеанса.ТекущийПользователь;
	ЗаказПокупателя.Комментарий = ПредЗаказ.Комментарий;
	ЗаказПокупателя.ДатаСоздания = ТекущаяДата();
	ЗаказПокупателя.Телефон = ПредЗаказ.Телефон;
	ЗаказПокупателя.Статус = Справочники.Статусы.НайтиПоКоду("000000067");
	ЗаказПокупателя.Подразделение = ПредЗаказ.Подразделение;
	//с.д.(
	ЗаказПокупателя.ЗаполнитьНП_APIКлюч();
	ЗаказПокупателя.НП_КонтрольОплаты = ПредЗаказ.НП_КонтрольОплаты;
	ЗаказПокупателя.НП_ГородПолучателя = ПредЗаказ.НП_ГородПолучателя;
	ЗаказПокупателя.НП_ОтделениеПолучения = ПредЗаказ.НП_ОтделениеПолучения;
	ЗаказПокупателя.НП_ОплатаНаКарту = ПредЗаказ.НП_ОплатаНаКарту;
	Если СтрДлина(ПредЗаказ.Телефон) = 13 Тогда
		ЗаказПокупателя.НП_ТелефонПолучателя = Прав(ПредЗаказ.Телефон,12);
	иначеЕсли СтрДлина(ПредЗаказ.Телефон) = 10 Тогда
		ЗаказПокупателя.НП_ТелефонПолучателя = "38"+ПредЗаказ.Телефон; 
	КонецЕсли;

	
	НП_Фамилия = "";
	НП_Имя = "";
	НП_Отчество = "";
	
	Если не ТипЗнч(ПредЗаказ.Контрагент) = Тип("Строка") Тогда
		СтрокаПоиска = ПредЗаказ.Контрагент.наименование;
		ДлинаСтроки = СтрДлина(СтрокаПоиска);
		Сч = 1;
		
		ПервыйПробел = 0;
		ВторойПробел = 0;
		Пока Сч<=ДлинаСтроки Цикл
			ТекСимвол = Сред(СтрокаПоиска, Сч, 1);
			
			Если ТекСимвол = " " тогда
				Если ПервыйПробел = 0 и ВторойПробел = 0 Тогда
					ПервыйПробел = сч;
				ИначеЕсли не ПервыйПробел = 0 и ВторойПробел = 0 Тогда
					ВторойПробел = сч;
				КонецЕсли;				
			КонецЕсли;
			
			Сч = Сч+1;
		КонецЦикла;
		
		НП_Фамилия = СокрЛП(Лев(СтрокаПоиска,ПервыйПробел));
		Если ВторойПробел = 0 Тогда
			НП_Имя = СокрЛП(СтрЗаменить(СтрокаПоиска,НП_Фамилия,""));
		Иначе
			НП_Имя = СокрЛП(Сред(СтрокаПоиска,ПервыйПробел+1,ВторойПробел-ПервыйПробел));
			НП_Отчество = СокрЛП(Прав(СтрокаПоиска,СтрДлина(СтрокаПоиска)-ВторойПробел+1));
		КонецЕсли;
	КонецЕсли;
	ЗаказПокупателя.НП_Фамилия = НП_Фамилия;
	ЗаказПокупателя.НП_Имя = НП_Имя;
	ЗаказПокупателя.НП_Отчество = НП_Отчество;
	//с.д.)
	Если ПредЗаказ.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
