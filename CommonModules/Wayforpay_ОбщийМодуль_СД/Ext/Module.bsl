Функция СоздатьИнвойс(НастройкиПодключений,ДокЗаказ,НомерЗаказа,СуммаЗаказа,предоплата = ложь)Экспорт 
	Если предоплата Тогда
		
		Если НастройкиПодключений.БП_ИспользоватьНаименованияТоваровДляТекстаПредоплати тогда
			Для каждого Стр из ДокЗаказ.Товары цикл
				ТекстТовараПредоплата = ?(ТекстТовараПредоплата = Неопределено, "", ОчисткаНеКоректныхСимволов(ТекстТовараПредоплата) + ", ") + ОчисткаНеКоректныхСимволов(Стр.Номенклатура.Наименование) + " (" + Формат(Стр.Количество,"ЧРД=.; ЧГ=0") + " " + ОчисткаНеКоректныхСимволов(Стр.ЕдиницаИзмерения) + ")" ;	
			КонецЦикла;
			Для каждого Стр из ДокЗаказ.Услуги цикл
				ТекстТовараПредоплата = ?(ТекстТовараПредоплата = Неопределено, "", ОчисткаНеКоректныхСимволов(ТекстТовараПредоплата) + ", ") + ОчисткаНеКоректныхСимволов(Стр.Номенклатура.Наименование) + " (" + Формат(Стр.Количество,"ЧРД=.; ЧГ=0") + " " + ОчисткаНеКоректныхСимволов(Стр.ЕдиницаИзмерения) + ")" ;	
			КонецЦикла;
		Иначе
			ТекстТовараПредоплата = СокрЛП(НастройкиПодключений.ШаблотТекстТовараДляПредоплаты_СД);
		КонецЕсли;		
		
		Если ТекстТовараПредоплата = "" Тогда
			Рез = Новый Структура;
			Рез.Вставить("Успешно",Ложь);
			Рез.Вставить("Сообщение","Не указан текст товара для предоплаты. Сообщите администратору");
			Рез.Вставить("qrCode","");
			Рез.Вставить("invoiceUrl","");
			Возврат Рез;
		КонецЕсли;
	КонецЕсли;
	
	Рез = Новый Структура;
	Рез.Вставить("Успешно",Ложь);
	Рез.Вставить("Сообщение","");
	Рез.Вставить("qrCode","");
	Рез.Вставить("invoiceUrl","");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Вид = &Вид";
	
	Запрос.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("Г00000014"));
	Запрос.УстановитьПараметр("Объект", ДокЗаказ.Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ЕмеилКонтр = "";
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЕмеилКонтр = ВыборкаДетальныеЗаписи.Представление;			
	КонецЦикла;



	Если ЗначениеЗаполнено(НастройкиПодключений.ПапкаФайлаЛога) и ФайлСуществует(НастройкиПодключений.ПапкаФайлаЛога) Тогда
		ИмяИсходящегоФайла = НастройкиПодключений.ПапкаФайлаЛога + "\CREATE_INVOICE.json";
	Иначе
		ИмяИсходящегоФайла = КаталогВременныхФайлов() + "CREATE_INVOICE.json";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкиПодключений.ПапкаФайлаЛога) и ФайлСуществует(НастройкиПодключений.ПапкаФайлаЛога) Тогда
		ИмяФайлаОтвета = НастройкиПодключений.ПапкаФайлаЛога + "\answ_CREATE_INVOICE.json";
	Иначе
		ИмяФайлаОтвета = КаталогВременныхФайлов() + "answ_CREATE_INVOICE.json";
	КонецЕсли;

	ТаблТов = ДокЗаказ.Товары;
	ТаблУслуги = ДокЗаказ.Услуги;
	unixtime = Формат(ДокЗаказ.Дата - дата(1970,1,1,1,0,0), "ЧГ=0");  
	
	СтрокаШифрования = ""+НастройкиПодключений.ИдентификаторПродавца+";"+НастройкиПодключений.ДоменноеИмя
	+";"+ НомерЗаказа +";"+ unixtime +";"+Формат(СуммаЗаказа,"ЧРД=.; ЧГ=0")+";UAH;";
	Если не предоплата Тогда
		Для каждого Стр_т1 из ТаблТов Цикл 
			СтрокаТовары = ОчисткаНеКоректныхСимволов(Строка(Стр_т1.Номенклатура));
			СтрокаШифрования = СтрокаШифрования + СтрокаТовары +";";
		КонецЦикла;  
		Для каждого Стр_у1 из ТаблУслуги Цикл
			СтрокаТовары = ОчисткаНеКоректныхСимволов(Строка(Стр_у1.Номенклатура));
			
			СтрокаШифрования = СтрокаШифрования + СтрокаТовары +";";
		КонецЦикла;
       	
		Для каждого Стр_т3 из ТаблТов Цикл
			СтрокаШифрования = СтрокаШифрования + Цел(Стр_т3.Количество) +";";
		КонецЦикла;  
		Для каждого Стр_у3 из ТаблУслуги Цикл
			СтрокаШифрования = СтрокаШифрования + Цел(Стр_у3.Количество) +";";
		КонецЦикла;
		
		Для каждого Стр_т2 из ТаблТов Цикл
			СтрокаШифрования = СтрокаШифрования + Формат(Окр(Стр_т2.Сумма / Цел(Стр_т2.Количество),2),"ЧРД=.; ЧГ=0") +";";
		КонецЦикла; 
		Для каждого Стр_у2 из ТаблУслуги Цикл
			СтрокаШифрования = СтрокаШифрования + Формат(Окр(Стр_у2.Сумма / Цел(Стр_у2.Количество),2),"ЧРД=.; ЧГ=0") +";";
		КонецЦикла;
		
		СтрокаШифрования = Лев(СтрокаШифрования,СтрДлина(СтрокаШифрования)-1);
	Иначе    
		//СтрокаШифрования = СтрокаШифрования + ТекстТовараПредоплата + ";" + "1" + ";" + Формат(СуммаЗаказа,"ЧРД=.; ЧГ=0");
    	СтрокаШифрования = СтрокаШифрования + ТекстТовараПредоплата + ";" + "1" + ";" + Формат(СуммаЗаказа,"ЧРД=.; ЧГ=0");

	КонецЕсли;
	
	//ТекстВремен = Новый ЗаписьТекста(КаталогВременныхФайлов()+"utf.txt", КодировкаТекста.UTF8);
	//ТекстВремен.ЗаписатьСтроку(СтрокаШифрования);
	//ТекстВремен.Закрыть();
	//
	//
	//ТекстВремен = Новый ЧтениеТекста(КаталогВременныхФайлов()+"utf.txt", КодировкаТекста.UTF8);
	//СтрокаШифрования = ТекстВремен.ПрочитатьСтроку();


	ПодписьЗапроса = НастройкиПодключений.ПодписьЗапроса;
	ПодписьЗапроса16 = "";
    Для к = 1 ПО СтрДлина(ПодписьЗапроса) Цикл
        
        ПодписьЗапроса16 = ПодписьЗапроса16 + ПреобразоватьДесятичнуюСИВHex(КодСимвола(Сред(ПодписьЗапроса,к,1)));
        
    КонецЦикла; 
	
	
	Соединение = СоздатьHTTPСоединение(НастройкиПодключений);
	
	
	ЗаписьДЖС = Новый ЗаписьJSON;
	ЗаписьДЖС.ПроверятьСтруктуру = Истина;
	ПараметрыЗаписиДЖС = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);
	ЗаписьДЖС.ОткрытьФайл(ИмяИсходящегоФайла,КодировкаТекста.UTF8,Ложь,ПараметрыЗаписиДЖС);
	//ЗаписьДЖС.УстановитьСтроку(ПараметрыЗаписиДЖС);
	ЗаписьДЖС.ЗаписатьНачалоОбъекта();
	ЗаписьДЖС.ЗаписатьИмяСвойства("transactionType");
	ЗаписьДЖС.ЗаписатьЗначение("CREATE_INVOICE");
	ЗаписьДЖС.ЗаписатьИмяСвойства("merchantAccount");
	ЗаписьДЖС.ЗаписатьЗначение(НастройкиПодключений.ИдентификаторПродавца);
	ЗаписьДЖС.ЗаписатьИмяСвойства("merchantDomainName");
	ЗаписьДЖС.ЗаписатьЗначение(НастройкиПодключений.ДоменноеИмя);
	ЗаписьДЖС.ЗаписатьИмяСвойства("merchantSignature");
	ЗаписьДЖС.ЗаписатьЗначение(HMAC(ПодписьЗапроса16,СтрокаШифрования,"MD5"));
	ЗаписьДЖС.ЗаписатьИмяСвойства("apiVersion");
	ЗаписьДЖС.ЗаписатьЗначение(1);
	ЗаписьДЖС.ЗаписатьИмяСвойства("language");
	ЗаписьДЖС.ЗаписатьЗначение(НастройкиПодключений.ЯзыкСчета);
	ЗаписьДЖС.ЗаписатьИмяСвойства("orderReference");
	ЗаписьДЖС.ЗаписатьЗначение(НомерЗаказа);
	ЗаписьДЖС.ЗаписатьИмяСвойства("orderDate"); 
	ЗаписьДЖС.ЗаписатьЗначение(Число(unixtime));
	ЗаписьДЖС.ЗаписатьИмяСвойства("amount");
	ЗаписьДЖС.ЗаписатьЗначение(СуммаЗаказа);
	ЗаписьДЖС.ЗаписатьИмяСвойства("currency");
	ЗаписьДЖС.ЗаписатьЗначение("UAH");
	если не НастройкиПодключений.ВремяДействияСчета = 7200 Тогда
		ЗаписьДЖС.ЗаписатьИмяСвойства("orderTimeout");
		ЗаписьДЖС.ЗаписатьЗначение(НастройкиПодключений.ВремяДействияСчета);
	КонецЕсли;
	ЗаписьДЖС.ЗаписатьИмяСвойства("productName");
	ЗаписьДЖС.ЗаписатьНачалоМассива();
	Если не предоплата Тогда
		Для каждого Стр_т1 из ТаблТов Цикл  
			СтрокаТовары = ОчисткаНеКоректныхСимволов(Строка(Стр_т1.Номенклатура));
			ЗаписьДЖС.ЗаписатьЗначение(СтрокаТовары);
		КонецЦикла;
		Для каждого Стр_у1 из ТаблУслуги Цикл 
			СтрокаТовары = ОчисткаНеКоректныхСимволов(Строка(Стр_у1.Номенклатура));
			ЗаписьДЖС.ЗаписатьЗначение(СтрокаТовары);
		КонецЦикла;
	Иначе
		СтрокаТовары = ОчисткаНеКоректныхСимволов(Строка(ТекстТовараПредоплата));
		ЗаписьДЖС.ЗаписатьЗначение(СтрокаТовары);
	КонецЕсли;
	ЗаписьДЖС.ЗаписатьКонецМассива();
	ЗаписьДЖС.ЗаписатьИмяСвойства("productPrice");
	ЗаписьДЖС.ЗаписатьНачалоМассива(); 
	Если не предоплата Тогда
		Для каждого Стр_т2 из ТаблТов Цикл
			ЗаписьДЖС.ЗаписатьЗначение(Окр(Стр_т2.Сумма / Цел(Стр_т2.Количество),2));
		КонецЦикла;
		Для каждого Стр_у2 из ТаблУслуги Цикл
			ЗаписьДЖС.ЗаписатьЗначение(Окр(Стр_у2.Сумма / Цел(Стр_у2.Количество),2));
		КонецЦикла; 
	Иначе
		ЗаписьДЖС.ЗаписатьЗначение(Окр(СуммаЗаказа,2));	
	КонецЕсли;
	ЗаписьДЖС.ЗаписатьКонецМассива();
	ЗаписьДЖС.ЗаписатьИмяСвойства("productCount");
	ЗаписьДЖС.ЗаписатьНачалоМассива();
	Если не предоплата Тогда
		Для каждого Стр_т3 из ТаблТов Цикл
			ЗаписьДЖС.ЗаписатьЗначение(Цел(Стр_т3.Количество));
		КонецЦикла;
		Для каждого Стр_у3 из ТаблУслуги Цикл
			ЗаписьДЖС.ЗаписатьЗначение(Цел(Стр_у3.Количество));
		КонецЦикла; 
	Иначе
		ЗаписьДЖС.ЗаписатьЗначение(1);
	КонецЕсли;
	ЗаписьДЖС.ЗаписатьКонецМассива();
	
	Если Не СокрЛП(ЕмеилКонтр) = "" Тогда
		ЗаписьДЖС.ЗаписатьИмяСвойства("clientEmail");
		ЗаписьДЖС.ЗаписатьЗначение(ЕмеилКонтр);
	КонецЕсли;
		
	ЗаписьДЖС.ЗаписатьКонецОбъекта();
	ЗаписьДЖС.Закрыть();

	
		
	Заголовки = Новый Соответствие();
	Заголовки.Вставить("Accept-Charset","UTF-8");
	Заголовки.Вставить("Content-Type","application/json");

	//ЗапросHTTP = Новый HTTPЗапрос("/api",Заголовки);
	//ЗапросHTTP.УстановитьТелоИзСтроки(СтрокаЗапроса,КодировкаТекста.UTF8);
	
	ОтветСервера = Соединение.ОтправитьДляОбработки(ИмяИсходящегоФайла, "/api", ИмяФайлаОтвета);

	
	ФайлОтвета = Новый Файл(ИмяФайлаОтвета);
	
	Если ФайлОтвета.Существует() Тогда
		
		ТекстОтвета = Новый ТекстовыйДокумент();
		ТекстОтвета.Прочитать(ИмяФайлаОтвета);
		Если ТекстОтвета.КоличествоСтрок()>0 Тогда
			ОтветСервера = ТекстОтвета.ПолучитьТекст();	
		Иначе
			Т = "Получен пустой ответ сервера.";
			//Сообщить(Т);
			Рез.Вставить("Успешно",Ложь);
			Рез.Вставить("Сообщение",Т);
			Возврат Рез;
		КонецЕсли;	
		
	Иначе	
		Т = "Ответ сервера не получен.";
		//Сообщить(Т);
		Рез.Вставить("Успешно",Ложь);
		Рез.Вставить("Сообщение",Т);
		Возврат Рез;
	КонецЕсли;
	
	
	ЧтениеДЖС = Новый ЧтениеJSON;
	ЧтениеДЖС.ОткрытьФайл(ИмяФайлаОтвета);
	Записи = ПрочитатьJSON(ЧтениеДЖС);
	Статус = ""; invoiceUrl = "";qrCode = "";reason = "";
	Для Каждого Запись Из Записи Цикл
		Если Запись.Ключ = "reasonCode" Тогда
			Статус = Запись.Значение;
		КонецЕсли;
		Попытка
			Если Запись.Ключ = "invoiceUrl" Тогда
				invoiceUrl = Запись.Значение;
			КонецЕсли;
		Исключение КонецПопытки;
		Попытка
			Если Запись.Ключ = "qrCode" Тогда
				qrCode = Запись.Значение;
			КонецЕсли;
		Исключение КонецПопытки;
		Попытка
			Если Запись.Ключ = "reason" Тогда
				reason = Запись.Значение;
			КонецЕсли;
		Исключение КонецПопытки;
	КонецЦикла;
	
	Если Не Статус = "1100" и не Статус = 1100 Тогда
		Рез.Вставить("Успешно",Ложь);
		Рез.Вставить("Сообщение","" + Статус + " " +reason);
		Рез.Вставить("qrCode","");
		Рез.Вставить("invoiceUrl","");
		Возврат Рез;
	Иначе

		Рез.Вставить("Успешно",Истина);
		Рез.Вставить("Сообщение","");
		Рез.Вставить("qrCode",qrCode);
		Рез.Вставить("invoiceUrl",invoiceUrl);

		// Фиксируем связь «orderReference - заказ»: по ней загрузка выписки
		// находит заказ, даже если его номер потом поменяют.
		ЗаписатьЗаказИнвойса(НомерЗаказа, ДокЗаказ);
	КонецЕсли;

	

	
	Возврат Рез;

КонецФункции 

// Пара «orderReference - заказ» пишется в регистр при каждом успешно
// созданном инвойсе. Повторное создание инвойса с тем же orderReference
// молча перезаписывает пару. Ошибка записи не должна ломать выставление
// инвойса — она уходит в журнал регистрации.
Процедура ЗаписатьЗаказИнвойса(OrderReference, ДокЗаказ)

	Попытка

		СсылкаЗаказа = ДокЗаказ.Ссылка;

		Если Не ЗначениеЗаполнено(СсылкаЗаказа)
			Или ПустаяСтрока(СокрЛП(Строка(OrderReference))) Тогда
			Возврат;
		КонецЕсли;

		// Инвойс создает менеджер, у которого нет прав на служебный
		// регистр, — пишем в привилегированном режиме.
		УстановитьПривилегированныйРежим(Истина);

		МенеджерЗаписи = РегистрыСведений.ЗаказыИнвойсовWayForPay.СоздатьМенеджерЗаписи();

		МенеджерЗаписи.OrderReference = Лев(СокрЛП(Строка(OrderReference)), 100);
		МенеджерЗаписи.Заказ          = СсылкаЗаказа;

		МенеджерЗаписи.Записать(Истина);

		УстановитьПривилегированныйРежим(Ложь);

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не удалось записать связь инвойса «" + Строка(OrderReference)
			+ "» с заказом: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// orderReference инвойса по заказу — обратный поиск по тому же регистру,
// по которому загрузка выписки находит заказ
// (БанковскиеВыписки.ЗаказПоРегиструИнвойсов).
//
// Номер заказа может смениться уже после выставления инвойса (перенумерация,
// пересоздание заказа по сайту), а в WayForPay инвойс так и остается под тем
// orderReference, с которым его создали. Собранный из текущего номера
// orderReference в этом случае дает «1127 Order Not Found», поэтому статус
// и удаление инвойса должны идти по значению из регистра.
//
// Параметры:
//  ДокЗаказ                  - ДокументОбъект.ЗаказПокупателя,
//                              ДокументСсылка.ЗаказПокупателя
//  НомерИнвойса              - Число  - порядковый номер инвойса в заказе,
//                              то есть суффикс после «_»
//  OrderReferenceПоУмолчанию - Строка - что вернуть, если в регистре ничего
//                              не нашлось: инвойсы, выставленные до появления
//                              регистра, там не записаны
//
// Возвращаемое значение:
//  Строка - orderReference для обращения в WayForPay
//
Функция OrderReferenceПоЗаказу(ДокЗаказ, НомерИнвойса, OrderReferenceПоУмолчанию = "") Экспорт

	Результат = СокрЛП(Строка(OrderReferenceПоУмолчанию));

	Суффикс = "_" + СокрЛП(Строка(НомерИнвойса));

	Подходящий = "";

	Для Каждого Значение Из OrderReferenceСписокПоЗаказу(ДокЗаказ) Цикл

		// Точное совпадение с текущим номером сильнее всего: номер заказа
		// не менялся либо инвойс перевыставлен уже под новым номером.
		Если Значение = Результат Тогда
			Подходящий = Значение;
			Прервать;
		КонецЕсли;

		// Иначе годится запись с тем же порядковым номером инвойса.
		// Суффикс проверяем вместе с «_», чтобы «_11» не попало под «_1».
		Если СтрДлина(Суффикс) > 1
			И Прав(Значение, СтрДлина(Суффикс)) = Суффикс
			И ПустаяСтрока(Подходящий) Тогда

			Подходящий = Значение;

		КонецЕсли;

	КонецЦикла;

	Если Не ПустаяСтрока(Подходящий) Тогда
		Результат = Подходящий;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Все orderReference заказа из регистра «Заказы инвойсов WayForPay»,
// новые первыми.
//
// Нужен, чтобы спрашивать статус оплаты по всем инвойсам заказа, а не только
// по текущему порядковому номеру: клиент мог оплатить первый инвойс, а менеджер
// к этому моменту выставить второй.
//
// Возвращаемое значение:
//  Массив строк - может быть пустым (инвойсы выставлены до появления регистра).
//
Функция OrderReferenceСписокПоЗаказу(ДокЗаказ) Экспорт

	Результат = Новый Массив;

	Попытка

		СсылкаЗаказа = ДокЗаказ.Ссылка;

		Если Не ЗначениеЗаполнено(СсылкаЗаказа) Тогда
			Возврат Результат;
		КонецЕсли;

		// Регистр служебный, прав на него у менеджера нет — читаем так же,
		// как и пишем.
		УстановитьПривилегированныйРежим(Истина);

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказыИнвойсов.OrderReference КАК OrderReference
		|ИЗ
		|	РегистрСведений.ЗаказыИнвойсовWayForPay КАК ЗаказыИнвойсов
		|ГДЕ
		|	ЗаказыИнвойсов.Заказ = &Заказ
		|
		|УПОРЯДОЧИТЬ ПО
		|	OrderReference УБЫВ";

		Запрос.УстановитьПараметр("Заказ", СсылкаЗаказа);

		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл

			Значение = СокрЛП(Строка(Выборка.OrderReference));

			Если Не ПустаяСтрока(Значение) Тогда
				Результат.Добавить(Значение);
			КонецЕсли;

		КонецЦикла;

		УстановитьПривилегированныйРежим(Ложь);

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не удалось получить orderReference инвойсов заказа: "
			+ ОписаниеОшибки());

	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ОчисткаНеКоректныхСимволов(ВходящаяСтрока)
	ИсходящаяСтрока = Строка(ВходящаяСтрока);
	ИсходящаяСтрока = СтрЗаменить(ИсходящаяСтрока,";","");
	ИсходящаяСтрока = СтрЗаменить(ИсходящаяСтрока,"≤","");
	ИсходящаяСтрока = СтрЗаменить(ИсходящаяСтрока,"≥","");
	ИсходящаяСтрока = СтрЗаменить(ИсходящаяСтрока,":","");
	ИсходящаяСтрока = СтрЗаменить(ИсходящаяСтрока,"»","");
	ИсходящаяСтрока = СтрЗаменить(ИсходящаяСтрока,"«","");
	Возврат ИсходящаяСтрока 
КонецФункции

