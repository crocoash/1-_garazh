	Если Не ЗначениеЗаполнено(НастройкиПодключений.ИдентификаторПродавца) Тогда
		Рез.Вставить("Сообщение", "Не указан идентификатор продавца WayForPay.");
		Возврат Рез;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НастройкиПодключений.ПодписьЗапроса) Тогда
		Рез.Вставить("Сообщение", "Не указана подпись запроса WayForPay.");
		Возврат Рез;
	КонецЕсли;

	Если ЗначениеЗаполнено(НастройкиПодключений.ПапкаФайлаЛога)
		И ФайлСуществует(НастройкиПодключений.ПапкаФайлаЛога) Тогда

		ИмяИсходящегоФайла =
			НастройкиПодключений.ПапкаФайлаЛога
			+ "\CHECK_STATUS.json";

		ИмяФайлаОтвета =
			НастройкиПодключений.ПапкаФайлаЛога
			+ "\answ_CHECK_STATUS.json";

	Иначе

		ИмяИсходящегоФайла =
			КаталогВременныхФайлов()
			+ "CHECK_STATUS.json";

		ИмяФайлаОтвета =
			КаталогВременныхФайлов()
			+ "answ_CHECK_STATUS.json";

	КонецЕсли;

	ФайлОтвета = Новый Файл(ИмяФайлаОтвета);

	Если ФайлОтвета.Существует() Тогда
		Попытка
			УдалитьФайлы(ИмяФайлаОтвета);
		Исключение
		КонецПопытки;
	КонецЕсли;

	СтрокаШифрования =
		Строка(НастройкиПодключений.ИдентификаторПродавца)
		+ ";"
		+ Строка(НомерЗаказа);

	ПодписьЗапроса =
		Строка(НастройкиПодключений.ПодписьЗапроса);

	ПодписьЗапроса16 = "";

	Для К = 1 По СтрДлина(ПодписьЗапроса) Цикл

		ПодписьЗапроса16 =
			ПодписьЗапроса16
			+ ПреобразоватьДесятичнуюСИВHex(
				КодСимвола(
					Сред(ПодписьЗапроса, К, 1)
				)
			);

	КонецЦикла;

	MerchantSignature =
		HMAC(
			ПодписьЗапроса16,
			СтрокаШифрования,
			"MD5"
		);

	Попытка

		ЗаписьДЖС = Новый ЗаписьJSON;
		ЗаписьДЖС.ПроверятьСтруктуру = Истина;

		ПараметрыЗаписиДЖС =
			Новый ПараметрыЗаписиJSON(
				ПереносСтрокJSON.Нет
			);

		ЗаписьДЖС.ОткрытьФайл(
			ИмяИсходящегоФайла,
			КодировкаТекста.UTF8,
			Ложь,
			ПараметрыЗаписиДЖС
		);

		ЗаписьДЖС.ЗаписатьНачалоОбъекта();

		ЗаписьДЖС.ЗаписатьИмяСвойства("transactionType");
		ЗаписьДЖС.ЗаписатьЗначение("CHECK_STATUS");

		ЗаписьДЖС.ЗаписатьИмяСвойства("merchantAccount");
		ЗаписьДЖС.ЗаписатьЗначение(
			НастройкиПодключений.ИдентификаторПродавца
		);

		ЗаписьДЖС.ЗаписатьИмяСвойства("orderReference");
		ЗаписьДЖС.ЗаписатьЗначение(
			Строка(НомерЗаказа)
		);

		ЗаписьДЖС.ЗаписатьИмяСвойства("merchantSignature");
		ЗаписьДЖС.ЗаписатьЗначение(
			MerchantSignature
		);

		ЗаписьДЖС.ЗаписатьИмяСвойства("apiVersion");
		ЗаписьДЖС.ЗаписатьЗначение(1);

		ЗаписьДЖС.ЗаписатьКонецОбъекта();
		ЗаписьДЖС.Закрыть();

	Исключение

		Рез.Вставить(
			"Сообщение",
			"Ошибка формирования запроса CHECK_STATUS: "
			+ ОписаниеОшибки()
		);

		Возврат Рез;

	КонецПопытки;

	Попытка

		Соединение =
			СоздатьHTTPСоединение(
				НастройкиПодключений
			);

		ОтветСервера =
			Соединение.ОтправитьДляОбработки(
				ИмяИсходящегоФайла,
				"/api",
				ИмяФайлаОтвета
			);

	Исключение

		Рез.Вставить(
			"Сообщение",
			"Ошибка подключения к WayForPay: "
			+ ОписаниеОшибки()
		);

		Возврат Рез;

	КонецПопытки;

	ФайлОтвета = Новый Файл(ИмяФайлаОтвета);

	Если Не ФайлОтвета.Существует() Тогда

		Рез.Вставить(
			"Сообщение",
			"Ответ сервера WayForPay не получен."
		);

		Возврат Рез;

	КонецЕсли;

	ТекстОтвета = Новый ТекстовыйДокумент;

	Попытка

		ТекстОтвета.Прочитать(
			ИмяФайлаОтвета
		);

	Исключение

		Рез.Вставить(
			"Сообщение",
			"Не удалось прочитать ответ WayForPay: "
			+ ОписаниеОшибки()
		);

		Возврат Рез;

	КонецПопытки;

	Если ТекстОтвета.КоличествоСтрок() = 0 Тогда

		Рез.Вставить(
			"Сообщение",
			"WayForPay вернул пустой ответ."
		);

		Возврат Рез;

	КонецЕсли;

	СтрокаОтвета =
		ТекстОтвета.ПолучитьТекст();

	Рез.Вставить(
		"ОтветСервера",
		СтрокаОтвета
	);

	Попытка

		ЧтениеДЖС = Новый ЧтениеJSON;
		ЧтениеДЖС.ОткрытьФайл(
			ИмяФайлаОтвета
		);

		Записи =
			ПрочитатьJSON(
				ЧтениеДЖС
			);

		ЧтениеДЖС.Закрыть();

	Исключение

		Рез.Вставить(
			"Сообщение",
			"Ошибка разбора ответа WayForPay: "
			+ ОписаниеОшибки()
			+ Символы.ПС
			+ СтрокаОтвета
		);

		Возврат Рез;

	КонецПопытки;

	СтатусОплаты = "";
	КодОтвета = "";
	Причина = "";
	НомерОтвета = "";
	AuthCode = "";
	Сумма = 0;
	Валюта = "";
	ДатаСоздания = 0;
	ДатаОплаты = 0;
	Карта = "";
	ТипКарты = "";
	Банк = "";
	СистемаОплаты = "";
	Комиссия = 0;
	СуммаВозврата = 0;
     //WAIT_FOR_KEEP

	Для Каждого Запись Из Записи Цикл

		Если Запись.Ключ = "orderReference" Тогда

			НомерОтвета =
				СокрЛП(
					Строка(
						Запись.Значение
					)
				);

		ИначеЕсли Запись.Ключ = "transactionStatus" Тогда

			СтатусОплаты =
				СокрЛП(
					Строка(
						Запись.Значение
					)
				);

		ИначеЕсли Запись.Ключ = "authCode" Тогда

			AuthCode =
				СокрЛП(
					Строка(
						Запись.Значение
					)
				);

		ИначеЕсли Запись.Ключ = "reasonCode" Тогда

			Если ТипЗнч(Запись.Значение) = Тип("Число") Тогда

				КодОтвета =
					Формат(
						Запись.Значение,
						"ЧГ=0; ЧН="
					);

			Иначе

				КодОтвета =
					СокрЛП(
						Строка(
							Запись.Значение
						)
					);

				КодОтвета =
					СтрЗаменить(
						КодОтвета,
						" ",
						""
					);

				КодОтвета =
					СтрЗаменить(
						КодОтвета,
						Символ(160),
						""
					);

			КонецЕсли;

		ИначеЕсли Запись.Ключ = "reason" Тогда

			Причина =
				СокрЛП(
					Строка(
						Запись.Значение
					)
				);

		ИначеЕсли Запись.Ключ = "amount" Тогда

			Сумма = Запись.Значение;

		ИначеЕсли Запись.Ключ = "currency" Тогда

			Валюта =
				СокрЛП(
					Строка(
						Запись.Значение
					)
				);

		ИначеЕсли Запись.Ключ = "createdDate" Тогда

			ДатаСоздания = Запись.Значение;

		ИначеЕсли Запись.Ключ = "processingDate" Тогда

			ДатаОплаты = Запись.Значение;

		ИначеЕсли Запись.Ключ = "cardPan" Тогда

			Карта =
				СокрЛП(
					Строка(
						Запись.Значение
					)
				);

		ИначеЕсли Запись.Ключ = "cardType" Тогда

			ТипКарты =
				СокрЛП(
					Строка(
						Запись.Значение
					)
				);

		ИначеЕсли Запись.Ключ = "issuerBankName" Тогда

			Банк =
				СокрЛП(
					Строка(
						Запись.Значение
					)
				);

		ИначеЕсли Запись.Ключ = "paymentSystem" Тогда

			СистемаОплаты =
				СокрЛП(
					Строка(
						Запись.Значение
					)
				);

		ИначеЕсли Запись.Ключ = "fee" Тогда

			Комиссия = Запись.Значение;

		ИначеЕсли Запись.Ключ = "refundAmount" Тогда

			СуммаВозврата = Запись.Значение;

		КонецЕсли;

	КонецЦикла;

	Рез.Вставить(
		"СтатусОплаты",
		СтатусОплаты
	);

	Рез.Вставить(
		"КодОтвета",
		КодОтвета
	);

	Рез.Вставить(
		"Причина",
		Причина
	);

	Рез.Вставить(
		"НомерЗаказа",
		НомерОтвета
	);

	Рез.Вставить(
		"AuthCode",
		AuthCode
	);

	Рез.Вставить(
		"Сумма",
		Сумма
	);

	Рез.Вставить(
		"Валюта",
		Валюта
	);

	Рез.Вставить(
		"ДатаСоздания",
		ДатаСоздания
	);

	Рез.Вставить(
		"ДатаОплаты",
		ДатаОплаты
	);

	Рез.Вставить(
		"Карта",
		Карта
	);

	Рез.Вставить(
		"ТипКарты",
		ТипКарты
	);

	Рез.Вставить(
		"Банк",
		Банк
	);

	Рез.Вставить(
		"СистемаОплаты",
		СистемаОплаты
	);

	Рез.Вставить(
		"Комиссия",
		Комиссия
	);

	Рез.Вставить(
		"СуммаВозврата",
		СуммаВозврата
	);

	Если КодОтвета <> "1100" Тогда

		Рез.Вставить(
			"Успешно",
			Ложь
		);

		Рез.Вставить(
			"Сообщение",
			КодОтвета
			+ " "
			+ Причина
		);

		Возврат Рез;

	КонецЕсли;

	Если ЗначениеЗаполнено(НомерОтвета)
		И НомерОтвета <> Строка(НомерЗаказа) Тогда

		Рез.Вставить(
			"Успешно",
			Ложь
		);

		Рез.Вставить(
			"Сообщение",
			"WayForPay вернул статус другого заказа: "
			+ НомерОтвета
		);

		Возврат Рез;

	КонецЕсли;

	Рез.Вставить(
		"Успешно",
		Истина
	);

	Рез.Вставить(
		"Сообщение",
		""
	);

	Возврат Рез;

КонецФункции

// Список транзакций мерчанта за период (метод WayForPay TRANSACTION_LIST).
// Используется загрузкой банковских выписок: источник "WayForPay" опрашивает
// эквайринг теми же реквизитами продавца, что и остальные методы модуля.
// Существующие функции не затрагивает.
//
// Параметры:
//   НастройкиПодключений - СправочникСсылка.wayforpay_НастройкиПодключения_СД;
//   ДатаНачала, ДатаКонца - Дата.
//
// Возвращаемое значение:
//   Структура:
//     * Успешно     - Булево;
//     * Сообщение   - Строка;
//     * КодОтвета   - Строка;
//     * Транзакции  - Массив из Соответствие - как их вернул WayForPay.
//
Функция ПолучитьСписокТранзакций(НастройкиПодключений, ДатаНачала, ДатаКонца) Экспорт

	Рез = Новый Структура;
	Рез.Вставить("Успешно", Ложь);
	Рез.Вставить("Сообщение", "");
	Рез.Вставить("КодОтвета", "");
	Рез.Вставить("Транзакции", Новый Массив);

	Если Не ЗначениеЗаполнено(НастройкиПодключений) Тогда
		Рез.Сообщение = "Не указаны настройки подключения WayForPay.";
		Возврат Рез;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НастройкиПодключений.ИдентификаторПродавца) Тогда
		Рез.Сообщение = "Не указан идентификатор продавца WayForPay.";
		Возврат Рез;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(НастройкиПодключений.ПодписьЗапроса) Тогда
		Рез.Сообщение = "Не указана подпись запроса WayForPay.";
		Возврат Рез;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаКонца) Тогда
		Рез.Сообщение = "Не указан период выборки транзакций.";
		Возврат Рез;
	КонецЕсли;

	Если ЗначениеЗаполнено(НастройкиПодключений.ПапкаФайлаЛога)
		И ФайлСуществует(НастройкиПодключений.ПапкаФайлаЛога) Тогда

		ИмяИсходящегоФайла = НастройкиПодключений.ПапкаФайлаЛога + "\TRANSACTION_LIST.json";
		ИмяФайлаОтвета     = НастройкиПодключений.ПапкаФайлаЛога + "\answ_TRANSACTION_LIST.json";

	Иначе

		ИмяИсходящегоФайла = КаталогВременныхФайлов() + "TRANSACTION_LIST.json";
		ИмяФайлаОтвета     = КаталогВременныхФайлов() + "answ_TRANSACTION_LIST.json";

	КонецЕсли;

	ФайлОтвета = Новый Файл(ИмяФайлаОтвета);

	Если ФайлОтвета.Существует() Тогда
		Попытка
			УдалитьФайлы(ИмяФайлаОтвета);
		Исключение
		КонецПопытки;
	КонецЕсли;

	UnixНачала = ДатаВUnixWayForPay(НачалоДня(ДатаНачала));
	UnixКонца  = ДатаВUnixWayForPay(КонецДня(ДатаКонца));

	СтрокаШифрования =
		Строка(НастройкиПодключений.ИдентификаторПродавца)
		+ ";"
		+ Формат(UnixНачала, "ЧГ=0")
		+ ";"
		+ Формат(UnixКонца, "ЧГ=0");

	ПодписьЗапроса = Строка(НастройкиПодключений.ПодписьЗапроса);
	ПодписьЗапроса16 = "";

	Для К = 1 По СтрДлина(ПодписьЗапроса) Цикл
		ПодписьЗапроса16 = ПодписьЗапроса16
			+ ПреобразоватьДесятичнуюСИВHex(КодСимвола(Сред(ПодписьЗапроса, К, 1)));
	КонецЦикла;

	MerchantSignature = HMAC(ПодписьЗапроса16, СтрокаШифрования, "MD5");

	Попытка

		ЗаписьДЖС = Новый ЗаписьJSON;
		ЗаписьДЖС.ПроверятьСтруктуру = Истина;

		ПараметрыЗаписиДЖС = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет);

		ЗаписьДЖС.ОткрытьФайл(ИмяИсходящегоФайла, КодировкаТекста.UTF8, Ложь, ПараметрыЗаписиДЖС);

		ЗаписьДЖС.ЗаписатьНачалоОбъекта();

		ЗаписьДЖС.ЗаписатьИмяСвойства("transactionType");
		ЗаписьДЖС.ЗаписатьЗначение("TRANSACTION_LIST");

		ЗаписьДЖС.ЗаписатьИмяСвойства("merchantAccount");
		ЗаписьДЖС.ЗаписатьЗначение(НастройкиПодключений.ИдентификаторПродавца);

		ЗаписьДЖС.ЗаписатьИмяСвойства("merchantSignature");
		ЗаписьДЖС.ЗаписатьЗначение(MerchantSignature);

		ЗаписьДЖС.ЗаписатьИмяСвойства("apiVersion");
		ЗаписьДЖС.ЗаписатьЗначение(1);

		ЗаписьДЖС.ЗаписатьИмяСвойства("dateBegin");
		ЗаписьДЖС.ЗаписатьЗначение(UnixНачала);

		ЗаписьДЖС.ЗаписатьИмяСвойства("dateEnd");
		ЗаписьДЖС.ЗаписатьЗначение(UnixКонца);

		ЗаписьДЖС.ЗаписатьКонецОбъекта();
		ЗаписьДЖС.Закрыть();

	Исключение

		Рез.Сообщение = "Ошибка формирования запроса TRANSACTION_LIST: " + ОписаниеОшибки();
		Возврат Рез;

	КонецПопытки;

	Попытка

		Соединение = СоздатьHTTPСоединение(НастройкиПодключений);
		Соединение.ОтправитьДляОбработки(ИмяИсходящегоФайла, "/api", ИмяФайлаОтвета);

	Исключение

		Рез.Сообщение = "Ошибка подключения к WayForPay: " + ОписаниеОшибки();
		Возврат Рез;

	КонецПопытки;

	ФайлОтвета = Новый Файл(ИмяФайлаОтвета);

	Если Не ФайлОтвета.Существует() Тогда
		Рез.Сообщение = "Ответ сервера WayForPay не получен.";
		Возврат Рез;
	КонецЕсли;

	Попытка

		ЧтениеДЖС = Новый ЧтениеJSON;
		ЧтениеДЖС.ОткрытьФайл(ИмяФайлаОтвета);
		Записи = ПрочитатьJSON(ЧтениеДЖС);
		ЧтениеДЖС.Закрыть();

	Исключение

		Рез.Сообщение = "Ошибка разбора ответа WayForPay: " + ОписаниеОшибки();
		Возврат Рез;

	КонецПопытки;

	Причина = "";

	Для Каждого Запись Из Записи Цикл

		Если Запись.Ключ = "reasonCode" Тогда

			// Число приходит с разделителем групп — неразрывным пробелом
			// (Символ(160)): "1 100". Вычищаем оба вида пробелов, иначе
			// сравнение с "1100" не сработает и успешный ответ будет
			// принят за ошибку.
			Если ТипЗнч(Запись.Значение) = Тип("Число") Тогда
				Рез.КодОтвета = Формат(Запись.Значение, "ЧГ=0; ЧН=");
			Иначе
				КодСтрокой = СокрЛП(Строка(Запись.Значение));
				КодСтрокой = СтрЗаменить(КодСтрокой, " ", "");
				КодСтрокой = СтрЗаменить(КодСтрокой, Символ(160), "");
				Рез.КодОтвета = КодСтрокой;
			КонецЕсли;

		ИначеЕсли Запись.Ключ = "reason" Тогда

			Причина = СокрЛП(Строка(Запись.Значение));

		ИначеЕсли Запись.Ключ = "transactionList" Тогда

			Если ТипЗнч(Запись.Значение) = Тип("Массив") Тогда
				Рез.Транзакции = Запись.Значение;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	// 1100 = Ok. Пустой список за период — тоже успех, просто транзакций нет.
	Если Рез.КодОтвета <> "" И Рез.КодОтвета <> "1100" Тогда

		Рез.Сообщение =
			"WayForPay вернул код " + Рез.КодОтвета
			+ ?(ПустаяСтрока(Причина), "", ": " + Причина);

		Возврат Рез;

	КонецЕсли;

	Рез.Успешно = Истина;

	Возврат Рез;

КонецФункции

// База работает по украинскому времени, WayForPay принимает unix-время UTC.
Функция ДатаВUnixWayForPay(ДатаЗначение)

	Если Не ЗначениеЗаполнено(ДатаЗначение) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Цел(ДатаЗначение - Дата(1970, 1, 1, 0, 0, 0) - 3 * 60 * 60);

КонецФункции

