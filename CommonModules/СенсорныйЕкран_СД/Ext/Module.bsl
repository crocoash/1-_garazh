Функция ВводЧисла(ЧислоЗначение,мБезДробнойЧасти = Ложь,мНеЗаполнятьСотые = Ложь,мРежимПароля = Ложь,мПоказыватьПароль = Ложь,мВводТелефона = ложь,мОграничениеЧисла = 0) Экспорт 
	Форма_СД = ПолучитьОбщуюФорму("СенсорныйЕкран_ВводЧисла_СД");
	Форма_СД.мЗначеЧисла 		= ЧислоЗначение;
	Форма_СД.мБезДробнойЧасти 	= мБезДробнойЧасти;
	Форма_СД.мНеЗаполнятьСотые 	= мНеЗаполнятьСотые;
	Форма_СД.мРежимПароля 		= мРежимПароля;
	Форма_СД.мПоказыватьПароль 	= мПоказыватьПароль;
	Форма_СД.мВводТелефона 		= мВводТелефона;
	Форма_СД.мОграничениеЧисла 	= мОграничениеЧисла;
	Форма_СД.ОткрытьМодально();

	ЧислоЗначение = СтрЗаменить(Форма_СД.мЗначеЧисла,Символы.НПП,"");
	
	Возврат ЧислоЗначение;
КонецФункции

Функция ПоискПоляПоПаролю(ЗначениеПароля)Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СенсорныйЕкран_НастройкиПользователей_СД.Оператор
		|ИЗ
		|	РегистрСведений.СенсорныйЕкран_НастройкиПользователей_СД КАК СенсорныйЕкран_НастройкиПользователей_СД
		|ГДЕ
		|	СенсорныйЕкран_НастройкиПользователей_СД.ПарольОператора = &ПарольОператора";
	
	Запрос.УстановитьПараметр("ПарольОператора", ЗначениеПароля);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Оператор;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции  

Функция ПолучитьПараметрыПользователя(Пользователь)Экспорт 
	//+БП: d.matyash (03.12.2024) <> 
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Оператор",Справочники.Пользователи.ПустаяСсылка());
	СтруктураВозврата.Вставить("УсловиеПриема",Справочники.УсловияПриема.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СенсорныйЕкран_НастройкиПользователей_СД.Оператор,
		|	СенсорныйЕкран_НастройкиПользователей_СД.УсловиеПриема
		|ИЗ
		|	РегистрСведений.СенсорныйЕкран_НастройкиПользователей_СД КАК СенсорныйЕкран_НастройкиПользователей_СД
		|ГДЕ
		|	СенсорныйЕкран_НастройкиПользователей_СД.Оператор = &Оператор";
	
	Запрос.УстановитьПараметр("Оператор", Пользователь);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл    
		ЗаполнитьЗначенияСвойств(СтруктураВозврата,ВыборкаДетальныеЗаписи);
		Возврат СтруктураВозврата;
	КонецЦикла;
	
	Возврат СтруктураВозврата;
	//-БП: d.matyash (03.12.2024) <>	
КонецФункции


Процедура ВывестиОповещение(ТекстСообщения)Экспорт 
	Форма_СД = ПолучитьОбщуюФорму("СенсорныйЕкран_ФормаОповещения");
	Форма_СД.мВопрос = ТекстСообщения;
	Форма_СД.ПоложениеОкна = ВариантПоложенияОкна.Центрировать;
	Форма_СД.ОткрытьМодально();
КонецПроцедуры

Функция ВывестиВопрос(ТекстСообщения,РежимДаНет = истина)Экспорт 
	Форма_СД 				= ПолучитьОбщуюФорму("СенсорныйЕкран_ФормаВопроса_СД");
	Форма_СД.мВопрос 		= ТекстСообщения;
	Форма_СД.мДаНет 		= РежимДаНет;
	Форма_СД.ПоложениеОкна 	= ВариантПоложенияОкна.Центрировать;
	Форма_СД.ОткрытьМодально();
	
	Возврат Форма_СД.мРезультат;
КонецФункции

Функция ВыборИзТабл(ТаблицаЗнач)Экспорт
