Процедура ОтправитьПисьмо(УчетнаяЗапись,Тема,АдресПолучателя,ПутьНаДискуКФайлу,ИмяФайла)Экспорт 
	
	
	СтворенняЕлектроногоЛиста = Документы.ЭлектронноеПисьмо.СоздатьДокумент();
	СтворенняЕлектроногоЛиста.Дата = ТекущаяДата();
	
	НоваяСтрока = СтворенняЕлектроногоЛиста.КомуТЧ.Добавить();
	
	НоваяСтрока.АдресЭлектроннойПочты =  АдресПолучателя;
	НоваяСтрока.Представление = АдресПолучателя;
	
	СтворенняЕлектроногоЛиста.КомуПредставление = АдресПолучателя;			
	СтворенняЕлектроногоЛиста.Кому = АдресПолучателя;
	
	СтворенняЕлектроногоЛиста.ОтправительАдресЭлектроннойПочты = УчетнаяЗапись.АдресЭлектроннойПочты;
	СтворенняЕлектроногоЛиста.ОтправительПредставление = УчетнаяЗапись.АдресЭлектроннойПочты;
	
	СтворенняЕлектроногоЛиста.Тема = Тема;			
	СтворенняЕлектроногоЛиста.УчетнаяЗапись = УчетнаяЗапись;
	СтворенняЕлектроногоЛиста.ВидТекстаПисьма = Перечисления.ВидыТекстовЭлектронныхПисем.Текст;
	СтворенняЕлектроногоЛиста.ЕстьВложения = истина;
	СтворенняЕлектроногоЛиста.Записать();
	
	Вложение = Справочники.ВложенияЭлектронныхПисем.СоздатьЭлемент() ;
	Вложение.Объект = СтворенняЕлектроногоЛиста.Ссылка;
	Вложение.ИмяФайла = ИмяФайла;//""+ТекущаяДата()+".xls";
	Вложение.Хранилище = Новый ХранилищеЗначения(Новый ДвоичныеДанные(ПутьНаДискуКФайлу)); 
	Вложение.Записать();
	
	//Попытка
	
	СтворенняЕлектроногоЛиста.ОтправитьПисьмо();

КонецПроцедуры