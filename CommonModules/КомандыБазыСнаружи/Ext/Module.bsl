////////////////////////////////////////////////////////////////////////////////
// Служебный вход в базу снаружи: произвольный запрос на языке запросов, справка
// по метаданным, правка справочников, чтение журнала регистрации. Работу делают
// ЧтениеДанныхБазы
// и ИзменениеСправочников, здесь только разбор запроса и проверка токена.
//
// Адрес: https://<хост>/<база>/hs/api/db/cmd
//
// Живёт в уже опубликованном HTTPСервис.HTTPОбменССайтомAPI отдельным шаблоном
// URL, а не своим сервисом. Причина практическая: список сервисов лежит
// в default.vrd на машине с веб-сервером, и новый сервис потребовал бы правки
// публикации, а новый шаблон внутри существующего - только загрузки
// конфигурации. Обработчики в модуле сервиса - две строки делегирования,
// вся работа здесь.
//
// ПОЧЕМУ ПРОИЗВОЛЬНЫЙ ТЕКСТ ЗАПРОСА, А НЕ БЕЛЫЙ СПИСОК ГОТОВЫХ
//
// В языке запросов 1С нет ни INSERT, ни UPDATE, ни DELETE, а Запрос.Текст
// никакой код не выполняет - он разбирается построителем запросов. Изменить
// данные этим путём нельзя в принципе, и худшее, что делает кривой запрос, -
// грузит сервер и возвращает мусор. Белый список стоил бы круга «правка ->
// push -> pull -> загрузка конфигурации» на КАЖДЫЙ новый вопрос к базе,
// а вопросы возникают по ходу разбора, а не заранее.
//
// Защита - один общий токен: у канала нет пользователей, есть свои и чужие.
// Токен принимается заголовком X-Site-Token, полем token в теле или параметром
// token в строке запроса. Три пути равноправны: заголовки до сервиса доходят
// не всегда (веб-сервер, прокси, настройки публикации), а поймать это снаружи
// нечем - отказ выглядит одинаково.
//
// Отвечаем 200 даже на отказ по существу (ошибка в запросе, объект не найден):
// разбираемый JSON с ok = Ложь полезнее, чем код состояния. 403 - единственное
// исключение, это ответ чужому.
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Обработчик POST и GET /hs/api/db/cmd. Зовётся из модуля HTTP-сервиса.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция Принять(Запрос) Экспорт

	Данные = ДанныеЗапроса(Запрос);

	Если Не ТокенСовпадает(Запрос, Данные) Тогда

		ЗаписьЖурналаРегистрации("База.Запрос",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Запрос без правильного токена отклонён.");

		Возврат Новый HTTPСервисОтвет(403);

	КонецЕсли;

	Действие = "";
	Данные.Свойство("action", Действие);
	Действие = НРег(СокрЛП(Строка(Действие)));

	Если Действие = "ping" Тогда

		Ответ = Новый Структура;
		Ответ.Вставить("ok",   Истина);
		Ответ.Вставить("time", Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm:ss'"));
		Ответ.Вставить("base", Метаданные.Синоним + " " + Метаданные.Версия);

		Возврат ОтветJSON(200, Ответ);

	КонецЕсли;

	Попытка

		Если Действие = "query" Тогда
			Возврат ОтветJSON(200, ЧтениеДанныхБазы.ВыполнитьЗапрос(Данные));
		КонецЕсли;

		Если Действие = "meta" Тогда
			Возврат ОтветJSON(200, ЧтениеДанныхБазы.ОписаниеМетаданных(Данные));
		КонецЕсли;

		Если Действие = "edit" Тогда
			Возврат ОтветJSON(200, ИзменениеСправочников.Изменить(Данные));
		КонецЕсли;

		Если Действие = "log" Тогда
			Возврат ОтветJSON(200, ЧтениеДанныхБазы.ПрочитатьЖурналРегистрации(Данные));
		КонецЕсли;

	Исключение

		// Текст ошибки уходит наружу как есть, в отличие от клиентских сервисов:
		// почти всегда это синтаксическая ошибка в самом запросе, и она нужна
		// тому, кто запрос писал. Канал служебный, покупатель этого не видит.
		ЗаписьЖурналаРегистрации("База.Запрос",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Действие """ + Действие + """ не выполнено: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь, ОписаниеОшибки()));

	КонецПопытки;

	Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь,
		"bad action: " + Лев(Действие, 40)));

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Тело запроса и параметры строки запроса одной структурой.
//
// В GET всё приходит строками, поэтому флаги и вложенный JSON приводим к типам
// сами: модулям ниже нужны Булево и Структура, а «ids=1» - это строка "1".
Функция ДанныеЗапроса(Запрос)

	// Тело читаем РОВНО ОДИН раз: повторный ПолучитьТелоКакСтроку по уже
	// вычитанному потоку возвращает пустое значение, а то и исключение.
	ТелоЗапроса = "";

	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	Исключение
		ТелоЗапроса = "";
	КонецПопытки;

	Данные = РазобратьТело(ТелоЗапроса);

	Для Каждого КлючЗначение Из Запрос.ПараметрыЗапроса Цикл
		Данные.Вставить(Строка(КлючЗначение.Ключ), Строка(КлючЗначение.Значение));
	КонецЦикла;

	ПривестиФлаг(Данные, "ids");
	ПривестиФлаг(Данные, "apply");
	ПривестиФлаг(Данные, "dry");

	ПривестиJSON(Данные, "params");
	ПривестиJSON(Данные, "items");

	Возврат Данные;

КонецФункции

Процедура ПривестиФлаг(Данные, Знач Ключ)

	Значение = Неопределено;

	Если Не Данные.Свойство(Ключ, Значение) Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = НРег(СокрЛП(Значение));
		Данные.Вставить(Ключ, Текст = "1" ИЛИ Текст = "true" ИЛИ Текст = "истина" ИЛИ Текст = "да");
	КонецЕсли;

КонецПроцедуры

Процедура ПривестиJSON(Данные, Знач Ключ)

	Значение = Неопределено;

	Если Не Данные.Свойство(Ключ, Значение) Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ ПустаяСтрока(Значение) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Значение);
		Данные.Вставить(Ключ, ПрочитатьJSON(ЧтениеJSON, Ложь));
		ЧтениеJSON.Закрыть();

	Исключение

		// Оставляем строкой: модуль ниже увидит не тот тип и скажет об этом
		// понятнее, чем «ошибка разбора» без имени поля.
		Данные.Вставить(Ключ, Значение);

	КонецПопытки;

КонецПроцедуры

// Тело запроса структурой. Не JSON, битый JSON, пустое тело - пустая структура,
// а не исключение: разбирать приходится ДО проверки токена, то есть тело может
// быть каким угодно, в том числе от чужого, кто просто постучался.
Функция РазобратьТело(Знач ТелоЗапроса)

	Попытка

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

	Исключение

		Данные = Неопределено;

	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Новый Структура;
	КонецЕсли;

	Возврат Данные;

КонецФункции

// Заголовки от веб-сервера приходят в разном регистре, поэтому ищем перебором
// по нижнему регистру имени, а не обращением по ключу.
Функция ТокенСовпадает(Запрос, Знач Данные)

	Ожидаемый = Токен();

	Если ПустаяСтрока(Ожидаемый) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Заголовок Из Запрос.Заголовки Цикл

		Если НРег(СокрЛП(Строка(Заголовок.Ключ))) = "x-site-token"
			И СокрЛП(Строка(Заголовок.Значение)) = Ожидаемый Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	ИзТела = "";
	Данные.Свойство("token", ИзТела);

	Возврат СокрЛП(Строка(ИзТела)) = Ожидаемый;

КонецФункции

// Общий токен канала. Лежит в коде, а не в константе, намеренно: канал служебный,
// а константу пришлось бы заводить, заполнять руками в базе и не забыть про это
// при следующей загрузке конфигурации. Менять - здесь и у всех вызывающих
// одновременно.
Функция Токен()

	Возврат "317d2e66a8d05688879a33df5efff3d5";

КонецФункции

// Ответ JSON. Тело собираем всегда сами: HTTPСервисОтвет по умолчанию отдаёт
// пустое тело, а вызывающему нужен разбираемый ответ даже на отказ.
Функция ОтветJSON(Знач Код, Знач Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Тело = ЗаписьJSON.Закрыть();

	Результат = Новый HTTPСервисОтвет(Код);
	Результат.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Результат.УстановитьТелоИзСтроки(Тело, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);

	Возврат Результат;

КонецФункции
