
Функция Э_НайтиЛид(НомерТелефона) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Э_Лиды.Ссылка
	|ИЗ
	|	Справочник.Э_Лиды КАК Э_Лиды
	|ГДЕ
	|	Э_Лиды.НомерТелефона = &НомерТелефона
	|	И Э_Лиды.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("НомерТелефона", СокрЛП(НомерТелефона));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	иначе
		Возврат Неопределено;
    КонецЕсли;
КонецФункции // Э_НайтиЛид()
 
Функция Э_СоздатьНайтиЛид(НомерТелефона,ТекКонтрагент,ИмяЗаказчика=Неопределено,IPЗаказчика=Неопределено,ЭлектронныйАдрес=Неопределено,Адрес=Неопределено,ДопИнфо=Неопределено,Ответственный=Неопределено,ИсточникИнформации=Неопределено,CustomerIDВиртуальнойАТС=Неопределено) Экспорт
    Перем ФлУдалосьЗаблокировать,Э_НайденныйЛид,НовыйЛид,ТекОтветственный;
	
	Э_НайденныйЛид=Э_НайтиЛид(НомерТелефона);
	
	Если ЗначениеЗаполнено(Э_НайденныйЛид) Тогда
		НовыйЛид = Э_НайденныйЛид.ПолучитьОбъект();
		 
		Попытка
		      НовыйЛид.Заблокировать();
			  ФлУдалосьЗаблокировать=Истина;
		Исключение
			  ФлУдалосьЗаблокировать=Ложь;
		КонецПопытки;
		   
	Иначе
		НовыйЛид = Справочники.Э_Лиды.СоздатьЭлемент();
		НовыйЛид.Наименование=НомерТелефона;
		 
		ФлУдалосьЗаблокировать=Истина;
		 
	КонецЕсли;
	
	Если ФлУдалосьЗаблокировать Тогда
		Если НЕ ЗначениеЗаполнено(НовыйЛид.Статус) Тогда
		     НовыйЛид.Статус = Перечисления.Э_СтатусыЛидов.Горячий;
		КонецЕсли;	 
		Если НЕ ЗначениеЗаполнено(НовыйЛид.НомерТелефона) и ЗначениеЗаполнено(НомерТелефона)  Тогда
			НовыйЛид.НомерТелефона = НомерТелефона;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НовыйЛид.IP_Адрес) и ЗначениеЗаполнено(IPЗаказчика) Тогда
			НовыйЛид.IP_Адрес = IPЗаказчика;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НовыйЛид.EMAIL) и ЗначениеЗаполнено(ЭлектронныйАдрес)  Тогда
			НовыйЛид.EMAIL = ЭлектронныйАдрес;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НовыйЛид.Адрес) и ЗначениеЗаполнено(Адрес) Тогда
			НовыйЛид.Адрес = Адрес;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НовыйЛид.Контрагент) и ЗначениеЗаполнено(ТекКонтрагент)  Тогда
			НовыйЛид.Контрагент = ТекКонтрагент;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НовыйЛид.Комментарий) и ЗначениеЗаполнено(ДопИнфо)  Тогда
			НовыйЛид.Комментарий = ДопИнфо;
		КонецЕсли;
		
		ТекОтветственный=?(ЗначениеЗаполнено(Ответственный),Ответственный,ПараметрыСеанса.ТекущийПользователь);
		Если (Не ЗначениеЗаполнено(НовыйЛид.ОтветсвенныйМенеджер) ИЛИ СокрЛП(НовыйЛид.ОтветсвенныйМенеджер)="<Не указан>") и НовыйЛид.ОтветсвенныйМенеджер <> ТекОтветственный Тогда
			НовыйЛид.ОтветсвенныйМенеджер = ТекОтветственный;
		КонецЕсли;
		Э_УправлениеЛидами.Э_ЛидыОпределитьРеквизитКонтрагентЕслиНеЗаполнен(НовыйЛид,НовыйЛид.НомерТелефона);
		
		Если Не ЗначениеЗаполнено(НовыйЛид.Э_ИсточникИнформации) и ЗначениеЗаполнено(ИсточникИнформации) Тогда
		 	НовыйЛид.Э_ИсточникИнформации = ИсточникИнформации;
		КонецЕсли; 
		 		 
		Если СокрЛП(НовыйЛид.Наименование)=СокрЛП(НовыйЛид.НомерТелефона) и ЗначениеЗаполнено(ИмяЗаказчика) Тогда
		     НовыйЛид.Наименование=ИмяЗаказчика;
		КонецЕсли;
		 
		Если НовыйЛид.Модифицированность() Тогда                           
		    НовыйЛид.Записать();
		КонецЕсли; 
				
		Если ЗначениеЗаполнено(НовыйЛид.Ссылка) и ЗначениеЗаполнено(CustomerIDВиртуальнойАТС) и Не ЗначениеЗаполнено(НовыйЛид.Контрагент) и Не ЗначениеЗаполнено(НовыйЛид.КонтактноеЛицо) Тогда
			CustomerID = Строка(CustomerIDВиртуальнойАТС);
			CustomerID = СтрЗаменить(CustomerID, Символы.НПП, "");
			Э_ТелефонияBinotel.Э_ЗаписатьIDКлиентаВСистемеБинотел(CustomerID,, НовыйЛид.Ссылка);
		КонецЕсли;
				
	КонецЕсли;
	
	Возврат НовыйЛид.Ссылка;
КонецФункции                                             
 
Функция Э_ОпределитьДатуПоследнегоЗапланированногоСобытия(Э_Лид);
     Запрос=Новый Запрос;
	 Запрос.Текст="ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	              |	Событие.Дата КАК СобытиеДата
	              |ИЗ
	              |	Документ.Событие КАК Событие
	              |ГДЕ
	              |	Событие.Э_Лид = &Э_Лид
	              |	И НЕ Событие.ПометкаУдаления
	              |	И Событие.СостояниеСобытия = ЗНАЧЕНИЕ(Перечисление.СостоянияСобытий.Запланировано)
	              |
	              |УПОРЯДОЧИТЬ ПО
	              |	Событие.Дата УБЫВ";
	 Запрос.УстановитьПараметр("Э_Лид",Э_Лид);			  
	 Результат=Запрос.Выполнить().Выбрать();
	 Если Результат.Следующий() Тогда
	      Возврат Результат.СобытиеДата
	 иначе	
	      Возврат Дата('00010101');
	 КонецЕсли;
КонецФункции 
 
// Функция находит актуальное значение телефона в контакной информации.
Функция ПолучитьТелефонИзКонтактнойИнформацииПервыйНеПустой(Объект) Экспорт

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Объект", Объект);
	Запрос.УстановитьПараметр("Тип"   , Перечисления.ТипыКонтактнойИнформации.Телефон);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтактнаяИнформация.CRM_НомерТелефона
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |ГДЕ
	               |	КонтактнаяИнформация.Объект = &Объект
	               |	И КонтактнаяИнформация.Тип = &Тип";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
	    Если ЗначениеЗаполнено(РезультатЗапроса.CRM_НомерТелефона) Тогда
		     Возврат СокрЛП(РезультатЗапроса.CRM_НомерТелефона);
		КонецЕсли;
	КонецЦикла; 
	Возврат Неопределено;
КонецФункции // ПолучитьТелефонИзКонтактнойИнформации()
 
Процедура Э_ПередЗаписьюСобытияПередЗаписью_Лиды(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если Источник.ВидСобытия=Перечисления.ВидыСобытий.ТелефонныйЗвонок и не Источник.ПометкаУдаления Тогда
		Если Не ЗначениеЗаполнено(Источник.Э_Лид) Тогда
		    
			Э_НомерТелефона=неопределено;
			Если ЗначениеЗаполнено(Источник.КонтактноеЛицо) Тогда
			     Э_НомерТелефона=ПолучитьТелефонИзКонтактнойИнформацииПервыйНеПустой(Источник.КонтактноеЛицо);
			КонецЕсли;
			Если Э_НомерТелефона =Неопределено и ЗначениеЗаполнено(Источник.Контрагент) Тогда
			     Э_НомерТелефона=ПолучитьТелефонИзКонтактнойИнформацииПервыйНеПустой(Источник.Контрагент);
			КонецЕсли;
			Если Э_НомерТелефона =Неопределено и ЗначениеЗаполнено(Источник.КонтактноеЛицоБезКонтрагента) Тогда
			     Э_НомерТелефона=ПолучитьТелефонИзКонтактнойИнформацииПервыйНеПустой(Источник.КонтактноеЛицоБезКонтрагента);
			КонецЕсли;
			Если Э_НомерТелефона <> Неопределено и ЗначениеЗаполнено(Э_НомерТелефона) Тогда
				 				 Источник.Э_Лид=Э_СоздатьНайтиЛид(Э_НомерТелефона,Источник.Контрагент,СокрЛП(Источник.Контрагент),,,,,Источник.Ответственный,Источник.ИсточникИнформацииПриОбращении);
				  
			КонецЕсли;
		КонецЕсли;
		                            
		
		Если (Не ЗначениеЗаполнено(Источник.Контрагент) или ТипЗнч(Источник.Контрагент)=Тип("Строка")) и ЗначениеЗаполнено(Источник.Э_Лид) и ЗначениеЗаполнено(Источник.Э_Лид.Контрагент) Тогда
		    Источник.Контрагент=Источник.Э_Лид.Контрагент;
		КонецЕсли;
		
		
		Если ЗначениеЗаполнено(Источник.Контрагент) и ЗначениеЗаполнено(Источник.Э_Лид) и Не ЗначениеЗаполнено(Источник.Э_Лид.Контрагент) Тогда
			ЛидОбъект=Источник.Э_Лид.ПолучитьОБъект();
			Попытка
			      ЛидОбъект.Заблокировать();
				  ФлУдалосьЗаблокировать=Истина;
			Исключение
				  ФлУдалосьЗаблокировать=Ложь;
			КонецПопытки;
		    Если ФлУдалосьЗаблокировать=Истина Тогда
				ЛидОбъект.Контрагент=Источник.Контрагент;
				Попытка
					ЛидОбъект.Записать();
				исключение
					#Если Клиент Тогда
					ОбщегоНазначения.СообщитьОбОшибке(НСтр("ru='Ошибка при попытке записи контрагента ';uk='Помилка при спробі запису контрагента '")+Источник.Контрагент+НСтр("ru=' в карточке лида ';uk=' в картці ліда '")+Источник.Э_Лид+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки());      
					#КонецЕсли
				КонецПопытки;
				ЛидОбъект.Разблокировать();
			иначе
			    #Если Клиент Тогда
			    Э_СтруктураДанных=Новый Структура();
			    Э_СтруктураДанных.Вставить("Э_Лид",Источник.Э_Лид);
			    Э_СтруктураДанных.Вставить("КонтрагентДляЗамены",Источник.Контрагент);
			    Оповестить("Э_ПередЗаписьюСобытияПередЗаписью_КонтрагентДляЗамены",Э_СтруктураДанных);
			    #КонецЕсли
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

Процедура Э_ПриЗаписиРегистраСведенийКонтактнаяИнформацияПриЗаписи_Лиды(Источник, Отказ, Замещение) Экспорт
	Перем Э_НомерТелефона,Э_Лид,ЛидОбъект,ФлУдалосьЗаблокировать,Э_ЛидКонтрагент_Новый;
	
	Для каждого Запись Из Источник Цикл
		Если Запись.Тип<>Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			Продолжить;
		КонецЕсли;	
		Э_НомерТелефона = Запись.CRM_НомерТелефона;                                                                                                
		Э_Лид=Э_НайтиЛид(Э_НомерТелефона);
		
		Э_ЛидКонтрагент_Новый=Неопределено;
		Э_ЛидКонтактноеЛицо_Новый=Неопределено;
		Если ЗначениеЗаполнено(Э_Лид) Тогда
			Если ТипЗнч(Запись.Объект)=Тип("СправочникСсылка.Контрагенты") и Э_Лид.Контрагент<>Запись.Объект Тогда
				 Э_ЛидКонтрагент_Новый=Запись.Объект;
			иначеЕсли ТипЗнч(Запись.Объект)=Тип("СправочникСсылка.КонтактныеЛицаКонтрагентов") Тогда
				Если Э_Лид.КонтактноеЛицо<>Запись.Объект тогда
					 Э_ЛидКонтактноеЛицо_Новый=Запись.Объект;
				КонецЕслИ;	
				Если Э_Лид.Контрагент<>Запись.Объект.Владелец   Тогда
				     Э_ЛидКонтрагент_Новый=Запись.Объект.Владелец
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если Э_ЛидКонтрагент_Новый<>Неопределено или Э_ЛидКонтактноеЛицо_Новый<>Неопределено Тогда
			ЛидОбъект=Э_Лид.ПолучитьОБъект();
			Попытка
			      ЛидОбъект.Заблокировать();
				  ФлУдалосьЗаблокировать=Истина;
			Исключение
				  ФлУдалосьЗаблокировать=Ложь;
			КонецПопытки;
		    Если ФлУдалосьЗаблокировать=Истина Тогда
				Если Э_ЛидКонтрагент_Новый<>Неопределено Тогда
				     ЛидОбъект.Контрагент=Э_ЛидКонтрагент_Новый;
				КонецЕсли;	 
				Если Э_ЛидКонтактноеЛицо_Новый<>Неопределено Тогда
				     ЛидОбъект.КонтактноеЛицо=Э_ЛидКонтактноеЛицо_Новый;
				КонецЕсли;	 
				Если ЛидОбъект.Модифицированность() Тогда
					Попытка
						ЛидОбъект.Записать();
					исключение
						#Если Клиент Тогда
                        ОбщегоНазначения.СообщитьОбОшибке(НСтр("ru='Ошибка при попытке записи контрагента ';uk='Помилка при спробі запису контрагента '")+Э_ЛидКонтрагент_Новый+""""+?(ЗначениеЗаполнено(Э_ЛидКонтактноеЛицо_Новый),НСтр("ru=' контактного лица ';uk=' контактної особи '")+Э_ЛидКонтактноеЛицо_Новый+"""","")+НСтр("ru=' в карточке лида ';uk=' в картці ліда '")+Э_Лид+НСтр("ru='. Ошибка:';uk='. Помилка:'")+ОписаниеОшибки());
                        #КонецЕсли
					КонецПопытки;
				КонецЕсли;	
				ЛидОбъект.Разблокировать();
			иначе                                                      
			    #Если Клиент Тогда
			    Э_СтруктураДанных=Новый Структура();
			    Э_СтруктураДанных.Вставить("Э_Лид",Э_Лид);
			    Э_СтруктураДанных.Вставить("КонтрагентДляЗамены",Э_ЛидКонтрагент_Новый);
				Э_СтруктураДанных.Вставить("КонтактноеЛицоДляЗамены",Э_ЛидКонтактноеЛицо_Новый);
			    Оповестить("Э_ПередЗаписьюСобытияПередЗаписью_КонтрагентДляЗамены",Э_СтруктураДанных);
			    #КонецЕсли
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры
 
Процедура Э_ЛидыОпределитьРеквизитКонтрагентЕслиНеЗаполнен(ТекОбъект,НомерТелефона) Экспорт
	Перем ТекКонтрагент,ТекКонтактноеЛицо,ВидОбъектаКонтактнойИнформации;
	
	Если ЗначениеЗаполнено(ТекОбъект.Контрагент) и ЗначениеЗаполнено(ТекОбъект.КонтактноеЛицо) Тогда
	     Возврат;
	КонецЕсли;
	
	ТекКонтрагент=Неопределено;
	ТекКонтактноеЛицо=Неопределено;
	ВидОбъектаКонтактнойИнформации="";
	Э_ТелефонияBinotel.Э_ОпределитьКонтрагентаКонтактноеЛицо(СокрЛП(НомерТелефона), ВидОбъектаКонтактнойИнформации,ТекКонтрагент,ТекКонтактноеЛицо,);
	
	Если ЗначениеЗаполнено(ТекКонтактноеЛицо) и Не ЗначениеЗаполнено(ТекОбъект.КонтактноеЛицо) Тогда
		 ТекОбъект.КонтактноеЛицо=ТекКонтактноеЛицо;
	КонецЕсли;
 	Если ЗначениеЗаполнено(ТекКонтрагент) и Не ЗначениеЗаполнено(ТекОбъект.Контрагент) Тогда
		 ТекОбъект.Контрагент=ТекКонтрагент;
    КонецЕсли;	
КонецПроцедуры

//Автоматически создаем запланированное событие по лиду, согласно его статуса: горящий, холодный, теплый, безперспективный
Процедура Э_СоздатьЗапланированноеСобытиеТелефонныйЗвонокАвтоматическиСогласноСтатусуЛида(Э_Лид, Э_ИзменятьДатуПланированияВСуществующихЗапланированныхСобытиях=Ложь) Экспорт 
	Э_НастройкиБинотел=Э_ТелефонияBinotel.Э_ПолучитьНастройкиБинотел();
	Если Э_НастройкиБинотел=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Э_НастройкиБинотел.Э_BinotelСоздаватьЗапланированныеСобытияТелефонныйЗвонок Тогда
		Возврат;
	КонецЕсли;
	
	Если Э_Лид.Закрыт Тогда
		Возврат;
	КонецЕсли;
	
	Если Э_Лид.Статус = Перечисления.Э_СтатусыЛидов.Безперспективный или Э_Лид.ПометкаУдаления Тогда
