Процедура Э_ПриЗаписиСправочникЭ_ЛидыПриЗаписи(Источник, Отказ) Экспорт
	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;	
	
	Э_Лид = Источник.Ссылка;
	Э_НастройкиБинотел=Э_ТелефонияBinotel.Э_ПолучитьНастройкиБинотел();
	Если Э_НастройкиБинотел=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Э_Лид.Э_ДатаРегистрации >= Э_НастройкиБинотел.Э_BinotelДатаНачалаОбработкиЛидов Тогда 
		Э_СоздатьЗапланированноеСобытиеТелефонныйЗвонокАвтоматическиСогласноСтатусуЛида(Источник.Ссылка, Истина);
	КонецЕсли;
КонецПроцедуры

Процедура Э_СозданиеСобытийТелефонныйЗвонокПоСтатусамЛидов() Экспорт 
	
	Э_НастройкиБинотел=Э_ТелефонияBinotel.Э_ПолучитьНастройкиБинотел();
	Если Э_НастройкиБинотел=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
		
	Если Э_НастройкиБинотел<>Неопределено и (НЕ Э_НастройкиБинотел.Э_BinotelИспользоватьФункционалИнтеграции или Не Э_НастройкиБинотел.Э_BinotelСоздаватьЗапланированныеСобытияТелефонныйЗвонок) Тогда
	     Возврат;
	КонецЕсли;
	
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Э_Лиды.Ссылка
		|ИЗ
		|	Справочник.Э_Лиды КАК Э_Лиды
		|ГДЕ
		|	Э_Лиды.ПометкаУдаления = ЛОЖЬ
		|	И Э_Лиды.Закрыт = ЛОЖЬ
		|	И НЕ Э_Лиды.ЭтоГруппа
		|	И Э_Лиды.Э_ДатаРегистрации >= &ДатаНачалаОбработкиЛидов";
	
	Запрос.УстановитьПараметр("ДатаНачалаОбработкиЛидов", Э_НастройкиБинотел.Э_BinotelДатаНачалаОбработкиЛидов);	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Э_СоздатьЗапланированноеСобытиеТелефонныйЗвонокАвтоматическиСогласноСтатусуЛида(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
КонецПроцедуры

