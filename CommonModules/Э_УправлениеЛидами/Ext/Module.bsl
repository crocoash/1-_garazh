Процедура Э_ТелефонияПередЗаписьюПредЗаказаПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Если ЗначениеЗаполнено(Источник.Контрагент) и ТипЗнч(Источник.Контрагент)=тип("СправочникСсылка.Контрагенты") Тогда
	    КонтрагентВПредЗаказе=Источник.Контрагент;
		ИмяЗаказчика=СокрЛП(КонтрагентВПредЗаказе);
	иначе
	    КонтрагентВПредЗаказе=Неопределено;
		ИмяЗаказчика=СокрЛП(Источник.Контрагент);
	КонецЕсли;
	КонтрагентВПредЗаказе=?(ЗначениеЗаполнено(Источник.Контрагент) и ТипЗнч(Источник.Контрагент)=тип("СправочникСсылка.Контрагенты"),Источник.Контрагент,"");
	ТекЭ_Лид=Э_СоздатьНайтиЛид(Источник.Телефон,КонтрагентВПредЗаказе,ИмяЗаказчика,,,Источник.АдресДоставки,,Источник.Ответственный);
	Если Источник.Э_Лид<>ТекЭ_Лид Тогда
	    Источник.Э_Лид=ТекЭ_Лид;
	КонецЕсли;
КонецПроцедуры
