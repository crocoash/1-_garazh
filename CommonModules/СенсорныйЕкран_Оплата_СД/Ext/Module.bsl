// Оплата заказа с сенсорного экрана.
//
// Обвязка над Wayforpay_ОбщийМодуль_СД и менеджером ПлатежногоПорученияВходящего.
// Диалогов здесь нет намеренно: с оператором общается форма, модуль только читает
// и пишет данные и возвращает структуру с текстом для показа.
//
// Та же логика в форме документа ЗаказПокупателя (ПолучитьОплатуWayForPay);
// при правках держать обе стороны в согласии.

////////////////////////////////////////////////////////////////////////////////
// Данные заказа для формы оплаты

// Всё, что форме нужно показать по заказу. Пустая структура (Заказ не заполнен)
// возвращается с признаком Успешно = Ложь.
Функция ДанныеОплаты(ЗаказСсылка) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Номер", "");
	Результат.Вставить("Дата", '00010101');
	Результат.Вставить("Контрагент", "");
	Результат.Вставить("СуммаДокумента", 0);
	Результат.Вставить("СуммаПредоплаты", 0);
	Результат.Вставить("Подразделение", Справочники.Подразделения.ПустаяСсылка());
	Результат.Вставить("ЕстьНастройкаWayforpay", Ложь);
	Результат.Вставить("ЕстьНастройкаСМС", Ложь);
	Результат.Вставить("URLИнвойса", "");
	Результат.Вставить("URLИнвойсаПредоплата", "");
	Результат.Вставить("Телефон", "");
	Результат.Вставить("ТекстСМС", "");
	Результат.Вставить("idСМС", "");
	Результат.Вставить("СтатусСМС", "");
	Результат.Вставить("ФормаРасчета", Справочники.ФормыРасчета.ПустаяСсылка());
	Результат.Вставить("Оплачено", 0);
	Результат.Вставить("ОрганизацияМерчанта", Справочники.Организации.ПустаяСсылка());

	Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Результат.Сообщение = "Замовлення не передано.";
		Возврат Результат;
	КонецЕсли;

	Результат.Успешно                = Истина;
	Результат.Номер                  = СокрЛП(ЗаказСсылка.Номер);
	Результат.Дата                   = ЗаказСсылка.Дата;
	Результат.Контрагент             = Строка(ЗаказСсылка.Контрагент);
	Результат.СуммаДокумента         = ЗаказСсылка.СуммаДокумента;
	Результат.СуммаПредоплаты        = ЗаказСсылка.НП_ОплатаНаКарту;
	Результат.Подразделение          = ЗаказСсылка.Подразделение;
	Результат.URLИнвойса             = СокрЛП(ЗаказСсылка.Wayforpay_url_INVOICE);
	Результат.URLИнвойсаПредоплата   = СокрЛП(ЗаказСсылка.Wayforpay_url_INVOICE_предоплата);
	Результат.idСМС                  = СокрЛП(ЗаказСсылка.id_СМС_СД);
	Результат.СтатусСМС              = СокрЛП(Строка(ЗаказСсылка.Статус_СМС));
	Результат.ФормаРасчета           = ЗаказСсылка.ФормаРасчета;
	Результат.Телефон                = ТелефонДляСМС(ЗаказСсылка);
	Результат.ТекстСМС               = ТекстСМС(ЗаказСсылка);
	Результат.Оплачено               = СуммаОплатыПоЗаказу(ЗаказСсылка);

	Если ЗначениеЗаполнено(ЗаказСсылка.Подразделение) Тогда
		Результат.ЕстьНастройкаWayforpay =
			ЗначениеЗаполнено(ЗаказСсылка.Подразделение.Настройка_WayforpayСД);

		// Фирма мерчанта эквайринга: по ней подбирается форма расчёта, чтобы
		// заказ и деньги оказались на одной организации.
		Результат.ОрганизацияМерчанта =
			ЗаказСсылка.Подразделение.Настройка_WayforpayСД.Организация;
		Результат.ЕстьНастройкаСМС =
			ЗначениеЗаполнено(ЗаказСсылка.Подразделение.НастройкаТурбоСМС_СД);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Сколько уже поступило по заказу — сумма проведённых платёжных поручений.
//
// Считаем по документу-основанию, а не по инвойсу: деньги могут прийти и мимо
// терминала — загрузкой банковской выписки или руками менеджера, и оператору
// это одинаково важно видеть.
Функция СуммаОплатыПоЗаказу(ЗаказСсылка) Экспорт

	Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(ПлатежноеПоручениеВходящее.СуммаДокумента) КАК Сумма
		|ИЗ
		|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
		|ГДЕ
		|	НЕ ПлатежноеПоручениеВходящее.ПометкаУдаления
		|	И ПлатежноеПоручениеВходящее.Проведен
		|	И ПлатежноеПоручениеВходящее.ДокументОснование = &Заказ";

	Запрос.УстановитьПараметр("Заказ", ЗаказСсылка);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Сумма) Тогда
		Возврат Выборка.Сумма;
	КонецЕсли;

	Возврат 0;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Форма расчёта

// Форма расчёта для безнала, выбранная в этом подразделении в прошлый раз.
//
// Лежит в хранилище общих настроек, а не в реквизите: своих полей под это в
// метаданных нет, а спрашивать оператора на каждом заказе — то же самое, что
// не спрашивать вовсе, только дольше.
Функция ЗапомненнаяФормаРасчета(Подразделение) Экспорт

	Попытка
		Возврат ХранилищеОбщихНастроек.Загрузить(КлючХранилища(), КлючНастроекПодразделения(Подразделение));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура ЗапомнитьФормуРасчета(Подразделение, ФормаРасчета) Экспорт

	// Не смогли сохранить (нет права на настройки) — не беда: в следующий раз
	// просто спросим ещё раз.
	Попытка
		ХранилищеОбщихНастроек.Сохранить(КлючХранилища(), КлючНастроекПодразделения(Подразделение), ФормаРасчета);
	Исключение
	КонецПопытки;

КонецПроцедуры

Функция КлючХранилища()

	Возврат "СенсорныйЕкран_Оплата_СД";

КонецФункции

Функция КлючНастроекПодразделения(Подразделение)

	Если ЗначениеЗаполнено(Подразделение) Тогда
		Возврат "ФормаРасчетаБезнал_" + Строка(Подразделение.УникальныйИдентификатор());
	КонецЕсли;

	Возврат "ФормаРасчетаБезнал_Общая";

КонецФункции

// Формы расчёта, доступные подразделению оператора.
//
// Привязка живёт в табличной части СписокПодразделений — своего реквизита
// Подразделение у справочника нет. Элементы с пустым списком считаем общими:
// иначе у подразделения, которому ничего не назначено, выбора не будет вовсе.
Функция ФормыРасчетаПодразделения(Подразделение) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ФормыРасчета.Ссылка КАК Ссылка,
		|	ФормыРасчета.Наименование КАК Наименование,
		|	ФормыРасчета.Организация КАК Организация
		|ИЗ
		|	Справочник.ФормыРасчета КАК ФормыРасчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФормыРасчета.СписокПодразделений КАК ПодразделенияФормы
		|		ПО ФормыРасчета.Ссылка = ПодразделенияФормы.Ссылка
		|ГДЕ
		|	НЕ ФормыРасчета.ПометкаУдаления
		|	И (&ПодразделениеНеЗадано
		|		ИЛИ ПодразделенияФормы.Подразделение = &Подразделение
		|		ИЛИ ПодразделенияФормы.Подразделение ЕСТЬ NULL)
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";

	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("ПодразделениеНеЗадано", Не ЗначениеЗаполнено(Подразделение));

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Записать заказ с новой формой расчёта.
//
// Форма расчёта тянет за собой организацию (ИзменитьОрганизацию), а организация —
// префикс нумерации, поэтому после записи номер заказа меняется. Инвойс строится
// из номера, значит выставлять его можно только после этой записи.
Функция УстановитьФормуРасчета(ЗаказСсылка, ФормаРасчета) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Номер", "");

	Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Результат.Сообщение = "Замовлення не передано.";
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ФормаРасчета) Тогда
		Результат.Сообщение = "Не вказана форма розрахунку.";
		Возврат Результат;
	КонецЕсли;

	Попытка

		ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();

		МеняемФормуРасчета = (ЗаказОбъект.ФормаРасчета <> ФормаРасчета);

		Если МеняемФормуРасчета Тогда

			ЗаказОбъект.ФормаРасчета = ФормаРасчета;
			// Второй параметр — «изменилась форма расчёта»: только при нём типовая
			// процедура подставляет организацию и банковский счёт из формы расчёта.
			// С Ложь она молча ничего не делает.
			БП_ОбщийМодуль.ИзменитьОрганизацию(ЗаказОбъект, Истина, Истина, Истина);

		КонецЕсли;

		// Организация сменилась, а договор остался от прежней — платеж по такому
		// заказу не проводится: «Выбран договор контрагента, не соответствующий
		// организации, указанной в документе». Форма заказа зовет подбор договора
		// сразу за сменой организации (ФормаРасчетаПриИзменении), здесь то же
		// самое, с двумя отличиями:
		//   — подбор берет первый попавшийся договор пары «контрагент +
		//     организация», поэтому уже подходящий договор не трогаем;
		//   — проверяем и когда форма расчёта не менялась: заказы, записанные
		//     до этой правки, лежат с чужим договором, и повторный заход в
		//     «Безнал» их чинит.
		ДоговорПодобран = Ложь;

		Если Не ДоговорПодходитОрганизации(ЗаказОбъект) Тогда

			БП_ОбщийМодуль.ПоискСозданиеДоговора(
				ЗаказОбъект,
				ЗаказОбъект.Организация,
				ЗаказОбъект.Контрагент);

			// Подбор мог не найти и не создать договор (о причине он сообщает
			// сам). Записывать заказ в заведомо непроводимом состоянии незачем:
			// инвойс выставится, деньги спишутся, а платеж создать будет нельзя.
			Если Не ДоговорПодходитОрганизации(ЗаказОбъект) Тогда

				Результат.Сообщение =
					"Не вдалося підібрати договір контрагента «"
					+ Строка(ЗаказОбъект.Контрагент) + "» для організації «"
					+ Строка(ЗаказОбъект.Организация) + "». Форму розрахунку не змінено.";

				Возврат Результат;

			КонецЕсли;

			ДоговорПодобран = Истина;

		КонецЕсли;

		Если Не МеняемФормуРасчета И Не ДоговорПодобран Тогда
			Результат.Успешно = Истина;
			Результат.Номер = СокрЛП(ЗаказОбъект.Номер);
			Возврат Результат;
		КонецЕсли;

		Если МеняемФормуРасчета Тогда
			// Номер выдан под прежнюю организацию. Чистим его только если префикс
			// перестал совпадать; пустой номер платформа выдаст заново при записи.
			// Типовую МеханизмНумерацииОбъектов.СброситьУстановленныйКодНомерОбъекта
			// звать нельзя: на клиенте обычного приложения её ветка «#Если Клиент»
			// лезет в поле ввода номера, которого у нас нет, и падает.
			СброситьНомерПодОрганизацию(ЗаказОбъект);
		КонецЕсли;

		// Организация и счёт поменялись — движения пересчитываем: проведённый
		// заказ перепроводим, непроведённый просто пишем. Метка гасит выгрузку
		// на сайт, как и при создании заказа терминалом.
		ЗаказОбъект.ДополнительныеСвойства.Вставить("СенсорныйЕкран_НеОтправлятьНаСайт", Истина);
		ЗаказОбъект.Записать(?(ЗаказОбъект.Проведен,
			РежимЗаписиДокумента.Проведение,
			РежимЗаписиДокумента.Запись));

		Результат.Успешно = Истина;
		Результат.Номер = СокрЛП(ЗаказОбъект.Номер);

	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Сброс номера, выданного под прежнюю организацию, — серверная половина
// типовой СброситьУстановленныйКодНомерОбъекта, без её клиентской части
// (та обновляет подсказку поля ввода и требует элементы формы).
//
// Номер не трогаем, пока его префикс совпадает с префиксом организации:
// к номеру уже могут быть привязаны выставленные инвойсы WayForPay.
Процедура СброситьНомерПодОрганизацию(ЗаказОбъект)

	Префикс = "";

	Если ЗначениеЗаполнено(ЗаказОбъект.Организация) Тогда
		Префикс = ЗаказОбъект.Организация.Префикс;
	КонецЕсли;

	ОбщегоНазначения.ДобавитьПрефиксУзла(Префикс);

	Если ПустаяСтрока(Префикс)
		Или Лев(ЗаказОбъект.Номер, СтрДлина(Префикс)) <> Префикс Тогда

		ЗаказОбъект.Номер = "";

	КонецЕсли;

КонецПроцедуры

// Ту же пару «организация — договор» проверяет проведение платежного поручения
// входящего; несовпадение там кончается отказом в проведении.
Функция ДоговорПодходитОрганизации(ЗаказОбъект)

	Если Не ЗначениеЗаполнено(ЗаказОбъект.ДоговорКонтрагента) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ЗаказОбъект.ДоговорКонтрагента.Организация = ЗаказОбъект.Организация;

КонецФункции

// Организация нового заказа — из формы расчёта, а не из предзаказа.
//
// Заказ на сенсорном экране собирается копированием реквизитов предзаказа:
// организация оттуда, форма расчёта оттуда же. Но у формы расчёта в справочнике
// своя организация и свой расчётный счёт — деньги придут именно на них. Если
// организация предзаказа другая (у оператора в настройках одна фирма, а форма
// расчёта заведена на другую), заказ и платёж расходятся по фирмам, и платёжное
// поручение по такому заказу не проводится.
//
// Зовётся ДО записи заказа, объектом. Номер сбрасывать не нужно: документ ещё
// не записан, платформа выдаст его под уже правильную организацию.
//
// Параметры:
//   ЗаказОбъект - ДокументОбъект.ЗаказПокупателя;
//   ЭтоЮрЛицо   - Булево - у юрлиц НДС выставляется отдельной веткой формы,
//                 признак «сумма включает НДС» тогда не трогаем.
//
// Возвращаемое значение:
//   Структура - Успешно, Сообщение, ОрганизацияИзменена.
//
Функция ПрименитьОрганизациюФормыРасчета(ЗаказОбъект, ЭтоЮрЛицо = Ложь) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("ОрганизацияИзменена", Ложь);

	Если ЗаказОбъект = Неопределено Тогда
		Результат.Сообщение = "Замовлення не передано.";
		Возврат Результат;
	КонецЕсли;

	// Формы расчёта нет или она без организации — оставляем как было:
	// организация предзаказа хотя бы не пустая.
	Если Не ЗначениеЗаполнено(ЗаказОбъект.ФормаРасчета)
		Или Не ЗначениеЗаполнено(ЗаказОбъект.ФормаРасчета.Организация) Тогда

		Результат.Успешно = Истина;
		Возврат Результат;

	КонецЕсли;

	ОрганизацияДо = ЗаказОбъект.Организация;

	// Второй параметр — «изменилась форма расчёта»: только при нём типовая
	// процедура подставляет организацию и банковский счёт из формы расчёта.
	// С Ложь она для заказа покупателя не делает вообще ничего.
	БП_ОбщийМодуль.ИзменитьОрганизацию(ЗаказОбъект, Истина, Истина, Истина);

	Результат.ОрганизацияИзменена = (ЗаказОбъект.Организация <> ОрганизацияДо);

	Если Не Результат.ОрганизацияИзменена Тогда
		Результат.Успешно = Истина;
		Возврат Результат;
	КонецЕсли;

	// Признак «сумма включает НДС» был взят от организации предзаказа.
	// У юрлиц форма выставляет его сама, туда не лезем.
	Если Не ЭтоЮрЛицо Тогда
		ЗаказОбъект.СуммаВключаетНДС = ЗаказОбъект.Организация.СуммаВключаетНДС;
	КонецЕсли;

	// Договор остался от прежней организации — с ним заказ непроводим.
	// ПоискСозданиеДоговора берёт первый договор пары «контрагент + организация»,
	// а если такого нет — создаёт его, поэтому подходящий договор не трогаем.
	Если Не ДоговорПодходитОрганизации(ЗаказОбъект) Тогда

		БП_ОбщийМодуль.ПоискСозданиеДоговора(
			ЗаказОбъект,
			ЗаказОбъект.Организация,
			ЗаказОбъект.Контрагент);

		Если Не ДоговорПодходитОрганизации(ЗаказОбъект) Тогда

			Результат.Сообщение =
				"Не вдалося підібрати договір контрагента «"
				+ Строка(ЗаказОбъект.Контрагент) + "» для організації «"
				+ Строка(ЗаказОбъект.Организация) + "».";

			ЗаписьЖурналаРегистрации(
				"СенсорныйЕкран.ФормаРасчета",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				Результат.Сообщение);

			Возврат Результат;

		КонецЕсли;

	КонецЕсли;

	Результат.Успешно = Истина;

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Инвойс WayForPay

Функция СоздатьИнвойс(ЗаказСсылка, Предоплата = Ложь, Сумма = 0) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("URLИнвойса", "");

	// Отказ до записи заказа: тот же запрет стоит и в Wayforpay_ОбщийМодуль_СД,
	// но там он срабатывает уже после того, как счётчик инвойсов увеличен.
	Если ЗначениеЗаполнено(ЗаказСсылка)
		И Wayforpay_ОбщийМодуль_СД.ЭквайрингЗапрещен(ЗаказСсылка.ФормаРасчета) Тогда

		Результат.Сообщение = Wayforpay_ОбщийМодуль_СД.ТекстЗапретаЭквайринга(ЗаказСсылка.ФормаРасчета);
		Возврат Результат;
	КонецЕсли;

	НастройкаWayforpay = НастройкаWayforpay(ЗаказСсылка);
	Если Не ЗначениеЗаполнено(НастройкаWayforpay) Тогда
		Результат.Сообщение = "У підрозділі не вказано налаштування Wayforpay.";
		Возврат Результат;
	КонецЕсли;

	СуммаИнвойса = ?(Сумма = 0, ЗаказСсылка.СуммаДокумента, Сумма);
	Если СуммаИнвойса <= 0 Тогда
		Результат.Сообщение = "Сума оплати не вказана.";
		Возврат Результат;
	КонецЕсли;

	Попытка

		ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();

		НомерИнвойса = ЗаказОбъект.КоличествоИнвойсов_Wayforpay + 1;
		OrderReference = СокрЛП(ЗаказОбъект.Номер) + "_" + Строка(НомерИнвойса);

		Если Предоплата Тогда
			ЗаказОбъект.НП_ОплатаНаКарту = СуммаИнвойса;
		КонецЕсли;

		Рез = Wayforpay_ОбщийМодуль_СД.СоздатьИнвойс(
			НастройкаWayforpay,
			ЗаказОбъект,
			OrderReference,
			СуммаИнвойса,
			Предоплата);

		// Счётчик растёт и на неудаче — так делает форма заказа: номер, ушедший
		// в WayForPay, повторно использовать нельзя, даже если ответ не дошёл.
		ЗаказОбъект.КоличествоИнвойсов_Wayforpay = НомерИнвойса;

		Если Рез.Успешно Тогда

			Если Предоплата Тогда
				ЗаказОбъект.Wayforpay_url_INVOICE_предоплата = Рез.invoiceUrl;
				ЗаказОбъект.НомерИнвойсПредоплата_Wayforpay = НомерИнвойса;
			Иначе
				ЗаказОбъект.Wayforpay_url_INVOICE = Рез.invoiceUrl;
				ЗаказОбъект.НомерИнвойсПолнаяОплата_Wayforpay = НомерИнвойса;
			КонецЕсли;

			Результат.Успешно = Истина;
			Результат.URLИнвойса = Рез.invoiceUrl;

		Иначе
			Результат.Сообщение = "Не вдалося сформувати інвойс. " + Рез.Сообщение;
		КонецЕсли;

		ЗаказОбъект.Записать();

	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция УдалитьИнвойс(ЗаказСсылка, Предоплата = Ложь) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Сообщение", "");

	НастройкаWayforpay = НастройкаWayforpay(ЗаказСсылка);
	Если Не ЗначениеЗаполнено(НастройкаWayforpay) Тогда
		Результат.Сообщение = "У підрозділі не вказано налаштування Wayforpay.";
		Возврат Результат;
	КонецЕсли;

	URLИнвойса = ?(Предоплата,
		СокрЛП(ЗаказСсылка.Wayforpay_url_INVOICE_предоплата),
		СокрЛП(ЗаказСсылка.Wayforpay_url_INVOICE));

	Если ПустаяСтрока(URLИнвойса) Тогда
		Результат.Сообщение = "Інвойс не створено.";
		Возврат Результат;
	КонецЕсли;

	Попытка

		ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();

		OrderReference = OrderReferenceИнвойса(ЗаказСсылка, НомерИнвойса(ЗаказСсылка, Предоплата));

		Рез = Wayforpay_ОбщийМодуль_СД.УдалитьИнвойс(
			НастройкаWayforpay,
			ЗаказОбъект,
			OrderReference);

		Если Рез.Успешно Тогда

			Если Предоплата Тогда
				ЗаказОбъект.Wayforpay_url_INVOICE_предоплата = "";
			Иначе
				ЗаказОбъект.Wayforpay_url_INVOICE = "";
			КонецЕсли;

			ЗаказОбъект.Записать();

			Результат.Успешно = Истина;
			Результат.Сообщение = "Інвойс видалено.";

		Иначе
			Результат.Сообщение = "Не вдалося видалити інвойс. " + Рез.Сообщение;
		КонецЕсли;

	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Спросить статус оплаты и, если деньги пришли, завести платёжное поручение.
//
// Статус спрашивается по всем инвойсам заказа, а не только по последнему:
// клиент мог оплатить первый, пока оператор выставлял второй.
Функция ПолучитьОплату(ЗаказСсылка, Предоплата = Ложь) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("СтатусОплаты", "");
	Результат.Вставить("КодОтвета", 0);
	Результат.Вставить("Оплачено", Ложь);
	Результат.Вставить("СсылкаППВ", Неопределено);
	Результат.Вставить("ППВСоздано", Ложь);
	Результат.Вставить("ППВСуществовало", Ложь);

	НастройкаWayforpay = НастройкаWayforpay(ЗаказСсылка);
	Если Не ЗначениеЗаполнено(НастройкаWayforpay) Тогда
		Результат.Сообщение = "У підрозділі не вказано налаштування Wayforpay.";
		Возврат Результат;
	КонецЕсли;

	URLИнвойса = ?(Предоплата,
		СокрЛП(ЗаказСсылка.Wayforpay_url_INVOICE_предоплата),
		СокрЛП(ЗаказСсылка.Wayforpay_url_INVOICE));

	Если ПустаяСтрока(URLИнвойса) Тогда
		Результат.Сообщение = "Інвойс не створено.";
		Возврат Результат;
	КонецЕсли;

	Рез = Неопределено;

	Для Каждого OrderReference Из OrderReferenceКандидаты(ЗаказСсылка, НомерИнвойса(ЗаказСсылка, Предоплата)) Цикл

		Ответ = Wayforpay_ОбщийМодуль_СД.ПолучитьСтатусИнвойса(НастройкаWayforpay, OrderReference);

		Если Рез = Неопределено Или (Ответ.Успешно И Не Рез.Успешно) Тогда
			Рез = Ответ;
		КонецЕсли;

		Если Ответ.Успешно И Ответ.СтатусОплаты = "Approved" Тогда
			Рез = Ответ;
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если Рез = Неопределено Тогда
		Результат.Сообщение = "Не визначено номер інвойсу замовлення.";
		Возврат Результат;
	КонецЕсли;

	Если Рез.Свойство("КодОтвета") Тогда
		Результат.КодОтвета = Рез.КодОтвета;
	КонецЕсли;

	Если Рез.Свойство("СтатусОплаты") Тогда
		Результат.СтатусОплаты = Рез.СтатусОплаты;
	КонецЕсли;

	Если Не Рез.Успешно Тогда
		Результат.Сообщение = "Не вдалося отримати статус оплати. " + Рез.Сообщение;
		Возврат Результат;
	КонецЕсли;

	Если Рез.СтатусОплаты <> "Approved" Тогда
		Результат.Успешно = Истина;
		Результат.Сообщение = "Інвойс не оплачено. Статус: " + Рез.СтатусОплаты;
		Возврат Результат;
	КонецЕсли;

	Результат.Оплачено = Истина;

	// Деньги пришли. Сначала ищем уже заведённое ППВ — иначе на повторное
	// нажатие «Перевірити статус» создастся второй платёж на ту же сумму.
	СсылкаППВ = НайтиПлатеж(ЗаказСсылка, Рез);

	Если ЗначениеЗаполнено(СсылкаППВ) Тогда
		Результат.Успешно = Истина;
		Результат.СсылкаППВ = СсылкаППВ;
		Результат.ППВСуществовало = Истина;
		Результат.Сообщение = "Оплачено. Платіжне доручення вже створено: " + Строка(СсылкаППВ);
		Возврат Результат;
	КонецЕсли;

	РезультатСоздания = Документы.ПлатежноеПоручениеВходящее.СоздатьПлатежноеПоручениеWayForPay(
		ЗаказСсылка,
		Рез,
		ДатаПлатежа(Рез));

	Если Не РезультатСоздания.Успешно Тогда
		Результат.Сообщение = "Оплачено, але не вдалося створити платіжне доручення. "
			+ РезультатСоздания.Сообщение;
		Возврат Результат;
	КонецЕсли;

	Результат.Успешно = Истина;
	Результат.ППВСоздано = Истина;

	Если РезультатСоздания.Свойство("Ссылка") Тогда
		Результат.СсылкаППВ = РезультатСоздания.Ссылка;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Результат.СсылкаППВ) Тогда
		Результат.СсылкаППВ = НайтиПлатеж(ЗаказСсылка, Рез);
	КонецЕсли;

	Результат.Сообщение = "Оплачено. Платіжне доручення створено";
	Если ЗначениеЗаполнено(Результат.СсылкаППВ) Тогда
		Результат.Сообщение = Результат.Сообщение + ": " + Строка(Результат.СсылкаППВ);
	КонецЕсли;

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// QR

// PNG с QR-кодом ссылки на оплату, положенный во временное хранилище формы.
// Картинку рисует тот же механизм, что и QR НБУ (менеджер БанковскихСчетов).
Функция АдресКартинкиQR(СтрокаДляQR, УникальныйИдентификаторФормы, Размер = "400x400") Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Адрес", "");

	Если ПустаяСтрока(СокрЛП(СтрокаДляQR)) Тогда
		Результат.Сообщение = "Інвойс не створено, немає що показувати.";
		Возврат Результат;
	КонецЕсли;

	ДвоичныеДанные = Справочники.БанковскиеСчета.NBU_QR_ПолучитьPNGПоСтроке(
		СокрЛП(СтрокаДляQR),
		Размер);

	Если ДвоичныеДанные = Неопределено Тогда
		Результат.Сообщение = "Не вдалося отримати QR-код. Перевірте інтернет на терміналі.";
		Возврат Результат;
	КонецЕсли;

	Результат.Успешно = Истина;
	Результат.Адрес = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификаторФормы);

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СМС

Функция ОтправитьСМС(ЗаказСсылка, Телефон, Текст) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("idСМС", "");

	Если Не ЗначениеЗаполнено(ЗаказСсылка.Подразделение)
		Или Не ЗначениеЗаполнено(ЗаказСсылка.Подразделение.НастройкаТурбоСМС_СД) Тогда

		Результат.Сообщение = "У підрозділі не вказано налаштування відправки SMS.";
		Возврат Результат;
	КонецЕсли;

	ТелефонПолучателя = НормализоватьТелефон(Телефон);

	Если СтрДлина(ТелефонПолучателя) <> 12 Тогда
		Результат.Сообщение = "Невірно вказано номер телефону: " + СокрЛП(Строка(Телефон));
		Возврат Результат;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Результат.Сообщение = "Текст SMS не заповнено.";
		Возврат Результат;
	КонецЕсли;

	Попытка

		Рез = ТурбоСМС_ОбщийМодуль_СД.ОтправитьСообщение(
			ЗаказСсылка.Подразделение.НастройкаТурбоСМС_СД,
			ТелефонПолучателя,
			Текст);

		Если Рез.Успешно Тогда

			ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
			ЗаказОбъект.id_СМС_СД = Рез.message_id;
			ЗаказОбъект.НП_ТелефонПолучателя = ТелефонПолучателя;
			ЗаказОбъект.ТекстДляОтправкиСМС = Текст;
			ЗаказОбъект.Записать();

			Результат.Успешно = Истина;
			Результат.idСМС = Рез.message_id;
			Результат.Сообщение = "SMS відправлено.";

		Иначе
			Результат.Сообщение = "Не вдалося відправити SMS. " + Рез.Сообщение;
		КонецЕсли;

	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;

КонецФункции

Функция ТекстСМС(ЗаказСсылка) Экспорт

	Шаблон = ЗаказСсылка.ШаблонСМС;

	Если Не ЗначениеЗаполнено(Шаблон)
		И ЗначениеЗаполнено(ЗаказСсылка.Подразделение) Тогда

		Шаблон = ЗаказСсылка.Подразделение.ШаблонСМС_ПоУмолчанию;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Шаблон) Тогда
		Возврат СокрЛП(ЗаказСсылка.ТекстДляОтправкиСМС);
	КонецЕсли;

	Попытка
		Возврат ТурбоСМС_ОбщийМодуль_СД.ПолучитьТекстСМС(Шаблон, ЗаказСсылка);
	Исключение
		Возврат СокрЛП(ЗаказСсылка.ТекстДляОтправкиСМС);
	КонецПопытки;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Служебные

Функция НастройкаWayforpay(ЗаказСсылка)

	Если Не ЗначениеЗаполнено(ЗаказСсылка) Или Не ЗначениеЗаполнено(ЗаказСсылка.Подразделение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЗаказСсылка.Подразделение.Настройка_WayforpayСД;

КонецФункции

Функция НомерИнвойса(ЗаказСсылка, Предоплата)

	Возврат ?(Предоплата,
		ЗаказСсылка.НомерИнвойсПредоплата_Wayforpay,
		ЗаказСсылка.НомерИнвойсПолнаяОплата_Wayforpay);

КонецФункции

Функция OrderReferenceИнвойса(ЗаказСсылка, НомерИнвойса)

	OrderReferenceПоНомеру = СокрЛП(ЗаказСсылка.Номер) + "_" + Строка(НомерИнвойса);

	Возврат Wayforpay_ОбщийМодуль_СД.OrderReferenceПоЗаказу(
		ЗаказСсылка,
		НомерИнвойса,
		OrderReferenceПоНомеру);

КонецФункции

Функция OrderReferenceКандидаты(ЗаказСсылка, НомерИнвойса)

	Кандидаты = Новый Массив;
	Кандидаты.Добавить(OrderReferenceИнвойса(ЗаказСсылка, НомерИнвойса));

	Для Каждого Значение Из Wayforpay_ОбщийМодуль_СД.OrderReferenceСписокПоЗаказу(ЗаказСсылка) Цикл
		Если Кандидаты.Найти(Значение) = Неопределено Тогда
			Кандидаты.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Кандидаты;

КонецФункции

// processingDate приходит unix-временем.
Функция ДатаПлатежа(Рез)

	Если ЗначениеЗаполнено(Рез.ДатаОплаты) И Рез.ДатаОплаты <> 0 Тогда
		Возврат Дата(1970, 1, 1, 0, 0, 0) + Рез.ДатаОплаты + 3 * 60 * 60;
	КонецЕсли;

	Возврат ТекущаяДата();

КонецФункции

// Ищем обоими ключами: «заказ + AuthCode» и входящий номер (= orderReference).
// Одного AuthCode мало: платёж из банковской выписки несёт код своей транзакции.
Функция НайтиПлатеж(ЗаказСсылка, Рез)

	Платеж = Документы.ПлатежноеПоручениеВходящее.ОписаниеПлатежаПоЗаказу();

	Платеж.Сумма       = Рез.Сумма;
	Платеж.ДатаПлатежа = ДатаПлатежа(Рез);
	Платеж.AuthCode    = Рез.AuthCode;

	OrderReference = СокрЛП(Строка(Рез.НомерЗаказа));

	Если Не ПустаяСтрока(OrderReference) И СтрДлина(OrderReference) <= 30 Тогда
		Платеж.НомерВходящегоДокумента = OrderReference;
	КонецЕсли;

	Возврат Документы.ПлатежноеПоручениеВходящее.НайтиПлатежПоЗаказу(ЗаказСсылка, Платеж);

КонецФункции

Функция ТелефонДляСМС(ЗаказСсылка)

	Телефон = НормализоватьТелефон(ЗаказСсылка.НП_ТелефонПолучателя);

	Если СтрДлина(Телефон) <> 12 Тогда
		Телефон = НормализоватьТелефон(ЗаказСсылка.Телефон);
	КонецЕсли;

	Возврат Телефон;

КонецФункции

// «(067) 123-45-67», «067 123 45 67», «+380671234567» → «380671234567».
Функция НормализоватьТелефон(Знач Телефон) Экспорт

	Исходная = СокрЛП(Строка(Телефон));
	ТолькоЦифры = "";

	Для Номер = 1 По СтрДлина(Исходная) Цикл
		Символ = Сред(Исходная, Номер, 1);
		Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 Тогда
			ТолькоЦифры = ТолькоЦифры + Символ;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(ТолькоЦифры) = 10 И Лев(ТолькоЦифры, 1) = "0" Тогда
		Возврат "38" + ТолькоЦифры;
	КонецЕсли;

	Если СтрДлина(ТолькоЦифры) = 9 Тогда
		Возврат "380" + ТолькоЦифры;
	КонецЕсли;

	Возврат ТолькоЦифры;

КонецФункции
