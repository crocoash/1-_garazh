//+БП: @Cvet_kov (28.08.2026) <>
// Возвращает приоритет "Б/Н" из справочника БП_Приоритеты.
//
// Предопределённых элементов у справочника нет — приоритеты заводятся руками,
// поэтому опознаём по коду (000000001): наименование правят, код нет.
// Элемента с таким кодом нет — возвращается пустая ссылка, приоритет
// выбирается вручную как раньше.
//
Функция ПриоритетБезналичный() Экспорт

	Возврат Справочники.БП_Приоритеты.НайтиПоКоду("000000001");

КонецФункции

// Подставляет приоритет "Б/Н" в заказ поставщику, если приоритет ещё не выбран.
// Осознанный выбор пользователя не перебивается.
//
Процедура ЗаполнитьПриоритетБезналичный(ЗаказПоставщикуОбъект) Экспорт

	Если ЗначениеЗаполнено(ЗаказПоставщикуОбъект.БП_Приоритет) Тогда
		Возврат;
	КонецЕсли;

	ЗаказПоставщикуОбъект.БП_Приоритет = ПриоритетБезналичный();

КонецПроцедуры
//-БП: @Cvet_kov (28.08.2026) <>

//+БП: @Cvet_kov (30.08.2026) <>
// Заказ поставщику, созданный из заказа покупателя кнопкой "Сформировать заказ поставщику",
// приезжал без договора: колонка ДоговорКонтрагента в строке заказа покупателя чаще всего
// пустая, а валюта документа берётся как раз из неё. Договор приходилось подтягивать вручную,
// перевыбирая контрагента в уже открытом заказе, и типовой ПриИзмененииЗначенияДоговора
// спрашивал про пересчёт по договору и открывал форму "Цены и валюта".
//
// Здесь то же самое делается под капотом: договор подбирается, а если подходящего нет -
// создаётся (так же, как ПоискСозданиеДоговора делает для покупателей), после чего валюта,
// курс и кратность взаиморасчётов синхронизируются с договором.
//
// Вызывать ПОСЛЕ того, как окончательно определена организация: её подменяет автозамена
// по справочнику БП_НастройкиАвтозаменыОрганизацииВЗаказеПоставщику, а договор привязан
// к организации.
//
// Цены табличных частей не пересчитываются: они скопированы из заказа покупателя
// (колонка ЦенаПокупки) и остаются как есть - как и до правки.
//
Процедура ЗаполнитьДоговорПоставщикаИВалюту(ЗаказПоставщикуОбъект) Экспорт

	Если НЕ ЗначениеЗаполнено(ЗаказПоставщикуОбъект.Контрагент)
		ИЛИ НЕ ЗначениеЗаполнено(ЗаказПоставщикуОбъект.Организация) Тогда
		Возврат;
	КонецЕсли;

	ПараметрыДоговора = ПараметрыДоговораЗаказаПоставщику();

	// договор, приехавший из строки заказа покупателя, может быть чужим: не той организации
	// (её подменяет автозамена), не того контрагента или не того вида
	Если НЕ ЗаполнениеДокументов.МожноИспользоватьДоговорДляДокумента(
				ЗаказПоставщикуОбъект.ДоговорКонтрагента,
				ЗаказПоставщикуОбъект.Контрагент,
				ЗаказПоставщикуОбъект.Организация,
				ПараметрыДоговора) Тогда

		Договор = НайтиДоговорПоставщика(ЗаказПоставщикуОбъект.Организация, ЗаказПоставщикуОбъект.Контрагент);

		Если НЕ ЗначениеЗаполнено(Договор) Тогда
			Договор = СоздатьДоговорПоставщика(ЗаказПоставщикуОбъект.Организация, ЗаказПоставщикуОбъект.Контрагент);
		КонецЕсли;

		ЗаказПоставщикуОбъект.ДоговорКонтрагента = Договор;

	КонецЕсли;

	СинхронизироватьВзаиморасчетыСДоговором(ЗаказПоставщикуОбъект);

КонецПроцедуры

// Параметры отбора договора для заказа поставщику - те же, что документ держит
// в мСтруктураПараметровДляПолученияДоговора: договоры покупки, взаиморасчёты
// по договору в целом или по заказам.
//
Функция ПараметрыДоговораЗаказаПоставщику()

	Параметры = ЗаполнениеДокументов.ПолучитьСтруктуруПараметровДляПолученияДоговораПокупки();

	СписокВзаиморасчетов = Новый СписокЗначений();
	СписокВзаиморасчетов.Добавить(Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом);
	СписокВзаиморасчетов.Добавить(Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоЗаказам);
	Параметры.Вставить("СписокДопустимыхВидовВзаиморасчетов", СписокВзаиморасчетов);

	Возврат Параметры;

КонецФункции

// Ищет договор поставщика по паре "организация + контрагент".
// Порядок отбора задан явно, чтобы выбор не зависел от порядка записей в базе:
// сначала основной договор контрагента, затем договоры с поставщиком (а не с комитентом),
// дальше по наименованию.
//
Функция НайтиДоговорПоставщика(Организация, Контрагент)

	УстановитьПривилегированныйРежим(Истина);

	ВидыДоговоров = Новый Массив();
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	ВидыДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СКомитентом);

	ВидыВзаиморасчетов = Новый Массив();
	ВидыВзаиморасчетов.Добавить(Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом);
	ВидыВзаиморасчетов.Добавить(Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоЗаказам);

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ДоговорыКонтрагентов.Ссылка КАК Договор
	                      |ИЗ
	                      |	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	                      |ГДЕ
	                      |	ДоговорыКонтрагентов.Владелец = &Контрагент
	                      |	И ДоговорыКонтрагентов.Организация = &Организация
	                      |	И НЕ ДоговорыКонтрагентов.ПометкаУдаления
	                      |	И НЕ ДоговорыКонтрагентов.ЭтоГруппа
	                      |	И ДоговорыКонтрагентов.ВидДоговора В (&ВидыДоговоров)
	                      |	И ДоговорыКонтрагентов.ВедениеВзаиморасчетов В (&ВидыВзаиморасчетов)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ВЫБОР
	                      |		КОГДА ДоговорыКонтрагентов.Ссылка = &ОсновнойДоговор
	                      |			ТОГДА 0
	                      |		ИНАЧЕ 1
	                      |	КОНЕЦ,
	                      |	ВЫБОР
	                      |		КОГДА ДоговорыКонтрагентов.ВидДоговора = &ВидСПоставщиком
	                      |			ТОГДА 0
	                      |		ИНАЧЕ 1
	                      |	КОНЕЦ,
	                      |	ДоговорыКонтрагентов.Наименование");

	Запрос.УстановитьПараметр("Контрагент",         Контрагент);
	Запрос.УстановитьПараметр("Организация",        Организация);
	Запрос.УстановитьПараметр("ВидыДоговоров",      ВидыДоговоров);
	Запрос.УстановитьПараметр("ВидыВзаиморасчетов", ВидыВзаиморасчетов);
	Запрос.УстановитьПараметр("ОсновнойДоговор",    Контрагент.ОсновнойДоговорКонтрагента);
	Запрос.УстановитьПараметр("ВидСПоставщиком",    Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);

	Выборка = Запрос.Выполнить().Выбрать();

	УстановитьПривилегированныйРежим(Ложь);

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Договор;
	КонецЕсли;

	Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();

КонецФункции

// Создаёт договор с поставщиком - по образцу ПоискСозданиеДоговора, который делает
// то же самое для договоров с покупателем.
//
Функция СоздатьДоговорПоставщика(Организация, Контрагент)

	УстановитьПривилегированныйРежим(Истина);

	НовыйДоговор                       = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	НовыйДоговор.Наименование          = НСтр("ru='Основной договор с поставщиком';uk='Основний договір з постачальником'");
	НовыйДоговор.Владелец              = Контрагент;
	НовыйДоговор.Организация           = Организация;
	НовыйДоговор.ВидДоговора           = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
	НовыйДоговор.ВидУсловийДоговора    = Перечисления.ВидыУсловийДоговоровВзаиморасчетов.БезДополнительныхУсловий;
	НовыйДоговор.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоЗаказам;
	НовыйДоговор.БП_ТипДоговора        = Справочники.БП_ТипыДоговоровКонтрагентов.Стандартный;
	НовыйДоговор.ТипЦен                = Справочники.ТипыЦенНоменклатурыКонтрагентов.ПустаяСсылка();

	НовыйДоговор.ВалютаВзаиморасчетов = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "ОсновнаяВалютаВзаиморасчетов");
	Если НЕ ЗначениеЗаполнено(НовыйДоговор.ВалютаВзаиморасчетов) Тогда
		НовыйДоговор.ВалютаВзаиморасчетов = глЗначениеПеременной("ВалютаРегламентированногоУчета");
	КонецЕсли;

	Если Контрагент.НеЯвляетсяРезидентом Тогда
		НовыйДоговор.Внешнеэкономический = Истина;
		Если НовыйДоговор.ВалютаВзаиморасчетов = глЗначениеПеременной("ВалютаРегламентированногоУчета") Тогда
			НовыйДоговор.ВалютаВзаиморасчетов = глЗначениеПеременной("ВалютаУправленческогоУчета");
		КонецЕсли;
	КонецЕсли;

	НовыйДоговор.УстановитьСхемуНалогообложения();
	НовыйДоговор.СхемаНалоговогоУчетаПоТаре = Справочники.СхемыНалоговогоУчетаПоДоговорамКонтрагентов.ПоПервомуСобытию;
	НовыйДоговор.ВыводитьИнформациюОСделкеПриПечатиДокументов = Истина;
	НовыйДоговор.Комментарий = "#Створено автоматично!";

	Попытка
		НовыйДоговор.Записать();
		Сообщить("Успішно створено новий договір з постачальником!");
		Результат = НовыйДоговор.Ссылка;
	Исключение
		Сообщить("Не вдалося створити договір з постачальником! " + ОписаниеОшибки());
		Результат = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецПопытки;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

// Валюта, курс и кратность взаиморасчётов - из договора. Без этого форма заказа
// поставщику при первом же изменении контрагента или договора спрашивает
// "Пересчитать документ в соответствии с договором?" и открывает "Цены и валюта".
//
Процедура СинхронизироватьВзаиморасчетыСДоговором(ЗаказПоставщикуОбъект)

	Договор = ЗаказПоставщикуОбъект.ДоговорКонтрагента;

	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Договор.ВалютаВзаиморасчетов) Тогда
		ЗаказПоставщикуОбъект.ВалютаДокумента = Договор.ВалютаВзаиморасчетов;
		СтруктураКурса = МодульВалютногоУчета.ПолучитьКурсВалюты(Договор.ВалютаВзаиморасчетов, ЗаказПоставщикуОбъект.Дата);
		ЗаказПоставщикуОбъект.КурсВзаиморасчетов      = СтруктураКурса.Курс;
		ЗаказПоставщикуОбъект.КратностьВзаиморасчетов = СтруктураКурса.Кратность;
	КонецЕсли;

	// Тип цен - тоже часть параметров договора; сами цены при этом не пересчитываются.
	// Тип проверяем: у договора ТипЦен может быть и ТипыЦенНоменклатуры (у договоров
	// с покупателем), а реквизит заказа поставщику принимает только цены контрагентов.
	Если НЕ ЗначениеЗаполнено(ЗаказПоставщикуОбъект.ТипЦен)
		И ЗначениеЗаполнено(Договор.ТипЦен)
		И ТипЗнч(Договор.ТипЦен) = Тип("СправочникСсылка.ТипыЦенНоменклатурыКонтрагентов") Тогда
		ЗаказПоставщикуОбъект.ТипЦен = Договор.ТипЦен;
	КонецЕсли;

КонецПроцедуры
//-БП: @Cvet_kov (30.08.2026) <>
