Процедура БП_ПерепроведениеРеализацииПоХронологии() Экспорт
	//+БП: bsoft (10.11.2025) <> 
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	БП_ДокументыДляПерепроведения.Документ
	                      |ИЗ
	                      |	РегистрСведений.БП_ДокументыДляПерепроведения КАК БП_ДокументыДляПерепроведения
	                      |ГДЕ
	                      |	НЕ БП_ДокументыДляПерепроведения.Проведено");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() цикл
		
		РеализацияТоваровУслуг = Выборка.Документ; 
		ЗаказПокупателя = Выборка.Документ.Сделка;
		
		МассивЗаказовПоставщику = Новый Массив;
		ТЗ_Док_НеНашСклад = Новый ТаблицаЗначений;
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	ЗаказПоставщику.Ссылка
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|ГДЕ
		|	ЗаказПоставщику.Проведен 
		|	И ЗаказПоставщику.ДокументОснование = &ДокументОснование 
		|	И ЗаказПоставщику.БП_ВидЗаказаПоставщику = &БП_ВидЗаказаПоставщику
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПоставщику.Ссылка");
			
		Запрос.УстановитьПараметр("ДокументОснование", ЗаказПокупателя); 
		Запрос.УстановитьПараметр("БП_ВидЗаказаПоставщику", Перечисления.БП_ВидЗаказаПоставщику.Менеджер);
		
		Выборка1 = Запрос.Выполнить().Выбрать();
		
		Пока Выборка1.Следующий() цикл
			МассивЗаказовПоставщику.Добавить(Выборка1.Ссылка);	
		КонецЦикла;                          
		
		Если МассивЗаказовПоставщику.Количество() тогда
			// якщо є замовлення постачальнику то склад НЕ наш
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	ПоступлениеТоваровУслуг.Ссылка КАК ПоступлениеТоваровУслуг,
			|	ПоступлениеТоваровУслуг.Сделка КАК ЗаказПоставщику
			|ИЗ
			|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
			|ГДЕ
			|	ПоступлениеТоваровУслуг.Сделка В(&Сделка)
			|	И ПоступлениеТоваровУслуг.Проведен");
			
			Запрос.УстановитьПараметр("Сделка", МассивЗаказовПоставщику); 
			
			ТЗ_Док_НеНашСклад = Запрос.Выполнить().Выгрузить();
		КонецЕсли; 
		
		
		МассивПеремещенийТоваров = Новый Массив;
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	ПеремещениеТоваров.Ссылка
		|ИЗ
		|	Документ.ПеремещениеТоваров КАК ПеремещениеТоваров
		|ГДЕ
		|	ПеремещениеТоваров.ВнутреннийЗаказ = &ЗаказПокупателя
		|	И ПеремещениеТоваров.Проведен");
		
		Запрос.УстановитьПараметр("ЗаказПокупателя", ЗаказПокупателя); 
		
		Выборка1 = Запрос.Выполнить().Выбрать();
		
		Пока Выборка1.Следующий() цикл
			//ПеремещениеТоваров = Выборка.Ссылка;
			МассивПеремещенийТоваров.Добавить(Выборка1.Ссылка);
		КонецЦикла; 
		
		
		//--------------------------- Алгоритм проверки  
		
		Попытка
			
			ХронологияНарушена = Ложь; 
			МаксДатаЗаказовПоставщику = Дата("00010101");	
			Для каждого Стр из МассивЗаказовПоставщику цикл
				Если Стр.Дата > МаксДатаЗаказовПоставщику тогда
					МаксДатаЗаказовПоставщику = Стр.Дата;          
				КонецЕсли;
			КонецЦикла;
			
			
			МаксДатаПоступления = Дата("00010101");	
			Для каждого Стр из ТЗ_Док_НеНашСклад цикл                            
				Если МаксДатаЗаказовПоставщику >= Стр.ПоступлениеТоваровУслуг.Дата тогда
					ХронологияНарушена = Истина;
				КонецЕсли;

				Если Стр.ПоступлениеТоваровУслуг.Дата > МаксДатаПоступления тогда
					МаксДатаПоступления = Стр.ПоступлениеТоваровУслуг.Дата;          
				КонецЕсли;
			КонецЦикла;
			
			МаксДатаПеремещениеТоваров = Дата("00010101");
			Для каждого ДокПеремещениеТоваров из МассивПеремещенийТоваров цикл 
				Если МаксДатаПоступления >= ДокПеремещениеТоваров.Дата тогда
					ХронологияНарушена = Истина;
				КонецЕсли;
				
				Если ДокПеремещениеТоваров.Дата >= МаксДатаПеремещениеТоваров тогда
					МаксДатаПеремещениеТоваров = ДокПеремещениеТоваров.Дата;          
				КонецЕсли;
				
			КонецЦикла;
			
			Если МаксДатаПеремещениеТоваров >= РеализацияТоваровУслуг.Дата тогда
				ХронологияНарушена = Истина;
			КонецЕсли;
			
			
			
			///	
			
			Если ХронологияНарушена тогда
				Для каждого Стр из МассивЗаказовПоставщику цикл
					ЗаказовПоставщику = Стр.ПолучитьОбъект();
					ЗаказовПоставщику.Комментарий = ЗаказовПоставщику.Комментарий + " #Перепроведено автоматично " + Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
					ЗаказовПоставщику.Дата = РеализацияТоваровУслуг.Дата - 6;          
					ЗаказовПоставщику.Записать(РежимЗаписиДокумента.Проведение);
				КонецЦикла;
			КонецЕсли;

			Для каждого Стр из ТЗ_Док_НеНашСклад цикл
				ДокПоступление = Стр.ПоступлениеТоваровУслуг.ПолучитьОбъект();
				ДокПоступление.Комментарий = ДокПоступление.Комментарий + " #Перепроведено автоматично " + Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
				Если ХронологияНарушена тогда
					ДокПоступление.Дата = РеализацияТоваровУслуг.Дата - 4;          
				КонецЕсли;
				ДокПоступление.Записать(РежимЗаписиДокумента.Проведение); 
				
			КонецЦикла;
			
			МаксДатаПеремещениеТоваров = Дата("00010101");
			Для каждого ДокПеремещениеТоваров из МассивПеремещенийТоваров цикл 
				ДокПеремещениеТоваровОб = ДокПеремещениеТоваров.ПолучитьОбъект();
				Если ХронологияНарушена тогда
					ДокПеремещениеТоваровОб.Дата = РеализацияТоваровУслуг.Дата - 2;;
				КонецЕсли;
				
				ДокПеремещениеТоваровОб.Комментарий = ДокПеремещениеТоваровОб.Комментарий + " #Перепроведено автоматично " + Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
				ДокПеремещениеТоваровОб.Записать(РежимЗаписиДокумента.Проведение);
								
			КонецЦикла;
			
			
			//+БП: d.matyash (16.12.2025) <> 
			СтарыйСтатус = ЗаказПокупателя.Статус;
			//-БП: d.matyash (16.12.2025) <>
			
			РеализацияТоваровУслугОб = РеализацияТоваровУслуг.ПолучитьОбъект();
			РеализацияТоваровУслугОб.Комментарий = РеализацияТоваровУслугОб.Комментарий + " #Перепроведено автоматично " + Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
			РеализацияТоваровУслугОб.Записать(РежимЗаписиДокумента.Проведение);	
			
			//+БП: d.matyash (16.12.2025) <> 
			Если ЗаказПокупателя.Статус <>  СтарыйСтатус Тогда
				ДокЗакОб = ЗаказПокупателя.ПолучитьОбъект();
				ДокЗакОб.Статус = СтарыйСтатус;
				ДокЗакОб.Записать();
			КонецЕслИ;
			//+БП: d.matyash (16.12.2025) <>			
			
			
			МенеджерЗаписи = РегистрыСведений.БП_ДокументыДляПерепроведения.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.Документ = РеализацияТоваровУслуг;
			МенеджерЗаписи.Проведено = Истина;
			МенеджерЗаписи.Статус = "Успішно";
			
			МенеджерЗаписи.Записать();
		Исключение  
			
			МенеджерЗаписи = РегистрыСведений.БП_ДокументыДляПерепроведения.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.Документ = РеализацияТоваровУслуг;
			МенеджерЗаписи.Проведено = Ложь;
			МенеджерЗаписи.Статус = ОписаниеОшибки();
			
			МенеджерЗаписи.Записать();

			Продолжить;
		КонецПопытки;
	КонецЦикла;
	//-БП: bsoft (10.11.2025) <>
КонецПроцедуры

