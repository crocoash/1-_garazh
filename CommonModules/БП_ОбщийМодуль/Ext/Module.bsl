
Процедура БП_ПереоцінкаЗапасів() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ДатаКурса = ТекущаяДата();
	ДатаКурсаТекст = Формат(ДатаКурса,"ДФ=yyyyMMdd");
	HTTP =  Новый HTTPСоединение("bank.gov.ua",443,,,,,Новый ЗащищенноеСоединениеOpenSSL());
	ЗапросТекст="/NBUStatService/v1/statdirectory/exchange?date="+ДатаКурсаТекст+"&json";    

	Попытка
		HTTPОтвет = HTTP.Получить(Новый HTTPЗапрос(ЗапросТекст));
	Исключение
		сообщить(ОписаниеОшибки()); 
	КонецПопытки;         
	
	ОтветСервера = HTTPОтвет.ПолучитьТелоКакСтроку();
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ОтветСервера);
	Объект = ПрочитатьJSON(Чтение, Истина);
	
	Для Каждого Соответствие Из Объект Цикл 
		
		КодВалюты = Соответствие.Получить("r030"); 
		КурсВалюты = Соответствие.Получить("rate"); 
		Если КодВалюты = Неопределено тогда
			Продолжить;
		КонецЕсли;
		
		Валюта = Справочники.Валюты.НайтиПоКоду(КодВалюты,,,);
		Если Валюта = Справочники.Валюты.ПустаяСсылка() тогда 
			Продолжить;
		КонецЕсли;
		
		РегистрКурсыВалют = РегистрыСведений.БП_КурсыВалют;
		ЗаписьКурсовВалют = РегистрКурсыВалют.СоздатьМенеджерЗаписи();
		ЗаписьКурсовВалют.Валюта = Валюта;
		ЗаписьКурсовВалют.Период = ДатаКурса;
		ЗаписьКурсовВалют.Прочитать();
		ЗаписьКурсовВалют.Валюта    = Валюта;
		ЗаписьКурсовВалют.Период    = ДатаКурса;
		ЗаписьКурсовВалют.Курс      = КурсВалюты;
		ЗаписьКурсовВалют.Кратность = 1;
		ЗаписьКурсовВалют.Записать();	
	КонецЦикла; 
	
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	БП_КонтрагентыКПереоценкеЗапасов.Контрагент,
	                      |	БП_КонтрагентыКПереоценкеЗапасов.ДоговорКонтрагента
	                      |ИЗ
	                      |	РегистрСведений.БП_КонтрагентыКПереоценкеЗапасов КАК БП_КонтрагентыКПереоценкеЗапасов
	                      |ГДЕ
	                      |	БП_КонтрагентыКПереоценкеЗапасов.Переоценка");   
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	МассивДоговоров = ТЗ.ВыгрузитьКолонку("ДоговорКонтрагента"); 
	
	ТабПериоценить = новый ТаблицаЗначений;
	ТабПериоценить.Колонки.Добавить("Номенклатура");
	ТабПериоценить.Колонки.Добавить("ЦенаПартииНовая");
	ТабПериоценить.Колонки.Добавить("ДоговорПоставщика");
	
	ЗапросОст = новый запрос;
	ЗапросОст.Текст = "ВЫБРАТЬ
	                  |	ПартииТоваровНаСкладахОстатки.Номенклатура КАК Номенклатура,
	                  |	ПартииТоваровНаСкладахОстатки.Склад КАК Склад,
	                  |	ПартииТоваровНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	                  |	ПартииТоваровНаСкладахОстатки.СерияНоменклатуры КАК СерияНоменклатуры,
	                  |	ПартииТоваровНаСкладахОстатки.ДокументОприходования КАК ДокументОприходования,
	                  |	ПартииТоваровНаСкладахОстатки.СтатусПартии КАК СтатусПартии,
	                  |	ПартииТоваровНаСкладахОстатки.Заказ КАК Заказ,
	                  |	ПартииТоваровНаСкладахОстатки.Качество КАК Качество,
	                  |	СУММА(ПартииТоваровНаСкладахОстатки.КоличествоОстаток) КАК Количество,
	                  |	СУММА(ПартииТоваровНаСкладахОстатки.СтоимостьОстаток) КАК Стоимость,
	                  |	0 КАК СтоимостьНовая,
	                  |	0 КАК СтоимостьОтличие,
	                  |	0 КАК ЦенаПартииНовая,
	                  |	ПартииТоваровНаСкладахОстатки.ДокументОприходования.КурсВзаиморасчетов КАК КурсСтарый,
	                  |	ВЫБОР
	                  |		КОГДА ЕСТЬNULL(БП_КурсыВалютСрезПоследних.Курс, 0) < ЕСТЬNULL(ДоговорыКонтрагентовБП_МинКурс.Курс, 0)
	                  |			ТОГДА ЕСТЬNULL(ДоговорыКонтрагентовБП_МинКурс.Курс, 0)
	                  |		ИНАЧЕ ЕСТЬNULL(БП_КурсыВалютСрезПоследних.Курс, 0)
	                  |	КОНЕЦ КАК КурсНовый,
	                  |	ПартииТоваровНаСкладахОстатки.ДокументОприходования.ДоговорКонтрагента КАК ДоговорКонтрагента
	                  |ИЗ
	                  |	РегистрНакопления.ПартииТоваровНаСкладах.Остатки(&ДатаОст, ДокументОприходования.ДоговорКонтрагента В (&ДоговорКонтрагента)) КАК ПартииТоваровНаСкладахОстатки
	                  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.БП_КурсыВалют.СрезПоследних(&ДатаОст, ) КАК БП_КурсыВалютСрезПоследних
	                  |		ПО ПартииТоваровНаСкладахОстатки.ДокументОприходования.ВалютаДокумента = БП_КурсыВалютСрезПоследних.Валюта
	                  |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов.БП_МинКурс КАК ДоговорыКонтрагентовБП_МинКурс
	                  |		ПО ПартииТоваровНаСкладахОстатки.ДокументОприходования.ВалютаДокумента = ДоговорыКонтрагентовБП_МинКурс.Валюта
	                  |			И ПартииТоваровНаСкладахОстатки.ДокументОприходования.ДоговорКонтрагента = ДоговорыКонтрагентовБП_МинКурс.Ссылка
	                  |ГДЕ
	                  |	ПартииТоваровНаСкладахОстатки.ДокументОприходования.ВалютаДокумента <> &ВалютаРег
	                  |	И ПартииТоваровНаСкладахОстатки.КоличествоОстаток > 0
	                  |	И БП_КурсыВалютСрезПоследних.Курс > 0
	                  |
	                  |СГРУППИРОВАТЬ ПО
	                  |	ПартииТоваровНаСкладахОстатки.Заказ,
	                  |	ПартииТоваровНаСкладахОстатки.Склад,
	                  |	ПартииТоваровНаСкладахОстатки.Номенклатура,
	                  |	ПартииТоваровНаСкладахОстатки.ХарактеристикаНоменклатуры,
	                  |	ПартииТоваровНаСкладахОстатки.Качество,
	                  |	ПартииТоваровНаСкладахОстатки.СерияНоменклатуры,
	                  |	ПартииТоваровНаСкладахОстатки.СтатусПартии,
	                  |	ПартииТоваровНаСкладахОстатки.ДокументОприходования,
	                  |	ПартииТоваровНаСкладахОстатки.ДокументОприходования.КурсВзаиморасчетов,
	                  |	ПартииТоваровНаСкладахОстатки.ДокументОприходования.ДоговорКонтрагента,
	                  |	ВЫБОР
	                  |		КОГДА ЕСТЬNULL(БП_КурсыВалютСрезПоследних.Курс, 0) < ЕСТЬNULL(ДоговорыКонтрагентовБП_МинКурс.Курс, 0)
	                  |			ТОГДА ЕСТЬNULL(ДоговорыКонтрагентовБП_МинКурс.Курс, 0)
	                  |		ИНАЧЕ ЕСТЬNULL(БП_КурсыВалютСрезПоследних.Курс, 0)
	                  |	КОНЕЦ";
	
	ЗапросОст.УстановитьПараметр("ДатаОст", ТекущаяДата());
	ЗапросОст.УстановитьПараметр("ДоговорКонтрагента", МассивДоговоров); 
	ЗапросОст.УстановитьПараметр("ВалютаРег", глЗначениеПеременной("ВалютаРегламентированногоУчета"));
	РезОст = ЗапросОст.Выполнить().Выгрузить();  
	
	Для каждого СтрокаТовар из РезОст цикл 
		ЦенаСтарая = (СтрокаТовар.Стоимость / СтрокаТовар.Количество) / СтрокаТовар.КурсСтарый;	
		СтоимостьНовая = (СтрокаТовар.Количество * ЦенаСтарая) * СтрокаТовар.КурсНовый;  
		СтрокаТовар.ЦенаПартииНовая = ЦенаСтарая * СтрокаТовар.КурсНовый ;
		СтрокаТовар.СтоимостьНовая = СтоимостьНовая; 
		СтрокаТовар.СтоимостьОтличие = СтоимостьНовая - СтрокаТовар.Стоимость;
	КонецЦикла;   

	РезОстТовары = РезОст.Скопировать(,"Номенклатура,ЦенаПартииНовая,ДоговорКонтрагента");
	РезОстТовары.Свернуть("Номенклатура,ЦенаПартииНовая,ДоговорКонтрагента");
	Для каждого Договор из МассивДоговоров цикл
		ОтборСтрок = новый Структура("ДоговорКонтрагента", Договор);
		ТЗОстаткиОтбор = РезОст.НайтиСтроки(ОтборСтрок);
		РезОстТоварыОтбор = РезОстТовары.НайтиСтроки(ОтборСтрок); 
		
		ДокПереоценка = Документы.ПереоценкаЗапасов_СД.СоздатьДокумент();
		ДокПереоценка.Дата = ТекущаяДата();
		ДокПереоценка.ДоговорКонтрагента = Договор;
		ДокПереоценка.Контрагент         = Договор.Владелец;
		ДокПереоценка.Комментарий = "#Створено автоматично!";	
		Для каждого СтрокаОстаток из ТЗОстаткиОтбор Цикл 
			НоваяСтрокаОстатков = ДокПереоценка.ОстаткиПартии.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОстатков, СтрокаОстаток);	
		КонецЦикла;	
		
		Для каждого СтрокаТовары из РезОстТоварыОтбор Цикл 
			НоваяСтрокаТоваров = ДокПереоценка.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТоваров, СтрокаТовары);	
		КонецЦикла;
		ДокПереоценка.Товары.Свернуть("Номенклатура,ЦенаПартииНовая");
		ДокПереоценка.Записать(РежимЗаписиДокумента.Запись);
		Если ДокПереоценка.Товары.Количество() > 0 Тогда 
			Попытка
				ДокПереоценка.Записать(РежимЗаписиДокумента.Проведение);
			Исключение	
				ДокПереоценка.Записать(РежимЗаписиДокумента.Запись);
				//ЗаписьЖурналаРегистрации("Документы.ПереоценкаЗапасов_СД" ,УровеньЖурналаРегистрации.Ошибка,Метаданные.Обработки.ЗагрузкаОстаткаИЦенПоставщика_СД,ОписаниеОшибки(), ОписаниеОшибки()); //bsoft (21.08.2024)
			КонецПопытки;
		КонецЕсли;

	КонецЦикла;	
	
	//Обработки.БП_РасчетРейтингаПоПравиламРанжировки.ВыполнитьВсе();
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Процедура ИзменитьОрганизацию(ДокументОб = Неопределено, ИзмениласьФормаРасчета = Ложь, Автозамена = Истина, ИзмениласьОрганизация = Ложь, СуммаДляВыбораОрганизации = Неопределено) Экспорт 
    УстановитьПривилегированныйРежим(Истина);
	Если ДокументОб = Неопределено ИЛИ Не Автозамена тогда
		Возврат;
	КонецЕсли;
	
	Если ИзмениласьФормаРасчета тогда 
		ФормаРасчета = ДокументОб.ФормаРасчета;
		Если не ЗначениеЗаполнено(ФормаРасчета) тогда
			Возврат;
		КонецЕсли;
		
		//+БП: @Cvet_kov (02.09.2026) <>
		// Организация может зависеть от суммы: табличная часть ОрганизацииПоСумме
		// в карточке формы расчёта (СуммаДо / Организация / БанковскийСчет).
		// Пока она пуста - работают прежние реквизиты Организация и ОсновнойБанковскийСчет.
		НастройкаПоСумме = ОрганизацияПоФормеРасчетаИСумме(ФормаРасчета, СуммаДляВыбораОрганизации, ДокументОб);
		
		Если НастройкаПоСумме <> Неопределено тогда
			ДокументОб.Организация = НастройкаПоСумме.Организация;
			
			Если ТипЗнч(ДокументОб) = Тип("ДокументОбъект.ЗаказПокупателя")
				И ЗначениеЗаполнено(НастройкаПоСумме.БанковскийСчет) тогда
				ДокументОб.СтруктурнаяЕдиница = НастройкаПоСумме.БанковскийСчет;	
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(ФормаРасчета.Организация) тогда
				ДокументОб.Организация = ФормаРасчета.Организация;	
			КонецЕсли;

			Если ТипЗнч(ДокументОб) = Тип("ДокументОбъект.ЗаказПокупателя") тогда
				ДокументОб.СтруктурнаяЕдиница = ФормаРасчета.ОсновнойБанковскийСчет;	
			КонецЕсли;		
		КонецЕсли;
		//-БП: @Cvet_kov (02.09.2026) <>
	КонецЕсли; 
	
	
	Если НЕ (ТипЗнч(ДокументОб) = Тип("ДокументОбъект.РеализацияТоваровУслуг") 
				ИЛИ ТипЗнч(ДокументОб) = Тип("ДокументОбъект.ПлатежноеПоручениеВходящее")
				ИЛИ ТипЗнч(ДокументОб) = Тип("ДокументОбъект.ПлатежноеПоручениеИсходящее")
				ИЛИ ТипЗнч(ДокументОб) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер")
				ИЛИ ТипЗнч(ДокументОб) = Тип("ДокументОбъект.РасходныйКассовыйОрдер")
				ИЛИ ТипЗнч(ДокументОб) = Тип("ДокументОбъект.ПриемТовараНаХранение")) тогда
			
			Возврат
	КонецЕсли;                   
	
	Если ИзмениласьОрганизация тогда
		ПравилаЗаполненияДокументов = ДокументОб.Организация.ПравилаЗаполненияДокументов;                                        
		Если Не ПравилаЗаполненияДокументов.Количество() тогда
			Сообщить("Не заповнені правила налаштувань в карточці організації!");
			Возврат;
		КонецЕсли;

		Если ТипЗнч(ДокументОб) = Тип("ДокументОбъект.РеализацияТоваровУслуг") тогда 			
			НайденнаяСтрока = ПравилаЗаполненияДокументов.Найти(Перечисления.БП_ВидыДокументовДляЗаполненияПоПравилам.РеализацияТоваровУслуг, "ВидДокумента");
			Если НайденнаяСтрока <> Неопределено Тогда
				ДокументОб.ОтражатьВУправленческомУчете = НайденнаяСтрока.ОтражатьВУправленческомУчете;
				ДокументОб.ОтражатьВБухгалтерскомУчете  = НайденнаяСтрока.ОтражатьВБухгалтерскомУчете;
				ДокументОб.ОтражатьВНалоговомУчете 		= НайденнаяСтрока.ОтражатьВНалоговомУчете;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДокументОб) = Тип("ДокументОбъект.ПлатежноеПоручениеВходящее") тогда
			НайденнаяСтрока = ПравилаЗаполненияДокументов.Найти(Перечисления.БП_ВидыДокументовДляЗаполненияПоПравилам.ПлатежноеПоручениеВходящее, "ВидДокумента");
			Если НайденнаяСтрока <> Неопределено Тогда
				ДокументОб.ОтражатьВБухгалтерскомУчете = НайденнаяСтрока.ОтражатьВБухгалтерскомУчете;
				ДокументОб.ОтражатьВНалоговомУчете     = НайденнаяСтрока.ОтражатьВНалоговомУчете;
				ДокументОб.ОтраженоВОперУчете  		   = НайденнаяСтрока.ОтраженоВОперУчете;
				ДокументОб.Оплачено 				   = НайденнаяСтрока.Оплачено; 
				
				Для каждого СтрокаТЧ из ДокументОб.РасшифровкаПлатежа цикл 
					СтрокаТЧ.СтатьяДекларацииПоЕдиномуНалогу = НайденнаяСтрока.СтатьяДекларацииПоЕдиномуНалогу;
					
					Если ЗначениеЗаполнено(НайденнаяСтрока.СтавкаНДС) тогда
						СтрокаТЧ.СтавкаНДС = НайденнаяСтрока.СтавкаНДС;	
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;	
		ИначеЕсли ТипЗнч(ДокументОб) = Тип("ДокументОбъект.ПлатежноеПоручениеИсходящее") тогда
			НайденнаяСтрока = ПравилаЗаполненияДокументов.Найти(Перечисления.БП_ВидыДокументовДляЗаполненияПоПравилам.ПлатежноеПоручениеИсходящее, "ВидДокумента");
			Если НайденнаяСтрока <> Неопределено Тогда
				ДокументОб.ОтражатьВБухгалтерскомУчете = НайденнаяСтрока.ОтражатьВБухгалтерскомУчете;
				ДокументОб.ОтражатьВНалоговомУчете     = НайденнаяСтрока.ОтражатьВНалоговомУчете;
				ДокументОб.ОтраженоВОперУчете  		   = НайденнаяСтрока.ОтраженоВОперУчете;
				ДокументОб.Оплачено 				   = НайденнаяСтрока.Оплачено; 
				
				Для каждого СтрокаТЧ из ДокументОб.РасшифровкаПлатежа цикл 
					СтрокаТЧ.СтатьяДекларацииПоЕдиномуНалогу = НайденнаяСтрока.СтатьяДекларацииПоЕдиномуНалогу;	
				КонецЦикла;
			КонецЕсли;				
		ИначеЕсли ТипЗнч(ДокументОб) = Тип("ДокументОбъект.ПриходныйКассовыйОрдер") тогда
			НайденнаяСтрока = ПравилаЗаполненияДокументов.Найти(Перечисления.БП_ВидыДокументовДляЗаполненияПоПравилам.ПриходныйКассовыйОрдер, "ВидДокумента");
			Если НайденнаяСтрока <> Неопределено Тогда
				ДокументОб.ОтражатьВУправленческомУчете = НайденнаяСтрока.ОтражатьВУправленческомУчете;
				ДокументОб.ОтражатьВБухгалтерскомУчете  = НайденнаяСтрока.ОтражатьВБухгалтерскомУчете;
				ДокументОб.ОтраженоВОперУчете 			= НайденнаяСтрока.ОтраженоВОперУчете;
				ДокументОб.ОтражатьВНалоговомУчете      = НайденнаяСтрока.ОтражатьВНалоговомУчете;
				ДокументОб.Оплачено 				    = НайденнаяСтрока.Оплачено; 
				ДокументОб.Чек		 				    = НайденнаяСтрока.Чек;
			КонецЕсли;				
		ИначеЕсли ТипЗнч(ДокументОб) = Тип("ДокументОбъект.РасходныйКассовыйОрдер") тогда
			НайденнаяСтрока = ПравилаЗаполненияДокументов.Найти(Перечисления.БП_ВидыДокументовДляЗаполненияПоПравилам.РасходныйКассовыйОрдер, "ВидДокумента");
			Если НайденнаяСтрока <> Неопределено Тогда
				ДокументОб.ОтражатьВУправленческомУчете = НайденнаяСтрока.ОтражатьВУправленческомУчете;
				ДокументОб.ОтражатьВБухгалтерскомУчете  = НайденнаяСтрока.ОтражатьВБухгалтерскомУчете;
				ДокументОб.ОтраженоВОперУчете 			= НайденнаяСтрока.ОтраженоВОперУчете; 
				ДокументОб.ОтражатьВНалоговомУчете      = НайденнаяСтрока.ОтражатьВНалоговомУчете;
				ДокументОб.Оплачено 				    = НайденнаяСтрока.Оплачено;  
				ДокументОб.Чек		 				    = НайденнаяСтрока.Чек;
			КонецЕсли;				
		КонецЕсли;
			
	КонецЕсли;     
	 УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры	


//+БП: @Cvet_kov (02.09.2026) <>
// Возвращает строку табличной части ФормыРасчета.ОрганизацииПоСумме, подходящую под сумму
// документа, или Неопределено, если таблица не заполнена - тогда вызывающий код работает
// по прежним реквизитам формы расчёта.
//
// Параметры:
//  ФормаРасчета - СправочникСсылка.ФормыРасчета
//  Сумма        - Число - сумма, по которой выбирается организация; Неопределено - взять из документа
//  ДокументОб   - ДокументОбъект - источник суммы, если она не передана явно
//
// Строка с нулевым лимитом СуммаДо считается строкой "и выше" и уходит в конец списка.
// Если сумма больше всех лимитов, берётся последняя строка.
//
Функция ОрганизацияПоФормеРасчетаИСумме(ФормаРасчета, Сумма = Неопределено, ДокументОб = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ФормаРасчета) тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Настройки = ФормаРасчета.ОрганизацииПоСумме.Выгрузить();
	
	Если Настройки.Количество() = 0 тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// строки без организации ни на что не годятся
	СтрокиБезОрганизации = Настройки.НайтиСтроки(Новый Структура("Организация", Справочники.Организации.ПустаяСсылка()));
	Для каждого СтрокаБезОрганизации Из СтрокиБезОрганизации Цикл
		Настройки.Удалить(СтрокаБезОрганизации);
	КонецЦикла;
	
	Если Настройки.Количество() = 0 тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Настройки.Колонки.Добавить("БезВерхнейГраницы", Новый ОписаниеТипов("Число"));
	Для каждого СтрокаНастройки Из Настройки Цикл
		СтрокаНастройки.БезВерхнейГраницы = ?(СтрокаНастройки.СуммаДо = 0, 1, 0);
	КонецЦикла;
	
	Настройки.Сортировать("БезВерхнейГраницы Возр, СуммаДо Возр");
	
	СуммаВыбора = Сумма;
	Если СуммаВыбора = Неопределено тогда
		СуммаВыбора = СуммаДокументаДляВыбораОрганизации(ДокументОб);
	КонецЕсли;
	
	Для каждого СтрокаНастройки Из Настройки Цикл
		Если СтрокаНастройки.БезВерхнейГраницы = 1 ИЛИ СуммаВыбора <= СтрокаНастройки.СуммаДо тогда
			Возврат СтрокаНастройки;
		КонецЕсли;
	КонецЦикла;
	
	// сумма больше всех лимитов - последняя, самая "старшая" строка
	Возврат Настройки[Настройки.Количество() - 1];
	
КонецФункции

// Сумма документа для выбора организации, когда она не передана явно.
// Товары берутся тоже: организация подставляется до заполнения табличной части,
// и в этот момент СуммаДокумента ещё нулевая.
//
Функция СуммаДокументаДляВыбораОрганизации(ДокументОб)
	
	Если ДокументОб = Неопределено тогда
		Возврат 0;
	КонецЕсли;
	
	СуммаДокумента = 0;
	Попытка
		СуммаДокумента = ДокументОб.СуммаДокумента;
	Исключение
	КонецПопытки;
	
	СуммаТоваров = 0;
	Попытка
		СуммаТоваров = ДокументОб.Товары.Итог("Сумма");
	Исключение
	КонецПопытки;
	
	Возврат Макс(СуммаДокумента, СуммаТоваров);
	
КонецФункции
