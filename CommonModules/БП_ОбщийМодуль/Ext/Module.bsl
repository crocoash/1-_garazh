					ДокПеремещениеТоваровОб.Дата = РеализацияТоваровУслуг.Дата - 2;;
				КонецЕсли;
				
				ДокПеремещениеТоваровОб.Комментарий = ДокПеремещениеТоваровОб.Комментарий + " #Перепроведено автоматично " + Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
				ДокПеремещениеТоваровОб.Записать(РежимЗаписиДокумента.Проведение);
								
			КонецЦикла; 
			
			//+БП: d.matyash (16.12.2025) <> 
			СтарыйСтатус = ЗаказПокупателя.Статус;
			//-БП: d.matyash (16.12.2025) <>
			
			РеализацияТоваровУслугОб = РеализацияТоваровУслуг.ПолучитьОбъект();
			РеализацияТоваровУслугОб.Комментарий = РеализацияТоваровУслугОб.Комментарий + " #Перепроведено автоматично " + Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
			РеализацияТоваровУслугОб.Записать(РежимЗаписиДокумента.Проведение);		
			
			
			//+БП: d.matyash (16.12.2025) <> 
			Если ЗаказПокупателя.Статус <>  СтарыйСтатус Тогда
				ДокЗакОб = ЗаказПокупателя.ПолучитьОбъект();
				ДокЗакОб.Статус = СтарыйСтатус;
				ДокЗакОб.Записать();
			КонецЕслИ;
			//+БП: d.matyash (16.12.2025) <>
			
			МенеджерЗаписи = РегистрыСведений.БП_ДокументыДляПерепроведения.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.Документ = РеализацияТоваровУслуг;
			МенеджерЗаписи.Проведено = Истина;
			МенеджерЗаписи.Статус = "Успішно";
			
			МенеджерЗаписи.Записать();
		Исключение  
			
			МенеджерЗаписи = РегистрыСведений.БП_ДокументыДляПерепроведения.СоздатьМенеджерЗаписи();
			
			МенеджерЗаписи.Документ = РеализацияТоваровУслуг;
			МенеджерЗаписи.Проведено = Ложь;
			МенеджерЗаписи.Статус = ОписаниеОшибки();
			
			МенеджерЗаписи.Записать();

		КонецПопытки;
	//-БП: bsoft (10.11.2025) <>

КонецПроцедуры

//+БП: @Cvet_kov (27.08.2026) <>
// Возвращает вид заказа поставщику, соответствующий группе текущего пользователя.
//
// Правило продиктовано проверкой в ПередЗаписью формы заказа поставщику: пользователю
// из группы "Менеджера" платформа молча отказывает в записи документа с любым другим видом.
// Для остальных групп вид не определён (в закомментированной проверке был "Бухгалтерія"),
// поэтому возвращается пустая ссылка и вид выбирается вручную.
//
Функция ВидЗаказаПоставщикуПоТекущемуПользователю() Экспорт

	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;

	Если НЕ ЗначениеЗаполнено(ТекущийПользователь) Тогда
		Возврат Перечисления.БП_ВидЗаказаПоставщику.ПустаяСсылка();
	КонецЕсли;

	Если СокрЛП(ТекущийПользователь.Родитель.Наименование) = "Менеджера" Тогда
		Возврат Перечисления.БП_ВидЗаказаПоставщику.Менеджер;
	КонецЕсли;

	Возврат Перечисления.БП_ВидЗаказаПоставщику.ПустаяСсылка();

КонецФункции

// Подставляет вид заказа поставщику по текущему пользователю, если вид ещё не выбран.
// Осознанный выбор пользователя не перебивается.
//
Процедура ЗаполнитьВидЗаказаПоставщикуПоТекущемуПользователю(ЗаказПоставщикуОбъект) Экспорт

	Если ЗначениеЗаполнено(ЗаказПоставщикуОбъект.БП_ВидЗаказаПоставщику) Тогда
		Возврат;
	КонецЕсли;

	ЗаказПоставщикуОбъект.БП_ВидЗаказаПоставщику = ВидЗаказаПоставщикуПоТекущемуПользователю();

КонецПроцедуры
