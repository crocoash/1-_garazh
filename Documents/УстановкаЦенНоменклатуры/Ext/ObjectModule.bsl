		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		Запрос.УстановитьПараметр("ТипЦен",Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("GarazhUA",,,));
		Товарыврем = Запрос.Выполнить().Выгрузить();
		Номенклатура = Товарыврем.ВыгрузитьКолонку("Номенклатура"); 
		
		// ПреДок ------------------------
		ПреДок = Неопределено;
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		                      |	УстановкаЦенНоменклатурыТипыЦен.Ссылка
