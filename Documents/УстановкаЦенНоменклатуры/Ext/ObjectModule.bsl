		                      |	И УстановкаЦенНоменклатурыТипыЦен.Ссылка.КонтрагентРасчета = &КонтрагентРасчета
		                      |	И УстановкаЦенНоменклатурыТипыЦен.Ссылка.Дата <= &Дата
		                      |	И УстановкаЦенНоменклатурыТипыЦен.ТипЦен = &ТипЦен
		                      |	И УстановкаЦенНоменклатурыТипыЦен.Ссылка <> &Ссылка
		                      |
		                      |СГРУППИРОВАТЬ ПО
		                      |	УстановкаЦенНоменклатурыТипыЦен.Ссылка
		                      |
		                      |УПОРЯДОЧИТЬ ПО
		                      |	УстановкаЦенНоменклатурыТипыЦен.Ссылка.Дата УБЫВ");
		
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		Запрос.УстановитьПараметр("ТипЦен",Справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("GarazhUA",,,));
		Запрос.УстановитьПараметр("Дата",Дата);
		Запрос.УстановитьПараметр("КонтрагентРасчета",Ссылка.КонтрагентРасчета);  
		Запрос.УстановитьПараметр("ВидНоменклатуры",Ссылка.ВидНоменклатуры);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() цикл
			ПреДок = Выборка.Ссылка;	
		КонецЦикла;  
		
		Если ПреДок <> Неопределено тогда
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	УстановкаЦенНоменклатурыТовары.Номенклатура
			                      |ИЗ
			                      |	Документ.УстановкаЦенНоменклатуры.Товары КАК УстановкаЦенНоменклатурыТовары
			                      |ГДЕ
			                      |	НЕ УстановкаЦенНоменклатурыТовары.Номенклатура В (&Номенклатура)
			                      |	И УстановкаЦенНоменклатурыТовары.Ссылка = &Ссылка
			                      |
			                      |СГРУППИРОВАТЬ ПО
			                      |	УстановкаЦенНоменклатурыТовары.Номенклатура");
			Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
