				ЗаполнитьЗначенияСвойств(НоваяСтр, Выборка);
				Номенклатура.Добавить(Выборка.Номенклатура);
				НоменклатураКИскоючению.Добавить(Выборка.Номенклатура);
			КонецЦикла; 	
