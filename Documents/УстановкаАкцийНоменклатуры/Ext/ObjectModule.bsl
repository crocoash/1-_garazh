
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Для Каждого Стр Из ТОвары Цикл
		Ном = Стр.Номенклатура.ПолучитьОбъект();
		Ном.Акция = Стр.Акция;
		Ном.Записать();
	КонецЦикла;
	Для Каждого Стр Из Снимаем Цикл
		Ном = Стр.Номенклатура.ПолучитьОбъект();
		Ном.Акция = 0;
		Ном.Записать();
	КонецЦикла;
	
КонецПроцедуры
