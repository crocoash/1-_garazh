функция СоздатьПКО(ЗаказСсылка, СуммаОплаты,Комментарий, КассаКод, Проводить) Экспорт 

	ПКО = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
	ПКО.ВидОперации = Перечисления.ВидыОперацийПКО.ОплатаПокупателя;

	ПКО.Дата = ТекущаяДата();

	ПКО.Касса = Справочники.Кассы.НайтиПоКоду(КассаКод);							
	ПКО.Организация = ЗаказСсылка.Организация;
	ПКО.Контрагент = ЗаказСсылка.Контрагент;
	ПКО.ДоговорКонтрагента = ЗаказСсылка.ДоговорКонтрагента;
    ПКО.Оплачено = Истина;
	ПКО.ДокументОснование = ЗаказСсылка;
	ПКО.СуммаДокумента = СуммаОплаты;
	ПКО.Комментарий = Комментарий;  	
	ПКО.Подразделение = ЗаказСсылка.Подразделение;
	 
	Стр = ПКО.РасшифровкаПлатежа.Добавить();
	Стр.СуммаПлатежа = СуммаОплаты;
	Стр.СуммаВзаиморасчетов = СуммаОплаты;
	Стр.ДоговорКонтрагента = ЗаказСсылка.ДоговорКонтрагента;
	Стр.ДокументРасчетовСКонтрагентом = ЗаказСсылка;
	Стр.Сделка = ЗаказСсылка;
	
	

	ПКО.ОтражатьВУправленческомУчете = Истина;
	ПКО.ВалютаДокумента = ЗаказСсылка.ВалютаДокумента;
	ПКО.Ответственный = Справочники.Пользователи.НайтиПоНаименованию("Magento");
	Если Проводить тогда 
		ПКО.Записать(РежимЗаписиДокумента.Проведение);	
	КонецЕсли;

	Возврат ПКО;
КонецФункции                    

// Маркер транзакции терминала в комментарии ордера. Разделители обязательны:
// без них поиск подстрокой находит транзакцию "123" внутри "1234".
Функция МаркерТранзакцииТерминала(ТранзакцияТерминала) Экспорт

	Возврат "TransactionId: " + СокрЛП(Строка(ТранзакцияТерминала)) + ";";

КонецФункции

Функция ЭкранироватьДляПодобно(Знач Текст)

	Текст = СтрЗаменить(Текст, "~", "~~");
	Текст = СтрЗаменить(Текст, "%", "~%");
	Текст = СтрЗаменить(Текст, "_", "~_");
	Текст = СтрЗаменить(Текст, "[", "~[");

	Возврат Текст;

КонецФункции

// Дедуп платежей терминала. Отбор по виду операции обязателен: по одной транзакции
// создаются два ордера - оплата заказа и благотворительный взнос, - и без него
// второй считался бы дублем первого, а терминалу уходил бы ложный "уже принят".
// Дата ограничивает перебор: повторы приходят от терминала в пределах минут,
// а индекса по комментарию нет и полный перебор ордеров растет вместе с базой.
Функция НайтиПКОПоТранзакцииТерминала(ТранзакцияТерминала, ВидОперации) Экспорт

	Если ПустаяСтрока(Строка(ТранзакцияТерминала)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПКО.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПКО
	|ГДЕ
	|	ПКО.Дата >= &ДатаОт
	|	И ПКО.ВидОперации = &ВидОперации
	|	И ПКО.Комментарий ПОДОБНО &Маркер СПЕЦСИМВОЛ ""~""";

	Запрос.УстановитьПараметр("ДатаОт", НачалоДня(ТекущаяДата() - 90 * 24 * 3600));
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	Запрос.УстановитьПараметр("Маркер",
		"%" + ЭкранироватьДляПодобно(МаркерТранзакцииТерминала(ТранзакцияТерминала)) + "%");

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Благотворительный взнос покупателя - сдача, от которой он отказался в терминале.
// Вид операции "прочий приход": контрагент не требуется (СтруктураОбязательныхПолейОплатаУпр
// исключает его для этого вида), взаиморасчеты не двигаются - в
// УправлениеДенежнымиСредствами.ЕстьРасчетыСКонтрагентами этого вида нет.
// Деньги приходуются в отдельную кассу фонда; обнуляет ее бухгалтер расходным ордером.
Функция СоздатьПКОБлаготворительность(ЗаказСсылка, Сумма, Комментарий, КассаКод,
                                      СтатьяДДСКод = "", Проводить = Ложь) Экспорт

	Касса = Справочники.Кассы.НайтиПоКоду(КассаКод);

	Если Касса.Пустая() Тогда
		ВызватьИсключение "Не найдена касса с кодом """ + Строка(КассаКод) + """";
	КонецЕсли;

	СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();

	Если Не ПустаяСтрока(Строка(СтатьяДДСКод)) Тогда
		СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду(СтатьяДДСКод);
	КонецЕсли;

	ПКО = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
	ПКО.ВидОперации = Перечисления.ВидыОперацийПКО.ПриходДенежныхСредствПрочее;

	ПКО.Дата = ТекущаяДата();

	ПКО.Касса = Касса;
	ПКО.Организация = ЗаказСсылка.Организация;
	ПКО.Подразделение = ЗаказСсылка.Подразделение;
	ПКО.ВалютаДокумента = ЗаказСсылка.ВалютаДокумента;
	ПКО.СуммаДокумента = Сумма;
	ПКО.Оплачено = Истина;
	ПКО.ОтражатьВУправленческомУчете = Истина;
	ПКО.ДокументОснование = ЗаказСсылка;
	ПКО.СтатьяДвиженияДенежныхСредств = СтатьяДДС;
	ПКО.ПринятоОт = "Покупець";
	ПКО.Основание = "Благодійний внесок (решта за замовленням № " + СокрЛП(ЗаказСсылка.Номер) + ")";
	ПКО.Комментарий = Комментарий;
	ПКО.Ответственный = Справочники.Пользователи.НайтиПоНаименованию("Magento");

	// Расшифровка обязательна: ПроверитьЗаполнениеДокументаУпр сверяет ее итог
	// с суммой документа. Договор и сделка не заполняются - это не расчеты с контрагентом.
	Стр = ПКО.РасшифровкаПлатежа.Добавить();
	Стр.СуммаПлатежа = Сумма;
	Стр.СуммаВзаиморасчетов = 0;
	Стр.СтатьяДвиженияДенежныхСредств = СтатьяДДС;

	Если Проводить Тогда
		ПКО.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;

	Возврат ПКО;

КонецФункции

// Договоры, по которым можно принять свободный аванс - платеж без привязки к заказу.
// При ведении взаиморасчетов "по заказам" и "по счетам" проведение ордера требует
// заполненную сделку в каждой строке расшифровки (ПроверитьЗаполнениеТЧ модуля объекта),
// поэтому свободного аванса по таким договорам не бывает в принципе.
Функция ДоступенСвободныйАванс(ДоговорКонтрагента) Экспорт

	Если Не ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		Возврат Ложь;
	КонецЕсли;

	Ведение = ДоговорКонтрагента.ВедениеВзаиморасчетов;

	Возврат Ведение <> Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоЗаказам
		И Ведение <> Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоСчетам;

КонецФункции

// Сдача, зачисляемая на баланс клиента: вторая строка расшифровки того же ордера,
// но без сделки. Пустая сделка - это и есть свободный аванс: при следующей продаже
// его подбирает УправлениеВзаиморасчетами.ЗаполнитьТаблицуДокументовРасчетовСКонтрагентом
// приоритетом 2, в режиме заполнения "по заказам и свободные".
// Контрагент и договор те же, что у оплаты заказа, поэтому отдельный документ не нужен.
Процедура ДобавитьАвансВПКО(ПКО, ЗаказСсылка, СуммаАванса) Экспорт

	Если СуммаАванса <= 0 Тогда
		Возврат;
	КонецЕсли;

	Если Не ДоступенСвободныйАванс(ЗаказСсылка.ДоговорКонтрагента) Тогда
		ВызватьИсключение "По договору """ + Строка(ЗаказСсылка.ДоговорКонтрагента)
			+ """ взаиморасчеты ведутся по заказам или счетам - свободный аванс не принимается";
	КонецЕсли;

	Стр = ПКО.РасшифровкаПлатежа.Добавить();
	Стр.СуммаПлатежа = СуммаАванса;
	Стр.СуммаВзаиморасчетов = СуммаАванса;
	Стр.ДоговорКонтрагента = ЗаказСсылка.ДоговорКонтрагента;

	ПКО.СуммаДокумента = ПКО.СуммаДокумента + СуммаАванса;

КонецПроцедуры
