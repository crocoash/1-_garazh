			price_old = НайденнаяСтрока.Цена;
		КонецЕсли;
		
		Если price_old = Стр.Цена тогда
			Продолжить;
		КонецЕсли;
		
		НайденнаяСтрока = ТЗОстаток.Найти(Стр.Номенклатура, "Номенклатура");
		Если НайденнаяСтрока = Неопределено Тогда
			qty = 0;
		Иначе
			qty = НайденнаяСтрока.КоличествоОстаток;
		КонецЕсли;
		
		Страна = "";
		ДатаПроизводства = "";
		Отбор = Новый Структура("Номенклатура, Поставщик",Стр.Номенклатура, Стр.Поставщик);
		Строки = ТЗДатыПроизводства.НайтиСтроки(Отбор);
		Если Строки.Количество() > 0 Тогда
			ДатаПроизводства = Строки[0].ДатаПроизводства; 
			Страна = Строки[0].Страна;
		КонецЕсли;
		
		
		//СтруктураОтправки_category.Вставить("name", Источник.Наименование);	
		СтруктураОтправки_category.Вставить("price_old", price_old);  
		СтруктураОтправки_category.Вставить("price_new", Стр.Цена); 
		СтруктураОтправки_category.Вставить("qty", qty);
		СтруктураОтправки_category.Вставить("currency", "UAH"); 
		СтруктураОтправки_category.Вставить("sort_options", МассивСортировок);
		
		
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","producer_country",Страна));
		МассивРеквизитовКОтправке.Добавить(Новый Структура("code, value","manufacturer_year",ДатаПроизводства));
		СтруктураОтправки_category.Вставить("attributes_values", МассивРеквизитовКОтправке); 
		
		СтруктураОтправки = Новый Структура;
		СтруктураОтправки.Вставить("product", СтруктураОтправки_category); 
		
		БП_ОбменMagento.УстановкаЦенНоменклатуриОтправить(СтруктураОтправки);
	КонецЦикла;
	
КонецПроцедуры

мИспользоватьХарактеристики     = глЗначениеПеременной("ИспользоватьХарактеристикиНоменклатуры");

