////////////////////////////////////////////////////////////////////////////////
// Создание платежного поручения входящего по заказу покупателя.
//
// СоздатьПлатежПоЗаказу — общая точка входа: заказ + факт платежа
// (сумма, дата, ключ дедупликации, счет организации). Организация,
// подразделение, контрагент, договор, валюта и НДС берутся из заказа.
//
// Используется:
//   * эквайрингом WayForPay (форма заказа покупателя) — через обертку
//     СоздатьПлатежноеПоручениеWayForPay, ключ дедупликации = AuthCode;
//   * загрузкой банковских выписок (обработка ОбменПриват24) — ключ
//     дедупликации = НомерВходящегоДокумента (идентификатор операции банка).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Заготовка структуры "факт платежа" для СоздатьПлатежПоЗаказу.
//
// Возвращаемое значение:
//   Структура:
//     * Сумма                   - Число  - сумма фактической оплаты;
//     * ДатаПлатежа             - Дата   - дата и время платежа;
//     * НомерВходящегоДокумента - Строка - идентификатор операции банка,
//                                 ключ дедупликации для выписки;
//     * AuthCode                - Строка - код авторизации WayForPay,
//                                 ключ дедупликации для эквайринга;
//     * СчетОрганизации         - СправочникСсылка.БанковскиеСчета - счет,
//                                 на который фактически пришли деньги;
//                                 приоритетнее счета из заказа;
//     * НазначениеПлатежа       - Строка;
//     * Комментарий             - Строка;
//     * Организация             - СправочникСсылка.Организации - резерв,
//                                 если заказ не определен;
//     * Подразделение           - СправочникСсылка.Подразделения - резерв;
//     * Контрагент              - СправочникСсылка.Контрагенты   - резерв;
//     * ДоговорКонтрагента      - СправочникСсылка.ДоговорыКонтрагентов - резерв;
//     * Проводить               - Булево - проводить документ (Истина)
//                                 либо только записать.
//
Функция ОписаниеПлатежаПоЗаказу() Экспорт

	Результат = Новый Структура;

	Результат.Вставить("Сумма", 0);
	Результат.Вставить("ДатаПлатежа", Неопределено);
	Результат.Вставить("НомерВходящегоДокумента", "");
	Результат.Вставить("AuthCode", "");
	Результат.Вставить("СчетОрганизации", Неопределено);
	Результат.Вставить("НазначениеПлатежа", "");
	Результат.Вставить("Комментарий", "");
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("Подразделение", Неопределено);
	Результат.Вставить("Контрагент", Неопределено);
	Результат.Вставить("ДоговорКонтрагента", Неопределено);
	Результат.Вставить("Проводить", Истина);

	Возврат Результат;

КонецФункции

// Создает платежное поручение входящее по заказу покупателя.
//
// Параметры:
//   ДокументОснование - ДокументСсылка.ЗаказПокупателя - может быть пустым:
//                       тогда реквизиты берутся из ФактПлатежа;
//   ФактПлатежа       - Структура - см. ОписаниеПлатежаПоЗаказу.
//
// Возвращаемое значение:
//   Структура - Успешно, Сообщение, Ссылка, УжеСуществует.
//
Функция СоздатьПлатежПоЗаказу(ДокументОснование, ФактПлатежа) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Ссылка", Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка());
	Результат.Вставить("УжеСуществует", Ложь);

	Если ФактПлатежа = Неопределено Тогда
		Результат.Сообщение = "Не передан факт платежа.";
		Возврат Результат;
	КонецЕсли;

	Платеж = ОписаниеПлатежаПоЗаказу();
	ЗаполнитьЗначенияСвойств(Платеж, ФактПлатежа);

	Если Не ЗначениеЗаполнено(Платеж.Сумма) Тогда
		Результат.Сообщение = "Не указана сумма платежа.";
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Платеж.ДатаПлатежа) Тогда
		Платеж.ДатаПлатежа = ТекущаяДата();
	КонецЕсли;

	// Дедупликация: WayForPay — по паре "заказ + AuthCode",
	// банковская выписка — по НомерВходящегоДокумента.
	СуществующийДокумент = НайтиПлатежПоЗаказу(ДокументОснование, Платеж);

	Если ЗначениеЗаполнено(СуществующийДокумент) Тогда

		Результат.Успешно       = Истина;
		Результат.УжеСуществует = Истина;
		Результат.Ссылка        = СуществующийДокумент;
		Результат.Сообщение     = "Платежное поручение уже создано.";

		Возврат Результат;

	КонецЕсли;

	Попытка

		ПлатежноеПоручение = Документы.ПлатежноеПоручениеВходящее.СоздатьДокумент();

		ПлатежноеПоручение.ВидОперации =
			Перечисления.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ОплатаПокупателя;

		Если ЗначениеЗаполнено(ДокументОснование) Тогда

			// Стандартное заполнение по заказу: вид операции, валюта,
			// договор, счет организации из структурной единицы заказа.
			ПлатежноеПоручение.Заполнить(ДокументОснование);

			ПлатежноеПоручение.ДокументОснование  = ДокументОснование;
			ПлатежноеПоручение.Организация        = ДокументОснование.Организация;
			ПлатежноеПоручение.Контрагент         = ДокументОснование.Контрагент;
			ПлатежноеПоручение.ДоговорКонтрагента = ДокументОснование.ДоговорКонтрагента;
			ПлатежноеПоручение.Подразделение      = ДокументОснование.Подразделение;

		Иначе

			// Платеж без заказа (например, поступление, которое пользователь
			// не сопоставил): реквизиты берем из факта платежа.
			ПлатежноеПоручение.Организация        = Платеж.Организация;
			ПлатежноеПоручение.Контрагент         = Платеж.Контрагент;
			ПлатежноеПоручение.ДоговорКонтрагента = Платеж.ДоговорКонтрагента;
			ПлатежноеПоручение.Подразделение      = Платеж.Подразделение;

			Если Не ЗначениеЗаполнено(Платеж.ДоговорКонтрагента) Тогда
				ПлатежноеПоручение.ВидОперации =
					Перечисления.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ПрочееПоступлениеБезналичныхДенежныхСредств;
			КонецЕсли;

		КонецЕсли;

		ПлатежноеПоручение.Дата                    = Платеж.ДатаПлатежа;
		ПлатежноеПоручение.ДатаОплаты              = Платеж.ДатаПлатежа;
		ПлатежноеПоручение.ДатаВходящегоДокумента  = Платеж.ДатаПлатежа;
		ПлатежноеПоручение.Оплачено                = Истина;
		ПлатежноеПоручение.СуммаДокумента          = Платеж.Сумма;

		Если Не ПустаяСтрока(СокрЛП(Строка(Платеж.НомерВходящегоДокумента))) Тогда
			ПлатежноеПоручение.НомерВходящегоДокумента =
				СокрЛП(Строка(Платеж.НомерВходящегоДокумента));
		КонецЕсли;

		Если Не ПустаяСтрока(СокрЛП(Строка(Платеж.AuthCode))) Тогда
			ПлатежноеПоручение.WayForPay_AuthCode = СокрЛП(Строка(Платеж.AuthCode));
		КонецЕсли;

		// Счет организации: приоритет у счета, на который деньги пришли
		// фактически (выписка). Если он не передан — оставляем то, что
		// подставило заполнение по заказу, и только затем берем основной
		// счет организации.
		Если ЗначениеЗаполнено(Платеж.СчетОрганизации) Тогда

			ПлатежноеПоручение.СчетОрганизации = Платеж.СчетОрганизации;

		ИначеЕсли Не ЗначениеЗаполнено(ПлатежноеПоручение.СчетОрганизации) Тогда

			Попытка
				ПлатежноеПоручение.СчетОрганизации =
					ПлатежноеПоручение.Организация.ОсновнойБанковскийСчет;
			Исключение
			КонецПопытки;

		КонецЕсли;

		Попытка
			ПлатежноеПоручение.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Исключение
		КонецПопытки;

		Если Не ПустаяСтрока(СокрЛП(Строка(Платеж.НазначениеПлатежа))) Тогда
			ПлатежноеПоручение.НазначениеПлатежа = Платеж.НазначениеПлатежа;
		КонецЕсли;

		Если Не ПустаяСтрока(СокрЛП(Строка(Платеж.Комментарий))) Тогда
			ПлатежноеПоручение.Комментарий = Платеж.Комментарий;
		КонецЕсли;

		ЗаполнитьРасшифровкуПлатежа(
			ПлатежноеПоручение,
			ДокументОснование,
			Платеж);

		Если Платеж.Проводить Тогда
			ПлатежноеПоручение.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ПлатежноеПоручение.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;

		Результат.Успешно       = Истина;
		Результат.УжеСуществует = Ложь;
		Результат.Ссылка        = ПлатежноеПоручение.Ссылка;
		Результат.Сообщение     = "Платежное поручение создано.";

	Исключение

		Результат.Успешно   = Ложь;
		Результат.Сообщение =
			"Ошибка создания платежного поручения: " + ОписаниеОшибки();

	КонецПопытки;

	Возврат Результат;

КонецФункции

// Ищет уже созданный платеж по тем же данным.
// Возвращает пустую ссылку, если платеж не найден.
Функция НайтиПлатежПоЗаказу(ДокументОснование, ФактПлатежа) Экспорт

	ПустаяСсылка = Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка();

	Если ФактПлатежа = Неопределено Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;

	AuthCode = "";
	ФактПлатежа.Свойство("AuthCode", AuthCode);

	Если Не ПустаяСтрока(СокрЛП(Строка(AuthCode))) Тогда

		Ссылка = НайтиПлатежноеПоручениеWayForPay(ДокументОснование, AuthCode);

		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;

	КонецЕсли;

	НомерВходящего = "";
	ФактПлатежа.Свойство("НомерВходящегоДокумента", НомерВходящего);

	Если Не ПустаяСтрока(СокрЛП(Строка(НомерВходящего))) Тогда

		ДатаПлатежа = Неопределено;
		ФактПлатежа.Свойство("ДатаПлатежа", ДатаПлатежа);

		Ссылка = НайтиПоНомеруВходящегоДокумента(НомерВходящего, ДатаПлатежа);

		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;

	КонецЕсли;

	Возврат ПустаяСсылка;

КонецФункции

// Ищет платеж по НомерВходящегоДокумента в окне +-2 дня от даты операции:
// дата документа может отличаться от даты операции банка.
//
// Живет здесь, а не в общем модуле загрузки выписок, чтобы платежная часть
// не зависела от него: эквайринг WayForPay работает и без выписок.
Функция НайтиПоНомеруВходящегоДокумента(
	ИдентификаторОперации,
	ДатаОперации) Экспорт

	Если ПустаяСтрока(СокрЛП(Строка(ИдентификаторОперации))) Тогда
		Возврат Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПлатежноеПоручениеВходящее.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	|ГДЕ
	|	НЕ ПлатежноеПоручениеВходящее.ПометкаУдаления
	|	И ПлатежноеПоручениеВходящее.Проведен
	|	И ПлатежноеПоручениеВходящее.НомерВходящегоДокумента
	|		= &ИдентификаторОперации
	|	И ПлатежноеПоручениеВходящее.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПлатежноеПоручениеВходящее.Дата УБЫВ";

	Запрос.УстановитьПараметр(
		"ИдентификаторОперации",
		СокрЛП(Строка(ИдентификаторОперации)));

	Запрос.УстановитьПараметр(
		"НачалоПериода",
		НачалоДня(ДатаОперации - 2 * 24 * 60 * 60));

	Запрос.УстановитьПараметр(
		"КонецПериода",
		КонецДня(ДатаОперации + 2 * 24 * 60 * 60));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка();

КонецФункции

// Ищет платеж эквайринга по паре "заказ + код авторизации".
// Учитываются только проведенные документы (решение заказчика, 31.07.2026):
// непроведенный платеж оплатой не считается. Обратная сторона: повторное
// нажатие "Получить оплату" при непроведенном платеже создаст второй
// документ — непроведенные черновики нужно помечать на удаление.
Функция НайтиПлатежноеПоручениеWayForPay(ДокументОснование, AuthCode) Экспорт

	ПустаяСсылка = Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка();

	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;

	Если СокрЛП(Строка(AuthCode)) = "" Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПлатежноеПоручениеВходящее.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	|ГДЕ
	|	НЕ ПлатежноеПоручениеВходящее.ПометкаУдаления
	|	И ПлатежноеПоручениеВходящее.Проведен
	|	И ПлатежноеПоручениеВходящее.ДокументОснование = &ДокументОснование
	|	И ПлатежноеПоручениеВходящее.WayForPay_AuthCode = &AuthCode
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПлатежноеПоручениеВходящее.Дата УБЫВ";

	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("AuthCode", СокрЛП(Строка(AuthCode)));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат ПустаяСсылка;

КонецФункции

// Ищет по заказу платеж, заведенный вручную до появления загрузки выписок:
// у такого документа нет входящего номера, поэтому опознаем его по сумме.
// Сюда попадают и ручные платежи, и созданные кнопкой «Получить оплату»
// из заказа, у которых код авторизации разошелся с выпиской. Платежи
// с заполненным входящим номером не рассматриваются — они уже привязаны
// к другим операциям выписки.
Функция НайтиПлатежПоЗаказуИСумме(ДокументОснование, Сумма) Экспорт

	ПустаяСсылка = Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка();

	Если Не ЗначениеЗаполнено(ДокументОснование) Или Сумма = 0 Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПлатежноеПоручениеВходящее.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	|ГДЕ
	|	НЕ ПлатежноеПоручениеВходящее.ПометкаУдаления
	|	И ПлатежноеПоручениеВходящее.Проведен
	|	И ПлатежноеПоручениеВходящее.ДокументОснование = &ДокументОснование
	|	И ПлатежноеПоручениеВходящее.СуммаДокумента = &Сумма
	|	И ПлатежноеПоручениеВходящее.НомерВходящегоДокумента = """"
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПлатежноеПоручениеВходящее.Дата УБЫВ";

	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("Сумма", Сумма);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат ПустаяСсылка;

КонецФункции

// Обертка для эквайринга WayForPay: вызывается из формы заказа покупателя.
//
// Параметры:
//   ДокументОснование - ДокументСсылка.ЗаказПокупателя;
//   РезWayForPay      - Структура - ответ WayForPay: СтатусОплаты, AuthCode,
//                       Сумма, НомерЗаказа, Карта;
//   ДатаПлатежа       - Дата.
//
Функция СоздатьПлатежноеПоручениеWayForPay(
	ДокументОснование,
	РезWayForPay,
	ДатаПлатежа) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Ссылка", Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка());
	Результат.Вставить("УжеСуществует", Ложь);

	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Результат.Сообщение = "Не указан документ-основание.";
		Возврат Результат;
	КонецЕсли;

	Если РезWayForPay = Неопределено Тогда
		Результат.Сообщение = "Не передан результат WayForPay.";
		Возврат Результат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(РезWayForPay.AuthCode) Тогда
		Результат.Сообщение = "WayForPay не вернул AuthCode платежа.";
		Возврат Результат;
	КонецЕсли;

	Если РезWayForPay.СтатусОплаты <> "Approved" Тогда
		Результат.Сообщение =
			"Платёж не подтверждён. Статус: " + РезWayForPay.СтатусОплаты;
		Возврат Результат;
	КонецЕсли;

	КомментарийWayForPay =
		"WayForPay; заказ "
		+ Строка(ДокументОснование)
		+ "; инвойс "
		+ Строка(РезWayForPay.НомерЗаказа)
		+ "; AuthCode "
		+ Строка(РезWayForPay.AuthCode);

	Если ЗначениеЗаполнено(РезWayForPay.Карта) Тогда
		КомментарийWayForPay =
			КомментарийWayForPay + "; карта " + Строка(РезWayForPay.Карта);
	КонецЕсли;

	Платеж = ОписаниеПлатежаПоЗаказу();

	Платеж.Сумма             = РезWayForPay.Сумма;
	Платеж.ДатаПлатежа       = ДатаПлатежа;
	Платеж.AuthCode          = РезWayForPay.AuthCode;
	Платеж.НазначениеПлатежа = КомментарийWayForPay;
	Платеж.Комментарий       = КомментарийWayForPay;

	// Входящий номер = orderReference инвойса — тот же ключ, которым платежи
	// заводит загрузка выписки. Без него платеж, созданный из заказа, виден
	// выписке только по паре «заказ + AuthCode», а сам заказ не находит платеж,
	// заведенный выпиской. Реквизит — Строка(30): длиннее не пишем, иначе
	// платформа усечет молча и ключ дедупликации разъедется.
	OrderReference = СокрЛП(Строка(РезWayForPay.НомерЗаказа));

	Если Не ПустаяСтрока(OrderReference)
		И СтрДлина(OrderReference) <= 30 Тогда

		Платеж.НомерВходящегоДокумента = OrderReference;

	КонецЕсли;

	Возврат СоздатьПлатежПоЗаказу(ДокументОснование, Платеж);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Расшифровка платежа: одна строка на один платеж по одной сделке.
// Если заполнение по основанию построило несколько строк, лишние удаляем —
// иначе сумма по табличной части разойдется с суммой документа
// (в остальных строках остались бы суммы заказа, а не фактической оплаты).
Процедура ЗаполнитьРасшифровкуПлатежа(
	ПлатежноеПоручение,
	ДокументОснование,
	Платеж)

	Если ПлатежноеПоручение.РасшифровкаПлатежа.Количество() <> 1 Тогда
		ПлатежноеПоручение.РасшифровкаПлатежа.Очистить();
		СтрокаРасшифровки = ПлатежноеПоручение.РасшифровкаПлатежа.Добавить();
	Иначе
		СтрокаРасшифровки = ПлатежноеПоручение.РасшифровкаПлатежа[0];
	КонецЕсли;

	СтрокаРасшифровки.ДоговорКонтрагента = ПлатежноеПоручение.ДоговорКонтрагента;

	Попытка
		СтрокаРасшифровки.СуммаПлатежа = Платеж.Сумма;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаРасшифровки.СуммаВзаиморасчетов = Платеж.Сумма;
	Исключение
	КонецПопытки;

	Если ЗначениеЗаполнено(ДокументОснование) Тогда

		Попытка
			СтрокаРасшифровки.Сделка = ДокументОснование;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаРасшифровки.ДокументРасчетовСКонтрагентом = ДокументОснование;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаРасшифровки.КурсВзаиморасчетов = ДокументОснование.КурсВзаиморасчетов;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаРасшифровки.КратностьВзаиморасчетов = ДокументОснование.КратностьВзаиморасчетов;
		Исключение
		КонецПопытки;

		СтавкаНДСЗаказа = СтавкаНДСПоЗаказу(ДокументОснование);

		Если ЗначениеЗаполнено(СтавкаНДСЗаказа) Тогда
			СтрокаРасшифровки.СтавкаНДС = СтавкаНДСЗаказа;
			СтрокаРасшифровки.СуммаНДС  = СуммаНДСПоСтавке(Платеж.Сумма, СтавкаНДСЗаказа);
		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтрокаРасшифровки.КурсВзаиморасчетов) Тогда
		СтрокаРасшифровки.КурсВзаиморасчетов = 1;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтрокаРасшифровки.КратностьВзаиморасчетов) Тогда
		СтрокаРасшифровки.КратностьВзаиморасчетов = 1;
	КонецЕсли;

	СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств = СтатьяДДСОплатыПокупателя(
		СтрокаРасшифровки.СтатьяДвиженияДенежныхСредств);

КонецПроцедуры

// Статья движения денежных средств для оплаты покупателя.
// Исторически подставляется статья с кодом "Д0001"; если такой в базе нет,
// прежний код молча записывал пустую статью — теперь остаётся то, что
// подставило заполнение по основанию, либо предопределённая ОплатаПокупателя.
Функция СтатьяДДСОплатыПокупателя(ТекущаяСтатья)

	Статья = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду("Д0001");

	Если ЗначениеЗаполнено(Статья) Тогда
		Возврат Статья;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущаяСтатья) Тогда
		Возврат ТекущаяСтатья;
	КонецЕсли;

	Возврат Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПокупателя;

КонецФункции

// Ставка НДС заказа берется из первой строки товаров (иначе — услуг).
// Смешанные ставки в одном заказе этой схемой не поддерживаются.
Функция СтавкаНДСПоЗаказу(ДокументОснование)

	Если ДокументОснование.Товары.Количество() > 0 Тогда
		Возврат ДокументОснование.Товары[0].СтавкаНДС;
	КонецЕсли;

	Если ДокументОснование.Услуги.Количество() > 0 Тогда
		Возврат ДокументОснование.Услуги[0].СтавкаНДС;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// НДС выделяется из суммы фактической оплаты (сумма НДС "в том числе").
// Состав Перечисление.СтавкиНДС в этой конфигурации: НДС0, НДС7, НДС20,
// БезНДС, НеНДС. Значения НДС14 здесь нет — обращение к нему падало бы
// с "Поле объекта не обнаружено" на любом заказе со ставкой НДС0/БезНДС.
Функция СуммаНДСПоСтавке(Сумма, СтавкаНДС)

	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		Возврат Окр(Сумма * 20 / 120, 2);
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7 Тогда
		Возврат Окр(Сумма * 7 / 107, 2);
	КонецЕсли;

	Возврат 0;

КонецФункции

#КонецОбласти
