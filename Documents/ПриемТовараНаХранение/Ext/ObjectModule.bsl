Процедура ОбработкаПроведения(Отказ, Режим)
	Движения.ХранениеТовара.Записывать = Истина;
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		Движение = Движения.ХранениеТовара.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Склад = Склад;
		Движение.Контрагент = Контрагент;
		Движение.Номенклатура = ТекСтрокаТовары.Номенклатура;
		Движение.ДокументХранения = Ссылка;
		Движение.Количество = ТекСтрокаТовары.Количество;
	КонецЦикла;   
	
	//С.Д. Сеня 15,05,24 +
	//1. В документі [прийом на храненія] прибрати рухи по всім регістрам крім ʼхраненияʼ з 01/05/2024
	Если НачалоДня(Дата) < Дата("20240501") Тогда 	
		Движения.ВзаиморасчетыСКонтрагентами.Записывать = Истина;
		Движение = Движения.ВзаиморасчетыСКонтрагентами.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.ДоговорКонтрагента = Сделка.ДоговорКонтрагента;
		Движение.Сделка = Сделка;
		Движение.Организация = Сделка.Организация;
		Движение.Контрагент = Контрагент;
		Движение.СуммаВзаиморасчетов = СуммаХранения;
		Движение.СуммаУпр = СуммаХранения;
		
		Движения.ЗаказыПокупателей.Записывать = Истина;
		Движения.Продажи.Записывать = Истина;
		Для Каждого Стр  из Сделка.Услуги Цикл
			Движение = Движения.ЗаказыПокупателей.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период = Дата;
			Движение.ДоговорКонтрагента = Сделка.ДоговорКонтрагента;
			Движение.ЗаказПокупателя = Сделка;
			Движение.СтатусПартии = Перечисления.СтатусыПартийТоваров.Купленный;
			ДВижение.Номенклатура = Стр.Номенклатура;
			Движение.Цена = Стр.Цена;
			ДВижение.СтавкаНДС = Стр.СтавкаНДС;
			ДВижение.Количество = Стр.Количество;
			ДВижение.СуммаВзаиморасчетов = Стр.Сумма;
			ДВижение.СуммаУпр = Стр.Сумма;
			
			Движение = Движения.Продажи.Добавить();
			Движение.Период = Дата;
			Движение.ДоговорКонтрагента = Сделка.ДоговорКонтрагента;
			Движение.ДокументПродажи = Ссылка;
			Движение.Контрагент = Контрагент;
			ДВижение.Номенклатура = Стр.Номенклатура;
			Движение.ЗаказПокупателя = Сделка;
			Движение.Подразделение = Сделка.Подразделение;
			Движение.Организация = Сделка.Организация;
			Движение.Количество = Стр.Количество;
			ДВижение.Стоимость = Стр.Сумма;
			Движение.НДС = Стр.СуммаНДС;
			Движение.СтоимостьБезСкидок = Стр.Сумма;
			
			Движения.ПродажиСебестоимость.Записывать = Истина;
			Движение = Движения.ПродажиСебестоимость.Добавить();
			Движение.Период = Дата;
			Движение.Номенклатура = Стр.Номенклатура;
			Движение.ЗаказПокупателя = Сделка;
			Движение.Подразделение = Сделка.Подразделение;
			Движение.Количество = Стр.Количество;
			//ДВижение.Стоимость = 50;
			
		КонецЦикла;
