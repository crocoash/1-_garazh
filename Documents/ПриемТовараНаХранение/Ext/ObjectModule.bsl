Функция ПечатьАктаЮ()

	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПриемНаХранениеДоговорООО";
	
	Макет = ПолучитьМакет("Акт");
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Номер = ?(ЗначениеЗаполнено(НомерПервичногоПриема),НомерПервичногоПриема,Номер);
//	ОбластьМакета.Параметры.ДатаПр = Формат(Дата,"Л=uk_UA; ДЛФ=DD");
	ОбластьМакета.Параметры.Дата = Формат(Дата,"Л=uk_UA; ДЛФ=DD");
	ОбластьМакета.Параметры.ДатаД = Формат(Сделка.ДоговорКонтрагента.Дата,"Л=uk_UA; ДЛФ=DD");
	ОбластьМакета.Параметры.НомерД = Формат(Сделка.ДоговорКонтрагента.Номер,"Л=uk_UA; ДЛФ=DD");
	
	ОбластьМакета.Параметры.ДатаД = Формат(Дата,"Л=uk_UA; ДЛФ=DD");
	ОбластьМакета.Параметры.НомерД = ?(ЗначениеЗаполнено(НомерПервичногоПриема),НомерПервичногоПриема,Номер);
	
	ОбластьМакета.Параметры.Особа = ДоверенноеЛицо;
	ОбластьМакета.Параметры.Довиреность = Доверенность;
	
	ОбластьМакета.Параметры.ДатаС = Формат(ДатаС,"ДФ=dd.MM.yyyy");	
	ОбластьМакета.Параметры.ДатаПо = Формат(ДатаПо,"ДФ=dd.MM.yyyy");	
	
	ОбластьМакета.Параметры.Хранение = СуммаХранения;	
	ОбластьМакета.Параметры.Хранениепроп = ОбщегоНазначения.СформироватьСуммуПрописью(СуммаХранения, Константы.ВалютаРегламентированногоУчета.Получить(),"uk");
	
	ОбластьМакета.Параметры.Контрагент = СокрЛП(Контрагент.НаименованиеПолное);
	
	ТабДокумент.Вывести(ОбластьМакета);
	Для Каждого Стр из Товары Цикл
		ОбластьМакета = Макет.ПолучитьОбласть("Строка");
		
		Областьмакета.Параметры.Заполнить(Ссылка);
		Областьмакета.Параметры.Заполнить(Стр);
//		Областьмакета.Параметры.ЗалоговаяСтоимость = СуммаХранения;
		ТабДокумент.Вывести(ОбластьМакета);
		
	конецЦикла;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Низ");
	
	ОбластьМакета.Параметры.Контрагент = СокрЛП(Контрагент.НаименованиеПолное);
	СведенияОПоставщике 	= УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(Контрагент, Дата,,,"uk");	
ОбластьМакета.Параметры.Реквизиты = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОПоставщике, "ПолноеНаименование,/,КодПоЕДРПОУ,КодПоДРФО,Телефоны,/,ИНН,НомерСвидетельства,",,"uk")
				+ "," + Символы.ПС + НСтр("ru='Р/с ';uk='Р/р '","uk") + Организация.ОсновнойБанковскийСчет.НомерСчета + ", Банк " + Организация.ОсновнойБанковскийСчет.Банк + ", МФО " + Организация.ОсновнойБанковскийСчет.Код + "," + Символы.ПС	
		        + ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОПоставщике, "ЮридическийАдрес,/,ПлательщикНалогаНаПрибыль,",,"uk");
	ОбластьМакета.Параметры.Дата = Формат(Дата,"Л=uk_UA; ДЛФ=DD");
				
	     ОбластьМакета.Параметры.Подпись =  "______________________"+ДоверенноеЛицо;
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	Возврат ТабДокумент;
	
