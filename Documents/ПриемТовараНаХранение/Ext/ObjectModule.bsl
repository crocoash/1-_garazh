Процедура ОбработатьКонтрагента()
	//+БП: d.matyash (25.02.2025) <>	
	Если ТипЗнч(контрагент) <> Тип("СправочникСсылка.Контрагенты") Тогда
		 Телефон = СтрЗаменить(Телефон," ","");
		 Телефон = СтрЗаменить(Телефон,"-","");
		 Телефон = СтрЗаменить(Телефон,"-","");
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	КонтактнаяИнформация.Объект.Код КАК Код,
		               |	КонтактнаяИнформация.Объект,
		               |	КонтактнаяИнформация.Вид,
		               |	КонтактнаяИнформация.Представление
		               |ИЗ
		               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		               |ГДЕ
		               |	ПОДСТРОКА(КонтактнаяИнформация.Представление, 1, 20) ПОДОБНО &Телефон";
		Запрос.УстановитьПараметр("Телефон","%"+Прав(Телефон,9));
		Рез = Запрос.Выполнить().Выгрузить().ВыбратьСтроку("Контрагент уже есть в базе, выберите контрагента");
		Если Не ЗначениеЗаполнено(Рез) Тогда
			Режим = РежимДиалогаВопрос.ДаНет;
			Текст = "Контрагента нету в базе, создать нового?";
			Ответ = Вопрос(Текст, Режим, 0);
			Если Ответ = КодВозвратаДиалога.Нет Тогда
				Возврат;
			КонецЕсли;
			КонтрагентН = Справочники.Контрагенты.СоздатьЭлемент();
			КонтрагентН.Наименование = Контрагент;
			КонтрагентН.НаименованиеПолное = Контрагент;
			КонтрагентН.Покупатель = Истина;
			КонтрагентН.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
			КонтрагентН.Родитель = Справочники.Контрагенты.НайтиПоКоду("000000003").Ссылка;
			КонтрагентН.Розница = Истина;
			КонтрагентН.Записать();
			ДоговорН = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			ДоговорН.Наименование = "Договір";
			ДоговорН.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчета.Получить();
			ДоговорН.Организация = Организация;
			ДоговорН.Владелец = КонтрагентН.Ссылка;
			ДоговорН.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
			//+БП: d.matyash (23.10.2024) <>
			ДоговорН.БП_ТипДоговора = Справочники.БП_ТипыДоговоровКонтрагентов.Стандартный;	
			//-БП: d.matyash (23.10.2024) <>
			ДоговорН.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоЗаказам;
			ДоговорН.Записать();
			КонтрагентН.ОсновнойДоговорКонтрагента = ДоговорН.Ссылка;
			КонтрагентН.Записать();
			Контрагент = КонтрагентН.Ссылка;
			ДоговорКонтрагента = ДоговорН.Ссылка;
			Если ТипЗнч(контрагент) =  Тип("СправочникСсылка.Контрагенты") и ЗначениеЗаполнено(контрагент) Тогда
				Отбор1 = Новый Структура("Объект");
				Отбор1.Объект = Контрагент; 
				Рег = РегистрыСведений.КонтактнаяИнформация.Выбрать(Отбор1);
				Пока Рег.Следующий() Цикл
					Если Рег.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента Тогда
						РегГ = Рег.ПолучитьМенеджерЗаписи();
						РегГ.Удалить();
					КонецЕсли;
				КонецЦикла;
				РегГ = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
				РегГ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
				Регг.Объект = Контрагент;
				Регг.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
				Регг.Поле1 = Телефон;
				Регг.Представление = Телефон;
				Регг.Записать();
			КонецЕслИ;
		Иначе
		Контрагент = Рез.Объект;
		//ДоговорКонтрагента = Контрагент.ОсновнойДоговорКонтрагента;
		КонецЕсли; 
		
	КонецЕслИ;
	//-БП: d.matyash (25.02.2025) <>
КонецПроцедуры