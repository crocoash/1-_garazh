		//Областьмакета.Параметры.ЗалоговаяСтоимость = СуммаХранения;
		ОбластьМакета.Параметры.Комментарий = "" + Стр.Комментарий + ?(стр.ОстатокПротэктора = 0,""," залишок протектора " + стр.ОстатокПротэктора) + " " + СезонУКР + " " + СостояниеТовараУКР;
		ТабДокумент.Вывести(ОбластьМакета);
		
