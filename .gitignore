# Инструменты. Тяжёлое (portable git, BSL Language Server) в репозиторий не тащим,
# но скрипты штрихкодов и снимков должны уезжать вместе с конфигурацией на машину с 1С.
/_tools/*
!/_tools/check-barcodes.ps1
!/_tools/fix-barcodes.ps1
!/_tools/barcode-object.txt
!/_tools/snapshot.ps1
!/_tools/update-base.ps1
!/_tools/update-base.cmd
!/_tools/make-shortcut.ps1
!/_tools/merge-cf.ps1
!/_tools/deploy.ps1
!/_tools/deploy.cmd
!/_tools/Обновить базу.cmd
!/_tools/merge-settings.txt
!/_tools/ШтрихкодыВМакетах.md
!/_tools/wait-deploy.ps1
!/_tools/Слушать заливку.cmd
!/_tools/deploy-result.log

# Служебные файлы Claude Code
/.claude/
